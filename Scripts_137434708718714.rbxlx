		["CUSTOM 3"] = "PERSONAL 3",
		["BACKWARDS"] = "HACIA ATR\195\129S",
		["FORWARDS"] = "HACIA DELANTE",
		["HOLD {Draw}"] = "MANT\195\137N {Draw}",
		["Walk onto the mat"] = "Camina hasta la estera",
		["Walk onto the straw mat with **WASD**."] = "Camina hasta la estera de paja con **WASD**.",
		["WALK ONTO THE MAT"] = "CAMINA HASTA LA ESTERA",
		["Walk onto the straw mat with the **thumbstick**."] = "Camina hasta la estera de paja con el **joystick**.",
		["Horizontal slice"] = "Corte horizontal",
		["Walk up close. Move the mouse **left**. Then **hold {Draw}** and **swipe right**."] = "Ac\195\169rcate. Mueve el rat\195\179n a la **izquierda**. Luego **mant\195\169n {Draw}** y **desliza a la derecha**.",
		["MOVE LEFT"] = "MUEVE A LA IZQUIERDA",
		["SWIPE RIGHT"] = "DESLIZA A LA DERECHA",
		["Walk up close. Then **flick right** on the right side of the screen."] = "Ac\195\169rcate. Luego **desliza r\195\161pido a la derecha** en el lado derecho de la pantalla.",
		["Sheathe the sword"] = "Envaina la espada",
		["Press **{Equip}** to sheathe the blade. Every draw starts from the sheath."] = "Pulsa **{Equip}** para envainar la hoja. Cada desenvaine empieza desde la vaina.",
		["PRESS {Equip}"] = "PULSA {Equip}",
		["Tap **SHEATHE** to sheathe the blade. Every draw starts from the sheath."] = "Toca **ENVAINAR** para envainar la hoja. Cada desenvaine empieza desde la vaina.",
		["TAP SHEATHE"] = "TOCA ENVAINAR",
		["Vertical slice"] = "Corte vertical",
		["Walk up close. Move the mouse **up**. Then **hold {Draw}** and **swipe down**."] = "Ac\195\169rcate. Mueve el rat\195\179n **arriba**. Luego **mant\195\169n {Draw}** y **desliza hacia abajo**.",
		["MOVE UP"] = "MUEVE ARRIBA",
		["SWIPE DOWN"] = "DESLIZA HACIA ABAJO",
		["Walk up close. Then **flick down** on the right side of the screen."] = "Ac\195\169rcate. Luego **desliza r\195\161pido hacia abajo** en el lado derecho de la pantalla.",
		["FLICK DOWN"] = "DESLIZA HACIA ABAJO",
		["Weakened: wipe the blade"] = "Debilitado: limpia la hoja",
		["Poise broken: **weakened** (slow, no jumping). Press **{Wipe}** to wipe the blade and recover."] = "Postura rota: **debilitado** (lento, sin saltar). Pulsa **{Wipe}** para limpiar la hoja y recuperarte.",
		["PRESS {Wipe}"] = "PULSA {Wipe}",
		["Poise broken: **weakened** (slow, no jumping). Tap **WIPE** to wipe the blade and recover."] = "Postura rota: **debilitado** (lento, sin saltar). Toca **LIMPIAR** para limpiar la hoja y recuperarte.",
		["TAP WIPE"] = "TOCA LIMPIAR",
		["Dash attack"] = "Ataque con impulso",
		["Blade out, walk up close. Hold **W + A** to walk past the watermelon, then press **{Dash}** to dash through it."] = "Con la hoja fuera, ac\195\169rcate. Mant\195\169n **W + A** para pasar junto a la sand\195\173a y luego pulsa **{Dash}** para atravesarla con un impulso.",
		["HOLD W + A"] = "MANT\195\137N W + A",
		["PRESS {Dash}"] = "PULSA {Dash}",
		["Blade out, walk up close. Walk past the watermelon, then tap **DASH** to dash through it."] = "Con la hoja fuera, ac\195\169rcate. Pasa junto a la sand\195\173a y luego toca **IMPULSO** para atravesarla con un impulso.",
		["WALK PAST IT"] = "PASA JUNTO A ELLA",
		["TAP DASH"] = "TOCA IMPULSO",
		["That was the low cut"] = "Ese fue el corte bajo",
		["That was the horizontal slice"] = "Ese fue el corte horizontal",
		["That was a diagonal cut"] = "Ese fue un corte diagonal",
		["That was the vertical slice"] = "Ese fue el corte vertical",
		["That was another draw"] = "Ese fue otro desenvaine",
		["That was a swing"] = "Eso fue un golpe",
		["move the mouse **left**, then **hold {Draw}** and **swipe right**"] = "mueve el rat\195\179n a la **izquierda**, luego **mant\195\169n {Draw}** y **desliza a la derecha**",
		["move the mouse **up**, then **hold {Draw}** and **swipe down**"] = "mueve el rat\195\179n **arriba**, luego **mant\195\169n {Draw}** y **desliza hacia abajo**",
		["draw again"] = "desenvaina de nuevo",
		["**flick right** on the right side of the screen"] = "**desliza r\195\161pido a la derecha** en el lado derecho de la pantalla",
		["**flick down** on the right side of the screen"] = "**desliza r\195\161pido hacia abajo** en el lado derecho de la pantalla",
		["Rusted, the cord rotten"] = "Oxidado, el cord\195\179n podrido",
		["Rust polished away"] = "\195\147xido pulido por completo",
		["Black silk on the handle and cords"] = "Seda negra en el mango y los cordones",
		["Bright silver fittings"] = "Guarniciones de plata brillante",
		["Black lacquered sheath"] = "Vaina lacada en negro",
		["Temper line polished, purple silk"] = "L\195\173nea de temple pulida, seda morada",
		["Best of 5: the first to {wins} round wins."] = "Al mejor de 5: gana quien gane {wins} rondas primero.",
		["Every attack is a draw-cut that strikes through any blade. No guard."] = "Cada ataque es un corte al desenvainar que atraviesa cualquier hoja. Sin guardia.",
		["Fight from the sheath: every draw-cut strikes through any blade, and the blade goes straight back in."] = "Lucha desde la vaina: cada corte al desenvainar atraviesa cualquier hoja, y la hoja vuelve enseguida a la vaina.",
		["10 rename spins"] = "10 giros de nombre",
		["50 rename spins"] = "50 giros de nombre",
		["Each column is a string: hold a key, then pluck that string."] = "Cada columna es una cuerda: mant\195\169n una tecla y puntea esa cuerda.",
		["TACHI restored: stage {stage}, {name}"] = "TACHI restaurado: etapa {stage}, {name}",
		["You can only bow for a 1v1 with someone you could fight right now, in the same ring."] = "Solo puedes hacer la reverencia para un 1v1 a alguien con quien podr\195\173as luchar ahora mismo, en el mismo ring.",
		["The rematch can\'t start: you both need to be in the same ring."] = "La revancha no puede empezar: ambos tienen que estar en el mismo ring.",
		["Positions 1 to 9: hold one, then pluck."] = "Posiciones 1 a 9: mant\195\169n una y puntea.",
		["Finish a daily quest"] = "Completa una misi\195\179n diaria",
		["VENGEFUL EMPRESS"] = "EMPERATRIZ VENGATIVA",
		["THE TEMPLE GHOST"] = "EL FANTASMA DEL TEMPLO",
		["Reroll your first name as often as you like, or spin a new family name ({count} spin)."] = "Cambia tu nombre tantas veces como quieras, o gira un nuevo apellido ({count} giro).",
		["Reroll your first name as often as you like, or spin a new family name ({count} spins)."] = "Cambia tu nombre tantas veces como quieras, o gira un nuevo apellido ({count} giros).",
		["Reroll your first name as often as you like."] = "Cambia tu nombre tantas veces como quieras.",
		["REROLL FIRST NAME"] = "CAMBIAR NOMBRE",
		["Couldn\'t roll. Try again."] = "No se pudo tirar. Int\195\169ntalo de nuevo.",
		["REROLL"] = "VOLVER A TIRAR",
		["Roll a first name first."] = "Primero tira un nombre.",
		["RARER THAN YOURS"] = "M\195\129S RARO QUE EL TUYO",
		["LEGENDARY AND UP"] = "LEGENDARIO O M\195\129S",
		["ASK TWICE FOR EXOTIC"] = "DOBLE AVISO SI ES EX\195\147TICO",
		["{on} OF {all}"] = "{on} DE {all}",
		["Asks before a spin throws away a family name."] = "Pregunta antes de que un giro descarte un apellido.",
		["You\'ll lose {names} and {count} more."] = "Perder\195\161s {names} y {count} m\195\161s.",
		["You\'ll lose {names}."] = "Perder\195\161s {names}.",
		["Are you sure?"] = "\194\191Est\195\161s seguro?",
		["{names} will be gone for good."] = "{names} se perder\195\161 para siempre.",
		["Peaceful: out in the forest nobody can hurt you, and you can\'t hurt anyone. In the rings you fight as usual."] = "Pac\195\173fico: en el bosque nadie puede herirte y t\195\186 no puedes herir a nadie. En los rings luchas como siempre.",
		["Peaceful: nobody can hurt you, and you can\'t hurt anyone. In the beginners\' ring and the boss arena you fight as usual."] = "Pac\195\173fico: nadie puede herirte y t\195\186 no puedes herir a nadie. En el ring de novatos y en la arena del jefe luchas como siempre.",
		["BONFIRE"] = "HOGUERA",
		["LAST LOCATION"] = "\195\154LTIMA UBICACI\195\147N",
		["Outside the ring: sword lowered"] = "Fuera del ring: espada bajada",
		["Outside the ring: sword sheathed"] = "Fuera del ring: espada envainada",
		["Find bonfires out in the world to travel between them."] = "Encuentra hogueras por el mundo para viajar entre ellas.",
		["Tap a bonfire you\'ve found to travel there."] = "Toca una hoguera que hayas encontrado para viajar all\195\173.",
		["Click a bonfire you\'ve found to travel there."] = "Haz clic en una hoguera que hayas encontrado para viajar all\195\173.",
		["Bonfire found: {name}"] = "Hoguera encontrada: {name}",
		["Rested at {name}. You\'ll start here when you next play."] = "Descansaste en {name}. Empezar\195\161s aqu\195\173 la pr\195\179xima vez que juegues.",
		["You haven\'t found that bonfire yet."] = "A\195\186n no has encontrado esa hoguera.",
		["{upgrade}.  {look}"] = "{upgrade}.  {look}",
		["REFORGE"] = "REFORJAR",
		["Forge your next upgrade, or reforge your blade to a rank you\'ve already forged."] = "Forja tu pr\195\179xima mejora, o reforja tu hoja a un rango que ya hayas forjado.",
		["FORGE RANK {rank}   {name}"] = "FORJAR RANGO {rank}   {name}",
		["unlocks at level {level} (you\'re level {yours})"] = "se desbloquea en el nivel {level} (tienes el nivel {yours})",
		["RANK {rank}   {name}   (in use)"] = "RANGO {rank}   {name}   (en uso)",
		["Dark blade, crimson edge, red lightning, a glow that flares as it drinks."] = "Hoja oscura, filo carmes\195\173, rayos rojos, un brillo que se aviva al beber.",
		["FIND IT"] = "ENCU\195\137NTRALA",
		["{short} Find it in the rooms of the temple on the hill."] = "{short} Encu\195\169ntrala en las salas del templo de la colina.",
		["Blade length 3.2 studs"] = "Hoja de 3.2 studs",
		["Blade length 3.4 studs, draw styles (coming soon)"] = "Hoja de 3.4 studs, estilos de desenvaine (pr\195\179ximamente)",
		["+5% walk speed"] = "+5% de velocidad al caminar",
		["+5% walk speed, 25% faster poise recovery"] = "+5% de velocidad al caminar, recuperaci\195\179n de postura un 25% m\195\161s r\195\161pida",
		["After {delay} seconds of calm it comes back, {regen} a second: faster with a still guard (L2 on a gamepad), slower with little blood.\n\nBelow half, your feet slow down. The lower it is, the heavier your blade and the more easily it\'s knocked aside."] = "Tras {delay} segundos de calma vuelve, {regen} por segundo: m\195\161s r\195\161pido con una guardia quieta (L2 en un mando), m\195\161s despacio con poca sangre.\n\nPor debajo de la mitad, tus pies se ralentizan. Cuanto m\195\161s baja, m\195\161s pesada tu hoja y m\195\161s f\195\161cil de desviar.",
		["<b>Wiping resets your poise.</b> While the cloth is on the blade, poise comes back {times} times as fast, and a finished wipe fills it to full.\n\nIt works after a break too: finishing a wipe ends being weakened.\n\nA finished wipe also gives back all your dashes."] = "<b>Limpiar la hoja restaura tu postura.</b> Mientras el pa\195\177o est\195\161 en la hoja, la postura vuelve {times} veces m\195\161s r\195\161pido, y una limpieza terminada la llena del todo.\n\nTambi\195\169n funciona tras romperse: terminar una limpieza acaba con el debilitamiento.\n\nUna limpieza completa tambi\195\169n te devuelve todos los impulsos.",
		["tap WIPE to refill dashes"] = "toca LIMPIAR para recargar los impulsos",
		["{key}  wipe to refill dashes"] = "{key}  limpia la hoja para recargar los impulsos",
		["Out of dashes. Tap **WIPE** to wipe your blade and get them back."] = "Sin impulsos. Toca **LIMPIAR** para limpiar la hoja y recuperarlos.",
		["Out of dashes. Press **{Wipe}** to wipe your blade and get them back."] = "Sin impulsos. Pulsa **{Wipe}** para limpiar la hoja y recuperarlos.",
		["+1% walk speed"] = "+1% de velocidad al caminar",
		["10% less poise lost to hits and clashes"] = "Un 10% menos de postura perdida por golpes y choques de espadas",
		["10% less poise lost to hits and clashes, 15% quicker back from knocks"] = "Un 10% menos de postura perdida por golpes y choques de espadas, recuperaci\195\179n de los rechazos un 15% m\195\161s r\195\161pida",
		["+1% walk speed, 25% faster poise recovery"] = "+1% de velocidad al caminar, recuperaci\195\179n de postura un 25% m\195\161s r\195\161pida",
		["+20 blood"] = "+20 de sangre",
		["UPGRADE READY"] = "MEJORA LISTA",
		["the forge"] = "la forja",
		["New look"] = "Nuevo aspecto",
		["Draw styles (coming soon)"] = "Estilos de desenvaine (pr\195\179ximamente)",
		["SINGLE"] = "SIMPLE",
		["DUAL WIELD"] = "DOS KATANAS",
		["IAI"] = "IAI",
		["Robux spins aren\'t sold on your account. Ry\197\141 and levels still give them."] = "Los giros por Robux no se venden en tu cuenta. Los ry\197\141 y los niveles siguen d\195\161ndolos.",
		["Beginners\' ring: under level {level} only"] = "Ring de novatos: solo por debajo del nivel {level}"
	}
}
return v1]]></ProtectedString>
