		["Hold, swipe to draw. Blade out: thrust."] = "\230\140\137\228\189\143\229\185\182\230\187\145\229\138\168\228\187\165\230\139\148\229\136\128\227\128\130\229\136\128\229\183\178\229\135\186\233\158\152\230\151\182\229\136\153\228\184\186\231\170\129\229\136\186\227\128\130",
