	["Lines"] = {
		["1 free rename spin"] = "\224\184\170\224\184\155\224\184\180\224\184\153\224\184\138\224\184\183\224\185\136\224\184\173\224\184\159\224\184\163\224\184\181 1 \224\184\132\224\184\163\224\184\177\224\185\137\224\184\135",
		["{count} free rename spins"] = "\224\184\170\224\184\155\224\184\180\224\184\153\224\184\138\224\184\183\224\185\136\224\184\173\224\184\159\224\184\163\224\184\181 {count} \224\184\132\224\184\163\224\184\177\224\185\137\224\184\135",
		["{xp} XP"] = "{xp} XP",
