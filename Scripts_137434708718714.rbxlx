		["APPEARANCE"] = "\224\184\163\224\184\185\224\184\155\224\184\165\224\184\177\224\184\129\224\184\169\224\184\147\224\185\140",
		["HAIR AND OUTFIT"] = "\224\184\151\224\184\163\224\184\135\224\184\156\224\184\161\224\185\129\224\184\165\224\184\176\224\184\138\224\184\184\224\184\148",
		["NAME"] = "\224\184\138\224\184\183\224\185\136\224\184\173",
		["LOADOUT"] = "\224\184\138\224\184\184\224\184\148\224\184\173\224\184\178\224\184\167\224\184\184\224\184\152",
