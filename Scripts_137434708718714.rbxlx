		v76.dash = math.floor(v80)
		local v81 = v_u_12.Kick * (1 - v_u_12.PlayerToughness) + 0.5
		v76.kick = math.floor(v81)
		local v82 = v_u_12.Wound * (1 - v_u_12.PlayerToughness) + 0.5
		v76.wound = math.floor(v82)
		return v76
	end
}, {
	["Text"] = v10("Poise refills after {delay} seconds with no poise lost, at {regen} per second. A still guard (L2 on a gamepad) refills it faster; low blood refills it slower.\n\nBelow half poise, blade and movement speed drop, and the blade is knocked aside more easily."),
	["Args"] = function()
		-- upvalues: (copy) v_u_12
		local v83 = {}
		local v84 = v_u_12.RegenDelay
		local v85
		if v84 % 1 == 0 then
			v85 = string.format("%d", v84)
