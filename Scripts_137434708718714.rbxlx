		["TRAVELLING MERCHANT"] = "\230\151\133\227\129\174\229\149\134\228\186\186",
		["Ah, a traveller. You\'ll forgive me if I don\'t get up."] = "\227\129\138\227\130\132\227\128\129\230\151\133\227\129\174\228\186\186\227\129\139\227\128\130\229\186\167\227\129\163\227\129\159\227\129\190\227\129\190\227\129\167\229\164\177\231\164\188\227\129\153\227\130\139\227\130\136\227\128\130",
		["Three nights ago my horses caught wind of something up at that temple."] = "\228\184\137\230\153\169\229\137\141\227\128\129\227\129\134\227\129\161\227\129\174\233\166\172\227\129\140\227\129\130\227\129\174\229\175\186\227\129\174\230\150\185\227\129\167\228\189\149\227\129\139\227\130\146\229\151\133\227\129\142\227\129\164\227\129\145\227\129\159\227\130\147\227\129\160\227\128\130",
		["They screamed, broke their harness and bolted into the trees. I haven\'t seen them since."] = "\227\129\132\227\129\170\227\129\170\227\129\132\227\129\166\233\166\172\229\133\183\227\130\146\229\188\149\227\129\141\227\129\161\227\129\142\227\130\138\227\128\129\230\163\174\227\129\184\233\128\131\227\129\146\227\129\166\227\129\151\227\129\190\227\129\163\227\129\159\227\128\130\227\129\157\227\130\140\227\129\141\227\130\138\229\167\191\227\130\146\232\166\139\227\129\166\227\129\132\227\129\170\227\129\132\227\128\130",
		["So here I am, stranded with a wagon full of wax."] = "\227\129\138\227\129\139\227\129\146\227\129\167\227\128\129\232\157\139\227\130\146\229\177\177\227\129\187\227\129\169\231\169\141\227\130\147\227\129\160\232\141\183\232\187\138\227\129\168\228\184\128\231\183\146\227\129\171\227\129\147\227\129\147\227\129\167\231\171\139\227\129\161\229\190\128\231\148\159\227\129\149\227\128\130",
		["There\'s something wrong with that temple, I\'d stay away if I were you, especially at night."] = "\227\129\130\227\129\174\229\175\186\227\129\175\228\189\149\227\129\139\227\129\140\227\129\138\227\129\139\227\129\151\227\129\132\227\128\130\227\130\143\227\129\151\227\129\170\227\130\137\232\191\145\227\129\165\227\129\139\227\130\147\227\129\173\227\128\130\231\137\185\227\129\171\229\164\156\227\129\175\227\129\170\227\128\130",
		["Here, take some wax. It might be useful to give your blade some extra shine. Be careful around a flame though, this stuff can catch alight in the blink of an eye!"] = "\227\129\187\227\130\137\227\128\129\232\157\139\227\130\146\229\176\145\227\129\151\230\140\129\227\129\163\227\129\166\227\129\132\227\129\145\227\128\130\229\136\131\227\129\171\227\129\178\227\129\168\229\145\179\233\129\149\227\129\134\232\137\182\227\129\140\229\135\186\227\130\139\227\129\139\227\130\130\227\129\151\227\130\140\227\130\147\227\128\130\227\129\160\227\129\140\231\129\171\227\129\174\227\129\157\227\129\176\227\129\167\227\129\175\230\176\151\227\130\146\227\129\164\227\129\145\227\130\141\227\128\130\227\129\147\227\129\132\227\129\164\227\129\175\227\129\130\227\129\163\227\129\168\227\129\132\227\129\134\233\150\147\227\129\171\231\135\131\227\129\136\228\184\138\227\129\140\227\130\139\227\129\139\227\130\137\227\129\170\239\188\129",
		["Still here? So am I."] = "\227\129\190\227\129\160\227\129\132\227\129\159\227\129\174\227\129\139\227\128\130\227\130\143\227\129\151\227\130\130\227\129\160\227\130\136\227\128\130",
		["And keep away from that temple at night."] = "\227\129\157\227\130\140\227\129\168\227\128\129\229\164\156\227\129\175\227\129\130\227\129\174\229\175\186\227\129\171\232\191\145\227\129\165\227\129\143\227\129\170\227\128\130",
