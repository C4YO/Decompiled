		["Bow to who you\'re locked onto: both bow, a 1v1."] = "\208\159\208\190\208\186\208\187\208\190\208\189 \209\134\208\181\208\187\208\184 \208\178 \208\183\208\176\209\133\208\178\208\176\209\130\208\181: \208\190\208\177\208\176 \208\191\208\190\208\186\208\187\208\190\208\189\208\184\208\187\208\184\209\129\209\140 \226\128\148 1v1.",
		["Battle music: next track."] = "\208\145\208\190\208\181\208\178\208\176\209\143 \208\188\209\131\208\183\209\139\208\186\208\176: \209\129\208\187\208\181\208\180\209\131\209\142\209\137\208\184\208\185 \209\130\209\128\208\181\208\186.",
		["Battle music: the last track."] = "\208\145\208\190\208\181\208\178\208\176\209\143 \208\188\209\131\208\183\209\139\208\186\208\176: \208\191\209\128\208\181\208\180\209\139\208\180\209\131\209\137\208\184\208\185 \209\130\209\128\208\181\208\186.",
		["In the dojo: skip to the arena."] = "\208\146 \208\180\208\190\208\180\208\183\209\145: \209\129\209\128\208\176\208\183\209\131 \208\189\208\176 \208\176\209\128\208\181\208\189\209\131.",
		["Hide the UI for clean shots. Again: show it."] = "\208\161\208\186\209\128\209\139\209\130\209\140 \208\184\208\189\209\130\208\181\209\128\209\132\208\181\208\185\209\129 \208\180\208\187\209\143 \209\135\208\184\209\129\209\130\209\139\209\133 \208\186\208\176\208\180\209\128\208\190\208\178. \208\149\209\137\209\145 \209\128\208\176\208\183: \208\191\208\190\208\186\208\176\208\183\208\176\209\130\209\140.",
		["Shamisen: take it out or put it away."] = "\208\161\209\143\208\188\208\184\209\129\209\141\208\189: \208\180\208\190\209\129\209\130\208\176\209\130\209\140 \208\184\208\187\208\184 \209\131\208\177\209\128\208\176\209\130\209\140.",
		["left click"] = "\208\155\208\154\208\156",
		["right click"] = "\208\159\208\154\208\156",
		["middle click"] = "\208\161\208\154\208\156",
		["RIGHT SHIFT"] = "\208\159\208\160\208\144\208\146\208\171\208\153 SHIFT",
		["RIGHT CTRL"] = "\208\159\208\160\208\144\208\146\208\171\208\153 CTRL",
		["RIGHT ALT"] = "\208\159\208\160\208\144\208\146\208\171\208\153 ALT",
		["Talk"] = "\208\147\208\190\208\178\208\190\209\128\208\184\209\130\209\140",
		["TRAVELLING MERCHANT"] = "\208\161\208\162\208\160\208\144\208\157\208\161\208\162\208\146\208\163\208\174\208\169\208\152\208\153 \208\162\208\158\208\160\208\147\208\158\208\146\208\149\208\166",
		["Ah, a traveller. You\'ll forgive me if I don\'t get up."] = "\208\144, \208\191\209\131\209\130\208\189\208\184\208\186. \208\163\208\182 \208\191\209\128\208\190\209\129\209\130\208\184, \209\135\209\130\208\190 \208\189\208\181 \208\178\209\129\209\130\208\176\209\142.",
		["Three nights ago my horses caught wind of something up at that temple."] = "\208\162\209\128\208\184 \208\189\208\190\209\135\208\184 \208\189\208\176\208\183\208\176\208\180 \208\188\208\190\208\184 \208\187\208\190\209\136\208\176\208\180\208\184 \208\191\208\190\209\135\209\131\209\143\208\187\208\184 \209\135\209\130\208\190-\209\130\208\190 \209\130\208\176\208\188, \208\189\208\176\208\178\208\181\209\128\209\133\209\131, \209\131 \209\130\208\190\208\179\208\190 \209\133\209\128\208\176\208\188\208\176.",
		["They screamed, broke their harness and bolted into the trees. I haven\'t seen them since."] = "\208\158\208\189\208\184 \208\183\208\176\208\178\208\184\208\183\208\182\208\176\208\187\208\184, \208\191\208\190\209\128\208\178\208\176\208\187\208\184 \209\131\208\191\209\128\209\143\208\182\209\140 \208\184 \209\131\208\188\209\135\208\176\208\187\208\184\209\129\209\140 \208\178 \208\187\208\181\209\129. \208\161 \209\130\208\181\209\133 \208\191\208\190\209\128 \209\143 \208\184\209\133 \208\189\208\181 \208\178\208\184\208\180\208\181\208\187.",
		["So here I am, stranded with a wagon full of wax."] = "\208\146\208\190\209\130 \209\130\208\176\208\186 \209\143 \208\184 \208\183\208\176\209\129\209\130\209\128\209\143\208\187 \208\183\208\180\208\181\209\129\209\140 \209\129 \208\191\208\190\208\178\208\190\208\183\208\186\208\190\208\185, \208\191\208\190\208\187\208\189\208\190\208\185 \208\178\208\190\209\129\208\186\208\176.",
		["There\'s something wrong with that temple, I\'d stay away if I were you, especially at night."] = "\208\161 \209\130\208\181\208\188 \209\133\209\128\208\176\208\188\208\190\208\188 \209\135\209\130\208\190-\209\130\208\190 \208\189\208\181 \209\130\208\176\208\186. \208\175 \208\177\209\139 \208\189\208\176 \209\130\208\178\208\190\209\145\208\188 \208\188\208\181\209\129\209\130\208\181 \208\180\208\181\209\128\208\182\208\176\208\187\209\129\209\143 \208\190\209\130 \208\189\208\181\208\179\208\190 \208\191\208\190\208\180\208\176\208\187\209\140\209\136\208\181, \208\190\209\129\208\190\208\177\208\181\208\189\208\189\208\190 \208\189\208\190\209\135\209\140\209\142.",
		["Here, take some wax. It might be useful to give your blade some extra shine. Be careful around a flame though, this stuff can catch alight in the blink of an eye!"] = "\208\146\208\190\209\130, \208\178\208\190\208\183\209\140\208\188\208\184 \208\189\208\181\208\188\208\189\208\190\208\179\208\190 \208\178\208\190\209\129\208\186\208\176. \208\158\208\189 \208\188\208\190\208\182\208\181\209\130 \208\191\209\128\208\184\208\180\208\176\209\130\209\140 \209\130\208\178\208\190\208\181\208\188\209\131 \208\186\208\187\208\184\208\189\208\186\209\131 \208\190\209\129\208\190\208\177\209\139\208\185 \208\177\208\187\208\181\209\129\208\186. \208\157\208\190 \208\190\209\129\209\130\208\190\209\128\208\190\208\182\208\189\208\181\208\181 \209\129 \208\190\208\179\208\189\209\145\208\188: \209\141\209\130\208\176 \209\136\209\130\209\131\208\186\208\176 \208\178\209\129\208\191\209\139\209\133\208\184\208\178\208\176\208\181\209\130 \208\178 \208\188\208\179\208\189\208\190\208\178\208\181\208\189\208\184\208\181 \208\190\208\186\208\176!",
		["Still here? So am I."] = "\208\146\209\129\209\145 \208\181\209\137\209\145 \208\183\208\180\208\181\209\129\209\140? \208\175 \209\130\208\190\208\182\208\181.",
		["And keep away from that temple at night."] = "\208\152 \208\180\208\181\209\128\208\182\208\184\209\129\209\140 \208\191\208\190\208\180\208\176\208\187\209\140\209\136\208\181 \208\190\209\130 \209\130\208\190\208\179\208\190 \209\133\209\128\208\176\208\188\208\176 \208\189\208\190\209\135\209\140\209\142.",
		["KATANA: SINGLE"] = "\208\154\208\144\208\162\208\144\208\157\208\144: \208\158\208\148\208\157\208\144",
		["One katana at the left hip."] = "\208\158\208\180\208\189\208\176 \208\186\208\176\209\130\208\176\208\189\208\176 \208\189\208\176 \208\187\208\181\208\178\208\190\208\188 \208\177\208\181\208\180\209\128\208\181.",
		["A katana at each hip, drawn together, one in each hand."] = "\208\154\208\176\209\130\208\176\208\189\208\176 \208\189\208\176 \208\186\208\176\208\182\208\180\208\190\208\188 \208\177\208\181\208\180\209\128\208\181: \208\178\209\139\209\133\208\178\208\176\209\130\209\139\208\178\208\176\209\142\209\130\209\129\209\143 \208\178\208\188\208\181\209\129\209\130\208\181, \208\191\208\190 \208\190\208\180\208\189\208\190\208\185 \208\178 \208\186\208\176\208\182\208\180\208\190\208\185 \209\128\209\131\208\186\208\181.",
		["A katana at each hip, one in each hand."] = "\208\154\208\176\209\130\208\176\208\189\208\176 \208\189\208\176 \208\186\208\176\208\182\208\180\208\190\208\188 \208\177\208\181\208\180\209\128\208\181, \208\191\208\190 \208\190\208\180\208\189\208\190\208\185 \208\178 \208\186\208\176\208\182\208\180\208\190\208\185 \209\128\209\131\208\186\208\181.",
		["KATANA: IAI"] = "\208\154\208\144\208\162\208\144\208\157\208\144: \208\152\208\144\208\153",
		["Draw-cuts only. High risk, high reward: cuts through blades, but a miss can be parried. Longer dash, faster draw. On a kill: poise back and a faster sheathe."] = "\208\162\208\190\208\187\209\140\208\186\208\190 \209\131\208\180\208\176\209\128\209\139 \209\129 \208\178\209\139\209\133\208\178\208\176\209\130\208\176. \208\146\209\139\209\129\208\190\208\186\208\184\208\185 \209\128\208\184\209\129\208\186, \208\178\209\139\209\129\208\190\208\186\208\176\209\143 \208\189\208\176\208\179\209\128\208\176\208\180\208\176: \208\191\209\128\208\190\208\177\208\184\208\178\208\176\208\181\209\130 \208\186\208\187\208\184\208\189\208\186\208\184, \208\189\208\190 \208\191\209\128\208\190\208\188\208\176\209\133 \208\188\208\190\208\182\208\189\208\190 \208\191\208\176\209\128\208\184\209\128\208\190\208\178\208\176\209\130\209\140. \208\160\209\139\208\178\208\190\208\186 \208\180\208\187\208\184\208\189\208\189\208\181\208\181, \208\178\209\139\209\133\208\178\208\176\209\130 \208\177\209\139\209\129\209\130\209\128\208\181\208\181. \208\151\208\176 \209\131\208\177\208\184\208\185\209\129\209\130\208\178\208\190: \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\176\208\178\208\187\208\184\208\178\208\176\208\181\209\130\209\129\209\143 \208\184 \208\177\209\139\209\129\209\130\209\128\208\181\208\181 \208\178 \208\189\208\190\208\182\208\189\209\139.",
		["The older, longer sword, slung edge down at your hip. Slower and heavier than the katana: its hits take more poise and bleed more."] = "\208\145\208\190\208\187\208\181\208\181 \208\180\209\128\208\181\208\178\208\189\208\184\208\185 \208\184 \208\180\208\187\208\184\208\189\208\189\209\139\208\185 \208\188\208\181\209\135, \208\191\208\190\208\180\208\178\208\181\209\136\208\181\208\189\208\189\209\139\208\185 \209\131 \208\177\208\181\208\180\209\128\208\176 \208\187\208\181\208\183\208\178\208\184\208\181\208\188 \208\178\208\189\208\184\208\183. \208\156\208\181\208\180\208\187\208\181\208\189\208\189\208\181\208\181 \208\184 \209\130\209\143\208\182\208\181\208\187\208\181\208\181 \208\186\208\176\209\130\208\176\208\189\209\139: \208\181\208\179\208\190 \209\131\208\180\208\176\209\128\209\139 \208\190\209\130\208\189\208\184\208\188\208\176\209\142\209\130 \208\177\208\190\208\187\209\140\209\136\208\181 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184 \208\184 \208\178\209\139\208\183\209\139\208\178\208\176\209\142\209\130 \209\129\208\184\208\187\209\140\208\189\208\190\208\181 \208\186\209\128\208\190\208\178\208\190\209\130\208\181\209\135\208\181\208\189\208\184\208\181.",
		["Longer and heavier than the katana: slower, but its hits take more poise and bleed more."] = "\208\148\208\187\208\184\208\189\208\189\208\181\208\181 \208\184 \209\130\209\143\208\182\208\181\208\187\208\181\208\181 \208\186\208\176\209\130\208\176\208\189\209\139: \208\188\208\181\208\180\208\187\208\181\208\189\208\189\208\181\208\181, \208\189\208\190 \208\181\208\179\208\190 \209\131\208\180\208\176\209\128\209\139 \208\190\209\130\208\189\208\184\208\188\208\176\209\142\209\130 \208\177\208\190\208\187\209\140\209\136\208\181 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184 \208\184 \208\178\209\139\208\183\209\139\208\178\208\176\209\142\209\130 \209\129\208\184\208\187\209\140\208\189\208\190\208\181 \208\186\209\128\208\190\208\178\208\190\209\130\208\181\209\135\208\181\208\189\208\184\208\181.",
		["Crimson rime. A keening at vespers. Kindled steel unsheathes me."] = "\208\145\208\176\208\179\209\128\209\143\208\189\209\139\208\185 \208\184\208\189\208\181\208\185. \208\159\208\187\208\176\209\135 \208\189\208\176 \208\178\208\181\209\135\208\181\209\128\208\189\208\181. \208\159\209\139\208\187\208\176\209\142\209\137\208\176\209\143 \209\129\209\130\208\176\208\187\209\140 \208\190\208\177\208\189\208\176\208\182\208\176\208\181\209\130 \208\188\208\181\208\189\209\143.",
		["+2.5% walk speed"] = "+2,5% \208\186 \209\129\208\186\208\190\209\128\208\190\209\129\209\130\208\184 \209\133\208\190\208\180\209\140\208\177\209\139",
		["Mirror polish, wavy temper line, clean bandages."] = "\208\151\208\181\209\128\208\186\208\176\208\187\209\140\208\189\208\176\209\143 \208\191\208\190\208\187\208\184\209\128\208\190\208\178\208\186\208\176, \208\178\208\190\208\187\208\189\208\184\209\129\209\130\209\139\208\185 \209\133\208\176\208\188\208\190\208\189, \209\135\208\184\209\129\209\130\209\139\208\181 \208\177\208\184\208\189\209\130\209\139.",
		["Store 2 dashes"] = "2 \209\128\209\139\208\178\208\186\208\176 \208\178 \208\183\208\176\208\191\208\176\209\129\208\181",
		["Black cord, gold collar, lacquered sheath."] = "\208\167\209\145\209\128\208\189\209\139\208\185 \209\136\208\189\209\131\209\128, \208\183\208\190\208\187\208\190\209\130\208\190\208\185 \209\133\208\176\208\177\208\176\208\186\208\184, \208\187\208\176\208\186\208\184\209\128\208\190\208\178\208\176\208\189\208\189\209\139\208\181 \208\189\208\190\208\182\208\189\209\139.",
		["Blade length 2.9 studs"] = "\208\148\208\187\208\184\208\189\208\176 \208\186\208\187\208\184\208\189\208\186\208\176 2.9 studs",
		["A groove down each side, red cord on the sheath."] = "\208\148\208\190\208\187 \209\129 \208\186\208\176\208\182\208\180\208\190\208\185 \209\129\209\130\208\190\209\128\208\190\208\189\209\139, \208\186\209\128\208\176\209\129\208\189\209\139\208\185 \209\136\208\189\209\131\209\128 \208\189\208\176 \208\189\208\190\208\182\208\189\208\176\209\133.",
		["Dark forged steel, black sheath."] = "\208\162\209\145\208\188\208\189\208\176\209\143 \208\186\208\190\208\178\208\176\208\189\208\176\209\143 \209\129\209\130\208\176\208\187\209\140, \209\135\209\145\209\128\208\189\209\139\208\181 \208\189\208\190\208\182\208\189\209\139.",
		["Quick wipe: both sides at once"] = "\208\145\209\139\209\129\209\130\209\128\208\176\209\143 \209\135\208\184\209\129\209\130\208\186\208\176: \208\190\208\177\208\181 \209\129\209\130\208\190\209\128\208\190\208\189\209\139 \209\129\209\128\208\176\208\183\209\131",
		["Gold guard, collar and pommel."] = "\208\151\208\190\208\187\208\190\209\130\209\139\208\181 \208\179\208\176\209\128\208\180\208\176, \209\133\208\176\208\177\208\176\208\186\208\184 \208\184 \208\189\208\176\208\178\208\181\209\128\209\136\208\184\208\181.",
		["Blade length 3.0 studs"] = "\208\148\208\187\208\184\208\189\208\176 \208\186\208\187\208\184\208\189\208\186\208\176 3.0 studs",
		["Gleaming silver, crescent-moon guard, white cord and sheath."] = "\208\161\208\184\209\143\209\142\209\137\208\181\208\181 \209\129\208\181\209\128\208\181\208\177\209\128\208\190, \208\179\208\176\209\128\208\180\208\176-\208\191\208\190\208\187\209\131\208\188\208\181\209\129\209\143\209\134, \208\177\208\181\208\187\209\139\208\181 \209\136\208\189\209\131\209\128 \208\184 \208\189\208\190\208\182\208\189\209\139.",
		["Store 3 dashes"] = "3 \209\128\209\139\208\178\208\186\208\176 \208\178 \208\183\208\176\208\191\208\176\209\129\208\181",
		["White metal fittings."] = "\208\145\208\181\208\187\208\176\209\143 \208\188\208\181\209\130\208\176\208\187\208\187\208\184\209\135\208\181\209\129\208\186\208\176\209\143 \209\132\209\131\209\128\208\189\208\184\209\130\209\131\209\128\208\176.",
		["+2.5% walk speed, 25% faster poise recovery"] = "+2,5% \208\186 \209\129\208\186\208\190\209\128\208\190\209\129\209\130\208\184 \209\133\208\190\208\180\209\140\208\177\209\139, \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\176\208\178\208\187\208\184\208\178\208\176\208\181\209\130\209\129\209\143 \208\189\208\176 25% \208\177\209\139\209\129\209\130\209\128\208\181\208\181",
		["Red cord, cherry-blossom ornaments, black tassel, red sheath with metal bands."] = "\208\154\209\128\208\176\209\129\208\189\209\139\208\185 \209\136\208\189\209\131\209\128, \209\131\208\186\209\128\208\176\209\136\208\181\208\189\208\184\209\143-\209\129\208\176\208\186\209\131\209\128\209\139, \209\135\209\145\209\128\208\189\208\176\209\143 \208\186\208\184\209\129\209\130\209\140, \208\186\209\128\208\176\209\129\208\189\209\139\208\181 \208\189\208\190\208\182\208\189\209\139 \209\129 \208\188\208\181\209\130\208\176\208\187\208\187\208\184\209\135\208\181\209\129\208\186\208\184\208\188\208\184 \208\186\208\190\208\187\209\140\209\134\208\176\208\188\208\184.",
		["Blade length 3.1 studs, draw styles (coming soon)"] = "\208\148\208\187\208\184\208\189\208\176 \208\186\208\187\208\184\208\189\208\186\208\176 3.1 studs, \209\129\209\130\208\184\208\187\208\184 \208\178\209\139\209\133\208\178\208\176\209\130\208\176 (\209\129\208\186\208\190\209\128\208\190)",
		["Pale gold fittings, four-lobed guard, faint red glow on the edge."] = "\208\145\208\187\208\181\208\180\208\189\208\190-\208\183\208\190\208\187\208\190\209\130\208\176\209\143 \209\132\209\131\209\128\208\189\208\184\209\130\209\131\209\128\208\176, \209\135\208\181\209\130\209\139\209\128\209\145\209\133\208\187\208\181\208\191\208\181\209\129\209\130\208\186\208\190\208\178\208\176\209\143 \208\179\208\176\209\128\208\180\208\176, \209\129\208\187\208\176\208\177\208\190\208\181 \208\186\209\128\208\176\209\129\208\189\208\190\208\181 \209\129\208\178\208\181\209\135\208\181\208\189\208\184\208\181 \208\187\208\181\208\183\208\178\208\184\209\143.",
		["Each hit that draws blood: +5 blood, +6 poise"] = "\208\154\208\176\208\182\208\180\209\139\208\185 \209\131\208\180\208\176\209\128 \208\180\208\190 \208\186\209\128\208\190\208\178\208\184: +5 \208\186\209\128\208\190\208\178\208\184, +6 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184",
		["Dark blade, crimson edge, red lightning."] = "\208\162\209\145\208\188\208\189\209\139\208\185 \208\186\208\187\208\184\208\189\208\190\208\186, \208\177\208\176\208\179\209\128\208\190\208\178\208\190\208\181 \208\187\208\181\208\183\208\178\208\184\208\181, \208\186\209\128\208\176\209\129\208\189\209\139\208\181 \208\188\208\190\208\187\208\189\208\184\208\184.",
		["No upgrades"] = "\208\145\208\181\208\183 \209\131\208\187\209\131\209\135\209\136\208\181\208\189\208\184\208\185",
		["Old bandages, a plain brown sheath."] = "\208\161\209\130\208\176\209\128\209\139\208\181 \208\177\208\184\208\189\209\130\209\139, \208\191\209\128\208\190\209\129\209\130\209\139\208\181 \208\186\208\190\209\128\208\184\209\135\208\189\208\181\208\178\209\139\208\181 \208\189\208\190\208\182\208\189\209\139.",
		["FLAMMABLE WAX"] = "\208\147\208\158\208\160\208\174\208\167\208\152\208\153 \208\146\208\158\208\161\208\154",
		["Wax obtained from the old merchant at the foot of the hill."] = "\208\146\208\190\209\129\208\186, \208\191\208\190\208\187\209\131\209\135\208\181\208\189\208\189\209\139\208\185 \208\190\209\130 \209\129\209\130\208\176\209\128\208\190\208\179\208\190 \209\130\208\190\209\128\208\179\208\190\208\178\209\134\208\176 \209\131 \208\191\208\190\208\180\208\189\208\190\208\182\208\184\209\143 \209\133\208\190\208\187\208\188\208\176.",
		["VENGEFUL EMPRESS: IZANAMI"] = "\208\156\208\161\208\162\208\152\208\162\208\149\208\155\208\172\208\157\208\144\208\175 \208\152\208\156\208\159\208\149\208\160\208\144\208\162\208\160\208\152\208\166\208\144: \208\152\208\148\208\151\208\144\208\157\208\144\208\156\208\152",
