        <Item class="ModuleScript" referent="RBX161">
          <Properties>
            <string name="Name">Appearance</string>
            <ProtectedString name="Source"><![CDATA[local v1 = require(script.Parent.Lang).mark
local v_u_2 = {
	["PARTS"] = {
		{
			["Part"] = "Head",
			["Label"] = nil,
			["Label"] = v1("HEAD")
		},
		{
			["Part"] = "Torso",
			["Label"] = nil,
			["Label"] = v1("TORSO")
		},
		{
			["Part"] = "Left Arm",
			["Label"] = nil,
			["Label"] = v1("LEFT ARM")
		},
		{
