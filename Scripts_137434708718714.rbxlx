		["no boost"] = "\208\177\208\181\208\183 \208\177\208\190\208\189\209\131\209\129\208\176",
		["{count} boost: +{walk} walk speed or +{other} to another stat"] = "{count} \208\177\208\190\208\189\209\131\209\129: +{walk} \208\186 \209\129\208\186\208\190\209\128\208\190\209\129\209\130\208\184 \209\133\208\190\208\180\209\140\208\177\209\139 \208\184\208\187\208\184 +{other} \208\186 \208\180\209\128\209\131\208\179\208\190\208\185 \209\133\208\176\209\128\208\176\208\186\209\130\208\181\209\128\208\184\209\129\209\130\208\184\208\186\208\181",
		["{count} boosts, each +{walk} walk speed or +{other} to another stat"] = "{count} \208\177\208\190\208\189\209\131\209\129\208\176, \208\186\208\176\208\182\208\180\209\139\208\185: +{walk} \208\186 \209\129\208\186\208\190\209\128\208\190\209\129\209\130\208\184 \209\133\208\190\208\180\209\140\208\177\209\139 \208\184\208\187\208\184 +{other} \208\186 \208\180\209\128\209\131\208\179\208\190\208\185 \209\133\208\176\209\128\208\176\208\186\209\130\208\181\209\128\208\184\209\129\209\130\208\184\208\186\208\181",
		["Safe zone: combat forbidden"] = "\208\145\208\181\208\183\208\190\208\191\208\176\209\129\208\189\208\176\209\143 \208\183\208\190\208\189\208\176: \208\177\208\190\208\185 \208\183\208\176\208\191\209\128\208\181\209\137\209\145\208\189",
		["Names and boosts"] = "\208\164\208\176\208\188\208\184\208\187\208\184\208\184 \208\184 \208\177\208\190\208\189\209\131\209\129\209\139",
		["<b>Family name</b>: rolled once, at the forge.\n<b>First name</b>: reroll any time on the character screen (CHARACTER, on the title screen).\n\nRarer family names give stat boosts. Boosts are kept small, so fights are still won with the blade."] = "<b>\208\164\208\176\208\188\208\184\208\187\208\184\209\143</b>: \208\178\209\139\208\191\208\176\208\180\208\176\208\181\209\130 \208\190\208\180\208\184\208\189 \209\128\208\176\208\183, \208\178 \208\186\209\131\208\183\208\189\208\184\209\134\208\181.\n<b>\208\152\208\188\209\143</b>: \208\188\208\190\208\182\208\189\208\190 \209\129\208\188\208\181\208\189\208\184\209\130\209\140 \208\186\208\190\208\179\208\180\208\176 \209\131\208\179\208\190\208\180\208\189\208\190 \208\189\208\176 \209\141\208\186\209\128\208\176\208\189\208\181 \208\191\208\181\209\128\209\129\208\190\208\189\208\176\208\182\208\176 (\208\159\208\149\208\160\208\161\208\158\208\157\208\144\208\150, \208\189\208\176 \208\179\208\187\208\176\208\178\208\189\208\190\208\188 \209\141\208\186\209\128\208\176\208\189\208\181).\n\n\208\145\208\190\208\187\208\181\208\181 \209\128\208\181\208\180\208\186\208\184\208\181 \209\132\208\176\208\188\208\184\208\187\208\184\208\184 \208\180\208\176\209\142\209\130 \208\177\208\190\208\189\209\131\209\129\209\139 \208\186 \209\133\208\176\209\128\208\176\208\186\209\130\208\181\209\128\208\184\209\129\209\130\208\184\208\186\208\176\208\188. \208\145\208\190\208\189\209\131\209\129\209\139 \209\129\208\180\208\181\208\187\208\176\208\189\209\139 \208\189\208\181\208\177\208\190\208\187\209\140\209\136\208\184\208\188\208\184, \209\135\209\130\208\190\208\177\209\139 \208\177\208\190\208\184 \208\178\209\129\209\145 \209\128\208\176\208\178\208\189\208\190 \209\128\208\181\209\136\208\176\208\187 \208\186\208\187\208\184\208\189\208\190\208\186.",
		["Rarity, odds and boosts:\n\n{rarities}\n\nThe rarest names belong to famous swordsmen and warlords. A Mythic name is a legend\'s own name, used in place of a family name. An Exotic name is a god\'s. Every spin is pure chance at these odds."] = "\208\160\208\181\208\180\208\186\208\190\209\129\209\130\209\140, \209\136\208\176\208\189\209\129\209\139 \208\184 \208\177\208\190\208\189\209\131\209\129\209\139:\n\n{rarities}\n\n\208\161\208\176\208\188\209\139\208\181 \209\128\208\181\208\180\208\186\208\184\208\181 \209\132\208\176\208\188\208\184\208\187\208\184\208\184 \208\191\209\128\208\184\208\189\208\176\208\180\208\187\208\181\208\182\208\176\209\130 \208\183\208\189\208\176\208\188\208\181\208\189\208\184\209\130\209\139\208\188 \208\188\208\181\209\135\208\189\208\184\208\186\208\176\208\188 \208\184 \208\191\208\190\208\187\208\186\208\190\208\178\208\190\208\180\209\134\208\176\208\188. \208\156\208\184\209\132\208\184\209\135\208\181\209\129\208\186\208\190\208\181 \208\184\208\188\209\143 \226\128\148 \209\141\209\130\208\190 \209\129\208\190\208\177\209\129\209\130\208\178\208\181\208\189\208\189\208\190\208\181 \208\184\208\188\209\143 \208\187\208\181\208\179\208\181\208\189\208\180\209\139, \208\184\209\129\208\191\208\190\208\187\209\140\208\183\209\131\208\181\208\188\208\190\208\181 \208\178\208\188\208\181\209\129\209\130\208\190 \209\132\208\176\208\188\208\184\208\187\208\184\208\184. \208\173\208\186\208\183\208\190\209\130\208\184\209\135\208\181\209\129\208\186\208\190\208\181 \208\184\208\188\209\143 \226\128\148 \208\184\208\188\209\143 \208\177\208\190\208\179\208\176. \208\154\208\176\208\182\208\180\209\139\208\185 \208\191\209\128\208\190\208\186\209\128\209\131\209\130 \226\128\148 \209\135\208\184\209\129\209\130\208\176\209\143 \209\129\208\187\209\131\209\135\208\176\208\185\208\189\208\190\209\129\209\130\209\140 \209\129 \209\141\209\130\208\184\208\188\208\184 \209\136\208\176\208\189\209\129\208\176\208\188\208\184.",
		["Boosts:\n\n<b>Walk speed</b>: faster movement.\n<b>Poise recovery</b>: poise refills faster.\n<b>Poise toughness</b>: all poise costs are lower.\n<b>Slower bleeding</b>: wounds and stumps bleed slower.\n<b>Faster dash recharge</b>: dash charges refill sooner.\n\nBoosts stack with forge upgrades."] = "\208\145\208\190\208\189\209\131\209\129\209\139:\n\n<b>\208\161\208\186\208\190\209\128\208\190\209\129\209\130\209\140 \209\133\208\190\208\180\209\140\208\177\209\139</b>: \208\177\208\190\208\187\208\181\208\181 \208\177\209\139\209\129\209\130\209\128\208\190\208\181 \208\191\208\181\209\128\208\181\208\180\208\178\208\184\208\182\208\181\208\189\208\184\208\181.\n<b>\208\146\208\190\209\129\209\129\209\130\208\176\208\189\208\190\208\178\208\187\208\181\208\189\208\184\208\181 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184</b>: \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\176\208\178\208\187\208\184\208\178\208\176\208\181\209\130\209\129\209\143 \208\177\209\139\209\129\209\130\209\128\208\181\208\181.\n<b>\208\159\209\128\208\190\209\135\208\189\208\190\209\129\209\130\209\140 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184</b>: \208\178\209\129\208\181 \208\183\208\176\209\130\209\128\208\176\209\130\209\139 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184 \208\189\208\184\208\182\208\181.\n<b>\208\151\208\176\208\188\208\181\208\180\208\187\208\181\208\189\208\184\208\181 \208\186\209\128\208\190\208\178\208\190\209\130\208\181\209\135\208\181\208\189\208\184\209\143</b>: \209\128\208\176\208\189\209\139 \208\184 \208\190\208\177\209\128\209\131\208\177\208\186\208\184 \208\186\209\128\208\190\208\178\208\190\209\130\208\190\209\135\208\176\209\130 \208\188\208\181\208\180\208\187\208\181\208\189\208\189\208\181\208\181.\n<b>\208\163\209\129\208\186\208\190\209\128\208\181\208\189\208\184\208\181 \208\191\208\181\209\128\208\181\208\183\208\176\209\128\209\143\208\180\208\186\208\184 \209\128\209\139\208\178\208\186\208\176</b>: \208\183\208\176\209\128\209\143\208\180\209\139 \209\128\209\139\208\178\208\186\208\176 \208\178\208\190\209\129\208\191\208\190\208\187\208\189\209\143\209\142\209\130\209\129\209\143 \208\177\209\139\209\129\209\130\209\128\208\181\208\181.\n\n\208\145\208\190\208\189\209\131\209\129\209\139 \209\129\208\186\208\187\208\176\208\180\209\139\208\178\208\176\209\142\209\130\209\129\209\143 \209\129 \209\131\208\187\209\131\209\135\209\136\208\181\208\189\208\184\209\143\208\188\208\184 \208\186\209\131\208\183\208\189\208\184\209\134\209\139.",
		["<b>Rename spins</b> reroll the family name. Get {spins} free spins every level, or buy more in the SHOP. Use them on the character screen. The old name can always be kept.\n\nBots have names too. The rarer a bot\'s name, the better it fights."] = "<b>\208\159\209\128\208\190\208\186\209\128\209\131\209\130\209\139 \209\132\208\176\208\188\208\184\208\187\208\184\208\184</b> \208\178\209\139\208\177\209\128\208\176\209\129\209\139\208\178\208\176\209\142\209\130 \209\132\208\176\208\188\208\184\208\187\208\184\209\142 \208\183\208\176\208\189\208\190\208\178\208\190. \208\159\208\190\208\187\209\131\209\135\208\176\208\185 {spins} \208\177\208\181\209\129\208\191\208\187\208\176\209\130\208\189\208\190 \208\183\208\176 \208\186\208\176\208\182\208\180\209\139\208\185 \209\131\209\128\208\190\208\178\208\181\208\189\209\140 \208\184\208\187\208\184 \208\180\208\190\208\186\209\131\208\191\208\176\208\185 \209\135\208\181\209\128\208\181\208\183 \208\156\208\144\208\147\208\144\208\151\208\152\208\157. \208\152\209\129\208\191\208\190\208\187\209\140\208\183\209\131\208\185 \208\184\209\133 \208\189\208\176 \209\141\208\186\209\128\208\176\208\189\208\181 \208\191\208\181\209\128\209\129\208\190\208\189\208\176\208\182\208\176. \208\161\209\130\208\176\209\128\209\131\209\142 \209\132\208\176\208\188\208\184\208\187\208\184\209\142 \208\178\209\129\208\181\208\179\208\180\208\176 \208\188\208\190\208\182\208\189\208\190 \208\190\209\129\209\130\208\176\208\178\208\184\209\130\209\140.\n\n\208\163 \208\177\208\190\209\130\208\190\208\178 \209\130\208\190\208\182\208\181 \208\181\209\129\209\130\209\140 \209\132\208\176\208\188\208\184\208\187\208\184\208\184. \208\167\208\181\208\188 \209\128\208\181\208\182\208\181 \209\132\208\176\208\188\208\184\208\187\208\184\209\143 \208\177\208\190\209\130\208\176, \209\130\208\181\208\188 \208\187\209\131\209\135\209\136\208\181 \208\190\208\189 \208\180\208\181\209\128\209\145\209\130\209\129\209\143.",
		["Poise"] = "\208\161\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140",
		["<b>Poise</b> is a fighter\'s steadiness. The poise bar is the thin bar above the blood squares; an opponent\'s is under their name. It grows from the middle as poise is lost, turning from gold to red, and hides at full poise."] = "<b>\208\161\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140</b> \226\128\148 \209\141\209\130\208\190 \209\131\209\129\209\130\208\190\208\185\209\135\208\184\208\178\208\190\209\129\209\130\209\140 \208\177\208\190\208\185\209\134\208\176. \208\159\208\190\208\187\208\190\209\129\208\186\208\176 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184 \226\128\148 \209\130\208\190\208\189\208\186\208\176\209\143 \208\191\208\190\208\187\208\190\209\129\208\186\208\176 \208\189\208\176\208\180 \208\186\208\178\208\176\208\180\209\128\208\176\209\130\208\184\208\186\208\176\208\188\208\184 \208\186\209\128\208\190\208\178\208\184; \209\131 \209\129\208\190\208\191\208\181\209\128\208\189\208\184\208\186\208\176 \208\190\208\189\208\176 \208\191\208\190\208\180 \208\181\208\179\208\190 \208\184\208\188\208\181\208\189\208\181\208\188. \208\158\208\189\208\176 \209\128\208\176\209\129\209\130\209\145\209\130 \208\190\209\130 \209\129\208\181\209\128\208\181\208\180\208\184\208\189\209\139 \208\191\208\190 \208\188\208\181\209\128\208\181 \208\191\208\190\209\130\208\181\209\128\208\184 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184, \208\188\208\181\208\189\209\143\209\143 \209\134\208\178\208\181\209\130 \209\129 \208\183\208\190\208\187\208\190\209\130\208\190\208\179\208\190 \208\189\208\176 \208\186\209\128\208\176\209\129\208\189\209\139\208\185, \208\184 \209\129\208\186\209\128\209\139\208\178\208\176\208\181\209\130\209\129\209\143 \208\191\209\128\208\184 \208\191\208\190\208\187\208\189\208\190\208\185 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184.",
		["Poise costs:\n\n<b>Draw-cut</b>: {draw}.  <b>Blade hit by a draw-cut</b>: {block}.\n<b>Hard swing</b>: {swing}.  <b>Dash</b>: {dash}.  <b>Kick</b>: {kick}.\n<b>Taking a cut</b>: {wound} (double from a draw-cut), plus blood loss.\n<b>Clashes</b>: more the harder the blade is knocked."] = "\208\151\208\176\209\130\209\128\208\176\209\130\209\139 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184:\n\n<b>\208\163\208\180\208\176\209\128 \209\129 \208\178\209\139\209\133\208\178\208\176\209\130\208\176</b>: {draw}.  <b>\208\154\208\187\208\184\208\189\208\190\208\186, \208\191\209\128\208\184\208\189\209\143\208\178\209\136\208\184\208\185 \209\131\208\180\208\176\209\128 \209\129 \208\178\209\139\209\133\208\178\208\176\209\130\208\176</b>: {block}.\n<b>\208\161\208\184\208\187\209\140\208\189\209\139\208\185 \208\178\208\183\208\188\208\176\209\133</b>: {swing}.  <b>\208\160\209\139\208\178\208\190\208\186</b>: {dash}.  <b>\208\159\208\184\208\189\208\190\208\186</b>: {kick}.\n<b>\208\159\208\190\208\187\209\131\209\135\208\181\208\189\208\189\209\139\208\185 \208\191\208\190\209\128\208\181\208\183</b>: {wound} (\208\178\208\180\208\178\208\190\208\181 \208\177\208\190\208\187\209\140\209\136\208\181 \208\190\209\130 \209\131\208\180\208\176\209\128\208\176 \209\129 \208\178\209\139\209\133\208\178\208\176\209\130\208\176), \208\191\208\187\209\142\209\129 \208\191\208\190\209\130\208\181\209\128\209\143 \208\186\209\128\208\190\208\178\208\184.\n<b>\208\161\209\130\208\190\208\187\208\186\208\189\208\190\208\178\208\181\208\189\208\184\209\143 \208\186\208\187\208\184\208\189\208\186\208\190\208\178</b>: \209\130\208\181\208\188 \208\177\208\190\208\187\209\140\209\136\208\181, \209\135\208\181\208\188 \209\129\208\184\208\187\209\140\208\189\208\181\208\181 \208\190\209\130\208\177\208\184\209\130 \208\186\208\187\208\184\208\189\208\190\208\186.",
		["Poise refills after {delay} seconds with no poise lost, at {regen} per second. A still guard (L2 on a gamepad) refills it faster; low blood refills it slower.\n\nBelow half poise, blade and movement speed drop, and the blade is knocked aside more easily."] = "\208\161\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\176\208\178\208\187\208\184\208\178\208\176\208\181\209\130\209\129\209\143 \209\135\208\181\209\128\208\181\208\183 {delay} \209\129\208\181\208\186. \208\177\208\181\208\183 \208\191\208\190\209\130\208\181\209\128\208\184 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184, \208\191\208\190 {regen} \208\178 \209\129\208\181\208\186\209\131\208\189\208\180\209\131. \208\157\208\181\208\191\208\190\208\180\208\178\208\184\208\182\208\189\209\139\208\185 \208\177\208\187\208\190\208\186 (L2 \208\189\208\176 \208\179\208\181\208\185\208\188\208\191\208\176\208\180\208\181) \209\131\209\129\208\186\208\190\209\128\209\143\208\181\209\130 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\190\208\178\208\187\208\181\208\189\208\184\208\181, \208\176 \208\189\208\181\209\133\208\178\208\176\209\130\208\186\208\176 \208\186\209\128\208\190\208\178\208\184 \208\183\208\176\208\188\208\181\208\180\208\187\209\143\208\181\209\130 \208\181\208\179\208\190.\n\n\208\157\208\184\208\182\208\181 \208\191\208\190\208\187\208\190\208\178\208\184\208\189\209\139 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184 \209\129\208\186\208\190\209\128\208\190\209\129\209\130\209\140 \208\186\208\187\208\184\208\189\208\186\208\176 \208\184 \208\191\208\181\209\128\208\181\208\180\208\178\208\184\208\182\208\181\208\189\208\184\209\143 \208\191\208\176\208\180\208\176\208\181\209\130, \208\176 \208\186\208\187\208\184\208\189\208\190\208\186 \208\187\208\181\208\179\209\135\208\181 \208\190\209\130\208\177\208\184\209\130\209\140 \208\178 \209\129\209\130\208\190\209\128\208\190\208\189\209\131.",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> ({Wipe}). See the next scroll."] = "\208\157\208\176 \208\189\209\131\208\187\208\181 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140 <b>\208\187\208\190\208\188\208\176\208\181\209\130\209\129\209\143</b>: \208\190\208\179\208\187\209\131\209\136\208\181\208\189\208\184\208\181 \208\189\208\176 {stagger} \209\129\208\181\208\186., \208\183\208\176\209\130\208\181\208\188 \208\190\209\129\208\187\208\176\208\177\208\187\208\181\208\189\208\184\208\181 \208\189\208\176 {weakened} \209\129\208\181\208\186. (\208\189\208\176 {slower} \208\188\208\181\208\180\208\187\208\181\208\189\208\189\208\181\208\181, \208\190\208\180\209\139\209\136\208\186\208\176, \208\186\209\128\208\176\209\143 \209\141\208\186\209\128\208\176\208\189\208\176 \209\130\208\181\208\188\208\189\208\181\209\142\209\130). \208\159\208\190\209\130\208\190\208\188 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\176\208\178\208\187\208\184\208\178\208\176\208\181\209\130\209\129\209\143 \208\180\208\190 \208\191\208\190\208\187\208\190\208\178\208\184\208\189\209\139.\n\n\208\145\209\139\209\129\209\130\209\128\208\181\208\181 \208\178\209\129\208\181\208\179\208\190 \208\178\208\181\209\128\208\189\209\131\209\130\209\140 \208\191\208\190\208\187\208\189\209\131\209\142 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140 \226\128\148 <b>\208\191\208\190\209\135\208\184\209\129\209\130\208\184\209\130\209\140 \208\186\208\187\208\184\208\189\208\190\208\186</b> ({Wipe}). \208\161\208\188\208\190\209\130\209\128\208\184 \209\129\208\187\208\181\208\180\209\131\209\142\209\137\208\184\208\185 \209\129\208\178\208\184\209\130\208\190\208\186.",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> (WIPE). See the next scroll."] = "\208\157\208\176 \208\189\209\131\208\187\208\181 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140 <b>\208\187\208\190\208\188\208\176\208\181\209\130\209\129\209\143</b>: \208\190\208\179\208\187\209\131\209\136\208\181\208\189\208\184\208\181 \208\189\208\176 {stagger} \209\129\208\181\208\186., \208\183\208\176\209\130\208\181\208\188 \208\190\209\129\208\187\208\176\208\177\208\187\208\181\208\189\208\184\208\181 \208\189\208\176 {weakened} \209\129\208\181\208\186. (\208\189\208\176 {slower} \208\188\208\181\208\180\208\187\208\181\208\189\208\189\208\181\208\181, \208\190\208\180\209\139\209\136\208\186\208\176, \208\186\209\128\208\176\209\143 \209\141\208\186\209\128\208\176\208\189\208\176 \209\130\208\181\208\188\208\189\208\181\209\142\209\130). \208\159\208\190\209\130\208\190\208\188 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\176\208\178\208\187\208\184\208\178\208\176\208\181\209\130\209\129\209\143 \208\180\208\190 \208\191\208\190\208\187\208\190\208\178\208\184\208\189\209\139.\n\n\208\145\209\139\209\129\209\130\209\128\208\181\208\181 \208\178\209\129\208\181\208\179\208\190 \208\178\208\181\209\128\208\189\209\131\209\130\209\140 \208\191\208\190\208\187\208\189\209\131\209\142 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140 \226\128\148 <b>\208\191\208\190\209\135\208\184\209\129\209\130\208\184\209\130\209\140 \208\186\208\187\208\184\208\189\208\190\208\186</b> (\208\167\208\152\208\161\208\162\208\154\208\144). \208\161\208\188\208\190\209\130\209\128\208\184 \209\129\208\187\208\181\208\180\209\131\209\142\209\137\208\184\208\185 \209\129\208\178\208\184\209\130\208\190\208\186.",
		["Wiping the blade"] = "\208\167\208\184\209\129\209\130\208\186\208\176 \208\186\208\187\208\184\208\189\208\186\208\176",
		["Cuts leave blood on the blade. With the blade drawn, press <b>{Wipe}</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "\208\159\208\190\209\128\208\181\208\183\209\139 \208\190\209\129\209\130\208\176\208\178\208\187\209\143\209\142\209\130 \208\186\209\128\208\190\208\178\209\140 \208\189\208\176 \208\186\208\187\208\184\208\189\208\186\208\181. \208\154\208\190\208\179\208\180\208\176 \208\186\208\187\208\184\208\189\208\190\208\186 \208\190\208\177\208\189\208\176\208\182\209\145\208\189, \208\189\208\176\208\182\208\188\208\184 <b>{Wipe}</b>, \209\135\209\130\208\190\208\177\209\139 \208\191\209\128\208\190\209\130\208\181\209\128\208\181\209\130\209\140 \208\181\208\179\208\190 \209\130\208\186\208\176\208\189\209\140\209\142: \208\190\208\180\208\189\209\131 \209\129\209\130\208\190\209\128\208\190\208\189\209\131, \208\191\208\190\209\130\208\190\208\188 \208\180\209\128\209\131\208\179\209\131\209\142. \208\167\208\184\209\129\209\130\208\186\208\176 \208\183\208\176\208\189\208\184\208\188\208\176\208\181\209\130 \208\190\208\186\208\190\208\187\208\190 {time} \209\129\208\181\208\186.",
		["<b>Wiping restores poise.</b> During a wipe, poise refills at {times}x speed, and a finished wipe fills it to full.\n\nAfter a poise break, a finished wipe also ends the weakened state."] = "<b>\208\167\208\184\209\129\209\130\208\186\208\176 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\176\208\178\208\187\208\184\208\178\208\176\208\181\209\130 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140.</b> \208\146\208\190 \208\178\209\128\208\181\208\188\209\143 \209\135\208\184\209\129\209\130\208\186\208\184 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140 \208\178\208\190\209\129\208\191\208\190\208\187\208\189\209\143\208\181\209\130\209\129\209\143 \209\129\208\190 \209\129\208\186\208\190\209\128\208\190\209\129\209\130\209\140\209\142 \195\151{times}, \208\176 \208\183\208\176\208\186\208\190\208\189\209\135\208\181\208\189\208\189\208\176\209\143 \209\135\208\184\209\129\209\130\208\186\208\176 \208\183\208\176\208\191\208\190\208\187\208\189\209\143\208\181\209\130 \208\181\209\145 \208\180\208\190 \208\186\208\190\208\189\209\134\208\176.\n\n\208\159\208\190\209\129\208\187\208\181 \209\129\208\187\208\190\208\188\208\176 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184 \208\183\208\176\208\186\208\190\208\189\209\135\208\181\208\189\208\189\208\176\209\143 \209\135\208\184\209\129\209\130\208\186\208\176 \209\130\208\176\208\186\208\182\208\181 \209\129\208\189\208\184\208\188\208\176\208\181\209\130 \208\190\209\129\208\187\208\176\208\177\208\187\208\181\208\189\208\184\208\181.",
		["<b>Wiping leaves an opening.</b> Once a wipe starts, steering, guarding and cutting are locked until it ends, and a swing into the loose blade knocks it far aside. Losing poise mid-wipe cancels the full refill.\n\nBots punish wipes. Make some distance first.\n\nA later forge rank unlocks a quicker wipe."] = "<b>\208\167\208\184\209\129\209\130\208\186\208\176 \208\190\209\129\209\130\208\176\208\178\208\187\209\143\208\181\209\130 \208\177\209\128\208\181\209\136\209\140 \208\178 \208\183\208\176\209\137\208\184\209\130\208\181.</b> \208\154\208\176\208\186 \209\130\208\190\208\187\209\140\208\186\208\190 \209\135\208\184\209\129\209\130\208\186\208\176 \208\189\208\176\209\135\208\176\208\187\208\176\209\129\209\140, \209\131\208\191\209\128\208\176\208\178\208\187\208\181\208\189\208\184\208\181 \208\186\208\187\208\184\208\189\208\186\208\190\208\188, \208\177\208\187\208\190\208\186 \208\184 \209\131\208\180\208\176\209\128\209\139 \208\189\208\181\208\180\208\190\209\129\209\130\209\131\208\191\208\189\209\139 \208\180\208\190 \208\181\209\145 \208\186\208\190\208\189\209\134\208\176, \208\176 \209\131\208\180\208\176\209\128 \208\191\208\190 \209\128\208\176\209\129\209\129\208\187\208\176\208\177\208\187\208\181\208\189\208\189\208\190\208\188\209\131 \208\186\208\187\208\184\208\189\208\186\209\131 \208\190\209\130\208\177\209\128\208\176\209\129\209\139\208\178\208\176\208\181\209\130 \208\181\208\179\208\190 \208\180\208\176\208\187\208\181\208\186\208\190 \208\178 \209\129\209\130\208\190\209\128\208\190\208\189\209\131. \208\159\208\190\209\130\208\181\209\128\209\143 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184 \208\191\208\190\209\129\209\128\208\181\208\180\208\184 \209\135\208\184\209\129\209\130\208\186\208\184 \208\190\209\130\208\188\208\181\208\189\209\143\208\181\209\130 \208\191\208\190\208\187\208\189\208\190\208\181 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\190\208\178\208\187\208\181\208\189\208\184\208\181.\n\n\208\145\208\190\209\130\209\139 \208\189\208\176\208\186\208\176\208\183\209\139\208\178\208\176\209\142\209\130 \208\183\208\176 \209\135\208\184\209\129\209\130\208\186\209\131. \208\161\208\189\208\176\209\135\208\176\208\187\208\176 \208\190\209\130\208\190\208\185\208\180\208\184 \208\191\208\190\208\180\208\176\208\187\209\140\209\136\208\181.\n\n\208\145\208\190\208\187\208\181\208\181 \208\178\209\139\209\129\208\190\208\186\208\184\208\185 \209\128\208\176\208\189\208\179 \208\186\208\190\208\178\208\186\208\184 \208\190\209\130\208\186\209\128\209\139\208\178\208\176\208\181\209\130 \208\177\209\139\209\129\209\130\209\128\209\131\209\142 \209\135\208\184\209\129\209\130\208\186\209\131.",
		["Cuts leave blood on the blade. With the blade drawn, tap <b>WIPE</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "\208\159\208\190\209\128\208\181\208\183\209\139 \208\190\209\129\209\130\208\176\208\178\208\187\209\143\209\142\209\130 \208\186\209\128\208\190\208\178\209\140 \208\189\208\176 \208\186\208\187\208\184\208\189\208\186\208\181. \208\154\208\190\208\179\208\180\208\176 \208\186\208\187\208\184\208\189\208\190\208\186 \208\190\208\177\208\189\208\176\208\182\209\145\208\189, \208\189\208\176\208\182\208\188\208\184 <b>\208\167\208\152\208\161\208\162\208\154\208\144</b>, \209\135\209\130\208\190\208\177\209\139 \208\191\209\128\208\190\209\130\208\181\209\128\208\181\209\130\209\140 \208\181\208\179\208\190 \209\130\208\186\208\176\208\189\209\140\209\142: \208\190\208\180\208\189\209\131 \209\129\209\130\208\190\209\128\208\190\208\189\209\131, \208\191\208\190\209\130\208\190\208\188 \208\180\209\128\209\131\208\179\209\131\209\142. \208\167\208\184\209\129\209\130\208\186\208\176 \208\183\208\176\208\189\208\184\208\188\208\176\208\181\209\130 \208\190\208\186\208\190\208\187\208\190 {time} \209\129\208\181\208\186.",
		["Drawing the sword"] = "\208\146\209\139\209\133\208\178\208\176\209\130 \208\188\208\181\209\135\208\176",
		["The sword starts sheathed, with a hand on the sheath, ready to draw.\n\n<b>{Lock}</b>: toggle lock-on. While locked on, the mouse picks the cut; its name shows at the bottom of the screen.\n<b>{NextTarget}</b>: switch target.\n<b>{Unequip}</b>: unequip the sword. <b>{Equip}</b>: equip it again."] = "\208\152\208\183\208\189\208\176\209\135\208\176\208\187\209\140\208\189\208\190 \208\188\208\181\209\135 \208\178 \208\189\208\190\208\182\208\189\208\176\209\133, \209\128\209\131\208\186\208\176 \208\187\208\181\208\182\208\184\209\130 \208\189\208\176 \208\189\208\190\208\182\208\189\208\176\209\133, \208\178\209\129\209\145 \208\179\208\190\209\130\208\190\208\178\208\190 \208\186 \208\178\209\139\209\133\208\178\208\176\209\130\209\131.\n\n<b>{Lock}</b>: \208\178\208\186\208\187\209\142\209\135\208\184\209\130\209\140 \208\184\208\187\208\184 \208\178\209\139\208\186\208\187\209\142\209\135\208\184\209\130\209\140 \208\183\208\176\209\133\208\178\208\176\209\130 \209\134\208\181\208\187\208\184. \208\159\209\128\208\184 \208\183\208\176\209\133\208\178\208\176\209\130\208\181 \208\188\209\139\209\136\209\140 \208\178\209\139\208\177\208\184\209\128\208\176\208\181\209\130 \209\131\208\180\208\176\209\128; \208\181\208\179\208\190 \208\189\208\176\208\183\208\178\208\176\208\189\208\184\208\181 \208\191\208\190\208\186\208\176\208\183\208\176\208\189\208\190 \208\178\208\189\208\184\208\183\209\131 \209\141\208\186\209\128\208\176\208\189\208\176.\n<b>{NextTarget}</b>: \209\129\208\188\208\181\208\189\208\184\209\130\209\140 \209\134\208\181\208\187\209\140.\n<b>{Unequip}</b>: \209\129\208\189\209\143\209\130\209\140 \208\188\208\181\209\135. <b>{Equip}</b>: \209\129\208\189\208\190\208\178\208\176 \208\178\208\183\209\143\209\130\209\140 \208\181\208\179\208\190.",
		["Move the mouse to pick the cut, then hold {Draw} and swipe:\n\n<b>Down-left</b>, swipe up-right: low cut.\n<b>Left</b>, swipe right: horizontal slice.\n<b>Up-left</b>, swipe down-right: diagonal cut.\n<b>Up</b>, swipe down: vertical slice.\n\nA faster swipe makes a faster cut.\n\n<b>{CalmDraw}</b>: calm draw. The blade slides out slowly into a guard, with no cut."] = "\208\161\208\180\208\178\208\184\208\189\209\140 \208\188\209\139\209\136\209\140, \209\135\209\130\208\190\208\177\209\139 \208\178\209\139\208\177\209\128\208\176\209\130\209\140 \209\131\208\180\208\176\209\128, \208\183\208\176\209\130\208\181\208\188 \208\183\208\176\208\182\208\188\208\184 {Draw} \208\184 \208\188\208\176\209\133\208\189\208\184:\n\n<b>\208\146\208\187\208\181\208\178\208\190-\208\178\208\189\208\184\208\183</b>, \208\188\208\176\209\133\208\189\208\184 \208\178\208\191\209\128\208\176\208\178\208\190-\208\178\208\178\208\181\209\128\209\133: \208\189\208\184\208\182\208\189\208\184\208\185 \209\131\208\180\208\176\209\128.\n<b>\208\146\208\187\208\181\208\178\208\190</b>, \208\188\208\176\209\133\208\189\208\184 \208\178\208\191\209\128\208\176\208\178\208\190: \208\179\208\190\209\128\208\184\208\183\208\190\208\189\209\130\208\176\208\187\209\140\208\189\209\139\208\185 \209\131\208\180\208\176\209\128.\n<b>\208\146\208\187\208\181\208\178\208\190-\208\178\208\178\208\181\209\128\209\133</b>, \208\188\208\176\209\133\208\189\208\184 \208\178\208\191\209\128\208\176\208\178\208\190-\208\178\208\189\208\184\208\183: \208\180\208\184\208\176\208\179\208\190\208\189\208\176\208\187\209\140\208\189\209\139\208\185 \209\131\208\180\208\176\209\128.\n<b>\208\146\208\178\208\181\209\128\209\133</b>, \208\188\208\176\209\133\208\189\208\184 \208\178\208\189\208\184\208\183: \208\178\208\181\209\128\209\130\208\184\208\186\208\176\208\187\209\140\208\189\209\139\208\185 \209\131\208\180\208\176\209\128.\n\n\208\167\208\181\208\188 \208\177\209\139\209\129\209\130\209\128\208\181\208\181 \208\178\208\183\208\188\208\176\209\133, \209\130\208\181\208\188 \208\177\209\139\209\129\209\130\209\128\208\181\208\181 \209\131\208\180\208\176\209\128.\n\n<b>{CalmDraw}</b>: \209\130\208\184\209\133\208\184\208\185 \208\178\209\139\209\133\208\178\208\176\209\130. \208\154\208\187\208\184\208\189\208\190\208\186 \208\188\208\181\208\180\208\187\208\181\208\189\208\189\208\190 \208\178\209\139\209\133\208\190\208\180\208\184\209\130 \208\178 \208\177\208\190\208\181\208\178\209\131\209\142 \209\129\209\130\208\190\208\185\208\186\209\131, \208\177\208\181\208\183 \209\131\208\180\208\176\209\128\208\176.",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>{Equip}</b>: put the blade away. The next draw is ready about a second later."] = "\208\163\208\180\208\176\209\128\209\139 \209\129 \208\178\209\139\209\133\208\178\208\176\209\130\208\176 \208\180\208\181\209\128\208\182\208\176\209\130\209\129\209\143 \208\186\209\128\208\181\208\191\208\186\208\190. \208\154\208\187\208\184\208\189\208\190\208\186, \208\191\209\128\208\184\208\189\209\143\208\178\209\136\208\184\208\185 \209\131\208\180\208\176\209\128 \209\129 \208\178\209\139\209\133\208\178\208\176\209\130\208\176, \208\190\209\130\208\187\208\181\209\130\208\176\208\181\209\130 \208\178 \209\129\209\130\208\190\209\128\208\190\208\189\209\131 \208\184 \209\130\208\181\209\128\209\143\208\181\209\130 {block} \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184. \208\154\208\176\208\182\208\180\209\139\208\185 \209\131\208\180\208\176\209\128 \209\129 \208\178\209\139\209\133\208\178\208\176\209\130\208\176 \209\129\209\130\208\190\208\184\209\130 {draw} \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184.\n\n<b>{Equip}</b>: \209\131\208\177\209\128\208\176\209\130\209\140 \208\186\208\187\208\184\208\189\208\190\208\186 \208\178 \208\189\208\190\208\182\208\189\209\139. \208\161\208\187\208\181\208\180\209\131\209\142\209\137\208\184\208\185 \208\178\209\139\209\133\208\178\208\176\209\130 \208\179\208\190\209\130\208\190\208\178 \208\191\209\128\208\184\208\188\208\181\209\128\208\189\208\190 \209\135\208\181\209\128\208\181\208\183 \209\129\208\181\208\186\209\131\208\189\208\180\209\131.",
		["The sword starts sheathed, with a hand on the sheath, ready to draw. While locked on, a slow drag on the right side of the screen moves the hand on the sheath, and a quick <b>flick</b> draws. The flick\'s direction picks the cut.\n\n<b>LOCKED ON</b>: tap to switch target, hold to turn lock-on off. <b>LOCK ON</b>: tap to turn it back on.\n<b>UNEQUIP</b>: hold to unequip the sword. <b>EQUIP</b>: tap to equip it again."] = "\208\152\208\183\208\189\208\176\209\135\208\176\208\187\209\140\208\189\208\190 \208\188\208\181\209\135 \208\178 \208\189\208\190\208\182\208\189\208\176\209\133, \209\128\209\131\208\186\208\176 \208\187\208\181\208\182\208\184\209\130 \208\189\208\176 \208\189\208\190\208\182\208\189\208\176\209\133, \208\178\209\129\209\145 \208\179\208\190\209\130\208\190\208\178\208\190 \208\186 \208\178\209\139\209\133\208\178\208\176\209\130\209\131. \208\159\209\128\208\184 \208\183\208\176\209\133\208\178\208\176\209\130\208\181 \209\134\208\181\208\187\208\184 \208\188\208\181\208\180\208\187\208\181\208\189\208\189\208\190\208\181 \208\178\208\181\208\180\208\181\208\189\208\184\208\181 \208\191\208\176\208\187\209\140\209\134\208\181\208\188 \208\191\208\190 \208\191\209\128\208\176\208\178\208\190\208\185 \209\135\208\176\209\129\209\130\208\184 \209\141\208\186\209\128\208\176\208\189\208\176 \208\191\208\181\209\128\208\181\208\188\208\181\209\137\208\176\208\181\209\130 \209\128\209\131\208\186\209\131 \208\189\208\176 \208\189\208\190\208\182\208\189\208\176\209\133, \208\176 \208\177\209\139\209\129\209\130\209\128\209\139\208\185 <b>\209\129\208\178\208\176\208\185\208\191</b> \208\178\209\139\209\133\208\178\208\176\209\130\209\139\208\178\208\176\208\181\209\130 \208\188\208\181\209\135. \208\157\208\176\208\191\209\128\208\176\208\178\208\187\208\181\208\189\208\184\208\181 \209\129\208\178\208\176\208\185\208\191\208\176 \208\178\209\139\208\177\208\184\209\128\208\176\208\181\209\130 \209\131\208\180\208\176\209\128.\n\n<b>\208\151\208\144\208\165\208\146\208\144\208\167\208\149\208\157</b>: \208\189\208\176\208\182\208\188\208\184, \209\135\209\130\208\190\208\177\209\139 \209\129\208\188\208\181\208\189\208\184\209\130\209\140 \209\134\208\181\208\187\209\140; \209\131\208\180\208\181\209\128\208\182\208\184\208\178\208\176\208\185, \209\135\209\130\208\190\208\177\209\139 \208\178\209\139\208\186\208\187\209\142\209\135\208\184\209\130\209\140 \208\183\208\176\209\133\208\178\208\176\209\130. <b>\208\151\208\144\208\165\208\146\208\144\208\162</b>: \208\189\208\176\208\182\208\188\208\184, \209\135\209\130\208\190\208\177\209\139 \209\129\208\189\208\190\208\178\208\176 \208\178\208\186\208\187\209\142\209\135\208\184\209\130\209\140 \208\183\208\176\209\133\208\178\208\176\209\130.\n<b>\208\161\208\157\208\175\208\162\208\172</b>: \209\131\208\180\208\181\209\128\208\182\208\184\208\178\208\176\208\185, \209\135\209\130\208\190\208\177\209\139 \209\129\208\189\209\143\209\130\209\140 \208\188\208\181\209\135. <b>\208\146\208\151\208\175\208\162\208\172</b>: \208\189\208\176\208\182\208\188\208\184, \209\135\209\130\208\190\208\177\209\139 \209\129\208\189\208\190\208\178\208\176 \208\178\208\183\209\143\209\130\209\140 \208\181\208\179\208\190.",
		["<b>Flick right</b>: horizontal slice.\n<b>Flick down</b>: vertical slice.\n<b>Flick up-right</b>: low cut.\n\n<b>CALM DRAW</b>: the blade slides out slowly into a guard, with no cut."] = "<b>\208\161\208\178\208\176\208\185\208\191 \208\178\208\191\209\128\208\176\208\178\208\190</b>: \208\179\208\190\209\128\208\184\208\183\208\190\208\189\209\130\208\176\208\187\209\140\208\189\209\139\208\185 \209\131\208\180\208\176\209\128.\n<b>\208\161\208\178\208\176\208\185\208\191 \208\178\208\189\208\184\208\183</b>: \208\178\208\181\209\128\209\130\208\184\208\186\208\176\208\187\209\140\208\189\209\139\208\185 \209\131\208\180\208\176\209\128.\n<b>\208\161\208\178\208\176\208\185\208\191 \208\178\208\191\209\128\208\176\208\178\208\190-\208\178\208\178\208\181\209\128\209\133</b>: \208\189\208\184\208\182\208\189\208\184\208\185 \209\131\208\180\208\176\209\128.\n\n<b>\208\162\208\152\208\165\208\152\208\153 \208\146\208\171\208\165\208\146\208\144\208\162</b>: \208\186\208\187\208\184\208\189\208\190\208\186 \208\188\208\181\208\180\208\187\208\181\208\189\208\189\208\190 \208\178\209\139\209\133\208\190\208\180\208\184\209\130 \208\178 \208\177\208\190\208\181\208\178\209\131\209\142 \209\129\209\130\208\190\208\185\208\186\209\131, \208\177\208\181\208\183 \209\131\208\180\208\176\209\128\208\176.",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>SHEATHE</b>: put the blade away. The next draw is ready about a second later."] = "\208\163\208\180\208\176\209\128\209\139 \209\129 \208\178\209\139\209\133\208\178\208\176\209\130\208\176 \208\180\208\181\209\128\208\182\208\176\209\130\209\129\209\143 \208\186\209\128\208\181\208\191\208\186\208\190. \208\154\208\187\208\184\208\189\208\190\208\186, \208\191\209\128\208\184\208\189\209\143\208\178\209\136\208\184\208\185 \209\131\208\180\208\176\209\128 \209\129 \208\178\209\139\209\133\208\178\208\176\209\130\208\176, \208\190\209\130\208\187\208\181\209\130\208\176\208\181\209\130 \208\178 \209\129\209\130\208\190\209\128\208\190\208\189\209\131 \208\184 \209\130\208\181\209\128\209\143\208\181\209\130 {block} \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184. \208\154\208\176\208\182\208\180\209\139\208\185 \209\131\208\180\208\176\209\128 \209\129 \208\178\209\139\209\133\208\178\208\176\209\130\208\176 \209\129\209\130\208\190\208\184\209\130 {draw} \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184.\n\n<b>\208\146 \208\157\208\158\208\150\208\157\208\171</b>: \209\131\208\177\209\128\208\176\209\130\209\140 \208\186\208\187\208\184\208\189\208\190\208\186. \208\161\208\187\208\181\208\180\209\131\209\142\209\137\208\184\208\185 \208\178\209\139\209\133\208\178\208\176\209\130 \208\179\208\190\209\130\208\190\208\178 \208\191\209\128\208\184\208\188\208\181\209\128\208\189\208\190 \209\135\208\181\209\128\208\181\208\183 \209\129\208\181\208\186\209\131\208\189\208\180\209\131.",
		["Clashes and parries"] = "\208\161\209\130\208\190\208\187\208\186\208\189\208\190\208\178\208\181\208\189\208\184\209\143 \208\184 \208\191\208\176\209\128\208\184\209\128\208\190\208\178\208\176\208\189\208\184\209\143",
		["Blades that meet push each other apart, and the firmer blade moves less. A hard swing knocks a still blade far aside, and that blade is slow to recover: an opening to attack.\n\nHit near the hands, a blade barely moves. Hit near the tip, it\'s knocked aside easily."] = "\208\161\209\130\208\190\208\187\208\186\208\189\209\131\208\178\209\136\208\184\208\181\209\129\209\143 \208\186\208\187\208\184\208\189\208\186\208\184 \208\190\209\130\209\130\208\176\208\187\208\186\208\184\208\178\208\176\209\142\209\130 \208\180\209\128\209\131\208\179 \208\180\209\128\209\131\208\179\208\176, \208\184 \208\186\208\187\208\184\208\189\208\190\208\186, \208\186\208\190\209\130\208\190\209\128\209\139\208\185 \208\180\208\181\209\128\208\182\208\176\209\130 \208\186\209\128\208\181\208\191\209\135\208\181, \209\129\208\180\208\178\208\184\208\179\208\176\208\181\209\130\209\129\209\143 \208\188\208\181\208\189\209\140\209\136\208\181. \208\161\208\184\208\187\209\140\208\189\209\139\208\185 \208\178\208\183\208\188\208\176\209\133 \208\180\208\176\208\187\208\181\208\186\208\190 \208\190\209\130\208\177\208\184\208\178\208\176\208\181\209\130 \208\189\208\181\208\191\208\190\208\180\208\178\208\184\208\182\208\189\209\139\208\185 \208\186\208\187\208\184\208\189\208\190\208\186, \208\184 \209\130\208\190\209\130 \208\188\208\181\208\180\208\187\208\181\208\189\208\189\208\190 \208\178\208\190\208\183\208\178\209\128\208\176\209\137\208\176\208\181\209\130\209\129\209\143: \208\190\208\186\208\189\208\190 \208\180\208\187\209\143 \208\176\209\130\208\176\208\186\208\184.\n\n\208\159\209\128\208\184 \209\131\208\180\208\176\209\128\208\181 \209\131 \209\128\209\131\208\186 \208\186\208\187\208\184\208\189\208\190\208\186 \208\191\208\190\209\135\209\130\208\184 \208\189\208\181 \209\129\208\180\208\178\208\184\208\179\208\176\208\181\209\130\209\129\209\143. \208\159\209\128\208\184 \209\131\208\180\208\176\209\128\208\181 \209\131 \208\190\209\129\209\130\209\128\208\184\209\143 \208\186\208\187\208\184\208\189\208\190\208\186 \208\187\208\181\208\179\208\186\208\190 \208\190\209\130\208\187\208\181\209\130\208\176\208\181\209\130 \208\178 \209\129\209\130\208\190\209\128\208\190\208\189\209\131.",
		["<b>Draw-cuts</b> hit hardest. A blade held still that meets a draw-cut, or the drawer while the blade comes out, is knocked aside, and the cut goes through.\n\n<b>A still guard</b> (L2 on a gamepad) parries other swings: the swing bounces off and the attacker is staggered.\n\n<b>Two swings meeting</b> both give way, and neither can cut for a moment.\n\nThe whole sword can clash, handle included."] = "<b>\208\163\208\180\208\176\209\128\209\139 \209\129 \208\178\209\139\209\133\208\178\208\176\209\130\208\176</b> \208\177\209\140\209\142\209\130 \209\129\208\184\208\187\209\140\208\189\208\181\208\181 \208\178\209\129\208\181\208\179\208\190. \208\157\208\181\208\191\208\190\208\180\208\178\208\184\208\182\208\189\209\139\208\185 \208\186\208\187\208\184\208\189\208\190\208\186, \208\178\209\129\209\130\209\128\208\181\209\130\208\184\208\178\209\136\208\184\208\185 \209\131\208\180\208\176\209\128 \209\129 \208\178\209\139\209\133\208\178\208\176\209\130\208\176 \208\184\208\187\208\184 \208\183\208\176\208\180\208\181\208\178\209\136\208\184\208\185 \208\178\209\139\209\133\208\178\208\176\209\130\209\139\208\178\208\176\209\142\209\137\208\181\208\179\208\190, \208\191\208\190\208\186\208\176 \208\186\208\187\208\184\208\189\208\190\208\186 \208\178\209\139\209\133\208\190\208\180\208\184\209\130, \208\190\209\130\208\177\209\128\208\176\209\129\209\139\208\178\208\176\208\181\209\130\209\129\209\143 \208\178 \209\129\209\130\208\190\209\128\208\190\208\189\209\131, \208\184 \209\131\208\180\208\176\209\128 \208\191\209\128\208\190\209\133\208\190\208\180\208\184\209\130.\n\n<b>\208\157\208\181\208\191\208\190\208\180\208\178\208\184\208\182\208\189\209\139\208\185 \208\177\208\187\208\190\208\186</b> (L2 \208\189\208\176 \208\179\208\181\208\185\208\188\208\191\208\176\208\180\208\181) \208\191\208\176\209\128\208\184\209\128\209\131\208\181\209\130 \208\180\209\128\209\131\208\179\208\184\208\181 \208\178\208\183\208\188\208\176\209\133\208\184: \208\178\208\183\208\188\208\176\209\133 \208\190\209\130\209\129\208\186\208\176\208\186\208\184\208\178\208\176\208\181\209\130, \208\176 \208\176\209\130\208\176\208\186\209\131\209\142\209\137\208\181\208\179\208\190 \208\190\208\179\208\187\209\131\209\136\208\176\208\181\209\130.\n\n<b>\208\148\208\178\208\176 \208\178\209\129\209\130\209\128\208\181\209\135\208\189\209\139\209\133 \208\178\208\183\208\188\208\176\209\133\208\176</b> \208\190\208\177\208\176 \209\131\209\129\209\130\209\131\208\191\208\176\209\142\209\130, \208\184 \208\189\208\176 \208\188\208\179\208\189\208\190\208\178\208\181\208\189\208\184\208\181 \208\189\208\184\208\186\209\130\208\190 \208\189\208\181 \208\188\208\190\208\182\208\181\209\130 \209\128\208\181\208\183\208\176\209\130\209\140.\n\n\208\161\209\130\208\176\208\187\208\186\208\184\208\178\208\176\209\130\209\140\209\129\209\143 \208\188\208\190\208\182\208\181\209\130 \208\178\208\181\209\129\209\140 \208\188\208\181\209\135, \208\178\208\186\208\187\209\142\209\135\208\176\209\143 \209\128\209\131\208\186\208\190\209\143\209\130\209\140.",
		["Cuts, wounds and bleeding"] = "\208\159\208\190\209\128\208\181\208\183\209\139, \209\128\208\176\208\189\209\139 \208\184 \208\186\209\128\208\190\208\178\208\190\209\130\208\181\209\135\208\181\208\189\208\184\208\181",
		["A cut needs speed and a leading edge. Speed comes from the swing and from movement, so dashing past counts. A sudden change of direction hits with the flat.\n\nOnly a blade moving into a target counts. A blade left resting in a body sticks."] = "\208\148\208\187\209\143 \208\191\208\190\209\128\208\181\208\183\208\176 \208\189\209\131\208\182\208\189\209\139 \209\129\208\186\208\190\209\128\208\190\209\129\209\130\209\140 \208\184 \208\187\208\181\208\183\208\178\208\184\208\181 \208\178\208\191\208\181\209\128\208\181\208\180\208\184. \208\161\208\186\208\190\209\128\208\190\209\129\209\130\209\140 \208\177\208\181\209\128\209\145\209\130\209\129\209\143 \208\184\208\183 \208\178\208\183\208\188\208\176\209\133\208\176 \208\184 \208\191\208\181\209\128\208\181\208\180\208\178\208\184\208\182\208\181\208\189\208\184\209\143, \208\191\208\190\209\141\209\130\208\190\208\188\209\131 \209\128\209\139\208\178\208\190\208\186 \208\188\208\184\208\188\208\190 \209\130\208\190\208\182\208\181 \209\129\209\135\208\184\209\130\208\176\208\181\209\130\209\129\209\143. \208\160\208\181\208\183\208\186\208\176\209\143 \209\129\208\188\208\181\208\189\208\176 \208\189\208\176\208\191\209\128\208\176\208\178\208\187\208\181\208\189\208\184\209\143 \208\177\209\140\209\145\209\130 \208\191\208\187\208\176\209\136\208\188\209\143.\n\n\208\151\208\176\209\129\209\135\208\184\209\130\209\139\208\178\208\176\208\181\209\130\209\129\209\143 \209\130\208\190\208\187\209\140\208\186\208\190 \208\186\208\187\208\184\208\189\208\190\208\186, \208\180\208\178\208\184\208\182\209\131\209\137\208\184\208\185\209\129\209\143 \208\178 \209\134\208\181\208\187\209\140. \208\154\208\187\208\184\208\189\208\190\208\186, \208\190\209\129\209\130\208\176\208\178\208\187\208\181\208\189\208\189\209\139\208\185 \208\178 \209\130\208\181\208\187\208\181, \208\183\208\176\209\129\209\130\209\128\208\181\208\178\208\176\208\181\209\130.",
		["A fast, edge-first cut all the way through a limb <b>severs</b> it. Through the head or torso: <b>a kill</b>.\n\nAnything less is a <b>wound</b>: it bleeds and slows the limb. Deeper wounds are worse.\n\n<b>Stabs</b> never kill outright. A stab to the head, or a fast one to the body (dash or lunge in), takes a lot of blood at once. Other stabs wound."] = "\208\145\209\139\209\129\209\130\209\128\209\139\208\185 \209\131\208\180\208\176\209\128 \208\187\208\181\208\183\208\178\208\184\208\181\208\188 \208\178\208\191\208\181\209\128\209\145\208\180, \208\191\209\128\208\190\209\136\208\181\208\180\209\136\208\184\208\185 \208\186\208\190\208\189\208\181\209\135\208\189\208\190\209\129\209\130\209\140 \208\189\208\176\209\129\208\186\208\178\208\190\208\183\209\140, <b>\208\190\209\130\209\128\209\131\208\177\208\176\208\181\209\130</b> \208\181\209\145. \208\161\208\186\208\178\208\190\208\183\209\140 \208\179\208\190\208\187\208\190\208\178\209\131 \208\184\208\187\208\184 \209\130\208\190\209\128\209\129: <b>\209\131\208\177\208\184\208\185\209\129\209\130\208\178\208\190</b>.\n\n\208\146\209\129\209\145, \209\135\209\130\208\190 \208\188\208\181\208\189\209\140\209\136\208\181, \226\128\148 \209\141\209\130\208\190 <b>\209\128\208\176\208\189\208\176</b>: \208\190\208\189\208\176 \208\186\209\128\208\190\208\178\208\190\209\130\208\190\209\135\208\184\209\130 \208\184 \208\183\208\176\208\188\208\181\208\180\208\187\209\143\208\181\209\130 \208\186\208\190\208\189\208\181\209\135\208\189\208\190\209\129\209\130\209\140. \208\145\208\190\208\187\208\181\208\181 \208\179\208\187\209\131\208\177\208\190\208\186\208\184\208\181 \209\128\208\176\208\189\209\139 \209\130\209\143\208\182\208\181\208\187\208\181\208\181.\n\n<b>\208\163\208\186\208\190\208\187\209\139</b> \208\189\208\184\208\186\208\190\208\179\208\180\208\176 \208\189\208\181 \209\131\208\177\208\184\208\178\208\176\209\142\209\130 \209\129\209\128\208\176\208\183\209\131. \208\163\208\186\208\190\208\187 \208\178 \208\179\208\190\208\187\208\190\208\178\209\131 \208\184\208\187\208\184 \208\177\209\139\209\129\209\130\209\128\209\139\208\185 \209\131\208\186\208\190\208\187 \208\178 \209\130\208\181\208\187\208\190 (\209\129 \209\128\209\139\208\178\208\186\208\190\208\188 \208\184\208\187\208\184 \208\178\209\139\208\191\208\176\208\180\208\190\208\188) \209\129\209\128\208\176\208\183\209\131 \208\190\209\130\208\189\208\184\208\188\208\176\208\181\209\130 \208\188\208\189\208\190\208\179\208\190 \208\186\209\128\208\190\208\178\208\184. \208\158\209\129\209\130\208\176\208\187\209\140\208\189\209\139\208\181 \209\131\208\186\208\190\208\187\209\139 \209\128\208\176\208\189\209\143\209\130.",
		["Every fighter has {squares} squares of blood. Wounds bleed for a few seconds, and so does a lost limb. With two limbs lost, the stumps bleed out. Losing both arms drops the katana.\n\nCombat is allowed in the arena and the forest, except in safe zones. Inside one, the screen shows <b>{safe}</b>."] = "\208\163 \208\186\208\176\208\182\208\180\208\190\208\179\208\190 \208\177\208\190\208\185\209\134\208\176 {squares} \208\186\208\178\208\176\208\180\209\128\208\176\209\130\208\184\208\186\208\190\208\178 \208\186\209\128\208\190\208\178\208\184. \208\160\208\176\208\189\209\139 \208\186\209\128\208\190\208\178\208\190\209\130\208\190\209\135\208\176\209\130 \208\189\208\181\209\129\208\186\208\190\208\187\209\140\208\186\208\190 \209\129\208\181\208\186\209\131\208\189\208\180, \208\186\208\176\208\186 \208\184 \208\190\209\130\209\128\209\131\208\177\208\187\208\181\208\189\208\189\208\176\209\143 \208\186\208\190\208\189\208\181\209\135\208\189\208\190\209\129\209\130\209\140. \208\149\209\129\208\187\208\184 \208\191\208\190\209\130\208\181\209\128\209\143\208\189\209\139 \208\180\208\178\208\181 \208\186\208\190\208\189\208\181\209\135\208\189\208\190\209\129\209\130\208\184, \208\190\208\177\209\128\209\131\208\177\208\186\208\184 \208\186\209\128\208\190\208\178\208\190\209\130\208\190\209\135\208\176\209\130 \208\180\208\190 \209\129\208\188\208\181\209\128\209\130\208\184. \208\159\209\128\208\184 \208\191\208\190\209\130\208\181\209\128\208\181 \208\190\208\177\208\181\208\184\209\133 \209\128\209\131\208\186 \208\186\208\176\209\130\208\176\208\189\208\176 \208\191\208\176\208\180\208\176\208\181\209\130.\n\n\208\161\209\128\208\176\208\182\208\176\209\130\209\140\209\129\209\143 \208\188\208\190\208\182\208\189\208\190 \208\189\208\176 \208\176\209\128\208\181\208\189\208\181 \208\184 \208\178 \208\187\208\181\209\129\209\131, \208\186\209\128\208\190\208\188\208\181 \208\177\208\181\208\183\208\190\208\191\208\176\209\129\208\189\209\139\209\133 \208\183\208\190\208\189. \208\146 \209\130\208\176\208\186\208\190\208\185 \208\183\208\190\208\189\208\181 \208\189\208\176 \209\141\208\186\209\128\208\176\208\189\208\181 \208\190\209\130\208\190\208\177\209\128\208\176\208\182\208\176\208\181\209\130\209\129\209\143 <b>{safe}</b>.",
		["The forge and levels"] = "\208\154\209\131\208\183\208\189\208\184\209\134\208\176 \208\184 \209\131\209\128\208\190\208\178\208\189\208\184",
		["XP rewards:\n\n<b>Wounding a player</b>: {wound}.\n<b>Severing a limb</b>: {sever}.\n<b>A kill</b>: {kill}.\n<b>Defeating a bot</b>: {botLeast} to {botMost}, more for rarer names.\n\nEach level needs a little more XP than the last. No level cap."] = "\208\157\208\176\208\179\209\128\208\176\208\180\209\139 XP:\n\n<b>\208\160\208\176\208\189\208\181\208\189\208\184\208\181 \208\184\208\179\209\128\208\190\208\186\208\176</b>: {wound}.\n<b>\208\158\209\130\209\128\209\131\208\177\208\176\208\189\208\184\208\181 \208\186\208\190\208\189\208\181\209\135\208\189\208\190\209\129\209\130\208\184</b>: {sever}.\n<b>\208\163\208\177\208\184\208\185\209\129\209\130\208\178\208\190</b>: {kill}.\n<b>\208\159\208\190\208\177\208\181\208\180\208\176 \208\189\208\176\208\180 \208\177\208\190\209\130\208\190\208\188</b>: \208\190\209\130 {botLeast} \208\180\208\190 {botMost}, \208\177\208\190\208\187\209\140\209\136\208\181 \208\183\208\176 \208\177\208\190\208\187\208\181\208\181 \209\128\208\181\208\180\208\186\208\184\208\181 \209\132\208\176\208\188\208\184\208\187\208\184\208\184.\n\n\208\154\208\176\208\182\208\180\209\139\208\185 \209\131\209\128\208\190\208\178\208\181\208\189\209\140 \209\130\209\128\208\181\208\177\209\131\208\181\209\130 \209\135\209\131\209\130\209\140 \208\177\208\190\208\187\209\140\209\136\208\181 XP, \209\135\208\181\208\188 \208\191\209\128\208\181\208\180\209\139\208\180\209\131\209\137\208\184\208\185. \208\156\208\176\208\186\209\129\208\184\208\188\208\176\208\187\209\140\208\189\208\190\208\179\208\190 \209\131\209\128\208\190\208\178\208\189\209\143 \208\189\208\181\209\130.",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, press E at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "\208\157\208\190\208\178\209\139\208\185 <b>\209\128\208\176\208\189\208\179 \208\186\208\190\208\178\208\186\208\184</b> \208\190\209\130\208\186\209\128\209\139\208\178\208\176\208\181\209\130\209\129\209\143 \208\186\208\176\208\182\208\180\209\139\208\181 {levels} \209\131\209\128\208\190\208\178\208\189\208\181\208\185. \208\146 \208\186\209\131\208\183\208\189\208\184\209\134\208\181, \208\186 \209\142\208\179\209\131 \208\190\209\130 \208\176\209\128\208\181\208\189\209\139, \208\189\208\176\208\182\208\188\208\184 E \209\131 \208\189\208\176\208\186\208\190\208\178\208\176\208\187\209\140\208\189\208\184, \209\135\209\130\208\190\208\177\209\139 \208\189\208\176\208\179\209\128\208\181\209\130\209\140, \208\191\209\128\208\190\208\186\208\190\208\178\208\176\209\130\209\140 \208\184 \208\183\208\176\208\186\208\176\208\187\208\184\209\130\209\140 \208\186\208\187\208\184\208\189\208\190\208\186. \208\154\208\176\208\182\208\180\209\139\208\185 \209\128\208\176\208\189\208\179 \208\180\208\176\209\145\209\130 \208\186\208\187\208\184\208\189\208\186\209\131 \208\189\208\190\208\178\209\139\208\185 \208\178\208\184\208\180 \208\184 \208\189\208\190\208\178\208\190\208\181 \209\131\208\187\209\131\209\135\209\136\208\181\208\189\208\184\208\181.\n\n\208\161\209\130\208\181\208\189\208\176 \208\188\208\181\209\135\208\181\208\185 \208\183\208\180\208\181\209\129\209\140 \208\191\208\190\208\186\208\176\208\183\209\139\208\178\208\176\208\181\209\130 \208\186\208\187\208\184\208\189\208\190\208\186 \208\186\208\176\208\182\208\180\208\190\208\179\208\190 \209\128\208\176\208\189\208\179\208\176 \208\186\208\190\208\178\208\186\208\184.\n\n<b>\208\159\208\181\209\128\208\181\208\186\209\131\208\185</b> \208\186\208\187\208\184\208\189\208\190\208\186, \209\135\209\130\208\190\208\177\209\139 \208\178\208\181\209\128\208\189\209\131\209\130\209\140\209\129\209\143 \208\186 \208\187\209\142\208\177\208\190\208\188\209\131 \209\131\208\182\208\181 \208\178\209\139\208\186\208\190\208\178\208\176\208\189\208\189\208\190\208\188\209\131 \209\128\208\176\208\189\208\179\209\131.",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, tap <b>Forge your blade</b> at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "\208\157\208\190\208\178\209\139\208\185 <b>\209\128\208\176\208\189\208\179 \208\186\208\190\208\178\208\186\208\184</b> \208\190\209\130\208\186\209\128\209\139\208\178\208\176\208\181\209\130\209\129\209\143 \208\186\208\176\208\182\208\180\209\139\208\181 {levels} \209\131\209\128\208\190\208\178\208\189\208\181\208\185. \208\146 \208\186\209\131\208\183\208\189\208\184\209\134\208\181, \208\186 \209\142\208\179\209\131 \208\190\209\130 \208\176\209\128\208\181\208\189\209\139, \208\189\208\176\208\182\208\188\208\184 <b>\208\146\209\139\208\186\208\190\208\178\208\176\209\130\209\140 \208\186\208\187\208\184\208\189\208\190\208\186</b> \209\131 \208\189\208\176\208\186\208\190\208\178\208\176\208\187\209\140\208\189\208\184, \209\135\209\130\208\190\208\177\209\139 \208\189\208\176\208\179\209\128\208\181\209\130\209\140, \208\191\209\128\208\190\208\186\208\190\208\178\208\176\209\130\209\140 \208\184 \208\183\208\176\208\186\208\176\208\187\208\184\209\130\209\140 \208\186\208\187\208\184\208\189\208\190\208\186. \208\154\208\176\208\182\208\180\209\139\208\185 \209\128\208\176\208\189\208\179 \208\180\208\176\209\145\209\130 \208\186\208\187\208\184\208\189\208\186\209\131 \208\189\208\190\208\178\209\139\208\185 \208\178\208\184\208\180 \208\184 \208\189\208\190\208\178\208\190\208\181 \209\131\208\187\209\131\209\135\209\136\208\181\208\189\208\184\208\181.\n\n\208\161\209\130\208\181\208\189\208\176 \208\188\208\181\209\135\208\181\208\185 \208\183\208\180\208\181\209\129\209\140 \208\191\208\190\208\186\208\176\208\183\209\139\208\178\208\176\208\181\209\130 \208\186\208\187\208\184\208\189\208\190\208\186 \208\186\208\176\208\182\208\180\208\190\208\179\208\190 \209\128\208\176\208\189\208\179\208\176 \208\186\208\190\208\178\208\186\208\184.\n\n<b>\208\159\208\181\209\128\208\181\208\186\209\131\208\185</b> \208\186\208\187\208\184\208\189\208\190\208\186, \209\135\209\130\208\190\208\177\209\139 \208\178\208\181\209\128\208\189\209\131\209\130\209\140\209\129\209\143 \208\186 \208\187\209\142\208\177\208\190\208\188\209\131 \209\131\208\182\208\181 \208\178\209\139\208\186\208\190\208\178\208\176\208\189\208\189\208\190\208\188\209\131 \209\128\208\176\208\189\208\179\209\131.",
		["Kill streaks"] = "\208\161\208\181\209\128\208\184\208\184 \209\131\208\177\208\184\208\185\209\129\209\130\208\178",
		["A <b>kill streak</b> counts kills in a row without dying, shown at the top right. Bleed-outs from a cut count, and so do bot kills. Dying ends the streak, but the best one is saved."] = "<b>\208\161\208\181\209\128\208\184\209\143 \209\131\208\177\208\184\208\185\209\129\209\130\208\178</b> \209\129\209\135\208\184\209\130\208\176\208\181\209\130 \209\131\208\177\208\184\208\185\209\129\209\130\208\178\208\176 \208\191\208\190\208\180\209\128\209\143\208\180 \208\177\208\181\208\183 \209\129\208\188\208\181\209\128\209\130\208\181\208\185 \208\184 \208\190\209\130\208\190\208\177\209\128\208\176\208\182\208\176\208\181\209\130\209\129\209\143 \208\178\208\178\208\181\209\128\209\133\209\131 \209\129\208\191\209\128\208\176\208\178\208\176. \208\161\208\188\208\181\209\128\209\130\208\184 \208\190\209\130 \208\186\209\128\208\190\208\178\208\190\208\191\208\190\209\130\208\181\209\128\208\184 \208\191\208\190\209\129\208\187\208\181 \208\191\208\190\209\128\208\181\208\183\208\176 \208\183\208\176\209\129\209\135\208\184\209\130\209\139\208\178\208\176\209\142\209\130\209\129\209\143, \208\186\208\176\208\186 \208\184 \209\131\208\177\208\184\208\185\209\129\209\130\208\178\208\176 \208\177\208\190\209\130\208\190\208\178. \208\161\208\188\208\181\209\128\209\130\209\140 \208\190\208\177\209\128\209\139\208\178\208\176\208\181\209\130 \209\129\208\181\209\128\208\184\209\142, \208\189\208\190 \208\187\209\131\209\135\209\136\208\176\209\143 \209\129\208\181\209\128\208\184\209\143 \209\129\208\190\209\133\209\128\208\176\208\189\209\143\208\181\209\130\209\129\209\143.",
		["The streak catches fire as it grows, and every ten kills earns a title. Every {every} kills up to {most}: +{share} walk speed and poise recovery (Mythic names +{mythic}, Exotic names +{exotic}).\n\nNo prizes: it\'s for the glory.\n\nAfter dying, <b>SPECTATE</b> watches other fighters and <b>RESPAWN</b> returns to the fight."] = "\208\160\208\176\209\129\209\130\209\131\209\137\208\176\209\143 \209\129\208\181\209\128\208\184\209\143 \208\183\208\176\208\179\208\190\209\128\208\176\208\181\209\130\209\129\209\143, \208\176 \208\186\208\176\208\182\208\180\209\139\208\181 \208\180\208\181\209\129\209\143\209\130\209\140 \209\131\208\177\208\184\208\185\209\129\209\130\208\178 \208\180\208\176\209\142\209\130 \209\130\208\184\209\130\209\131\208\187. \208\154\208\176\208\182\208\180\209\139\208\181 {every} \209\131\208\177\208\184\208\185\209\129\209\130\208\178, \208\180\208\190 {most}: +{share} \208\186 \209\129\208\186\208\190\209\128\208\190\209\129\209\130\208\184 \209\133\208\190\208\180\209\140\208\177\209\139 \208\184 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\190\208\178\208\187\208\181\208\189\208\184\209\142 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184 (\208\156\208\184\209\132\208\184\209\135\208\181\209\129\208\186\208\184\208\181 \209\132\208\176\208\188\208\184\208\187\208\184\208\184 +{mythic}, \208\173\208\186\208\183\208\190\209\130\208\184\209\135\208\181\209\129\208\186\208\184\208\181 +{exotic}).\n\n\208\157\208\176\208\179\209\128\208\176\208\180 \208\189\208\181\209\130: \209\130\208\190\208\187\209\140\208\186\208\190 \209\129\208\187\208\176\208\178\208\176.\n\n\208\159\208\190\209\129\208\187\208\181 \209\129\208\188\208\181\209\128\209\130\208\184 <b>\208\157\208\144\208\145\208\155\208\174\208\148\208\144\208\162\208\172</b> \208\191\208\190\208\186\208\176\208\183\209\139\208\178\208\176\208\181\209\130 \208\180\209\128\209\131\208\179\208\184\209\133 \208\177\208\190\208\185\209\134\208\190\208\178, \208\176 <b>\208\146\208\158\208\151\208\160\208\158\208\148\208\152\208\162\208\172\208\161\208\175</b> \208\178\208\190\208\183\208\178\209\128\208\176\209\137\208\176\208\181\209\130 \208\178 \208\177\208\190\208\185.",
		["TO WHOEVER FREED THIS TEMPLE"] = "\208\162\208\158\208\156\208\163, \208\154\208\162\208\158 \208\158\208\161\208\146\208\158\208\145\208\158\208\148\208\152\208\155 \208\173\208\162\208\158\208\162 \208\165\208\160\208\144\208\156",
		["Her blade still rests within these walls. Search every corner."] = "\208\149\209\145 \208\186\208\187\208\184\208\189\208\190\208\186 \208\178\209\129\209\145 \208\181\209\137\209\145 \208\191\208\190\208\186\208\190\208\184\209\130\209\129\209\143 \208\178 \209\141\209\130\208\184\209\133 \209\129\209\130\208\181\208\189\208\176\209\133. \208\158\208\177\209\139\209\137\208\184 \208\186\208\176\208\182\208\180\209\139\208\185 \209\131\208\179\208\190\208\187.",
