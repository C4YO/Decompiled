		v83.regen = v_u_12.Regen
		return v83
	end
}, {
	["Text"] = v10("At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> ({Wipe}). See the next scroll."),
	["Args"] = v40
}})
v72.Pages = v73
local v86 = {
