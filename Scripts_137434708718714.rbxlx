		["Kill streak lost: safe zone"] = "M\225\186\165t chu\225\187\151i h\225\186\161 g\225\187\165c: v\195\185ng an to\195\160n",
		["Kicked, not sliced: it\'s back on its stand."] = "B\225\187\139 \196\145\195\161 ch\225\187\169 kh\195\180ng b\225\187\139 ch\195\169m: n\195\179 \196\145\195\163 v\225\187\129 l\225\186\161i tr\195\170n gi\195\161.",
		["A stab only marks it. **Swing** through it to slice it."] = "\196\144\195\162m ch\225\187\137 \196\145\225\187\131 l\225\186\161i v\225\186\191t. **Vung ki\225\186\191m** ch\195\169m xuy\195\170n qua \196\145\225\187\131 b\225\187\149 n\195\179.",
		["Too slow, or hit with the flat. Swing faster, edge first."] = "Ch\225\186\173m qu\195\161, ho\225\186\183c tr\195\186ng m\225\186\183t ki\225\186\191m. Vung nhanh h\198\161n, l\198\176\225\187\161i s\225\186\175c \196\145i tr\198\176\225\187\155c.",
		["{was}. Press **{Equip}** to sheathe, then {how}."] = "{was}. Nh\225\186\165n **{Equip}** \196\145\225\187\131 tra ki\225\186\191m, r\225\187\147i {how}.",
		["{was}. Tap **SHEATHE**, then {how}."] = "{was}. Ch\225\186\161m **TRA KI\225\186\190M**, r\225\187\147i {how}.",
		["Not a dash attack. Hold **W + A** and press **{Dash}** while passing it."] = "Kh\195\180ng ph\225\186\163i \196\145\195\178n l\198\176\225\187\155t. Gi\225\187\175 **W + A** v\195\160 nh\225\186\165n **{Dash}** khi \196\145i ngang qua n\195\179.",
		["Not a dash attack. Tap **DASH** while walking past it."] = "Kh\195\180ng ph\225\186\163i \196\145\195\178n l\198\176\225\187\155t. Ch\225\186\161m **L\198\175\225\187\154T** khi \196\145i ngang qua n\195\179.",
		["A new watermelon is on the stand."] = "\196\144\195\163 c\195\179 qu\225\186\163 d\198\176a h\225\186\165u m\225\187\155i tr\195\170n gi\195\161.",
		["Still loading: try again in a moment."] = "V\225\186\171n \196\145ang t\225\186\163i: th\225\187\173 l\225\186\161i sau gi\195\162y l\195\161t.",
		["Not during a 1v1."] = "Kh\195\180ng \196\145\198\176\225\187\163c khi \196\145ang 1v1.",
		["Not straight after a fight: wait a few seconds."] = "Kh\195\180ng \196\145\198\176\225\187\163c ngay sau khi giao chi\225\186\191n: ch\225\187\157 v\195\160i gi\195\162y.",
		["Not with a missing limb."] = "Kh\195\180ng \196\145\198\176\225\187\163c khi b\225\187\139 m\225\186\165t m\225\187\153t chi.",
		["The dojo is full: try again soon."] = "V\195\181 \196\145\198\176\225\187\157ng \196\145\195\163 \196\145\225\186\167y: th\225\187\173 l\225\186\161i sau nh\195\169.",
		["HEAD"] = "\196\144\225\186\166U",
