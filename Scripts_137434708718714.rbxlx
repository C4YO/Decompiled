		["Chapter {number}, {name}"] = "Cap\195\173tulo {number}, {name}",
		["Path of the Sword: {chapter} done. Chapter {number}, {next}, begins."] = "Caminho da Espada: {chapter} conclu\195\173do. Come\195\167a o cap\195\173tulo {number}, {next}.",
		["Path of the Sword: done. You walked it to the end."] = "Caminho da Espada: conclu\195\173do. Voc\195\170 percorreu at\195\169 o fim.",
		["You can\'t go peaceful so soon after a fight."] = "Voc\195\170 n\195\163o pode ficar pac\195\173fico logo depois de uma luta.",
		["You can go peaceful again in {time}."] = "Voc\195\170 pode ficar pac\195\173fico de novo em {time}.",
		["PvP off in the forest. PvP still on in the rings."] = "PvP desligado na floresta. PvP continua ligado nos ringues.",
		["PvP is back on."] = "O PvP est\195\161 ligado de novo.",
		["Couldn\'t load your data. Please rejoin."] = "N\195\163o deu para carregar seus dados. Entre de novo.",
		["Your data was opened on another server. Please rejoin."] = "Seus dados foram abertos em outro servidor. Entre de novo.",
		["{event}: {quest}"] = "{event}: {quest}",
		["Unknown tab."] = "Aba desconhecida.",
		["That isn\'t one of today\'s quests."] = "Essa n\195\163o \195\169 uma das miss\195\181es de hoje.",
		["Already done today."] = "J\195\161 conclu\195\173da hoje.",
		["You can work on {count} at a time: drop one first."] = "Voc\195\170 pode fazer {count} por vez: abandone uma primeiro.",
		["Not in a boss fight."] = "N\195\163o durante uma batalha de chefe.",
		["Needs both hands."] = "Precisa das duas m\195\163os.",
		["Not during a fight."] = "N\195\163o durante uma luta.",
		["That can\'t be bought with ry\197\141."] = "Isso n\195\163o pode ser comprado com ry\197\141.",
		["Already owned."] = "J\195\161 obtido.",
		["Unknown pack."] = "Pacote desconhecido.",
		["1 rename spin"] = "1 giro de nome",
		["{count} rename spins"] = "{count} giros de nome",
		["Kill streak lost: safe zone"] = "Sequ\195\170ncia de abates perdida: zona segura",
		["Kicked, not sliced: it\'s back on its stand."] = "Chutada, n\195\163o cortada: ela voltou para o suporte.",
		["A stab only marks it. **Swing** through it to slice it."] = "Uma estocada s\195\179 marca. **Golpeie** atrav\195\169s dela para cortar.",
		["Too slow, or hit with the flat. Swing faster, edge first."] = "Lento demais, ou golpe com a parte chata. Golpeie mais r\195\161pido, com o fio na frente.",
		["{was}. Press **{Equip}** to sheathe, then {how}."] = "{was}. Aperte **{Equip}** para guardar e ent\195\163o {how}.",
		["{was}. Tap **SHEATHE**, then {how}."] = "{was}. Toque em **GUARDAR** e ent\195\163o {how}.",
		["Not a dash attack. Hold **W + A** and press **{Dash}** while passing it."] = "N\195\163o foi um ataque com dash. Segure **W + A** e aperte **{Dash}** ao passar por ela.",
		["Not a dash attack. Tap **DASH** while walking past it."] = "N\195\163o foi um ataque com dash. Toque em **DASH** ao passar andando por ela.",
		["A new watermelon is on the stand."] = "Uma nova melancia est\195\161 no suporte.",
		["Still loading: try again in a moment."] = "Ainda carregando: tente de novo daqui a pouco.",
		["Not during a 1v1."] = "N\195\163o durante um 1v1.",
		["Not straight after a fight: wait a few seconds."] = "N\195\163o logo depois de uma luta: espere alguns segundos.",
		["Not with a missing limb."] = "N\195\163o com um membro faltando.",
		["The dojo is full: try again soon."] = "O dojo est\195\161 cheio: tente de novo em breve.",
		["HEAD"] = "CABE\195\135A",
		["TORSO"] = "TRONCO",
		["LEFT ARM"] = "BRA\195\135O ESQUERDO",
		["RIGHT ARM"] = "BRA\195\135O DIREITO",
		["LEFT LEG"] = "PERNA ESQUERDA",
		["RIGHT LEG"] = "PERNA DIREITA",
		["THE ARENA"] = "A ARENA",
		["THE CHERRY GROVE"] = "O BOSQUE DAS CEREJEIRAS",
		["THE BAMBOO SHRINE"] = "O SANTU\195\129RIO DO BAMBU",
		["THE FOG GATE"] = "O PORT\195\131O DA N\195\137VOA",
		["THE NORTH WOOD"] = "A FLORESTA DO NORTE",
		["THE TEMPLE"] = "O TEMPLO",
		["THE FOOT OF THE HILL"] = "O P\195\137 DA COLINA",
		["THE RIVER BRIDGE"] = "A PONTE DO RIO",
		["THE RUINED OUTSKIRTS"] = "OS ARREDORES EM RU\195\141NAS",
		["THE MOUNTAIN\'S FOOT"] = "O P\195\137 DA MONTANHA",
		["THE SOUTH WOOD"] = "A FLORESTA DO SUL",
		["Pumpkin Samurai"] = "Samurai Ab\195\179bora",
		["Take hold of the sword, or sheathe it."] = "Pegar a espada, ou guard\195\161-la.",
		["Unequip the sword (sheathes it first)."] = "Soltar a espada (guarda antes).",
		["Hold, swipe to draw. Blade out: thrust."] = "Segure e deslize: sacar. L\195\162mina fora: estocada.",
		["Hip swap: draw from the other hip."] = "Troca de quadril: sacar do outro quadril.",
		["Lock on to who you\'re looking at, or off."] = "Travar a mira no alvo em vista, ou destravar.",
		["Cycle lock on target."] = "Trocar o alvo da mira.",
		["Kick: knock back, send limbs flying."] = "Chute: empurra e faz membros voarem.",
		["Dash."] = "Dash.",
		["Front view: watch your own draws."] = "Vista frontal: veja seus pr\195\179prios saques.",
		["Bow to who you\'re locked onto: both bow, a 1v1."] = "Saudar o alvo: se os dois saudarem, um 1v1.",
		["Battle music: next track."] = "M\195\186sica de batalha: pr\195\179xima faixa.",
		["Battle music: the last track."] = "M\195\186sica de batalha: faixa anterior.",
		["In the dojo: skip to the arena."] = "No dojo: pular para a arena.",
		["Hide the UI for clean shots. Again: show it."] = "Oculta a interface para filmar. De novo: volta.",
		["Shamisen: take it out or put it away."] = "Shamisen: pegar ou guardar.",
		["left click"] = "clique esquerdo",
		["right click"] = "clique direito",
		["middle click"] = "clique do meio",
		["RIGHT SHIFT"] = "SHIFT DIREITO",
		["RIGHT CTRL"] = "CTRL DIREITO",
		["RIGHT ALT"] = "ALT DIREITO",
		["Talk"] = "Falar",
		["TRAVELLING MERCHANT"] = "MERCADOR VIAJANTE",
		["Ah, a traveller. You\'ll forgive me if I don\'t get up."] = "Ah, um viajante. Perdoe-me por n\195\163o me levantar.",
		["Three nights ago my horses caught wind of something up at that temple."] = "Tr\195\170s noites atr\195\161s, meus cavalos sentiram o cheiro de algo l\195\161 em cima, naquele templo.",
		["They screamed, broke their harness and bolted into the trees. I haven\'t seen them since."] = "Eles gritaram, arrebentaram os arreios e fugiram para as \195\161rvores. N\195\163o os vi desde ent\195\163o.",
		["So here I am, stranded with a wagon full of wax."] = "Ent\195\163o aqui estou, encalhado com uma carro\195\167a cheia de cera.",
		["There\'s something wrong with that temple, I\'d stay away if I were you, especially at night."] = "H\195\161 algo errado naquele templo. Se eu fosse voc\195\170, ficaria longe, principalmente \195\160 noite.",
		["Here, take some wax. It might be useful to give your blade some extra shine. Be careful around a flame though, this stuff can catch alight in the blink of an eye!"] = "Tome, pegue um pouco de cera. Pode ser \195\186til para dar um brilho extra \195\160 sua l\195\162mina. Mas cuidado perto de uma chama: isto pega fogo num piscar de olhos!",
		["Still here? So am I."] = "Ainda aqui? Eu tamb\195\169m.",
		["And keep away from that temple at night."] = "E fique longe daquele templo \195\160 noite.",
		["KATANA: SINGLE"] = "KATANA: SIMPLES",
		["One katana at the left hip."] = "Uma katana no quadril esquerdo.",
		["A katana at each hip, drawn together, one in each hand."] = "Uma katana em cada quadril, sacadas juntas, uma em cada m\195\163o.",
		["A katana at each hip, one in each hand."] = "Uma katana em cada quadril, uma em cada m\195\163o.",
		["KATANA: IAI"] = "KATANA: IAI",
		["Draw-cuts only. High risk, high reward: cuts through blades, but a miss can be parried. Longer dash, faster draw. On a kill: poise back and a faster sheathe."] = "S\195\179 cortes de saque. Alto risco, alta recompensa: atravessa l\195\162minas, mas um erro pode ser defendido. Dash mais longo e saque mais r\195\161pido. Com cada abate: postura de volta e guardar mais r\195\161pido.",
		["The older, longer sword, slung edge down at your hip. Slower and heavier than the katana: its hits take more poise and bleed more."] = "A espada mais antiga e mais longa, pendurada no quadril com o fio para baixo. Mais lenta e pesada que a katana: seus golpes tiram mais postura e fazem sangrar mais.",
		["Longer and heavier than the katana: slower, but its hits take more poise and bleed more."] = "Mais longa e pesada que a katana: mais lenta, mas seus golpes tiram mais postura e fazem sangrar mais.",
		["Crimson rime. A keening at vespers. Kindled steel unsheathes me."] = "Geada carmesim. Um lamento nas v\195\169speras. O a\195\167o aceso me desembainha.",
		["+2.5% walk speed"] = "+2,5% de velocidade de caminhada",
		["Mirror polish, wavy temper line, clean bandages."] = "Polimento espelhado, linha de t\195\170mpera ondulada, ataduras limpas.",
		["Store 2 dashes"] = "Acumula 2 dashes",
		["Black cord, gold collar, lacquered sheath."] = "Cord\195\163o preto, colar dourado, bainha laqueada.",
		["Blade length 2.9 studs"] = "L\195\162mina de 2,9 studs",
		["A groove down each side, red cord on the sheath."] = "Um sulco em cada lado, cord\195\163o vermelho na bainha.",
		["Dark forged steel, black sheath."] = "A\195\167o forjado escuro, bainha preta.",
		["Quick wipe: both sides at once"] = "Limpeza r\195\161pida: os dois lados de uma vez",
		["Gold guard, collar and pommel."] = "Guarda, colar e pomo dourados.",
		["Blade length 3.0 studs"] = "L\195\162mina de 3,0 studs",
		["Gleaming silver, crescent-moon guard, white cord and sheath."] = "Prata reluzente, guarda de lua crescente, cord\195\163o e bainha brancos.",
		["Store 3 dashes"] = "Acumula 3 dashes",
		["White metal fittings."] = "Guarni\195\167\195\181es de metal branco.",
		["+2.5% walk speed, 25% faster poise recovery"] = "+2,5% de velocidade de caminhada, recupera\195\167\195\163o de postura 25% mais r\195\161pida",
		["Red cord, cherry-blossom ornaments, black tassel, red sheath with metal bands."] = "Cord\195\163o vermelho, enfeites de flor de cerejeira, borla preta, bainha vermelha com faixas de metal.",
		["Blade length 3.1 studs, draw styles (coming soon)"] = "L\195\162mina de 3,1 studs, estilos de saque (em breve)",
		["Pale gold fittings, four-lobed guard, faint red glow on the edge."] = "Guarni\195\167\195\181es de ouro p\195\161lido, guarda de quatro l\195\179bulos, leve brilho vermelho no fio.",
		["Each hit that draws blood: +5 blood, +6 poise"] = "Cada golpe que tira sangue: +5 de sangue, +6 de postura",
		["Dark blade, crimson edge, red lightning."] = "L\195\162mina escura, fio carmesim, raios vermelhos.",
		["No upgrades"] = "Sem melhorias",
		["Old bandages, a plain brown sheath."] = "Ataduras velhas, uma bainha marrom simples.",
		["FLAMMABLE WAX"] = "CERA INFLAM\195\129VEL",
		["Wax obtained from the old merchant at the foot of the hill."] = "Cera obtida com o velho mercador ao p\195\169 da colina.",
