		["Your blade is alight: {hits} hits."] = "Tu hoja arde: {hits} golpes.",
		["Your blade\'s flame is out: wipe it again, then light it."] = "La llama de tu hoja se apag\195\179: l\195\173mpiala otra vez y vuelve a encenderla.",
		["Your blade is waxed: hold it in a fire stand\'s flame."] = "Tu hoja tiene cera: sostenla en la llama de un brasero.",
		["{count} / {goal}"] = "{count} / {goal}",
		["The mist seals the way out: defeat the boss, or fall."] = "La niebla sella la salida: derrota al jefe, o cae.",
