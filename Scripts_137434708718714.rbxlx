		["ADVENT CALENDAR"] = "CALEND\195\129RIO DO ADVENTO",
		["Day {day} of 25"] = "Dia {day} de 25",
		["no boost"] = "sem b\195\180nus",
		["{count} boost: +{walk} walk speed or +{other} to another stat"] = "{count} b\195\180nus: +{walk} de velocidade de caminhada ou +{other} em outro atributo",
		["{count} boosts, each +{walk} walk speed or +{other} to another stat"] = "{count} b\195\180nus, cada um: +{walk} de velocidade de caminhada ou +{other} em outro atributo",
		["Safe zone: combat forbidden"] = "Zona segura: combate proibido",
		["Names and boosts"] = "Nomes e b\195\180nus",
		["<b>Family name</b>: rolled once, at the forge.\n<b>First name</b>: reroll any time on the character screen (CHARACTER, on the title screen).\n\nRarer family names give stat boosts. Boosts are kept small, so fights are still won with the blade."] = "<b>Sobrenome</b>: sorteado uma vez, na forja.\n<b>Nome</b>: pode ser sorteado de novo a qualquer momento na tela de personagem (PERSONAGEM, na tela inicial).\n\nSobrenomes mais raros d\195\163o b\195\180nus de atributo. Os b\195\180nus s\195\163o mantidos pequenos para que as lutas continuem sendo vencidas com a l\195\162mina.",
		["Rarity, odds and boosts:\n\n{rarities}\n\nThe rarest names belong to famous swordsmen and warlords. A Mythic name is a legend\'s own name, used in place of a family name. An Exotic name is a god\'s. Every spin is pure chance at these odds."] = "Raridade, chances e b\195\180nus:\n\n{rarities}\n\nOs nomes mais raros pertencem a espadachins e senhores da guerra famosos. Um nome M\195\173tico \195\169 o pr\195\179prio nome de uma lenda, usado no lugar de um sobrenome. Um nome Ex\195\179tico \195\169 o de um deus. Cada giro \195\169 pura sorte, com essas chances.",
		["Boosts:\n\n<b>Walk speed</b>: faster movement.\n<b>Poise recovery</b>: poise refills faster.\n<b>Poise toughness</b>: all poise costs are lower.\n<b>Slower bleeding</b>: wounds and stumps bleed slower.\n<b>Faster dash recharge</b>: dash charges refill sooner.\n\nBoosts stack with forge upgrades."] = "B\195\180nus:\n\n<b>Velocidade de caminhada</b>: movimento mais r\195\161pido.\n<b>Recupera\195\167\195\163o de postura</b>: a postura se recarrega mais r\195\161pido.\n<b>Resist\195\170ncia de postura</b>: todos os custos de postura s\195\163o menores.\n<b>Sangramento mais lento</b>: ferimentos e cotos sangram mais devagar.\n<b>Recarga de dash mais r\195\161pida</b>: as cargas de dash se recarregam mais cedo.\n\nOs b\195\180nus se acumulam com as melhorias da forja.",
		["<b>Rename spins</b> reroll the family name. Get {spins} free spins every level, or buy more in the SHOP. Use them on the character screen. The old name can always be kept.\n\nBots have names too. The rarer a bot\'s name, the better it fights."] = "Os <b>giros de nome</b> sorteiam o sobrenome de novo. Ganhe {spins} giros gr\195\161tis a cada n\195\173vel, ou compre mais na LOJA. Use-os na tela de personagem. O nome antigo sempre pode ser mantido.\n\nOs bots tamb\195\169m t\195\170m nomes. Quanto mais raro o nome de um bot, melhor ele luta.",
		["Poise"] = "Postura",
		["<b>Poise</b> is a fighter\'s steadiness. The poise bar is the thin bar above the blood squares; an opponent\'s is under their name. It grows from the middle as poise is lost, turning from gold to red, and hides at full poise."] = "A <b>postura</b> \195\169 a firmeza de um lutador. A barra de postura \195\169 a barra fina acima dos quadrados de sangue; a de um oponente fica embaixo do nome dele. Ela cresce a partir do meio conforme a postura \195\169 perdida, passando de dourado para vermelho, e some quando a postura est\195\161 cheia.",
		["Poise costs:\n\n<b>Draw-cut</b>: {draw}.  <b>Blade hit by a draw-cut</b>: {block}.\n<b>Hard swing</b>: {swing}.  <b>Dash</b>: {dash}.  <b>Kick</b>: {kick}.\n<b>Taking a cut</b>: {wound} (double from a draw-cut), plus blood loss.\n<b>Clashes</b>: more the harder the blade is knocked."] = "Custos de postura:\n\n<b>Corte de saque</b>: {draw}.  <b>L\195\162mina atingida por um corte de saque</b>: {block}.\n<b>Golpe forte</b>: {swing}.  <b>Dash</b>: {dash}.  <b>Chute</b>: {kick}.\n<b>Ser cortado</b>: {wound} (o dobro por um corte de saque), al\195\169m da perda de sangue.\n<b>Choques</b>: mais quanto mais forte a l\195\162mina for golpeada.",
		["Poise refills after {delay} seconds with no poise lost, at {regen} per second. A still guard (L2 on a gamepad) refills it faster; low blood refills it slower.\n\nBelow half poise, blade and movement speed drop, and the blade is knocked aside more easily."] = "A postura se recarrega depois de {delay} segundos sem perder postura, a {regen} por segundo. Uma guarda parada (L2 no controle) a recarrega mais r\195\161pido; com pouco sangue, ela se recarrega mais devagar.\n\nAbaixo da metade da postura, a velocidade da l\195\162mina e a do movimento caem, e a l\195\162mina \195\169 desviada com mais facilidade.",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> ({Wipe}). See the next scroll."] = "Ao chegar a zero, a postura <b>quebra</b>: atordoado por {stagger} segundos e, em seguida, enfraquecido por {weakened} segundos ({slower} mais lento, sem f\195\180lego, com as bordas da tela escurecendo). Depois, a postura se recarrega at\195\169 a metade.\n\nA forma mais r\195\161pida de voltar \195\160 postura cheia \195\169 <b>limpar a l\195\162mina</b> ({Wipe}). Veja o pr\195\179ximo pergaminho.",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> (WIPE). See the next scroll."] = "Ao chegar a zero, a postura <b>quebra</b>: atordoado por {stagger} segundos e, em seguida, enfraquecido por {weakened} segundos ({slower} mais lento, sem f\195\180lego, com as bordas da tela escurecendo). Depois, a postura se recarrega at\195\169 a metade.\n\nA forma mais r\195\161pida de voltar \195\160 postura cheia \195\169 <b>limpar a l\195\162mina</b> (LIMPAR). Veja o pr\195\179ximo pergaminho.",
		["Wiping the blade"] = "Limpando a l\195\162mina",
		["Cuts leave blood on the blade. With the blade drawn, press <b>{Wipe}</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "Cortes deixam sangue na l\195\162mina. Com a l\195\162mina sacada, aperte <b>{Wipe}</b> para limp\195\161-la com um pano, um lado e depois o outro. Uma limpeza leva cerca de {time} segundos.",
		["<b>Wiping restores poise.</b> During a wipe, poise refills at {times}x speed, and a finished wipe fills it to full.\n\nAfter a poise break, a finished wipe also ends the weakened state."] = "<b>Limpar a l\195\162mina restaura a postura.</b> Durante uma limpeza, a postura se recarrega em velocidade {times}x, e uma limpeza conclu\195\173da a recarrega por completo.\n\nDepois de uma quebra de postura, uma limpeza conclu\195\173da tamb\195\169m encerra o estado enfraquecido.",
		["<b>Wiping leaves an opening.</b> Once a wipe starts, steering, guarding and cutting are locked until it ends, and a swing into the loose blade knocks it far aside. Losing poise mid-wipe cancels the full refill.\n\nBots punish wipes. Make some distance first.\n\nA later forge rank unlocks a quicker wipe."] = "<b>Limpar a l\195\162mina deixa uma brecha.</b> Depois que a limpeza come\195\167a, guiar, defender e cortar ficam bloqueados at\195\169 ela terminar, e um golpe na l\195\162mina solta a joga para longe. Perder postura no meio da limpeza cancela a recarga completa.\n\nOs bots punem limpezas. Ganhe dist\195\162ncia primeiro.\n\nUm rank de forja posterior desbloqueia uma limpeza mais r\195\161pida.",
		["Cuts leave blood on the blade. With the blade drawn, tap <b>WIPE</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "Cortes deixam sangue na l\195\162mina. Com a l\195\162mina sacada, toque em <b>LIMPAR</b> para limp\195\161-la com um pano, um lado e depois o outro. Uma limpeza leva cerca de {time} segundos.",
		["Drawing the sword"] = "Sacar a espada",
		["The sword starts sheathed, with a hand on the sheath, ready to draw.\n\n<b>{Lock}</b>: toggle lock-on. While locked on, the mouse picks the cut; its name shows at the bottom of the screen.\n<b>{NextTarget}</b>: switch target.\n<b>{Unequip}</b>: unequip the sword. <b>{Equip}</b>: equip it again."] = "A espada come\195\167a embainhada, com uma m\195\163o na bainha, pronta para sacar.\n\n<b>{Lock}</b>: ativar ou desativar a mira travada. Com a mira travada, o mouse escolhe o corte; o nome dele aparece na parte de baixo da tela.\n<b>{NextTarget}</b>: trocar de alvo.\n<b>{Unequip}</b>: soltar a espada. <b>{Equip}</b>: equip\195\161-la de novo.",
		["Move the mouse to pick the cut, then hold {Draw} and swipe:\n\n<b>Down-left</b>, swipe up-right: low cut.\n<b>Left</b>, swipe right: horizontal slice.\n<b>Up-left</b>, swipe down-right: diagonal cut.\n<b>Up</b>, swipe down: vertical slice.\n\nA faster swipe makes a faster cut.\n\n<b>{CalmDraw}</b>: calm draw. The blade slides out slowly into a guard, with no cut."] = "Mova o mouse para escolher o corte; depois, segure {Draw} e deslize:\n\n<b>Embaixo \195\160 esquerda</b>, deslize para cima e para a direita: corte baixo.\n<b>Esquerda</b>, deslize para a direita: corte horizontal.\n<b>Em cima \195\160 esquerda</b>, deslize para baixo e para a direita: corte diagonal.\n<b>Em cima</b>, deslize para baixo: corte vertical.\n\nQuanto mais r\195\161pido o deslize, mais r\195\161pido o corte.\n\n<b>{CalmDraw}</b>: saque calmo. A l\195\162mina sai devagar at\195\169 ficar em guarda, sem cortar.",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>{Equip}</b>: put the blade away. The next draw is ready about a second later."] = "Cortes de saque s\195\163o firmes. Uma l\195\162mina atingida por um corte de saque \195\169 desviada e perde {block} de postura. Cada corte de saque custa {draw} de postura.\n\n<b>{Equip}</b>: guardar a l\195\162mina. O pr\195\179ximo saque fica pronto cerca de um segundo depois.",
		["The sword starts sheathed, with a hand on the sheath, ready to draw. While locked on, a slow drag on the right side of the screen moves the hand on the sheath, and a quick <b>flick</b> draws. The flick\'s direction picks the cut.\n\n<b>LOCKED ON</b>: tap to switch target, hold to turn lock-on off. <b>LOCK ON</b>: tap to turn it back on.\n<b>UNEQUIP</b>: hold to unequip the sword. <b>EQUIP</b>: tap to equip it again."] = "A espada come\195\167a embainhada, com uma m\195\163o na bainha, pronta para sacar. Com a mira travada, arrastar devagar no lado direito da tela move a m\195\163o na bainha, e um <b>deslize r\195\161pido</b> saca. A dire\195\167\195\163o do deslize escolhe o corte.\n\n<b>MIRA TRAVADA</b>: toque para trocar de alvo, segure para desativar a mira. <b>TRAVAR MIRA</b>: toque para ativ\195\161-la de novo.\n<b>SOLTAR</b>: segure para soltar a espada. <b>EQUIPAR</b>: toque para equip\195\161-la de novo.",
		["<b>Flick right</b>: horizontal slice.\n<b>Flick down</b>: vertical slice.\n<b>Flick up-right</b>: low cut.\n\n<b>CALM DRAW</b>: the blade slides out slowly into a guard, with no cut."] = "<b>Deslize r\195\161pido para a direita</b>: corte horizontal.\n<b>Deslize r\195\161pido para baixo</b>: corte vertical.\n<b>Deslize r\195\161pido para cima e para a direita</b>: corte baixo.\n\n<b>SAQUE CALMO</b>: a l\195\162mina sai devagar at\195\169 ficar em guarda, sem cortar.",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>SHEATHE</b>: put the blade away. The next draw is ready about a second later."] = "Cortes de saque s\195\163o firmes. Uma l\195\162mina atingida por um corte de saque \195\169 desviada e perde {block} de postura. Cada corte de saque custa {draw} de postura.\n\n<b>GUARDAR</b>: guardar a l\195\162mina. O pr\195\179ximo saque fica pronto cerca de um segundo depois.",
		["Clashes and parries"] = "Choques e defesas",
		["Blades that meet push each other apart, and the firmer blade moves less. A hard swing knocks a still blade far aside, and that blade is slow to recover: an opening to attack.\n\nHit near the hands, a blade barely moves. Hit near the tip, it\'s knocked aside easily."] = "L\195\162minas que se encontram se empurram, e a mais firme se move menos. Um golpe forte joga uma l\195\162mina parada para longe, e essa l\195\162mina demora para se recuperar: uma brecha para atacar.\n\nAtingida perto das m\195\163os, uma l\195\162mina quase n\195\163o se move. Atingida perto da ponta, \195\169 desviada com facilidade.",
		["<b>Draw-cuts</b> hit hardest. A blade held still that meets a draw-cut, or the drawer while the blade comes out, is knocked aside, and the cut goes through.\n\n<b>A still guard</b> (L2 on a gamepad) parries other swings: the swing bounces off and the attacker is staggered.\n\n<b>Two swings meeting</b> both give way, and neither can cut for a moment.\n\nThe whole sword can clash, handle included."] = "<b>Cortes de saque</b> batem mais forte. Uma l\195\162mina parada que encontra um corte de saque, ou que toca quem saca enquanto a l\195\162mina sai, \195\169 desviada, e o corte passa.\n\n<b>Uma guarda parada</b> (L2 no controle) apara os outros golpes: o golpe ricocheteia e o atacante fica atordoado.\n\n<b>Dois golpes que se encontram</b> cedem os dois, e nenhum pode cortar por um momento.\n\nA espada inteira pode se chocar, punho inclu\195\173do.",
		["Cuts, wounds and bleeding"] = "Cortes, ferimentos e sangramento",
		["A cut needs speed and a leading edge. Speed comes from the swing and from movement, so dashing past counts. A sudden change of direction hits with the flat.\n\nOnly a blade moving into a target counts. A blade left resting in a body sticks."] = "Um corte precisa de velocidade e do fio na frente. A velocidade vem do golpe e do movimento, ent\195\163o passar com um dash conta. Uma mudan\195\167a brusca de dire\195\167\195\163o acerta com a parte chata.\n\nS\195\179 conta uma l\195\162mina que est\195\161 entrando no alvo. Uma l\195\162mina deixada parada dentro de um corpo fica presa.",
		["A fast, edge-first cut all the way through a limb <b>severs</b> it. Through the head or torso: <b>a kill</b>.\n\nAnything less is a <b>wound</b>: it bleeds and slows the limb. Deeper wounds are worse.\n\n<b>Stabs</b> never kill outright. A stab to the head, or a fast one to the body (dash or lunge in), takes a lot of blood at once. Other stabs wound."] = "Um membro atravessado por inteiro por um corte r\195\161pido, com o fio na frente, \195\169 <b>decepado</b>. Atrav\195\169s da cabe\195\167a ou do tronco: <b>um abate</b>.\n\nMenos que isso \195\169 um <b>ferimento</b>: sangra e deixa o membro lento. Ferimentos mais fundos s\195\163o piores.\n\n<b>Estocadas</b> nunca matam de uma vez. Uma estocada na cabe\195\167a, ou uma r\195\161pida no corpo (com dash ou avan\195\167ando), tira muito sangue de uma vez. Outras estocadas ferem.",
		["Every fighter has {squares} squares of blood. Wounds bleed for a few seconds, and so does a lost limb. With two limbs lost, the stumps bleed out. Losing both arms drops the katana.\n\nCombat is allowed in the arena and the forest, except in safe zones. Inside one, the screen shows <b>{safe}</b>."] = "Cada lutador tem {squares} quadrados de sangue. Ferimentos sangram por alguns segundos, e um membro perdido tamb\195\169m. Com dois membros perdidos, os cotos sangram at\195\169 a morte. Perder os dois bra\195\167os faz a katana cair.\n\nO combate \195\169 permitido na arena e na floresta, exceto nas zonas seguras. Dentro de uma, a tela mostra <b>{safe}</b>.",
		["The forge and levels"] = "A forja e os n\195\173veis",
		["XP rewards:\n\n<b>Wounding a player</b>: {wound}.\n<b>Severing a limb</b>: {sever}.\n<b>A kill</b>: {kill}.\n<b>Defeating a bot</b>: {botLeast} to {botMost}, more for rarer names.\n\nEach level needs a little more XP than the last. No level cap."] = "Recompensas de XP:\n\n<b>Ferir um jogador</b>: {wound}.\n<b>Decepar um membro</b>: {sever}.\n<b>Um abate</b>: {kill}.\n<b>Derrotar um bot</b>: de {botLeast} a {botMost}, mais para nomes mais raros.\n\nCada n\195\173vel pede um pouco mais de XP que o anterior. Sem limite de n\195\173vel.",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, press E at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "Um novo <b>rank de forja</b> \195\169 desbloqueado a cada {levels} n\195\173veis. Na forja, ao sul da arena, aperte E na bigorna para aquecer, martelar e temperar a l\195\162mina. Cada rank d\195\161 \195\160 l\195\162mina um novo visual e uma nova melhoria.\n\nA parede de espadas aqui mostra a l\195\162mina de cada rank de forja.\n\n<b>Reforje</b> para voltar a qualquer rank j\195\161 forjado.",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, tap <b>Forge your blade</b> at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "Um novo <b>rank de forja</b> \195\169 desbloqueado a cada {levels} n\195\173veis. Na forja, ao sul da arena, toque em <b>Forje sua l\195\162mina</b> na bigorna para aquecer, martelar e temperar a l\195\162mina. Cada rank d\195\161 \195\160 l\195\162mina um novo visual e uma nova melhoria.\n\nA parede de espadas aqui mostra a l\195\162mina de cada rank de forja.\n\n<b>Reforje</b> para voltar a qualquer rank j\195\161 forjado.",
		["Kill streaks"] = "Sequ\195\170ncias de abates",
		["A <b>kill streak</b> counts kills in a row without dying, shown at the top right. Bleed-outs from a cut count, and so do bot kills. Dying ends the streak, but the best one is saved."] = "Uma <b>sequ\195\170ncia de abates</b> conta os abates seguidos sem morrer e aparece no alto \195\160 direita. Mortes por sangramento ap\195\179s um corte contam, e abates de bots tamb\195\169m. Morrer encerra a sequ\195\170ncia, mas a melhor fica salva.",
		["The streak catches fire as it grows, and every ten kills earns a title. Every {every} kills up to {most}: +{share} walk speed and poise recovery (Mythic names +{mythic}, Exotic names +{exotic}).\n\nNo prizes: it\'s for the glory.\n\nAfter dying, <b>SPECTATE</b> watches other fighters and <b>RESPAWN</b> returns to the fight."] = "A sequ\195\170ncia pega fogo conforme cresce, e cada dez abates valem um t\195\173tulo. A cada {every} abates, at\195\169 {most}: +{share} de velocidade de caminhada e de recupera\195\167\195\163o de postura (sobrenomes M\195\173ticos +{mythic}, Ex\195\179ticos +{exotic}).\n\nSem pr\195\170mios: \195\169 pela gl\195\179ria.\n\nDepois de morrer, <b>ASSISTIR</b> mostra outros lutadores e <b>RENASCER</b> volta para a luta.",
		["TO WHOEVER FREED THIS TEMPLE"] = "A QUEM LIBERTOU ESTE TEMPLO",
		["Her blade still rests within these walls. Search every corner."] = "A l\195\162mina dela ainda repousa dentro destas muralhas. Procure em cada canto.",
		["YOU  {mine}  :  {theirs}  {name}"] = "VOC\195\138  {mine}  :  {theirs}  {name}",
		["1V1 \194\183 ROUND {round} \194\183 FIRST TO {wins}"] = "1V1 \194\183 RODADA {round} \194\183 PRIMEIRO A {wins}",
		["1V1 \194\183 FIRST TO {wins} KILLS"] = "1V1 \194\183 PRIMEIRO A {wins} ABATES",
		["Lock on to {name} to bow back."] = "Trave a mira em {name} para retribuir a sauda\195\167\195\163o.",
		["BOW BACK"] = "SAUDAR DE VOLTA",
		["ACCEPT"] = "ACEITAR",
		["{key}   BOW BACK"] = "{key}   SAUDAR DE VOLTA",
		["{key}   ACCEPT"] = "{key}   ACEITAR",
		["DECLINE"] = "RECUSAR",
		["{key}   DECLINE"] = "{key}   RECUSAR",
		["1V1 BOW"] = "SAUDA\195\135\195\131O 1V1",
		["1V1 REMATCH"] = "REVANCHE 1V1",
		["1V1 CHALLENGE"] = "DESAFIO 1V1",
		["{name} bows to you"] = "{name} te sa\195\186da",
		["{name} wants a rematch"] = "{name} quer revanche",
		["{name} challenges you"] = "{name} te desafia",
		["{name} bowed back: the 1v1 begins."] = "{name} retribuiu a sauda\195\167\195\163o: o 1v1 come\195\167a.",
		["They bowed back: the 1v1 begins."] = "O oponente retribuiu a sauda\195\167\195\163o: o 1v1 come\195\167a.",
		["FIGHT"] = "LUTEM!",
		["DRAW"] = "EMPATE",
		["No winner in {seconds} seconds: the round again."] = "Sem vencedor em {seconds} segundos: a rodada recome\195\167a.",
		["They stayed out of the ring: a point to you."] = "O oponente ficou fora do ringue: ponto para voc\195\170.",
		["You stayed out of the ring: a point to them."] = "Voc\195\170 ficou fora do ringue: ponto para o oponente.",
		["They left the 1v1."] = "O oponente saiu do 1v1.",
		["They forfeited."] = "O oponente desistiu.",
		["You forfeited."] = "Voc\195\170 desistiu.",
		["+{xp} XP   {why}"] = "+{xp} XP   {why}",
		["NO RESULT"] = "SEM RESULTADO",
		["The 1v1 couldn\'t go on."] = "O 1v1 n\195\163o p\195\180de continuar.",
		["VICTORY"] = "VIT\195\147RIA",
		["DEFEAT"] = "DERROTA",
		["Back into the ring: {seconds} seconds out loses the round"] = "Volte ao ringue: {seconds} segundos fora e voc\195\170 perde a rodada",
		["Back into the ring: {seconds} seconds out gives them a point"] = "Volte ao ringue: {seconds} segundos fora d\195\163o um ponto ao oponente",
		["1v1 queue: waiting for an opponent ({key} to leave it)"] = "Fila do 1v1: esperando um oponente ({key} para sair)",
		["MENU"] = "MENU",
		["First to {wins} kills."] = "Primeiro a {wins} abates.",
		["HEAT"] = "AQUECER",
