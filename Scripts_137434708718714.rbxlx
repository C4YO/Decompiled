		["Dark blade, crimson edge, red lightning, a glow that flares as it drinks."] = "\230\154\151\233\187\145\229\136\128\232\186\171\227\128\129\230\183\177\231\180\133\229\136\131\229\143\163\227\128\129\232\181\164\232\137\178\233\155\183\229\133\137\239\188\140\233\163\178\232\161\128\232\182\138\229\164\154\229\133\137\232\138\146\232\182\138\231\155\155\227\128\130",
		["FIND IT"] = "\229\176\139\230\137\190",
		["{short} Find it in the rooms of the temple on the hill."] = "{short} \229\156\168\229\177\177\228\184\138\229\175\186\229\187\159\231\154\132\230\136\191\233\150\147\232\163\161\229\143\175\228\187\165\230\137\190\229\136\176\229\174\131\227\128\130",
		["Blade length 3.2 studs"] = "\229\136\128\232\186\171\233\149\1833.2\230\160\188",
		["Blade length 3.4 studs, draw styles (coming soon)"] = "\229\136\128\232\186\171\233\149\1833.4\230\160\188\239\188\140\230\139\148\229\136\128\230\181\129\230\180\190\239\188\136\229\141\179\229\176\135\230\142\168\229\135\186\239\188\137",
		["+5% walk speed"] = "\231\167\187\229\139\149\233\128\159\229\186\166+5%",
		["+5% walk speed, 25% faster poise recovery"] = "\231\167\187\229\139\149\233\128\159\229\186\166+5%\239\188\140\232\187\128\229\185\185\230\129\162\229\190\169\233\128\159\229\186\166+25%",
		["After {delay} seconds of calm it comes back, {regen} a second: faster with a still guard (L2 on a gamepad), slower with little blood.\n\nBelow half, your feet slow down. The lower it is, the heavier your blade and the more easily it\'s knocked aside."] = "\229\185\179\233\157\156{delay}\231\167\146\229\190\140\233\150\139\229\167\139\230\129\162\229\190\169\239\188\140\230\175\143\231\167\146{regen}\239\188\154\233\157\156\230\173\162\230\160\188\230\147\139\230\153\130\230\155\180\229\191\171\239\188\136\230\137\139\230\138\138\231\130\186L2\239\188\137\239\188\140\232\161\128\233\135\143\228\189\142\230\153\130\230\155\180\230\133\162\227\128\130\n\n\228\189\142\230\150\188\228\184\128\229\141\138\230\153\130\239\188\140\228\189\160\231\154\132\232\133\179\230\173\165\230\156\131\232\174\138\230\133\162\227\128\130\232\182\138\228\189\142\239\188\140\228\189\160\231\154\132\229\136\128\232\182\138\230\178\137\239\188\140\228\185\159\232\182\138\229\174\185\230\152\147\232\162\171\230\147\138\233\150\139\227\128\130",
		["<b>Wiping resets your poise.</b> While the cloth is on the blade, poise comes back {times} times as fast, and a finished wipe fills it to full.\n\nIt works after a break too: finishing a wipe ends being weakened.\n\nA finished wipe also gives back all your dashes."] = "<b>\230\140\175\232\161\128\229\143\175\228\187\165\230\129\162\229\190\169\232\187\128\229\185\185\227\128\130</b>\229\184\131\232\178\188\229\156\168\229\136\128\228\184\138\230\153\130\239\188\140\232\187\128\229\185\185\228\187\165{times}\229\128\141\233\128\159\229\186\166\230\129\162\229\190\169\239\188\155\229\174\140\230\136\144\230\140\175\232\161\128\229\137\135\231\155\180\230\142\165\229\155\158\230\187\191\227\128\130\n\n\232\187\128\229\185\185\229\180\169\230\189\176\229\190\140\229\144\140\230\168\163\230\156\137\230\149\136\239\188\154\229\174\140\230\136\144\230\140\175\232\161\128\229\176\177\232\131\189\232\167\163\233\153\164\229\138\155\231\171\173\227\128\130\n\n\229\174\140\230\136\144\230\140\175\232\161\128\233\130\132\230\156\131\230\129\162\229\190\169\228\189\160\230\137\128\230\156\137\231\154\132\232\161\157\229\136\186\227\128\130",
		["tap WIPE to refill dashes"] = "\233\187\158\230\147\138\227\128\140\230\140\175\232\161\128\227\128\141\230\129\162\229\190\169\232\161\157\229\136\186",
		["{key}  wipe to refill dashes"] = "{key}  \230\140\175\232\161\128\228\187\165\230\129\162\229\190\169\232\161\157\229\136\186",
		["Out of dashes. Tap **WIPE** to wipe your blade and get them back."] = "\232\161\157\229\136\186\231\148\168\229\174\140\228\186\134\227\128\130\233\187\158\230\147\138**\230\140\175\232\161\128**\230\147\166\229\136\128\229\141\179\229\143\175\230\129\162\229\190\169\227\128\130",
		["Out of dashes. Press **{Wipe}** to wipe your blade and get them back."] = "\232\161\157\229\136\186\231\148\168\229\174\140\228\186\134\227\128\130\230\140\137 **{Wipe}** \230\147\166\229\136\128\229\141\179\229\143\175\230\129\162\229\190\169\227\128\130",
		["+1% walk speed"] = "\231\167\187\229\139\149\233\128\159\229\186\166+1%",
		["10% less poise lost to hits and clashes"] = "\229\143\151\229\136\176\230\148\187\230\147\138\229\146\140\230\160\188\230\147\139\231\162\176\230\146\158\230\153\130\232\187\128\229\185\185\230\144\141\229\164\177\230\184\155\229\176\14510%",
		["10% less poise lost to hits and clashes, 15% quicker back from knocks"] = "\229\143\151\229\136\176\230\148\187\230\147\138\229\146\140\230\160\188\230\147\139\231\162\176\230\146\158\230\153\130\232\187\128\229\185\185\230\144\141\229\164\177\230\184\155\229\176\14510%\239\188\140\232\162\171\230\147\138\233\128\128\229\190\140\230\129\162\229\190\169\229\191\17115%",
		["+1% walk speed, 25% faster poise recovery"] = "\231\167\187\229\139\149\233\128\159\229\186\166+1%\239\188\140\232\187\128\229\185\185\230\129\162\229\190\169\233\128\159\229\186\166+25%",
		["+20 blood"] = "\232\161\128\233\135\143+20",
		["UPGRADE READY"] = "\229\143\175\229\188\183\229\140\150",
		["the forge"] = "\233\141\155\229\136\128\229\157\138",
		["New look"] = "\229\133\168\230\150\176\229\164\150\232\167\128",
		["Draw styles (coming soon)"] = "\230\139\148\229\136\128\230\181\129\230\180\190\239\188\136\229\141\179\229\176\135\230\142\168\229\135\186\239\188\137",
		["SINGLE"] = "\228\184\128\229\136\128\230\181\129",
		["DUAL WIELD"] = "\228\186\140\229\136\128\230\181\129",
		["IAI"] = "\229\177\133\229\144\136"
	}
}
return v1]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX151">
            <Properties>
              <string name="Name">English</string>
              <ProtectedString name="Source"><![CDATA[local v1 = {
	["Name"] = "English",
	["Locales"] = nil,
	["Lines"] = nil,
	["Locales"] = { "en" },
	["Lines"] = {
		["1 free rename spin"] = true,
		["{count} free rename spins"] = true,
		["{xp} XP"] = true,
		["{scale}x XP for {minutes} minutes"] = true,
		["OPENED"] = true,
		["MISSED"] = true,
		["A door opens each day from 1 to 25 December while playing. Missed doors stay shut."] = true,
		["BACK"] = true,
		["AIM DOT"] = true,
		["COLOUR"] = true,
		["OUTLINE"] = true,
		["DOT"] = true,
		["BRIGHTNESS"] = true,
		["CUSTOM"] = true,
		["DEFAULT"] = true,
		["ON"] = true,
		["OFF"] = true,
		["Your blade is alight: {hits} hits."] = true,
		["Your blade\'s flame is out: wipe it again, then light it."] = true,
		["Your blade is waxed: hold it in a fire stand\'s flame."] = true,
		["{count} / {goal}"] = true,
		["The mist seals the way out: defeat the boss, or fall."] = true,
		["The seal is broken: the way out is open."] = true,
		["LOCAL"] = true,
		["DM"] = true,
		["GLOBAL"] = true,
		["SHOW"] = true,
		["HIDE"] = true,
		["Sending too fast. Wait a moment."] = true,
		["Message not sent."] = true,
		["Can\'t message this player."] = true,
		["Type a message"] = true,
		["{key}   chat"] = true,
		["No other players in this server."] = true,
		["Type a code and press REDEEM. Each code works once."] = true,
		["ENTER CODE"] = true,
		["Type a code first."] = true,
		["Checking..."] = true,
		["No answer from the server. Try again."] = true,
		["Redeemed: {reward}"] = true,
		["REDEEM"] = true,
		["YES"] = true,
		["NO"] = true,
		["CHARACTER"] = true,
		["APPEARANCE"] = true,
		["HAIR AND OUTFIT"] = true,
		["NAME"] = true,
		["LOADOUT"] = true,
		["Pick a first name or spin a new family name ({count} spin)."] = true,
		["Pick a first name or spin a new family name ({count} spins)."] = true,
		["Spin a new family name ({count} spin)."] = true,
		["Spin a new family name ({count} spins)."] = true,
		["CUSTOMISE APPEARANCE"] = true,
		["Hair, outfit, accessory, face, skins, effects and colours."] = true,
		["CUSTOMISE NAME"] = true,
		["Select draw style or change weapon."] = true,
		["SKIP ANIMATION"] = true,
		["ROLL ALL"] = true,
		["SPIN AGAIN \194\183 {count}"] = true,
		["SPIN FAMILY NAME \194\183 {count}"] = true,
		["NEW FAMILY NAME"] = true,
		["KEEP {name}"] = true,
		["No rename spins left: {count} each level up, and more in the SHOP."] = true,
		["No rename spins left: {count} each level up."] = true,
		["Spin again?"] = true,
		["Couldn\'t spin. Try again."] = true,
		["Keep {name}?"] = true,
		["Couldn\'t choose. Try again."] = true,
		["SPIN x{count}"] = true,
		["TEN NEW FAMILY NAMES"] = true,
		["SPIN x10 needs {need} rename spins. Spins: {have}."] = true,
		["Spin x{count}?"] = true,
		["BEST OF {count} ROLLS"] = true,
		["Use all {count} spins?"] = true,
		["Every name rolled is listed once, best first."] = true,
		["EVENT"] = true,
		["LIMITED"] = true,
		["ROBUX"] = true,
		["QUEST"] = true,
		["PATH"] = true,
		["DROP"] = true,
		["SOON"] = true,
		["CODE"] = true,
		["ADVENT"] = true,
		["LV {level}"] = true,
		["HAIR"] = true,
		["HAIR COLOUR"] = true,
		["OUTFIT"] = true,
		["ACCESSORY"] = true,
		["ACCESSORY COLOUR"] = true,
		["FACE"] = true,
		["SWORD"] = true,
		["BLOOD"] = true,
		["EFFECT"] = true,
		["DRAW STYLES"] = true,
		["RIGHT KATANA"] = true,
		["LEFT KATANA"] = true,
		["KATANA: DUAL"] = true,
		["BODY COLOURS: BELOW"] = true,
		["BODY COLOURS"] = true,
		["CLOSE"] = true,
		["WEAPON SKIN"] = true,
		["BLOOD SKIN"] = true,
		["WEAPON EFFECT"] = true,
		["{item}   \194\183   {kind}"] = true,
		["Owned and equipped."] = true,
		["{chance}% chance to drop from the {boss}."] = true,
		["Only from a code (CODES, in the menu)."] = true,
		["Only from the advent calendar, day {day}."] = true,
		["Needs the Shamisen pass."] = true,
		["Only from the {quest} (QUESTS, in the menu)."] = true,
		["Only from the quests (QUESTS, in the menu)."] = true,
		["Not obtainable yet."] = true,
		["{chance}% chance to drop from {rarity} and higher rarity bots."] = true,
		["Finish chapter {chapter} of the Path of the Sword, {name} (QUESTS, in the menu)."] = true,
		["Only from the Path of the Sword (QUESTS, in the menu)."] = true,
		["Limited: no longer in the shop."] = true,
		["Limited: only in the shop until {date}."] = true,
		["Limited: only in the shop for a while."] = true,
		["Only sold for Robux."] = true,
		["Available to buy."] = true,
		["Available to buy with ry\197\141 from level {level}, or with Robux now."] = true,
		["Available to buy from level {level}."] = true,
		["BUY {price}"] = true,
		["NOT ON SALE"] = true,
		["WEAPON"] = true,
		["DRAW STYLE"] = true,
		["{short} Owned: equipped from the next spawn."] = true,
		["{short} Permanent unlock."] = true,
		["{short} Only sold for Robux. Permanent unlock."] = true,
		["Not enough ry\197\141: {amount} more to go."] = true,
		["Buy {name}?"] = true,
		["Price: {price}. Balance: {have}."] = true,
		["Buying..."] = true,
		["DONE"] = true,
		["Keep one of the names first."] = true,
		["SAVING"] = true,
		["Couldn\'t save. Try again."] = true,
		["DAILY REWARD"] = true,
		["+1 free rename spin"] = true,
		["+{count} free rename spins"] = true,
		["Day {day} in a row: {spins} spins a day."] = true,
		["Day {day} in a row. From day {from} you get {spins} a day."] = true,
		["MERRY CHRISTMAS"] = true,
		["A gift for playing on Christmas Day."] = true,
		["DAILY BONUS"] = true,
		["+{xp} XP"] = true,
		["All daily quests done"] = true,
		["ADVENT CALENDAR"] = true,
		["Day {day} of 25"] = true,
		["no boost"] = true,
		["{count} boost: +{walk} walk speed or +{other} to another stat"] = true,
		["{count} boosts, each +{walk} walk speed or +{other} to another stat"] = true,
		["Safe zone: combat forbidden"] = true,
		["Names and boosts"] = true,
		["<b>Family name</b>: rolled once, at the forge.\n<b>First name</b>: reroll any time on the character screen (CHARACTER, on the title screen).\n\nRarer family names give stat boosts. Boosts are kept small, so fights are still won with the blade."] = true,
		["Rarity, odds and boosts:\n\n{rarities}\n\nThe rarest names belong to famous swordsmen and warlords. A Mythic name is a legend\'s own name, used in place of a family name. An Exotic name is a god\'s. Every spin is pure chance at these odds."] = true,
		["Boosts:\n\n<b>Walk speed</b>: faster movement.\n<b>Poise recovery</b>: poise refills faster.\n<b>Poise toughness</b>: all poise costs are lower.\n<b>Slower bleeding</b>: wounds and stumps bleed slower.\n<b>Faster dash recharge</b>: dash charges refill sooner.\n\nBoosts stack with forge upgrades."] = true,
		["<b>Rename spins</b> reroll the family name. Get {spins} free spins every level, or buy more in the SHOP. Use them on the character screen. The old name can always be kept.\n\nBots have names too. The rarer a bot\'s name, the better it fights."] = true,
		["Poise"] = true,
		["<b>Poise</b> is a fighter\'s steadiness. The poise bar is the thin bar above the blood squares; an opponent\'s is under their name. It grows from the middle as poise is lost, turning from gold to red, and hides at full poise."] = true,
		["Poise costs:\n\n<b>Draw-cut</b>: {draw}.  <b>Blade hit by a draw-cut</b>: {block}.\n<b>Hard swing</b>: {swing}.  <b>Dash</b>: {dash}.  <b>Kick</b>: {kick}.\n<b>Taking a cut</b>: {wound} (double from a draw-cut), plus blood loss.\n<b>Clashes</b>: more the harder the blade is knocked."] = true,
		["Poise refills after {delay} seconds with no poise lost, at {regen} per second. A still guard (L2 on a gamepad) refills it faster; low blood refills it slower.\n\nBelow half poise, blade and movement speed drop, and the blade is knocked aside more easily."] = true,
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> ({Wipe}). See the next scroll."] = true,
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> (WIPE). See the next scroll."] = true,
		["Wiping the blade"] = true,
		["Cuts leave blood on the blade. With the blade drawn, press <b>{Wipe}</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = true,
		["<b>Wiping restores poise.</b> During a wipe, poise refills at {times}x speed, and a finished wipe fills it to full.\n\nAfter a poise break, a finished wipe also ends the weakened state."] = true,
		["<b>Wiping leaves an opening.</b> Once a wipe starts, steering, guarding and cutting are locked until it ends, and a swing into the loose blade knocks it far aside. Losing poise mid-wipe cancels the full refill.\n\nBots punish wipes. Make some distance first.\n\nA later forge rank unlocks a quicker wipe."] = true,
		["Cuts leave blood on the blade. With the blade drawn, tap <b>WIPE</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = true,
		["Drawing the sword"] = true,
		["The sword starts sheathed, with a hand on the sheath, ready to draw.\n\n<b>{Lock}</b>: toggle lock-on. While locked on, the mouse picks the cut; its name shows at the bottom of the screen.\n<b>{NextTarget}</b>: switch target.\n<b>{Unequip}</b>: unequip the sword. <b>{Equip}</b>: equip it again."] = true,
		["Move the mouse to pick the cut, then hold {Draw} and swipe:\n\n<b>Down-left</b>, swipe up-right: low cut.\n<b>Left</b>, swipe right: horizontal slice.\n<b>Up-left</b>, swipe down-right: diagonal cut.\n<b>Up</b>, swipe down: vertical slice.\n\nA faster swipe makes a faster cut.\n\n<b>{CalmDraw}</b>: calm draw. The blade slides out slowly into a guard, with no cut."] = true,
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>{Equip}</b>: put the blade away. The next draw is ready about a second later."] = true,
		["The sword starts sheathed, with a hand on the sheath, ready to draw. While locked on, a slow drag on the right side of the screen moves the hand on the sheath, and a quick <b>flick</b> draws. The flick\'s direction picks the cut.\n\n<b>LOCKED ON</b>: tap to switch target, hold to turn lock-on off. <b>LOCK ON</b>: tap to turn it back on.\n<b>UNEQUIP</b>: hold to unequip the sword. <b>EQUIP</b>: tap to equip it again."] = true,
		["<b>Flick right</b>: horizontal slice.\n<b>Flick down</b>: vertical slice.\n<b>Flick up-right</b>: low cut.\n\n<b>CALM DRAW</b>: the blade slides out slowly into a guard, with no cut."] = true,
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>SHEATHE</b>: put the blade away. The next draw is ready about a second later."] = true,
		["Clashes and parries"] = true,
		["Blades that meet push each other apart, and the firmer blade moves less. A hard swing knocks a still blade far aside, and that blade is slow to recover: an opening to attack.\n\nHit near the hands, a blade barely moves. Hit near the tip, it\'s knocked aside easily."] = true,
		["<b>Draw-cuts</b> hit hardest. A blade held still that meets a draw-cut, or the drawer while the blade comes out, is knocked aside, and the cut goes through.\n\n<b>A still guard</b> (L2 on a gamepad) parries other swings: the swing bounces off and the attacker is staggered.\n\n<b>Two swings meeting</b> both give way, and neither can cut for a moment.\n\nThe whole sword can clash, handle included."] = true,
		["Cuts, wounds and bleeding"] = true,
		["A cut needs speed and a leading edge. Speed comes from the swing and from movement, so dashing past counts. A sudden change of direction hits with the flat.\n\nOnly a blade moving into a target counts. A blade left resting in a body sticks."] = true,
		["A fast, edge-first cut all the way through a limb <b>severs</b> it. Through the head or torso: <b>a kill</b>.\n\nAnything less is a <b>wound</b>: it bleeds and slows the limb. Deeper wounds are worse.\n\n<b>Stabs</b> never kill outright. A stab to the head, or a fast one to the body (dash or lunge in), takes a lot of blood at once. Other stabs wound."] = true,
		["Every fighter has {squares} squares of blood. Wounds bleed for a few seconds, and so does a lost limb. With two limbs lost, the stumps bleed out. Losing both arms drops the katana.\n\nCombat is allowed in the arena and the forest, except in safe zones. Inside one, the screen shows <b>{safe}</b>."] = true,
		["The forge and levels"] = true,
		["XP rewards:\n\n<b>Wounding a player</b>: {wound}.\n<b>Severing a limb</b>: {sever}.\n<b>A kill</b>: {kill}.\n<b>Defeating a bot</b>: {botLeast} to {botMost}, more for rarer names.\n\nEach level needs a little more XP than the last. No level cap."] = true,
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, press E at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = true,
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, tap <b>Forge your blade</b> at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = true,
		["Kill streaks"] = true,
		["A <b>kill streak</b> counts kills in a row without dying, shown at the top right. Bleed-outs from a cut count, and so do bot kills. Dying ends the streak, but the best one is saved."] = true,
		["The streak catches fire as it grows, and every ten kills earns a title. Every {every} kills up to {most}: +{share} walk speed and poise recovery (Mythic names +{mythic}, Exotic names +{exotic}).\n\nNo prizes: it\'s for the glory.\n\nAfter dying, <b>SPECTATE</b> watches other fighters and <b>RESPAWN</b> returns to the fight."] = true,
		["TO WHOEVER FREED THIS TEMPLE"] = true,
		["Her blade still rests within these walls. Search every corner."] = true,
		["YOU  {mine}  :  {theirs}  {name}"] = true,
		["1V1 \194\183 ROUND {round} \194\183 FIRST TO {wins}"] = true,
		["1V1 \194\183 FIRST TO {wins} KILLS"] = true,
		["Lock on to {name} to bow back."] = true,
		["BOW BACK"] = true,
		["ACCEPT"] = true,
		["{key}   BOW BACK"] = true,
