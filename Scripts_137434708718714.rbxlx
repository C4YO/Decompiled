		["2x XP for 30 minutes"] = "30\235\182\132 \235\143\153\236\149\136 XP 2\235\176\176",
		["2x XP"] = "XP 2\235\176\176",
		["Doubles all XP earned. Stacks with other XP multipliers and passes."] = "\236\150\187\235\138\148 \235\170\168\235\147\160 XP\234\176\128 2\235\176\176\234\176\128 \235\143\188\236\154\148. \235\139\164\235\165\184 XP \235\176\176\236\156\168 \237\154\168\234\179\188 \235\176\143 \237\140\168\236\138\164\236\153\128 \236\164\145\236\178\169\235\143\188\236\154\148.",
		["1.5x XP"] = "XP 1.5\235\176\176",
		["Multiplies all XP by 1.5. Stacks with other XP multipliers and passes."] = "\235\170\168\235\147\160 XP\234\176\128 1.5\235\176\176\234\176\128 \235\143\188\236\154\148. \235\139\164\235\165\184 XP \235\176\176\236\156\168 \237\154\168\234\179\188 \235\176\143 \237\140\168\236\138\164\236\153\128 \236\164\145\236\178\169\235\143\188\236\154\148.",
		["2x Ry\197\141"] = "\228\184\161 2\235\176\176",
		["Doubles every ry\197\141 gain: kills, quests, rewards and ry\197\141 packs."] = "\236\150\187\235\138\148 \235\170\168\235\147\160 \228\184\161\236\157\180 2\235\176\176\234\176\128 \235\143\188\236\154\148: \236\178\152\236\185\152, \237\128\152\236\138\164\237\138\184, \235\179\180\236\131\129, \228\184\161 \237\140\169\234\185\140\236\167\128.",
		["Dual Wield"] = "\236\157\180\235\143\132\235\165\152",
		["A second katana at your right hip: draw both at once and fight with one in each hand."] = "\236\152\164\235\165\184\236\170\189 \237\151\136\235\166\172\236\151\144 \236\185\180\237\131\128\235\130\152 \237\149\156 \236\158\144\235\163\168 \235\141\148: \235\145\144 \236\158\144\235\163\168\235\165\188 \235\143\153\236\139\156\236\151\144 \235\189\145\236\149\132 \236\150\145\236\134\144\236\151\144 \237\149\152\235\130\152\236\148\169 \235\147\164\234\179\160 \236\139\184\236\155\140\236\154\148.",
		["Iai"] = "\234\177\176\237\149\169",
		["Draw-cuts only. Cuts through blades, but a miss can be parried. 1.5x dash, 1.6x draw speed."] = "\235\176\156\235\143\132 \235\178\160\234\184\176 \236\160\132\236\154\169. \236\185\188\235\130\160\236\157\132 \235\154\171\234\179\160 \235\178\160\236\167\128\235\167\140, \235\185\151\235\130\152\234\176\128\235\169\180 \237\140\168\235\167\129\235\139\185\237\149\160 \236\136\152 \236\158\136\236\150\180\236\154\148. \235\140\128\236\139\156 1.5\235\176\176, \235\176\156\235\143\132 \236\134\141\235\143\132 1.6\235\176\176.",
		["Shamisen"] = "\236\131\164\235\175\184\236\132\188",
		["A playable three-string shamisen. Pluck with the mouse or a finger; 9 keys or pads set the notes. Heard by nearby players."] = "\236\151\176\236\163\188\237\149\160 \236\136\152 \236\158\136\235\138\148 3\237\152\132 \236\131\164\235\175\184\236\132\188. \235\167\136\236\154\176\236\138\164\235\130\152 \236\134\144\234\176\128\235\157\189\236\156\188\235\161\156 \236\164\132\236\157\132 \237\138\149\234\184\176\234\179\160, 9\234\176\156\236\157\152 \237\130\164\235\130\152 \237\140\168\235\147\156\235\161\156 \236\157\140\236\157\132 \236\160\149\237\149\180\236\154\148. \234\183\188\236\178\152 \237\148\140\235\160\136\236\157\180\236\150\180\236\151\144\234\178\140 \235\147\164\235\160\164\236\154\148.",
