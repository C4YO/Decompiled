		["Quick wipe: both sides at once"] = "\229\191\171\233\128\159\230\140\175\232\161\128\239\188\154\229\133\169\233\157\162\228\184\128\230\172\161\230\140\175\230\183\168",
		["Gold guard, collar and pommel."] = "\233\135\145\232\137\178\229\136\128\233\144\148\227\128\129\229\136\128\231\174\141\232\136\135\230\159\132\233\160\173\227\128\130",
		["Blade length 3.0 studs"] = "\229\136\128\232\186\171\233\149\1833.0\230\160\188",
		["Gleaming silver, crescent-moon guard, white cord and sheath."] = "\233\150\131\228\186\174\233\138\128\232\186\171\227\128\129\230\150\176\230\156\136\229\189\162\229\136\128\233\144\148\227\128\129\231\153\189\232\137\178\230\159\132\231\185\169\232\136\135\229\136\128\233\158\152\227\128\130",
