		["Available to buy."] = "\234\181\172\235\167\164 \234\176\128\235\138\165.",
		["Available to buy with ry\197\141 from level {level}, or with Robux now."] = "\235\160\136\235\178\168 {level}\235\182\128\237\132\176 \228\184\161 \234\181\172\235\167\164 \234\176\128\235\138\165, \235\161\156\235\178\133\236\138\164\235\161\156\235\138\148 \236\167\128\234\184\136 \234\181\172\235\167\164 \234\176\128\235\138\165.",
		["Available to buy from level {level}."] = "\235\160\136\235\178\168 {level}\235\182\128\237\132\176 \234\181\172\235\167\164 \234\176\128\235\138\165.",
		["BUY {price}"] = "\234\181\172\235\167\164 {price}",
		["NOT ON SALE"] = "\235\185\132\235\167\164\237\146\136",
		["WEAPON"] = "\235\172\180\234\184\176",
		["DRAW STYLE"] = "\235\176\156\235\143\132 \236\138\164\237\131\128\236\157\188",
		["{short} Owned: equipped from the next spawn."] = "{short} \235\179\180\236\156\160 \236\164\145: \235\139\164\236\157\140 \236\138\164\237\143\176\235\182\128\237\132\176 \236\158\165\236\176\169.",
		["{short} Permanent unlock."] = "{short} \236\152\129\234\181\172 \237\149\180\234\184\136.",
		["{short} Only sold for Robux. Permanent unlock."] = "{short} \235\161\156\235\178\133\236\138\164\235\161\156\235\167\140 \237\140\144\235\167\164. \236\152\129\234\181\172 \237\149\180\234\184\136.",
		["Not enough ry\197\141: {amount} more to go."] = "\228\184\161 \235\182\128\236\161\177: {amount} \235\141\148 \237\149\132\236\154\148\237\149\180\236\154\148.",
		["Buy {name}?"] = "{name} \234\181\172\235\167\164\237\149\160\234\185\140\236\154\148?",
		["Price: {price}. Balance: {have}."] = "\234\176\128\234\178\169 {price}. \236\158\148\236\149\161 {have}.",
		["Buying..."] = "\234\181\172\235\167\164 \236\164\145...",
		["DONE"] = "\236\153\132\235\163\140",
		["Keep one of the names first."] = "\235\168\188\236\160\128 \236\157\180\235\166\132 \237\149\152\235\130\152\235\165\188 \236\132\160\237\131\157\237\149\152\236\132\184\236\154\148.",
		["SAVING"] = "\236\160\128\236\158\165 \236\164\145",
		["Couldn\'t save. Try again."] = "\236\160\128\236\158\165\237\149\152\236\167\128 \235\170\187\237\150\136\236\150\180\236\154\148. \235\139\164\236\139\156 \236\139\156\235\143\132\237\149\152\236\132\184\236\154\148.",
		["DAILY REWARD"] = "\236\157\188\236\157\188 \235\179\180\236\131\129",
		["+1 free rename spin"] = "\235\172\180\235\163\140 \234\176\156\235\170\133\234\182\140 +1",
		["+{count} free rename spins"] = "\235\172\180\235\163\140 \234\176\156\235\170\133\234\182\140 +{count}",
		["Day {day} in a row: {spins} spins a day."] = "{day}\236\157\188 \236\151\176\236\134\141: \237\149\152\235\163\168 \234\176\156\235\170\133\234\182\140 {spins}\234\176\156.",
		["Day {day} in a row. From day {from} you get {spins} a day."] = "{day}\236\157\188 \236\151\176\236\134\141. {from}\236\157\188\236\167\184\235\182\128\237\132\176 \237\149\152\235\163\168 {spins}\234\176\156\235\165\188 \235\176\155\236\149\132\236\154\148.",
		["MERRY CHRISTMAS"] = "\235\169\148\235\166\172 \237\129\172\235\166\172\236\138\164\235\167\136\236\138\164",
		["A gift for playing on Christmas Day."] = "\237\129\172\235\166\172\236\138\164\235\167\136\236\138\164 \235\139\185\236\157\188 \236\160\145\236\134\141 \236\132\160\235\172\188\236\157\180\236\151\144\236\154\148.",
		["DAILY BONUS"] = "\236\157\188\236\157\188 \235\179\180\235\132\136\236\138\164",
		["+{xp} XP"] = "+{xp} XP",
		["All daily quests done"] = "\236\157\188\236\157\188 \237\128\152\236\138\164\237\138\184 \235\170\168\235\145\144 \236\153\132\235\163\140",
		["ADVENT CALENDAR"] = "\236\150\180\235\147\156\235\178\164\237\138\184 \236\186\152\235\166\176\235\141\148",
		["Day {day} of 25"] = "25\236\157\188 \236\164\145 {day}\236\157\188\236\167\184",
		["no boost"] = "\235\179\180\235\132\136\236\138\164 \236\151\134\236\157\140",
		["{count} boost: +{walk} walk speed or +{other} to another stat"] = "\235\179\180\235\132\136\236\138\164 {count}\234\176\156: \236\157\180\235\143\153 \236\134\141\235\143\132 +{walk} \235\152\144\235\138\148 \235\139\164\235\165\184 \235\138\165\235\160\165\236\185\152 +{other}",
		["{count} boosts, each +{walk} walk speed or +{other} to another stat"] = "\235\179\180\235\132\136\236\138\164 {count}\234\176\156, \234\176\129\234\176\129 \236\157\180\235\143\153 \236\134\141\235\143\132 +{walk} \235\152\144\235\138\148 \235\139\164\235\165\184 \235\138\165\235\160\165\236\185\152 +{other}",
		["Safe zone: combat forbidden"] = "\236\149\136\236\160\132 \236\167\128\235\140\128: \236\160\132\237\136\172 \234\184\136\236\167\128",
		["Names and boosts"] = "\236\157\180\235\166\132\234\179\188 \235\179\180\235\132\136\236\138\164",
		["<b>Family name</b>: rolled once, at the forge.\n<b>First name</b>: reroll any time on the character screen (CHARACTER, on the title screen).\n\nRarer family names give stat boosts. Boosts are kept small, so fights are still won with the blade."] = "<b>\236\132\177\236\148\168</b>: \235\140\128\236\158\165\234\176\132\236\151\144\236\132\156 \237\149\156 \235\178\136 \235\189\145\236\149\132\236\154\148.\n<b>\236\157\180\235\166\132</b>: \236\186\144\235\166\173\237\132\176 \237\153\148\235\169\180(\237\131\128\236\157\180\237\139\128 \237\153\148\235\169\180\236\157\152 [\236\186\144\235\166\173\237\132\176])\236\151\144\236\132\156 \236\150\184\236\160\156\235\147\160 \235\139\164\236\139\156 \235\189\145\236\157\132 \236\136\152 \236\158\136\236\150\180\236\154\148.\n\n\237\157\172\234\183\128\237\149\156 \236\132\177\236\148\168\236\157\188\236\136\152\235\161\157 \235\138\165\235\160\165\236\185\152 \235\179\180\235\132\136\236\138\164\235\165\188 \236\164\152\236\154\148. \235\179\180\235\132\136\236\138\164\235\138\148 \236\158\145\234\178\140 \236\156\160\236\167\128\235\144\152\235\175\128\235\161\156 \236\138\185\235\182\128\235\138\148 \236\151\172\236\160\132\237\158\136 \236\185\188\235\161\156 \234\176\136\235\160\164\236\154\148.",
		["Rarity, odds and boosts:\n\n{rarities}\n\nThe rarest names belong to famous swordsmen and warlords. A Mythic name is a legend\'s own name, used in place of a family name. An Exotic name is a god\'s. Every spin is pure chance at these odds."] = "\237\157\172\234\183\128\235\143\132, \237\153\149\235\165\160, \235\179\180\235\132\136\236\138\164:\n\n{rarities}\n\n\234\176\128\236\158\165 \237\157\172\234\183\128\237\149\156 \236\157\180\235\166\132\236\157\128 \236\156\160\235\170\133\237\149\156 \234\178\128\234\176\157\234\179\188 \235\172\180\236\158\165\236\157\152 \234\178\131\236\157\180\236\151\144\236\154\148. \236\139\160\237\153\148 \236\157\180\235\166\132\236\157\128 \236\160\132\236\132\164 \236\134\141 \236\157\184\235\172\188 \235\179\184\236\157\184\236\157\152 \236\157\180\235\166\132\236\156\188\235\161\156, \236\132\177\236\148\168 \235\140\128\236\139\160 \236\147\176\236\151\172\236\154\148. \236\180\136\236\155\148 \236\157\180\235\166\132\236\157\128 \236\139\160\236\157\152 \236\157\180\235\166\132\236\157\180\236\151\144\236\154\148. \235\170\168\235\147\160 \235\189\145\234\184\176\235\138\148 \236\157\180 \237\153\149\235\165\160\236\157\132 \235\148\176\235\165\180\235\138\148 \236\136\156\236\136\152\237\149\156 \236\154\180\236\157\180\236\151\144\236\154\148.",
		["Boosts:\n\n<b>Walk speed</b>: faster movement.\n<b>Poise recovery</b>: poise refills faster.\n<b>Poise toughness</b>: all poise costs are lower.\n<b>Slower bleeding</b>: wounds and stumps bleed slower.\n<b>Faster dash recharge</b>: dash charges refill sooner.\n\nBoosts stack with forge upgrades."] = "\235\179\180\235\132\136\236\138\164:\n\n<b>\236\157\180\235\143\153 \236\134\141\235\143\132</b>: \236\157\180\235\143\153\236\157\180 \235\185\168\235\157\188\236\160\184\236\154\148.\n<b>\236\158\144\236\132\184 \237\154\140\235\179\181</b>: \236\158\144\236\132\184\234\176\128 \235\141\148 \235\185\168\235\166\172 \237\154\140\235\179\181\235\143\188\236\154\148.\n<b>\236\158\144\236\132\184 \234\176\149\236\157\184\235\143\132</b>: \235\170\168\235\147\160 \236\158\144\236\132\184 \236\134\140\235\170\168\234\176\128 \236\164\132\236\150\180\236\154\148.\n<b>\236\182\156\237\152\136 \234\176\144\236\134\140</b>: \236\131\129\236\178\152\236\153\128 \236\158\152\235\166\176 \235\182\128\236\156\132\236\157\152 \236\182\156\237\152\136\236\157\180 \235\138\144\235\160\164\236\160\184\236\154\148.\n<b>\235\140\128\236\139\156 \236\182\169\236\160\132 \236\134\141\235\143\132</b>: \235\140\128\236\139\156 \236\182\169\236\160\132\236\157\180 \235\141\148 \235\185\168\235\166\172 \236\177\132\236\155\140\236\160\184\236\154\148.\n\n\235\179\180\235\132\136\236\138\164\235\138\148 \235\140\128\236\158\165\234\176\132 \234\176\149\237\153\148\236\153\128 \236\164\145\236\178\169\235\143\188\236\154\148.",
		["<b>Rename spins</b> reroll the family name. Get {spins} free spins every level, or buy more in the SHOP. Use them on the character screen. The old name can always be kept.\n\nBots have names too. The rarer a bot\'s name, the better it fights."] = "<b>\234\176\156\235\170\133\234\182\140</b>\236\156\188\235\161\156 \236\132\177\236\148\168\235\165\188 \235\139\164\236\139\156 \235\189\145\236\149\132\236\154\148. \235\160\136\235\178\168\235\167\136\235\139\164 \235\172\180\235\163\140 \234\176\156\235\170\133\234\182\140 {spins}\234\176\156\235\165\188 \235\176\155\234\179\160, [\236\131\129\236\160\144]\236\151\144\236\132\156 \235\141\148 \234\181\172\235\167\164\237\149\160 \236\136\152\235\143\132 \236\158\136\236\150\180\236\154\148. \236\186\144\235\166\173\237\132\176 \237\153\148\235\169\180\236\151\144\236\132\156 \236\130\172\236\154\169\237\149\152\236\132\184\236\154\148. \236\155\144\235\158\152 \236\132\177\236\148\168\235\138\148 \236\150\184\236\160\156\235\147\160 \236\156\160\236\167\128\237\149\160 \236\136\152 \236\158\136\236\150\180\236\154\148.\n\n\235\180\135\236\151\144\234\178\140\235\143\132 \236\157\180\235\166\132\236\157\180 \236\158\136\236\150\180\236\154\148. \236\157\180\235\166\132\236\157\180 \237\157\172\234\183\128\237\149\156 \235\180\135\236\157\188\236\136\152\235\161\157 \235\141\148 \236\158\152 \236\139\184\236\155\140\236\154\148.",
		["Poise"] = "\236\158\144\236\132\184",
		["<b>Poise</b> is a fighter\'s steadiness. The poise bar is the thin bar above the blood squares; an opponent\'s is under their name. It grows from the middle as poise is lost, turning from gold to red, and hides at full poise."] = "<b>\236\158\144\236\132\184</b>\235\138\148 \234\178\128\234\176\157\236\157\180 \236\150\188\235\167\136\235\130\152 \236\149\136\236\160\149\236\160\129\236\157\184\236\167\128\235\165\188 \235\130\152\237\131\128\235\130\180\236\154\148. \236\158\144\236\132\184 \235\167\137\235\140\128\235\138\148 \237\148\188 \236\185\184 \236\156\132\236\157\152 \236\150\135\236\157\128 \235\167\137\235\140\128\236\157\180\234\179\160, \236\131\129\235\140\128\236\157\152 \236\158\144\236\132\184 \235\167\137\235\140\128\235\138\148 \236\157\180\235\166\132 \236\149\132\235\158\152\236\151\144 \236\158\136\236\150\180\236\154\148. \236\158\144\236\132\184\235\165\188 \236\158\131\236\157\132\236\136\152\235\161\157 \234\176\128\236\154\180\235\141\176\236\132\156\235\182\128\237\132\176 \235\138\152\236\150\180\235\130\152\235\169\176 \234\184\136\236\131\137\236\151\144\236\132\156 \235\185\168\234\176\132\236\131\137\236\156\188\235\161\156 \235\176\148\235\128\140\234\179\160, \236\158\144\236\132\184\234\176\128 \234\176\128\235\147\157 \236\176\168\235\169\180 \236\130\172\235\157\188\236\160\184\236\154\148.",
		["Poise costs:\n\n<b>Draw-cut</b>: {draw}.  <b>Blade hit by a draw-cut</b>: {block}.\n<b>Hard swing</b>: {swing}.  <b>Dash</b>: {dash}.  <b>Kick</b>: {kick}.\n<b>Taking a cut</b>: {wound} (double from a draw-cut), plus blood loss.\n<b>Clashes</b>: more the harder the blade is knocked."] = "\236\158\144\236\132\184 \236\134\140\235\170\168:\n\n<b>\235\176\156\235\143\132 \235\178\160\234\184\176</b>: {draw}.  <b>\235\176\156\235\143\132 \235\178\160\234\184\176\236\151\144 \235\182\128\235\148\170\237\158\140 \236\185\188</b>: {block}.\n<b>\234\176\149\237\149\156 \237\156\152\235\145\144\235\165\180\234\184\176</b>: {swing}.  <b>\235\140\128\236\139\156</b>: {dash}.  <b>\235\176\156\236\176\168\234\184\176</b>: {kick}.\n<b>\235\178\160\236\158\132</b>: {wound} (\235\176\156\235\143\132 \235\178\160\234\184\176\235\169\180 2\235\176\176), \236\182\156\237\152\136\235\161\156 \236\182\148\234\176\128 \236\134\140\235\170\168.\n<b>\236\182\169\235\143\140</b>: \236\185\188\236\157\180 \236\132\184\234\178\140 \237\138\149\234\184\184\236\136\152\235\161\157 \235\141\148 \235\167\142\236\157\180.",
		["Poise refills after {delay} seconds with no poise lost, at {regen} per second. A still guard (L2 on a gamepad) refills it faster; low blood refills it slower.\n\nBelow half poise, blade and movement speed drop, and the blade is knocked aside more easily."] = "\236\158\144\236\132\184\235\165\188 \236\158\131\236\167\128 \236\149\138\234\179\160 {delay}\236\180\136\234\176\128 \236\167\128\235\130\152\235\169\180 \236\180\136\235\139\185 {regen}\236\148\169 \237\154\140\235\179\181\235\143\188\236\154\148. \235\169\136\236\182\152 \234\176\128\235\147\156(\234\178\140\236\158\132\237\140\168\235\147\156 L2)\235\169\180 \235\141\148 \235\185\168\235\166\172, \237\148\188\234\176\128 \236\160\129\236\156\188\235\169\180 \235\141\148 \235\138\144\235\166\172\234\178\140 \237\154\140\235\179\181\235\143\188\236\154\148.\n\n\236\158\144\236\132\184\234\176\128 \236\160\136\235\176\152 \236\149\132\235\158\152\235\161\156 \235\150\168\236\150\180\236\167\128\235\169\180 \236\185\188 \236\134\141\235\143\132\236\153\128 \236\157\180\235\143\153 \236\134\141\235\143\132\234\176\128 \235\138\144\235\160\164\236\167\128\234\179\160, \236\185\188\236\157\180 \235\141\148 \236\137\189\234\178\140 \237\138\149\234\178\168 \235\130\152\234\176\128\236\154\148.",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> ({Wipe}). See the next scroll."] = "\236\158\144\236\132\184\234\176\128 0\236\157\180 \235\144\152\235\169\180 <b>\235\172\180\235\132\136\236\160\184\236\154\148</b>: {stagger}\236\180\136 \235\143\153\236\149\136 \234\178\189\236\167\129, \234\183\184 \235\146\164 {weakened}\236\180\136 \235\143\153\236\149\136 \236\149\189\237\153\148 ({slower} \235\138\144\235\160\164\236\167\128\234\179\160, \236\136\168\236\157\180 \236\176\168\234\179\160, \237\153\148\235\169\180 \234\176\128\236\158\165\236\158\144\235\166\172\234\176\128 \236\150\180\235\145\144\236\155\140\236\160\184\236\154\148). \234\183\184\235\139\164\236\157\140 \236\158\144\236\132\184\234\176\128 \236\160\136\235\176\152\234\185\140\236\167\128 \237\154\140\235\179\181\235\143\188\236\154\148.\n\n\236\158\144\236\132\184\235\165\188 \234\176\128\236\158\165 \235\185\168\235\166\172 \234\176\128\235\147\157 \236\177\132\236\154\176\235\138\148 \235\176\169\235\178\149\236\157\128 <b>\236\185\188\235\130\160 \235\139\166\234\184\176</b>({Wipe})\236\152\136\236\154\148. \235\139\164\236\157\140 \235\145\144\235\163\168\235\167\136\235\166\172\235\165\188 \235\179\180\236\132\184\236\154\148.",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> (WIPE). See the next scroll."] = "\236\158\144\236\132\184\234\176\128 0\236\157\180 \235\144\152\235\169\180 <b>\235\172\180\235\132\136\236\160\184\236\154\148</b>: {stagger}\236\180\136 \235\143\153\236\149\136 \234\178\189\236\167\129, \234\183\184 \235\146\164 {weakened}\236\180\136 \235\143\153\236\149\136 \236\149\189\237\153\148 ({slower} \235\138\144\235\160\164\236\167\128\234\179\160, \236\136\168\236\157\180 \236\176\168\234\179\160, \237\153\148\235\169\180 \234\176\128\236\158\165\236\158\144\235\166\172\234\176\128 \236\150\180\235\145\144\236\155\140\236\160\184\236\154\148). \234\183\184\235\139\164\236\157\140 \236\158\144\236\132\184\234\176\128 \236\160\136\235\176\152\234\185\140\236\167\128 \237\154\140\235\179\181\235\143\188\236\154\148.\n\n\236\158\144\236\132\184\235\165\188 \234\176\128\236\158\165 \235\185\168\235\166\172 \234\176\128\235\147\157 \236\177\132\236\154\176\235\138\148 \235\176\169\235\178\149\236\157\128 <b>\236\185\188\235\130\160 \235\139\166\234\184\176</b>([\235\139\166\234\184\176])\236\152\136\236\154\148. \235\139\164\236\157\140 \235\145\144\235\163\168\235\167\136\235\166\172\235\165\188 \235\179\180\236\132\184\236\154\148.",
		["Wiping the blade"] = "\236\185\188\235\130\160 \235\139\166\234\184\176",
		["Cuts leave blood on the blade. With the blade drawn, press <b>{Wipe}</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "\235\178\160\235\169\180 \236\185\188\235\130\160\236\151\144 \237\148\188\234\176\128 \235\172\187\236\150\180\236\154\148. \236\185\188\236\157\132 \235\189\145\236\157\128 \236\131\129\237\131\156\236\151\144\236\132\156 <b>{Wipe}</b> \237\130\164\235\165\188 \235\136\132\235\165\180\235\169\180 \236\178\156\236\156\188\235\161\156 \237\149\156 \235\169\180\236\148\169 \236\150\145\235\169\180\236\157\132 \235\139\166\236\149\132\236\154\148. \235\139\166\234\184\176\235\138\148 \236\149\189 {time}\236\180\136 \234\177\184\235\160\164\236\154\148.",
		["<b>Wiping restores poise.</b> During a wipe, poise refills at {times}x speed, and a finished wipe fills it to full.\n\nAfter a poise break, a finished wipe also ends the weakened state."] = "<b>\236\185\188\235\130\160\236\157\132 \235\139\166\236\156\188\235\169\180 \236\158\144\236\132\184\234\176\128 \237\154\140\235\179\181\235\143\188\236\154\148.</b> \235\139\166\235\138\148 \235\143\153\236\149\136 \236\158\144\236\132\184\234\176\128 {times}\235\176\176 \236\134\141\235\143\132\235\161\156 \237\154\140\235\179\181\235\144\152\234\179\160, \235\139\164 \235\139\166\236\156\188\235\169\180 \234\176\128\235\147\157 \236\176\168\236\154\148.\n\n\236\158\144\236\132\184\234\176\128 \235\172\180\235\132\136\236\167\132 \235\146\164\236\151\144\235\143\132 \235\139\166\234\184\176\235\165\188 \235\129\157\235\130\180\235\169\180 \236\149\189\237\153\148 \236\131\129\237\131\156\234\176\128 \237\146\128\235\160\164\236\154\148.",
		["<b>Wiping leaves an opening.</b> Once a wipe starts, steering, guarding and cutting are locked until it ends, and a swing into the loose blade knocks it far aside. Losing poise mid-wipe cancels the full refill.\n\nBots punish wipes. Make some distance first.\n\nA later forge rank unlocks a quicker wipe."] = "<b>\235\139\166\234\184\176\235\138\148 \235\185\136\237\139\136\236\157\132 \235\167\140\235\147\164\236\150\180\236\154\148.</b> \235\139\166\234\184\176\235\165\188 \236\139\156\236\158\145\237\149\152\235\169\180 \235\129\157\235\130\160 \235\149\140\234\185\140\236\167\128 \236\185\188 \236\161\176\236\162\133, \234\176\128\235\147\156, \235\178\160\234\184\176\235\165\188 \237\149\160 \236\136\152 \236\151\134\234\179\160, \235\138\144\236\138\168\237\149\156 \236\185\188\236\151\144 \234\179\181\234\178\169\236\157\132 \235\167\158\236\156\188\235\169\180 \235\169\128\235\166\172 \237\138\149\234\178\168 \235\130\152\234\176\128\236\154\148. \235\139\166\235\138\148 \235\143\132\236\164\145 \236\158\144\236\132\184\235\165\188 \236\158\131\236\156\188\235\169\180 \236\153\132\236\160\132 \237\154\140\235\179\181\236\157\180 \236\183\168\236\134\140\235\143\188\236\154\148.\n\n\235\180\135\236\157\128 \235\139\166\235\138\148 \237\139\136\236\157\132 \235\133\184\235\160\164\236\154\148. \235\168\188\236\160\128 \234\177\176\235\166\172\235\165\188 \235\178\140\235\166\172\236\132\184\236\154\148.\n\n\236\157\180\237\155\132 \235\139\168\236\161\176 \235\147\177\234\184\137\236\151\144\236\132\156 \235\141\148 \235\185\160\235\165\184 \235\139\166\234\184\176\234\176\128 \237\149\180\234\184\136\235\143\188\236\154\148.",
		["Cuts leave blood on the blade. With the blade drawn, tap <b>WIPE</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "\235\178\160\235\169\180 \236\185\188\235\130\160\236\151\144 \237\148\188\234\176\128 \235\172\187\236\150\180\236\154\148. \236\185\188\236\157\132 \235\189\145\236\157\128 \236\131\129\237\131\156\236\151\144\236\132\156 <b>\235\139\166\234\184\176</b>\235\165\188 \237\131\173\237\149\152\235\169\180 \236\178\156\236\156\188\235\161\156 \237\149\156 \235\169\180\236\148\169 \236\150\145\235\169\180\236\157\132 \235\139\166\236\149\132\236\154\148. \235\139\166\234\184\176\235\138\148 \236\149\189 {time}\236\180\136 \234\177\184\235\160\164\236\154\148.",
		["Drawing the sword"] = "\235\176\156\235\143\132",
		["The sword starts sheathed, with a hand on the sheath, ready to draw.\n\n<b>{Lock}</b>: toggle lock-on. While locked on, the mouse picks the cut; its name shows at the bottom of the screen.\n<b>{NextTarget}</b>: switch target.\n<b>{Unequip}</b>: unequip the sword. <b>{Equip}</b>: equip it again."] = "\236\185\188\236\157\128 \236\185\188\236\167\145\236\151\144 \235\147\160 \236\177\132\235\161\156 \236\139\156\236\158\145\237\149\152\234\179\160, \236\134\144\236\157\128 \236\185\188\236\167\145\236\151\144 \236\150\185\237\152\128 \236\158\136\236\150\180 \236\150\184\236\160\156\235\147\160 \235\176\156\235\143\132\237\149\160 \236\136\152 \236\158\136\236\150\180\236\154\148.\n\n<b>{Lock}</b>: \235\157\189\236\152\168 \236\188\156\234\184\176/\235\129\132\234\184\176. \235\157\189\236\152\168 \236\164\145\236\151\144\235\138\148 \235\167\136\236\154\176\236\138\164\235\161\156 \235\178\160\234\184\176\235\165\188 \234\179\160\235\165\180\234\179\160, \234\183\184 \236\157\180\235\166\132\236\157\180 \237\153\148\235\169\180 \236\149\132\235\158\152\236\151\144 \237\145\156\236\139\156\235\143\188\236\154\148.\n<b>{NextTarget}</b>: \235\140\128\236\131\129 \235\176\148\234\190\184\234\184\176.\n<b>{Unequip}</b>: \236\185\188 \236\158\165\236\176\169 \237\149\180\236\160\156. <b>{Equip}</b>: \235\139\164\236\139\156 \236\158\165\236\176\169.",
		["Move the mouse to pick the cut, then hold {Draw} and swipe:\n\n<b>Down-left</b>, swipe up-right: low cut.\n<b>Left</b>, swipe right: horizontal slice.\n<b>Up-left</b>, swipe down-right: diagonal cut.\n<b>Up</b>, swipe down: vertical slice.\n\nA faster swipe makes a faster cut.\n\n<b>{CalmDraw}</b>: calm draw. The blade slides out slowly into a guard, with no cut."] = "\235\167\136\236\154\176\236\138\164\235\165\188 \236\155\128\236\167\129\236\151\172 \235\178\160\234\184\176\235\165\188 \234\179\160\235\165\184 \235\146\164, {Draw} \235\136\132\235\165\184 \236\177\132 \236\138\164\236\153\128\236\157\180\237\148\132\237\149\152\236\132\184\236\154\148:\n\n<b>\236\153\188\236\170\189 \236\149\132\235\158\152</b>, \236\152\164\235\165\184\236\170\189 \236\156\132\235\161\156 \236\138\164\236\153\128\236\157\180\237\148\132: \237\149\152\235\139\168 \235\178\160\234\184\176.\n<b>\236\153\188\236\170\189</b>, \236\152\164\235\165\184\236\170\189\236\156\188\235\161\156 \236\138\164\236\153\128\236\157\180\237\148\132: \234\176\128\235\161\156 \235\178\160\234\184\176.\n<b>\236\153\188\236\170\189 \236\156\132</b>, \236\152\164\235\165\184\236\170\189 \236\149\132\235\158\152\235\161\156 \236\138\164\236\153\128\236\157\180\237\148\132: \236\130\172\236\132\160 \235\178\160\234\184\176.\n<b>\236\156\132</b>, \236\149\132\235\158\152\235\161\156 \236\138\164\236\153\128\236\157\180\237\148\132: \236\132\184\235\161\156 \235\178\160\234\184\176.\n\n\235\185\160\235\165\180\234\178\140 \236\138\164\236\153\128\236\157\180\237\148\132\237\149\160\236\136\152\235\161\157 \235\178\160\234\184\176\235\143\132 \235\185\168\235\157\188\236\154\148.\n\n<b>{CalmDraw}</b>: \236\176\168\235\182\132\237\149\156 \235\176\156\235\143\132. \235\178\160\236\167\128 \236\149\138\234\179\160 \236\185\188\236\157\180 \236\178\156\236\178\156\237\158\136 \235\130\152\236\153\128 \234\176\128\235\147\156 \236\158\144\236\132\184\234\176\128 \235\143\188\236\154\148.",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>{Equip}</b>: put the blade away. The next draw is ready about a second later."] = "\235\176\156\235\143\132 \235\178\160\234\184\176\235\138\148 \236\185\188\236\157\132 \235\139\168\235\139\168\237\158\136 \236\165\148 \236\177\132 \235\130\152\234\176\128\236\154\148. \235\176\156\235\143\132 \235\178\160\234\184\176\236\151\144 \235\182\128\235\148\170\237\158\140 \236\185\188\236\157\128 \237\138\149\234\178\168 \235\130\152\234\176\128\234\179\160 \236\158\144\236\132\184\235\165\188 {block} \236\158\131\236\150\180\236\154\148. \235\176\156\235\143\132 \235\178\160\234\184\176\235\138\148 \237\149\156 \235\178\136\236\151\144 \236\158\144\236\132\184\235\165\188 {draw} \236\134\140\235\170\168\237\149\180\236\154\148.\n\n<b>{Equip}</b>: \236\185\188\236\157\132 \236\185\188\236\167\145\236\151\144 \235\132\163\234\184\176. \236\149\189 1\236\180\136 \235\146\164 \235\139\164\236\157\140 \235\176\156\235\143\132\235\165\188 \237\149\160 \236\136\152 \236\158\136\236\150\180\236\154\148.",
		["The sword starts sheathed, with a hand on the sheath, ready to draw. While locked on, a slow drag on the right side of the screen moves the hand on the sheath, and a quick <b>flick</b> draws. The flick\'s direction picks the cut.\n\n<b>LOCKED ON</b>: tap to switch target, hold to turn lock-on off. <b>LOCK ON</b>: tap to turn it back on.\n<b>UNEQUIP</b>: hold to unequip the sword. <b>EQUIP</b>: tap to equip it again."] = "\236\185\188\236\157\128 \236\185\188\236\167\145\236\151\144 \235\147\160 \236\177\132\235\161\156 \236\139\156\236\158\145\237\149\152\234\179\160, \236\134\144\236\157\128 \236\185\188\236\167\145\236\151\144 \236\150\185\237\152\128 \236\158\136\236\150\180 \236\150\184\236\160\156\235\147\160 \235\176\156\235\143\132\237\149\160 \236\136\152 \236\158\136\236\150\180\236\154\148. \235\157\189\236\152\168 \236\164\145\236\151\144\235\138\148 \237\153\148\235\169\180 \236\152\164\235\165\184\236\170\189\236\157\132 \236\178\156\236\178\156\237\158\136 \235\147\156\235\158\152\234\183\184\237\149\152\235\169\180 \236\185\188\236\167\145 \236\156\132\236\157\152 \236\134\144\236\157\180 \236\155\128\236\167\129\236\157\180\234\179\160, \235\185\160\235\165\180\234\178\140 <b>\237\148\140\235\166\173</b>\237\149\152\235\169\180 \235\176\156\235\143\132\237\149\180\236\154\148. \237\148\140\235\166\173 \235\176\169\237\150\165\236\156\188\235\161\156 \235\178\160\234\184\176\234\176\128 \236\160\149\237\149\180\236\160\184\236\154\148.\n\n<b>\235\157\189\236\152\168 \236\164\145</b>: \237\131\173\237\149\180\236\132\156 \235\140\128\236\131\129 \235\176\148\234\190\184\234\184\176, \234\184\184\234\178\140 \235\136\140\235\159\172 \235\157\189\236\152\168 \235\129\132\234\184\176. <b>\235\157\189\236\152\168</b>: \237\131\173\237\149\180\236\132\156 \235\139\164\236\139\156 \236\188\156\234\184\176.\n<b>\236\158\165\236\176\169 \237\149\180\236\160\156</b>: \234\184\184\234\178\140 \235\136\140\235\159\172 \236\185\188 \236\158\165\236\176\169 \237\149\180\236\160\156. <b>\236\158\165\236\176\169</b>: \237\131\173\237\149\180\236\132\156 \235\139\164\236\139\156 \236\158\165\236\176\169.",
		["<b>Flick right</b>: horizontal slice.\n<b>Flick down</b>: vertical slice.\n<b>Flick up-right</b>: low cut.\n\n<b>CALM DRAW</b>: the blade slides out slowly into a guard, with no cut."] = "<b>\236\152\164\235\165\184\236\170\189\236\156\188\235\161\156 \237\148\140\235\166\173</b>: \234\176\128\235\161\156 \235\178\160\234\184\176.\n<b>\236\149\132\235\158\152\235\161\156 \237\148\140\235\166\173</b>: \236\132\184\235\161\156 \235\178\160\234\184\176.\n<b>\236\152\164\235\165\184\236\170\189 \236\156\132\235\161\156 \237\148\140\235\166\173</b>: \237\149\152\235\139\168 \235\178\160\234\184\176.\n\n<b>\236\176\168\235\182\132\237\149\156 \235\176\156\235\143\132</b>: \235\178\160\236\167\128 \236\149\138\234\179\160 \236\185\188\236\157\180 \236\178\156\236\178\156\237\158\136 \235\130\152\236\153\128 \234\176\128\235\147\156 \236\158\144\236\132\184\234\176\128 \235\143\188\236\154\148.",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>SHEATHE</b>: put the blade away. The next draw is ready about a second later."] = "\235\176\156\235\143\132 \235\178\160\234\184\176\235\138\148 \236\185\188\236\157\132 \235\139\168\235\139\168\237\158\136 \236\165\148 \236\177\132 \235\130\152\234\176\128\236\154\148. \235\176\156\235\143\132 \235\178\160\234\184\176\236\151\144 \235\182\128\235\148\170\237\158\140 \236\185\188\236\157\128 \237\138\149\234\178\168 \235\130\152\234\176\128\234\179\160 \236\158\144\236\132\184\235\165\188 {block} \236\158\131\236\150\180\236\154\148. \235\176\156\235\143\132 \235\178\160\234\184\176\235\138\148 \237\149\156 \235\178\136\236\151\144 \236\158\144\236\132\184\235\165\188 {draw} \236\134\140\235\170\168\237\149\180\236\154\148.\n\n<b>\235\130\169\235\143\132</b>: \236\185\188\236\157\132 \236\185\188\236\167\145\236\151\144 \235\132\163\234\184\176. \236\149\189 1\236\180\136 \235\146\164 \235\139\164\236\157\140 \235\176\156\235\143\132\235\165\188 \237\149\160 \236\136\152 \236\158\136\236\150\180\236\154\148.",
		["Clashes and parries"] = "\236\182\169\235\143\140\234\179\188 \237\140\168\235\167\129",
		["Blades that meet push each other apart, and the firmer blade moves less. A hard swing knocks a still blade far aside, and that blade is slow to recover: an opening to attack.\n\nHit near the hands, a blade barely moves. Hit near the tip, it\'s knocked aside easily."] = "\235\182\128\235\148\170\237\158\140 \236\185\188\236\157\128 \236\132\156\235\161\156\235\165\188 \235\176\128\236\150\180\235\130\180\234\179\160, \235\141\148 \235\139\168\235\139\168\237\158\136 \236\165\148 \236\185\188\236\157\180 \235\141\156 \235\176\128\235\160\164\236\154\148. \234\176\149\237\149\156 \237\156\152\235\145\144\235\165\180\234\184\176\235\138\148 \235\169\136\236\182\176 \236\158\136\235\138\148 \236\185\188\236\157\132 \235\169\128\235\166\172 \236\179\144\235\130\180\234\179\160, \234\183\184 \236\185\188\236\157\128 \235\138\166\234\178\140 \235\143\140\236\149\132\236\153\128\236\154\148: \234\179\181\234\178\169\237\149\160 \237\139\136\236\157\180\236\151\144\236\154\148.\n\n\236\134\144 \234\176\128\234\185\140\236\157\180\236\151\144 \235\167\158\236\156\188\235\169\180 \236\185\188\236\157\180 \234\177\176\236\157\152 \236\155\128\236\167\129\236\157\180\236\167\128 \236\149\138\236\149\132\236\154\148. \236\185\188\235\129\157 \234\176\128\234\185\140\236\157\180\236\151\144 \235\167\158\236\156\188\235\169\180 \236\137\189\234\178\140 \237\138\149\234\178\168 \235\130\152\234\176\128\236\154\148.",
		["<b>Draw-cuts</b> hit hardest. A blade held still that meets a draw-cut, or the drawer while the blade comes out, is knocked aside, and the cut goes through.\n\n<b>A still guard</b> (L2 on a gamepad) parries other swings: the swing bounces off and the attacker is staggered.\n\n<b>Two swings meeting</b> both give way, and neither can cut for a moment.\n\nThe whole sword can clash, handle included."] = "<b>\235\176\156\235\143\132 \235\178\160\234\184\176</b>\234\176\128 \234\176\128\236\158\165 \234\176\149\237\149\152\234\178\140 \235\182\128\235\148\170\237\152\128\236\154\148. \235\169\136\236\182\176 \236\158\136\235\138\148 \236\185\188\236\157\180 \235\176\156\235\143\132 \235\178\160\234\184\176\236\151\144 \235\167\158\234\177\176\235\130\152, \236\185\188\236\157\132 \235\189\145\235\138\148 \236\164\145\236\157\184 \236\131\129\235\140\128\236\151\144\234\178\140 \235\139\191\236\156\188\235\169\180 \236\152\134\236\156\188\235\161\156 \237\138\149\234\178\168 \235\130\152\234\176\128\234\179\160, \235\178\160\234\184\176\235\138\148 \234\183\184\235\140\128\235\161\156 \236\167\128\235\130\152\234\176\128\236\154\148.\n\n<b>\235\169\136\236\182\152 \234\176\128\235\147\156</b>(\234\178\140\236\158\132\237\140\168\235\147\156 L2)\235\138\148 \235\139\164\235\165\184 \237\156\152\235\145\144\235\165\180\234\184\176\235\165\188 \237\140\168\235\167\129\237\149\180\236\154\148: \237\156\152\235\145\144\235\165\184 \236\185\188\236\157\180 \237\138\149\234\178\168 \235\130\152\234\176\128\234\179\160 \234\179\181\234\178\169\237\149\156 \236\170\189\236\157\180 \234\178\189\236\167\129\235\143\188\236\154\148.\n\n<b>\237\156\152\235\145\144\235\165\184 \236\185\188\235\129\188\235\166\172 \235\182\128\235\148\170\237\158\136\235\169\180</b> \235\145\152 \235\139\164 \235\176\128\235\160\164\235\130\152\234\179\160, \236\158\160\236\139\156 \235\145\152 \235\139\164 \235\178\168 \236\136\152 \236\151\134\236\150\180\236\154\148.\n\n\236\134\144\236\158\161\236\157\180\235\165\188 \237\143\172\237\149\168\237\149\180 \236\185\188 \236\160\132\236\178\180\234\176\128 \235\182\128\235\148\170\237\158\144 \236\136\152 \236\158\136\236\150\180\236\154\148.",
		["Cuts, wounds and bleeding"] = "\235\178\160\234\184\176, \236\131\129\236\178\152, \236\182\156\237\152\136",
		["A cut needs speed and a leading edge. Speed comes from the swing and from movement, so dashing past counts. A sudden change of direction hits with the flat.\n\nOnly a blade moving into a target counts. A blade left resting in a body sticks."] = "\235\178\160\235\160\164\235\169\180 \236\134\141\235\143\132\236\153\128 \236\149\158\236\132\156 \235\130\152\234\176\128\235\138\148 \235\130\160\236\157\180 \237\149\132\236\154\148\237\149\180\236\154\148. \236\134\141\235\143\132\235\138\148 \237\156\152\235\145\144\235\165\180\234\184\176\236\153\128 \236\157\180\235\143\153\236\151\144\236\132\156 \235\130\152\236\152\164\235\175\128\235\161\156, \235\140\128\236\139\156\235\161\156 \236\167\128\235\130\152\234\176\128\235\138\148 \234\178\131\235\143\132 \236\157\184\236\160\149\235\143\188\236\154\148. \234\176\145\236\158\144\234\184\176 \235\176\169\237\150\165\236\157\132 \235\176\148\234\190\184\235\169\180 \236\185\188 \236\152\134\235\169\180\236\156\188\235\161\156 \235\167\158\236\149\132\236\154\148.\n\n\235\140\128\236\131\129\236\157\132 \237\150\165\237\149\180 \236\155\128\236\167\129\236\157\180\235\138\148 \236\185\188\235\167\140 \236\157\184\236\160\149\235\143\188\236\154\148. \235\170\184\236\151\144 \235\140\128\234\179\160\235\167\140 \236\158\136\235\138\148 \236\185\188\236\157\128 \235\176\149\237\152\128\236\132\156 \235\169\136\236\182\176\236\154\148.",
		["A fast, edge-first cut all the way through a limb <b>severs</b> it. Through the head or torso: <b>a kill</b>.\n\nAnything less is a <b>wound</b>: it bleeds and slows the limb. Deeper wounds are worse.\n\n<b>Stabs</b> never kill outright. A stab to the head, or a fast one to the body (dash or lunge in), takes a lot of blood at once. Other stabs wound."] = "\235\130\160\235\182\128\237\132\176 \235\147\164\236\150\180\234\176\128\235\138\148 \235\185\160\235\165\184 \235\178\160\234\184\176\235\161\156 \237\140\148\235\139\164\235\166\172\235\165\188 \236\153\132\236\160\132\237\158\136 \235\178\160\236\150\180 \236\167\128\235\130\152\234\176\128\235\169\180 <b>\236\158\152\235\160\164 \235\130\152\234\176\128\236\154\148</b>. \235\168\184\235\166\172\235\130\152 \235\170\184\237\134\181\236\157\180\235\169\180 <b>\236\178\152\236\185\152</b>\236\152\136\236\154\148.\n\n\234\183\184\235\179\180\235\139\164 \236\150\149\236\156\188\235\169\180 <b>\236\131\129\236\178\152</b>\236\152\136\236\154\148: \237\148\188\234\176\128 \235\130\152\234\179\160 \234\183\184 \237\140\148\235\139\164\235\166\172\234\176\128 \235\138\144\235\160\164\236\160\184\236\154\148. \236\131\129\236\178\152\234\176\128 \234\185\138\236\157\132\236\136\152\235\161\157 \236\139\172\237\149\180\236\154\148.\n\n<b>\236\176\140\235\165\180\234\184\176</b>\235\161\156\235\138\148 \237\149\156 \235\178\136\236\151\144 \236\178\152\236\185\152\235\144\152\236\167\128 \236\149\138\236\149\132\236\154\148. \235\168\184\235\166\172\235\165\188 \236\176\140\235\165\180\234\177\176\235\130\152 \235\170\184\236\157\132 \235\185\160\235\165\180\234\178\140 \236\176\140\235\165\180\235\169\180(\235\140\128\236\139\156\235\130\152 \235\143\140\236\167\132) \237\149\156 \235\178\136\236\151\144 \237\148\188\235\165\188 \235\167\142\236\157\180 \236\158\131\236\150\180\236\154\148. \235\139\164\235\165\184 \236\176\140\235\165\180\234\184\176\235\138\148 \236\131\129\236\178\152\234\176\128 \235\130\152\236\154\148.",
		["Every fighter has {squares} squares of blood. Wounds bleed for a few seconds, and so does a lost limb. With two limbs lost, the stumps bleed out. Losing both arms drops the katana.\n\nCombat is allowed in the arena and the forest, except in safe zones. Inside one, the screen shows <b>{safe}</b>."] = "\235\170\168\235\147\160 \234\178\128\234\176\157\236\157\152 \237\148\188\235\138\148 {squares}\236\185\184\236\157\180\236\151\144\236\154\148. \236\131\129\236\178\152\235\138\148 \235\170\135 \236\180\136 \235\143\153\236\149\136 \237\148\188\234\176\128 \235\130\152\234\179\160, \236\158\131\236\157\128 \237\140\148\235\139\164\235\166\172\235\143\132 \235\167\136\236\176\172\234\176\128\236\167\128\236\152\136\236\154\148. \237\140\148\235\139\164\235\166\172\235\165\188 \235\145\152 \236\158\131\236\156\188\235\169\180 \236\158\152\235\166\176 \235\182\128\236\156\132\236\151\144\236\132\156 \236\163\189\236\157\132 \235\149\140\234\185\140\236\167\128 \237\148\188\234\176\128 \235\130\152\236\154\148. \235\145\144 \237\140\148\236\157\132 \235\170\168\235\145\144 \236\158\131\236\156\188\235\169\180 \236\185\180\237\131\128\235\130\152\235\165\188 \235\150\168\236\150\180\235\156\168\235\160\164\236\154\148.\n\n\236\149\136\236\160\132 \236\167\128\235\140\128\235\165\188 \236\160\156\236\153\184\237\149\156 \234\178\189\234\184\176\236\158\165\234\179\188 \236\136\178\236\151\144\236\132\156 \236\160\132\237\136\172\237\149\160 \236\136\152 \236\158\136\236\150\180\236\154\148. \236\149\136\236\160\132 \236\167\128\235\140\128 \236\149\136\236\151\144\236\132\156\235\138\148 \237\153\148\235\169\180\236\151\144 <b>{safe}</b> \237\145\156\236\139\156\234\176\128 \235\130\152\236\153\128\236\154\148.",
		["The forge and levels"] = "\235\140\128\236\158\165\234\176\132\234\179\188 \235\160\136\235\178\168",
		["XP rewards:\n\n<b>Wounding a player</b>: {wound}.\n<b>Severing a limb</b>: {sever}.\n<b>A kill</b>: {kill}.\n<b>Defeating a bot</b>: {botLeast} to {botMost}, more for rarer names.\n\nEach level needs a little more XP than the last. No level cap."] = "XP \235\179\180\236\131\129:\n\n<b>\237\148\140\235\160\136\236\157\180\236\150\180\236\151\144\234\178\140 \236\131\129\236\178\152 \236\158\133\237\158\136\234\184\176</b>: {wound}.\n<b>\237\140\148\235\139\164\235\166\172 \236\160\136\235\139\168</b>: {sever}.\n<b>\236\178\152\236\185\152</b>: {kill}.\n<b>\235\180\135 \236\178\152\236\185\152</b>: {botLeast}~{botMost}, \236\157\180\235\166\132\236\157\180 \237\157\172\234\183\128\237\149\160\236\136\152\235\161\157 \235\167\142\236\157\180.\n\n\235\160\136\235\178\168\235\167\136\235\139\164 \236\157\180\236\160\132 \235\160\136\235\178\168\235\179\180\235\139\164 \236\161\176\234\184\136 \235\141\148 \235\167\142\236\157\128 XP\234\176\128 \237\149\132\236\154\148\237\149\180\236\154\148. \236\181\156\235\140\128 \235\160\136\235\178\168 \236\151\134\236\157\140.",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, press E at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "{levels}\235\160\136\235\178\168\235\167\136\235\139\164 \236\131\136 <b>\235\139\168\236\161\176 \235\147\177\234\184\137</b>\236\157\180 \237\149\180\234\184\136\235\143\188\236\154\148. \234\178\189\234\184\176\236\158\165 \235\130\168\236\170\189 \235\140\128\236\158\165\234\176\132\236\157\152 \235\170\168\235\163\168 \236\149\158\236\151\144\236\132\156 E \237\130\164\235\165\188 \235\136\140\235\159\172 \236\185\188\236\157\132 \235\139\172\234\181\172\234\179\160, \235\145\144\235\147\156\235\166\172\234\179\160, \235\139\180\234\184\136\236\167\136\237\149\152\236\132\184\236\154\148. \235\147\177\234\184\137\235\167\136\235\139\164 \236\185\188\236\157\152 \235\170\168\236\138\181\236\157\180 \235\176\148\235\128\140\234\179\160 \236\131\136\235\161\156\236\154\180 \234\176\149\237\153\148\234\176\128 \236\131\157\234\178\168\236\154\148.\n\n\236\157\180\234\179\179 \236\185\188 \235\178\189\236\151\144\235\138\148 \235\170\168\235\147\160 \235\139\168\236\161\176 \235\147\177\234\184\137\236\157\152 \236\185\188\236\157\180 \234\177\184\235\160\164 \236\158\136\236\150\180\236\154\148.\n\n<b>\236\158\172\235\139\168\236\161\176</b>\235\161\156 \236\157\180\235\175\184 \235\139\168\236\161\176\237\149\156 \236\150\180\235\138\144 \235\147\177\234\184\137\236\156\188\235\161\156\235\147\160 \235\144\152\235\143\140\235\166\180 \236\136\152 \236\158\136\236\150\180\236\154\148.",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, tap <b>Forge your blade</b> at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "{levels}\235\160\136\235\178\168\235\167\136\235\139\164 \236\131\136 <b>\235\139\168\236\161\176 \235\147\177\234\184\137</b>\236\157\180 \237\149\180\234\184\136\235\143\188\236\154\148. \234\178\189\234\184\176\236\158\165 \235\130\168\236\170\189 \235\140\128\236\158\165\234\176\132\236\157\152 \235\170\168\235\163\168\236\151\144\236\132\156 <b>\236\185\188 \235\139\168\236\161\176\237\149\152\234\184\176</b>\235\165\188 \237\131\173\237\149\180 \236\185\188\236\157\132 \235\139\172\234\181\172\234\179\160, \235\145\144\235\147\156\235\166\172\234\179\160, \235\139\180\234\184\136\236\167\136\237\149\152\236\132\184\236\154\148. \235\147\177\234\184\137\235\167\136\235\139\164 \236\185\188\236\157\152 \235\170\168\236\138\181\236\157\180 \235\176\148\235\128\140\234\179\160 \236\131\136\235\161\156\236\154\180 \234\176\149\237\153\148\234\176\128 \236\131\157\234\178\168\236\154\148.\n\n\236\157\180\234\179\179 \236\185\188 \235\178\189\236\151\144\235\138\148 \235\170\168\235\147\160 \235\139\168\236\161\176 \235\147\177\234\184\137\236\157\152 \236\185\188\236\157\180 \234\177\184\235\160\164 \236\158\136\236\150\180\236\154\148.\n\n<b>\236\158\172\235\139\168\236\161\176</b>\235\161\156 \236\157\180\235\175\184 \235\139\168\236\161\176\237\149\156 \236\150\180\235\138\144 \235\147\177\234\184\137\236\156\188\235\161\156\235\147\160 \235\144\152\235\143\140\235\166\180 \236\136\152 \236\158\136\236\150\180\236\154\148.",
		["Kill streaks"] = "\236\151\176\236\134\141 \236\178\152\236\185\152",
		["A <b>kill streak</b> counts kills in a row without dying, shown at the top right. Bleed-outs from a cut count, and so do bot kills. Dying ends the streak, but the best one is saved."] = "<b>\236\151\176\236\134\141 \236\178\152\236\185\152</b>\235\138\148 \236\163\189\236\167\128 \236\149\138\234\179\160 \236\151\176\235\139\172\236\149\132 \236\178\152\236\185\152\237\149\156 \236\136\152\235\161\156, \236\152\164\235\165\184\236\170\189 \236\156\132\236\151\144 \237\145\156\236\139\156\235\143\188\236\154\148. \235\178\160\234\184\176\235\161\156 \236\157\184\237\149\156 \236\182\156\237\152\136\236\130\172\236\153\128 \235\180\135 \236\178\152\236\185\152\235\143\132 \237\143\172\237\149\168\235\143\188\236\154\148. \236\163\189\236\156\188\235\169\180 \236\151\176\236\134\141 \236\178\152\236\185\152\234\176\128 \235\129\157\235\130\152\236\167\128\235\167\140, \236\181\156\234\179\160 \234\184\176\235\161\157\236\157\128 \236\160\128\236\158\165\235\143\188\236\154\148.",
		["The streak catches fire as it grows, and every ten kills earns a title. Every {every} kills up to {most}: +{share} walk speed and poise recovery (Mythic names +{mythic}, Exotic names +{exotic}).\n\nNo prizes: it\'s for the glory.\n\nAfter dying, <b>SPECTATE</b> watches other fighters and <b>RESPAWN</b> returns to the fight."] = "\236\151\176\236\134\141 \236\178\152\236\185\152\235\138\148 \235\138\152\236\150\180\235\130\160\236\136\152\235\161\157 \235\182\136\237\131\128\236\152\164\235\165\180\234\179\160, 10\236\151\176\236\134\141 \236\178\152\236\185\152\235\167\136\235\139\164 \236\185\173\237\152\184\235\165\188 \236\150\187\236\150\180\236\154\148. {most}\236\151\176\236\134\141 \236\178\152\236\185\152\234\185\140\236\167\128 {every}\236\151\176\236\134\141 \236\178\152\236\185\152\235\167\136\235\139\164 \236\157\180\235\143\153 \236\134\141\235\143\132\236\153\128 \236\158\144\236\132\184 \237\154\140\235\179\181\236\157\180 +{share}\236\148\169 \236\152\172\235\157\188\236\154\148(\236\139\160\237\153\148 \236\132\177\236\148\168\235\138\148 +{mythic}, \236\180\136\236\155\148 \236\132\177\236\148\168\235\138\148 +{exotic}).\n\n\236\131\129\237\146\136\236\157\128 \236\151\134\236\150\180\236\154\148: \236\152\164\236\167\129 \236\152\129\234\180\145\236\157\132 \236\156\132\237\149\180\236\132\156\236\152\136\236\154\148.\n\n\236\163\189\236\157\128 \235\146\164\236\151\144\235\138\148 <b>\234\180\128\236\160\132</b>\236\156\188\235\161\156 \235\139\164\235\165\184 \234\178\128\234\176\157\235\147\164\236\157\132 \236\167\128\236\188\156\235\179\180\234\179\160, <b>\235\182\128\237\153\156</b>\235\161\156 \236\160\132\237\136\172\236\151\144 \235\143\140\236\149\132\236\153\128\236\154\148.",
		["TO WHOEVER FREED THIS TEMPLE"] = "\236\157\180 \236\130\172\236\155\144\236\157\132 \237\149\180\235\176\169\237\149\156 \236\158\144\236\151\144\234\178\140",
		["Her blade still rests within these walls. Search every corner."] = "\234\183\184\235\133\128\236\157\152 \234\178\128\236\157\128 \236\149\132\236\167\129 \236\157\180 \235\139\180\236\158\165 \236\149\136\236\151\144 \236\158\160\235\147\164\236\150\180 \236\158\136\235\139\164. \234\181\172\236\132\157\234\181\172\236\132\157 \236\176\190\236\149\132\235\179\180\235\157\188.",
		["YOU  {mine}  :  {theirs}  {name}"] = "\235\130\152  {mine}  :  {theirs}  {name}",
		["1V1 \194\183 ROUND {round} \194\183 FIRST TO {wins}"] = "1V1 \194\183 {round}\235\157\188\236\154\180\235\147\156 \194\183 {wins}\236\132\160\236\138\185\236\160\156",
		["1V1 \194\183 FIRST TO {wins} KILLS"] = "1V1 \194\183 \235\168\188\236\160\128 {wins}\236\178\152\236\185\152 \236\139\156 \236\138\185\235\166\172",
