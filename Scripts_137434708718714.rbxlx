		["Your data was opened on another server. Please rejoin."] = "\208\162\208\178\208\190\208\184 \208\180\208\176\208\189\208\189\209\139\208\181 \208\190\209\130\208\186\209\128\209\139\209\130\209\139 \208\189\208\176 \208\180\209\128\209\131\208\179\208\190\208\188 \209\129\208\181\209\128\208\178\208\181\209\128\208\181. \208\159\208\181\209\128\208\181\208\183\208\176\208\185\208\180\208\184, \208\191\208\190\208\182\208\176\208\187\209\131\208\185\209\129\209\130\208\176.",
