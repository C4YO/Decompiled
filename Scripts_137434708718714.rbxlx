		["Press **{Equip}** to sheathe the blade first."] = "\208\161\208\189\208\176\209\135\208\176\208\187\208\176 \208\189\208\176\208\182\208\188\208\184 **{Equip}**, \209\135\209\130\208\190\208\177\209\139 \209\131\208\177\209\128\208\176\209\130\209\140 \208\186\208\187\208\184\208\189\208\190\208\186 \208\178 \208\189\208\190\208\182\208\189\209\139.",
