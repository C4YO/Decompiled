		["{name} declined your 1v1."] = "{name} rechaz\195\179 tu 1v1.",
		["Every 1v1 ring is in use: try again in a moment."] = "Todos los rings de 1v1 est\195\161n ocupados: int\195\169ntalo en un momento.",
