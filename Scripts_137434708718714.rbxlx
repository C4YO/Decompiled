		["Names and boosts"] = "\229\167\147\230\176\143\228\184\142\229\138\160\230\136\144",
		["<b>Family name</b>: rolled once, at the forge.\n<b>First name</b>: reroll any time on the character screen (CHARACTER, on the title screen).\n\nRarer family names give stat boosts. Boosts are kept small, so fights are still won with the blade."] = "<b>\229\167\147\230\176\143</b>\239\188\154\229\143\170\229\156\168\233\148\187\229\136\128\229\157\138\230\138\189\229\174\154\228\184\128\230\172\161\227\128\130\n<b>\229\144\141\229\173\151</b>\239\188\154\233\154\143\230\151\182\229\143\175\228\187\165\229\156\168\232\167\146\232\137\178\231\149\140\233\157\162\239\188\136\230\160\135\233\162\152\231\148\187\233\157\162\228\184\173\231\154\132\226\128\156\232\167\146\232\137\178\226\128\157\239\188\137\233\135\141\230\138\189\227\128\130\n\n\232\190\131\231\168\128\230\156\137\231\154\132\229\167\147\230\176\143\228\188\154\229\184\166\230\157\165\229\177\158\230\128\167\229\138\160\230\136\144\227\128\130\229\138\160\230\136\144\229\136\187\230\132\143\229\129\154\229\190\151\229\190\136\229\176\143\239\188\140\229\165\189\232\174\169\232\131\156\232\180\159\228\187\141\229\143\150\229\134\179\228\186\142\229\136\128\230\179\149\227\128\130",
		["Rarity, odds and boosts:\n\n{rarities}\n\nThe rarest names belong to famous swordsmen and warlords. A Mythic name is a legend\'s own name, used in place of a family name. An Exotic name is a god\'s. Every spin is pure chance at these odds."] = "\231\168\128\230\156\137\229\186\166\227\128\129\230\166\130\231\142\135\228\184\142\229\138\160\230\136\144\239\188\154\n\n{rarities}\n\n\230\156\128\231\168\128\230\156\137\231\154\132\229\167\147\230\176\143\229\177\158\228\186\142\232\145\151\229\144\141\229\137\145\232\177\170\228\184\142\230\173\166\229\176\134\227\128\130\231\165\158\232\175\157\231\186\167\230\152\175\228\188\160\229\165\135\228\186\186\231\137\169\230\156\172\228\186\186\231\154\132\229\144\141\229\173\151\239\188\140\231\148\168\230\157\165\228\187\163\230\155\191\229\167\147\230\176\143\227\128\130\232\182\133\229\135\161\231\186\167\229\136\153\230\152\175\231\165\158\230\152\142\228\185\139\229\144\141\227\128\130\230\175\143\230\172\161\230\138\189\231\173\190\233\131\189\229\174\140\229\133\168\230\140\137\231\133\167\228\187\165\228\184\138\230\166\130\231\142\135\233\154\143\230\156\186\227\128\130",
		["Boosts:\n\n<b>Walk speed</b>: faster movement.\n<b>Poise recovery</b>: poise refills faster.\n<b>Poise toughness</b>: all poise costs are lower.\n<b>Slower bleeding</b>: wounds and stumps bleed slower.\n<b>Faster dash recharge</b>: dash charges refill sooner.\n\nBoosts stack with forge upgrades."] = "\229\138\160\230\136\144\231\167\141\231\177\187\239\188\154\n\n<b>\231\167\187\229\138\168\233\128\159\229\186\166</b>\239\188\154\231\167\187\229\138\168\230\155\180\229\191\171\227\128\130\n<b>\232\186\175\229\185\178\230\129\162\229\164\141</b>\239\188\154\232\186\175\229\185\178\230\129\162\229\164\141\229\190\151\230\155\180\229\191\171\227\128\130\n<b>\232\186\175\229\185\178\233\159\167\230\128\167</b>\239\188\154\230\137\128\230\156\137\232\186\175\229\185\178\230\182\136\232\128\151\233\131\189\233\153\141\228\189\142\227\128\130\n<b>\229\135\186\232\161\128\229\135\143\231\188\147</b>\239\188\154\228\188\164\229\143\163\229\146\140\230\150\173\232\130\162\230\181\129\232\161\128\230\155\180\230\133\162\227\128\130\n<b>\229\134\178\229\136\186\229\133\133\232\131\189\233\128\159\229\186\166</b>\239\188\154\229\134\178\229\136\186\229\133\133\232\131\189\230\129\162\229\164\141\229\190\151\230\155\180\229\191\171\227\128\130\n\n\229\138\160\230\136\144\228\188\154\228\184\142\233\148\187\229\136\128\229\157\138\231\154\132\229\188\186\229\140\150\229\143\160\229\138\160\227\128\130",
		["<b>Rename spins</b> reroll the family name. Get {spins} free spins every level, or buy more in the SHOP. Use them on the character screen. The old name can always be kept.\n\nBots have names too. The rarer a bot\'s name, the better it fights."] = "<b>\230\148\185\229\144\141\230\138\189\231\173\190</b>\229\143\175\228\187\165\233\135\141\230\138\189\229\167\147\230\176\143\227\128\130\230\175\143\229\141\135\228\184\128\231\186\167\229\133\141\232\180\185\232\142\183\229\190\151{spins}\230\172\161\230\138\189\231\173\190\239\188\140\228\185\159\229\143\175\229\156\168\226\128\156\229\149\134\229\186\151\226\128\157\232\180\173\228\185\176\230\155\180\229\164\154\227\128\130\229\156\168\232\167\146\232\137\178\231\149\140\233\157\162\228\189\191\231\148\168\227\128\130\229\142\159\230\157\165\231\154\132\229\167\147\230\176\143\229\167\139\231\187\136\229\143\175\228\187\165\228\191\157\231\149\153\227\128\130\n\n\228\186\186\230\156\186\228\185\159\230\156\137\229\167\147\230\176\143\227\128\130\228\186\186\230\156\186\231\154\132\229\167\147\230\176\143\232\182\138\231\168\128\230\156\137\239\188\140\229\174\158\229\138\155\232\182\138\229\188\186\227\128\130",
		["Poise"] = "\232\186\175\229\185\178",
		["<b>Poise</b> is a fighter\'s steadiness. The poise bar is the thin bar above the blood squares; an opponent\'s is under their name. It grows from the middle as poise is lost, turning from gold to red, and hides at full poise."] = "<b>\232\186\175\229\185\178</b>\228\187\163\232\161\168\230\173\166\232\128\133\230\158\182\229\138\191\231\154\132\231\168\179\229\174\154\231\168\139\229\186\166\227\128\130\232\186\175\229\185\178\230\157\161\230\152\175\232\161\128\230\160\188\228\184\138\230\150\185\231\154\132\231\187\134\230\157\161\239\188\155\229\175\185\230\137\139\231\154\132\232\186\175\229\185\178\230\157\161\229\156\168\229\133\182\229\144\141\229\173\151\228\184\139\230\150\185\227\128\130\230\141\159\229\164\177\232\186\175\229\185\178\230\151\182\239\188\140\232\186\175\229\185\178\230\157\161\228\188\154\228\187\142\228\184\173\233\151\180\229\144\145\228\184\164\228\190\167\229\187\182\228\188\184\239\188\140\231\148\177\233\135\145\229\143\152\231\186\162\239\188\155\232\186\175\229\185\178\229\133\168\230\187\161\230\151\182\229\136\153\228\188\154\233\154\144\232\151\143\227\128\130",
		["Poise costs:\n\n<b>Draw-cut</b>: {draw}.  <b>Blade hit by a draw-cut</b>: {block}.\n<b>Hard swing</b>: {swing}.  <b>Dash</b>: {dash}.  <b>Kick</b>: {kick}.\n<b>Taking a cut</b>: {wound} (double from a draw-cut), plus blood loss.\n<b>Clashes</b>: more the harder the blade is knocked."] = "\232\186\175\229\185\178\230\182\136\232\128\151\239\188\154\n\n<b>\230\139\148\229\136\128\230\150\169</b>\239\188\154{draw}\227\128\130  <b>\232\162\171\230\139\148\229\136\128\230\150\169\229\135\187\228\184\173\231\154\132\229\136\128</b>\239\188\154{block}\227\128\130\n<b>\231\140\155\229\138\155\230\140\165\231\160\141</b>\239\188\154{swing}\227\128\130  <b>\229\134\178\229\136\186</b>\239\188\154{dash}\227\128\130  <b>\232\184\162\229\135\187</b>\239\188\154{kick}\227\128\130\n<b>\232\162\171\230\150\169\228\184\173</b>\239\188\154{wound}\239\188\136\232\162\171\230\139\148\229\136\128\230\150\169\229\136\153\231\191\187\229\128\141\239\188\137\239\188\140\229\143\166\229\138\160\229\164\177\232\161\128\233\128\160\230\136\144\231\154\132\230\182\136\232\128\151\227\128\130\n<b>\230\139\188\229\136\128</b>\239\188\154\229\136\128\232\162\171\229\135\187\229\188\128\229\190\151\232\182\138\231\139\160\239\188\140\230\182\136\232\128\151\232\182\138\229\164\154\227\128\130",
		["Poise refills after {delay} seconds with no poise lost, at {regen} per second. A still guard (L2 on a gamepad) refills it faster; low blood refills it slower.\n\nBelow half poise, blade and movement speed drop, and the blade is knocked aside more easily."] = "\232\191\158\231\187\173{delay}\231\167\146\230\156\170\230\141\159\229\164\177\232\186\175\229\185\178\229\144\142\239\188\140\232\186\175\229\185\178\229\188\128\229\167\139\228\187\165\230\175\143\231\167\146{regen}\231\154\132\233\128\159\229\186\166\230\129\162\229\164\141\227\128\130\233\157\153\230\173\162\230\160\188\230\140\161\239\188\136\230\137\139\230\159\132\228\184\186L2\239\188\137\230\151\182\230\129\162\229\164\141\230\155\180\229\191\171\239\188\155\232\161\128\233\135\143\228\189\142\230\151\182\230\129\162\229\164\141\230\155\180\230\133\162\227\128\130\n\n\232\186\175\229\185\178\228\189\142\228\186\142\228\184\128\229\141\138\230\151\182\239\188\140\229\136\128\233\128\159\228\184\142\231\167\187\229\138\168\233\128\159\229\186\166\228\184\139\233\153\141\239\188\140\229\136\128\228\185\159\230\155\180\229\174\185\230\152\147\232\162\171\229\135\187\229\188\128\227\128\130",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> ({Wipe}). See the next scroll."] = "\232\186\175\229\185\178\229\189\146\233\155\182\230\151\182\228\188\154<b>\229\180\169\230\186\131</b>\239\188\154\232\184\137\232\183\132{stagger}\231\167\146\239\188\140\233\154\143\229\144\142\229\138\155\231\171\173{weakened}\231\167\146\239\188\136\229\135\143\233\128\159{slower}\227\128\129\229\150\152\230\129\175\227\128\129\229\177\143\229\185\149\232\190\185\231\188\152\229\143\152\230\154\151\239\188\137\227\128\130\228\185\139\229\144\142\232\186\175\229\185\178\230\129\162\229\164\141\229\136\176\228\184\128\229\141\138\227\128\130\n\n\232\186\175\229\185\178\229\155\158\230\187\161\230\156\128\229\191\171\231\154\132\230\150\185\230\179\149\230\152\175<b>\230\140\175\232\161\128</b>\239\188\136{Wipe}\239\188\137\227\128\130\232\175\166\232\167\129\228\184\139\228\184\128\229\141\183\232\189\180\227\128\130",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> (WIPE). See the next scroll."] = "\232\186\175\229\185\178\229\189\146\233\155\182\230\151\182\228\188\154<b>\229\180\169\230\186\131</b>\239\188\154\232\184\137\232\183\132{stagger}\231\167\146\239\188\140\233\154\143\229\144\142\229\138\155\231\171\173{weakened}\231\167\146\239\188\136\229\135\143\233\128\159{slower}\227\128\129\229\150\152\230\129\175\227\128\129\229\177\143\229\185\149\232\190\185\231\188\152\229\143\152\230\154\151\239\188\137\227\128\130\228\185\139\229\144\142\232\186\175\229\185\178\230\129\162\229\164\141\229\136\176\228\184\128\229\141\138\227\128\130\n\n\232\186\175\229\185\178\229\155\158\230\187\161\230\156\128\229\191\171\231\154\132\230\150\185\230\179\149\230\152\175<b>\230\140\175\232\161\128</b>\239\188\136\231\130\185\229\135\187\226\128\156\230\140\175\232\161\128\226\128\157\239\188\137\227\128\130\232\175\166\232\167\129\228\184\139\228\184\128\229\141\183\232\189\180\227\128\130",
		["Wiping the blade"] = "\230\140\175\232\161\128",
		["Cuts leave blood on the blade. With the blade drawn, press <b>{Wipe}</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "\230\150\169\229\135\187\228\188\154\229\156\168\229\136\128\228\184\138\231\149\153\228\184\139\232\161\128\232\191\185\227\128\130\230\139\148\229\136\128\231\138\182\230\128\129\228\184\139\230\140\137<b>{Wipe}</b>\239\188\140\231\148\168\229\184\131\230\147\166\230\139\173\229\136\128\232\186\171\239\188\140\229\133\136\230\147\166\228\184\128\233\157\162\229\134\141\230\147\166\229\143\166\228\184\128\233\157\162\227\128\130\230\175\143\230\172\161\230\140\175\232\161\128\231\186\166\233\156\128{time}\231\167\146\227\128\130",
		["<b>Wiping restores poise.</b> During a wipe, poise refills at {times}x speed, and a finished wipe fills it to full.\n\nAfter a poise break, a finished wipe also ends the weakened state."] = "<b>\230\140\175\232\161\128\229\143\175\228\187\165\230\129\162\229\164\141\232\186\175\229\185\178\227\128\130</b>\230\140\175\232\161\128\230\156\159\233\151\180\239\188\140\232\186\175\229\185\178\228\187\165{times}\229\128\141\233\128\159\229\186\166\230\129\162\229\164\141\239\188\155\229\174\140\230\136\144\230\140\175\232\161\128\229\136\153\231\155\180\230\142\165\229\155\158\230\187\161\227\128\130\n\n\232\186\175\229\185\178\229\180\169\230\186\131\229\144\142\239\188\140\229\174\140\230\136\144\230\140\175\232\161\128\232\191\152\232\131\189\232\167\163\233\153\164\229\138\155\231\171\173\231\138\182\230\128\129\227\128\130",
		["<b>Wiping leaves an opening.</b> Once a wipe starts, steering, guarding and cutting are locked until it ends, and a swing into the loose blade knocks it far aside. Losing poise mid-wipe cancels the full refill.\n\nBots punish wipes. Make some distance first.\n\nA later forge rank unlocks a quicker wipe."] = "<b>\230\140\175\232\161\128\228\188\154\233\156\178\229\135\186\231\160\180\231\187\189\227\128\130</b>\230\140\175\232\161\128\228\184\128\230\151\166\229\188\128\229\167\139\239\188\140\231\187\147\230\157\159\229\137\141\233\131\189\230\151\160\230\179\149\230\147\141\230\142\167\229\136\128\227\128\129\230\160\188\230\140\161\230\136\150\230\150\169\229\135\187\239\188\155\230\157\190\230\143\161\231\154\132\229\136\128\232\139\165\232\162\171\231\160\141\228\184\173\239\188\140\228\188\154\232\162\171\232\191\156\232\191\156\229\135\187\229\188\128\227\128\130\230\140\175\232\161\128\233\128\148\228\184\173\232\139\165\230\141\159\229\164\177\232\186\175\229\185\178\239\188\140\229\174\140\230\136\144\229\144\142\228\190\191\228\184\141\228\188\154\229\155\158\230\187\161\227\128\130\n\n\228\186\186\230\156\186\228\184\147\230\140\145\230\140\175\232\161\128\230\151\182\232\191\155\230\148\187\227\128\130\229\133\136\230\139\137\229\188\128\232\183\157\231\166\187\227\128\130\n\n\229\144\142\231\187\173\231\154\132\233\148\187\229\136\128\231\173\137\231\186\167\228\188\154\232\167\163\233\148\129\230\155\180\229\191\171\231\154\132\230\140\175\232\161\128\227\128\130",
		["Cuts leave blood on the blade. With the blade drawn, tap <b>WIPE</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "\230\150\169\229\135\187\228\188\154\229\156\168\229\136\128\228\184\138\231\149\153\228\184\139\232\161\128\232\191\185\227\128\130\230\139\148\229\136\128\231\138\182\230\128\129\228\184\139\231\130\185\229\135\187\226\128\156<b>\230\140\175\232\161\128</b>\226\128\157\239\188\140\231\148\168\229\184\131\230\147\166\230\139\173\229\136\128\232\186\171\239\188\140\229\133\136\230\147\166\228\184\128\233\157\162\229\134\141\230\147\166\229\143\166\228\184\128\233\157\162\227\128\130\230\175\143\230\172\161\230\140\175\232\161\128\231\186\166\233\156\128{time}\231\167\146\227\128\130",
		["Drawing the sword"] = "\230\139\148\229\136\128\230\156\175",
		["The sword starts sheathed, with a hand on the sheath, ready to draw.\n\n<b>{Lock}</b>: toggle lock-on. While locked on, the mouse picks the cut; its name shows at the bottom of the screen.\n<b>{NextTarget}</b>: switch target.\n<b>{Unequip}</b>: unequip the sword. <b>{Equip}</b>: equip it again."] = "\229\136\128\232\181\183\229\136\157\230\148\182\229\156\168\229\136\128\233\158\152\228\184\173\239\188\140\230\137\139\230\140\137\229\136\128\233\158\152\239\188\140\233\154\143\230\151\182\229\143\175\228\187\165\230\139\148\229\136\128\227\128\130\n\n<b>{Lock}</b>\239\188\154\229\188\128\229\144\175\230\136\150\229\133\179\233\151\173\233\148\129\229\174\154\227\128\130\233\148\129\229\174\154\230\151\182\239\188\140\233\188\160\230\160\135\228\189\141\231\189\174\229\134\179\229\174\154\230\139\148\229\135\186\229\147\170\231\167\141\230\150\169\229\135\187\239\188\140\229\133\182\229\144\141\231\167\176\230\152\190\231\164\186\229\156\168\229\177\143\229\185\149\229\186\149\233\131\168\227\128\130\n<b>{NextTarget}</b>\239\188\154\229\136\135\230\141\162\231\155\174\230\160\135\227\128\130\n<b>{Unequip}</b>\239\188\154\230\157\190\230\137\139\230\148\190\229\188\128\229\136\128\227\128\130<b>{Equip}</b>\239\188\154\233\135\141\230\150\176\230\143\161\229\136\128\227\128\130",
		["Move the mouse to pick the cut, then hold {Draw} and swipe:\n\n<b>Down-left</b>, swipe up-right: low cut.\n<b>Left</b>, swipe right: horizontal slice.\n<b>Up-left</b>, swipe down-right: diagonal cut.\n<b>Up</b>, swipe down: vertical slice.\n\nA faster swipe makes a faster cut.\n\n<b>{CalmDraw}</b>: calm draw. The blade slides out slowly into a guard, with no cut."] = "\231\167\187\229\138\168\233\188\160\230\160\135\233\128\137\230\139\169\230\150\169\229\135\187\239\188\140\231\132\182\229\144\142\230\140\137\228\189\143{Draw}\229\185\182\230\187\145\229\138\168\239\188\154\n\n<b>\229\183\166\228\184\139</b>\239\188\140\229\144\145\229\143\179\228\184\138\230\187\145\229\138\168\239\188\154\230\146\169\230\150\169\227\128\130\n<b>\229\183\166</b>\239\188\140\229\144\145\229\143\179\230\187\145\229\138\168\239\188\154\230\168\170\230\150\169\227\128\130\n<b>\229\183\166\228\184\138</b>\239\188\140\229\144\145\229\143\179\228\184\139\230\187\145\229\138\168\239\188\154\230\150\156\230\150\169\227\128\130\n<b>\228\184\138</b>\239\188\140\229\144\145\228\184\139\230\187\145\229\138\168\239\188\154\231\186\181\230\150\169\227\128\130\n\n\230\187\145\229\190\151\232\182\138\229\191\171\239\188\140\230\150\169\229\190\151\232\182\138\229\191\171\227\128\130\n\n<b>{CalmDraw}</b>\239\188\154\233\157\153\229\191\131\230\139\148\229\136\128\227\128\130\229\136\128\232\186\171\231\188\147\231\188\147\229\135\186\233\158\152\239\188\140\230\145\134\229\165\189\230\160\188\230\140\161\230\158\182\229\138\191\239\188\140\228\184\141\229\135\186\230\150\169\229\135\187\227\128\130",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>{Equip}</b>: put the blade away. The next draw is ready about a second later."] = "\230\139\148\229\136\128\230\150\169\230\151\182\230\143\161\229\136\128\230\158\129\231\168\179\227\128\130\232\162\171\230\139\148\229\136\128\230\150\169\229\135\187\228\184\173\231\154\132\229\136\128\228\188\154\232\162\171\229\135\187\229\188\128\239\188\140\229\185\182\230\141\159\229\164\177{block}\232\186\175\229\185\178\227\128\130\230\175\143\230\172\161\230\139\148\229\136\128\230\150\169\230\182\136\232\128\151{draw}\232\186\175\229\185\178\227\128\130\n\n<b>{Equip}</b>\239\188\154\230\148\182\229\136\128\227\128\130\231\186\166\228\184\128\231\167\146\229\144\142\229\143\175\229\134\141\230\172\161\230\139\148\229\136\128\227\128\130",
		["The sword starts sheathed, with a hand on the sheath, ready to draw. While locked on, a slow drag on the right side of the screen moves the hand on the sheath, and a quick <b>flick</b> draws. The flick\'s direction picks the cut.\n\n<b>LOCKED ON</b>: tap to switch target, hold to turn lock-on off. <b>LOCK ON</b>: tap to turn it back on.\n<b>UNEQUIP</b>: hold to unequip the sword. <b>EQUIP</b>: tap to equip it again."] = "\229\136\128\232\181\183\229\136\157\230\148\182\229\156\168\229\136\128\233\158\152\228\184\173\239\188\140\230\137\139\230\140\137\229\136\128\233\158\152\239\188\140\233\154\143\230\151\182\229\143\175\228\187\165\230\139\148\229\136\128\227\128\130\233\148\129\229\174\154\230\151\182\239\188\140\229\156\168\229\177\143\229\185\149\229\143\179\228\190\167\231\188\147\230\133\162\230\139\150\229\138\168\229\143\175\231\167\187\229\138\168\229\136\128\233\158\152\228\184\138\231\154\132\230\137\139\239\188\140<b>\229\191\171\229\136\146</b>\229\141\179\229\143\175\230\139\148\229\136\128\227\128\130\229\191\171\229\136\146\231\154\132\230\150\185\229\144\145\229\134\179\229\174\154\230\150\169\229\135\187\227\128\130\n\n\226\128\156<b>\229\183\178\233\148\129\229\174\154</b>\226\128\157\239\188\154\231\130\185\229\135\187\229\136\135\230\141\162\231\155\174\230\160\135\239\188\140\233\149\191\230\140\137\229\133\179\233\151\173\233\148\129\229\174\154\227\128\130\226\128\156<b>\233\148\129\229\174\154</b>\226\128\157\239\188\154\231\130\185\229\135\187\233\135\141\230\150\176\229\188\128\229\144\175\227\128\130\n\226\128\156<b>\230\157\190\230\137\139</b>\226\128\157\239\188\154\233\149\191\230\140\137\230\148\190\229\188\128\229\136\128\227\128\130\226\128\156<b>\230\143\161\229\136\128</b>\226\128\157\239\188\154\231\130\185\229\135\187\233\135\141\230\150\176\230\143\161\229\136\128\227\128\130",
		["<b>Flick right</b>: horizontal slice.\n<b>Flick down</b>: vertical slice.\n<b>Flick up-right</b>: low cut.\n\n<b>CALM DRAW</b>: the blade slides out slowly into a guard, with no cut."] = "<b>\229\144\145\229\143\179\229\191\171\229\136\146</b>\239\188\154\230\168\170\230\150\169\227\128\130\n<b>\229\144\145\228\184\139\229\191\171\229\136\146</b>\239\188\154\231\186\181\230\150\169\227\128\130\n<b>\229\144\145\229\143\179\228\184\138\229\191\171\229\136\146</b>\239\188\154\230\146\169\230\150\169\227\128\130\n\n\226\128\156<b>\233\157\153\229\191\131\230\139\148\229\136\128</b>\226\128\157\239\188\154\229\136\128\232\186\171\231\188\147\231\188\147\229\135\186\233\158\152\239\188\140\230\145\134\229\165\189\230\160\188\230\140\161\230\158\182\229\138\191\239\188\140\228\184\141\229\135\186\230\150\169\229\135\187\227\128\130",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>SHEATHE</b>: put the blade away. The next draw is ready about a second later."] = "\230\139\148\229\136\128\230\150\169\230\151\182\230\143\161\229\136\128\230\158\129\231\168\179\227\128\130\232\162\171\230\139\148\229\136\128\230\150\169\229\135\187\228\184\173\231\154\132\229\136\128\228\188\154\232\162\171\229\135\187\229\188\128\239\188\140\229\185\182\230\141\159\229\164\177{block}\232\186\175\229\185\178\227\128\130\230\175\143\230\172\161\230\139\148\229\136\128\230\150\169\230\182\136\232\128\151{draw}\232\186\175\229\185\178\227\128\130\n\n\226\128\156<b>\230\148\182\229\136\128</b>\226\128\157\239\188\154\229\176\134\229\136\128\230\148\182\229\155\158\233\158\152\228\184\173\227\128\130\231\186\166\228\184\128\231\167\146\229\144\142\229\143\175\229\134\141\230\172\161\230\139\148\229\136\128\227\128\130",
		["Clashes and parries"] = "\230\139\188\229\136\128\228\184\142\229\188\185\229\143\141",
		["Blades that meet push each other apart, and the firmer blade moves less. A hard swing knocks a still blade far aside, and that blade is slow to recover: an opening to attack.\n\nHit near the hands, a blade barely moves. Hit near the tip, it\'s knocked aside easily."] = "\231\155\184\231\162\176\231\154\132\229\136\128\228\188\154\228\186\146\231\155\184\230\142\168\229\188\128\239\188\140\230\143\161\229\190\151\230\155\180\231\168\179\231\154\132\229\136\128\231\167\187\229\138\168\230\155\180\229\176\145\227\128\130\231\140\155\229\138\155\230\140\165\231\160\141\232\131\189\230\138\138\233\157\153\230\173\162\231\154\132\229\136\128\232\191\156\232\191\156\229\135\187\229\188\128\239\188\140\228\184\148\232\175\165\229\136\128\229\155\158\228\189\141\231\188\147\230\133\162\239\188\154\232\191\153\230\173\163\230\152\175\232\191\155\230\148\187\231\154\132\230\156\186\228\188\154\227\128\130\n\n\229\135\187\228\184\173\233\157\160\232\191\145\230\143\161\230\159\132\229\164\132\239\188\140\229\136\128\229\135\160\228\185\142\231\186\185\228\184\157\228\184\141\229\138\168\227\128\130\229\135\187\228\184\173\233\157\160\232\191\145\229\136\128\229\176\150\229\164\132\239\188\140\229\136\128\229\190\136\229\174\185\230\152\147\232\162\171\229\135\187\229\188\128\227\128\130",
		["<b>Draw-cuts</b> hit hardest. A blade held still that meets a draw-cut, or the drawer while the blade comes out, is knocked aside, and the cut goes through.\n\n<b>A still guard</b> (L2 on a gamepad) parries other swings: the swing bounces off and the attacker is staggered.\n\n<b>Two swings meeting</b> both give way, and neither can cut for a moment.\n\nThe whole sword can clash, handle included."] = "<b>\230\139\148\229\136\128\230\150\169</b>\229\138\155\233\129\147\230\156\128\229\188\186\227\128\130\233\157\153\230\173\162\231\154\132\229\136\128\231\162\176\229\136\176\230\139\148\229\136\128\230\150\169\239\188\140\230\136\150\229\156\168\229\135\186\229\136\128\230\151\182\231\162\176\229\136\176\230\139\148\229\136\128\232\128\133\239\188\140\228\188\154\232\162\171\229\188\185\229\188\128\239\188\140\232\128\140\230\150\169\229\135\187\231\155\180\230\142\165\230\150\169\232\191\135\227\128\130\n\n<b>\233\157\153\230\173\162\230\160\188\230\140\161</b>\239\188\136\230\137\139\230\159\132\228\184\186L2\239\188\137\229\143\175\229\188\185\229\143\141\229\133\182\228\187\150\230\140\165\231\160\141\239\188\154\230\140\165\231\160\141\228\188\154\232\162\171\229\188\185\229\188\128\239\188\140\230\148\187\229\135\187\232\128\133\233\153\183\229\133\165\232\184\137\232\183\132\227\128\130\n\n<b>\228\184\164\230\172\161\230\140\165\231\160\141\231\155\184\230\146\158</b>\230\151\182\229\143\140\230\150\185\233\131\189\228\188\154\232\162\171\230\142\168\229\188\128\239\188\140\228\184\128\230\151\182\232\176\129\228\185\159\230\151\160\230\179\149\230\150\169\229\135\187\227\128\130\n\n\230\149\180\230\138\138\229\136\128\233\131\189\232\131\189\230\139\188\229\136\128\239\188\140\229\136\128\230\159\132\228\185\159\229\140\133\230\139\172\229\156\168\229\134\133\227\128\130",
		["Cuts, wounds and bleeding"] = "\230\150\169\229\135\187\227\128\129\228\188\164\229\143\163\228\184\142\230\181\129\232\161\128",
		["A cut needs speed and a leading edge. Speed comes from the swing and from movement, so dashing past counts. A sudden change of direction hits with the flat.\n\nOnly a blade moving into a target counts. A blade left resting in a body sticks."] = "\230\150\169\229\135\187\233\156\128\232\166\129\233\128\159\229\186\166\239\188\140\229\185\182\228\184\148\229\136\128\229\136\131\230\156\157\229\137\141\227\128\130\233\128\159\229\186\166\230\157\165\232\135\170\230\140\165\229\136\128\229\146\140\231\167\187\229\138\168\239\188\140\229\155\160\230\173\164\229\134\178\229\136\186\230\142\160\232\191\135\228\185\159\231\174\151\227\128\130\231\170\129\231\132\182\230\148\185\229\143\152\230\150\185\229\144\145\228\188\154\229\143\152\230\136\144\229\136\128\233\157\162\230\139\141\230\137\147\227\128\130\n\n\229\143\170\230\156\137\230\156\157\231\155\174\230\160\135\229\136\135\229\133\165\231\154\132\229\136\128\230\137\141\231\174\151\230\149\176\227\128\130\229\129\156\231\149\153\229\156\168\232\186\171\228\189\147\233\135\140\231\154\132\229\136\128\228\188\154\229\141\161\228\189\143\227\128\130",
		["A fast, edge-first cut all the way through a limb <b>severs</b> it. Through the head or torso: <b>a kill</b>.\n\nAnything less is a <b>wound</b>: it bleeds and slows the limb. Deeper wounds are worse.\n\n<b>Stabs</b> never kill outright. A stab to the head, or a fast one to the body (dash or lunge in), takes a lot of blood at once. Other stabs wound."] = "\233\128\159\229\186\166\229\191\171\227\128\129\229\136\128\229\136\131\229\156\168\229\137\141\228\184\148\229\174\140\229\133\168\229\136\135\231\169\191\232\130\162\228\189\147\231\154\132\230\150\169\229\135\187\239\188\140\228\188\154\229\176\134\229\133\182<b>\230\150\169\230\150\173</b>\227\128\130\229\136\135\231\169\191\229\164\180\233\131\168\230\136\150\232\186\171\232\186\175\239\188\154<b>\228\184\128\229\135\187\230\175\153\229\145\189</b>\227\128\130\n\n\230\156\170\232\190\190\229\136\176\232\191\153\228\184\128\231\168\139\229\186\166\231\154\132\229\136\153\230\152\175<b>\228\188\164\229\143\163</b>\239\188\154\228\188\154\230\181\129\232\161\128\229\185\182\228\189\191\232\175\165\232\130\162\228\189\147\229\143\152\230\133\162\227\128\130\228\188\164\229\143\163\232\182\138\230\183\177\232\182\138\228\184\165\233\135\141\227\128\130\n\n<b>\231\170\129\229\136\186</b>\228\184\141\228\188\154\228\184\128\229\135\187\230\175\153\229\145\189\227\128\130\231\170\129\229\136\186\229\164\180\233\131\168\239\188\140\230\136\150\229\191\171\233\128\159\231\170\129\229\136\186\232\186\171\228\189\147\239\188\136\229\134\178\229\136\186\230\136\150\231\170\129\232\191\155\229\136\186\229\133\165\239\188\137\239\188\140\228\188\154\228\184\128\228\184\139\233\128\160\230\136\144\229\164\167\233\135\143\229\164\177\232\161\128\227\128\130\229\133\182\228\187\150\231\170\129\229\136\186\229\143\170\233\128\160\230\136\144\228\188\164\229\143\163\227\128\130",
		["Every fighter has {squares} squares of blood. Wounds bleed for a few seconds, and so does a lost limb. With two limbs lost, the stumps bleed out. Losing both arms drops the katana.\n\nCombat is allowed in the arena and the forest, except in safe zones. Inside one, the screen shows <b>{safe}</b>."] = "\230\175\143\229\144\141\230\173\166\232\128\133\233\131\189\230\156\137{squares}\230\160\188\232\161\128\227\128\130\228\188\164\229\143\163\228\188\154\230\181\129\232\161\128\229\135\160\231\167\146\239\188\140\230\150\173\232\130\162\228\185\159\228\184\128\230\160\183\227\128\130\229\164\177\229\142\187\228\184\164\230\157\161\232\130\162\228\189\147\229\144\142\239\188\140\230\150\173\229\143\163\228\188\154\228\184\128\231\155\180\230\181\129\232\161\128\231\155\180\232\135\179\230\173\187\228\186\161\227\128\130\229\164\177\229\142\187\229\143\140\232\135\130\229\176\177\228\188\154\230\142\137\229\136\128\227\128\130\n\n\231\171\158\230\138\128\229\156\186\229\146\140\230\163\174\230\158\151\228\184\173\229\157\135\229\143\175\230\136\152\230\150\151\239\188\140\229\174\137\229\133\168\229\140\186\233\153\164\229\164\150\227\128\130\232\186\171\229\164\132\229\174\137\229\133\168\229\140\186\230\151\182\239\188\140\229\177\143\229\185\149\228\188\154\230\152\190\231\164\186<b>{safe}</b>\227\128\130",
		["The forge and levels"] = "\233\148\187\229\136\128\229\157\138\228\184\142\231\173\137\231\186\167",
		["XP rewards:\n\n<b>Wounding a player</b>: {wound}.\n<b>Severing a limb</b>: {sever}.\n<b>A kill</b>: {kill}.\n<b>Defeating a bot</b>: {botLeast} to {botMost}, more for rarer names.\n\nEach level needs a little more XP than the last. No level cap."] = "XP\229\165\150\229\138\177\239\188\154\n\n<b>\228\188\164\229\136\176\231\142\169\229\174\182</b>\239\188\154{wound}\227\128\130\n<b>\230\150\169\230\150\173\232\130\162\228\189\147</b>\239\188\154{sever}\227\128\130\n<b>\229\135\187\230\157\128</b>\239\188\154{kill}\227\128\130\n<b>\229\135\187\232\180\165\228\186\186\230\156\186</b>\239\188\154{botLeast}\232\135\179{botMost}\239\188\140\229\167\147\230\176\143\232\182\138\231\168\128\230\156\137\232\182\138\229\164\154\227\128\130\n\n\230\175\143\231\186\167\230\137\128\233\156\128XP\230\175\148\228\184\138\228\184\128\231\186\167\231\149\165\229\164\154\227\128\130\230\178\161\230\156\137\231\173\137\231\186\167\228\184\138\233\153\144\227\128\130",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, press E at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "\230\175\143{levels}\231\186\167\232\167\163\233\148\129\228\184\128\228\184\170\230\150\176\231\154\132<b>\233\148\187\229\136\128\231\173\137\231\186\167</b>\227\128\130\229\156\168\231\171\158\230\138\128\229\156\186\229\141\151\232\190\185\231\154\132\233\148\187\229\136\128\229\157\138\239\188\140\229\136\176\233\147\129\231\160\167\229\137\141\230\140\137E\239\188\140\228\184\186\229\136\128\229\138\160\231\131\173\227\128\129\233\148\164\230\137\147\227\128\129\230\183\172\231\129\171\227\128\130\230\175\143\228\184\170\231\173\137\231\186\167\233\131\189\228\188\154\232\181\139\228\186\136\229\136\128\229\133\168\230\150\176\231\154\132\229\164\150\232\167\130\229\146\140\228\184\128\233\161\185\230\150\176\229\188\186\229\140\150\227\128\130\n\n\232\191\153\233\135\140\231\154\132\229\136\128\230\158\182\229\177\149\231\164\186\228\186\134\230\175\143\228\184\170\233\148\187\229\136\128\231\173\137\231\186\167\231\154\132\229\136\128\227\128\130\n\n<b>\233\135\141\233\147\184</b>\229\141\179\229\143\175\229\136\135\230\141\162\229\155\158\228\187\187\228\189\149\229\183\178\233\148\187\233\128\160\232\191\135\231\154\132\231\173\137\231\186\167\227\128\130",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, tap <b>Forge your blade</b> at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "\230\175\143{levels}\231\186\167\232\167\163\233\148\129\228\184\128\228\184\170\230\150\176\231\154\132<b>\233\148\187\229\136\128\231\173\137\231\186\167</b>\227\128\130\229\156\168\231\171\158\230\138\128\229\156\186\229\141\151\232\190\185\231\154\132\233\148\187\229\136\128\229\157\138\239\188\140\229\136\176\233\147\129\231\160\167\229\137\141\231\130\185\229\135\187\226\128\156<b>\233\148\187\233\128\160\229\136\128\229\136\131</b>\226\128\157\239\188\140\228\184\186\229\136\128\229\138\160\231\131\173\227\128\129\233\148\164\230\137\147\227\128\129\230\183\172\231\129\171\227\128\130\230\175\143\228\184\170\231\173\137\231\186\167\233\131\189\228\188\154\232\181\139\228\186\136\229\136\128\229\133\168\230\150\176\231\154\132\229\164\150\232\167\130\229\146\140\228\184\128\233\161\185\230\150\176\229\188\186\229\140\150\227\128\130\n\n\232\191\153\233\135\140\231\154\132\229\136\128\230\158\182\229\177\149\231\164\186\228\186\134\230\175\143\228\184\170\233\148\187\229\136\128\231\173\137\231\186\167\231\154\132\229\136\128\227\128\130\n\n<b>\233\135\141\233\147\184</b>\229\141\179\229\143\175\229\136\135\230\141\162\229\155\158\228\187\187\228\189\149\229\183\178\233\148\187\233\128\160\232\191\135\231\154\132\231\173\137\231\186\167\227\128\130",
		["Kill streaks"] = "\232\191\158\230\150\169",
		["A <b>kill streak</b> counts kills in a row without dying, shown at the top right. Bleed-outs from a cut count, and so do bot kills. Dying ends the streak, but the best one is saved."] = "<b>\232\191\158\230\150\169</b>\231\187\159\232\174\161\230\156\170\230\173\187\228\186\161\230\156\159\233\151\180\231\154\132\232\191\158\231\187\173\229\135\187\230\157\128\230\149\176\239\188\140\230\152\190\231\164\186\229\156\168\229\143\179\228\184\138\232\167\146\227\128\130\232\162\171\230\150\169\228\188\164\229\144\142\229\164\177\232\161\128\232\128\140\228\186\161\231\154\132\228\185\159\231\174\151\239\188\140\229\135\187\230\157\128\228\186\186\230\156\186\228\185\159\231\174\151\227\128\130\230\173\187\228\186\161\228\188\154\228\184\173\230\150\173\232\191\158\230\150\169\239\188\140\228\189\134\230\156\128\233\171\152\231\186\170\229\189\149\228\188\154\228\191\157\229\173\152\228\184\139\230\157\165\227\128\130",
		["The streak catches fire as it grows, and every ten kills earns a title. Every {every} kills up to {most}: +{share} walk speed and poise recovery (Mythic names +{mythic}, Exotic names +{exotic}).\n\nNo prizes: it\'s for the glory.\n\nAfter dying, <b>SPECTATE</b> watches other fighters and <b>RESPAWN</b> returns to the fight."] = "\232\191\158\230\150\169\232\182\138\229\164\154\239\188\140\230\149\176\229\173\151\229\176\177\228\188\154\231\135\131\232\181\183\231\129\171\231\132\176\239\188\155\230\175\143\229\141\129\232\191\158\230\150\169\232\142\183\229\190\151\228\184\128\228\184\170\231\167\176\229\143\183\227\128\130\230\175\143{every}\232\191\158\230\150\169\239\188\140\231\155\180\229\136\176{most}\232\191\158\230\150\169\239\188\154\231\167\187\229\138\168\233\128\159\229\186\166\228\184\142\232\186\175\229\185\178\230\129\162\229\164\141+{share}\239\188\136\231\165\158\232\175\157\229\167\147\230\176\143+{mythic}\239\188\140\232\182\133\229\135\161\229\167\147\230\176\143+{exotic}\239\188\137\227\128\130\n\n\230\178\161\230\156\137\229\165\150\229\147\129\239\188\154\229\143\170\228\184\186\232\141\163\232\128\128\227\128\130\n\n\233\152\181\228\186\161\229\144\142\239\188\140\226\128\156<b>\232\167\130\230\136\152</b>\226\128\157\229\143\175\232\167\130\231\156\139\229\133\182\228\187\150\230\173\166\232\128\133\230\136\152\230\150\151\239\188\140\226\128\156<b>\229\164\141\230\180\187</b>\226\128\157\229\143\175\233\135\141\232\191\148\230\136\152\230\150\151\227\128\130",
		["TO WHOEVER FREED THIS TEMPLE"] = "\232\135\180\232\167\163\230\148\190\230\173\164\229\175\186\228\185\139\228\186\186",
		["Her blade still rests within these walls. Search every corner."] = "\229\165\185\231\154\132\229\136\128\228\187\141\229\174\137\230\148\190\229\156\168\232\191\153\229\155\180\229\162\153\228\185\139\229\134\133\227\128\130\230\144\156\233\129\141\230\175\143\228\184\128\228\184\170\232\167\146\232\144\189\227\128\130",
