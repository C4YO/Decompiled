		["Can\'t queue for a 1v1: {why}."] = "No puedes entrar en la cola 1v1: {why}.",
		["You joined the 1v1 queue."] = "Entraste en la cola 1v1.",
		["Can\'t bow for a 1v1: you\'re {why}."] = "No puedes hacer la reverencia para un 1v1: est\195\161s {why}.",
