		["{names} will be gone for good."] = "{names}\229\176\134\230\176\184\232\191\156\229\164\177\229\142\187\227\128\130",
		["Peaceful: out in the forest nobody can hurt you, and you can\'t hurt anyone. In the rings you fight as usual."] = "\229\146\140\229\185\179\230\168\161\229\188\143\239\188\154\229\156\168\230\163\174\230\158\151\233\135\140\230\178\161\228\186\186\232\131\189\228\188\164\229\174\179\228\189\160\239\188\140\228\189\160\228\185\159\228\184\141\232\131\189\228\188\164\229\174\179\228\187\187\228\189\149\228\186\186\227\128\130\229\156\168\230\147\130\229\143\176\233\135\140\231\133\167\229\184\184\230\136\152\230\150\151\227\128\130",
		["Peaceful: nobody can hurt you, and you can\'t hurt anyone. In the beginners\' ring and the boss arena you fight as usual."] = "\229\146\140\229\185\179\230\168\161\229\188\143\239\188\154\230\178\161\228\186\186\232\131\189\228\188\164\229\174\179\228\189\160\239\188\140\228\189\160\228\185\159\228\184\141\232\131\189\228\188\164\229\174\179\228\187\187\228\189\149\228\186\186\227\128\130\229\156\168\230\150\176\230\137\139\230\147\130\229\143\176\229\146\140\233\166\150\233\162\134\231\171\158\230\138\128\229\156\186\233\135\140\231\133\167\229\184\184\230\136\152\230\150\151\227\128\130",
		["BONFIRE"] = "\231\175\157\231\129\171",
		["LAST LOCATION"] = "\228\184\138\230\172\161\228\189\141\231\189\174",
		["Outside the ring: sword lowered"] = "\230\147\130\229\143\176\229\164\150\239\188\154\229\136\128\229\183\178\229\158\130\228\184\139",
		["Outside the ring: sword sheathed"] = "\230\147\130\229\143\176\229\164\150\239\188\154\229\183\178\230\148\182\229\136\128",
		["Find bonfires out in the world to travel between them."] = "\229\156\168\228\184\150\231\149\140\229\144\132\229\156\176\230\137\190\229\136\176\231\175\157\231\129\171\239\188\140\229\176\177\232\131\189\229\156\168\229\174\131\228\187\172\228\185\139\233\151\180\228\188\160\233\128\129\227\128\130",
		["Tap a bonfire you\'ve found to travel there."] = "\232\189\187\232\167\166\228\189\160\230\137\190\229\136\176\231\154\132\231\175\157\231\129\171\229\141\179\229\143\175\228\188\160\233\128\129\229\136\176\233\130\163\233\135\140\227\128\130",
		["Click a bonfire you\'ve found to travel there."] = "\231\130\185\229\135\187\228\189\160\230\137\190\229\136\176\231\154\132\231\175\157\231\129\171\229\141\179\229\143\175\228\188\160\233\128\129\229\136\176\233\130\163\233\135\140\227\128\130",
		["Bonfire found: {name}"] = "\229\143\145\231\142\176\231\175\157\231\129\171\239\188\154{name}",
		["Rested at {name}. You\'ll start here when you next play."] = "\229\183\178\229\156\168{name}\228\188\145\230\129\175\227\128\130\228\184\139\230\172\161\232\191\155\229\133\165\230\184\184\230\136\143\228\188\154\228\187\142\232\191\153\233\135\140\229\188\128\229\167\139\227\128\130",
		["You haven\'t found that bonfire yet."] = "\228\189\160\232\191\152\230\178\161\230\156\137\230\137\190\229\136\176\233\130\163\229\164\132\231\175\157\231\129\171\227\128\130",
		["{upgrade}.  {look}"] = "{upgrade}\227\128\130  {look}",
		["REFORGE"] = "\233\135\141\233\147\184",
		["Forge your next upgrade, or reforge your blade to a rank you\'ve already forged."] = "\233\148\187\233\128\160\228\184\139\228\184\128\231\186\167\229\188\186\229\140\150\239\188\140\230\136\150\229\176\134\229\136\128\233\135\141\233\147\184\228\184\186\229\183\178\233\148\187\233\128\160\232\191\135\231\154\132\231\173\137\231\186\167\227\128\130",
		["FORGE RANK {rank}   {name}"] = "\233\148\187\233\128\160\231\173\137\231\186\167{rank}   {name}",
		["unlocks at level {level} (you\'re level {yours})"] = "{level}\231\186\167\232\167\163\233\148\129\239\188\136\228\189\160\231\155\174\229\137\141{yours}\231\186\167\239\188\137",
		["RANK {rank}   {name}   (in use)"] = "\231\173\137\231\186\167{rank}   {name}   \239\188\136\228\189\191\231\148\168\228\184\173\239\188\137",
		["Dark blade, crimson edge, red lightning, a glow that flares as it drinks."] = "\230\154\151\233\187\145\229\136\128\232\186\171\227\128\129\230\183\177\231\186\162\229\136\131\229\143\163\227\128\129\232\181\164\232\137\178\233\155\183\229\133\137\239\188\140\233\165\174\232\161\128\232\182\138\229\164\154\229\133\137\232\138\146\232\182\138\231\155\155\227\128\130",
		["FIND IT"] = "\229\175\187\230\137\190",
		["{short} Find it in the rooms of the temple on the hill."] = "{short} \229\156\168\229\177\177\228\184\138\229\175\186\229\186\153\231\154\132\230\136\191\233\151\180\233\135\140\229\143\175\228\187\165\230\137\190\229\136\176\229\174\131\227\128\130",
		["Blade length 3.2 studs"] = "\229\136\128\232\186\171\233\149\1913.2\230\160\188",
		["Blade length 3.4 studs, draw styles (coming soon)"] = "\229\136\128\232\186\171\233\149\1913.4\230\160\188\239\188\140\230\139\148\229\136\128\230\181\129\230\180\190\239\188\136\229\141\179\229\176\134\230\142\168\229\135\186\239\188\137",
		["+5% walk speed"] = "\231\167\187\229\138\168\233\128\159\229\186\166+5%",
		["+5% walk speed, 25% faster poise recovery"] = "\231\167\187\229\138\168\233\128\159\229\186\166+5%\239\188\140\232\186\175\229\185\178\230\129\162\229\164\141\233\128\159\229\186\166+25%",
		["After {delay} seconds of calm it comes back, {regen} a second: faster with a still guard (L2 on a gamepad), slower with little blood.\n\nBelow half, your feet slow down. The lower it is, the heavier your blade and the more easily it\'s knocked aside."] = "\229\185\179\233\157\153{delay}\231\167\146\229\144\142\229\188\128\229\167\139\230\129\162\229\164\141\239\188\140\230\175\143\231\167\146{regen}\239\188\154\233\157\153\230\173\162\230\160\188\230\140\161\230\151\182\230\155\180\229\191\171\239\188\136\230\137\139\230\159\132\228\184\186L2\239\188\137\239\188\140\232\161\128\233\135\143\228\189\142\230\151\182\230\155\180\230\133\162\227\128\130\n\n\228\189\142\228\186\142\228\184\128\229\141\138\230\151\182\239\188\140\228\189\160\231\154\132\232\132\154\230\173\165\228\188\154\229\143\152\230\133\162\227\128\130\232\182\138\228\189\142\239\188\140\228\189\160\231\154\132\229\136\128\232\182\138\230\178\137\239\188\140\228\185\159\232\182\138\229\174\185\230\152\147\232\162\171\229\135\187\229\188\128\227\128\130",
		["<b>Wiping resets your poise.</b> While the cloth is on the blade, poise comes back {times} times as fast, and a finished wipe fills it to full.\n\nIt works after a break too: finishing a wipe ends being weakened.\n\nA finished wipe also gives back all your dashes."] = "<b>\230\140\175\232\161\128\229\143\175\228\187\165\230\129\162\229\164\141\232\186\175\229\185\178\227\128\130</b>\229\184\131\232\180\180\229\156\168\229\136\128\228\184\138\230\151\182\239\188\140\232\186\175\229\185\178\228\187\165{times}\229\128\141\233\128\159\229\186\166\230\129\162\229\164\141\239\188\155\229\174\140\230\136\144\230\140\175\232\161\128\229\136\153\231\155\180\230\142\165\229\155\158\230\187\161\227\128\130\n\n\232\186\175\229\185\178\229\180\169\230\186\131\229\144\142\229\144\140\230\160\183\230\156\137\230\149\136\239\188\154\229\174\140\230\136\144\230\140\175\232\161\128\229\141\179\229\143\175\232\167\163\233\153\164\229\138\155\231\171\173\227\128\130\n\n\229\174\140\230\136\144\230\140\175\232\161\128\232\191\152\228\188\154\230\129\162\229\164\141\228\189\160\230\137\128\230\156\137\231\154\132\229\134\178\229\136\186\227\128\130",
		["tap WIPE to refill dashes"] = "\231\130\185\229\135\187\226\128\156\230\140\175\232\161\128\226\128\157\230\129\162\229\164\141\229\134\178\229\136\186",
		["{key}  wipe to refill dashes"] = "{key}  \230\140\175\232\161\128\228\187\165\230\129\162\229\164\141\229\134\178\229\136\186",
		["Out of dashes. Tap **WIPE** to wipe your blade and get them back."] = "\229\134\178\229\136\186\231\148\168\229\174\140\228\186\134\227\128\130\231\130\185\229\135\187**\230\140\175\232\161\128**\230\147\166\229\136\128\229\141\179\229\143\175\230\129\162\229\164\141\227\128\130",
		["Out of dashes. Press **{Wipe}** to wipe your blade and get them back."] = "\229\134\178\229\136\186\231\148\168\229\174\140\228\186\134\227\128\130\230\140\137 **{Wipe}** \230\147\166\229\136\128\229\141\179\229\143\175\230\129\162\229\164\141\227\128\130",
		["+1% walk speed"] = "\231\167\187\229\138\168\233\128\159\229\186\166+1%",
		["10% less poise lost to hits and clashes"] = "\229\143\151\229\136\176\230\148\187\229\135\187\229\146\140\230\160\188\230\140\161\231\162\176\230\146\158\230\151\182\232\186\175\229\185\178\230\141\159\229\164\177\229\135\143\229\176\14510%",
		["10% less poise lost to hits and clashes, 15% quicker back from knocks"] = "\229\143\151\229\136\176\230\148\187\229\135\187\229\146\140\230\160\188\230\140\161\231\162\176\230\146\158\230\151\182\232\186\175\229\185\178\230\141\159\229\164\177\229\135\143\229\176\14510%\239\188\140\232\162\171\229\135\187\233\128\128\229\144\142\230\129\162\229\164\141\229\191\17115%",
		["+1% walk speed, 25% faster poise recovery"] = "\231\167\187\229\138\168\233\128\159\229\186\166+1%\239\188\140\232\186\175\229\185\178\230\129\162\229\164\141\233\128\159\229\186\166+25%",
		["+20 blood"] = "\232\161\128\233\135\143+20",
		["UPGRADE READY"] = "\229\143\175\229\188\186\229\140\150",
		["the forge"] = "\233\148\187\229\136\128\229\157\138",
		["New look"] = "\229\133\168\230\150\176\229\164\150\232\167\130",
		["Draw styles (coming soon)"] = "\230\139\148\229\136\128\230\181\129\230\180\190\239\188\136\229\141\179\229\176\134\230\142\168\229\135\186\239\188\137",
		["SINGLE"] = "\228\184\128\229\136\128\230\181\129",
