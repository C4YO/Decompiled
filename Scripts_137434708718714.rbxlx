		["After {delay} seconds of calm it comes back, {regen} a second: faster with a still guard (L2 on a gamepad), slower with little blood.\n\nBelow half, your feet slow down. The lower it is, the heavier your blade and the more easily it\'s knocked aside."] = "{delay}\231\167\146\232\144\189\227\129\161\231\157\128\227\129\143\227\129\168\227\128\129\230\175\142\231\167\146{regen}\227\129\154\227\129\164\230\136\187\227\130\139\227\128\130\233\157\153\230\173\162\227\129\151\227\129\159\230\167\139\227\129\136\227\129\170\227\130\137\233\128\159\227\129\143\239\188\136\227\130\178\227\131\188\227\131\160\227\131\145\227\131\131\227\131\137\227\129\167\227\129\175L2\239\188\137\227\128\129\232\161\128\227\129\140\229\176\145\227\129\170\227\129\132\227\129\168\233\129\133\227\129\132\227\128\130\n\n\229\141\138\229\136\134\227\130\146\228\184\139\229\155\158\227\130\139\227\129\168\232\182\179\227\129\140\233\129\133\227\129\143\227\129\170\227\130\139\227\128\130\228\189\142\227\129\132\227\129\187\227\129\169\229\136\128\227\129\175\233\135\141\227\129\143\227\129\170\227\130\138\227\128\129\229\188\190\227\129\139\227\130\140\227\130\132\227\129\153\227\129\143\227\129\170\227\130\139\227\128\130",
		["<b>Wiping resets your poise.</b> While the cloth is on the blade, poise comes back {times} times as fast, and a finished wipe fills it to full.\n\nIt works after a break too: finishing a wipe ends being weakened.\n\nA finished wipe also gives back all your dashes."] = "<b>\232\161\128\230\140\175\227\130\138\227\129\167\228\189\147\229\185\185\227\129\140\230\136\187\227\130\139\227\128\130</b>\229\184\131\227\129\140\229\136\128\227\129\171\232\167\166\227\130\140\227\129\166\227\129\132\227\130\139\233\150\147\227\128\129\228\189\147\229\185\185\227\129\175{times}\229\128\141\227\129\174\233\128\159\227\129\149\227\129\167\230\136\187\227\130\138\227\128\129\230\156\128\229\190\140\227\129\190\227\129\167\227\130\132\227\130\138\227\129\141\227\130\140\227\129\176\230\186\128\227\130\191\227\131\179\227\129\171\227\129\170\227\130\139\227\128\130\n\n\228\189\147\229\185\185\227\129\140\229\180\169\227\130\140\227\129\159\229\190\140\227\129\171\227\130\130\229\138\185\227\129\143\239\188\154\232\161\128\230\140\175\227\130\138\227\130\146\231\181\130\227\129\136\227\130\139\227\129\168\230\129\175\229\136\135\227\130\140\227\129\140\230\178\187\227\129\190\227\130\139\227\128\130\n\n\232\161\128\230\140\175\227\130\138\227\130\146\227\130\132\227\130\138\231\181\130\227\129\136\227\130\139\227\129\168\227\128\129\227\131\128\227\131\131\227\130\183\227\131\165\227\130\130\227\129\153\227\129\185\227\129\166\229\155\158\229\190\169\227\129\153\227\130\139\227\128\130",
		["tap WIPE to refill dashes"] = "\227\128\140\232\161\128\230\140\175\227\130\138\227\128\141\227\130\146\227\130\191\227\131\131\227\131\151\227\129\151\227\129\166\227\131\128\227\131\131\227\130\183\227\131\165\229\155\158\229\190\169",
		["{key}  wipe to refill dashes"] = "{key}  \232\161\128\230\140\175\227\130\138\227\129\167\227\131\128\227\131\131\227\130\183\227\131\165\229\155\158\229\190\169",
		["Out of dashes. Tap **WIPE** to wipe your blade and get them back."] = "\227\131\128\227\131\131\227\130\183\227\131\165\229\136\135\227\130\140\227\128\130**\232\161\128\230\140\175\227\130\138**\227\130\146\227\130\191\227\131\131\227\131\151\227\129\151\227\129\166\229\136\128\227\130\146\230\139\173\227\129\145\227\129\176\229\155\158\229\190\169\227\129\153\227\130\139\227\128\130",
		["Out of dashes. Press **{Wipe}** to wipe your blade and get them back."] = "\227\131\128\227\131\131\227\130\183\227\131\165\229\136\135\227\130\140\227\128\130**{Wipe}**\227\130\146\230\138\188\227\129\151\227\129\166\229\136\128\227\130\146\230\139\173\227\129\145\227\129\176\229\155\158\229\190\169\227\129\153\227\130\139\227\128\130",
		["+1% walk speed"] = "\231\167\187\229\139\149\233\128\159\229\186\166+1%",
		["10% less poise lost to hits and clashes"] = "\232\162\171\229\188\190\227\129\168\230\137\147\227\129\161\229\144\136\227\129\132\227\129\167\229\164\177\227\129\134\228\189\147\229\185\185-10%",
		["10% less poise lost to hits and clashes, 15% quicker back from knocks"] = "\232\162\171\229\188\190\227\129\168\230\137\147\227\129\161\229\144\136\227\129\132\227\129\167\229\164\177\227\129\134\228\189\147\229\185\185-10%\227\128\129\229\188\190\227\129\139\227\130\140\227\129\159\229\190\140\227\129\174\231\171\139\227\129\166\231\155\180\227\129\15115%\233\128\159\227\129\132",
		["+1% walk speed, 25% faster poise recovery"] = "\231\167\187\229\139\149\233\128\159\229\186\166+1%\227\128\129\228\189\147\229\185\185\229\155\158\229\190\16925%\227\130\162\227\131\131\227\131\151",
