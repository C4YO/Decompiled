		["Lock on to who you\'re looking at, or off."] = "\208\151\208\176\209\133\208\178\208\176\209\130\208\184\209\130\209\140 \209\130\208\190\208\179\208\190, \208\189\208\176 \208\186\208\190\208\179\208\190 \209\129\208\188\208\190\209\130\209\128\208\184\209\136\209\140, \208\184\208\187\208\184 \209\129\208\189\209\143\209\130\209\140 \208\183\208\176\209\133\208\178\208\176\209\130.",
		["Cycle lock on target."] = "\208\161\208\188\208\181\208\189\208\184\209\130\209\140 \209\134\208\181\208\187\209\140 \208\183\208\176\209\133\208\178\208\176\209\130\208\176.",
		["Kick: knock back, send limbs flying."] = "\208\159\208\184\208\189\208\190\208\186: \208\190\209\130\208\177\209\128\208\176\209\129\209\139\208\178\208\176\208\181\209\130, \208\176 \208\186\208\190\208\189\208\181\209\135\208\189\208\190\209\129\209\130\208\184 \208\187\208\181\209\130\209\143\209\130.",
		["Dash."] = "\208\160\209\139\208\178\208\190\208\186.",
