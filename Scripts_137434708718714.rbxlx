		["Talk"] = "N\195\179i chuy\225\187\135n",
		["TRAVELLING MERCHANT"] = "TH\198\175\198\160NG NH\195\130N L\225\187\174 H\195\128NH",
		["Ah, a traveller. You\'ll forgive me if I don\'t get up."] = "\195\128, m\225\187\153t l\225\187\175 kh\195\161ch. Th\225\187\169 l\225\187\151i cho ta v\195\172 kh\195\180ng \196\145\225\187\169ng d\225\186\173y.",
		["Three nights ago my horses caught wind of something up at that temple."] = "Ba \196\145\195\170m tr\198\176\225\187\155c, l\197\169 ng\225\187\177a c\225\187\167a ta \196\145\195\161nh h\198\161i th\225\186\165y th\225\187\169 g\195\172 \196\145\195\179 tr\195\170n ng\195\180i ch\195\185a kia.",
		["They screamed, broke their harness and bolted into the trees. I haven\'t seen them since."] = "Ch\195\186ng h\195\173 l\195\170n, gi\225\186\173t \196\145\225\187\169t d\195\162y c\198\176\198\161ng r\225\187\147i ch\225\186\161y v\195\160o r\225\187\171ng. T\225\187\171 \196\145\195\179 ta ch\198\176a th\225\186\165y l\225\186\161i ch\195\186ng.",
		["So here I am, stranded with a wagon full of wax."] = "Th\225\186\191 n\195\170n ta \225\187\159 \196\145\195\162y, m\225\186\175c k\225\186\185t v\225\187\155i m\225\187\153t c\225\187\151 xe \196\145\225\186\167y s\195\161p.",
		["There\'s something wrong with that temple, I\'d stay away if I were you, especially at night."] = "Ng\195\180i ch\195\185a \196\145\195\179 c\195\179 g\195\172 \196\145\195\179 kh\195\180ng \225\187\149n. N\225\186\191u l\195\160 ng\198\176\198\161i, ta s\225\186\189 tr\195\161nh xa n\195\179, nh\225\186\165t l\195\160 v\195\160o ban \196\145\195\170m.",
		["Here, take some wax. It might be useful to give your blade some extra shine. Be careful around a flame though, this stuff can catch alight in the blink of an eye!"] = "\196\144\195\162y, c\225\186\167m l\225\186\165y ch\195\186t s\195\161p. C\195\179 khi n\195\179 s\225\186\189 gi\195\186p l\198\176\225\187\161i ki\225\186\191m c\225\187\167a ng\198\176\198\161i b\195\179ng h\198\161n. Nh\198\176ng c\225\186\169n th\225\186\173n khi \225\187\159 g\225\186\167n l\225\187\173a nh\195\169, th\225\187\169 n\195\160y c\195\179 th\225\187\131 b\225\186\175t l\225\187\173a trong ch\225\187\155p m\225\186\175t!",
		["Still here? So am I."] = "V\225\186\171n c\195\178n \196\145\195\162y sao? Ta c\197\169ng v\225\186\173y.",
		["And keep away from that temple at night."] = "V\195\160 tr\195\161nh xa ng\195\180i ch\195\185a \196\145\195\179 v\195\160o ban \196\145\195\170m.",
		["KATANA: SINGLE"] = "KATANA: \196\144\198\160N",
		["One katana at the left hip."] = "M\225\187\153t thanh katana b\195\170n h\195\180ng tr\195\161i.",
		["A katana at each hip, drawn together, one in each hand."] = "M\225\187\151i b\195\170n h\195\180ng m\225\187\153t thanh katana, r\195\186t c\195\185ng l\195\186c, m\225\187\151i tay m\225\187\153t thanh.",
		["A katana at each hip, one in each hand."] = "M\225\187\151i b\195\170n h\195\180ng m\225\187\153t thanh katana, m\225\187\151i tay m\225\187\153t thanh.",
		["KATANA: IAI"] = "KATANA: IAI",
		["Draw-cuts only. High risk, high reward: cuts through blades, but a miss can be parried. Longer dash, faster draw. On a kill: poise back and a faster sheathe."] = "Ch\225\187\137 c\195\179 \196\145\195\178n r\195\186t ki\225\186\191m. R\225\187\167i ro cao, ph\225\186\167n th\198\176\225\187\159ng l\225\187\155n: xuy\195\170n qua l\198\176\225\187\161i ki\225\186\191m, nh\198\176ng \196\145\195\161nh h\225\187\165t c\195\179 th\225\187\131 b\225\187\139 g\225\186\161t \196\145\195\178n. L\198\176\225\187\155t xa h\198\161n, r\195\186t ki\225\186\191m nhanh h\198\161n. Khi h\225\186\161 g\225\187\165c: h\225\187\147i \196\145\225\187\153 v\225\187\175ng v\195\160 tra ki\225\186\191m nhanh h\198\161n.",
		["The older, longer sword, slung edge down at your hip. Slower and heavier than the katana: its hits take more poise and bleed more."] = "Thanh ki\225\186\191m c\225\187\149 h\198\161n v\195\160 d\195\160i h\198\161n, \196\145eo b\195\170n h\195\180ng v\225\187\155i l\198\176\225\187\161i h\198\176\225\187\155ng xu\225\187\145ng. Ch\225\186\173m v\195\160 n\225\186\183ng h\198\161n katana: \196\145\195\178n \196\145\195\161nh l\195\160m m\225\186\165t nhi\225\187\129u \196\145\225\187\153 v\225\187\175ng h\198\161n v\195\160 g\195\162y ch\225\186\163y m\195\161u nhi\225\187\129u h\198\161n.",
		["Longer and heavier than the katana: slower, but its hits take more poise and bleed more."] = "D\195\160i v\195\160 n\225\186\183ng h\198\161n katana: ch\225\186\173m h\198\161n, nh\198\176ng \196\145\195\178n \196\145\195\161nh l\195\160m m\225\186\165t nhi\225\187\129u \196\145\225\187\153 v\225\187\175ng h\198\161n v\195\160 g\195\162y ch\225\186\163y m\195\161u nhi\225\187\129u h\198\161n.",
		["Crimson rime. A keening at vespers. Kindled steel unsheathes me."] = "S\198\176\198\161ng gi\195\161 \196\145\225\187\143 th\225\186\175m. Ti\225\186\191ng kh\195\179c than l\195\186c kinh chi\225\187\129u. Th\195\169p b\225\187\171ng l\225\187\173a r\195\186t ta kh\225\187\143i v\225\187\143.",
		["+2.5% walk speed"] = "+2,5% t\225\187\145c \196\145\225\187\153 \196\145i",
		["Mirror polish, wavy temper line, clean bandages."] = "\196\144\195\161nh b\195\179ng nh\198\176 g\198\176\198\161ng, v\195\162n t\195\180i g\225\187\163n s\195\179ng, b\196\131ng qu\225\186\165n s\225\186\161ch.",
		["Store 2 dashes"] = "T\195\173ch tr\225\187\175 2 l\198\176\225\187\163t l\198\176\225\187\155t",
		["Black cord, gold collar, lacquered sheath."] = "D\195\162y \196\145en, kh\195\162u v\195\160ng, v\225\187\143 ki\225\186\191m s\198\161n m\195\160i.",
		["Blade length 2.9 studs"] = "L\198\176\225\187\161i ki\225\186\191m d\195\160i 2.9 studs",
		["A groove down each side, red cord on the sheath."] = "R\195\163nh d\225\187\141c m\225\187\151i m\225\186\183t l\198\176\225\187\161i, d\195\162y \196\145\225\187\143 tr\195\170n v\225\187\143 ki\225\186\191m.",
		["Dark forged steel, black sheath."] = "Th\195\169p r\195\168n s\225\186\171m m\195\160u, v\225\187\143 ki\225\186\191m \196\145en.",
		["Quick wipe: both sides at once"] = "Lau nhanh: c\225\186\163 hai m\225\186\183t c\195\185ng l\195\186c",
		["Gold guard, collar and pommel."] = "Ch\225\186\175n ki\225\186\191m, kh\195\162u v\195\160 \196\145\225\187\145c ki\225\186\191m b\225\186\177ng v\195\160ng.",
		["Blade length 3.0 studs"] = "L\198\176\225\187\161i ki\225\186\191m d\195\160i 3.0 studs",
		["Gleaming silver, crescent-moon guard, white cord and sheath."] = "B\225\186\161c s\195\161ng lo\195\161ng, ch\225\186\175n ki\225\186\191m h\195\172nh tr\196\131ng l\198\176\225\187\161i li\225\187\129m, d\195\162y v\195\160 v\225\187\143 ki\225\186\191m tr\225\186\175ng.",
		["Store 3 dashes"] = "T\195\173ch tr\225\187\175 3 l\198\176\225\187\163t l\198\176\225\187\155t",
		["White metal fittings."] = "Chi ti\225\186\191t b\225\186\177ng kim lo\225\186\161i tr\225\186\175ng.",
		["+2.5% walk speed, 25% faster poise recovery"] = "+2,5% t\225\187\145c \196\145\225\187\153 \196\145i, h\225\187\147i \196\145\225\187\153 v\225\187\175ng nhanh h\198\161n 25%",
		["Red cord, cherry-blossom ornaments, black tassel, red sheath with metal bands."] = "D\195\162y \196\145\225\187\143, h\225\187\141a ti\225\186\191t hoa anh \196\145\195\160o, tua \196\145en, v\225\187\143 ki\225\186\191m \196\145\225\187\143 c\195\179 \196\145ai kim lo\225\186\161i.",
		["Blade length 3.1 studs, draw styles (coming soon)"] = "L\198\176\225\187\161i ki\225\186\191m d\195\160i 3.1 studs, ki\225\187\131u r\195\186t ki\225\186\191m (s\225\186\175p c\195\179)",
		["Pale gold fittings, four-lobed guard, faint red glow on the edge."] = "Chi ti\225\186\191t v\195\160ng nh\225\186\161t, ch\225\186\175n ki\225\186\191m b\225\187\145n c\195\161nh, l\198\176\225\187\161i s\225\186\175c \195\161nh \196\145\225\187\143 m\225\187\157.",
		["Each hit that draws blood: +5 blood, +6 poise"] = "M\225\187\151i \196\145\195\178n g\195\162y ch\225\186\163y m\195\161u: +5 m\195\161u, +6 \196\145\225\187\153 v\225\187\175ng",
		["Dark blade, crimson edge, red lightning."] = "L\198\176\225\187\161i ki\225\186\191m s\225\186\171m, l\198\176\225\187\161i s\225\186\175c \196\145\225\187\143 th\225\186\171m, tia s\195\169t \196\145\225\187\143.",
		["No upgrades"] = "Kh\195\180ng c\195\179 n\195\162ng c\225\186\165p",
		["Old bandages, a plain brown sheath."] = "B\196\131ng qu\225\186\165n c\197\169, v\225\187\143 ki\225\186\191m n\195\162u \196\145\198\161n s\198\161.",
