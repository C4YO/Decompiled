}
local v93, v94 = v10("<b>Wiping leaves an opening.</b> Once a wipe starts, steering, guarding and cutting are locked until it ends, and a swing into the loose blade knocks it far aside. Losing poise mid-wipe cancels the full refill.\n\nBots punish wipes. Make some distance first.\n\nA later forge rank unlocks a quicker wipe.")
__set_list(v88, 1, {v89, v92, {
	["Text"] = v93,
	["Args"] = v94
}})
v87.Pages = v88
local v95 = {
	{
