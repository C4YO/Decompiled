		["Cycle lock on target."] = "\235\157\189\236\152\168 \235\140\128\236\131\129 \235\176\148\234\190\184\234\184\176.",
		["Kick: knock back, send limbs flying."] = "\235\176\156\236\176\168\234\184\176: \235\176\128\236\179\144\235\130\180\234\179\160 \237\140\148\235\139\164\235\166\172\235\165\188 \235\130\160\235\160\164\236\154\148.",
		["Dash."] = "\235\140\128\236\139\156.",
		["Front view: watch your own draws."] = "\236\160\149\235\169\180 \236\139\156\236\160\144: \235\130\180 \235\176\156\235\143\132\235\165\188 \235\179\180\234\184\176.",
		["Bow to who you\'re locked onto: both bow, a 1v1."] = "\235\157\189\236\152\168\237\149\156 \236\131\129\235\140\128\236\151\144\234\178\140 \236\157\184\236\130\172: \235\145\152 \235\139\164 \236\157\184\236\130\172\237\149\152\235\169\180 1v1.",
		["Battle music: next track."] = "\236\160\132\237\136\172 \236\157\140\236\149\133: \235\139\164\236\157\140 \234\179\161.",
		["Battle music: the last track."] = "\236\160\132\237\136\172 \236\157\140\236\149\133: \236\157\180\236\160\132 \234\179\161.",
		["In the dojo: skip to the arena."] = "\235\143\132\236\158\165\236\151\144\236\132\156: \234\178\189\234\184\176\236\158\165\236\156\188\235\161\156 \234\177\180\235\132\136\235\155\176\234\184\176.",
		["Hide the UI for clean shots. Again: show it."] = "\234\185\148\235\129\148\237\149\156 \236\158\165\235\169\180\236\157\132 \236\156\132\237\149\180 UI\235\165\188 \236\136\168\234\185\128. \235\139\164\236\139\156 \235\136\132\235\165\180\235\169\180 \237\145\156\236\139\156.",
		["Shamisen: take it out or put it away."] = "\236\131\164\235\175\184\236\132\188: \234\186\188\235\130\180\234\177\176\235\130\152 \236\167\145\236\150\180\235\132\163\236\150\180\236\154\148.",
		["left click"] = "\236\162\140\237\129\180\235\166\173",
		["right click"] = "\236\154\176\237\129\180\235\166\173",
		["middle click"] = "\237\156\160 \237\129\180\235\166\173",
		["RIGHT SHIFT"] = "\236\152\164\235\165\184\236\170\189 SHIFT",
		["RIGHT CTRL"] = "\236\152\164\235\165\184\236\170\189 CTRL",
		["RIGHT ALT"] = "\236\152\164\235\165\184\236\170\189 ALT",
		["Talk"] = "\235\140\128\237\153\148",
		["TRAVELLING MERCHANT"] = "\235\150\160\235\143\140\236\157\180 \236\131\129\236\157\184",
		["Ah, a traveller. You\'ll forgive me if I don\'t get up."] = "\236\149\132, \235\130\152\234\183\184\235\132\164\235\161\156\234\181\176. \236\157\188\236\150\180\235\130\152\236\167\128 \235\170\187\237\149\152\235\138\148 \234\177\184 \236\154\169\236\132\156\237\149\152\234\178\140.",
		["Three nights ago my horses caught wind of something up at that temple."] = "\236\130\172\237\157\152 \235\176\164 \236\160\132\236\151\144 \235\130\180 \235\167\144\235\147\164\236\157\180 \236\160\128 \236\156\132 \236\160\136\236\151\144\236\132\156 \235\172\180\236\150\184\234\176\128\236\157\152 \235\130\140\236\131\136\235\165\188 \235\167\161\236\149\152\236\167\128.",
		["They screamed, broke their harness and bolted into the trees. I haven\'t seen them since."] = "\235\185\132\235\170\133\236\157\132 \236\167\128\235\165\180\235\141\148\235\139\136 \235\167\136\234\181\172\235\165\188 \235\129\138\234\179\160 \236\136\178\236\156\188\235\161\156 \235\139\172\236\149\132\235\130\152 \235\178\132\235\160\184\236\150\180. \234\183\184 \235\146\164\235\161\156 \235\179\184 \236\160\129\236\157\180 \236\151\134\235\132\164.",
		["So here I am, stranded with a wagon full of wax."] = "\234\183\184\235\158\152\236\132\156 \236\157\180\235\160\135\234\178\140 \235\176\128\235\158\141\236\157\180 \234\176\128\235\147\157\237\149\156 \236\136\152\235\160\136\236\153\128 \237\149\168\234\187\152 \236\152\164\235\143\132 \234\176\128\235\143\132 \235\170\187\237\149\152\234\179\160 \236\158\136\236\167\128.",
		["There\'s something wrong with that temple, I\'d stay away if I were you, especially at night."] = "\236\160\128 \236\160\136\236\157\128 \235\173\148\234\176\128 \236\158\152\235\170\187\235\144\144\236\150\180. \235\130\180\234\176\128 \236\158\144\235\132\164\235\157\188\235\169\180 \234\176\128\234\185\140\236\157\180 \234\176\128\236\167\128 \236\149\138\234\178\160\235\132\164, \237\138\185\237\158\136 \235\176\164\236\151\144\235\138\148.",
		["Here, take some wax. It might be useful to give your blade some extra shine. Be careful around a flame though, this stuff can catch alight in the blink of an eye!"] = "\236\158\144, \235\176\128\235\158\141\236\157\132 \236\162\128 \234\176\128\236\160\184\234\176\128\234\178\140. \236\185\188\235\130\160\236\151\144 \234\180\145\236\157\132 \235\141\148 \235\130\180\235\138\148 \235\141\176 \236\147\184\235\170\168\234\176\128 \236\158\136\236\157\132\236\167\128\235\143\132 \235\170\168\235\165\180\236\167\128. \237\149\152\236\167\128\235\167\140 \235\182\136\234\189\131 \234\183\188\236\178\152\236\151\144\236\132\160 \236\161\176\236\139\172\237\149\152\234\178\140, \236\157\180\234\177\180 \235\136\136 \234\185\156\236\167\157\237\149\160 \236\130\172\236\157\180\236\151\144 \235\182\136\236\157\180 \235\182\153\234\177\176\235\147\160!",
		["Still here? So am I."] = "\236\149\132\236\167\129 \236\158\136\236\151\136\235\130\152? \235\130\152\235\143\132 \234\183\184\235\160\135\235\132\164.",
		["And keep away from that temple at night."] = "\234\183\184\235\166\172\234\179\160 \235\176\164\236\151\144\235\138\148 \236\160\128 \236\160\136\236\151\144 \234\176\128\234\185\140\236\157\180 \234\176\128\236\167\128 \235\167\144\234\178\140.",
		["KATANA: SINGLE"] = "\236\185\180\237\131\128\235\130\152: \236\157\188\235\143\132\235\165\152",
		["One katana at the left hip."] = "\236\153\188\236\170\189 \237\151\136\235\166\172\236\151\144 \236\185\180\237\131\128\235\130\152 \237\149\156 \236\158\144\235\163\168.",
		["A katana at each hip, drawn together, one in each hand."] = "\236\150\145\236\170\189 \237\151\136\235\166\172\236\151\144 \236\185\180\237\131\128\235\130\152 \237\149\156 \236\158\144\235\163\168\236\148\169, \237\149\168\234\187\152 \235\189\145\236\149\132 \236\150\145\236\134\144\236\151\144 \237\149\152\235\130\152\236\148\169.",
		["A katana at each hip, one in each hand."] = "\236\150\145\236\170\189 \237\151\136\235\166\172\236\151\144 \237\149\156 \236\158\144\235\163\168\236\148\169, \236\150\145\236\134\144\236\151\144 \237\149\152\235\130\152\236\148\169.",
		["KATANA: IAI"] = "\236\185\180\237\131\128\235\130\152: \234\177\176\237\149\169",
		["Draw-cuts only. High risk, high reward: cuts through blades, but a miss can be parried. Longer dash, faster draw. On a kill: poise back and a faster sheathe."] = "\235\176\156\235\143\132 \235\178\160\234\184\176 \236\160\132\236\154\169. \234\179\160\236\156\132\237\151\152 \234\179\160\235\179\180\236\131\129: \236\185\188\235\130\160\236\157\132 \235\154\171\234\179\160 \235\178\160\236\167\128\235\167\140, \235\185\151\235\130\152\234\176\128\235\169\180 \237\140\168\235\167\129\235\139\185\237\149\160 \236\136\152 \236\158\136\236\150\180\236\154\148. \235\141\148 \234\184\180 \235\140\128\236\139\156, \235\141\148 \235\185\160\235\165\184 \235\176\156\235\143\132. \236\178\152\236\185\152 \236\139\156: \236\158\144\236\132\184 \237\154\140\235\179\181, \235\130\169\235\143\132 \236\134\141\235\143\132 \236\166\157\234\176\128.",
		["The older, longer sword, slung edge down at your hip. Slower and heavier than the katana: its hits take more poise and bleed more."] = "\235\141\148 \236\152\164\235\158\152\235\144\152\234\179\160 \235\141\148 \234\184\180 \234\178\128\236\156\188\235\161\156, \235\130\160\236\157\132 \236\149\132\235\158\152\235\161\156 \237\150\165\237\149\180 \237\151\136\235\166\172\236\151\144 \235\167\164\235\139\181\235\139\136\235\139\164. \236\185\180\237\131\128\235\130\152\235\179\180\235\139\164 \235\138\144\235\166\172\234\179\160 \235\172\180\234\178\129\236\167\128\235\167\140, \234\179\181\234\178\169\236\157\180 \236\158\144\236\132\184\235\165\188 \235\141\148 \234\185\142\234\179\160 \236\182\156\237\152\136\236\157\132 \235\141\148 \236\157\188\236\156\188\237\130\181\235\139\136\235\139\164.",
		["Longer and heavier than the katana: slower, but its hits take more poise and bleed more."] = "\236\185\180\237\131\128\235\130\152\235\179\180\235\139\164 \234\184\184\234\179\160 \235\172\180\234\178\129\236\138\181\235\139\136\235\139\164. \235\138\144\235\166\172\236\167\128\235\167\140, \234\179\181\234\178\169\236\157\180 \236\158\144\236\132\184\235\165\188 \235\141\148 \234\185\142\234\179\160 \236\182\156\237\152\136\236\157\132 \235\141\148 \236\157\188\236\156\188\237\130\181\235\139\136\235\139\164.",
		["Crimson rime. A keening at vespers. Kindled steel unsheathes me."] = "\236\167\132\237\153\141\236\157\152 \236\132\156\235\166\172. \236\160\128\235\133\129 \236\152\136\235\182\136 \235\149\140\236\157\152 \234\179\161\236\132\177. \235\182\136\235\182\153\236\157\128 \234\176\149\236\178\160\236\157\180 \235\130\152\235\165\188 \236\185\188\236\167\145\236\151\144\236\132\156 \235\189\145\235\138\148\235\139\164.",
		["+2.5% walk speed"] = "\236\157\180\235\143\153 \236\134\141\235\143\132 +2.5%",
		["Mirror polish, wavy temper line, clean bandages."] = "\234\177\176\236\154\184 \234\176\153\236\157\128 \234\180\145\237\131\157, \235\172\188\234\178\176\236\185\152\235\138\148 \236\185\188\235\130\160 \235\172\180\235\138\172, \234\185\168\235\129\151\237\149\156 \235\182\149\235\140\128.",
		["Store 2 dashes"] = "\235\140\128\236\139\156 2\237\154\140 \236\160\128\236\158\165",
		["Black cord, gold collar, lacquered sheath."] = "\234\178\128\236\157\128 \235\129\136, \234\184\136\235\185\155 \236\185\188\235\170\169 \236\158\165\236\139\157, \236\152\187\236\185\160\237\149\156 \236\185\188\236\167\145.",
		["Blade length 2.9 studs"] = "\236\185\188\235\130\160 \234\184\184\236\157\180 2.9 \236\138\164\237\132\176\235\147\156",
		["A groove down each side, red cord on the sheath."] = "\236\150\145\235\169\180\236\151\144 \237\140\140\236\157\184 \237\153\136, \236\185\188\236\167\145\236\151\144 \235\182\137\236\157\128 \235\129\136.",
		["Dark forged steel, black sheath."] = "\234\178\128\234\178\140 \235\139\168\236\161\176\237\149\156 \234\176\149\236\178\160, \234\178\128\236\157\128 \236\185\188\236\167\145.",
		["Quick wipe: both sides at once"] = "\235\185\160\235\165\184 \235\139\166\234\184\176: \236\150\145\235\169\180\236\157\132 \237\149\156 \235\178\136\236\151\144",
		["Gold guard, collar and pommel."] = "\234\184\136\235\185\155 \236\189\148\235\147\177\236\157\180, \236\185\188\235\170\169 \236\158\165\236\139\157, \236\158\144\235\163\168 \235\168\184\235\166\172.",
		["Blade length 3.0 studs"] = "\236\185\188\235\130\160 \234\184\184\236\157\180 3.0 \236\138\164\237\132\176\235\147\156",
		["Gleaming silver, crescent-moon guard, white cord and sheath."] = "\235\185\155\235\130\152\235\138\148 \236\157\128\235\185\155, \236\180\136\236\138\185\235\139\172 \236\189\148\235\147\177\236\157\180, \237\157\176 \235\129\136\234\179\188 \236\185\188\236\167\145.",
		["Store 3 dashes"] = "\235\140\128\236\139\156 3\237\154\140 \236\160\128\236\158\165",
		["White metal fittings."] = "\237\157\176 \234\184\136\236\134\141 \236\158\165\236\139\157.",
		["+2.5% walk speed, 25% faster poise recovery"] = "\236\157\180\235\143\153 \236\134\141\235\143\132 +2.5%, \236\158\144\236\132\184 \237\154\140\235\179\181 25% \235\185\168\235\157\188\236\167\144",
		["Red cord, cherry-blossom ornaments, black tassel, red sheath with metal bands."] = "\235\182\137\236\157\128 \235\129\136, \235\178\154\234\189\131 \236\158\165\236\139\157, \234\178\128\236\157\128 \236\136\160, \234\184\136\236\134\141 \235\157\160\235\165\188 \235\145\144\235\165\184 \235\182\137\236\157\128 \236\185\188\236\167\145.",
		["Blade length 3.1 studs, draw styles (coming soon)"] = "\236\185\188\235\130\160 \234\184\184\236\157\180 3.1 \236\138\164\237\132\176\235\147\156, \235\176\156\235\143\132 \236\138\164\237\131\128\236\157\188 (\236\182\156\236\139\156 \236\152\136\236\160\149)",
		["Pale gold fittings, four-lobed guard, faint red glow on the edge."] = "\236\152\133\236\157\128 \234\184\136\235\185\155 \236\158\165\236\139\157, \235\132\164 \236\158\142 \236\189\148\235\147\177\236\157\180, \235\130\160\236\151\144 \236\157\128\236\157\128\237\149\156 \235\182\137\236\157\128 \235\185\155.",
		["Each hit that draws blood: +5 blood, +6 poise"] = "\237\148\188\235\165\188 \235\130\184 \237\131\128\234\178\169\235\167\136\235\139\164: \237\148\188 +5, \236\158\144\236\132\184 +6",
		["Dark blade, crimson edge, red lightning."] = "\234\178\128\236\157\128 \236\185\188\235\130\160, \236\167\132\237\153\141\235\185\155 \235\130\160, \235\182\137\236\157\128 \235\178\136\234\176\156.",
		["No upgrades"] = "\234\176\149\237\153\148 \236\151\134\236\157\140",
		["Old bandages, a plain brown sheath."] = "\235\130\161\236\157\128 \235\182\149\235\140\128, \236\136\152\236\136\152\237\149\156 \234\176\136\236\131\137 \236\185\188\236\167\145.",
		["FLAMMABLE WAX"] = "\234\176\128\236\151\176\236\132\177 \235\176\128\235\158\141",
		["Wax obtained from the old merchant at the foot of the hill."] = "\236\150\184\235\141\149 \234\184\176\236\138\173\236\157\152 \235\138\153\236\157\128 \236\131\129\236\157\184\236\151\144\234\178\140\236\132\156 \236\150\187\236\157\128 \235\176\128\235\158\141.",
		["VENGEFUL EMPRESS: IZANAMI"] = "\235\179\181\236\136\152\236\157\152 \236\151\172\236\160\156 \236\157\180\236\158\144\235\130\152\235\175\184",
