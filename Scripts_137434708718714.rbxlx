        <Item class="ModuleScript" referent="RBX202">
          <Properties>
            <string name="Name">SwordSim</string>
            <ProtectedString name="Source"><![CDATA[local v_u_1 = require(script.Parent.SwordConfig)
local v_u_2 = require(script.Parent.Pose)
local v_u_3 = require(script.Parent.Body)
local v_u_4 = v_u_1.Steer
local v_u_5 = v_u_1.Sheath
local v_u_6 = v_u_1.Clash
local v_u_191 = {
	["new"] = function() -- name: new
		-- upvalues: (copy) v_u_4
		return {
			["Yaw"] = nil,
			["Pitch"] = nil,
			["VX"] = 0,
			["VY"] = 0,
			["Roll"] = 0,
			["Thrust"] = 0,
			["AimYaw"] = nil,
			["AimPitch"] = nil,
			["Guard"] = false,
			["Thrusting"] = false,
			["Stuck"] = false,
			["Boost"] = 0,
			["BoostScale"] = 1,
			["KnockX"] = 0,
			["KnockY"] = 0,
			["BendYaw"] = 0,
			["BendPitch"] = 0,
			["Recover"] = 0,
			["RecoverTime"] = 0,
			["Steered"] = 0,
			["EdgeWay"] = Vector3.new(0, 0, 0),
			["EdgeRoll"] = 0,
			["Swung"] = 0,
			["RestRoll"] = 0,
			["Dual"] = false,
			["YawMin"] = nil,
			["YawMax"] = nil,
			["PitchMin"] = nil,
			["PitchMax"] = nil,
			["Yaw"] = v_u_4.RestYaw,
			["Pitch"] = v_u_4.RestPitch,
			["AimYaw"] = v_u_4.RestYaw,
			["AimPitch"] = v_u_4.RestPitch,
			["YawMin"] = -v_u_4.YawLimit,
			["YawMax"] = v_u_4.YawLimitRight,
			["PitchMin"] = v_u_4.PitchMin,
			["PitchMax"] = v_u_4.PitchMax
		}
	end,
	["newDual"] = function() -- name: newDual
		-- upvalues: (copy) v_u_191, (copy) v_u_2, (copy) v_u_1
		local v7 = v_u_191.new()
		local v8, v9 = v_u_2.dualYawRange()
		v7.YawMin = v8
		v7.YawMax = v9
		local v10 = v_u_1.Dual.PitchLowest
		v7.PitchMin = math.rad(v10)
		local v11 = v_u_1.Dual.PitchHighest
		v7.PitchMax = math.rad(v11)
		v7.Yaw = v_u_1.Dual.Apart / 2
		v7.AimYaw = v7.Yaw
		v7.Dual = true
		local v12 = v_u_1.Dual.EdgeRest
		v7.RestRoll = math.rad(v12)
		v7.Roll = v7.RestRoll
		return v7
	end,
	["aim"] = function(p13, p14, p15) -- name: aim
		local v16 = p13.AimYaw + p14
		local v17 = p13.YawMin
		local v18 = p13.YawMax
		p13.AimYaw = math.clamp(v16, v17, v18)
		local v19 = p13.AimPitch + p15
		local v20 = p13.PitchMin
		local v21 = p13.PitchMax
		p13.AimPitch = math.clamp(v19, v20, v21)
	end,
	["steered"] = function(p22, p23) -- name: steered
		p22.Steered = p22.Steered + math.max(p23, 0)
	end,
	["setAim"] = function(p24, p25, p26) -- name: setAim
		local v27 = p24.YawMin
		local v28 = p24.YawMax
		p24.AimYaw = math.clamp(p25, v27, v28)
		local v29 = p24.PitchMin
		local v30 = p24.PitchMax
		p24.AimPitch = math.clamp(p26, v29, v30)
	end,
	["place"] = function(p31, p32, p33) -- name: place
		p31.Yaw = p32
		p31.Pitch = p33
	end,
	["straighten"] = function(p34) -- name: straighten
		p34.BendYaw = 0
