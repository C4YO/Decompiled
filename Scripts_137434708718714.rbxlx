		["Kick: knock back, send limbs flying."] = "\224\185\128\224\184\149\224\184\176: \224\184\150\224\184\181\224\184\154\224\185\131\224\184\171\224\185\137\224\184\129\224\184\163\224\184\176\224\185\128\224\184\148\224\185\135\224\184\153 \224\184\170\224\185\136\224\184\135\224\185\129\224\184\130\224\184\153\224\184\130\224\184\178\224\184\155\224\184\165\224\184\180\224\184\167",
		["Dash."] = "\224\184\158\224\184\184\224\185\136\224\184\135",
		["Front view: watch your own draws."] = "\224\184\161\224\184\184\224\184\161\224\184\171\224\184\153\224\185\137\224\184\178: \224\184\148\224\184\185\224\184\151\224\185\136\224\184\178\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154\224\184\130\224\184\173\224\184\135\224\184\149\224\184\177\224\184\167\224\185\128\224\184\173\224\184\135",
		["Bow to who you\'re locked onto: both bow, a 1v1."] = "\224\184\132\224\184\179\224\184\153\224\184\177\224\184\154\224\185\128\224\184\155\224\185\137\224\184\178\224\184\151\224\184\181\224\185\136\224\184\165\224\185\135\224\184\173\224\184\129\224\184\173\224\184\162\224\184\185\224\185\136: \224\184\132\224\184\179\224\184\153\224\184\177\224\184\154\224\184\151\224\184\177\224\185\137\224\184\135\224\184\132\224\184\185\224\185\136 \224\185\128\224\184\163\224\184\180\224\185\136\224\184\161 1v1",
		["Battle music: next track."] = "\224\185\128\224\184\158\224\184\165\224\184\135\224\184\149\224\185\136\224\184\173\224\184\170\224\184\185\224\185\137: \224\185\128\224\184\158\224\184\165\224\184\135\224\184\150\224\184\177\224\184\148\224\185\132\224\184\155",
		["Battle music: the last track."] = "\224\185\128\224\184\158\224\184\165\224\184\135\224\184\149\224\185\136\224\184\173\224\184\170\224\184\185\224\185\137: \224\185\128\224\184\158\224\184\165\224\184\135\224\184\129\224\185\136\224\184\173\224\184\153\224\184\171\224\184\153\224\185\137\224\184\178",
		["In the dojo: skip to the arena."] = "\224\185\131\224\184\153\224\185\130\224\184\148\224\185\130\224\184\136: \224\184\130\224\185\137\224\184\178\224\184\161\224\185\132\224\184\155\224\184\170\224\184\153\224\184\178\224\184\161\224\184\155\224\184\163\224\184\176\224\184\165\224\184\173\224\184\135",
		["Hide the UI for clean shots. Again: show it."] = "\224\184\139\224\185\136\224\184\173\224\184\153 UI \224\185\128\224\184\158\224\184\183\224\185\136\224\184\173\224\184\150\224\185\136\224\184\178\224\184\162\224\184\160\224\184\178\224\184\158\224\185\131\224\184\171\224\185\137\224\184\170\224\184\176\224\184\173\224\184\178\224\184\148\224\184\149\224\184\178 \224\184\129\224\184\148\224\184\173\224\184\181\224\184\129\224\184\132\224\184\163\224\184\177\224\185\137\224\184\135\224\185\128\224\184\158\224\184\183\224\185\136\224\184\173\224\185\129\224\184\170\224\184\148\224\184\135",
		["Shamisen: take it out or put it away."] = "\224\184\139\224\184\178\224\184\161\224\184\180\224\185\128\224\184\139\224\185\135\224\184\153: \224\184\171\224\184\162\224\184\180\224\184\154\224\184\173\224\184\173\224\184\129\224\184\161\224\184\178\224\184\171\224\184\163\224\184\183\224\184\173\224\185\128\224\184\129\224\185\135\224\184\154",
		["left click"] = "\224\185\128\224\184\161\224\184\178\224\184\170\224\185\140\224\184\139\224\185\137\224\184\178\224\184\162",
		["right click"] = "\224\185\128\224\184\161\224\184\178\224\184\170\224\185\140\224\184\130\224\184\167\224\184\178",
		["middle click"] = "\224\185\128\224\184\161\224\184\178\224\184\170\224\185\140\224\184\129\224\184\165\224\184\178\224\184\135",
		["RIGHT SHIFT"] = "SHIFT \224\184\130\224\184\167\224\184\178",
		["RIGHT CTRL"] = "CTRL \224\184\130\224\184\167\224\184\178",
		["RIGHT ALT"] = "ALT \224\184\130\224\184\167\224\184\178",
		["Talk"] = "\224\184\132\224\184\184\224\184\162",
		["TRAVELLING MERCHANT"] = "\224\184\158\224\185\136\224\184\173\224\184\132\224\185\137\224\184\178\224\185\128\224\184\163\224\185\136",
		["Ah, a traveller. You\'ll forgive me if I don\'t get up."] = "\224\184\173\224\185\137\224\184\173 \224\184\153\224\184\177\224\184\129\224\185\128\224\184\148\224\184\180\224\184\153\224\184\151\224\184\178\224\184\135\224\184\153\224\184\181\224\185\136\224\185\128\224\184\173\224\184\135 \224\184\130\224\184\173\224\184\173\224\184\160\224\184\177\224\184\162\224\184\151\224\184\181\224\185\136\224\184\130\224\185\137\224\184\178\224\185\132\224\184\161\224\185\136\224\184\165\224\184\184\224\184\129\224\184\130\224\184\182\224\185\137\224\184\153\224\184\153\224\184\176",
		["Three nights ago my horses caught wind of something up at that temple."] = "\224\184\170\224\184\178\224\184\161\224\184\132\224\184\183\224\184\153\224\184\129\224\185\136\224\184\173\224\184\153 \224\184\161\224\185\137\224\184\178\224\184\130\224\184\173\224\184\135\224\184\130\224\185\137\224\184\178\224\185\132\224\184\148\224\185\137\224\184\129\224\184\165\224\184\180\224\185\136\224\184\153\224\184\173\224\184\176\224\185\132\224\184\163\224\184\154\224\184\178\224\184\135\224\184\173\224\184\162\224\185\136\224\184\178\224\184\135\224\184\136\224\184\178\224\184\129\224\184\167\224\184\177\224\184\148\224\184\154\224\184\153\224\184\153\224\184\177\224\185\137\224\184\153",
		["They screamed, broke their harness and bolted into the trees. I haven\'t seen them since."] = "\224\184\158\224\184\167\224\184\129\224\184\161\224\184\177\224\184\153\224\184\163\224\185\137\224\184\173\224\184\135\224\184\165\224\184\177\224\185\136\224\184\153 \224\184\129\224\184\163\224\184\176\224\184\138\224\184\178\224\184\129\224\184\154\224\184\177\224\184\135\224\185\128\224\184\171\224\184\181\224\184\162\224\184\153\224\184\130\224\184\178\224\184\148 \224\185\129\224\184\165\224\185\137\224\184\167\224\184\167\224\184\180\224\185\136\224\184\135\224\184\171\224\184\153\224\184\181\224\185\128\224\184\130\224\185\137\224\184\178\224\184\155\224\185\136\224\184\178\224\185\132\224\184\155 \224\184\130\224\185\137\224\184\178\224\185\132\224\184\161\224\185\136\224\185\128\224\184\171\224\185\135\224\184\153\224\184\158\224\184\167\224\184\129\224\184\161\224\184\177\224\184\153\224\184\173\224\184\181\224\184\129\224\185\128\224\184\165\224\184\162",
		["So here I am, stranded with a wagon full of wax."] = "\224\184\130\224\185\137\224\184\178\224\185\128\224\184\165\224\184\162\224\184\149\224\184\180\224\184\148\224\184\173\224\184\162\224\184\185\224\185\136\224\184\149\224\184\163\224\184\135\224\184\153\224\184\181\224\185\137 \224\184\129\224\184\177\224\184\154\224\185\128\224\184\129\224\184\167\224\184\181\224\184\162\224\184\153\224\184\151\224\184\181\224\185\136\224\185\128\224\184\149\224\185\135\224\184\161\224\185\132\224\184\155\224\184\148\224\185\137\224\184\167\224\184\162\224\184\130\224\184\181\224\185\137\224\184\156\224\184\182\224\185\137\224\184\135",
		["There\'s something wrong with that temple, I\'d stay away if I were you, especially at night."] = "\224\184\167\224\184\177\224\184\148\224\184\153\224\184\177\224\185\137\224\184\153\224\184\161\224\184\181\224\184\173\224\184\176\224\185\132\224\184\163\224\184\156\224\184\180\224\184\148\224\184\155\224\184\129\224\184\149\224\184\180 \224\184\150\224\185\137\224\184\178\224\184\130\224\185\137\224\184\178\224\185\128\224\184\155\224\185\135\224\184\153\224\185\128\224\184\136\224\185\137\224\184\178 \224\184\130\224\185\137\224\184\178\224\184\136\224\184\176\224\184\173\224\184\162\224\184\185\224\185\136\224\185\131\224\184\171\224\185\137\224\184\171\224\185\136\224\184\178\224\184\135 \224\185\130\224\184\148\224\184\162\224\185\128\224\184\137\224\184\158\224\184\178\224\184\176\224\184\149\224\184\173\224\184\153\224\184\129\224\184\165\224\184\178\224\184\135\224\184\132\224\184\183\224\184\153",
		["Here, take some wax. It might be useful to give your blade some extra shine. Be careful around a flame though, this stuff can catch alight in the blink of an eye!"] = "\224\184\153\224\184\181\224\185\136 \224\185\128\224\184\173\224\184\178\224\184\130\224\184\181\224\185\137\224\184\156\224\184\182\224\185\137\224\184\135\224\185\132\224\184\155\224\184\171\224\184\153\224\185\136\224\184\173\224\184\162 \224\184\161\224\184\177\224\184\153\224\184\173\224\184\178\224\184\136\224\184\138\224\185\136\224\184\167\224\184\162\224\185\131\224\184\171\224\185\137\224\184\148\224\184\178\224\184\154\224\184\130\224\184\173\224\184\135\224\185\128\224\184\136\224\185\137\224\184\178\224\185\128\224\184\135\224\184\178\224\184\135\224\184\178\224\184\161\224\184\130\224\184\182\224\185\137\224\184\153 \224\185\129\224\184\149\224\185\136\224\184\163\224\184\176\224\184\167\224\184\177\224\184\135\224\185\128\224\184\167\224\184\165\224\184\178\224\184\173\224\184\162\224\184\185\224\185\136\224\185\131\224\184\129\224\184\165\224\185\137\224\185\132\224\184\159\224\184\148\224\185\137\224\184\167\224\184\162\224\184\165\224\185\136\224\184\176 \224\184\130\224\184\173\224\184\135\224\184\153\224\184\181\224\185\136\224\184\149\224\184\180\224\184\148\224\185\132\224\184\159\224\185\132\224\184\148\224\185\137\224\185\131\224\184\153\224\184\158\224\184\163\224\184\180\224\184\154\224\184\149\224\184\178\224\185\128\224\184\148\224\184\181\224\184\162\224\184\167!",
		["Still here? So am I."] = "\224\184\162\224\184\177\224\184\135\224\184\173\224\184\162\224\184\185\224\185\136\224\184\173\224\184\181\224\184\129\224\184\171\224\184\163\224\184\183\224\184\173 \224\184\130\224\185\137\224\184\178\224\184\129\224\185\135\224\185\128\224\184\171\224\184\161\224\184\183\224\184\173\224\184\153\224\184\129\224\184\177\224\184\153",
		["And keep away from that temple at night."] = "\224\185\129\224\184\165\224\184\176\224\184\173\224\184\162\224\185\136\224\184\178\224\185\128\224\184\130\224\185\137\224\184\178\224\185\131\224\184\129\224\184\165\224\185\137\224\184\167\224\184\177\224\184\148\224\184\153\224\184\177\224\185\137\224\184\153\224\184\149\224\184\173\224\184\153\224\184\129\224\184\165\224\184\178\224\184\135\224\184\132\224\184\183\224\184\153",
		["KATANA: SINGLE"] = "\224\184\132\224\184\178\224\184\149\224\184\178\224\184\153\224\184\176: \224\184\148\224\184\178\224\184\154\224\185\128\224\184\148\224\184\181\224\185\136\224\184\162\224\184\167",
		["One katana at the left hip."] = "\224\184\132\224\184\178\224\184\149\224\184\178\224\184\153\224\184\176\224\184\171\224\184\153\224\184\182\224\185\136\224\184\135\224\185\128\224\184\165\224\185\136\224\184\161\224\184\151\224\184\181\224\185\136\224\184\170\224\184\176\224\185\130\224\184\158\224\184\129\224\184\139\224\185\137\224\184\178\224\184\162",
		["A katana at each hip, drawn together, one in each hand."] = "\224\184\132\224\184\178\224\184\149\224\184\178\224\184\153\224\184\176\224\184\151\224\184\181\224\185\136\224\184\170\224\184\176\224\185\130\224\184\158\224\184\129\224\184\151\224\184\177\224\185\137\224\184\135\224\184\170\224\184\173\224\184\135\224\184\130\224\185\137\224\184\178\224\184\135 \224\184\138\224\184\177\224\184\129\224\184\158\224\184\163\224\185\137\224\184\173\224\184\161\224\184\129\224\184\177\224\184\153 \224\184\161\224\184\183\224\184\173\224\184\165\224\184\176\224\185\128\224\184\165\224\185\136\224\184\161",
		["A katana at each hip, one in each hand."] = "\224\184\132\224\184\178\224\184\149\224\184\178\224\184\153\224\184\176\224\184\151\224\184\181\224\185\136\224\184\170\224\184\176\224\185\130\224\184\158\224\184\129\224\184\151\224\184\177\224\185\137\224\184\135\224\184\170\224\184\173\224\184\135\224\184\130\224\185\137\224\184\178\224\184\135 \224\184\161\224\184\183\224\184\173\224\184\165\224\184\176\224\185\128\224\184\165\224\185\136\224\184\161",
		["KATANA: IAI"] = "\224\184\132\224\184\178\224\184\149\224\184\178\224\184\153\224\184\176: \224\184\173\224\184\180\224\185\132\224\184\173",
		["Draw-cuts only. High risk, high reward: cuts through blades, but a miss can be parried. Longer dash, faster draw. On a kill: poise back and a faster sheathe."] = "\224\184\159\224\184\177\224\184\153\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154\224\185\128\224\184\151\224\185\136\224\184\178\224\184\153\224\184\177\224\185\137\224\184\153 \224\185\128\224\184\170\224\184\181\224\185\136\224\184\162\224\184\135\224\184\170\224\184\185\224\184\135 \224\185\132\224\184\148\224\185\137\224\184\161\224\184\178\224\184\129: \224\184\151\224\184\176\224\184\165\224\184\167\224\184\135\224\184\156\224\185\136\224\184\178\224\184\153\224\184\148\224\184\178\224\184\154 \224\185\129\224\184\149\224\185\136\224\184\150\224\185\137\224\184\178\224\184\158\224\184\165\224\184\178\224\184\148\224\184\173\224\184\178\224\184\136\224\184\150\224\184\185\224\184\129\224\184\155\224\184\177\224\184\148\224\184\155\224\185\137\224\184\173\224\184\135 \224\184\158\224\184\184\224\185\136\224\184\135\224\185\132\224\184\129\224\184\165\224\184\130\224\184\182\224\185\137\224\184\153 \224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154\224\185\128\224\184\163\224\185\135\224\184\167\224\184\130\224\184\182\224\185\137\224\184\153 \224\185\128\224\184\161\224\184\183\224\185\136\224\184\173\224\184\170\224\184\177\224\184\135\224\184\171\224\184\178\224\184\163: \224\185\132\224\184\148\224\185\137\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\184\132\224\184\183\224\184\153\224\185\129\224\184\165\224\184\176\224\185\128\224\184\129\224\185\135\224\184\154\224\184\148\224\184\178\224\184\154\224\185\128\224\184\163\224\185\135\224\184\167\224\184\130\224\184\182\224\185\137\224\184\153",
		["The older, longer sword, slung edge down at your hip. Slower and heavier than the katana: its hits take more poise and bleed more."] = "\224\184\148\224\184\178\224\184\154\224\184\151\224\184\181\224\185\136\224\185\128\224\184\129\224\185\136\224\184\178\224\185\129\224\184\129\224\185\136\224\185\129\224\184\165\224\184\176\224\184\162\224\184\178\224\184\167\224\184\129\224\184\167\224\185\136\224\184\178 \224\184\171\224\185\137\224\184\173\224\184\162\224\185\132\224\184\167\224\185\137\224\184\151\224\184\181\224\185\136\224\184\170\224\184\176\224\185\130\224\184\158\224\184\129\224\185\130\224\184\148\224\184\162\224\184\171\224\184\177\224\184\153\224\184\132\224\184\161\224\184\165\224\184\135 \224\184\138\224\185\137\224\184\178\224\185\129\224\184\165\224\184\176\224\184\171\224\184\153\224\184\177\224\184\129\224\184\129\224\184\167\224\185\136\224\184\178\224\184\132\224\184\178\224\184\149\224\184\178\224\184\153\224\184\176: \224\184\129\224\184\178\224\184\163\224\185\130\224\184\136\224\184\161\224\184\149\224\184\181\224\184\165\224\184\148\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\184\161\224\184\178\224\184\129\224\184\129\224\184\167\224\185\136\224\184\178\224\185\129\224\184\165\224\184\176\224\184\151\224\184\179\224\185\131\224\184\171\224\185\137\224\185\128\224\184\165\224\184\183\224\184\173\224\184\148\224\184\173\224\184\173\224\184\129\224\184\161\224\184\178\224\184\129\224\184\129\224\184\167\224\185\136\224\184\178",
		["Longer and heavier than the katana: slower, but its hits take more poise and bleed more."] = "\224\184\162\224\184\178\224\184\167\224\185\129\224\184\165\224\184\176\224\184\171\224\184\153\224\184\177\224\184\129\224\184\129\224\184\167\224\185\136\224\184\178\224\184\132\224\184\178\224\184\149\224\184\178\224\184\153\224\184\176: \224\184\138\224\185\137\224\184\178\224\184\129\224\184\167\224\185\136\224\184\178 \224\185\129\224\184\149\224\185\136\224\184\129\224\184\178\224\184\163\224\185\130\224\184\136\224\184\161\224\184\149\224\184\181\224\184\165\224\184\148\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\184\161\224\184\178\224\184\129\224\184\129\224\184\167\224\185\136\224\184\178\224\185\129\224\184\165\224\184\176\224\184\151\224\184\179\224\185\131\224\184\171\224\185\137\224\185\128\224\184\165\224\184\183\224\184\173\224\184\148\224\184\173\224\184\173\224\184\129\224\184\161\224\184\178\224\184\129\224\184\129\224\184\167\224\185\136\224\184\178",
