		["Use a mouse, not a trackpad. To change mouse speed: **{Menu}** \226\134\146 Settings \226\134\146 Mouse Sensitivity."] = "\237\138\184\235\158\153\237\140\168\235\147\156 \235\167\144\234\179\160 \235\167\136\236\154\176\236\138\164\235\165\188 \236\147\176\236\132\184\236\154\148. \235\167\136\236\154\176\236\138\164 \236\134\141\235\143\132\235\165\188 \235\176\148\234\190\184\235\160\164\235\169\180: **{Menu}** \226\134\146 \236\132\164\236\160\149 \226\134\146 \235\167\136\236\154\176\236\138\164 \234\176\144\235\143\132.",
		["Steer with the right thumb. To change steering speed: **MENU** \226\134\146 Settings \226\134\146 Touch Sensitivity."] = "\236\152\164\235\165\184\236\134\144 \236\151\132\236\167\128\235\161\156 \236\161\176\236\162\133\237\149\152\236\132\184\236\154\148. \236\161\176\236\162\133 \236\134\141\235\143\132\235\165\188 \235\176\148\234\190\184\235\160\164\235\169\180: **\235\169\148\235\137\180** \226\134\146 \236\132\164\236\160\149 \226\134\146 \237\132\176\236\185\152 \234\176\144\235\143\132.",
		["**Staggered**: the blade is knocked loose for a moment. Then tap **WIPE**."] = "**\234\178\189\236\167\129**: \236\158\160\236\139\156 \236\185\188\236\157\180 \237\138\149\234\178\168 \235\130\152\234\176\128\236\154\148. \234\183\184\235\139\164\236\157\140 **\235\139\166\234\184\176**\235\165\188 \237\131\173\237\149\152\236\132\184\236\154\148.",
		["**Staggered**: the blade is knocked loose for a moment. Then press **{Wipe}**."] = "**\234\178\189\236\167\129**: \236\158\160\236\139\156 \236\185\188\236\157\180 \237\138\149\234\178\168 \235\130\152\234\176\128\236\154\148. \234\183\184\235\139\164\236\157\140 **{Wipe}** \237\130\164\235\165\188 \235\136\132\235\165\180\236\132\184\236\154\148.",
		["Tap **SHEATHE** to put the blade away first."] = "\235\168\188\236\160\128 **\235\130\169\235\143\132**\235\165\188 \237\131\173\237\149\180 \236\185\188\236\157\132 \235\132\163\236\156\188\236\132\184\236\154\148.",
		["Press **{Equip}** to sheathe the blade first."] = "\235\168\188\236\160\128 **{Equip}** \237\130\164\235\165\188 \235\136\140\235\159\172 \235\130\169\235\143\132\237\149\152\236\132\184\236\154\148.",
		["Press **{Lock}** to lock on."] = "**{Lock}** \237\130\164\235\165\188 \235\136\140\235\159\172 \235\157\189\236\152\168\237\149\152\236\132\184\236\154\148.",
		["Blade sheathed. **Flick right** to draw it."] = "\236\185\188\236\157\180 \236\185\188\236\167\145\236\151\144 \236\158\136\236\150\180\236\154\148. **\236\152\164\235\165\184\236\170\189\236\156\188\235\161\156 \237\148\140\235\166\173**\237\149\180 \235\176\156\235\143\132\237\149\152\236\132\184\236\154\148.",
		["Blade sheathed. Tap **EQUIP**, then **flick right** to draw it."] = "\236\185\188\236\157\180 \236\185\188\236\167\145\236\151\144 \236\158\136\236\150\180\236\154\148. **\236\158\165\236\176\169**\236\157\132 \237\131\173\237\149\156 \235\146\164 **\236\152\164\235\165\184\236\170\189\236\156\188\235\161\156 \237\148\140\235\166\173**\237\149\180 \235\176\156\235\143\132\237\149\152\236\132\184\236\154\148.",
		["Blade sheathed. Press **{CalmDraw}** to draw it, or **hold {Draw}** and **swipe**."] = "\236\185\188\236\157\180 \236\185\188\236\167\145\236\151\144 \236\158\136\236\150\180\236\154\148. **{CalmDraw}** \237\130\164\235\161\156 \235\176\156\235\143\132\237\149\152\234\177\176\235\130\152, **{Draw} \235\136\132\235\165\184 \236\177\132** **\236\138\164\236\153\128\236\157\180\237\148\132**\237\149\152\236\132\184\236\154\148.",
