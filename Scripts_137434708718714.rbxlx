		["Rare"] = "\208\160\208\181\208\180\208\186\208\184\208\185",
		["Epic"] = "\208\173\208\191\208\184\209\135\208\181\209\129\208\186\208\184\208\185",
		["Legendary"] = "\208\155\208\181\208\179\208\181\208\189\208\180\208\176\209\128\208\189\209\139\208\185",
		["Mythic"] = "\208\156\208\184\209\132\208\184\209\135\208\181\209\129\208\186\208\184\208\185",
		["Exotic"] = "\208\173\208\186\208\183\208\190\209\130\208\184\209\135\208\181\209\129\208\186\208\184\208\185",
		["walk speed"] = "\209\129\208\186\208\190\209\128\208\190\209\129\209\130\209\140 \209\133\208\190\208\180\209\140\208\177\209\139",
		["poise recovery"] = "\208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\190\208\178\208\187\208\181\208\189\208\184\208\181 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184",
		["poise toughness"] = "\208\191\209\128\208\190\209\135\208\189\208\190\209\129\209\130\209\140 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184",
		["slower bleeding"] = "\208\183\208\176\208\188\208\181\208\180\208\187\208\181\208\189\208\184\208\181 \208\186\209\128\208\190\208\178\208\190\209\130\208\181\209\135\208\181\208\189\208\184\209\143",
		["faster dash recharge"] = "\209\131\209\129\208\186\208\190\209\128\208\181\208\189\208\184\208\181 \208\191\208\181\209\128\208\181\208\183\208\176\209\128\209\143\208\180\208\186\208\184 \209\128\209\139\208\178\208\186\208\176",
		["BALD"] = "\208\155\208\171\208\161\208\152\208\157\208\144",
		["SWEPT"] = "\208\151\208\144\208\167\208\129\208\161",
		["TOPKNOT"] = "\208\159\208\163\208\167\208\158\208\154",
		["MESSY"] = "\208\146\208\152\208\165\208\160\208\171",
