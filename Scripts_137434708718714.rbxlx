		["the next rank"] = "\235\139\164\236\157\140 \235\147\177\234\184\137",
		["Forging for rank {rank}: {name}.  The pommel, the wrap, the handle, then the guard"] = "\235\147\177\234\184\137 {rank} \235\139\168\236\161\176 \236\164\145: {name}.  \236\158\144\235\163\168 \235\168\184\235\166\172, \236\134\144\236\158\161\236\157\180 \235\129\136, \236\134\144\236\158\161\236\157\180, \235\167\136\236\167\128\235\167\137\236\156\188\235\161\156 \236\189\148\235\147\177\236\157\180",
