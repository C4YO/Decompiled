		["WIDE LEFT SHOULDER"] = "HOMBRO IZQUIERDO ABIERTO",
		["ABOVE HEAD"] = "SOBRE LA CABEZA",
		["BEHIND"] = "DETR\195\129S",
		["FAR BEHIND"] = "MUY DETR\195\129S",
		["CUSTOM 1"] = "PERSONAL 1",
