		["No upgrades"] = "\231\132\161\229\188\183\229\140\150",
		["Old bandages, a plain brown sheath."] = "\233\153\179\232\136\138\231\186\143\229\184\131\227\128\129\230\168\184\231\180\160\231\154\132\230\163\149\232\137\178\229\136\128\233\158\152\227\128\130",
