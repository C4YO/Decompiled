		["That was a swing"] = true,
		["move the mouse **left**, then **hold {Draw}** and **swipe right**"] = true,
		["move the mouse **up**, then **hold {Draw}** and **swipe down**"] = true,
		["draw again"] = true,
		["**flick right** on the right side of the screen"] = true,
		["**flick down** on the right side of the screen"] = true,
		["Rusted, the cord rotten"] = true,
		["Rust polished away"] = true,
		["Black silk on the handle and cords"] = true,
		["Bright silver fittings"] = true,
		["Black lacquered sheath"] = true,
		["Temper line polished, purple silk"] = true
	}
}
return v1]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX152">
            <Properties>
              <string name="Name">French</string>
              <ProtectedString name="Source"><![CDATA[local v1 = {
	["Name"] = "Fran\195\167ais",
	["Locales"] = nil,
	["Lines"] = nil,
	["Locales"] = { "fr-fr", "fr" },
	["Lines"] = {
		["1 free rename spin"] = "1 tirage de nom gratuit",
		["{count} free rename spins"] = "{count} tirages de nom gratuits",
		["{xp} XP"] = "{xp} XP",
		["{scale}x XP for {minutes} minutes"] = "{scale}x XP pendant {minutes} minutes",
		["OPENED"] = "OUVERTE",
		["MISSED"] = "MANQU\195\137E",
		["A door opens each day from 1 to 25 December while playing. Missed doors stay shut."] = "Une porte s\'ouvre chaque jour du 1er au 25 d\195\169cembre en jouant. Les portes manqu\195\169es restent ferm\195\169es.",
		["BACK"] = "RETOUR",
		["AIM DOT"] = "POINT DE VIS\195\137E",
		["COLOUR"] = "COULEUR",
		["OUTLINE"] = "CONTOUR",
		["DOT"] = "POINT",
		["BRIGHTNESS"] = "LUMINOSIT\195\137",
		["CUSTOM"] = "PERSO",
		["DEFAULT"] = "PAR D\195\137FAUT",
		["ON"] = "OUI",
		["OFF"] = "NON",
		["Your blade is alight: {hits} hits."] = "Ta lame est en feu : {hits} coups.",
		["Your blade\'s flame is out: wipe it again, then light it."] = "La flamme de ta lame s\'est \195\169teinte : essuie-la \195\160 nouveau, puis rallume-la.",
		["Your blade is waxed: hold it in a fire stand\'s flame."] = "Ta lame est cir\195\169e : tiens-la dans la flamme d\'un brasero.",
		["{count} / {goal}"] = "{count} / {goal}",
		["The mist seals the way out: defeat the boss, or fall."] = "La brume scelle la sortie\194\160: bats le boss, ou tombe.",
		["The seal is broken: the way out is open."] = "Le sceau est bris\195\169\194\160: la sortie est ouverte.",
		["LOCAL"] = "LOCAL",
		["DM"] = "MP",
		["GLOBAL"] = "GLOBAL",
		["SHOW"] = "AFFICHER",
		["HIDE"] = "MASQUER",
		["Sending too fast. Wait a moment."] = "Envoi trop rapide. Attends un instant.",
		["Message not sent."] = "Message non envoy\195\169.",
		["Can\'t message this player."] = "Impossible d\'\195\169crire \195\160 ce joueur.",
		["Type a message"] = "\195\137cris un message",
		["{key}   chat"] = "{key}   chat",
		["No other players in this server."] = "Aucun autre joueur sur ce serveur.",
		["Type a code and press REDEEM. Each code works once."] = "Entre un code et appuie sur UTILISER. Chaque code ne marche qu\'une fois.",
		["ENTER CODE"] = "ENTRE LE CODE",
		["Type a code first."] = "Entre d\'abord un code.",
		["Checking..."] = "V\195\169rification...",
		["No answer from the server. Try again."] = "Le serveur ne r\195\169pond pas. R\195\169essaie.",
		["Redeemed: {reward}"] = "Code utilis\195\169 : {reward}",
		["REDEEM"] = "UTILISER",
		["YES"] = "OUI",
		["NO"] = "NON",
		["CHARACTER"] = "PERSONNAGE",
		["APPEARANCE"] = "APPARENCE",
		["HAIR AND OUTFIT"] = "CHEVEUX ET TENUE",
		["NAME"] = "NOM",
		["LOADOUT"] = "ARSENAL",
		["Pick a first name or spin a new family name ({count} spin)."] = "Choisis un pr\195\169nom ou tire un nouveau nom de famille ({count} tirage).",
		["Pick a first name or spin a new family name ({count} spins)."] = "Choisis un pr\195\169nom ou tire un nouveau nom de famille ({count} tirages).",
		["Spin a new family name ({count} spin)."] = "Tire un nouveau nom de famille ({count} tirage).",
		["Spin a new family name ({count} spins)."] = "Tire un nouveau nom de famille ({count} tirages).",
		["CUSTOMISE APPEARANCE"] = "MODIFIER L\'APPARENCE",
		["Hair, outfit, accessory, face, skins, effects and colours."] = "Cheveux, tenue, accessoire, visage, skins, effets et couleurs.",
		["CUSTOMISE NAME"] = "MODIFIER LE NOM",
		["Select draw style or change weapon."] = "Choisir un style de d\195\169gainage ou changer d\'arme.",
		["SKIP ANIMATION"] = "PASSER L\'ANIMATION",
		["ROLL ALL"] = "TOUT TIRER",
		["SPIN AGAIN \194\183 {count}"] = "RELANCER \194\183 {count}",
		["SPIN FAMILY NAME \194\183 {count}"] = "TIRER UN NOM \194\183 {count}",
		["NEW FAMILY NAME"] = "NOUVEAU NOM DE FAMILLE",
		["KEEP {name}"] = "GARDER {name}",
		["No rename spins left: {count} each level up, and more in the SHOP."] = "Plus de tirages de nom : {count} \195\160 chaque niveau, et d\'autres \195\160 la BOUTIQUE.",
		["No rename spins left: {count} each level up."] = "Plus de tirages de nom : {count} \195\160 chaque niveau.",
		["Spin again?"] = "Relancer ?",
		["Couldn\'t spin. Try again."] = "Tirage impossible. R\195\169essaie.",
		["Keep {name}?"] = "Garder {name} ?",
		["Couldn\'t choose. Try again."] = "Choix impossible. R\195\169essaie.",
		["SPIN x{count}"] = "TIRER x{count}",
		["TEN NEW FAMILY NAMES"] = "DIX NOUVEAUX NOMS DE FAMILLE",
		["SPIN x10 needs {need} rename spins. Spins: {have}."] = "TIRER x10 demande {need} tirages de nom. Tirages : {have}.",
		["Spin x{count}?"] = "Tirer x{count} ?",
		["BEST OF {count} ROLLS"] = "LE MEILLEUR DE {count} TIRAGES",
		["Use all {count} spins?"] = "Utiliser les {count} tirages ?",
		["Every name rolled is listed once, best first."] = "Chaque nom obtenu est list\195\169 une fois, les meilleurs d\'abord.",
		["EVENT"] = "EVENT",
		["LIMITED"] = "LIMIT\195\137",
		["ROBUX"] = "ROBUX",
		["QUEST"] = "QU\195\138TE",
		["PATH"] = "VOIE",
		["DROP"] = "BUTIN",
		["SOON"] = "BIENT\195\148T",
		["CODE"] = "CODE",
		["ADVENT"] = "AVENT",
		["LV {level}"] = "NIV. {level}",
		["HAIR"] = "CHEVEUX",
		["HAIR COLOUR"] = "COULEUR DES CHEVEUX",
		["OUTFIT"] = "TENUE",
		["ACCESSORY"] = "ACCESSOIRE",
		["ACCESSORY COLOUR"] = "COULEUR DE L\'ACCESSOIRE",
		["FACE"] = "VISAGE",
		["SWORD"] = "SABRE",
		["BLOOD"] = "SANG",
		["EFFECT"] = "EFFET",
		["DRAW STYLES"] = "STYLES DE D\195\137GAINAGE",
		["RIGHT KATANA"] = "KATANA DROIT",
		["LEFT KATANA"] = "KATANA GAUCHE",
		["KATANA: DUAL"] = "KATANA : DOUBLE",
		["BODY COLOURS: BELOW"] = "COULEURS DU CORPS\194\160: EN BAS",
		["BODY COLOURS"] = "COULEURS DU CORPS",
		["CLOSE"] = "FERMER",
		["WEAPON SKIN"] = "SKIN D\'ARME",
		["BLOOD SKIN"] = "SKIN DE SANG",
		["WEAPON EFFECT"] = "EFFET D\'ARME",
		["{item}   \194\183   {kind}"] = "{item}   \194\183   {kind}",
		["Owned and equipped."] = "Poss\195\169d\195\169 et \195\169quip\195\169.",
		["{chance}% chance to drop from the {boss}."] = "{chance}\194\160% de chances que le {boss} le l\195\162che.",
		["Only from a code (CODES, in the menu)."] = "Seulement via un code (CODES, dans le menu).",
		["Only from the advent calendar, day {day}."] = "Uniquement dans le calendrier de l\'Avent, jour {day}.",
		["Needs the Shamisen pass."] = "N\195\169cessite le pass Shamisen.",
		["Only from the {quest} (QUESTS, in the menu)."] = "Seulement via la {quest} (QU\195\138TES, dans le menu).",
		["Only from the quests (QUESTS, in the menu)."] = "Seulement via les qu\195\170tes (QU\195\138TES, dans le menu).",
		["Not obtainable yet."] = "Impossible \195\160 obtenir pour l\'instant.",
		["{chance}% chance to drop from {rarity} and higher rarity bots."] = "{chance} % de chances qu\'il tombe des bots {rarity} ou de raret\195\169 sup\195\169rieure.",
		["Finish chapter {chapter} of the Path of the Sword, {name} (QUESTS, in the menu)."] = "Termine le chapitre {chapter} de la Voie du Sabre, {name} (QU\195\138TES, dans le menu).",
		["Only from the Path of the Sword (QUESTS, in the menu)."] = "Seulement via la Voie du Sabre (QU\195\138TES, dans le menu).",
		["Limited: no longer in the shop."] = "Limit\195\169\194\160: plus en boutique.",
		["Limited: only in the shop until {date}."] = "Limit\195\169\194\160: en boutique jusqu\'au {date}.",
		["Limited: only in the shop for a while."] = "Limit\195\169\194\160: en boutique pour un temps.",
		["Only sold for Robux."] = "Vendu uniquement contre des Robux.",
		["Available to buy."] = "En vente.",
		["Available to buy with ry\197\141 from level {level}, or with Robux now."] = "En vente contre des ry\197\141 d\195\168s le niveau {level}, ou contre des Robux d\195\168s maintenant.",
		["Available to buy from level {level}."] = "En vente d\195\168s le niveau {level}.",
		["BUY {price}"] = "ACHETER {price}",
		["NOT ON SALE"] = "PAS EN VENTE",
		["WEAPON"] = "ARME",
		["DRAW STYLE"] = "STYLE DE D\195\137GAINAGE",
		["{short} Owned: equipped from the next spawn."] = "{short} Poss\195\169d\195\169 : \195\169quip\195\169 d\195\168s la prochaine apparition.",
		["{short} Permanent unlock."] = "{short} D\195\169blocage permanent.",
		["{short} Only sold for Robux. Permanent unlock."] = "{short} Vendu uniquement contre des Robux. D\195\169blocage permanent.",
		["Not enough ry\197\141: {amount} more to go."] = "Pas assez de ry\197\141\194\160: il t\'en manque {amount}.",
		["Buy {name}?"] = "Acheter {name}\194\160?",
		["Price: {price}. Balance: {have}."] = "Prix : {price}. Solde : {have}.",
		["Buying..."] = "Achat...",
		["DONE"] = "TERMIN\195\137",
		["Keep one of the names first."] = "Garde d\'abord l\'un des noms.",
		["SAVING"] = "SAUVEGARDE",
		["Couldn\'t save. Try again."] = "Sauvegarde impossible. R\195\169essaie.",
		["DAILY REWARD"] = "R\195\137COMPENSE DU JOUR",
		["+1 free rename spin"] = "+1 tirage de nom gratuit",
		["+{count} free rename spins"] = "+{count} tirages de nom gratuits",
		["Day {day} in a row: {spins} spins a day."] = "Jour {day} d\'affil\195\169e\194\160: {spins} tirages par jour.",
		["Day {day} in a row. From day {from} you get {spins} a day."] = "Jour {day} d\'affil\195\169e. D\195\168s le jour {from}, tu en re\195\167ois {spins} par jour.",
		["MERRY CHRISTMAS"] = "JOYEUX NO\195\139L",
		["A gift for playing on Christmas Day."] = "Un cadeau pour avoir jou\195\169 le jour de No\195\171l.",
		["DAILY BONUS"] = "BONUS DU JOUR",
		["+{xp} XP"] = "+{xp} XP",
		["All daily quests done"] = "Qu\195\170tes du jour termin\195\169es",
		["ADVENT CALENDAR"] = "CALENDRIER DE L\'AVENT",
		["Day {day} of 25"] = "Jour {day} sur 25",
		["no boost"] = "aucun bonus",
		["{count} boost: +{walk} walk speed or +{other} to another stat"] = "{count} bonus : +{walk} de vitesse de marche ou +{other} \195\160 une autre statistique",
		["{count} boosts, each +{walk} walk speed or +{other} to another stat"] = "{count} bonus, chacun : +{walk} de vitesse de marche ou +{other} \195\160 une autre statistique",
		["Safe zone: combat forbidden"] = "Zone s\195\187re : combat interdit",
		["Names and boosts"] = "Noms et bonus",
		["<b>Family name</b>: rolled once, at the forge.\n<b>First name</b>: reroll any time on the character screen (CHARACTER, on the title screen).\n\nRarer family names give stat boosts. Boosts are kept small, so fights are still won with the blade."] = "<b>Nom de famille</b> : tir\195\169 une seule fois, \195\160 la forge.\n<b>Pr\195\169nom</b> : peut \195\170tre relanc\195\169 \195\160 tout moment sur l\'\195\169cran du personnage (PERSONNAGE, sur l\'\195\169cran titre).\n\nLes noms de famille plus rares donnent des bonus de statistiques. Les bonus restent petits, pour que les combats se gagnent toujours \195\160 la lame.",
		["Rarity, odds and boosts:\n\n{rarities}\n\nThe rarest names belong to famous swordsmen and warlords. A Mythic name is a legend\'s own name, used in place of a family name. An Exotic name is a god\'s. Every spin is pure chance at these odds."] = "Raret\195\169, probabilit\195\169s et bonus :\n\n{rarities}\n\nLes noms les plus rares appartiennent \195\160 de c\195\169l\195\168bres sabreurs et seigneurs de guerre. Un nom Mythique est le nom m\195\170me d\'une l\195\169gende, utilis\195\169 \195\160 la place d\'un nom de famille. Un nom Exotique est celui d\'un dieu. Chaque tirage rel\195\168ve du pur hasard, selon ces probabilit\195\169s.",
		["Boosts:\n\n<b>Walk speed</b>: faster movement.\n<b>Poise recovery</b>: poise refills faster.\n<b>Poise toughness</b>: all poise costs are lower.\n<b>Slower bleeding</b>: wounds and stumps bleed slower.\n<b>Faster dash recharge</b>: dash charges refill sooner.\n\nBoosts stack with forge upgrades."] = "Bonus :\n\n<b>Vitesse de marche</b> : d\195\169placement plus rapide.\n<b>R\195\169cup\195\169ration d\'\195\169quilibre</b> : l\'\195\169quilibre se recharge plus vite.\n<b>R\195\169sistance d\'\195\169quilibre</b> : tous les co\195\187ts d\'\195\169quilibre sont r\195\169duits.\n<b>Saignement ralenti</b> : les blessures et les moignons saignent moins vite.\n<b>Recharge de ru\195\169e rapide</b> : les charges de ru\195\169e se rechargent plus t\195\180t.\n\nLes bonus se cumulent avec les am\195\169liorations de la forge.",
		["<b>Rename spins</b> reroll the family name. Get {spins} free spins every level, or buy more in the SHOP. Use them on the character screen. The old name can always be kept.\n\nBots have names too. The rarer a bot\'s name, the better it fights."] = "Les <b>tirages de nom</b> relancent le nom de famille. Obtiens {spins} tirages gratuits \195\160 chaque niveau, ou ach\195\168tes-en d\'autres \195\160 la BOUTIQUE. Utilise-les sur l\'\195\169cran du personnage. L\'ancien nom peut toujours \195\170tre conserv\195\169.\n\nLes bots ont aussi des noms. Plus le nom d\'un bot est rare, mieux il se bat.",
		["Poise"] = "\195\137quilibre",
		["<b>Poise</b> is a fighter\'s steadiness. The poise bar is the thin bar above the blood squares; an opponent\'s is under their name. It grows from the middle as poise is lost, turning from gold to red, and hides at full poise."] = "L\'<b>\195\169quilibre</b> est la stabilit\195\169 d\'un combattant. La barre d\'\195\169quilibre est la fine barre au-dessus des carr\195\169s de sang ; celle d\'un adversaire est sous son nom. Elle grandit depuis le milieu \195\160 mesure que l\'\195\169quilibre baisse, passe de l\'or au rouge, et dispara\195\174t quand l\'\195\169quilibre est plein.",
		["Poise costs:\n\n<b>Draw-cut</b>: {draw}.  <b>Blade hit by a draw-cut</b>: {block}.\n<b>Hard swing</b>: {swing}.  <b>Dash</b>: {dash}.  <b>Kick</b>: {kick}.\n<b>Taking a cut</b>: {wound} (double from a draw-cut), plus blood loss.\n<b>Clashes</b>: more the harder the blade is knocked."] = "Co\195\187ts d\'\195\169quilibre :\n\n<b>Coupe au d\195\169gainage</b> : {draw}.  <b>Lame frapp\195\169e par une coupe au d\195\169gainage</b> : {block}.\n<b>Coup puissant</b> : {swing}.  <b>Ru\195\169e</b> : {dash}.  <b>Coup de pied</b> : {kick}.\n<b>Subir une coupe</b> : {wound} (le double pour une coupe au d\195\169gainage), plus la perte de sang.\n<b>Chocs</b> : d\'autant plus que la lame est frapp\195\169e fort.",
		["Poise refills after {delay} seconds with no poise lost, at {regen} per second. A still guard (L2 on a gamepad) refills it faster; low blood refills it slower.\n\nBelow half poise, blade and movement speed drop, and the blade is knocked aside more easily."] = "L\'\195\169quilibre se recharge apr\195\168s {delay} secondes sans perte d\'\195\169quilibre, \195\160 {regen} par seconde. Une garde immobile (L2 sur une manette) le recharge plus vite ; avec peu de sang, il se recharge moins vite.\n\nSous la moiti\195\169 de l\'\195\169quilibre, la vitesse de la lame et celle des d\195\169placements baissent, et la lame est \195\169cart\195\169e plus facilement.",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> ({Wipe}). See the next scroll."] = "\195\128 z\195\169ro, l\'\195\169quilibre se <b>brise</b> : \195\169tourdi pendant {stagger} secondes, puis affaibli pendant {weakened} secondes ({slower} plus lent, essouffl\195\169, les bords de l\'\195\169cran qui s\'assombrissent). L\'\195\169quilibre se recharge ensuite jusqu\'\195\160 la moiti\195\169.\n\nLe moyen le plus rapide de retrouver tout l\'\195\169quilibre est d\'<b>essuyer la lame</b> ({Wipe}). Consulte le rouleau suivant.",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> (WIPE). See the next scroll."] = "\195\128 z\195\169ro, l\'\195\169quilibre se <b>brise</b> : \195\169tourdi pendant {stagger} secondes, puis affaibli pendant {weakened} secondes ({slower} plus lent, essouffl\195\169, les bords de l\'\195\169cran qui s\'assombrissent). L\'\195\169quilibre se recharge ensuite jusqu\'\195\160 la moiti\195\169.\n\nLe moyen le plus rapide de retrouver tout l\'\195\169quilibre est d\'<b>essuyer la lame</b> (ESSUYER). Consulte le rouleau suivant.",
		["Wiping the blade"] = "Essuyer la lame",
		["Cuts leave blood on the blade. With the blade drawn, press <b>{Wipe}</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "Les coupes laissent du sang sur la lame. Lame d\195\169gain\195\169e, appuie sur <b>{Wipe}</b> pour l\'essuyer avec un tissu, une face puis l\'autre. Un essuyage prend environ {time} secondes.",
		["<b>Wiping restores poise.</b> During a wipe, poise refills at {times}x speed, and a finished wipe fills it to full.\n\nAfter a poise break, a finished wipe also ends the weakened state."] = "<b>Essuyer la lame r\195\169tablit l\'\195\169quilibre.</b> Pendant un essuyage, l\'\195\169quilibre se recharge \195\160 une vitesse de {times}x, et un essuyage termin\195\169 le recharge compl\195\168tement.\n\nApr\195\168s une rupture d\'\195\169quilibre, un essuyage termin\195\169 met aussi fin \195\160 l\'\195\169tat affaibli.",
		["<b>Wiping leaves an opening.</b> Once a wipe starts, steering, guarding and cutting are locked until it ends, and a swing into the loose blade knocks it far aside. Losing poise mid-wipe cancels the full refill.\n\nBots punish wipes. Make some distance first.\n\nA later forge rank unlocks a quicker wipe."] = "<b>Essuyer la lame laisse une ouverture.</b> Une fois l\'essuyage lanc\195\169, diriger, se mettre en garde et couper sont bloqu\195\169s jusqu\'\195\160 ce qu\'il soit termin\195\169, et un coup contre la lame rel\195\162ch\195\169e l\'\195\169carte largement. Perdre de l\'\195\169quilibre pendant l\'essuyage annule la recharge compl\195\168te.\n\nLes bots punissent les essuyages. Prends d\'abord de la distance.\n\nUn rang de forge ult\195\169rieur d\195\169bloque un essuyage plus rapide.",
		["Cuts leave blood on the blade. With the blade drawn, tap <b>WIPE</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "Les coupes laissent du sang sur la lame. Lame d\195\169gain\195\169e, touche <b>ESSUYER</b> pour l\'essuyer avec un tissu, une face puis l\'autre. Un essuyage prend environ {time} secondes.",
		["Drawing the sword"] = "D\195\169gainer le sabre",
		["The sword starts sheathed, with a hand on the sheath, ready to draw.\n\n<b>{Lock}</b>: toggle lock-on. While locked on, the mouse picks the cut; its name shows at the bottom of the screen.\n<b>{NextTarget}</b>: switch target.\n<b>{Unequip}</b>: unequip the sword. <b>{Equip}</b>: equip it again."] = "Le sabre commence au fourreau, une main sur le fourreau, pr\195\170t \195\160 \195\170tre d\195\169gain\195\169.\n\n<b>{Lock}</b> : activer ou d\195\169sactiver le ciblage. Avec le ciblage actif, la souris choisit la coupe ; son nom s\'affiche en bas de l\'\195\169cran.\n<b>{NextTarget}</b> : changer de cible.\n<b>{Unequip}</b> : l\195\162cher le sabre. <b>{Equip}</b> : l\'\195\169quiper \195\160 nouveau.",
		["Move the mouse to pick the cut, then hold {Draw} and swipe:\n\n<b>Down-left</b>, swipe up-right: low cut.\n<b>Left</b>, swipe right: horizontal slice.\n<b>Up-left</b>, swipe down-right: diagonal cut.\n<b>Up</b>, swipe down: vertical slice.\n\nA faster swipe makes a faster cut.\n\n<b>{CalmDraw}</b>: calm draw. The blade slides out slowly into a guard, with no cut."] = "D\195\169place la souris pour choisir la coupe, puis maintiens {Draw} et glisse :\n\n<b>En bas \195\160 gauche</b>, glisse en haut \195\160 droite : coupe basse.\n<b>\195\128 gauche</b>, glisse \195\160 droite : coupe horizontale.\n<b>En haut \195\160 gauche</b>, glisse en bas \195\160 droite : coupe diagonale.\n<b>En haut</b>, glisse vers le bas : coupe verticale.\n\nUn glissement plus rapide donne une coupe plus rapide.\n\n<b>{CalmDraw}</b> : d\195\169gainage calme. La lame sort lentement et se met en garde, sans couper.",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>{Equip}</b>: put the blade away. The next draw is ready about a second later."] = "Les coupes au d\195\169gainage sont tenues fermement. Une lame frapp\195\169e par une coupe au d\195\169gainage est \195\169cart\195\169e et perd {block} d\'\195\169quilibre. Chaque coupe au d\195\169gainage co\195\187te {draw} d\'\195\169quilibre.\n\n<b>{Equip}</b> : remettre la lame au fourreau. Le d\195\169gainage suivant est pr\195\170t environ une seconde plus tard.",
		["The sword starts sheathed, with a hand on the sheath, ready to draw. While locked on, a slow drag on the right side of the screen moves the hand on the sheath, and a quick <b>flick</b> draws. The flick\'s direction picks the cut.\n\n<b>LOCKED ON</b>: tap to switch target, hold to turn lock-on off. <b>LOCK ON</b>: tap to turn it back on.\n<b>UNEQUIP</b>: hold to unequip the sword. <b>EQUIP</b>: tap to equip it again."] = "Le sabre commence au fourreau, une main sur le fourreau, pr\195\170t \195\160 \195\170tre d\195\169gain\195\169. Avec le ciblage actif, glisser lentement sur le c\195\180t\195\169 droit de l\'\195\169cran d\195\169place la main sur le fourreau, et un <b>balayage</b> rapide d\195\169gaine. La direction du balayage choisit la coupe.\n\n<b>CIBL\195\137</b> : un appui change de cible, un appui long d\195\169sactive le ciblage. <b>CIBLER</b> : un appui le r\195\169active.\n<b>L\195\130CHER</b> : un appui long l\195\162che le sabre. <b>\195\137QUIPER</b> : un appui l\'\195\169quipe \195\160 nouveau.",
		["<b>Flick right</b>: horizontal slice.\n<b>Flick down</b>: vertical slice.\n<b>Flick up-right</b>: low cut.\n\n<b>CALM DRAW</b>: the blade slides out slowly into a guard, with no cut."] = "<b>Balaie \195\160 droite</b> : coupe horizontale.\n<b>Balaie vers le bas</b> : coupe verticale.\n<b>Balaie en haut \195\160 droite</b> : coupe basse.\n\n<b>D\195\137GAINE CALME</b> : la lame sort lentement et se met en garde, sans couper.",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>SHEATHE</b>: put the blade away. The next draw is ready about a second later."] = "Les coupes au d\195\169gainage sont tenues fermement. Une lame frapp\195\169e par une coupe au d\195\169gainage est \195\169cart\195\169e et perd {block} d\'\195\169quilibre. Chaque coupe au d\195\169gainage co\195\187te {draw} d\'\195\169quilibre.\n\n<b>RANGER</b> : remettre la lame au fourreau. Le d\195\169gainage suivant est pr\195\170t environ une seconde plus tard.",
		["Clashes and parries"] = "Chocs et parades",
		["Blades that meet push each other apart, and the firmer blade moves less. A hard swing knocks a still blade far aside, and that blade is slow to recover: an opening to attack.\n\nHit near the hands, a blade barely moves. Hit near the tip, it\'s knocked aside easily."] = "Les lames qui se rencontrent se repoussent, et la plus ferme bouge moins. Un coup puissant \195\169carte largement une lame immobile, et cette lame tarde \195\160 revenir : une ouverture pour attaquer.\n\nFrapp\195\169e pr\195\168s des mains, une lame bouge \195\160 peine. Frapp\195\169e pr\195\168s de la pointe, elle est facilement \195\169cart\195\169e.",
		["<b>Draw-cuts</b> hit hardest. A blade held still that meets a draw-cut, or the drawer while the blade comes out, is knocked aside, and the cut goes through.\n\n<b>A still guard</b> (L2 on a gamepad) parries other swings: the swing bounces off and the attacker is staggered.\n\n<b>Two swings meeting</b> both give way, and neither can cut for a moment.\n\nThe whole sword can clash, handle included."] = "Les <b>coupes au d\195\169gainage</b> frappent le plus fort. Une lame tenue immobile qui rencontre une coupe au d\195\169gainage, ou qui touche celui qui d\195\169gaine pendant que la lame sort, est \195\169cart\195\169e, et la coupe passe.\n\n<b>Une garde immobile</b> (L2 sur une manette) pare les autres coups : le coup rebondit et l\'attaquant est \195\169tourdi.\n\n<b>Deux coups qui se rencontrent</b> c\195\168dent tous les deux, et aucun ne peut couper pendant un instant.\n\nLe choc peut se produire sur tout le sabre, poign\195\169e comprise.",
		["Cuts, wounds and bleeding"] = "Coupes, blessures et saignements",
		["A cut needs speed and a leading edge. Speed comes from the swing and from movement, so dashing past counts. A sudden change of direction hits with the flat.\n\nOnly a blade moving into a target counts. A blade left resting in a body sticks."] = "Une coupe demande de la vitesse et le tranchant devant. La vitesse vient du coup et du d\195\169placement, donc passer en ru\195\169e compte. Un brusque changement de direction frappe du plat.\n\nSeule compte une lame qui entre dans la cible. Une lame laiss\195\169e immobile dans un corps reste plant\195\169e.",
		["A fast, edge-first cut all the way through a limb <b>severs</b> it. Through the head or torso: <b>a kill</b>.\n\nAnything less is a <b>wound</b>: it bleeds and slows the limb. Deeper wounds are worse.\n\n<b>Stabs</b> never kill outright. A stab to the head, or a fast one to the body (dash or lunge in), takes a lot of blood at once. Other stabs wound."] = "Un membre travers\195\169 de part en part par une coupe rapide, tranchant devant, est <b>tranch\195\169</b>. \195\128 travers la t\195\170te ou le torse : <b>une \195\169limination</b>.\n\nMoins que cela, c\'est une <b>blessure</b> : elle saigne et ralentit le membre. Les blessures plus profondes sont plus graves.\n\nLes <b>coups d\'estoc</b> ne tuent jamais d\'un coup. Un coup d\'estoc \195\160 la t\195\170te, ou un rapide au corps (en ru\195\169e ou en fente), fait perdre beaucoup de sang d\'un coup. Les autres coups d\'estoc blessent.",
		["Every fighter has {squares} squares of blood. Wounds bleed for a few seconds, and so does a lost limb. With two limbs lost, the stumps bleed out. Losing both arms drops the katana.\n\nCombat is allowed in the arena and the forest, except in safe zones. Inside one, the screen shows <b>{safe}</b>."] = "Chaque combattant a {squares} carr\195\169s de sang. Les blessures saignent quelques secondes, un membre perdu aussi. Avec deux membres perdus, les moignons saignent jusqu\'\195\160 la mort. La perte des deux bras fait tomber le katana.\n\nLe combat est autoris\195\169 dans l\'ar\195\168ne et la for\195\170t, sauf dans les zones s\195\187res. Dans l\'une d\'elles, l\'\195\169cran affiche <b>{safe}</b>.",
		["The forge and levels"] = "La forge et les niveaux",
		["XP rewards:\n\n<b>Wounding a player</b>: {wound}.\n<b>Severing a limb</b>: {sever}.\n<b>A kill</b>: {kill}.\n<b>Defeating a bot</b>: {botLeast} to {botMost}, more for rarer names.\n\nEach level needs a little more XP than the last. No level cap."] = "R\195\169compenses d\'XP :\n\n<b>Blesser un joueur</b> : {wound}.\n<b>Trancher un membre</b> : {sever}.\n<b>Une \195\169limination</b> : {kill}.\n<b>Vaincre un bot</b> : de {botLeast} \195\160 {botMost}, plus pour les noms plus rares.\n\nChaque niveau demande un peu plus d\'XP que le pr\195\169c\195\169dent. Pas de limite de niveau.",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, press E at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "Un nouveau <b>rang de forge</b> se d\195\169bloque tous les {levels} niveaux. \195\128 la forge, au sud de l\'ar\195\168ne, appuie sur E \195\160 l\'enclume pour chauffer, marteler et tremper la lame. Chaque rang donne \195\160 la lame une nouvelle apparence et une nouvelle am\195\169lioration.\n\nLe mur des sabres ici montre la lame de chaque rang de forge.\n\n<b>Reforge</b> pour revenir \195\160 n\'importe quel rang d\195\169j\195\160 forg\195\169.",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, tap <b>Forge your blade</b> at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "Un nouveau <b>rang de forge</b> se d\195\169bloque tous les {levels} niveaux. \195\128 la forge, au sud de l\'ar\195\168ne, touche <b>Forge ta lame</b> \195\160 l\'enclume pour chauffer, marteler et tremper la lame. Chaque rang donne \195\160 la lame une nouvelle apparence et une nouvelle am\195\169lioration.\n\nLe mur des sabres ici montre la lame de chaque rang de forge.\n\n<b>Reforge</b> pour revenir \195\160 n\'importe quel rang d\195\169j\195\160 forg\195\169.",
		["Kill streaks"] = "S\195\169ries d\'\195\169liminations",
		["A <b>kill streak</b> counts kills in a row without dying, shown at the top right. Bleed-outs from a cut count, and so do bot kills. Dying ends the streak, but the best one is saved."] = "Une <b>s\195\169rie d\'\195\169liminations</b> compte les \195\169liminations d\'affil\195\169e sans mourir ; elle s\'affiche en haut \195\160 droite. Les morts par saignement apr\195\168s une coupe comptent, les \195\169liminations de bots aussi. Mourir met fin \195\160 la s\195\169rie, mais la meilleure est enregistr\195\169e.",
		["The streak catches fire as it grows, and every ten kills earns a title. Every {every} kills up to {most}: +{share} walk speed and poise recovery (Mythic names +{mythic}, Exotic names +{exotic}).\n\nNo prizes: it\'s for the glory.\n\nAfter dying, <b>SPECTATE</b> watches other fighters and <b>RESPAWN</b> returns to the fight."] = "La s\195\169rie s\'enflamme en grandissant, et chaque dizaine d\'\195\169liminations rapporte un titre. Toutes les {every} \195\169liminations, jusqu\'\195\160 {most} : +{share} de vitesse de marche et de r\195\169cup\195\169ration d\'\195\169quilibre (noms Mythiques +{mythic}, Exotiques +{exotic}).\n\nPas de prix : c\'est pour la gloire.\n\nApr\195\168s la mort, <b>OBSERVER</b> permet de regarder d\'autres combattants et <b>R\195\137APPARA\195\142TRE</b> renvoie au combat.",
		["TO WHOEVER FREED THIS TEMPLE"] = "\195\128 CELUI QUI A LIB\195\137R\195\137 CE TEMPLE",
		["Her blade still rests within these walls. Search every corner."] = "Sa lame repose toujours entre ces murs. Fouille chaque recoin.",
		["YOU  {mine}  :  {theirs}  {name}"] = "TOI  {mine} \194\160:  {theirs}  {name}",
		["1V1 \194\183 ROUND {round} \194\183 FIRST TO {wins}"] = "1V1 \194\183 MANCHE {round} \194\183 PREMIER \195\128 {wins}",
		["1V1 \194\183 FIRST TO {wins} KILLS"] = "1V1 \194\183 PREMIER \195\128 {wins} \195\137LIMINATIONS",
		["Lock on to {name} to bow back."] = "Cible {name} pour lui rendre son salut.",
		["BOW BACK"] = "RENDRE LE SALUT",
