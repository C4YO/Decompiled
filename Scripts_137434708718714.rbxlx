		["Safe zone: combat forbidden"] = "\229\174\137\229\133\168\229\156\176\229\184\175\239\188\154\230\136\166\233\151\152\231\166\129\230\173\162",
		["Names and boosts"] = "\229\144\141\229\173\151\227\129\168\227\131\156\227\131\188\227\131\138\227\130\185",
		["<b>Family name</b>: rolled once, at the forge.\n<b>First name</b>: reroll any time on the character screen (CHARACTER, on the title screen).\n\nRarer family names give stat boosts. Boosts are kept small, so fights are still won with the blade."] = "<b>\229\144\141\229\173\151</b>\239\188\154\233\141\155\229\134\182\229\160\180\227\129\167\228\184\128\229\186\166\227\129\160\227\129\145\230\177\186\227\129\190\227\130\139\227\128\130\n<b>\229\144\141\229\137\141</b>\239\188\154\227\130\173\227\131\163\227\131\169\227\130\175\227\130\191\227\131\188\231\148\187\233\157\162\239\188\136\227\130\191\227\130\164\227\131\136\227\131\171\231\148\187\233\157\162\227\129\174\227\128\140\227\130\173\227\131\163\227\131\169\227\130\175\227\130\191\227\131\188\227\128\141\239\188\137\227\129\167\227\129\132\227\129\164\227\129\167\227\130\130\229\188\149\227\129\141\231\155\180\227\129\155\227\130\139\227\128\130\n\n\231\143\141\227\129\151\227\129\132\229\144\141\229\173\151\227\129\187\227\129\169\232\131\189\229\138\155\229\128\164\227\129\171\227\131\156\227\131\188\227\131\138\227\130\185\227\129\140\227\129\164\227\129\143\227\128\130\227\131\156\227\131\188\227\131\138\227\130\185\227\129\175\229\176\143\227\129\149\227\129\143\230\138\145\227\129\136\227\129\166\227\129\130\227\130\138\227\128\129\229\139\157\232\178\160\227\129\175\227\129\130\227\129\143\227\129\190\227\129\167\229\136\128\227\129\174\232\133\149\227\129\167\230\177\186\227\129\190\227\130\139\227\128\130",
		["Rarity, odds and boosts:\n\n{rarities}\n\nThe rarest names belong to famous swordsmen and warlords. A Mythic name is a legend\'s own name, used in place of a family name. An Exotic name is a god\'s. Every spin is pure chance at these odds."] = "\227\131\172\227\130\162\229\186\166\227\131\187\231\162\186\231\142\135\227\131\187\227\131\156\227\131\188\227\131\138\227\130\185\239\188\154\n\n{rarities}\n\n\230\156\128\227\130\130\231\143\141\227\129\151\227\129\132\229\144\141\229\173\151\227\129\175\227\128\129\229\144\141\233\171\152\227\129\132\229\137\163\232\177\170\227\130\132\230\173\166\229\176\134\227\129\174\227\130\130\227\129\174\227\128\130\227\131\159\227\130\183\227\131\131\227\130\175\227\129\174\229\144\141\227\129\175\228\188\157\232\170\172\227\129\174\228\186\186\231\137\169\227\129\157\227\129\174\228\186\186\227\129\174\229\144\141\227\129\167\227\128\129\229\144\141\229\173\151\227\129\174\228\187\163\227\130\143\227\130\138\227\129\171\228\189\191\227\130\143\227\130\140\227\130\139\227\128\130\227\130\168\227\130\173\227\130\190\227\131\129\227\131\131\227\130\175\227\129\174\229\144\141\227\129\175\231\165\158\227\129\174\229\144\141\227\129\160\227\128\130\227\130\172\227\131\129\227\131\163\227\129\175\227\129\153\227\129\185\227\129\166\227\128\129\227\129\147\227\129\174\231\162\186\231\142\135\227\129\171\227\130\136\227\130\139\229\174\140\229\133\168\227\129\170\233\129\139\227\128\130",
		["Boosts:\n\n<b>Walk speed</b>: faster movement.\n<b>Poise recovery</b>: poise refills faster.\n<b>Poise toughness</b>: all poise costs are lower.\n<b>Slower bleeding</b>: wounds and stumps bleed slower.\n<b>Faster dash recharge</b>: dash charges refill sooner.\n\nBoosts stack with forge upgrades."] = "\227\131\156\227\131\188\227\131\138\227\130\185\239\188\154\n\n<b>\231\167\187\229\139\149\233\128\159\229\186\166</b>\239\188\154\231\167\187\229\139\149\227\129\140\233\128\159\227\129\143\227\129\170\227\130\139\227\128\130\n<b>\228\189\147\229\185\185\229\155\158\229\190\169</b>\239\188\154\228\189\147\229\185\185\227\129\174\229\155\158\229\190\169\227\129\140\233\128\159\227\129\143\227\129\170\227\130\139\227\128\130\n<b>\228\189\147\229\185\185\227\129\174\229\188\183\227\129\149</b>\239\188\154\227\129\153\227\129\185\227\129\166\227\129\174\228\189\147\229\185\185\230\182\136\232\178\187\227\129\140\230\184\155\227\130\139\227\128\130\n<b>\229\135\186\232\161\128\232\187\189\230\184\155</b>\239\188\154\229\130\183\227\130\132\229\136\135\230\150\173\233\157\162\227\129\139\227\130\137\227\129\174\229\135\186\232\161\128\227\129\140\233\129\133\227\129\143\227\129\170\227\130\139\227\128\130\n<b>\227\131\128\227\131\131\227\130\183\227\131\165\229\155\158\229\190\169\233\128\159\229\186\166</b>\239\188\154\227\131\128\227\131\131\227\130\183\227\131\165\227\129\174\227\131\129\227\131\163\227\131\188\227\130\184\227\129\140\230\151\169\227\129\143\229\155\158\229\190\169\227\129\153\227\130\139\227\128\130\n\n\227\131\156\227\131\188\227\131\138\227\130\185\227\129\175\233\141\155\229\134\182\229\160\180\227\129\174\229\188\183\229\140\150\227\129\171\228\184\138\228\185\151\227\129\155\227\129\149\227\130\140\227\130\139\227\128\130",
		["<b>Rename spins</b> reroll the family name. Get {spins} free spins every level, or buy more in the SHOP. Use them on the character screen. The old name can always be kept.\n\nBots have names too. The rarer a bot\'s name, the better it fights."] = "<b>\230\148\185\229\144\141\227\130\172\227\131\129\227\131\163</b>\227\129\167\229\144\141\229\173\151\227\130\146\229\188\149\227\129\141\231\155\180\227\129\155\227\130\139\227\128\130\227\131\172\227\131\153\227\131\171\227\129\148\227\129\168\227\129\171{spins}\229\155\158\229\136\134\227\130\146\231\132\161\230\150\153\227\129\167\231\141\178\229\190\151\227\129\167\227\129\141\227\128\129\227\128\140\227\130\183\227\131\167\227\131\131\227\131\151\227\128\141\227\129\167\232\191\189\229\138\160\232\179\188\229\133\165\227\130\130\227\129\167\227\129\141\227\130\139\227\128\130\227\130\173\227\131\163\227\131\169\227\130\175\227\130\191\227\131\188\231\148\187\233\157\162\227\129\167\228\189\191\227\129\138\227\129\134\227\128\130\229\133\131\227\129\174\229\144\141\229\173\151\227\129\175\227\129\132\227\129\164\227\129\167\227\130\130\230\174\139\227\129\155\227\130\139\227\128\130\n\n\227\131\156\227\131\131\227\131\136\227\129\171\227\130\130\229\144\141\229\173\151\227\129\140\227\129\130\227\130\139\227\128\130\229\144\141\229\173\151\227\129\140\231\143\141\227\129\151\227\129\132\227\131\156\227\131\131\227\131\136\227\129\187\227\129\169\229\188\183\227\129\132\227\128\130",
		["Poise"] = "\228\189\147\229\185\185",
		["<b>Poise</b> is a fighter\'s steadiness. The poise bar is the thin bar above the blood squares; an opponent\'s is under their name. It grows from the middle as poise is lost, turning from gold to red, and hides at full poise."] = "<b>\228\189\147\229\185\185</b>\227\129\168\227\129\175\227\128\129\229\137\163\229\163\171\227\129\174\228\189\147\229\139\162\227\129\174\229\174\137\229\174\154\229\186\166\227\128\130\228\189\147\229\185\185\227\131\144\227\131\188\227\129\175\232\161\128\227\129\174\227\131\158\227\130\185\227\129\174\228\184\138\227\129\171\227\129\130\227\130\139\231\180\176\227\129\132\227\131\144\227\131\188\227\129\167\227\128\129\231\155\184\230\137\139\227\129\174\228\189\147\229\185\185\227\131\144\227\131\188\227\129\175\229\144\141\229\137\141\227\129\174\228\184\139\227\129\171\227\129\130\227\130\139\227\128\130\228\189\147\229\185\185\227\129\140\230\184\155\227\130\139\227\129\187\227\129\169\228\184\173\229\164\174\227\129\139\227\130\137\228\188\184\227\129\179\227\128\129\233\135\145\232\137\178\227\129\139\227\130\137\232\181\164\227\129\171\229\164\137\227\130\143\227\130\139\227\128\130\228\189\147\229\185\185\227\129\140\230\186\128\227\130\191\227\131\179\227\129\174\227\129\168\227\129\141\227\129\175\232\161\168\231\164\186\227\129\149\227\130\140\227\129\170\227\129\132\227\128\130",
		["Poise costs:\n\n<b>Draw-cut</b>: {draw}.  <b>Blade hit by a draw-cut</b>: {block}.\n<b>Hard swing</b>: {swing}.  <b>Dash</b>: {dash}.  <b>Kick</b>: {kick}.\n<b>Taking a cut</b>: {wound} (double from a draw-cut), plus blood loss.\n<b>Clashes</b>: more the harder the blade is knocked."] = "\228\189\147\229\185\185\227\129\174\230\182\136\232\178\187\239\188\154\n\n<b>\230\138\156\229\136\128\230\150\172\227\130\138</b>\239\188\154{draw}\227\128\130  <b>\230\138\156\229\136\128\230\150\172\227\130\138\227\130\146\229\143\151\227\129\145\227\129\159\229\136\128</b>\239\188\154{block}\227\128\130\n<b>\229\188\183\227\129\132\230\140\175\227\130\138</b>\239\188\154{swing}\227\128\130  <b>\227\131\128\227\131\131\227\130\183\227\131\165</b>\239\188\154{dash}\227\128\130  <b>\232\185\180\227\130\138</b>\239\188\154{kick}\227\128\130\n<b>\230\150\172\227\130\137\227\130\140\227\130\139</b>\239\188\154{wound}\239\188\136\230\138\156\229\136\128\230\150\172\227\130\138\227\129\170\227\130\1372\229\128\141\239\188\137\227\128\129\227\129\149\227\130\137\227\129\171\229\135\186\232\161\128\227\129\167\227\130\130\230\184\155\227\130\139\227\128\130\n<b>\230\137\147\227\129\161\229\144\136\227\129\132</b>\239\188\154\229\136\128\227\130\146\229\188\183\227\129\143\229\188\190\227\129\139\227\130\140\227\130\139\227\129\187\227\129\169\229\164\154\227\129\143\230\184\155\227\130\139\227\128\130",
		["Poise refills after {delay} seconds with no poise lost, at {regen} per second. A still guard (L2 on a gamepad) refills it faster; low blood refills it slower.\n\nBelow half poise, blade and movement speed drop, and the blade is knocked aside more easily."] = "\228\189\147\229\185\185\227\130\146{delay}\231\167\146\229\164\177\227\130\143\227\129\154\227\129\171\227\129\132\227\130\139\227\129\168\227\128\129\230\175\142\231\167\146{regen}\227\129\154\227\129\164\229\155\158\229\190\169\227\129\153\227\130\139\227\128\130\233\157\153\230\173\162\227\129\151\227\129\159\230\167\139\227\129\136\239\188\136\227\130\178\227\131\188\227\131\160\227\131\145\227\131\131\227\131\137\227\129\167\227\129\175L2\239\188\137\227\129\170\227\130\137\229\155\158\229\190\169\227\129\140\233\128\159\227\129\143\227\128\129\232\161\128\227\129\140\229\176\145\227\129\170\227\129\132\227\129\168\233\129\133\227\129\143\227\129\170\227\130\139\227\128\130\n\n\228\189\147\229\185\185\227\129\140\229\141\138\229\136\134\227\130\146\228\184\139\229\155\158\227\130\139\227\129\168\227\128\129\229\136\128\227\129\174\233\128\159\227\129\149\227\129\168\231\167\187\229\139\149\233\128\159\229\186\166\227\129\140\232\144\189\227\129\161\227\128\129\229\136\128\227\130\146\229\188\190\227\129\139\227\130\140\227\130\132\227\129\153\227\129\143\227\129\170\227\130\139\227\128\130",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> ({Wipe}). See the next scroll."] = "\228\189\147\229\185\185\227\129\140\227\130\188\227\131\173\227\129\171\227\129\170\227\130\139\227\129\168<b>\229\180\169\227\130\140\227\130\139</b>\239\188\154{stagger}\231\167\146\227\130\136\227\130\141\227\130\129\227\129\141\227\128\129\231\182\154\227\129\132\227\129\166{weakened}\231\167\146\227\129\174\230\129\175\229\136\135\227\130\140\239\188\136{slower}\233\129\133\227\129\143\227\129\170\227\130\138\227\128\129\230\129\175\227\129\140\228\184\138\227\129\140\227\130\138\227\128\129\231\148\187\233\157\162\227\129\174\231\171\175\227\129\140\230\154\151\227\129\143\227\129\170\227\130\139\239\188\137\227\128\130\227\129\157\227\129\174\229\190\140\227\128\129\228\189\147\229\185\185\227\129\175\229\141\138\229\136\134\227\129\190\227\129\167\229\155\158\229\190\169\227\129\153\227\130\139\227\128\130\n\n\228\189\147\229\185\185\227\130\146\230\186\128\227\130\191\227\131\179\227\129\171\230\136\187\227\129\153\228\184\128\231\149\170\227\129\174\232\191\145\233\129\147\227\129\175<b>\232\161\128\230\140\175\227\130\138</b>\239\188\136{Wipe}\239\188\137\227\128\130\230\172\161\227\129\174\229\183\187\231\137\169\227\130\146\232\170\173\227\130\130\227\129\134\227\128\130",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> (WIPE). See the next scroll."] = "\228\189\147\229\185\185\227\129\140\227\130\188\227\131\173\227\129\171\227\129\170\227\130\139\227\129\168<b>\229\180\169\227\130\140\227\130\139</b>\239\188\154{stagger}\231\167\146\227\130\136\227\130\141\227\130\129\227\129\141\227\128\129\231\182\154\227\129\132\227\129\166{weakened}\231\167\146\227\129\174\230\129\175\229\136\135\227\130\140\239\188\136{slower}\233\129\133\227\129\143\227\129\170\227\130\138\227\128\129\230\129\175\227\129\140\228\184\138\227\129\140\227\130\138\227\128\129\231\148\187\233\157\162\227\129\174\231\171\175\227\129\140\230\154\151\227\129\143\227\129\170\227\130\139\239\188\137\227\128\130\227\129\157\227\129\174\229\190\140\227\128\129\228\189\147\229\185\185\227\129\175\229\141\138\229\136\134\227\129\190\227\129\167\229\155\158\229\190\169\227\129\153\227\130\139\227\128\130\n\n\228\189\147\229\185\185\227\130\146\230\186\128\227\130\191\227\131\179\227\129\171\230\136\187\227\129\153\228\184\128\231\149\170\227\129\174\232\191\145\233\129\147\227\129\175<b>\232\161\128\230\140\175\227\130\138</b>\239\188\136\227\128\140\232\161\128\230\140\175\227\130\138\227\128\141\227\131\156\227\130\191\227\131\179\239\188\137\227\128\130\230\172\161\227\129\174\229\183\187\231\137\169\227\130\146\232\170\173\227\130\130\227\129\134\227\128\130",
		["Wiping the blade"] = "\232\161\128\230\140\175\227\130\138",
		["Cuts leave blood on the blade. With the blade drawn, press <b>{Wipe}</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "\230\150\172\227\130\139\227\129\168\229\136\128\227\129\171\232\161\128\227\129\140\227\129\164\227\129\143\227\128\130\229\136\128\227\130\146\230\138\156\227\129\132\227\129\159\231\138\182\230\133\139\227\129\167<b>{Wipe}</b>\227\130\146\230\138\188\227\129\153\227\129\168\227\128\129\229\184\131\227\129\167\231\137\135\233\157\162\227\129\154\227\129\164\232\161\128\227\130\146\227\129\172\227\129\144\227\129\134\227\128\130\232\161\128\230\140\175\227\130\138\227\129\171\227\129\175\231\180\132{time}\231\167\146\227\129\139\227\129\139\227\130\139\227\128\130",
		["<b>Wiping restores poise.</b> During a wipe, poise refills at {times}x speed, and a finished wipe fills it to full.\n\nAfter a poise break, a finished wipe also ends the weakened state."] = "<b>\232\161\128\230\140\175\227\130\138\227\129\167\228\189\147\229\185\185\227\129\140\229\155\158\229\190\169\227\129\153\227\130\139\227\128\130</b>\232\161\128\230\140\175\227\130\138\228\184\173\227\129\175\228\189\147\229\185\185\227\129\140{times}\229\128\141\227\129\174\233\128\159\227\129\149\227\129\167\229\155\158\229\190\169\227\129\151\227\128\129\230\156\128\229\190\140\227\129\190\227\129\167\231\181\130\227\129\136\227\130\139\227\129\168\230\186\128\227\130\191\227\131\179\227\129\171\227\129\170\227\130\139\227\128\130\n\n\228\189\147\229\185\185\227\129\140\229\180\169\227\130\140\227\129\159\229\190\140\227\129\167\227\130\130\227\128\129\232\161\128\230\140\175\227\130\138\227\130\146\230\156\128\229\190\140\227\129\190\227\129\167\231\181\130\227\129\136\227\130\140\227\129\176\230\129\175\229\136\135\227\130\140\227\129\140\230\178\187\227\129\190\227\130\139\227\128\130",
		["<b>Wiping leaves an opening.</b> Once a wipe starts, steering, guarding and cutting are locked until it ends, and a swing into the loose blade knocks it far aside. Losing poise mid-wipe cancels the full refill.\n\nBots punish wipes. Make some distance first.\n\nA later forge rank unlocks a quicker wipe."] = "<b>\232\161\128\230\140\175\227\130\138\227\129\175\233\154\153\227\130\146\231\148\159\227\130\128\227\128\130</b>\232\161\128\230\140\175\227\130\138\227\130\146\229\167\139\227\130\129\227\130\139\227\129\168\227\128\129\231\181\130\227\130\143\227\130\139\227\129\190\227\129\167\229\136\128\227\130\146\230\147\141\227\130\139\227\129\147\227\129\168\227\130\130\230\167\139\227\129\136\227\130\139\227\129\147\227\129\168\227\130\130\230\150\172\227\130\139\227\129\147\227\129\168\227\130\130\227\129\167\227\129\141\227\129\154\227\128\129\231\183\169\227\130\147\227\129\160\229\136\128\227\129\171\228\184\128\230\146\131\227\130\146\229\143\151\227\129\145\227\130\139\227\129\168\229\164\167\227\129\141\227\129\143\229\188\190\227\129\139\227\130\140\227\130\139\227\128\130\233\128\148\228\184\173\227\129\167\228\189\147\229\185\185\227\129\140\230\184\155\227\130\139\227\129\168\227\128\129\230\186\128\227\130\191\227\131\179\227\129\190\227\129\167\227\129\174\229\155\158\229\190\169\227\129\175\229\143\150\227\130\138\230\182\136\227\129\149\227\130\140\227\130\139\227\128\130\n\n\227\131\156\227\131\131\227\131\136\227\129\175\232\161\128\230\140\175\227\130\138\227\129\174\233\154\153\227\130\146\231\139\153\227\129\163\227\129\166\227\129\143\227\130\139\227\128\130\229\133\136\227\129\171\232\183\157\233\155\162\227\130\146\229\143\150\227\130\141\227\129\134\227\128\130\n\n\229\190\140\227\129\174\233\141\155\229\136\128\227\131\169\227\131\179\227\130\175\227\129\167\227\128\129\227\130\136\227\130\138\231\180\160\230\151\169\227\129\132\232\161\128\230\140\175\227\130\138\227\129\140\232\167\163\230\148\190\227\129\149\227\130\140\227\130\139\227\128\130",
		["Cuts leave blood on the blade. With the blade drawn, tap <b>WIPE</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "\230\150\172\227\130\139\227\129\168\229\136\128\227\129\171\232\161\128\227\129\140\227\129\164\227\129\143\227\128\130\229\136\128\227\130\146\230\138\156\227\129\132\227\129\159\231\138\182\230\133\139\227\129\167<b>\232\161\128\230\140\175\227\130\138</b>\227\130\146\227\130\191\227\131\131\227\131\151\227\129\153\227\130\139\227\129\168\227\128\129\229\184\131\227\129\167\231\137\135\233\157\162\227\129\154\227\129\164\232\161\128\227\130\146\227\129\172\227\129\144\227\129\134\227\128\130\232\161\128\230\140\175\227\130\138\227\129\171\227\129\175\231\180\132{time}\231\167\146\227\129\139\227\129\139\227\130\139\227\128\130",
		["Drawing the sword"] = "\230\138\156\229\136\128",
		["The sword starts sheathed, with a hand on the sheath, ready to draw.\n\n<b>{Lock}</b>: toggle lock-on. While locked on, the mouse picks the cut; its name shows at the bottom of the screen.\n<b>{NextTarget}</b>: switch target.\n<b>{Unequip}</b>: unequip the sword. <b>{Equip}</b>: equip it again."] = "\229\136\128\227\129\175\233\158\152\227\129\171\231\180\141\227\129\190\227\129\163\227\129\159\231\138\182\230\133\139\227\129\167\229\167\139\227\129\190\227\130\138\227\128\129\230\137\139\227\129\175\233\158\152\227\129\171\230\183\187\227\129\136\227\130\137\227\130\140\227\128\129\227\129\132\227\129\164\227\129\167\227\130\130\230\138\156\229\136\128\227\129\167\227\129\141\227\130\139\227\128\130\n\n<b>{Lock}</b>\239\188\154\227\131\173\227\131\131\227\130\175\227\130\170\227\131\179\227\129\174\227\130\170\227\131\179\239\188\143\227\130\170\227\131\149\227\128\130\227\131\173\227\131\131\227\130\175\227\130\170\227\131\179\228\184\173\227\129\175\227\128\129\227\131\158\227\130\166\227\130\185\227\129\167\230\150\172\227\130\138\227\130\146\233\129\184\227\129\182\227\128\130\233\129\184\227\130\147\227\129\160\230\150\172\227\130\138\227\129\174\229\144\141\229\137\141\227\129\175\231\148\187\233\157\162\228\184\139\227\129\171\232\161\168\231\164\186\227\129\149\227\130\140\227\130\139\227\128\130\n<b>{NextTarget}</b>\239\188\154\230\172\161\227\129\174\231\155\184\230\137\139\227\129\171\229\136\135\227\130\138\230\155\191\227\129\136\227\128\130\n<b>{Unequip}</b>\239\188\154\229\136\128\227\129\139\227\130\137\230\137\139\227\130\146\233\155\162\227\129\153\227\128\130<b>{Equip}</b>\239\188\154\229\134\141\227\129\179\230\143\161\227\130\139\227\128\130",
		["Move the mouse to pick the cut, then hold {Draw} and swipe:\n\n<b>Down-left</b>, swipe up-right: low cut.\n<b>Left</b>, swipe right: horizontal slice.\n<b>Up-left</b>, swipe down-right: diagonal cut.\n<b>Up</b>, swipe down: vertical slice.\n\nA faster swipe makes a faster cut.\n\n<b>{CalmDraw}</b>: calm draw. The blade slides out slowly into a guard, with no cut."] = "\227\131\158\227\130\166\227\130\185\227\130\146\229\139\149\227\129\139\227\129\151\227\129\166\230\150\172\227\130\138\227\130\146\233\129\184\227\129\179\227\128\129{Draw}\227\130\146\230\138\188\227\129\151\227\129\159\227\129\190\227\129\190\227\130\185\227\131\175\227\130\164\227\131\151\227\129\151\227\130\136\227\129\134\239\188\154\n\n<b>\229\183\166\228\184\139</b>\227\128\129\229\143\179\228\184\138\227\129\184\227\130\185\227\131\175\227\130\164\227\131\151\239\188\154\230\150\172\227\130\138\228\184\138\227\129\146\227\128\130\n<b>\229\183\166</b>\227\128\129\229\143\179\227\129\184\227\130\185\227\131\175\227\130\164\227\131\151\239\188\154\230\168\170\230\150\172\227\130\138\227\128\130\n<b>\229\183\166\228\184\138</b>\227\128\129\229\143\179\228\184\139\227\129\184\227\130\185\227\131\175\227\130\164\227\131\151\239\188\154\232\162\136\232\163\159\230\150\172\227\130\138\227\128\130\n<b>\228\184\138</b>\227\128\129\228\184\139\227\129\184\227\130\185\227\131\175\227\130\164\227\131\151\239\188\154\231\184\166\230\150\172\227\130\138\227\128\130\n\n\233\128\159\227\129\143\227\130\185\227\131\175\227\130\164\227\131\151\227\129\153\227\130\139\227\129\187\227\129\169\230\150\172\227\130\138\227\130\130\233\128\159\227\129\132\227\128\130\n\n<b>{CalmDraw}</b>\239\188\154\233\157\153\227\129\139\227\129\170\230\138\156\229\136\128\227\128\130\230\150\172\227\130\137\227\129\154\227\129\171\227\128\129\229\136\128\227\130\146\227\130\134\227\129\163\227\129\143\227\130\138\230\138\156\227\129\132\227\129\166\230\167\139\227\129\136\227\130\139\227\128\130",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>{Equip}</b>: put the blade away. The next draw is ready about a second later."] = "\230\138\156\229\136\128\230\150\172\227\130\138\227\129\174\229\136\128\227\129\175\227\129\151\227\129\163\227\129\139\227\130\138\230\143\161\227\130\137\227\130\140\227\129\166\227\129\132\227\130\139\227\128\130\230\138\156\229\136\128\230\150\172\227\130\138\227\130\146\229\143\151\227\129\145\227\129\159\229\136\128\227\129\175\229\188\190\227\129\139\227\130\140\227\128\129\228\189\147\229\185\185\227\129\140{block}\230\184\155\227\130\139\227\128\130\230\138\156\229\136\128\230\150\172\227\130\138\227\129\1751\229\155\158\227\129\148\227\129\168\227\129\171\228\189\147\229\185\185\227\130\146{draw}\230\182\136\232\178\187\227\129\153\227\130\139\227\128\130\n\n<b>{Equip}</b>\239\188\154\229\136\128\227\130\146\231\180\141\227\130\129\227\130\139\227\128\130\231\180\1321\231\167\146\229\190\140\227\129\171\230\172\161\227\129\174\230\138\156\229\136\128\227\129\140\227\129\167\227\129\141\227\130\139\227\128\130",
		["The sword starts sheathed, with a hand on the sheath, ready to draw. While locked on, a slow drag on the right side of the screen moves the hand on the sheath, and a quick <b>flick</b> draws. The flick\'s direction picks the cut.\n\n<b>LOCKED ON</b>: tap to switch target, hold to turn lock-on off. <b>LOCK ON</b>: tap to turn it back on.\n<b>UNEQUIP</b>: hold to unequip the sword. <b>EQUIP</b>: tap to equip it again."] = "\229\136\128\227\129\175\233\158\152\227\129\171\231\180\141\227\129\190\227\129\163\227\129\159\231\138\182\230\133\139\227\129\167\229\167\139\227\129\190\227\130\138\227\128\129\230\137\139\227\129\175\233\158\152\227\129\171\230\183\187\227\129\136\227\130\137\227\130\140\227\128\129\227\129\132\227\129\164\227\129\167\227\130\130\230\138\156\229\136\128\227\129\167\227\129\141\227\130\139\227\128\130\227\131\173\227\131\131\227\130\175\227\130\170\227\131\179\228\184\173\227\129\175\227\128\129\231\148\187\233\157\162\227\129\174\229\143\179\229\129\180\227\130\146\227\130\134\227\129\163\227\129\143\227\130\138\227\131\137\227\131\169\227\131\131\227\130\176\227\129\153\227\130\139\227\129\168\233\158\152\227\129\174\228\184\138\227\129\174\230\137\139\227\129\140\229\139\149\227\129\141\227\128\129\231\180\160\230\151\169\227\129\143<b>\227\131\149\227\131\170\227\131\131\227\130\175</b>\227\129\153\227\130\139\227\129\168\230\138\156\229\136\128\227\129\153\227\130\139\227\128\130\227\131\149\227\131\170\227\131\131\227\130\175\227\129\174\229\144\145\227\129\141\227\129\167\230\150\172\227\130\138\227\129\140\230\177\186\227\129\190\227\130\139\227\128\130\n\n<b>\227\131\173\227\131\131\227\130\175\227\130\170\227\131\179\228\184\173</b>\239\188\154\227\130\191\227\131\131\227\131\151\227\129\167\230\172\161\227\129\174\231\155\184\230\137\139\227\129\171\229\136\135\227\130\138\230\155\191\227\129\136\227\128\129\233\149\183\230\138\188\227\129\151\227\129\167\227\131\173\227\131\131\227\130\175\227\130\170\227\131\179\232\167\163\233\153\164\227\128\130<b>\227\131\173\227\131\131\227\130\175\227\130\170\227\131\179</b>\239\188\154\227\130\191\227\131\131\227\131\151\227\129\167\229\134\141\227\129\179\227\130\170\227\131\179\227\128\130\n<b>\233\155\162\227\129\153</b>\239\188\154\233\149\183\230\138\188\227\129\151\227\129\167\229\136\128\227\129\139\227\130\137\230\137\139\227\130\146\233\155\162\227\129\153\227\128\130<b>\230\143\161\227\130\139</b>\239\188\154\227\130\191\227\131\131\227\131\151\227\129\167\229\134\141\227\129\179\230\143\161\227\130\139\227\128\130",
		["<b>Flick right</b>: horizontal slice.\n<b>Flick down</b>: vertical slice.\n<b>Flick up-right</b>: low cut.\n\n<b>CALM DRAW</b>: the blade slides out slowly into a guard, with no cut."] = "<b>\229\143\179\227\129\184\227\131\149\227\131\170\227\131\131\227\130\175</b>\239\188\154\230\168\170\230\150\172\227\130\138\227\128\130\n<b>\228\184\139\227\129\184\227\131\149\227\131\170\227\131\131\227\130\175</b>\239\188\154\231\184\166\230\150\172\227\130\138\227\128\130\n<b>\229\143\179\228\184\138\227\129\184\227\131\149\227\131\170\227\131\131\227\130\175</b>\239\188\154\230\150\172\227\130\138\228\184\138\227\129\146\227\128\130\n\n<b>\233\157\153\227\129\139\227\129\170\230\138\156\229\136\128</b>\239\188\154\230\150\172\227\130\137\227\129\154\227\129\171\227\128\129\229\136\128\227\130\146\227\130\134\227\129\163\227\129\143\227\130\138\230\138\156\227\129\132\227\129\166\230\167\139\227\129\136\227\130\139\227\128\130",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>SHEATHE</b>: put the blade away. The next draw is ready about a second later."] = "\230\138\156\229\136\128\230\150\172\227\130\138\227\129\174\229\136\128\227\129\175\227\129\151\227\129\163\227\129\139\227\130\138\230\143\161\227\130\137\227\130\140\227\129\166\227\129\132\227\130\139\227\128\130\230\138\156\229\136\128\230\150\172\227\130\138\227\130\146\229\143\151\227\129\145\227\129\159\229\136\128\227\129\175\229\188\190\227\129\139\227\130\140\227\128\129\228\189\147\229\185\185\227\129\140{block}\230\184\155\227\130\139\227\128\130\230\138\156\229\136\128\230\150\172\227\130\138\227\129\1751\229\155\158\227\129\148\227\129\168\227\129\171\228\189\147\229\185\185\227\130\146{draw}\230\182\136\232\178\187\227\129\153\227\130\139\227\128\130\n\n<b>\231\180\141\229\136\128</b>\239\188\154\229\136\128\227\130\146\231\180\141\227\130\129\227\130\139\227\128\130\231\180\1321\231\167\146\229\190\140\227\129\171\230\172\161\227\129\174\230\138\156\229\136\128\227\129\140\227\129\167\227\129\141\227\130\139\227\128\130",
		["Clashes and parries"] = "\230\137\147\227\129\161\229\144\136\227\129\132\227\129\168\229\188\190\227\129\141",
		["Blades that meet push each other apart, and the firmer blade moves less. A hard swing knocks a still blade far aside, and that blade is slow to recover: an opening to attack.\n\nHit near the hands, a blade barely moves. Hit near the tip, it\'s knocked aside easily."] = "\227\129\182\227\129\164\227\129\139\227\129\163\227\129\159\229\136\128\227\129\175\228\186\146\227\129\132\227\129\171\230\138\188\227\129\151\229\144\136\227\129\132\227\128\129\227\129\151\227\129\163\227\129\139\227\130\138\230\143\161\227\130\137\227\130\140\227\129\159\230\150\185\227\129\175\227\129\130\227\129\190\227\130\138\229\139\149\227\129\139\227\129\170\227\129\132\227\128\130\229\188\183\227\129\132\230\140\175\227\130\138\227\129\175\230\173\162\227\129\190\227\129\163\227\129\159\229\136\128\227\130\146\229\164\167\227\129\141\227\129\143\229\188\190\227\129\141\227\128\129\229\188\190\227\129\139\227\130\140\227\129\159\229\136\128\227\129\175\227\129\170\227\129\139\227\129\170\227\129\139\230\136\187\227\130\137\227\129\170\227\129\132\239\188\154\230\148\187\230\146\131\227\129\174\229\165\189\230\169\159\227\129\160\227\128\130\n\n\230\137\139\229\133\131\232\191\145\227\129\143\227\129\171\229\189\147\227\129\159\227\130\139\227\129\168\227\128\129\229\136\128\227\129\175\227\129\187\227\129\168\227\130\147\227\129\169\229\139\149\227\129\139\227\129\170\227\129\132\227\128\130\229\136\135\227\129\163\229\133\136\232\191\145\227\129\143\227\129\171\229\189\147\227\129\159\227\130\139\227\129\168\227\128\129\231\176\161\229\141\152\227\129\171\229\188\190\227\129\139\227\130\140\227\130\139\227\128\130",
		["<b>Draw-cuts</b> hit hardest. A blade held still that meets a draw-cut, or the drawer while the blade comes out, is knocked aside, and the cut goes through.\n\n<b>A still guard</b> (L2 on a gamepad) parries other swings: the swing bounces off and the attacker is staggered.\n\n<b>Two swings meeting</b> both give way, and neither can cut for a moment.\n\nThe whole sword can clash, handle included."] = "<b>\230\138\156\229\136\128\230\150\172\227\130\138</b>\227\129\140\228\184\128\231\149\170\233\135\141\227\129\132\227\128\130\233\157\153\230\173\162\227\129\151\227\129\159\229\136\128\227\129\175\227\128\129\230\138\156\229\136\128\230\150\172\227\130\138\227\129\171\229\189\147\227\129\159\227\130\139\227\129\139\227\128\129\229\136\128\227\130\146\230\138\156\227\129\143\230\156\128\228\184\173\227\129\174\231\155\184\230\137\139\227\129\171\232\167\166\227\130\140\227\130\139\227\129\168\229\188\190\227\129\139\227\130\140\227\128\129\230\150\172\227\130\138\227\129\175\227\129\157\227\129\174\227\129\190\227\129\190\233\128\154\227\130\139\227\128\130\n\n<b>\233\157\153\230\173\162\227\129\151\227\129\159\230\167\139\227\129\136</b>\239\188\136\227\130\178\227\131\188\227\131\160\227\131\145\227\131\131\227\131\137\227\129\167\227\129\175L2\239\188\137\227\129\175\227\129\187\227\129\139\227\129\174\230\140\175\227\130\138\227\130\146\229\188\190\227\129\143\239\188\154\230\140\175\227\130\138\227\129\140\232\183\179\227\129\173\232\191\148\227\129\149\227\130\140\227\128\129\230\148\187\230\146\131\227\129\151\227\129\159\229\129\180\227\129\140\227\130\136\227\130\141\227\130\129\227\129\143\227\128\130\n\n<b>\230\140\175\227\130\138\229\144\140\229\163\171\227\129\140\227\129\182\227\129\164\227\129\139\227\130\139</b>\227\129\168\228\186\146\227\129\132\227\129\171\230\138\188\227\129\151\232\178\160\227\129\145\227\128\129\227\129\151\227\129\176\227\130\137\227\129\143\227\129\169\227\129\161\227\130\137\227\130\130\230\150\172\227\130\140\227\129\170\227\129\132\227\128\130\n\n\230\159\132\227\130\130\229\144\171\227\130\129\227\128\129\229\136\128\229\133\168\228\189\147\227\129\140\230\137\147\227\129\161\229\144\136\227\129\136\227\130\139\227\128\130",
		["Cuts, wounds and bleeding"] = "\230\150\172\230\146\131\227\131\187\229\130\183\227\131\187\229\135\186\232\161\128",
		["A cut needs speed and a leading edge. Speed comes from the swing and from movement, so dashing past counts. A sudden change of direction hits with the flat.\n\nOnly a blade moving into a target counts. A blade left resting in a body sticks."] = "\230\150\172\227\130\139\227\129\171\227\129\175\233\128\159\227\129\149\227\129\168\227\128\129\229\136\131\227\129\140\229\133\136\227\129\171\229\189\147\227\129\159\227\130\139\227\129\147\227\129\168\227\129\140\229\191\133\232\166\129\227\128\130\233\128\159\227\129\149\227\129\175\230\140\175\227\130\138\227\129\168\231\167\187\229\139\149\227\129\139\227\130\137\231\148\159\227\129\190\227\130\140\227\130\139\227\129\174\227\129\167\227\128\129\227\131\128\227\131\131\227\130\183\227\131\165\227\129\167\233\167\134\227\129\145\230\138\156\227\129\145\227\130\139\227\129\174\227\130\130\230\156\137\229\138\185\227\128\130\230\128\165\227\129\171\229\144\145\227\129\141\227\130\146\229\164\137\227\129\136\227\130\139\227\129\168\229\136\128\227\129\174\232\133\185\227\129\167\229\189\147\227\129\159\227\130\139\227\128\130\n\n\230\150\172\227\130\140\227\130\139\227\129\174\227\129\175\227\128\129\229\175\190\232\177\161\227\129\171\229\144\145\227\129\139\227\129\163\227\129\166\229\139\149\227\129\132\227\129\166\227\129\132\227\130\139\229\136\128\227\129\160\227\129\145\227\128\130\228\189\147\227\129\171\229\189\147\227\129\166\227\129\159\227\129\190\227\129\190\230\173\162\227\129\190\227\129\163\227\129\159\229\136\128\227\129\175\233\163\159\227\129\132\232\190\188\227\130\128\227\129\160\227\129\145\227\129\160\227\128\130",
		["A fast, edge-first cut all the way through a limb <b>severs</b> it. Through the head or torso: <b>a kill</b>.\n\nAnything less is a <b>wound</b>: it bleeds and slows the limb. Deeper wounds are worse.\n\n<b>Stabs</b> never kill outright. A stab to the head, or a fast one to the body (dash or lunge in), takes a lot of blood at once. Other stabs wound."] = "\229\136\131\227\129\139\227\130\137\229\133\165\227\130\139\233\128\159\227\129\132\230\150\172\227\130\138\227\129\167\230\137\139\232\182\179\227\130\146\229\174\140\229\133\168\227\129\171\230\150\172\227\130\138\230\138\156\227\129\145\227\129\176<b>\230\150\172\227\130\138\232\144\189\227\129\168\227\129\155\227\130\139</b>\227\128\130\233\160\173\227\130\132\232\131\180\227\129\170\227\130\137<b>\228\184\128\230\146\131\227\129\167\229\128\146\227\129\155\227\130\139</b>\227\128\130\n\n\227\129\157\227\130\140\227\129\171\230\186\128\227\129\159\227\129\170\227\129\145\227\130\140\227\129\176<b>\229\130\183</b>\239\188\154\229\135\186\232\161\128\227\129\151\227\128\129\227\129\157\227\129\174\230\137\139\232\182\179\227\129\140\233\136\141\227\130\139\227\128\130\229\130\183\227\129\140\230\183\177\227\129\132\227\129\187\227\129\169\227\129\178\227\129\169\227\129\132\227\128\130\n\n<b>\231\170\129\227\129\141</b>\227\129\167\227\129\175\228\184\128\230\146\131\227\129\167\229\128\146\227\129\155\227\129\170\227\129\132\227\128\130\233\160\173\227\129\184\227\129\174\231\170\129\227\129\141\227\130\132\227\128\129\232\131\180\227\129\184\227\129\174\233\128\159\227\129\132\231\170\129\227\129\141\239\188\136\227\131\128\227\131\131\227\130\183\227\131\165\227\130\132\232\184\143\227\129\191\232\190\188\227\129\191\239\188\137\227\129\175\227\128\129\228\184\128\229\186\166\227\129\171\229\164\167\233\135\143\227\129\174\232\161\128\227\130\146\229\165\170\227\129\134\227\128\130\227\129\157\227\130\140\228\187\165\229\164\150\227\129\174\231\170\129\227\129\141\227\129\175\229\130\183\227\129\171\227\129\170\227\130\139\227\128\130",
		["Every fighter has {squares} squares of blood. Wounds bleed for a few seconds, and so does a lost limb. With two limbs lost, the stumps bleed out. Losing both arms drops the katana.\n\nCombat is allowed in the arena and the forest, except in safe zones. Inside one, the screen shows <b>{safe}</b>."] = "\227\129\169\227\129\174\229\137\163\229\163\171\227\130\130\232\161\128\227\129\175{squares}\227\131\158\227\130\185\227\128\130\229\130\183\227\129\175\230\149\176\231\167\146\233\150\147\229\135\186\232\161\128\227\129\151\227\128\129\229\164\177\227\129\163\227\129\159\230\137\139\232\182\179\227\130\130\229\144\140\227\129\152\227\128\130\230\137\139\232\182\179\227\130\1462\230\156\172\229\164\177\227\129\134\227\129\168\227\128\129\229\136\135\230\150\173\233\157\162\227\129\175\230\173\187\227\129\172\227\129\190\227\129\167\229\135\186\232\161\128\227\129\151\231\182\154\227\129\145\227\130\139\227\128\130\228\184\161\232\133\149\227\130\146\229\164\177\227\129\134\227\129\168\229\136\128\227\130\146\232\144\189\227\129\168\227\129\153\227\128\130\n\n\233\151\152\230\138\128\229\160\180\227\129\168\230\163\174\227\129\167\227\129\175\230\136\166\233\151\152\227\129\140\227\129\167\227\129\141\227\130\139\239\188\136\229\174\137\229\133\168\229\156\176\229\184\175\227\130\146\233\153\164\227\129\143\239\188\137\227\128\130\229\174\137\229\133\168\229\156\176\229\184\175\227\129\174\228\184\173\227\129\167\227\129\175\227\128\129\231\148\187\233\157\162\227\129\171<b>{safe}</b>\227\129\168\232\161\168\231\164\186\227\129\149\227\130\140\227\130\139\227\128\130",
		["The forge and levels"] = "\233\141\155\229\134\182\229\160\180\227\129\168\227\131\172\227\131\153\227\131\171",
		["XP rewards:\n\n<b>Wounding a player</b>: {wound}.\n<b>Severing a limb</b>: {sever}.\n<b>A kill</b>: {kill}.\n<b>Defeating a bot</b>: {botLeast} to {botMost}, more for rarer names.\n\nEach level needs a little more XP than the last. No level cap."] = "XP\229\160\177\233\133\172\239\188\154\n\n<b>\227\131\151\227\131\172\227\130\164\227\131\164\227\131\188\227\129\171\229\130\183\227\130\146\232\178\160\227\130\143\227\129\155\227\130\139</b>\239\188\154{wound}\227\128\130\n<b>\230\137\139\232\182\179\227\130\146\230\150\172\227\130\138\232\144\189\227\129\168\227\129\153</b>\239\188\154{sever}\227\128\130\n<b>\229\128\146\227\129\153</b>\239\188\154{kill}\227\128\130\n<b>\227\131\156\227\131\131\227\131\136\227\130\146\229\128\146\227\129\153</b>\239\188\154{botLeast}\227\128\156{botMost}\227\128\129\229\144\141\229\173\151\227\129\140\231\143\141\227\129\151\227\129\132\227\129\187\227\129\169\229\164\154\227\129\132\227\128\130\n\n\229\144\132\227\131\172\227\131\153\227\131\171\227\129\171\229\191\133\232\166\129\227\129\170XP\227\129\175\227\128\129\229\137\141\227\129\174\227\131\172\227\131\153\227\131\171\227\130\136\227\130\138\229\176\145\227\129\151\229\164\154\227\129\132\227\128\130\227\131\172\227\131\153\227\131\171\228\184\138\233\153\144\227\129\170\227\129\151\227\128\130",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, press E at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "{levels}\227\131\172\227\131\153\227\131\171\227\129\148\227\129\168\227\129\171\230\150\176\227\129\151\227\129\132<b>\233\141\155\229\136\128\227\131\169\227\131\179\227\130\175</b>\227\129\140\232\167\163\230\148\190\227\129\149\227\130\140\227\130\139\227\128\130\233\151\152\230\138\128\229\160\180\227\129\174\229\141\151\227\129\171\227\129\130\227\130\139\233\141\155\229\134\182\229\160\180\227\129\167\227\128\129\233\135\145\229\186\138\227\129\174\229\137\141\227\129\167E\227\130\146\230\138\188\227\129\151\227\129\166\227\128\129\229\136\128\227\130\146\231\134\177\227\129\151\227\128\129\230\137\147\227\129\161\227\128\129\231\132\188\227\129\141\229\133\165\227\130\140\227\129\151\227\130\136\227\129\134\227\128\130\227\131\169\227\131\179\227\130\175\227\129\148\227\129\168\227\129\171\229\136\128\227\129\174\232\166\139\227\129\159\231\155\174\227\129\140\229\164\137\227\130\143\227\130\138\227\128\129\230\150\176\227\129\151\227\129\132\229\188\183\229\140\150\227\129\140\230\137\139\227\129\171\229\133\165\227\130\139\227\128\130\n\n\227\129\147\227\129\147\227\129\174\229\136\128\230\142\155\227\129\145\227\129\171\227\129\175\227\128\129\227\129\153\227\129\185\227\129\166\227\129\174\233\141\155\229\136\128\227\131\169\227\131\179\227\130\175\227\129\174\229\136\128\227\129\140\228\184\166\227\130\147\227\129\167\227\129\132\227\130\139\227\128\130\n\n<b>\230\137\147\227\129\161\231\155\180\227\129\151</b>\227\129\167\227\128\129\233\141\155\227\129\136\227\129\159\227\129\147\227\129\168\227\129\174\227\129\130\227\130\139\227\129\169\227\129\174\227\131\169\227\131\179\227\130\175\227\129\171\227\130\130\230\136\187\227\129\155\227\130\139\227\128\130",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, tap <b>Forge your blade</b> at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "{levels}\227\131\172\227\131\153\227\131\171\227\129\148\227\129\168\227\129\171\230\150\176\227\129\151\227\129\132<b>\233\141\155\229\136\128\227\131\169\227\131\179\227\130\175</b>\227\129\140\232\167\163\230\148\190\227\129\149\227\130\140\227\130\139\227\128\130\233\151\152\230\138\128\229\160\180\227\129\174\229\141\151\227\129\171\227\129\130\227\130\139\233\141\155\229\134\182\229\160\180\227\129\167\227\128\129\233\135\145\229\186\138\227\129\174\229\137\141\227\129\174<b>\229\136\128\227\130\146\233\141\155\227\129\136\227\130\139</b>\227\130\146\227\130\191\227\131\131\227\131\151\227\129\151\227\129\166\227\128\129\229\136\128\227\130\146\231\134\177\227\129\151\227\128\129\230\137\147\227\129\161\227\128\129\231\132\188\227\129\141\229\133\165\227\130\140\227\129\151\227\130\136\227\129\134\227\128\130\227\131\169\227\131\179\227\130\175\227\129\148\227\129\168\227\129\171\229\136\128\227\129\174\232\166\139\227\129\159\231\155\174\227\129\140\229\164\137\227\130\143\227\130\138\227\128\129\230\150\176\227\129\151\227\129\132\229\188\183\229\140\150\227\129\140\230\137\139\227\129\171\229\133\165\227\130\139\227\128\130\n\n\227\129\147\227\129\147\227\129\174\229\136\128\230\142\155\227\129\145\227\129\171\227\129\175\227\128\129\227\129\153\227\129\185\227\129\166\227\129\174\233\141\155\229\136\128\227\131\169\227\131\179\227\130\175\227\129\174\229\136\128\227\129\140\228\184\166\227\130\147\227\129\167\227\129\132\227\130\139\227\128\130\n\n<b>\230\137\147\227\129\161\231\155\180\227\129\151</b>\227\129\167\227\128\129\233\141\155\227\129\136\227\129\159\227\129\147\227\129\168\227\129\174\227\129\130\227\130\139\227\129\169\227\129\174\227\131\169\227\131\179\227\130\175\227\129\171\227\130\130\230\136\187\227\129\155\227\130\139\227\128\130",
		["Kill streaks"] = "\233\128\163\230\150\172",
		["A <b>kill streak</b> counts kills in a row without dying, shown at the top right. Bleed-outs from a cut count, and so do bot kills. Dying ends the streak, but the best one is saved."] = "<b>\233\128\163\230\150\172</b>\227\129\175\227\128\129\230\173\187\227\129\170\227\129\154\227\129\171\231\182\154\227\129\145\227\129\166\229\128\146\227\129\151\227\129\159\230\149\176\239\188\136\229\143\179\228\184\138\227\129\171\232\161\168\231\164\186\239\188\137\227\128\130\230\150\172\227\130\137\227\130\140\227\129\159\231\155\184\230\137\139\227\129\174\229\164\177\232\161\128\230\173\187\227\130\130\227\128\129\227\131\156\227\131\131\227\131\136\227\129\174\230\146\131\231\160\180\227\130\130\230\149\176\227\129\171\229\133\165\227\130\139\227\128\130\230\173\187\227\129\172\227\129\168\233\128\163\230\150\172\227\129\175\233\128\148\229\136\135\227\130\140\227\130\139\227\129\140\227\128\129\230\156\128\233\171\152\232\168\152\233\140\178\227\129\175\228\191\157\229\173\152\227\129\149\227\130\140\227\130\139\227\128\130",
		["The streak catches fire as it grows, and every ten kills earns a title. Every {every} kills up to {most}: +{share} walk speed and poise recovery (Mythic names +{mythic}, Exotic names +{exotic}).\n\nNo prizes: it\'s for the glory.\n\nAfter dying, <b>SPECTATE</b> watches other fighters and <b>RESPAWN</b> returns to the fight."] = "\233\128\163\230\150\172\227\129\175\230\149\176\227\129\140\229\162\151\227\129\136\227\130\139\227\129\187\227\129\169\231\135\131\227\129\136\228\184\138\227\129\140\227\130\138\227\128\12910\233\128\163\230\150\172\227\129\148\227\129\168\227\129\171\231\167\176\229\143\183\227\129\140\227\129\164\227\129\143\227\128\130{most}\233\128\163\230\150\172\227\129\190\227\129\167\227\128\129{every}\233\128\163\230\150\172\227\129\148\227\129\168\227\129\171\231\167\187\229\139\149\233\128\159\229\186\166\227\129\168\228\189\147\229\185\185\229\155\158\229\190\169\227\129\140+{share}\228\184\138\227\129\140\227\130\139\239\188\136\227\131\159\227\130\183\227\131\131\227\130\175\227\129\174\229\144\141\229\173\151\227\129\175+{mythic}\227\128\129\227\130\168\227\130\173\227\130\190\227\131\129\227\131\131\227\130\175\227\129\175+{exotic}\239\188\137\227\128\130\n\n\232\179\158\229\147\129\227\129\175\227\129\170\227\129\132\239\188\154\229\144\141\232\170\137\227\129\174\227\129\159\227\130\129\227\129\160\227\128\130\n\n\230\173\187\228\186\161\229\190\140\227\129\175\227\128\129<b>\232\166\179\230\136\166</b>\227\129\167\228\187\150\227\129\174\229\137\163\229\163\171\227\129\174\230\136\166\227\129\132\227\130\146\232\166\139\227\130\137\227\130\140\227\128\129<b>\229\190\169\230\180\187</b>\227\129\167\230\136\166\227\129\132\227\129\171\230\136\187\227\130\140\227\130\139\227\128\130",
		["TO WHOEVER FREED THIS TEMPLE"] = "\227\129\147\227\129\174\229\175\186\227\130\146\232\167\163\227\129\141\230\148\190\227\129\163\227\129\159\232\128\133\227\129\184",
