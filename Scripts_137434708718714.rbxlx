		["A door opens each day from 1 to 25 December while playing. Missed doors stay shut."] = "\224\184\151\224\184\184\224\184\129\224\184\167\224\184\177\224\184\153\224\184\149\224\184\177\224\185\137\224\184\135\224\185\129\224\184\149\224\185\136 1 \224\184\150\224\184\182\224\184\135 25 \224\184\152\224\184\177\224\184\153\224\184\167\224\184\178\224\184\132\224\184\161 \224\184\155\224\184\163\224\184\176\224\184\149\224\184\185\224\184\171\224\184\153\224\184\182\224\185\136\224\184\135\224\184\154\224\184\178\224\184\153\224\184\136\224\184\176\224\185\128\224\184\155\224\184\180\224\184\148\224\185\128\224\184\161\224\184\183\224\185\136\224\184\173\224\185\128\224\184\165\224\185\136\224\184\153 \224\184\155\224\184\163\224\184\176\224\184\149\224\184\185\224\184\151\224\184\181\224\185\136\224\184\158\224\184\165\224\184\178\224\184\148\224\185\132\224\184\155\224\184\136\224\184\176\224\184\155\224\184\180\224\184\148\224\184\149\224\184\165\224\184\173\224\184\148\224\185\132\224\184\155",
		["BACK"] = "\224\184\129\224\184\165\224\184\177\224\184\154",
		["AIM DOT"] = "\224\184\136\224\184\184\224\184\148\224\185\128\224\184\165\224\185\135\224\184\135",
		["COLOUR"] = "\224\184\170\224\184\181",
