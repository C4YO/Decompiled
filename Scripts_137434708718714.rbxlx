		["BRIGHTNESS"] = "\224\184\132\224\184\167\224\184\178\224\184\161\224\184\170\224\184\167\224\185\136\224\184\178\224\184\135",
		["CUSTOM"] = "\224\184\129\224\184\179\224\184\171\224\184\153\224\184\148\224\185\128\224\184\173\224\184\135",
		["DEFAULT"] = "\224\184\132\224\185\136\224\184\178\224\185\128\224\184\163\224\184\180\224\185\136\224\184\161\224\184\149\224\185\137\224\184\153",
		["ON"] = "\224\185\128\224\184\155\224\184\180\224\184\148",
		["OFF"] = "\224\184\155\224\184\180\224\184\148",
		["Your blade is alight: {hits} hits."] = "\224\184\148\224\184\178\224\184\154\224\184\129\224\184\179\224\184\165\224\184\177\224\184\135\224\184\165\224\184\184\224\184\129\224\185\128\224\184\155\224\185\135\224\184\153\224\185\132\224\184\159: \224\185\128\224\184\171\224\184\165\224\184\183\224\184\173\224\184\173\224\184\181\224\184\129 {hits} \224\184\132\224\184\163\224\184\177\224\185\137\224\184\135",
		["Your blade\'s flame is out: wipe it again, then light it."] = "\224\185\132\224\184\159\224\184\154\224\184\153\224\184\148\224\184\178\224\184\154\224\184\148\224\184\177\224\184\154\224\185\129\224\184\165\224\185\137\224\184\167: \224\185\128\224\184\138\224\185\135\224\184\148\224\184\148\224\184\178\224\184\154\224\184\173\224\184\181\224\184\129\224\184\132\224\184\163\224\184\177\224\185\137\224\184\135 \224\185\129\224\184\165\224\185\137\224\184\167\224\184\136\224\184\184\224\184\148\224\185\132\224\184\159\224\185\131\224\184\171\224\184\161\224\185\136",
		["Your blade is waxed: hold it in a fire stand\'s flame."] = "\224\184\148\224\184\178\224\184\154\224\184\150\224\184\185\224\184\129\224\184\151\224\184\178\224\184\130\224\184\181\224\185\137\224\184\156\224\184\182\224\185\137\224\184\135\224\185\129\224\184\165\224\185\137\224\184\167: \224\184\162\224\184\183\224\185\136\224\184\153\224\184\148\224\184\178\224\184\154\224\185\128\224\184\130\224\185\137\224\184\178\224\185\132\224\184\155\224\185\131\224\184\153\224\185\128\224\184\155\224\184\165\224\184\167\224\185\132\224\184\159\224\184\130\224\184\173\224\184\135\224\184\132\224\184\154\224\185\128\224\184\158\224\184\165\224\184\180\224\184\135",
		["{count} / {goal}"] = "{count} / {goal}",
		["The mist seals the way out: defeat the boss, or fall."] = "\224\184\171\224\184\161\224\184\173\224\184\129\224\184\155\224\184\180\224\184\148\224\184\151\224\184\178\224\184\135\224\184\173\224\184\173\224\184\129\224\185\129\224\184\165\224\185\137\224\184\167: \224\184\155\224\184\163\224\184\178\224\184\154\224\184\154\224\184\173\224\184\170\224\185\131\224\184\171\224\185\137\224\185\132\224\184\148\224\185\137 \224\184\171\224\184\163\224\184\183\224\184\173\224\185\132\224\184\161\224\185\136\224\184\129\224\185\135\224\184\165\224\185\137\224\184\161\224\184\165\224\184\135\224\184\151\224\184\181\224\185\136\224\184\153\224\184\181\224\185\136",
		["The seal is broken: the way out is open."] = "\224\184\156\224\184\153\224\184\182\224\184\129\224\185\129\224\184\149\224\184\129\224\185\129\224\184\165\224\185\137\224\184\167: \224\184\151\224\184\178\224\184\135\224\184\173\224\184\173\224\184\129\224\185\128\224\184\155\224\184\180\224\184\148\224\185\129\224\184\165\224\185\137\224\184\167",
		["LOCAL"] = "\224\185\131\224\184\129\224\184\165\224\185\137\224\185\128\224\184\132\224\184\181\224\184\162\224\184\135",
		["DM"] = "\224\184\170\224\185\136\224\184\167\224\184\153\224\184\149\224\184\177\224\184\167",
		["GLOBAL"] = "\224\184\151\224\184\177\224\185\136\224\184\167\224\185\132\224\184\155",
		["SHOW"] = "\224\185\129\224\184\170\224\184\148\224\184\135",
		["HIDE"] = "\224\184\139\224\185\136\224\184\173\224\184\153",
		["Sending too fast. Wait a moment."] = "\224\184\170\224\185\136\224\184\135\224\185\128\224\184\163\224\185\135\224\184\167\224\185\128\224\184\129\224\184\180\224\184\153\224\185\132\224\184\155 \224\184\163\224\184\173\224\184\170\224\184\177\224\184\129\224\184\132\224\184\163\224\184\185\224\185\136",
		["Message not sent."] = "\224\184\170\224\185\136\224\184\135\224\184\130\224\185\137\224\184\173\224\184\132\224\184\167\224\184\178\224\184\161\224\185\132\224\184\161\224\185\136\224\184\170\224\184\179\224\185\128\224\184\163\224\185\135\224\184\136",
		["Can\'t message this player."] = "\224\184\170\224\185\136\224\184\135\224\184\130\224\185\137\224\184\173\224\184\132\224\184\167\224\184\178\224\184\161\224\184\150\224\184\182\224\184\135\224\184\156\224\184\185\224\185\137\224\185\128\224\184\165\224\185\136\224\184\153\224\184\153\224\184\181\224\185\137\224\185\132\224\184\161\224\185\136\224\185\132\224\184\148\224\185\137",
		["Type a message"] = "\224\184\158\224\184\180\224\184\161\224\184\158\224\185\140\224\184\130\224\185\137\224\184\173\224\184\132\224\184\167\224\184\178\224\184\161",
		["{key}   chat"] = "{key}   \224\185\129\224\184\138\224\184\151",
		["No other players in this server."] = "\224\185\132\224\184\161\224\185\136\224\184\161\224\184\181\224\184\156\224\184\185\224\185\137\224\185\128\224\184\165\224\185\136\224\184\153\224\184\173\224\184\183\224\185\136\224\184\153\224\185\131\224\184\153\224\185\128\224\184\139\224\184\180\224\184\163\224\185\140\224\184\159\224\185\128\224\184\167\224\184\173\224\184\163\224\185\140\224\184\153\224\184\181\224\185\137",
		["Type a code and press REDEEM. Each code works once."] = "\224\184\158\224\184\180\224\184\161\224\184\158\224\185\140\224\185\130\224\184\132\224\185\137\224\184\148\224\185\129\224\184\165\224\185\137\224\184\167\224\184\129\224\184\148 \224\185\129\224\184\165\224\184\129 \224\185\130\224\184\132\224\185\137\224\184\148\224\185\129\224\184\149\224\185\136\224\184\165\224\184\176\224\184\173\224\184\177\224\184\153\224\185\131\224\184\138\224\185\137\224\185\132\224\184\148\224\185\137\224\184\132\224\184\163\224\184\177\224\185\137\224\184\135\224\185\128\224\184\148\224\184\181\224\184\162\224\184\167",
		["ENTER CODE"] = "\224\185\131\224\184\170\224\185\136\224\185\130\224\184\132\224\185\137\224\184\148",
		["Type a code first."] = "\224\184\158\224\184\180\224\184\161\224\184\158\224\185\140\224\185\130\224\184\132\224\185\137\224\184\148\224\184\129\224\185\136\224\184\173\224\184\153",
		["Checking..."] = "\224\184\129\224\184\179\224\184\165\224\184\177\224\184\135\224\184\149\224\184\163\224\184\167\224\184\136\224\184\170\224\184\173\224\184\154...",
		["No answer from the server. Try again."] = "\224\185\128\224\184\139\224\184\180\224\184\163\224\185\140\224\184\159\224\185\128\224\184\167\224\184\173\224\184\163\224\185\140\224\185\132\224\184\161\224\185\136\224\184\149\224\184\173\224\184\154 \224\184\165\224\184\173\224\184\135\224\184\173\224\184\181\224\184\129\224\184\132\224\184\163\224\184\177\224\185\137\224\184\135",
		["Redeemed: {reward}"] = "\224\185\129\224\184\165\224\184\129\224\185\129\224\184\165\224\185\137\224\184\167: {reward}",
		["REDEEM"] = "\224\185\129\224\184\165\224\184\129",
