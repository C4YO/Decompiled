		["Hold, swipe to draw. Blade out: thrust."] = "\208\151\208\176\208\182\208\188\208\184 \208\184 \208\188\208\176\209\133\208\189\208\184 \226\128\148 \208\178\209\139\209\133\208\178\208\176\209\130. \208\154\208\187\208\184\208\189\208\190\208\186 \208\190\208\177\208\189\208\176\208\182\209\145\208\189 \226\128\148 \209\131\208\186\208\190\208\187.",
