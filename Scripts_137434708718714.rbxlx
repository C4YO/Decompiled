local function v_u_30() -- name: rarityLines
	-- upvalues: (copy) v_u_5, (copy) v_u_11
	local v15 = {}
	for _, v16 in v_u_5.RARITIES do
		local v17 = v_u_5.FAMILY[v16.Name] or {}
		local v18 = v17[1] and #v17[1].Boosts or 0
