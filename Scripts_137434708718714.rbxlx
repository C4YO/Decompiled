	["Lines"] = nil,
	["Locales"] = { "id-id", "id" },
	["Lines"] = {
		["1 free rename spin"] = "1 spin nama gratis",
		["{count} free rename spins"] = "{count} spin nama gratis",
		["{xp} XP"] = "{xp} XP",
		["{scale}x XP for {minutes} minutes"] = "{scale}x XP selama {minutes} menit",
		["OPENED"] = "DIBUKA",
		["MISSED"] = "TERLEWAT",
		["A door opens each day from 1 to 25 December while playing. Missed doors stay shut."] = "Satu pintu terbuka setiap hari dari 1 sampai 25 Desember saat bermain. Pintu yang terlewat tetap tertutup.",
		["BACK"] = "KEMBALI",
		["AIM DOT"] = "TITIK BIDIK",
		["COLOUR"] = "WARNA",
		["OUTLINE"] = "GARIS TEPI",
		["DOT"] = "TITIK",
		["BRIGHTNESS"] = "KECERAHAN",
		["CUSTOM"] = "KUSTOM",
		["DEFAULT"] = "BAWAAN",
		["ON"] = "AKTIF",
		["OFF"] = "NONAKTIF",
		["Your blade is alight: {hits} hits."] = "Pedangmu menyala: {hits} serangan.",
		["Your blade\'s flame is out: wipe it again, then light it."] = "Api di pedangmu padam: lap lagi, lalu nyalakan.",
		["Your blade is waxed: hold it in a fire stand\'s flame."] = "Pedangmu sudah dilapisi lilin: dekatkan ke api tiang obor.",
		["{count} / {goal}"] = "{count} / {goal}",
		["The mist seals the way out: defeat the boss, or fall."] = "Kabut menyegel jalan keluar: kalahkan bos, atau gugur.",
		["The seal is broken: the way out is open."] = "Segel telah hancur: jalan keluar terbuka.",
		["LOCAL"] = "LOKAL",
		["DM"] = "DM",
		["GLOBAL"] = "GLOBAL",
		["SHOW"] = "TAMPILKAN",
		["HIDE"] = "SEMBUNYIKAN",
		["Sending too fast. Wait a moment."] = "Terlalu cepat mengirim. Tunggu sebentar.",
		["Message not sent."] = "Pesan tidak terkirim.",
		["Can\'t message this player."] = "Tidak bisa mengirim pesan ke pemain ini.",
		["Type a message"] = "Ketik pesan",
		["{key}   chat"] = "{key}   chat",
		["No other players in this server."] = "Tidak ada pemain lain di server ini.",
		["Type a code and press REDEEM. Each code works once."] = "Ketik kode lalu tekan TUKARKAN. Setiap kode hanya bisa dipakai sekali.",
		["ENTER CODE"] = "MASUKKAN KODE",
		["Type a code first."] = "Ketik kode dulu.",
