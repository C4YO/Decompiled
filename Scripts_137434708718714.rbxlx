		["BODY COLOURS: BELOW"] = "WARNA TUBUH: DI BAWAH",
		["BODY COLOURS"] = "WARNA TUBUH",
		["CLOSE"] = "TUTUP",
		["WEAPON SKIN"] = "SKIN SENJATA",
		["BLOOD SKIN"] = "SKIN DARAH",
		["WEAPON EFFECT"] = "EFEK SENJATA",
		["{item}   \194\183   {kind}"] = "{item}   \194\183   {kind}",
		["Owned and equipped."] = "Dimiliki dan dipakai.",
		["{chance}% chance to drop from the {boss}."] = "Peluang drop {chance}% dari {boss}.",
		["Only from a code (CODES, in the menu)."] = "Hanya dari kode (KODE, di menu).",
		["Only from the advent calendar, day {day}."] = "Hanya dari kalender Adven, hari {day}.",
		["Needs the Shamisen pass."] = "Perlu pass Shamisen.",
		["Only from the {quest} (QUESTS, in the menu)."] = "Hanya dari {quest} (MISI, di menu).",
		["Only from the quests (QUESTS, in the menu)."] = "Hanya dari misi (MISI, di menu).",
		["Not obtainable yet."] = "Belum bisa didapat.",
		["{chance}% chance to drop from {rarity} and higher rarity bots."] = "Peluang drop {chance}% dari bot {rarity} ke atas.",
		["Finish chapter {chapter} of the Path of the Sword, {name} (QUESTS, in the menu)."] = "Selesaikan bab {chapter} Jalan Pedang, {name} (MISI, di menu).",
		["Only from the Path of the Sword (QUESTS, in the menu)."] = "Hanya dari Jalan Pedang (MISI, di menu).",
		["Limited: no longer in the shop."] = "Terbatas: sudah tidak ada di toko.",
		["Limited: only in the shop until {date}."] = "Terbatas: hanya ada di toko sampai {date}.",
		["Limited: only in the shop for a while."] = "Terbatas: hanya ada di toko untuk sementara.",
		["Only sold for Robux."] = "Hanya dijual dengan Robux.",
		["Available to buy."] = "Bisa dibeli.",
		["Available to buy with ry\197\141 from level {level}, or with Robux now."] = "Bisa dibeli dengan ry\197\141 mulai level {level}, atau dengan Robux sekarang.",
		["Available to buy from level {level}."] = "Bisa dibeli mulai level {level}.",
		["BUY {price}"] = "BELI {price}",
		["NOT ON SALE"] = "TIDAK DIJUAL",
		["WEAPON"] = "SENJATA",
		["DRAW STYLE"] = "GAYA CABUT",
		["{short} Owned: equipped from the next spawn."] = "{short} Dimiliki: dipakai mulai spawn berikutnya.",
		["{short} Permanent unlock."] = "{short} Terbuka permanen.",
		["{short} Only sold for Robux. Permanent unlock."] = "{short} Hanya dijual dengan Robux. Terbuka permanen.",
		["Not enough ry\197\141: {amount} more to go."] = "Ry\197\141 tidak cukup: kurang {amount} lagi.",
		["Buy {name}?"] = "Beli {name}?",
		["Price: {price}. Balance: {have}."] = "Harga: {price}. Saldo: {have}.",
		["Buying..."] = "Membeli...",
		["DONE"] = "SELESAI",
		["Keep one of the names first."] = "Pilih salah satu nama dulu.",
		["SAVING"] = "MENYIMPAN",
		["Couldn\'t save. Try again."] = "Gagal menyimpan. Coba lagi.",
		["DAILY REWARD"] = "HADIAH HARIAN",
		["+1 free rename spin"] = "+1 spin nama gratis",
		["+{count} free rename spins"] = "+{count} spin nama gratis",
		["Day {day} in a row: {spins} spins a day."] = "Hari ke-{day} berturut-turut: {spins} spin sehari.",
		["Day {day} in a row. From day {from} you get {spins} a day."] = "Hari ke-{day} berturut-turut. Mulai hari ke-{from} kamu dapat {spins} sehari.",
		["MERRY CHRISTMAS"] = "SELAMAT NATAL",
		["A gift for playing on Christmas Day."] = "Hadiah karena bermain di hari Natal.",
		["DAILY BONUS"] = "BONUS HARIAN",
		["+{xp} XP"] = "+{xp} XP",
		["All daily quests done"] = "Semua misi harian selesai",
		["ADVENT CALENDAR"] = "KALENDER ADVEN",
		["Day {day} of 25"] = "Hari {day} dari 25",
		["no boost"] = "tanpa bonus",
		["{count} boost: +{walk} walk speed or +{other} to another stat"] = "{count} bonus: +{walk} kecepatan jalan atau +{other} untuk stat lain",
		["{count} boosts, each +{walk} walk speed or +{other} to another stat"] = "{count} bonus, masing-masing +{walk} kecepatan jalan atau +{other} untuk stat lain",
		["Safe zone: combat forbidden"] = "Zona aman: pertarungan dilarang",
		["Names and boosts"] = "Nama dan bonus",
		["<b>Family name</b>: rolled once, at the forge.\n<b>First name</b>: reroll any time on the character screen (CHARACTER, on the title screen).\n\nRarer family names give stat boosts. Boosts are kept small, so fights are still won with the blade."] = "<b>Nama keluarga</b>: diacak sekali, di tempat tempa.\n<b>Nama depan</b>: bisa diacak ulang kapan saja di layar karakter (KARAKTER, di layar judul).\n\nNama keluarga yang lebih langka memberi bonus stat. Bonus dibuat kecil agar pertarungan tetap dimenangkan dengan pedang.",
		["Rarity, odds and boosts:\n\n{rarities}\n\nThe rarest names belong to famous swordsmen and warlords. A Mythic name is a legend\'s own name, used in place of a family name. An Exotic name is a god\'s. Every spin is pure chance at these odds."] = "Kelangkaan, peluang, dan bonus:\n\n{rarities}\n\nNama paling langka milik pendekar dan panglima terkenal. Nama Mitos adalah nama sang legenda sendiri, dipakai sebagai pengganti nama keluarga. Nama Eksotis adalah nama dewa. Setiap spin murni untung-untungan dengan peluang ini.",
		["Boosts:\n\n<b>Walk speed</b>: faster movement.\n<b>Poise recovery</b>: poise refills faster.\n<b>Poise toughness</b>: all poise costs are lower.\n<b>Slower bleeding</b>: wounds and stumps bleed slower.\n<b>Faster dash recharge</b>: dash charges refill sooner.\n\nBoosts stack with forge upgrades."] = "Bonus:\n\n<b>Kecepatan jalan</b>: gerakan lebih cepat.\n<b>Pemulihan kuda-kuda</b>: kuda-kuda pulih lebih cepat.\n<b>Ketahanan kuda-kuda</b>: semua biaya kuda-kuda lebih rendah.\n<b>Pendarahan lebih lambat</b>: luka dan bekas potongan berdarah lebih lambat.\n<b>Isi ulang dash lebih cepat</b>: charge dash terisi lebih cepat.\n\nBonus bertumpuk dengan upgrade dari tempat tempa.",
		["<b>Rename spins</b> reroll the family name. Get {spins} free spins every level, or buy more in the SHOP. Use them on the character screen. The old name can always be kept.\n\nBots have names too. The rarer a bot\'s name, the better it fights."] = "<b>Spin nama</b> mengacak ulang nama keluarga. Dapatkan {spins} spin gratis setiap level, atau beli lebih banyak di TOKO. Pakai di layar karakter. Nama lama selalu bisa dipertahankan.\n\nBot juga punya nama. Makin langka nama bot, makin jago bertarungnya.",
		["Poise"] = "Kuda-kuda",
		["<b>Poise</b> is a fighter\'s steadiness. The poise bar is the thin bar above the blood squares; an opponent\'s is under their name. It grows from the middle as poise is lost, turning from gold to red, and hides at full poise."] = "<b>Kuda-kuda</b> adalah kekokohan petarung. Bar kuda-kuda adalah bar tipis di atas kotak darah; milik lawan ada di bawah namanya. Bar ini melebar dari tengah saat kuda-kuda berkurang, berubah dari emas menjadi merah, dan hilang saat kuda-kuda penuh.",
		["Poise costs:\n\n<b>Draw-cut</b>: {draw}.  <b>Blade hit by a draw-cut</b>: {block}.\n<b>Hard swing</b>: {swing}.  <b>Dash</b>: {dash}.  <b>Kick</b>: {kick}.\n<b>Taking a cut</b>: {wound} (double from a draw-cut), plus blood loss.\n<b>Clashes</b>: more the harder the blade is knocked."] = "Biaya kuda-kuda:\n\n<b>Tebasan cabut</b>: {draw}.  <b>Pedang yang terkena tebasan cabut</b>: {block}.\n<b>Ayunan keras</b>: {swing}.  <b>Dash</b>: {dash}.  <b>Sepakan</b>: {kick}.\n<b>Terkena tebasan</b>: {wound} (dua kali lipat dari tebasan cabut), ditambah kehilangan darah.\n<b>Benturan</b>: makin keras pedang terpental, makin banyak.",
		["Poise refills after {delay} seconds with no poise lost, at {regen} per second. A still guard (L2 on a gamepad) refills it faster; low blood refills it slower.\n\nBelow half poise, blade and movement speed drop, and the blade is knocked aside more easily."] = "Kuda-kuda pulih setelah {delay} detik tanpa kehilangan kuda-kuda, sebanyak {regen} per detik. Posisi bertahan diam (L2 di gamepad) mempercepat pemulihan; darah yang sedikit memperlambatnya.\n\nDi bawah setengah kuda-kuda, kecepatan pedang dan gerakan turun, dan pedang lebih mudah terpental.",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> ({Wipe}). See the next scroll."] = "Saat habis, kuda-kuda <b>hancur</b>: terhuyung selama {stagger} detik, lalu lemah selama {weakened} detik ({slower} lebih lambat, kehabisan napas, tepi layar menggelap). Setelah itu kuda-kuda pulih sampai setengah.\n\nCara tercepat memulihkan kuda-kuda sampai penuh adalah <b>mengelap pedang</b> ({Wipe}). Lihat gulungan berikutnya.",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> (WIPE). See the next scroll."] = "Saat habis, kuda-kuda <b>hancur</b>: terhuyung selama {stagger} detik, lalu lemah selama {weakened} detik ({slower} lebih lambat, kehabisan napas, tepi layar menggelap). Setelah itu kuda-kuda pulih sampai setengah.\n\nCara tercepat memulihkan kuda-kuda sampai penuh adalah <b>mengelap pedang</b> (LAP). Lihat gulungan berikutnya.",
		["Wiping the blade"] = "Mengelap pedang",
		["Cuts leave blood on the blade. With the blade drawn, press <b>{Wipe}</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "Tebasan meninggalkan darah di pedang. Saat pedang tercabut, tekan <b>{Wipe}</b> untuk mengelapnya dengan kain, satu sisi lalu sisi lainnya. Mengelap butuh sekitar {time} detik.",
		["<b>Wiping restores poise.</b> During a wipe, poise refills at {times}x speed, and a finished wipe fills it to full.\n\nAfter a poise break, a finished wipe also ends the weakened state."] = "<b>Mengelap memulihkan kuda-kuda.</b> Selama mengelap, kuda-kuda pulih dengan kecepatan {times}x, dan lap yang selesai mengisinya sampai penuh.\n\nSetelah kuda-kuda hancur, lap yang selesai juga mengakhiri kondisi lemah.",
		["<b>Wiping leaves an opening.</b> Once a wipe starts, steering, guarding and cutting are locked until it ends, and a swing into the loose blade knocks it far aside. Losing poise mid-wipe cancels the full refill.\n\nBots punish wipes. Make some distance first.\n\nA later forge rank unlocks a quicker wipe."] = "<b>Mengelap membuka celah.</b> Begitu lap dimulai, mengarahkan pedang, bertahan, dan menebas terkunci sampai lap selesai, dan ayunan ke pedang yang longgar membuatnya terpental jauh. Kehilangan kuda-kuda di tengah lap membatalkan pemulihan penuh.\n\nBot menghukum yang sedang mengelap. Cari jarak dulu.\n\nTingkat tempa yang lebih tinggi membuka lap yang lebih cepat.",
		["Cuts leave blood on the blade. With the blade drawn, tap <b>WIPE</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "Tebasan meninggalkan darah di pedang. Saat pedang tercabut, ketuk <b>LAP</b> untuk mengelapnya dengan kain, satu sisi lalu sisi lainnya. Mengelap butuh sekitar {time} detik.",
		["Drawing the sword"] = "Mencabut pedang",
		["The sword starts sheathed, with a hand on the sheath, ready to draw.\n\n<b>{Lock}</b>: toggle lock-on. While locked on, the mouse picks the cut; its name shows at the bottom of the screen.\n<b>{NextTarget}</b>: switch target.\n<b>{Unequip}</b>: unequip the sword. <b>{Equip}</b>: equip it again."] = "Pedang mulai dalam keadaan tersarung, dengan tangan di sarung, siap dicabut.\n\n<b>{Lock}</b>: nyalakan atau matikan kunci target. Saat kunci target aktif, mouse memilih tebasan; namanya muncul di bagian bawah layar.\n<b>{NextTarget}</b>: ganti target.\n<b>{Unequip}</b>: lepas pedang. <b>{Equip}</b>: pegang pedang lagi.",
		["Move the mouse to pick the cut, then hold {Draw} and swipe:\n\n<b>Down-left</b>, swipe up-right: low cut.\n<b>Left</b>, swipe right: horizontal slice.\n<b>Up-left</b>, swipe down-right: diagonal cut.\n<b>Up</b>, swipe down: vertical slice.\n\nA faster swipe makes a faster cut.\n\n<b>{CalmDraw}</b>: calm draw. The blade slides out slowly into a guard, with no cut."] = "Gerakkan mouse untuk memilih tebasan, lalu tahan {Draw} dan geser:\n\n<b>Kiri bawah</b>, geser ke kanan atas: tebasan bawah.\n<b>Kiri</b>, geser ke kanan: tebasan horizontal.\n<b>Kiri atas</b>, geser ke kanan bawah: tebasan diagonal.\n<b>Atas</b>, geser ke bawah: tebasan vertikal.\n\nMakin cepat geseran, makin cepat tebasan.\n\n<b>{CalmDraw}</b>: cabut pelan. Pedang keluar perlahan ke posisi bertahan, tanpa menebas.",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>{Equip}</b>: put the blade away. The next draw is ready about a second later."] = "Tebasan cabut dipegang kuat. Pedang yang terkena tebasan cabut terpental dan kehilangan {block} kuda-kuda. Setiap tebasan cabut menguras {draw} kuda-kuda.\n\n<b>{Equip}</b>: sarungkan pedang. Cabutan berikutnya siap sekitar satu detik kemudian.",
		["The sword starts sheathed, with a hand on the sheath, ready to draw. While locked on, a slow drag on the right side of the screen moves the hand on the sheath, and a quick <b>flick</b> draws. The flick\'s direction picks the cut.\n\n<b>LOCKED ON</b>: tap to switch target, hold to turn lock-on off. <b>LOCK ON</b>: tap to turn it back on.\n<b>UNEQUIP</b>: hold to unequip the sword. <b>EQUIP</b>: tap to equip it again."] = "Pedang mulai dalam keadaan tersarung, dengan tangan di sarung, siap dicabut. Saat kunci target aktif, seretan pelan di sisi kanan layar menggerakkan tangan di sarung, dan <b>geseran cepat</b> mencabut pedang. Arah geseran menentukan tebasan.\n\n<b>TERKUNCI</b>: ketuk untuk ganti target, tahan untuk mematikan kunci target. <b>KUNCI</b>: ketuk untuk menyalakannya lagi.\n<b>LEPAS</b>: tahan untuk melepas pedang. <b>PEGANG</b>: ketuk untuk memegangnya lagi.",
		["<b>Flick right</b>: horizontal slice.\n<b>Flick down</b>: vertical slice.\n<b>Flick up-right</b>: low cut.\n\n<b>CALM DRAW</b>: the blade slides out slowly into a guard, with no cut."] = "<b>Geser cepat ke kanan</b>: tebasan horizontal.\n<b>Geser cepat ke bawah</b>: tebasan vertikal.\n<b>Geser cepat ke kanan atas</b>: tebasan bawah.\n\n<b>CABUT PELAN</b>: pedang keluar perlahan ke posisi bertahan, tanpa menebas.",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>SHEATHE</b>: put the blade away. The next draw is ready about a second later."] = "Tebasan cabut dipegang kuat. Pedang yang terkena tebasan cabut terpental dan kehilangan {block} kuda-kuda. Setiap tebasan cabut menguras {draw} kuda-kuda.\n\n<b>SARUNG</b>: sarungkan pedang. Cabutan berikutnya siap sekitar satu detik kemudian.",
		["Clashes and parries"] = "Benturan dan tangkisan",
		["Blades that meet push each other apart, and the firmer blade moves less. A hard swing knocks a still blade far aside, and that blade is slow to recover: an opening to attack.\n\nHit near the hands, a blade barely moves. Hit near the tip, it\'s knocked aside easily."] = "Pedang yang beradu saling mendorong, dan pedang yang dipegang lebih kuat bergeser lebih sedikit. Ayunan keras membuat pedang yang diam terpental jauh, dan pedang itu lambat pulih: celah untuk menyerang.\n\nJika terkena di dekat tangan, pedang hampir tidak bergeser. Jika terkena di dekat ujung, pedang mudah terpental.",
		["<b>Draw-cuts</b> hit hardest. A blade held still that meets a draw-cut, or the drawer while the blade comes out, is knocked aside, and the cut goes through.\n\n<b>A still guard</b> (L2 on a gamepad) parries other swings: the swing bounces off and the attacker is staggered.\n\n<b>Two swings meeting</b> both give way, and neither can cut for a moment.\n\nThe whole sword can clash, handle included."] = "<b>Tebasan cabut</b> menghantam paling keras. Pedang yang diam dan terkena tebasan cabut, atau mengenai si pencabut saat pedangnya keluar, akan tertepis, dan tebasannya tembus.\n\n<b>Posisi bertahan diam</b> (L2 di gamepad) menangkis ayunan lain: ayunan terpantul dan penyerangnya terhuyung.\n\n<b>Dua ayunan yang beradu</b> sama-sama mengalah, dan tidak ada yang bisa menebas sesaat.\n\nSeluruh pedang bisa beradu, termasuk gagangnya.",
		["Cuts, wounds and bleeding"] = "Tebasan, luka, dan pendarahan",
		["A cut needs speed and a leading edge. Speed comes from the swing and from movement, so dashing past counts. A sudden change of direction hits with the flat.\n\nOnly a blade moving into a target counts. A blade left resting in a body sticks."] = "Tebasan butuh kecepatan dan sisi tajam di depan. Kecepatan berasal dari ayunan dan gerakan, jadi dash melewati lawan juga dihitung. Perubahan arah mendadak memukul dengan sisi datar.\n\nHanya pedang yang bergerak masuk ke target yang dihitung. Pedang yang dibiarkan diam di tubuh akan tersangkut.",
		["A fast, edge-first cut all the way through a limb <b>severs</b> it. Through the head or torso: <b>a kill</b>.\n\nAnything less is a <b>wound</b>: it bleeds and slows the limb. Deeper wounds are worse.\n\n<b>Stabs</b> never kill outright. A stab to the head, or a fast one to the body (dash or lunge in), takes a lot of blood at once. Other stabs wound."] = "Tebasan cepat dengan sisi tajam di depan yang menembus anggota tubuh sepenuhnya akan <b>memutusnya</b>. Tembus kepala atau badan: <b>kill</b>.\n\nKurang dari itu adalah <b>luka</b>: berdarah dan memperlambat anggota tubuh itu. Luka yang lebih dalam lebih parah.\n\n<b>Tusukan</b> tidak pernah langsung membunuh. Tusukan ke kepala, atau tusukan cepat ke badan (dash atau menerjang masuk), menguras banyak darah sekaligus. Tusukan lain melukai.",
		["Every fighter has {squares} squares of blood. Wounds bleed for a few seconds, and so does a lost limb. With two limbs lost, the stumps bleed out. Losing both arms drops the katana.\n\nCombat is allowed in the arena and the forest, except in safe zones. Inside one, the screen shows <b>{safe}</b>."] = "Setiap petarung punya {squares} kotak darah. Luka berdarah selama beberapa detik, begitu juga anggota tubuh yang putus. Jika dua anggota tubuh putus, bekas potongannya berdarah sampai mati. Kehilangan kedua lengan membuat katana jatuh.\n\nPertarungan diizinkan di arena dan hutan, kecuali di zona aman. Di dalam zona aman, layar menampilkan <b>{safe}</b>.",
		["The forge and levels"] = "Tempat tempa dan level",
		["XP rewards:\n\n<b>Wounding a player</b>: {wound}.\n<b>Severing a limb</b>: {sever}.\n<b>A kill</b>: {kill}.\n<b>Defeating a bot</b>: {botLeast} to {botMost}, more for rarer names.\n\nEach level needs a little more XP than the last. No level cap."] = "Hadiah XP:\n\n<b>Melukai pemain</b>: {wound}.\n<b>Memutus anggota tubuh</b>: {sever}.\n<b>Kill</b>: {kill}.\n<b>Mengalahkan bot</b>: {botLeast} sampai {botMost}, lebih banyak untuk nama yang lebih langka.\n\nSetiap level butuh sedikit lebih banyak XP daripada level sebelumnya. Tanpa batas level.",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, press E at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "<b>Tingkat tempa</b> baru terbuka setiap {levels} level. Di tempat tempa, di selatan arena, tekan E di landasan untuk memanaskan, menempa, dan mencelupkan pedang. Setiap tingkat memberi pedang tampilan baru dan upgrade baru.\n\nDinding pedang di sini menunjukkan pedang dari setiap tingkat tempa.\n\n<b>Tempa ulang</b> untuk kembali ke tingkat mana pun yang sudah ditempa.",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, tap <b>Forge your blade</b> at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "<b>Tingkat tempa</b> baru terbuka setiap {levels} level. Di tempat tempa, di selatan arena, ketuk <b>Tempa pedangmu</b> di landasan untuk memanaskan, menempa, dan mencelupkan pedang. Setiap tingkat memberi pedang tampilan baru dan upgrade baru.\n\nDinding pedang di sini menunjukkan pedang dari setiap tingkat tempa.\n\n<b>Tempa ulang</b> untuk kembali ke tingkat mana pun yang sudah ditempa.",
		["Kill streaks"] = "Kill streak",
		["A <b>kill streak</b> counts kills in a row without dying, shown at the top right. Bleed-outs from a cut count, and so do bot kills. Dying ends the streak, but the best one is saved."] = "<b>Kill streak</b> menghitung kill berturut-turut tanpa mati, ditampilkan di kanan atas. Kematian karena kehabisan darah akibat tebasan ikut dihitung, begitu juga kill bot. Mati mengakhiri streak, tapi rekor terbaik disimpan.",
		["The streak catches fire as it grows, and every ten kills earns a title. Every {every} kills up to {most}: +{share} walk speed and poise recovery (Mythic names +{mythic}, Exotic names +{exotic}).\n\nNo prizes: it\'s for the glory.\n\nAfter dying, <b>SPECTATE</b> watches other fighters and <b>RESPAWN</b> returns to the fight."] = "Streak menyala saat bertambah, dan setiap sepuluh kill memberi gelar. Setiap {every} kill hingga {most}: +{share} kecepatan jalan dan pemulihan kuda-kuda (nama Mitos +{mythic}, Eksotis +{exotic}).\n\nTanpa hadiah: ini demi kejayaan.\n\nSetelah mati, <b>TONTON</b> untuk menonton petarung lain dan <b>RESPAWN</b> untuk kembali ke pertarungan.",
		["TO WHOEVER FREED THIS TEMPLE"] = "UNTUK SIAPA PUN YANG MEMBEBASKAN KUIL INI",
		["Her blade still rests within these walls. Search every corner."] = "Pedangnya masih tersimpan di balik tembok-tembok ini. Telusuri setiap sudut.",
		["YOU  {mine}  :  {theirs}  {name}"] = "KAMU  {mine}  :  {theirs}  {name}",
		["1V1 \194\183 ROUND {round} \194\183 FIRST TO {wins}"] = "1V1 \194\183 RONDE {round} \194\183 PERTAMA CAPAI {wins}",
		["1V1 \194\183 FIRST TO {wins} KILLS"] = "1V1 \194\183 PERTAMA CAPAI {wins} KILL",
		["Lock on to {name} to bow back."] = "Kunci {name} untuk membalas hormat.",
		["BOW BACK"] = "BALAS HORMAT",
		["ACCEPT"] = "TERIMA",
		["{key}   BOW BACK"] = "{key}   BALAS HORMAT",
		["{key}   ACCEPT"] = "{key}   TERIMA",
		["DECLINE"] = "TOLAK",
		["{key}   DECLINE"] = "{key}   TOLAK",
		["1V1 BOW"] = "HORMAT 1V1",
		["1V1 REMATCH"] = "REMATCH 1V1",
		["1V1 CHALLENGE"] = "TANTANGAN 1V1",
		["{name} bows to you"] = "{name} memberi hormat padamu",
		["{name} wants a rematch"] = "{name} ingin rematch",
		["{name} challenges you"] = "{name} menantangmu",
		["{name} bowed back: the 1v1 begins."] = "{name} membalas hormat: 1v1 dimulai.",
		["They bowed back: the 1v1 begins."] = "Lawan membalas hormat: 1v1 dimulai.",
		["FIGHT"] = "BERTARUNG!",
		["DRAW"] = "SERI",
		["No winner in {seconds} seconds: the round again."] = "Tak ada pemenang dalam {seconds} detik: ronde diulang.",
		["They stayed out of the ring: a point to you."] = "Lawan keluar dari ring: satu poin untukmu.",
		["You stayed out of the ring: a point to them."] = "Kamu keluar dari ring: satu poin untuk lawan.",
		["They left the 1v1."] = "Lawan meninggalkan 1v1.",
		["They forfeited."] = "Lawan menyerah.",
		["You forfeited."] = "Kamu menyerah.",
		["+{xp} XP   {why}"] = "+{xp} XP   {why}",
		["NO RESULT"] = "TANPA HASIL",
		["The 1v1 couldn\'t go on."] = "1v1 tidak bisa dilanjutkan.",
