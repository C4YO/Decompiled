	}
}
v87.TouchPages = v95
v63.Wiping = v87
local v96 = {
	["Title"] = v10("Drawing the sword")
}
local v97 = {}
local v98, v99 = v10("The sword starts sheathed, with a hand on the sheath, ready to draw.\n\n<b>{Lock}</b>: toggle lock-on. While locked on, the mouse picks the cut; its name shows at the bottom of the screen.\n<b>{NextTarget}</b>: switch target.\n<b>{Unequip}</b>: unequip the sword. <b>{Equip}</b>: equip it again.")
local v100 = {
	["Text"] = v98,
	["Args"] = v99
}
local v101, v102 = v10("Move the mouse to pick the cut, then hold {Draw} and swipe:\n\n<b>Down-left</b>, swipe up-right: low cut.\n<b>Left</b>, swipe right: horizontal slice.\n<b>Up-left</b>, swipe down-right: diagonal cut.\n<b>Up</b>, swipe down: vertical slice.\n\nA faster swipe makes a faster cut.\n\n<b>{CalmDraw}</b>: calm draw. The blade slides out slowly into a guard, with no cut.")
__set_list(v97, 1, {v100, {
	["Text"] = v101,
	["Args"] = v102
}, {
	["Text"] = v10("Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>{Equip}</b>: put the blade away. The next draw is ready about a second later."),
	["Args"] = v49
}})
v96.Pages = v97
local v103 = {}
local v104, v105 = v10("The sword starts sheathed, with a hand on the sheath, ready to draw. While locked on, a slow drag on the right side of the screen moves the hand on the sheath, and a quick <b>flick</b> draws. The flick\'s direction picks the cut.\n\n<b>LOCKED ON</b>: tap to switch target, hold to turn lock-on off. <b>LOCK ON</b>: tap to turn it back on.\n<b>UNEQUIP</b>: hold to unequip the sword. <b>EQUIP</b>: tap to equip it again.")
local v106 = {
	["Text"] = v104,
	["Args"] = v105
}
local v107, v108 = v10("<b>Flick right</b>: horizontal slice.\n<b>Flick down</b>: vertical slice.\n<b>Flick up-right</b>: low cut.\n\n<b>CALM DRAW</b>: the blade slides out slowly into a guard, with no cut.")
__set_list(v103, 1, {v106, {
	["Text"] = v107,
	["Args"] = v108
}, {
	["Text"] = v10("Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>SHEATHE</b>: put the blade away. The next draw is ready about a second later."),
	["Args"] = v49
}})
v96.TouchPages = v103
v63.Draws = v96
local v109 = {
	["Title"] = v10("Clashes and parries")
}
local v110 = {}
local v111, v112 = v10("Blades that meet push each other apart, and the firmer blade moves less. A hard swing knocks a still blade far aside, and that blade is slow to recover: an opening to attack.\n\nHit near the hands, a blade barely moves. Hit near the tip, it\'s knocked aside easily.")
local v113 = {
	["Text"] = v111,
	["Args"] = v112
}
local v114, v115 = v10("<b>Draw-cuts</b> hit hardest. A blade held still that meets a draw-cut, or the drawer while the blade comes out, is knocked aside, and the cut goes through.\n\n<b>A still guard</b> (L2 on a gamepad) parries other swings: the swing bounces off and the attacker is staggered.\n\n<b>Two swings meeting</b> both give way, and neither can cut for a moment.\n\nThe whole sword can clash, handle included.")
__set_list(v110, 1, {v113, {
	["Text"] = v114,
	["Args"] = v115
}})
v109.Pages = v110
v63.Clashes = v109
local v116 = {
	["Title"] = v10("Cuts, wounds and bleeding")
}
local v117 = {}
local v118, v119 = v10("A cut needs speed and a leading edge. Speed comes from the swing and from movement, so dashing past counts. A sudden change of direction hits with the flat.\n\nOnly a blade moving into a target counts. A blade left resting in a body sticks.")
local v120 = {
	["Text"] = v118,
	["Args"] = v119
}
local v121, v122 = v10("A fast, edge-first cut all the way through a limb <b>severs</b> it. Through the head or torso: <b>a kill</b>.\n\nAnything less is a <b>wound</b>: it bleeds and slows the limb. Deeper wounds are worse.\n\n<b>Stabs</b> never kill outright. A stab to the head, or a fast one to the body (dash or lunge in), takes a lot of blood at once. Other stabs wound.")
__set_list(v117, 1, {v120, {
	["Text"] = v121,
	["Args"] = v122
}, {
	["Text"] = v10("Every fighter has {squares} squares of blood. Wounds bleed for a few seconds, and so does a lost limb. With two limbs lost, the stumps bleed out. Losing both arms drops the katana.\n\nCombat is allowed in the arena and the forest, except in safe zones. Inside one, the screen shows <b>{safe}</b>."),
	["Args"] = function() -- name: bloodArgs
		-- upvalues: (copy) v_u_6, (copy) v_u_11
		local v123 = {}
		local v124 = v_u_6.Blood.Max / 10 + 0.5
		v123.squares = math.floor(v124)
