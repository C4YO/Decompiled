		["No answer from the server. Try again."] = "Server tidak menjawab. Coba lagi.",
		["Redeemed: {reward}"] = "Berhasil ditukar: {reward}",
		["REDEEM"] = "TUKARKAN",
		["YES"] = "YA",
		["NO"] = "TIDAK",
		["CHARACTER"] = "KARAKTER",
		["APPEARANCE"] = "PENAMPILAN",
		["HAIR AND OUTFIT"] = "RAMBUT DAN PAKAIAN",
		["NAME"] = "NAMA",
		["LOADOUT"] = "LOADOUT",
		["Pick a first name or spin a new family name ({count} spin)."] = "Pilih nama depan atau spin nama keluarga baru ({count} spin).",
		["Pick a first name or spin a new family name ({count} spins)."] = "Pilih nama depan atau spin nama keluarga baru ({count} spin).",
		["Spin a new family name ({count} spin)."] = "Spin nama keluarga baru ({count} spin).",
		["Spin a new family name ({count} spins)."] = "Spin nama keluarga baru ({count} spin).",
		["CUSTOMISE APPEARANCE"] = "ATUR PENAMPILAN",
		["Hair, outfit, accessory, face, skins, effects and colours."] = "Rambut, pakaian, aksesori, wajah, skin, efek, dan warna.",
		["CUSTOMISE NAME"] = "ATUR NAMA",
		["Select draw style or change weapon."] = "Pilih gaya cabut atau ganti senjata.",
		["SKIP ANIMATION"] = "LEWATI ANIMASI",
		["ROLL ALL"] = "SPIN SEMUA",
		["SPIN AGAIN \194\183 {count}"] = "SPIN LAGI \194\183 {count}",
		["SPIN FAMILY NAME \194\183 {count}"] = "SPIN NAMA KELUARGA \194\183 {count}",
		["NEW FAMILY NAME"] = "NAMA KELUARGA BARU",
		["KEEP {name}"] = "PILIH {name}",
		["No rename spins left: {count} each level up, and more in the SHOP."] = "Spin nama habis: {count} setiap naik level, dan lebih banyak di TOKO.",
		["No rename spins left: {count} each level up."] = "Spin nama habis: {count} setiap naik level.",
