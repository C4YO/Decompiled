		["Kill streak lost: safe zone"] = "\208\161\208\181\209\128\208\184\209\143 \209\131\208\177\208\184\208\185\209\129\209\130\208\178 \208\190\208\177\208\190\209\128\208\178\208\176\208\187\208\176\209\129\209\140: \208\177\208\181\208\183\208\190\208\191\208\176\209\129\208\189\208\176\209\143 \208\183\208\190\208\189\208\176",
