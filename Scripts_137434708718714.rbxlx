		["Walk onto the straw mat with **WASD**."] = "Marche sur la natte de paille avec **WASD**.",
		["WALK ONTO THE MAT"] = "MARCHE SUR LA NATTE",
		["Walk onto the straw mat with the **thumbstick**."] = "Marche sur la natte de paille avec le **joystick**.",
		["Horizontal slice"] = "Coupe horizontale",
		["Walk up close. Move the mouse **left**. Then **hold {Draw}** and **swipe right**."] = "Approche-toi. D\195\169place la souris **\195\160 gauche**. Puis **maintiens {Draw}** et **glisse \195\160 droite**.",
		["MOVE LEFT"] = "\195\128 GAUCHE",
		["SWIPE RIGHT"] = "GLISSE \195\128 DROITE",
		["Walk up close. Then **flick right** on the right side of the screen."] = "Approche-toi. Puis **balaie \195\160 droite** sur le c\195\180t\195\169 droit de l\'\195\169cran.",
		["Sheathe the sword"] = "Rengaine le sabre",
		["Press **{Equip}** to sheathe the blade. Every draw starts from the sheath."] = "Appuie sur **{Equip}** pour rengainer la lame. Chaque d\195\169gainage part du fourreau.",
		["PRESS {Equip}"] = "APPUIE SUR {Equip}",
		["Tap **SHEATHE** to sheathe the blade. Every draw starts from the sheath."] = "Touche **RANGER** pour rengainer la lame. Chaque d\195\169gainage part du fourreau.",
		["TAP SHEATHE"] = "TOUCHE RANGER",
		["Vertical slice"] = "Coupe verticale",
		["Walk up close. Move the mouse **up**. Then **hold {Draw}** and **swipe down**."] = "Approche-toi. D\195\169place la souris **vers le haut**. Puis **maintiens {Draw}** et **glisse vers le bas**.",
		["MOVE UP"] = "EN HAUT",
		["SWIPE DOWN"] = "GLISSE VERS LE BAS",
		["Walk up close. Then **flick down** on the right side of the screen."] = "Approche-toi. Puis **balaie vers le bas** sur le c\195\180t\195\169 droit de l\'\195\169cran.",
		["FLICK DOWN"] = "BALAIE VERS LE BAS",
		["Weakened: wipe the blade"] = "Affaibli\194\160: essuie la lame",
		["Poise broken: **weakened** (slow, no jumping). Press **{Wipe}** to wipe the blade and recover."] = "\195\137quilibre bris\195\169 : **affaibli** (lent, pas de saut). Appuie sur **{Wipe}** pour essuyer la lame et r\195\169cup\195\169rer.",
		["PRESS {Wipe}"] = "APPUIE SUR {Wipe}",
		["Poise broken: **weakened** (slow, no jumping). Tap **WIPE** to wipe the blade and recover."] = "\195\137quilibre bris\195\169 : **affaibli** (lent, pas de saut). Touche **ESSUYER** pour essuyer la lame et r\195\169cup\195\169rer.",
		["TAP WIPE"] = "TOUCHE ESSUYER",
		["Dash attack"] = "Attaque en ru\195\169e",
		["Blade out, walk up close. Hold **W + A** to walk past the watermelon, then press **{Dash}** to dash through it."] = "Lame sortie, approche-toi. Maintiens **W + A** pour passer \195\160 c\195\180t\195\169 de la past\195\168que, puis appuie sur **{Dash}** pour la traverser en ru\195\169e.",
		["HOLD W + A"] = "MAINTIENS W + A",
		["PRESS {Dash}"] = "APPUIE SUR {Dash}",
		["Blade out, walk up close. Walk past the watermelon, then tap **DASH** to dash through it."] = "Lame sortie, approche-toi. Passe \195\160 c\195\180t\195\169 de la past\195\168que, puis touche **RU\195\137E** pour la traverser en ru\195\169e.",
		["WALK PAST IT"] = "PASSE \195\128 C\195\148T\195\137",
		["TAP DASH"] = "TOUCHE RU\195\137E",
		["That was the low cut"] = "C\'\195\169tait la coupe basse",
		["That was the horizontal slice"] = "C\'\195\169tait la coupe horizontale",
		["That was a diagonal cut"] = "C\'\195\169tait une coupe diagonale",
		["That was the vertical slice"] = "C\'\195\169tait la coupe verticale",
		["That was another draw"] = "C\'\195\169tait un autre d\195\169gainage",
		["That was a swing"] = "C\'\195\169tait un simple coup",
		["move the mouse **left**, then **hold {Draw}** and **swipe right**"] = "d\195\169place la souris **\195\160 gauche**, puis **maintiens {Draw}** et **glisse \195\160 droite**",
		["move the mouse **up**, then **hold {Draw}** and **swipe down**"] = "d\195\169place la souris **vers le haut**, puis **maintiens {Draw}** et **glisse vers le bas**",
		["draw again"] = "d\195\169gaine \195\160 nouveau",
		["**flick right** on the right side of the screen"] = "**balaie \195\160 droite** sur le c\195\180t\195\169 droit de l\'\195\169cran",
		["**flick down** on the right side of the screen"] = "**balaie vers le bas** sur le c\195\180t\195\169 droit de l\'\195\169cran",
		["Rusted, the cord rotten"] = "Rouill\195\169, le cordon pourri",
		["Rust polished away"] = "Rouille effac\195\169e au polissage",
		["Black silk on the handle and cords"] = "Soie noire sur la poign\195\169e et les cordons",
		["Bright silver fittings"] = "Garnitures en argent brillant",
		["Black lacquered sheath"] = "Fourreau laqu\195\169 noir",
		["Temper line polished, purple silk"] = "Ligne de trempe polie, soie violette",
		["Best of 5: the first to {wins} round wins."] = "Au meilleur des 5\194\160: le premier \195\160 {wins} manches l\'emporte.",
		["Every attack is a draw-cut that strikes through any blade. No guard."] = "Chaque attaque est une coupe au d\195\169gainage qui traverse toute lame. Pas de garde.",
		["Fight from the sheath: every draw-cut strikes through any blade, and the blade goes straight back in."] = "Combats depuis le fourreau\194\160: chaque coupe au d\195\169gainage traverse toute lame, et la lame retourne aussit\195\180t au fourreau.",
		["10 rename spins"] = "10 tirages de nom",
		["50 rename spins"] = "50 tirages de nom",
		["Each column is a string: hold a key, then pluck that string."] = "Chaque colonne est une corde : maintiens une touche, puis pince cette corde.",
		["TACHI restored: stage {stage}, {name}"] = "TACHI restaur\195\169 : \195\169tape {stage}, {name}",
		["You can only bow for a 1v1 with someone you could fight right now, in the same ring."] = "Tu ne peux saluer pour un 1v1 que quelqu\'un que tu pourrais combattre maintenant, dans le m\195\170me ring.",
		["The rematch can\'t start: you both need to be in the same ring."] = "La revanche ne peut pas commencer\194\160: vous devez \195\170tre tous les deux dans le m\195\170me ring.",
		["Positions 1 to 9: hold one, then pluck."] = "Positions 1 \195\160 9 : maintiens-en une, puis pince.",
		["Finish a daily quest"] = "Termine une qu\195\170te du jour",
		["VENGEFUL EMPRESS"] = "IMP\195\137RATRICE VENGERESSE",
		["THE TEMPLE GHOST"] = "LE FANT\195\148ME DU TEMPLE",
		["Reroll your first name as often as you like, or spin a new family name ({count} spin)."] = "Relance ton pr\195\169nom autant que tu veux, ou tire un nouveau nom de famille ({count} tirage).",
		["Reroll your first name as often as you like, or spin a new family name ({count} spins)."] = "Relance ton pr\195\169nom autant que tu veux, ou tire un nouveau nom de famille ({count} tirages).",
		["Reroll your first name as often as you like."] = "Relance ton pr\195\169nom autant que tu veux.",
		["REROLL FIRST NAME"] = "RELANCER LE PR\195\137NOM",
		["Couldn\'t roll. Try again."] = "Tirage impossible. R\195\169essaie.",
		["REROLL"] = "RELANCER",
		["Roll a first name first."] = "Tire d\'abord un pr\195\169nom.",
		["RARER THAN YOURS"] = "PLUS RARE QUE LE TIEN",
		["LEGENDARY AND UP"] = "L\195\137GENDAIRE ET PLUS",
		["ASK TWICE FOR EXOTIC"] = "DOUBLE ALERTE EXOTIQUE",
		["{on} OF {all}"] = "{on} SUR {all}",
		["Asks before a spin throws away a family name."] = "Demande avant qu\'un tirage ne jette un nom de famille.",
		["You\'ll lose {names} and {count} more."] = "Tu perdras {names} et {count} autres.",
		["You\'ll lose {names}."] = "Tu perdras {names}.",
		["Are you sure?"] = "Tu es s\195\187r ?",
		["{names} will be gone for good."] = "{names} sera perdu pour de bon.",
		["Peaceful: out in the forest nobody can hurt you, and you can\'t hurt anyone. In the rings you fight as usual."] = "Pacifique : dans la for\195\170t, personne ne peut te blesser et tu ne peux blesser personne. Dans les rings, tu combats comme d\'habitude.",
		["Peaceful: nobody can hurt you, and you can\'t hurt anyone. In the beginners\' ring and the boss arena you fight as usual."] = "Pacifique : personne ne peut te blesser et tu ne peux blesser personne. Dans le ring des d\195\169butants et l\'ar\195\168ne du boss, tu combats comme d\'habitude.",
		["BONFIRE"] = "FEU DE CAMP",
		["LAST LOCATION"] = "DERNIER EMPLACEMENT",
		["Outside the ring: sword lowered"] = "Hors du ring : sabre baiss\195\169",
		["Outside the ring: sword sheathed"] = "Hors du ring\194\160: sabre rengain\195\169",
		["Find bonfires out in the world to travel between them."] = "Trouve des feux de camp dans le monde pour voyager entre eux.",
		["Tap a bonfire you\'ve found to travel there."] = "Touche un feu de camp que tu as trouv\195\169 pour y voyager.",
		["Click a bonfire you\'ve found to travel there."] = "Clique sur un feu de camp que tu as trouv\195\169 pour y voyager.",
		["Bonfire found: {name}"] = "Feu de camp trouv\195\169 : {name}",
		["Rested at {name}. You\'ll start here when you next play."] = "Repos \195\160 {name}. Tu commenceras ici la prochaine fois que tu joueras.",
		["You haven\'t found that bonfire yet."] = "Tu n\'as pas encore trouv\195\169 ce feu de camp.",
		["{upgrade}.  {look}"] = "{upgrade}.  {look}",
		["REFORGE"] = "REFORGER",
		["Forge your next upgrade, or reforge your blade to a rank you\'ve already forged."] = "Forge ta prochaine am\195\169lioration, ou reforge ta lame vers un rang d\195\169j\195\160 forg\195\169.",
		["FORGE RANK {rank}   {name}"] = "FORGER LE RANG {rank}   {name}",
		["unlocks at level {level} (you\'re level {yours})"] = "se d\195\169bloque au niveau {level} (tu es niveau {yours})",
		["RANK {rank}   {name}   (in use)"] = "RANG {rank}   {name}   (utilis\195\169)",
		["Dark blade, crimson edge, red lightning, a glow that flares as it drinks."] = "Lame sombre, tranchant carmin, \195\169clairs rouges, une lueur qui flamboie quand elle boit.",
		["FIND IT"] = "\195\128 TROUVER",
		["{short} Find it in the rooms of the temple on the hill."] = "{short} Trouve-la dans les salles du temple sur la colline.",
		["Blade length 3.2 studs"] = "Lame de 3,2 studs",
		["Blade length 3.4 studs, draw styles (coming soon)"] = "Lame de 3,4 studs, styles de d\195\169gainage (bient\195\180t)",
		["+5% walk speed"] = "+5\194\160% de vitesse de marche",
		["+5% walk speed, 25% faster poise recovery"] = "+5\194\160% de vitesse de marche, r\195\169cup\195\169ration d\'\195\169quilibre 25\194\160% plus rapide",
		["After {delay} seconds of calm it comes back, {regen} a second: faster with a still guard (L2 on a gamepad), slower with little blood.\n\nBelow half, your feet slow down. The lower it is, the heavier your blade and the more easily it\'s knocked aside."] = "Apr\195\168s {delay} secondes de calme, il revient, {regen} par seconde\194\160: plus vite avec une garde immobile (L2 sur une manette), moins vite avec peu de sang.\n\nSous la moiti\195\169, tes pieds ralentissent. Plus il est bas, plus ta lame est lourde et s\'\195\169carte facilement.",
		["<b>Wiping resets your poise.</b> While the cloth is on the blade, poise comes back {times} times as fast, and a finished wipe fills it to full.\n\nIt works after a break too: finishing a wipe ends being weakened.\n\nA finished wipe also gives back all your dashes."] = "<b>Essuyer ta lame r\195\169tablit ton \195\169quilibre.</b> Tant que le tissu est sur la lame, l\'\195\169quilibre revient {times} fois plus vite, et un essuyage termin\195\169 le remplit compl\195\168tement.\n\n\195\135a marche aussi apr\195\168s une rupture\194\160: finir un essuyage met fin \195\160 l\'affaiblissement.\n\nUn essuyage termin\195\169 te rend aussi toutes tes ru\195\169es.",
		["tap WIPE to refill dashes"] = "touche ESSUYER pour recharger les ru\195\169es",
		["{key}  wipe to refill dashes"] = "{key}  essuyer la lame pour recharger les ru\195\169es",
		["Out of dashes. Tap **WIPE** to wipe your blade and get them back."] = "Plus de ru\195\169es. Touche **ESSUYER** pour essuyer ta lame et les r\195\169cup\195\169rer.",
		["Out of dashes. Press **{Wipe}** to wipe your blade and get them back."] = "Plus de ru\195\169es. Appuie sur **{Wipe}** pour essuyer ta lame et les r\195\169cup\195\169rer.",
		["+1% walk speed"] = "+1 % de vitesse de marche",
		["10% less poise lost to hits and clashes"] = "10 % d\'\195\169quilibre en moins perdu aux coups et aux chocs de lames",
		["10% less poise lost to hits and clashes, 15% quicker back from knocks"] = "10 % d\'\195\169quilibre en moins perdu aux coups et aux chocs de lames, r\195\169cup\195\169ration apr\195\168s un choc 15 % plus rapide",
		["+1% walk speed, 25% faster poise recovery"] = "+1 % de vitesse de marche, r\195\169cup\195\169ration d\'\195\169quilibre 25 % plus rapide",
		["+20 blood"] = "+20 de sang",
		["UPGRADE READY"] = "AM\195\137LIORATION PR\195\138TE",
		["the forge"] = "la forge",
		["New look"] = "Nouvelle apparence",
		["Draw styles (coming soon)"] = "Styles de d\195\169gainage (bient\195\180t)",
		["SINGLE"] = "SIMPLE",
		["DUAL WIELD"] = "DEUX SABRES",
		["IAI"] = "IAI",
		["Robux spins aren\'t sold on your account. Ry\197\141 and levels still give them."] = "Les tirages contre des Robux ne sont pas vendus sur ton compte. Les ry\197\141 et les niveaux en donnent toujours.",
		["Beginners\' ring: under level {level} only"] = "Ring des d\195\169butants\194\160: seulement sous le niveau {level}"
	}
}
return v1]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX153">
            <Properties>
              <string name="Name">Indonesian</string>
              <ProtectedString name="Source"><![CDATA[local v1 = {
	["Name"] = "Bahasa Indonesia",
