		["Cuts leave blood on the blade. With the blade drawn, press <b>{Wipe}</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "\224\184\129\224\184\178\224\184\163\224\184\159\224\184\177\224\184\153\224\184\151\224\184\180\224\185\137\224\184\135\224\185\128\224\184\165\224\184\183\224\184\173\224\184\148\224\185\132\224\184\167\224\185\137\224\184\154\224\184\153\224\184\148\224\184\178\224\184\154 \224\185\128\224\184\161\224\184\183\224\185\136\224\184\173\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154\224\184\173\224\184\173\224\184\129\224\184\161\224\184\178\224\185\129\224\184\165\224\185\137\224\184\167 \224\184\129\224\184\148 <b>{Wipe}</b> \224\185\128\224\184\158\224\184\183\224\185\136\224\184\173\224\185\128\224\184\138\224\185\135\224\184\148\224\184\148\224\185\137\224\184\167\224\184\162\224\184\156\224\185\137\224\184\178\224\184\151\224\184\181\224\184\165\224\184\176\224\184\148\224\185\137\224\184\178\224\184\153 \224\184\129\224\184\178\224\184\163\224\185\128\224\184\138\224\185\135\224\184\148\224\185\131\224\184\138\224\185\137\224\185\128\224\184\167\224\184\165\224\184\178\224\184\155\224\184\163\224\184\176\224\184\161\224\184\178\224\184\147 {time} \224\184\167\224\184\180\224\184\153\224\184\178\224\184\151\224\184\181",
		["<b>Wiping restores poise.</b> During a wipe, poise refills at {times}x speed, and a finished wipe fills it to full.\n\nAfter a poise break, a finished wipe also ends the weakened state."] = "<b>\224\184\129\224\184\178\224\184\163\224\185\128\224\184\138\224\185\135\224\184\148\224\184\148\224\184\178\224\184\154\224\184\159\224\184\183\224\185\137\224\184\153\224\184\159\224\184\185\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165</b> \224\184\163\224\184\176\224\184\171\224\184\167\224\185\136\224\184\178\224\184\135\224\185\128\224\184\138\224\185\135\224\184\148 \224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\184\136\224\184\176\224\184\159\224\184\183\224\185\137\224\184\153\224\185\128\224\184\163\224\185\135\224\184\167\224\184\130\224\184\182\224\185\137\224\184\153 {times} \224\185\128\224\184\151\224\185\136\224\184\178 \224\185\129\224\184\165\224\184\176\224\185\128\224\184\161\224\184\183\224\185\136\224\184\173\224\185\128\224\184\138\224\185\135\224\184\148\224\185\128\224\184\170\224\184\163\224\185\135\224\184\136 \224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\184\136\224\184\176\224\185\128\224\184\149\224\185\135\224\184\161\n\n\224\184\171\224\184\165\224\184\177\224\184\135\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\185\129\224\184\149\224\184\129 \224\184\129\224\184\178\224\184\163\224\185\128\224\184\138\224\185\135\224\184\148\224\184\136\224\184\153\224\185\128\224\184\170\224\184\163\224\185\135\224\184\136\224\184\162\224\184\177\224\184\135\224\184\151\224\184\179\224\185\131\224\184\171\224\185\137\224\184\171\224\184\178\224\184\162\224\184\173\224\185\136\224\184\173\224\184\153\224\185\129\224\184\163\224\184\135\224\184\148\224\185\137\224\184\167\224\184\162",
		["<b>Wiping leaves an opening.</b> Once a wipe starts, steering, guarding and cutting are locked until it ends, and a swing into the loose blade knocks it far aside. Losing poise mid-wipe cancels the full refill.\n\nBots punish wipes. Make some distance first.\n\nA later forge rank unlocks a quicker wipe."] = "<b>\224\184\129\224\184\178\224\184\163\224\185\128\224\184\138\224\185\135\224\184\148\224\184\148\224\184\178\224\184\154\224\184\151\224\184\179\224\185\131\224\184\171\224\185\137\224\185\128\224\184\155\224\184\180\224\184\148\224\184\138\224\185\136\224\184\173\224\184\135</b> \224\185\128\224\184\161\224\184\183\224\185\136\224\184\173\224\185\128\224\184\163\224\184\180\224\185\136\224\184\161\224\185\128\224\184\138\224\185\135\224\184\148\224\185\129\224\184\165\224\185\137\224\184\167 \224\184\136\224\184\176\224\184\154\224\184\177\224\184\135\224\184\132\224\184\177\224\184\154\224\184\148\224\184\178\224\184\154 \224\184\149\224\184\177\224\185\137\224\184\135\224\184\129\224\184\178\224\184\163\224\185\140\224\184\148 \224\184\171\224\184\163\224\184\183\224\184\173\224\184\159\224\184\177\224\184\153\224\185\132\224\184\161\224\185\136\224\185\132\224\184\148\224\185\137\224\184\136\224\184\153\224\184\129\224\184\167\224\185\136\224\184\178\224\184\136\224\184\176\224\185\128\224\184\138\224\185\135\224\184\148\224\185\128\224\184\170\224\184\163\224\185\135\224\184\136 \224\185\129\224\184\165\224\184\176\224\184\150\224\185\137\224\184\178\224\185\130\224\184\148\224\184\153\224\184\159\224\184\178\224\184\148\224\185\131\224\184\170\224\185\136\224\184\148\224\184\178\224\184\154\224\184\151\224\184\181\224\185\136\224\184\150\224\184\183\224\184\173\224\184\171\224\184\165\224\184\167\224\184\161\224\185\134 \224\184\173\224\184\162\224\184\185\224\185\136 \224\184\148\224\184\178\224\184\154\224\184\136\224\184\176\224\184\129\224\184\163\224\184\176\224\185\128\224\184\148\224\185\135\224\184\153\224\185\132\224\184\155\224\185\132\224