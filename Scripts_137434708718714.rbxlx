		["THE MOUNTAIN\'S FOOT"] = "CH\195\130N N\195\154I",
		["THE SOUTH WOOD"] = "R\225\187\170NG PH\195\141A NAM",
		["Pumpkin Samurai"] = "Samurai B\195\173 Ng\195\180",
		["Take hold of the sword, or sheathe it."] = "C\225\186\167m ki\225\186\191m, ho\225\186\183c tra ki\225\186\191m v\195\160o v\225\187\143.",
		["Unequip the sword (sheathes it first)."] = "Bu\195\180ng ki\225\186\191m (tra v\195\160o v\225\187\143 tr\198\176\225\187\155c).",
		["Hold, swipe to draw. Blade out: thrust."] = "Gi\225\187\175 v\195\160 lia chu\225\187\153t \196\145\225\187\131 r\195\186t ki\225\186\191m. Ki\225\186\191m \196\145\195\163 r\195\186t: \196\145\195\162m.",
		["Hip swap: draw from the other hip."] = "\196\144\225\187\149i h\195\180ng: r\195\186t ki\225\186\191m t\225\187\171 h\195\180ng b\195\170n kia.",
		["Lock on to who you\'re looking at, or off."] = "Kh\195\179a v\195\160o ng\198\176\225\187\157i b\225\186\161n \196\145ang nh\195\172n, ho\225\186\183c t\225\186\175t kh\195\179a.",
		["Cycle lock on target."] = "\196\144\225\187\149i m\225\187\165c ti\195\170u \196\145ang kh\195\179a.",
		["Kick: knock back, send limbs flying."] = "\196\144\195\161: \196\145\225\186\169y l\195\185i, h\225\186\165t v\196\131ng tay ch\195\162n.",
		["Dash."] = "L\198\176\225\187\155t.",
		["Front view: watch your own draws."] = "G\195\179c nh\195\172n tr\198\176\225\187\155c: xem th\225\186\191 r\195\186t ki\225\186\191m c\225\187\167a m\195\172nh.",
		["Bow to who you\'re locked onto: both bow, a 1v1."] = "C\195\186i ch\195\160o m\225\187\165c ti\195\170u: c\225\186\163 hai c\195\186i ch\195\160o l\195\160 1v1.",
		["Battle music: next track."] = "Nh\225\186\161c chi\225\186\191n \196\145\225\186\165u: b\195\160i ti\225\186\191p theo.",
		["Battle music: the last track."] = "Nh\225\186\161c chi\225\186\191n \196\145\225\186\165u: b\195\160i tr\198\176\225\187\155c.",
		["In the dojo: skip to the arena."] = "Trong v\195\181 \196\145\198\176\225\187\157ng: b\225\187\143 qua \196\145\225\187\131 v\195\160o \196\145\225\186\165u tr\198\176\225\187\157ng.",
		["Hide the UI for clean shots. Again: show it."] = "\225\186\168n giao di\225\187\135n \196\145\225\187\131 quay c\225\186\163nh. Nh\225\186\165n l\225\186\161i: hi\225\187\135n.",
		["Shamisen: take it out or put it away."] = "Shamisen: l\225\186\165y ra ho\225\186\183c c\225\186\165t \196\145i.",
		["left click"] = "chu\225\187\153t tr\195\161i",
		["right click"] = "chu\225\187\153t ph\225\186\163i",
		["middle click"] = "chu\225\187\153t gi\225\187\175a",
