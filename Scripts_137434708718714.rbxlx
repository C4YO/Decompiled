		["{name} bowed back: the 1v1 begins."] = "\208\158\209\130\208\178\208\181\209\130\208\189\209\139\208\185 \208\191\208\190\208\186\208\187\208\190\208\189 \208\190\209\130 {name}: 1v1 \208\189\208\176\209\135\208\184\208\189\208\176\208\181\209\130\209\129\209\143.",
