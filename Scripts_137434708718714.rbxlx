		["Only from the Path of the Sword (QUESTS, in the menu)."] = "\234\178\128\236\157\152 \234\184\184\236\151\144\236\132\156\235\167\140 \236\150\187\236\157\132 \236\136\152 \236\158\136\236\150\180\236\154\148 (\235\169\148\235\137\180\236\157\152 [\237\128\152\236\138\164\237\138\184]).",
