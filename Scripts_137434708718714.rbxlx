		["THE RUINED OUTSKIRTS"] = "LES FAUBOURGS EN RUINE",
		["THE MOUNTAIN\'S FOOT"] = "LE PIED DE LA MONTAGNE",
		["THE SOUTH WOOD"] = "LE BOIS DU SUD",
		["Pumpkin Samurai"] = "Samoura\195\175 Citrouille",
		["Take hold of the sword, or sheathe it."] = "Prendre le sabre en main, ou le rengainer.",
		["Unequip the sword (sheathes it first)."] = "L\195\162cher le sabre (le rengaine d\'abord).",
		["Hold, swipe to draw. Blade out: thrust."] = "Maintenir, glisser\194\160: d\195\169gainer. D\195\169gain\195\169\194\160: estoc.",
		["Hip swap: draw from the other hip."] = "Changer de hanche : d\195\169gainer de l\'autre c\195\180t\195\169.",
		["Lock on to who you\'re looking at, or off."] = "Cibler qui tu regardes, ou couper le ciblage.",
		["Cycle lock on target."] = "Changer de cible.",
		["Kick: knock back, send limbs flying."] = "Coup de pied\194\160: repousse, projette les membres.",
		["Dash."] = "Ru\195\169e.",
		["Front view: watch your own draws."] = "Vue de face\194\160: regarde tes propres d\195\169gainages.",
		["Bow to who you\'re locked onto: both bow, a 1v1."] = "Saluer la cible\194\160: si les deux saluent, un 1v1.",
		["Battle music: next track."] = "Musique de combat\194\160: piste suivante.",
		["Battle music: the last track."] = "Musique de combat\194\160: piste pr\195\169c\195\169dente.",
		["In the dojo: skip to the arena."] = "Au dojo\194\160: passer \195\160 l\'ar\195\168ne.",
		["Hide the UI for clean shots. Again: show it."] = "Cache l\'interface pour filmer. Encore : l\'affiche.",
		["Shamisen: take it out or put it away."] = "Shamisen : le sortir ou le ranger.",
		["left click"] = "clic gauche",
		["right click"] = "clic droit",
		["middle click"] = "clic molette",
		["RIGHT SHIFT"] = "SHIFT DROIT",
		["RIGHT CTRL"] = "CTRL DROIT",
		["RIGHT ALT"] = "ALT DROIT",
		["Talk"] = "Parler",
		["TRAVELLING MERCHANT"] = "MARCHAND AMBULANT",
		["Ah, a traveller. You\'ll forgive me if I don\'t get up."] = "Ah, un voyageur. Tu me pardonneras de ne pas me lever.",
		["Three nights ago my horses caught wind of something up at that temple."] = "Il y a trois nuits, mes chevaux ont senti quelque chose l\195\160-haut, dans ce temple.",
		["They screamed, broke their harness and bolted into the trees. I haven\'t seen them since."] = "Ils ont hurl\195\169, bris\195\169 leur harnais et se sont enfuis dans les bois. Je ne les ai pas revus depuis.",
		["So here I am, stranded with a wagon full of wax."] = "Alors me voil\195\160, coinc\195\169 avec une charrette pleine de cire.",
		["There\'s something wrong with that temple, I\'d stay away if I were you, especially at night."] = "Il y a quelque chose qui cloche dans ce temple. \195\128 ta place, je m\'en tiendrais loin, surtout la nuit.",
		["Here, take some wax. It might be useful to give your blade some extra shine. Be careful around a flame though, this stuff can catch alight in the blink of an eye!"] = "Tiens, prends un peu de cire. \195\135a pourrait donner \195\160 ta lame un \195\169clat en plus. Mais fais attention pr\195\168s d\'une flamme : ce truc s\'enflamme en un clin d\'\197\147il !",
		["Still here? So am I."] = "Encore l\195\160 ? Moi aussi.",
		["And keep away from that temple at night."] = "Et reste loin de ce temple la nuit.",
		["KATANA: SINGLE"] = "KATANA : SIMPLE",
		["One katana at the left hip."] = "Un katana \195\160 la hanche gauche.",
		["A katana at each hip, drawn together, one in each hand."] = "Un katana \195\160 chaque hanche, d\195\169gain\195\169s ensemble, un dans chaque main.",
		["A katana at each hip, one in each hand."] = "Un katana \195\160 chaque hanche, un dans chaque main.",
		["KATANA: IAI"] = "KATANA : IAI",
		["Draw-cuts only. High risk, high reward: cuts through blades, but a miss can be parried. Longer dash, faster draw. On a kill: poise back and a faster sheathe."] = "Coupes au d\195\169gainage uniquement. Gros risque, grosse r\195\169compense : traverse les lames, mais un rat\195\169 peut \195\170tre par\195\169. Ru\195\169e plus longue, d\195\169gainage plus rapide. Sur une \195\169limination : \195\169quilibre rendu et rengainage plus rapide.",
		["The older, longer sword, slung edge down at your hip. Slower and heavier than the katana: its hits take more poise and bleed more."] = "L\'\195\169p\195\169e plus ancienne et plus longue, port\195\169e tranchant vers le bas \195\160 la hanche. Plus lente et plus lourde que le katana : ses coups retirent plus d\'\195\169quilibre et font plus saigner.",
		["Longer and heavier than the katana: slower, but its hits take more poise and bleed more."] = "Plus longue et plus lourde que le katana : plus lente, mais ses coups retirent plus d\'\195\169quilibre et font plus saigner.",
		["Crimson rime. A keening at vespers. Kindled steel unsheathes me."] = "Givre cramoisi. Une lamentation aux v\195\170pres. L\'acier embras\195\169 me d\195\169gaine.",
		["+2.5% walk speed"] = "+2,5\194\160% de vitesse de marche",
		["Mirror polish, wavy temper line, clean bandages."] = "Poli miroir, ligne de trempe ondul\195\169e, bandages propres.",
		["Store 2 dashes"] = "Stocke 2 ru\195\169es",
		["Black cord, gold collar, lacquered sheath."] = "Cordon noir, collier dor\195\169, fourreau laqu\195\169.",
		["Blade length 2.9 studs"] = "Lame de 2,9 studs",
		["A groove down each side, red cord on the sheath."] = "Une gorge sur chaque face, cordon rouge sur le fourreau.",
		["Dark forged steel, black sheath."] = "Acier forg\195\169 sombre, fourreau noir.",
		["Quick wipe: both sides at once"] = "Essuyage rapide\194\160: les deux faces d\'un coup",
		["Gold guard, collar and pommel."] = "Garde, collier et pommeau dor\195\169s.",
		["Blade length 3.0 studs"] = "Lame de 3,0 studs",
		["Gleaming silver, crescent-moon guard, white cord and sheath."] = "Argent \195\169tincelant, garde en croissant de lune, cordon et fourreau blancs.",
		["Store 3 dashes"] = "Stocke 3 ru\195\169es",
		["White metal fittings."] = "Garnitures en m\195\169tal blanc.",
		["+2.5% walk speed, 25% faster poise recovery"] = "+2,5\194\160% de vitesse de marche, r\195\169cup\195\169ration d\'\195\169quilibre 25\194\160% plus rapide",
		["Red cord, cherry-blossom ornaments, black tassel, red sheath with metal bands."] = "Cordon rouge, ornements en fleurs de cerisier, gland noir, fourreau rouge cercl\195\169 de m\195\169tal.",
		["Blade length 3.1 studs, draw styles (coming soon)"] = "Lame de 3,1 studs, styles de d\195\169gainage (bient\195\180t)",
		["Pale gold fittings, four-lobed guard, faint red glow on the edge."] = "Garnitures en or p\195\162le, garde \195\160 quatre lobes, faible lueur rouge sur le tranchant.",
		["Each hit that draws blood: +5 blood, +6 poise"] = "Chaque coup qui fait saigner\194\160: +5 de sang, +6 d\'\195\169quilibre",
		["Dark blade, crimson edge, red lightning."] = "Lame sombre, tranchant carmin, \195\169clairs rouges.",
		["No upgrades"] = "Aucune am\195\169lioration",
		["Old bandages, a plain brown sheath."] = "Vieux bandages, un simple fourreau brun.",
		["FLAMMABLE WAX"] = "CIRE INFLAMMABLE",
