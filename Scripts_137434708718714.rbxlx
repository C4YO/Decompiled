		["{count} free rename spins"] = "\208\177\208\181\209\129\208\191\208\187\208\176\209\130\208\189\209\139\208\181 \208\191\209\128\208\190\208\186\209\128\209\131\209\130\209\139 \209\132\208\176\208\188\208\184\208\187\208\184\208\184: {count}",
		["{xp} XP"] = "{xp} XP",
		["{scale}x XP for {minutes} minutes"] = "{scale}x XP \208\189\208\176 {minutes} \208\188\208\184\208\189.",
		["OPENED"] = "\208\158\208\162\208\154\208\160\208\171\208\162\208\158",
		["MISSED"] = "\208\159\208\160\208\158\208\159\208\163\208\169\208\149\208\157\208\158",
		["A door opens each day from 1 to 25 December while playing. Missed doors stay shut."] = "\208\161 1 \208\191\208\190 25 \208\180\208\181\208\186\208\176\208\177\209\128\209\143 \208\186\208\176\208\182\208\180\209\139\208\185 \208\180\208\181\208\189\209\140 \208\178\208\190 \208\178\209\128\208\181\208\188\209\143 \208\184\208\179\209\128\209\139 \208\190\209\130\208\186\209\128\209\139\208\178\208\176\208\181\209\130\209\129\209\143 \208\180\208\178\208\181\209\128\209\134\208\176. \208\159\209\128\208\190\208\191\209\131\209\137\208\181\208\189\208\189\209\139\208\181 \208\180\208\178\208\181\209\128\209\134\209\139 \208\190\209\129\209\130\208\176\209\142\209\130\209\129\209\143 \208\183\208\176\208\186\209\128\209\139\209\130\209\139\208\188\208\184.",
		["BACK"] = "\208\157\208\144\208\151\208\144\208\148",
		["AIM DOT"] = "\208\162\208\158\208\167\208\154\208\144 \208\159\208\160\208\152\208\166\208\149\208\155\208\144",
		["COLOUR"] = "\208\166\208\146\208\149\208\162",
		["OUTLINE"] = "\208\154\208\158\208\157\208\162\208\163\208\160",
		["DOT"] = "\208\162\208\158\208\167\208\154\208\144",
		["BRIGHTNESS"] = "\208\175\208\160\208\154\208\158\208\161\208\162\208\172",
		["CUSTOM"] = "\208\161\208\146\208\158\208\153",
		["DEFAULT"] = "\208\159\208\158 \208\163\208\156\208\158\208\155\208\167\208\144\208\157\208\152\208\174",
