		["THE TEMPLE GHOST"] = "\229\175\186\233\153\162\229\185\189\233\157\136",
		["Reroll your first name as often as you like, or spin a new family name ({count} spin)."] = "\229\144\141\229\173\151\229\143\175\228\187\165\233\154\168\230\132\143\233\135\141\230\138\189\239\188\140\228\185\159\229\143\175\228\187\165\230\138\189\228\184\128\229\128\139\230\150\176\229\167\147\230\176\143\239\188\136\229\137\169\233\164\152{count}\230\172\161\239\188\137\227\128\130",
		["Reroll your first name as often as you like, or spin a new family name ({count} spins)."] = "\229\144\141\229\173\151\229\143\175\228\187\165\233\154\168\230\132\143\233\135\141\230\138\189\239\188\140\228\185\159\229\143\175\228\187\165\230\138\189\228\184\128\229\128\139\230\150\176\229\167\147\230\176\143\239\188\136\229\137\169\233\164\152{count}\230\172\161\239\188\137\227\128\130",
