}
local v65 = {}
local v66, v67 = v10("<b>Family name</b>: rolled once, at the forge.\n<b>First name</b>: reroll any time on the character screen (CHARACTER, on the title screen).\n\nRarer family names give stat boosts. Boosts are kept small, so fights are still won with the blade.")
local v68 = {
	["Text"] = v66,
	["Args"] = v67
}
local v69 = {
	["Text"] = v10("Rarity, odds and boosts:\n\n{rarities}\n\nThe rarest names belong to famous swordsmen and warlords. A Mythic name is a legend\'s own name, used in place of a family name. An Exotic name is a god\'s. Every spin is pure chance at these odds."),
	["Args"] = function()
		-- upvalues: (copy) v_u_30
		return {
			["rarities"] = v_u_30()
		}
	end
}
local v70, v71 = v10("Boosts:\n\n<b>Walk speed</b>: faster movement.\n<b>Poise recovery</b>: poise refills faster.\n<b>Poise toughness</b>: all poise costs are lower.\n<b>Slower bleeding</b>: wounds and stumps bleed slower.\n<b>Faster dash recharge</b>: dash charges refill sooner.\n\nBoosts stack with forge upgrades.")
__set_list(v65, 1, {v68, v69, {
	["Text"] = v70,
	["Args"] = v71
}, {
	["Text"] = v10("<b>Rename spins</b> reroll the family name. Get {spins} free spins every level, or buy more in the SHOP. Use them on the character screen. The old name can always be kept.\n\nBots have names too. The rarer a bot\'s name, the better it fights."),
	["Args"] = function()
