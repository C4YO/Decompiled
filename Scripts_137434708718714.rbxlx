		["2x Ry\197\141"] = "2x Ry\197\141",
		["Doubles every ry\197\141 gain: kills, quests, rewards and ry\197\141 packs."] = "\208\163\208\180\208\178\208\176\208\184\208\178\208\176\208\181\209\130 \208\178\209\129\208\181 \208\191\208\190\208\187\209\131\209\135\208\176\208\181\208\188\209\139\208\181 ry\197\141: \209\131\208\177\208\184\208\185\209\129\209\130\208\178\208\176, \208\186\208\178\208\181\209\129\209\130\209\139, \208\189\208\176\208\179\209\128\208\176\208\180\209\139 \208\184 \208\189\208\176\208\177\208\190\209\128\209\139 ry\197\141.",
		["Dual Wield"] = "\208\148\208\178\208\176 \208\188\208\181\209\135\208\176",
		["A second katana at your right hip: draw both at once and fight with one in each hand."] = "\208\146\209\130\208\190\209\128\208\176\209\143 \208\186\208\176\209\130\208\176\208\189\208\176 \208\189\208\176 \208\191\209\128\208\176\208\178\208\190\208\188 \208\177\208\181\208\180\209\128\208\181: \208\178\209\139\209\133\208\178\208\176\209\130\209\139\208\178\208\176\208\185 \208\190\208\177\208\181 \209\129\209\128\208\176\208\183\209\131 \208\184 \209\129\209\128\208\176\208\182\208\176\208\185\209\129\209\143 \209\129 \208\188\208\181\209\135\208\190\208\188 \208\178 \208\186\208\176\208\182\208\180\208\190\208\185 \209\128\209\131\208\186\208\181.",
		["Iai"] = "\208\152\208\176\208\185",
		["Draw-cuts only. Cuts through blades, but a miss can be parried. 1.5x dash, 1.6x draw speed."] = "\208\162\208\190\208\187\209\140\208\186\208\190 \209\131\208\180\208\176\209\128\209\139 \209\129 \208\178\209\139\209\133\208\178\208\176\209\130\208\176. \208\159\209\128\208\190\208\177\208\184\208\178\208\176\208\181\209\130 \208\186\208\187\208\184\208\189\208\186\208\184, \208\189\208\190 \208\191\209\128\208\190\208\188\208\176\209\133 \208\188\208\190\208\182\208\189\208\190 \208\191\208\176\209\128\208\184\209\128\208\190\208\178\208\176\209\130\209\140. \208\160\209\139\208\178\208\190\208\186 \195\1511,5, \208\178\209\139\209\133\208\178\208\176\209\130 \208\177\209\139\209\129\209\130\209\128\208\181\208\181 \208\178 1,6 \209\128\208\176\208\183\208\176.",
		["Shamisen"] = "\208\161\209\143\208\188\208\184\209\129\209\141\208\189",
		["A playable three-string shamisen. Pluck with the mouse or a finger; 9 keys or pads set the notes. Heard by nearby players."] = "\208\162\209\128\209\145\209\133\209\129\209\130\209\128\209\131\208\189\208\189\209\139\208\185 \209\129\209\143\208\188\208\184\209\129\209\141\208\189, \208\189\208\176 \208\186\208\190\209\130\208\190\209\128\208\190\208\188 \208\188\208\190\208\182\208\189\208\190 \208\184\208\179\209\128\208\176\209\130\209\140. \208\169\208\184\208\191\208\176\208\185 \209\129\209\130\209\128\209\131\208\189\209\139 \208\188\209\139\209\136\209\140\209\142 \208\184\208\187\208\184 \208\191\208\176\208\187\209\140\209\134\208\181\208\188; \208\189\208\190\209\130\209\139 \208\183\208\176\208\180\208\176\209\142\209\130 9 \208\186\208\187\208\176\208\178\208\184\209\136 \208\184\208\187\208\184 \208\186\208\189\208\190\208\191\208\190\208\186. \208\149\208\179\208\190 \209\129\208\187\209\139\209\136\208\176\209\130 \208\184\208\179\209\128\208\190\208\186\208\184 \209\128\209\143\208\180\208\190\208\188.",
