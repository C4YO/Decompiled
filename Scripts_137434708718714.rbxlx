		["PvP off in the forest. PvP still on in the rings."] = "\230\163\174\230\158\151\233\135\140PvP\229\133\179\233\151\173\227\128\130\230\147\130\229\143\176\233\135\140PvP\228\187\141\231\132\182\229\188\128\229\144\175\227\128\130",
		["PvP is back on."] = "PvP\229\183\178\233\135\141\230\150\176\229\188\128\229\144\175\227\128\130",
