		["Path of the Sword: {chapter} done. Chapter {number}, {next}, begins."] = "Camino de la Espada: {chapter} completado. Empieza el cap\195\173tulo {number}, {next}.",
		["Path of the Sword: done. You walked it to the end."] = "Camino de la Espada: completado. Lo recorriste hasta el final.",
		["You can\'t go peaceful so soon after a fight."] = "No puedes pasar a modo pac\195\173fico tan pronto despu\195\169s de una pelea.",
		["You can go peaceful again in {time}."] = "Podr\195\161s volver al modo pac\195\173fico en {time}.",
		["PvP off in the forest. PvP still on in the rings."] = "PvP desactivado en el bosque. PvP sigue activo en los rings.",
		["PvP is back on."] = "El PvP vuelve a estar activo.",
		["Couldn\'t load your data. Please rejoin."] = "No se pudieron cargar tus datos. Vuelve a entrar.",
		["Your data was opened on another server. Please rejoin."] = "Tus datos se abrieron en otro servidor. Vuelve a entrar.",
		["{event}: {quest}"] = "{event}: {quest}",
		["Unknown tab."] = "Pesta\195\177a desconocida.",
		["That isn\'t one of today\'s quests."] = "Esa no es una de las misiones de hoy.",
		["Already done today."] = "Ya completada hoy.",
		["You can work on {count} at a time: drop one first."] = "Puedes llevar {count} a la vez: deja una primero.",
		["Not in a boss fight."] = "No se puede en una pelea contra un jefe.",
		["Needs both hands."] = "Hacen falta las dos manos.",
		["Not during a fight."] = "No se puede durante una pelea.",
		["That can\'t be bought with ry\197\141."] = "Eso no se puede comprar con ry\197\141.",
		["Already owned."] = "Ya obtenido.",
		["Unknown pack."] = "Paquete desconocido.",
		["1 rename spin"] = "1 giro de nombre",
		["{count} rename spins"] = "{count} giros de nombre",
		["Kill streak lost: safe zone"] = "Racha de bajas perdida: zona segura",
		["Kicked, not sliced: it\'s back on its stand."] = "Pateada, no cortada: ha vuelto a su soporte.",
		["A stab only marks it. **Swing** through it to slice it."] = "Una estocada solo la marca. **Golpea** a trav\195\169s de ella para cortarla.",
		["Too slow, or hit with the flat. Swing faster, edge first."] = "Demasiado lento, o golpe con la parte plana. Golpea m\195\161s r\195\161pido, con el filo por delante.",
		["{was}. Press **{Equip}** to sheathe, then {how}."] = "{was}. Pulsa **{Equip}** para envainar y luego {how}.",
		["{was}. Tap **SHEATHE**, then {how}."] = "{was}. Toca **ENVAINAR** y luego {how}.",
		["Not a dash attack. Hold **W + A** and press **{Dash}** while passing it."] = "No fue un ataque con impulso. Mant\195\169n **W + A** y pulsa **{Dash}** al pasar junto a ella.",
		["Not a dash attack. Tap **DASH** while walking past it."] = "No fue un ataque con impulso. Toca **IMPULSO** al pasar caminando junto a ella.",
		["A new watermelon is on the stand."] = "Hay una sand\195\173a nueva en el soporte.",
		["Still loading: try again in a moment."] = "A\195\186n cargando: int\195\169ntalo de nuevo en un momento.",
		["Not during a 1v1."] = "No durante un 1v1.",
		["Not straight after a fight: wait a few seconds."] = "No justo despu\195\169s de una pelea: espera unos segundos.",
		["Not with a missing limb."] = "No se puede si falta una extremidad.",
		["The dojo is full: try again soon."] = "El dojo est\195\161 lleno: int\195\169ntalo de nuevo pronto.",
		["HEAD"] = "CABEZA",
		["TORSO"] = "TORSO",
		["LEFT ARM"] = "BRAZO IZQUIERDO",
		["RIGHT ARM"] = "BRAZO DERECHO",
		["LEFT LEG"] = "PIERNA IZQUIERDA",
		["RIGHT LEG"] = "PIERNA DERECHA",
		["THE ARENA"] = "LA ARENA",
		["THE CHERRY GROVE"] = "LA ARBOLEDA DE LOS CEREZOS",
		["THE BAMBOO SHRINE"] = "EL SANTUARIO DEL BAMB\195\154",
		["THE FOG GATE"] = "LA PUERTA DE LA NIEBLA",
		["THE NORTH WOOD"] = "EL BOSQUE DEL NORTE",
		["THE TEMPLE"] = "EL TEMPLO",
		["THE FOOT OF THE HILL"] = "EL PIE DE LA COLINA",
		["THE RIVER BRIDGE"] = "EL PUENTE DEL R\195\141O",
		["THE RUINED OUTSKIRTS"] = "LAS AFUERAS EN RUINAS",
		["THE MOUNTAIN\'S FOOT"] = "EL PIE DE LA MONTA\195\145A",
		["THE SOUTH WOOD"] = "EL BOSQUE DEL SUR",
		["Pumpkin Samurai"] = "Samur\195\161i Calabaza",
		["Take hold of the sword, or sheathe it."] = "Toma la espada, o env\195\161inala.",
		["Unequip the sword (sheathes it first)."] = "Suelta la espada (la envaina primero).",
		["Hold, swipe to draw. Blade out: thrust."] = "Mant\195\169n, desliza: desenvainar. Fuera: estocada.",
		["Hip swap: draw from the other hip."] = "Cambio de cadera: desenvainar del otro lado.",
		["Lock on to who you\'re looking at, or off."] = "Fija a quien est\195\161s mirando, o deja de fijar.",
		["Cycle lock on target."] = "Cambia de objetivo fijado.",
		["Kick: knock back, send limbs flying."] = "Patada: empuja y haz volar extremidades.",
		["Dash."] = "Impulso.",
		["Front view: watch your own draws."] = "Vista frontal: mira tus propios desenvaines.",
		["Bow to who you\'re locked onto: both bow, a 1v1."] = "Reverencia al objetivo: si ambos la hacen, 1v1.",
		["Battle music: next track."] = "M\195\186sica de combate: siguiente pista.",
		["Battle music: the last track."] = "M\195\186sica de combate: pista anterior.",
		["In the dojo: skip to the arena."] = "En el dojo: salta a la arena.",
		["Hide the UI for clean shots. Again: show it."] = "Ocultar interfaz para fotos. Otra vez: mostrar.",
		["Shamisen: take it out or put it away."] = "Shamisen: s\195\161calo o gu\195\161rdalo.",
		["left click"] = "clic izquierdo",
		["right click"] = "clic derecho",
		["middle click"] = "clic central",
		["RIGHT SHIFT"] = "SHIFT DERECHO",
		["RIGHT CTRL"] = "CTRL DERECHO",
		["RIGHT ALT"] = "ALT DERECHO",
		["Talk"] = "Hablar",
		["TRAVELLING MERCHANT"] = "MERCADER AMBULANTE",
		["Ah, a traveller. You\'ll forgive me if I don\'t get up."] = "Ah, un viajero. Perdona que no me levante.",
		["Three nights ago my horses caught wind of something up at that temple."] = "Hace tres noches, mis caballos olieron algo all\195\161 arriba, en ese templo.",
		["They screamed, broke their harness and bolted into the trees. I haven\'t seen them since."] = "Chillaron, rompieron los arneses y huyeron hacia los \195\161rboles. No los he vuelto a ver.",
		["So here I am, stranded with a wagon full of wax."] = "As\195\173 que aqu\195\173 estoy, varado con un carro lleno de cera.",
		["There\'s something wrong with that temple, I\'d stay away if I were you, especially at night."] = "Algo no anda bien en ese templo. Yo que t\195\186 me mantendr\195\173a alejado, sobre todo de noche.",
		["Here, take some wax. It might be useful to give your blade some extra shine. Be careful around a flame though, this stuff can catch alight in the blink of an eye!"] = "Toma, ll\195\169vate un poco de cera. Puede que le d\195\169 a tu hoja un brillo extra. Pero ten cuidado cerca de una llama: \194\161esto se prende en un abrir y cerrar de ojos!",
		["Still here? So am I."] = "\194\191Sigues aqu\195\173? Yo tambi\195\169n.",
		["And keep away from that temple at night."] = "Y al\195\169jate de ese templo por la noche.",
		["KATANA: SINGLE"] = "KATANA: SIMPLE",
		["One katana at the left hip."] = "Una katana en la cadera izquierda.",
		["A katana at each hip, drawn together, one in each hand."] = "Una katana en cada cadera, desenvainadas a la vez, una en cada mano.",
		["A katana at each hip, one in each hand."] = "Una katana en cada cadera, una en cada mano.",
		["KATANA: IAI"] = "KATANA: IAI",
		["Draw-cuts only. High risk, high reward: cuts through blades, but a miss can be parried. Longer dash, faster draw. On a kill: poise back and a faster sheathe."] = "Solo cortes al desenvainar. Alto riesgo, alta recompensa: atraviesa hojas, pero si falla, se puede parar. Impulso m\195\161s largo y desenvainado m\195\161s r\195\161pido. Con cada baja: recuperas postura y envainado m\195\161s r\195\161pido.",
		["The older, longer sword, slung edge down at your hip. Slower and heavier than the katana: its hits take more poise and bleed more."] = "La espada m\195\161s antigua y m\195\161s larga, colgada de la cadera con el filo hacia abajo. M\195\161s lenta y pesada que la katana: sus golpes quitan m\195\161s postura y hacen sangrar m\195\161s.",
		["Longer and heavier than the katana: slower, but its hits take more poise and bleed more."] = "M\195\161s larga y pesada que la katana: m\195\161s lenta, pero sus golpes quitan m\195\161s postura y hacen sangrar m\195\161s.",
		["Crimson rime. A keening at vespers. Kindled steel unsheathes me."] = "Escarcha carmes\195\173. Un lamento en v\195\173speras. El acero encendido me desenvaina.",
		["+2.5% walk speed"] = "+2,5% de velocidad al caminar",
		["Mirror polish, wavy temper line, clean bandages."] = "Pulido espejo, l\195\173nea de temple ondulada, vendas limpias.",
		["Store 2 dashes"] = "Guarda 2 impulsos",
		["Black cord, gold collar, lacquered sheath."] = "Cord\195\179n negro, collar dorado, vaina lacada.",
		["Blade length 2.9 studs"] = "Hoja de 2.9 studs",
		["A groove down each side, red cord on the sheath."] = "Una acanaladura en cada lado, cord\195\179n rojo en la vaina.",
		["Dark forged steel, black sheath."] = "Acero forjado oscuro, vaina negra.",
		["Quick wipe: both sides at once"] = "Limpieza r\195\161pida: los dos lados a la vez",
		["Gold guard, collar and pommel."] = "Guarda, collar y pomo dorados.",
		["Blade length 3.0 studs"] = "Hoja de 3.0 studs",
		["Gleaming silver, crescent-moon guard, white cord and sheath."] = "Plata reluciente, guarda de media luna, cord\195\179n y vaina blancos.",
		["Store 3 dashes"] = "Guarda 3 impulsos",
		["White metal fittings."] = "Guarniciones de metal blanco.",
		["+2.5% walk speed, 25% faster poise recovery"] = "+2,5% de velocidad al caminar, recuperaci\195\179n de postura un 25% m\195\161s r\195\161pida",
		["Red cord, cherry-blossom ornaments, black tassel, red sheath with metal bands."] = "Cord\195\179n rojo, adornos de flor de cerezo, borla negra, vaina roja con anillas de metal.",
		["Blade length 3.1 studs, draw styles (coming soon)"] = "Hoja de 3.1 studs, estilos de desenvaine (pr\195\179ximamente)",
		["Pale gold fittings, four-lobed guard, faint red glow on the edge."] = "Guarniciones de oro p\195\161lido, guarda de cuatro l\195\179bulos, leve brillo rojo en el filo.",
		["Each hit that draws blood: +5 blood, +6 poise"] = "Cada golpe que saca sangre: +5 de sangre, +6 de postura",
		["Dark blade, crimson edge, red lightning."] = "Hoja oscura, filo carmes\195\173, rayos rojos.",
		["No upgrades"] = "Sin mejoras",
