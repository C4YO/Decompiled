		["Lock on to {name} to bow to them."] = "Fija a {name} para hacerle una reverencia.",
		["{name} has to be locked on to you too."] = "{name} tambi\195\169n tiene que fijarte a ti.",
		["You can only bow for a 1v1 with someone you could fight right now."] = "Solo puedes hacer la reverencia para un 1v1 a alguien con quien podr\195\173as luchar ahora mismo.",
