		["You can only bow for a 1v1 with someone you could fight right now."] = "Voc\195\170 s\195\179 pode fazer a sauda\195\167\195\163o do 1v1 para algu\195\169m com quem poderia lutar agora.",
		["{name} declined: try again a little later."] = "{name} recusou: tente de novo daqui a pouco.",
		["The 1v1 can\'t start right now: someone\'s {why}."] = "O 1v1 n\195\163o pode come\195\167ar agora: algu\195\169m est\195\161 {why}.",
		["The 1v1 can\'t start right now."] = "O 1v1 n\195\163o pode come\195\167ar agora.",
		["You bowed to {name}: if they bow back, the 1v1 begins."] = "Voc\195\170 saudou {name}: se a sauda\195\167\195\163o for retribu\195\173da, o 1v1 come\195\167a.",
		["{name} declined your bow."] = "{name} recusou sua sauda\195\167\195\163o.",
		["There\'s nobody to challenge back."] = "N\195\163o tem ningu\195\169m para desafiar de volta.",
		["Can\'t challenge: you\'re {why}."] = "N\195\163o d\195\161 para desafiar: voc\195\170 est\195\161 {why}.",
		["{name} already has a challenge waiting."] = "{name} j\195\161 tem um desafio pendente.",
		["Rematch sent to {name}."] = "Revanche enviada para {name}.",
		["The rematch can\'t start: someone\'s {why}."] = "A revanche n\195\163o pode come\195\167ar: algu\195\169m est\195\161 {why}.",
		["That challenge has run out."] = "Esse desafio expirou.",
		["{name} declined your 1v1."] = "{name} recusou seu 1v1.",
		["Every 1v1 ring is in use: try again in a moment."] = "Todos os ringues de 1v1 est\195\163o ocupados: tente de novo daqui a pouco.",
		["{count} bots defeated in this server: an Exotic bot has entered the main arena!"] = "{count} bots derrotados neste servidor: um bot Ex\195\179tico entrou na arena principal!",
		["Tachi not owned."] = "Tachi n\195\163o obtido.",
		["Already fully restored."] = "J\195\161 est\195\161 totalmente restaurado.",
		["Needs forge rank {rank}."] = "Requer rank de forja {rank}.",
		["Needs level {level}."] = "Requer n\195\173vel {level}.",
		["Not enough ry\197\141: it costs {price}."] = "Ry\197\141 insuficiente: custa {price}.",
		["Data still loading. Try again."] = "Dados ainda carregando. Tente de novo.",
		["Roll a family name first."] = "Sorteie um sobrenome primeiro.",
		["Bought rename spins can\'t be used on this account."] = "Giros de nome comprados n\195\163o podem ser usados nesta conta.",
		["There\'s no spin to choose."] = "N\195\163o tem nenhum giro para escolher.",
		["Keep which?"] = "Ficar com qual?",
		["1 day"] = "1 dia",
