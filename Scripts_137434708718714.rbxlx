		["In the dojo: skip to the arena."] = "\229\156\168\233\129\147\229\160\180\228\184\173\239\188\154\231\155\180\230\142\165\229\137\141\229\190\128\231\171\182\230\138\128\229\160\180\227\128\130",
		["Hide the UI for clean shots. Again: show it."] = "\233\154\177\232\151\143\228\187\139\233\157\162\228\187\165\230\139\141\230\148\157\228\185\190\230\183\168\231\149\171\233\157\162\227\128\130\229\134\141\230\140\137\228\184\128\230\172\161\239\188\154\233\161\175\231\164\186\227\128\130",
		["Shamisen: take it out or put it away."] = "\228\184\137\229\145\179\231\183\154\239\188\154\229\143\150\229\135\186\230\136\150\230\148\182\232\181\183\227\128\130",
		["left click"] = "\229\183\166\233\141\181",
		["right click"] = "\229\143\179\233\141\181",
		["middle click"] = "\228\184\173\233\141\181",
		["RIGHT SHIFT"] = "\229\143\179SHIFT",
		["RIGHT CTRL"] = "\229\143\179CTRL",
		["RIGHT ALT"] = "\229\143\179ALT",
		["Talk"] = "\228\186\164\232\171\135",
		["TRAVELLING MERCHANT"] = "\232\161\140\229\149\134",
		["Ah, a traveller. You\'ll forgive me if I don\'t get up."] = "\229\149\138\239\188\140\230\152\175\228\189\141\230\151\133\228\186\186\227\128\130\230\129\149\230\136\145\229\157\144\232\145\151\228\184\141\232\181\183\232\186\171\228\186\134\227\128\130",
		["Three nights ago my horses caught wind of something up at that temple."] = "\228\184\137\229\164\169\229\137\141\231\154\132\229\164\156\232\163\161\239\188\140\230\136\145\231\154\132\233\166\172\229\156\168\233\130\163\229\186\167\229\175\186\233\153\162\233\130\163\233\130\138\229\151\133\229\136\176\228\186\134\228\187\128\233\186\188\230\157\177\232\165\191\227\128\130",
		["They screamed, broke their harness and bolted into the trees. I haven\'t seen them since."] = "\231\137\160\229\128\145\229\152\182\229\143\171\232\145\151\230\142\153\230\150\183\228\186\134\230\140\189\229\133\183\239\188\140\233\128\131\233\128\178\228\186\134\230\168\185\230\158\151\227\128\130\229\190\158\233\130\163\228\187\165\229\190\140\230\136\145\229\176\177\229\134\141\230\178\146\232\166\139\233\129\142\231\137\160\229\128\145\227\128\130",
		["So here I am, stranded with a wagon full of wax."] = "\230\137\128\228\187\165\230\136\145\229\176\177\229\155\176\229\156\168\233\128\153\232\163\161\239\188\140\229\174\136\232\145\151\228\184\128\232\187\138\231\154\132\232\160\159\227\128\130",
		["There\'s something wrong with that temple, I\'d stay away if I were you, especially at night."] = "\233\130\163\229\186\167\229\175\186\233\153\162\228\184\141\229\176\141\229\139\129\227\128\130\232\166\129\230\152\175\230\136\145\230\152\175\228\189\160\239\188\140\229\176\177\233\155\162\229\174\131\233\129\160\233\187\158\239\188\140\229\176\164\229\133\182\230\152\175\229\164\156\232\163\161\227\128\130",
		["Here, take some wax. It might be useful to give your blade some extra shine. Be careful around a flame though, this stuff can catch alight in the blink of an eye!"] = "\230\139\191\232\145\151\239\188\140\231\181\166\228\189\160\228\184\128\228\186\155\232\160\159\227\128\130\228\185\159\232\168\177\232\131\189\232\174\147\228\189\160\231\154\132\229\136\128\229\136\131\230\155\180\230\156\137\229\133\137\230\190\164\227\128\130\228\184\141\233\129\142\233\157\160\232\191\145\231\129\171\231\154\132\230\153\130\229\128\153\229\176\143\229\191\131\233\187\158\239\188\140\233\128\153\230\157\177\232\165\191\228\184\128\231\156\168\231\156\188\229\176\177\230\156\131\231\135\146\232\181\183\228\190\134\239\188\129",
		["Still here? So am I."] = "\233\130\132\229\156\168\233\128\153\229\133\146\239\188\159\230\136\145\228\185\159\230\152\175\227\128\130",
		["And keep away from that temple at night."] = "\233\130\132\230\156\137\239\188\140\230\153\154\228\184\138\229\136\165\233\157\160\232\191\145\233\130\163\229\186\167\229\175\186\233\153\162\227\128\130",
		["KATANA: SINGLE"] = "\229\136\128\239\188\154\228\184\128\229\136\128\230\181\129",
		["One katana at the left hip."] = "\229\183\166\232\133\176\228\189\169\228\184\128\230\138\138\229\136\128\227\128\130",
		["A katana at each hip, drawn together, one in each hand."] = "\229\133\169\229\129\180\232\133\176\233\150\147\229\144\132\228\189\169\228\184\128\230\138\138\229\136\128\239\188\140\229\144\140\230\153\130\230\139\148\229\135\186\239\188\140\233\155\153\230\137\139\229\144\132\230\140\129\228\184\128\230\138\138\227\128\130",
		["A katana at each hip, one in each hand."] = "\229\133\169\229\129\180\232\133\176\233\150\147\229\144\132\228\189\169\228\184\128\230\138\138\229\136\128\239\188\140\233\155\153\230\137\139\229\144\132\230\140\129\228\184\128\230\138\138\227\128\130",
		["KATANA: IAI"] = "\229\136\128\239\188\154\229\177\133\229\144\136",
		["Draw-cuts only. High risk, high reward: cuts through blades, but a miss can be parried. Longer dash, faster draw. On a kill: poise back and a faster sheathe."] = "\229\131\133\230\139\148\229\136\128\230\150\172\227\128\130\233\171\152\233\162\168\233\154\170\233\171\152\229\155\158\229\160\177\239\188\154\229\143\175\230\150\172\231\169\191\229\136\128\229\136\131\239\188\140\228\189\134\232\144\189\231\169\186\230\153\130\229\143\175\232\131\189\232\162\171\229\189\136\229\143\141\227\128\130\232\161\157\229\136\186\230\155\180\233\129\160\239\188\140\230\139\148\229\136\128\230\155\180\229\191\171\227\128\130\230\147\138\230\174\186\230\153\130\239\188\154\230\129\162\229\190\169\232\187\128\229\185\185\239\188\140\230\148\182\229\136\128\230\155\180\229\191\171\227\128\130",
		["The older, longer sword, slung edge down at your hip. Slower and heavier than the katana: its hits take more poise and bleed more."] = "\230\155\180\229\143\164\232\128\129\227\128\129\230\155\180\233\149\183\231\154\132\229\164\170\229\136\128\239\188\140\229\136\131\229\143\163\230\156\157\228\184\139\230\142\155\229\156\168\232\133\176\233\150\147\227\128\130\230\175\148\229\136\128\230\155\180\230\133\162\230\155\180\233\135\141\239\188\154\229\145\189\228\184\173\230\153\130\229\137\138\230\184\155\230\155\180\229\164\154\232\187\128\229\185\185\239\188\140\228\184\166\233\128\160\230\136\144\230\155\180\229\164\154\229\135\186\232\161\128\227\128\130",
		["Longer and heavier than the katana: slower, but its hits take more poise and bleed more."] = "\230\175\148\229\136\128\230\155\180\233\149\183\230\155\180\233\135\141\239\188\154\230\155\180\230\133\162\239\188\140\228\189\134\229\145\189\228\184\173\230\153\130\229\137\138\230\184\155\230\155\180\229\164\154\232\187\128\229\185\185\239\188\140\228\184\166\233\128\160\230\136\144\230\155\180\229\164\154\229\135\186\232\161\128\227\128\130",
		["Crimson rime. A keening at vespers. Kindled steel unsheathes me."] = "\231\183\139\231\180\133\228\185\139\233\156\156\227\128\130\230\153\154\232\170\178\230\153\130\231\154\132\229\147\128\229\147\173\227\128\130\231\135\131\232\181\183\231\154\132\233\139\188\228\187\164\230\136\145\229\135\186\233\158\152\227\128\130",
		["+2.5% walk speed"] = "\231\167\187\229\139\149\233\128\159\229\186\166+2.5%",
		["Mirror polish, wavy temper line, clean bandages."] = "\233\143\161\233\157\162\231\160\148\231\163\168\227\128\129\230\179\162\230\181\170\229\136\131\231\180\139\227\128\129\229\182\132\230\150\176\231\186\143\229\184\131\227\128\130",
		["Store 2 dashes"] = "\229\143\175\229\132\178\229\173\1522\230\172\161\232\161\157\229\136\186",
		["Black cord, gold collar, lacquered sheath."] = "\233\187\145\232\137\178\230\159\132\231\185\169\227\128\129\233\135\145\232\137\178\229\136\128\231\174\141\227\128\129\229\161\151\230\188\134\229\136\128\233\158\152\227\128\130",
		["Blade length 2.9 studs"] = "\229\136\128\232\186\171\233\149\1832.9\230\160\188",
		["A groove down each side, red cord on the sheath."] = "\229\136\128\232\186\171\229\133\169\233\157\162\233\150\139\230\156\137\232\161\128\230\167\189\239\188\140\229\136\128\233\158\152\231\185\171\231\180\133\231\185\169\227\128\130",
