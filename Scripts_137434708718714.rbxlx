}
local v92 = {
	["Text"] = v10("<b>Wiping restores poise.</b> During a wipe, poise refills at {times}x speed, and a finished wipe fills it to full.\n\nAfter a poise break, a finished wipe also ends the weakened state."),
	["Args"] = function()
		-- upvalues: (copy) v_u_12
