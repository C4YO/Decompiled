		["WEAPON EFFECT"] = "EFECTO DE ARMA",
		["{item}   \194\183   {kind}"] = "{item}   \194\183   {kind}",
		["Owned and equipped."] = "Obtenido y equipado.",
		["{chance}% chance to drop from the {boss}."] = "{chance}% de probabilidad de que lo suelte el {boss}.",
		["Only from a code (CODES, in the menu)."] = "Solo con un c\195\179digo (C\195\147DIGOS, en el men\195\186).",
		["Only from the advent calendar, day {day}."] = "Solo del calendario de Adviento, d\195\173a {day}.",
		["Needs the Shamisen pass."] = "Requiere el pase Shamisen.",
		["Only from the {quest} (QUESTS, in the menu)."] = "Solo de la {quest} (MISIONES, en el men\195\186).",
		["Only from the quests (QUESTS, in the menu)."] = "Solo de las misiones (MISIONES, en el men\195\186).",
		["Not obtainable yet."] = "A\195\186n no se puede conseguir.",
		["{chance}% chance to drop from {rarity} and higher rarity bots."] = "{chance}% de probabilidad de que lo suelten los bots {rarity} o de mayor rareza.",
		["Finish chapter {chapter} of the Path of the Sword, {name} (QUESTS, in the menu)."] = "Completa el cap\195\173tulo {chapter} del Camino de la Espada, {name} (MISIONES, en el men\195\186).",
		["Only from the Path of the Sword (QUESTS, in the menu)."] = "Solo del Camino de la Espada (MISIONES, en el men\195\186).",
		["Limited: no longer in the shop."] = "Limitado: ya no est\195\161 en la tienda.",
		["Limited: only in the shop until {date}."] = "Limitado: solo en la tienda hasta el {date}.",
		["Limited: only in the shop for a while."] = "Limitado: solo en la tienda por un tiempo.",
		["Only sold for Robux."] = "Solo se vende por Robux.",
		["Available to buy."] = "Disponible para comprar.",
		["Available to buy with ry\197\141 from level {level}, or with Robux now."] = "Se puede comprar con ry\197\141 desde el nivel {level}, o con Robux ya.",
		["Available to buy from level {level}."] = "Se puede comprar desde el nivel {level}.",
		["BUY {price}"] = "COMPRAR {price}",
		["NOT ON SALE"] = "NO A LA VENTA",
		["WEAPON"] = "ARMA",
		["DRAW STYLE"] = "ESTILO DE DESENVAINE",
		["{short} Owned: equipped from the next spawn."] = "{short} Obtenido: equipado desde la pr\195\179xima aparici\195\179n.",
		["{short} Permanent unlock."] = "{short} Desbloqueo permanente.",
		["{short} Only sold for Robux. Permanent unlock."] = "{short} Solo se vende por Robux. Desbloqueo permanente.",
		["Not enough ry\197\141: {amount} more to go."] = "No tienes suficientes ry\197\141: te faltan {amount}.",
		["Buy {name}?"] = "\194\191Comprar {name}?",
		["Price: {price}. Balance: {have}."] = "Precio: {price}. Saldo: {have}.",
		["Buying..."] = "Comprando...",
		["DONE"] = "LISTO",
		["Keep one of the names first."] = "Primero qu\195\169date con uno de los nombres.",
		["SAVING"] = "GUARDANDO",
		["Couldn\'t save. Try again."] = "No se pudo guardar. Int\195\169ntalo de nuevo.",
		["DAILY REWARD"] = "RECOMPENSA DIARIA",
		["+1 free rename spin"] = "+1 giro de nombre gratis",
		["+{count} free rename spins"] = "+{count} giros de nombre gratis",
		["Day {day} in a row: {spins} spins a day."] = "D\195\173a {day} seguido: {spins} giros al d\195\173a.",
		["Day {day} in a row. From day {from} you get {spins} a day."] = "D\195\173a {day} seguido. Desde el d\195\173a {from} recibes {spins} al d\195\173a.",
		["MERRY CHRISTMAS"] = "FELIZ NAVIDAD",
		["A gift for playing on Christmas Day."] = "Un regalo por jugar el d\195\173a de Navidad.",
		["DAILY BONUS"] = "BONO DIARIO",
		["+{xp} XP"] = "+{xp} XP",
		["All daily quests done"] = "Todas las diarias completadas",
		["ADVENT CALENDAR"] = "CALENDARIO DE ADVIENTO",
		["Day {day} of 25"] = "D\195\173a {day} de 25",
		["no boost"] = "sin mejora",
		["{count} boost: +{walk} walk speed or +{other} to another stat"] = "{count} mejora: +{walk} de velocidad al caminar o +{other} a otra estad\195\173stica",
		["{count} boosts, each +{walk} walk speed or +{other} to another stat"] = "{count} mejoras, cada una: +{walk} de velocidad al caminar o +{other} a otra estad\195\173stica",
		["Safe zone: combat forbidden"] = "Zona segura: combate prohibido",
		["Names and boosts"] = "Nombres y mejoras",
		["<b>Family name</b>: rolled once, at the forge.\n<b>First name</b>: reroll any time on the character screen (CHARACTER, on the title screen).\n\nRarer family names give stat boosts. Boosts are kept small, so fights are still won with the blade."] = "<b>Apellido</b>: se sortea una vez, en la forja.\n<b>Nombre</b>: se puede volver a sortear en cualquier momento en la pantalla de personaje (PERSONAJE, en la pantalla de t\195\173tulo).\n\nLos apellidos m\195\161s raros dan mejoras de estad\195\173sticas. Las mejoras se mantienen peque\195\177as para que los combates se sigan ganando con la espada.",
		["Rarity, odds and boosts:\n\n{rarities}\n\nThe rarest names belong to famous swordsmen and warlords. A Mythic name is a legend\'s own name, used in place of a family name. An Exotic name is a god\'s. Every spin is pure chance at these odds."] = "Rareza, probabilidades y mejoras:\n\n{rarities}\n\nLos nombres m\195\161s raros pertenecen a famosos espadachines y se\195\177ores de la guerra. Un nombre M\195\173tico es el nombre propio de una leyenda, usado en lugar de un apellido. Un nombre Ex\195\179tico es el de un dios. Cada giro es puro azar con estas probabilidades.",
		["Boosts:\n\n<b>Walk speed</b>: faster movement.\n<b>Poise recovery</b>: poise refills faster.\n<b>Poise toughness</b>: all poise costs are lower.\n<b>Slower bleeding</b>: wounds and stumps bleed slower.\n<b>Faster dash recharge</b>: dash charges refill sooner.\n\nBoosts stack with forge upgrades."] = "Mejoras:\n\n<b>Velocidad al caminar</b>: movimiento m\195\161s r\195\161pido.\n<b>Recuperaci\195\179n de postura</b>: la postura se recarga m\195\161s r\195\161pido.\n<b>Resistencia de postura</b>: todos los costes de postura son menores.\n<b>Sangrado m\195\161s lento</b>: las heridas y los mu\195\177ones sangran m\195\161s despacio.\n<b>Recarga de impulso m\195\161s r\195\161pida</b>: las cargas de impulso se recargan antes.\n\nLas mejoras se acumulan con las de la forja.",
		["<b>Rename spins</b> reroll the family name. Get {spins} free spins every level, or buy more in the SHOP. Use them on the character screen. The old name can always be kept.\n\nBots have names too. The rarer a bot\'s name, the better it fights."] = "Los <b>giros de nombre</b> vuelven a sortear el apellido. Consigue {spins} giros gratis en cada nivel, o compra m\195\161s en la TIENDA. \195\154salos en la pantalla de personaje. Siempre se puede conservar el nombre anterior.\n\nLos bots tambi\195\169n tienen nombre. Cuanto m\195\161s raro es el nombre de un bot, mejor lucha.",
		["Poise"] = "Postura",
		["<b>Poise</b> is a fighter\'s steadiness. The poise bar is the thin bar above the blood squares; an opponent\'s is under their name. It grows from the middle as poise is lost, turning from gold to red, and hides at full poise."] = "La <b>postura</b> es la firmeza de un luchador. La barra de postura es la barra fina encima de los cuadrados de sangre; la de un oponente est\195\161 bajo su nombre. Crece desde el centro a medida que se pierde postura, pasando de dorado a rojo, y se oculta cuando la postura est\195\161 completa.",
		["Poise costs:\n\n<b>Draw-cut</b>: {draw}.  <b>Blade hit by a draw-cut</b>: {block}.\n<b>Hard swing</b>: {swing}.  <b>Dash</b>: {dash}.  <b>Kick</b>: {kick}.\n<b>Taking a cut</b>: {wound} (double from a draw-cut), plus blood loss.\n<b>Clashes</b>: more the harder the blade is knocked."] = "Costes de postura:\n\n<b>Corte al desenvainar</b>: {draw}.  <b>Hoja golpeada por un corte al desenvainar</b>: {block}.\n<b>Golpe fuerte</b>: {swing}.  <b>Impulso</b>: {dash}.  <b>Patada</b>: {kick}.\n<b>Recibir un corte</b>: {wound} (el doble si es un corte al desenvainar), adem\195\161s de perder sangre.\n<b>Choques</b>: m\195\161s cuanto m\195\161s fuerte golpean la hoja.",
		["Poise refills after {delay} seconds with no poise lost, at {regen} per second. A still guard (L2 on a gamepad) refills it faster; low blood refills it slower.\n\nBelow half poise, blade and movement speed drop, and the blade is knocked aside more easily."] = "La postura se recarga tras {delay} segundos sin perder postura, a {regen} por segundo. Una guardia quieta (L2 en un mando) la recarga m\195\161s r\195\161pido; con poca sangre, se recarga m\195\161s despacio.\n\nPor debajo de la mitad de la postura, la velocidad de la hoja y la de movimiento bajan, y la hoja se desv\195\173a con m\195\161s facilidad.",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> ({Wipe}). See the next scroll."] = "Al llegar a cero, la postura se <b>rompe</b>: aturdido durante {stagger} segundos y luego debilitado durante {weakened} segundos ({slower} m\195\161s lento, sin aliento, con los bordes de la pantalla oscureci\195\169ndose). Despu\195\169s, la postura se recarga hasta la mitad.\n\nLa forma m\195\161s r\195\161pida de recuperar toda la postura es <b>limpiar la hoja</b> ({Wipe}). Mira el siguiente pergamino.",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> (WIPE). See the next scroll."] = "Al llegar a cero, la postura se <b>rompe</b>: aturdido durante {stagger} segundos y luego debilitado durante {weakened} segundos ({slower} m\195\161s lento, sin aliento, con los bordes de la pantalla oscureci\195\169ndose). Despu\195\169s, la postura se recarga hasta la mitad.\n\nLa forma m\195\161s r\195\161pida de recuperar toda la postura es <b>limpiar la hoja</b> (LIMPIAR). Mira el siguiente pergamino.",
		["Wiping the blade"] = "Limpiar la hoja",
		["Cuts leave blood on the blade. With the blade drawn, press <b>{Wipe}</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "Los cortes dejan sangre en la hoja. Con la hoja desenvainada, pulsa <b>{Wipe}</b> para limpiarla con un pa\195\177o, un lado y luego el otro. Una limpieza tarda unos {time} segundos.",
		["<b>Wiping restores poise.</b> During a wipe, poise refills at {times}x speed, and a finished wipe fills it to full.\n\nAfter a poise break, a finished wipe also ends the weakened state."] = "<b>Limpiar la hoja restaura la postura.</b> Durante una limpieza, la postura se recarga a una velocidad de {times}x, y una limpieza terminada la recarga por completo.\n\nTras romperse la postura, una limpieza terminada tambi\195\169n pone fin al estado debilitado.",
		["<b>Wiping leaves an opening.</b> Once a wipe starts, steering, guarding and cutting are locked until it ends, and a swing into the loose blade knocks it far aside. Losing poise mid-wipe cancels the full refill.\n\nBots punish wipes. Make some distance first.\n\nA later forge rank unlocks a quicker wipe."] = "<b>Limpiar la hoja abre la guardia.</b> Una vez empezada una limpieza, dirigir, cubrirse y cortar quedan bloqueados hasta que termine, y un golpe contra la hoja suelta la desv\195\173a lejos. Perder postura a mitad de la limpieza anula la recarga completa.\n\nLos bots castigan las limpiezas. Toma distancia primero.\n\nUn rango de forja posterior desbloquea una limpieza m\195\161s r\195\161pida.",
		["Cuts leave blood on the blade. With the blade drawn, tap <b>WIPE</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "Los cortes dejan sangre en la hoja. Con la hoja desenvainada, toca <b>LIMPIAR</b> para limpiarla con un pa\195\177o, un lado y luego el otro. Una limpieza tarda unos {time} segundos.",
		["Drawing the sword"] = "Desenvainar la espada",
		["The sword starts sheathed, with a hand on the sheath, ready to draw.\n\n<b>{Lock}</b>: toggle lock-on. While locked on, the mouse picks the cut; its name shows at the bottom of the screen.\n<b>{NextTarget}</b>: switch target.\n<b>{Unequip}</b>: unequip the sword. <b>{Equip}</b>: equip it again."] = "La espada empieza envainada, con una mano en la vaina, lista para desenvainar.\n\n<b>{Lock}</b>: activar o desactivar la fijaci\195\179n. Con el objetivo fijado, el rat\195\179n elige el corte; su nombre aparece en la parte inferior de la pantalla.\n<b>{NextTarget}</b>: cambiar de objetivo.\n<b>{Unequip}</b>: soltar la espada. <b>{Equip}</b>: volver a empu\195\177arla.",
		["Move the mouse to pick the cut, then hold {Draw} and swipe:\n\n<b>Down-left</b>, swipe up-right: low cut.\n<b>Left</b>, swipe right: horizontal slice.\n<b>Up-left</b>, swipe down-right: diagonal cut.\n<b>Up</b>, swipe down: vertical slice.\n\nA faster swipe makes a faster cut.\n\n<b>{CalmDraw}</b>: calm draw. The blade slides out slowly into a guard, with no cut."] = "Mueve el rat\195\179n para elegir el corte; despu\195\169s, mant\195\169n {Draw} y desliza:\n\n<b>Abajo a la izquierda</b>, desliza arriba a la derecha: corte bajo.\n<b>Izquierda</b>, desliza a la derecha: corte horizontal.\n<b>Arriba a la izquierda</b>, desliza abajo a la derecha: corte diagonal.\n<b>Arriba</b>, desliza hacia abajo: corte vertical.\n\nUn deslizamiento m\195\161s r\195\161pido da un corte m\195\161s r\195\161pido.\n\n<b>{CalmDraw}</b>: desenvaine tranquilo. La hoja sale despacio hasta quedar en guardia, sin cortar.",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>{Equip}</b>: put the blade away. The next draw is ready about a second later."] = "Los cortes al desenvainar se sujetan con firmeza. Una hoja golpeada por un corte al desenvainar sale desviada y pierde {block} de postura. Cada corte al desenvainar cuesta {draw} de postura.\n\n<b>{Equip}</b>: guardar la hoja. El siguiente desenvaine est\195\161 listo aproximadamente un segundo despu\195\169s.",
		["The sword starts sheathed, with a hand on the sheath, ready to draw. While locked on, a slow drag on the right side of the screen moves the hand on the sheath, and a quick <b>flick</b> draws. The flick\'s direction picks the cut.\n\n<b>LOCKED ON</b>: tap to switch target, hold to turn lock-on off. <b>LOCK ON</b>: tap to turn it back on.\n<b>UNEQUIP</b>: hold to unequip the sword. <b>EQUIP</b>: tap to equip it again."] = "La espada empieza envainada, con una mano en la vaina, lista para desenvainar. Con el objetivo fijado, arrastrar despacio en el lado derecho de la pantalla mueve la mano en la vaina, y un <b>deslizamiento r\195\161pido</b> desenvaina. La direcci\195\179n del deslizamiento elige el corte.\n\n<b>FIJADO</b>: toca para cambiar de objetivo, mant\195\169n pulsado para desactivar la fijaci\195\179n. <b>FIJAR</b>: toca para volver a activarla.\n<b>SOLTAR</b>: mant\195\169n pulsado para soltar la espada. <b>EMPU\195\145AR</b>: toca para volver a empu\195\177arla.",
		["<b>Flick right</b>: horizontal slice.\n<b>Flick down</b>: vertical slice.\n<b>Flick up-right</b>: low cut.\n\n<b>CALM DRAW</b>: the blade slides out slowly into a guard, with no cut."] = "<b>Desliza r\195\161pido a la derecha</b>: corte horizontal.\n<b>Desliza r\195\161pido hacia abajo</b>: corte vertical.\n<b>Desliza r\195\161pido arriba a la derecha</b>: corte bajo.\n\n<b>SACAR CON CALMA</b>: la hoja sale despacio hasta quedar en guardia, sin cortar.",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>SHEATHE</b>: put the blade away. The next draw is ready about a second later."] = "Los cortes al desenvainar se sujetan con firmeza. Una hoja golpeada por un corte al desenvainar sale desviada y pierde {block} de postura. Cada corte al desenvainar cuesta {draw} de postura.\n\n<b>ENVAINAR</b>: guardar la hoja. El siguiente desenvaine est\195\161 listo aproximadamente un segundo despu\195\169s.",
		["Clashes and parries"] = "Choques y paradas",
		["Blades that meet push each other apart, and the firmer blade moves less. A hard swing knocks a still blade far aside, and that blade is slow to recover: an opening to attack.\n\nHit near the hands, a blade barely moves. Hit near the tip, it\'s knocked aside easily."] = "Las hojas que chocan se empujan entre s\195\173, y la m\195\161s firme se mueve menos. Un golpe fuerte desv\195\173a lejos una hoja quieta, y esa hoja tarda en recuperarse: una oportunidad para atacar.\n\nGolpeada cerca de las manos, una hoja apenas se mueve. Golpeada cerca de la punta, se desv\195\173a con facilidad.",
		["<b>Draw-cuts</b> hit hardest. A blade held still that meets a draw-cut, or the drawer while the blade comes out, is knocked aside, and the cut goes through.\n\n<b>A still guard</b> (L2 on a gamepad) parries other swings: the swing bounces off and the attacker is staggered.\n\n<b>Two swings meeting</b> both give way, and neither can cut for a moment.\n\nThe whole sword can clash, handle included."] = "Los <b>cortes al desenvainar</b> son los que golpean con m\195\161s fuerza. Una hoja quieta que se encuentra con un corte al desenvainar, o que toca a quien desenvaina mientras la hoja sale, queda desviada, y el corte pasa.\n\n<b>Una guardia quieta</b> (L2 en un mando) para los dem\195\161s golpes: el golpe rebota y el atacante queda aturdido.\n\n<b>Dos golpes que se encuentran</b> ceden los dos, y ninguno puede cortar durante un momento.\n\nToda la espada puede chocar, mango incluido.",
		["Cuts, wounds and bleeding"] = "Cortes, heridas y sangrado",
		["A cut needs speed and a leading edge. Speed comes from the swing and from movement, so dashing past counts. A sudden change of direction hits with the flat.\n\nOnly a blade moving into a target counts. A blade left resting in a body sticks."] = "Un corte necesita velocidad y el filo por delante. La velocidad viene del golpe y del movimiento, as\195\173 que pasar con un impulso cuenta. Un cambio brusco de direcci\195\179n golpea con la parte plana.\n\nSolo cuenta una hoja que entra en el objetivo. Una hoja que se deja quieta dentro de un cuerpo se queda atascada.",
		["A fast, edge-first cut all the way through a limb <b>severs</b> it. Through the head or torso: <b>a kill</b>.\n\nAnything less is a <b>wound</b>: it bleeds and slows the limb. Deeper wounds are worse.\n\n<b>Stabs</b> never kill outright. A stab to the head, or a fast one to the body (dash or lunge in), takes a lot of blood at once. Other stabs wound."] = "Una extremidad atravesada del todo por un corte r\195\161pido, con el filo por delante, queda <b>cercenada</b>. A trav\195\169s de la cabeza o el torso: <b>una baja</b>.\n\nMenos que eso es una <b>herida</b>: sangra y ralentiza la extremidad. Las heridas m\195\161s profundas son peores.\n\nLas <b>estocadas</b> nunca matan de golpe. Una estocada a la cabeza, o una r\195\161pida al cuerpo (con un impulso o una arremetida), quita mucha sangre de golpe. Las dem\195\161s estocadas hieren.",
		["Every fighter has {squares} squares of blood. Wounds bleed for a few seconds, and so does a lost limb. With two limbs lost, the stumps bleed out. Losing both arms drops the katana.\n\nCombat is allowed in the arena and the forest, except in safe zones. Inside one, the screen shows <b>{safe}</b>."] = "Cada luchador tiene {squares} cuadrados de sangre. Las heridas sangran unos segundos, y una extremidad perdida tambi\195\169n. Con dos extremidades perdidas, los mu\195\177ones sangran hasta la muerte. Perder los dos brazos hace caer la katana.\n\nEl combate est\195\161 permitido en la arena y en el bosque, salvo en las zonas seguras. Dentro de una, la pantalla muestra <b>{safe}</b>.",
		["The forge and levels"] = "La forja y los niveles",
		["XP rewards:\n\n<b>Wounding a player</b>: {wound}.\n<b>Severing a limb</b>: {sever}.\n<b>A kill</b>: {kill}.\n<b>Defeating a bot</b>: {botLeast} to {botMost}, more for rarer names.\n\nEach level needs a little more XP than the last. No level cap."] = "Recompensas de XP:\n\n<b>Herir a un jugador</b>: {wound}.\n<b>Cercenar una extremidad</b>: {sever}.\n<b>Una baja</b>: {kill}.\n<b>Derrotar a un bot</b>: de {botLeast} a {botMost}, m\195\161s cuanto m\195\161s raro sea su nombre.\n\nCada nivel necesita un poco m\195\161s de XP que el anterior. Sin l\195\173mite de nivel.",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, press E at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "Cada {levels} niveles se desbloquea un nuevo <b>rango de forja</b>. En la forja, al sur de la arena, pulsa E en el yunque para calentar, martillear y templar la hoja. Cada rango da a la hoja un aspecto nuevo y una mejora nueva.\n\nLa pared de espadas de aqu\195\173 muestra la hoja de cada rango de forja.\n\n<b>Reforja</b> para volver a cualquier rango ya forjado.",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, tap <b>Forge your blade</b> at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "Cada {levels} niveles se desbloquea un nuevo <b>rango de forja</b>. En la forja, al sur de la arena, toca <b>Forja tu hoja</b> en el yunque para calentar, martillear y templar la hoja. Cada rango da a la hoja un aspecto nuevo y una mejora nueva.\n\nLa pared de espadas de aqu\195\173 muestra la hoja de cada rango de forja.\n\n<b>Reforja</b> para volver a cualquier rango ya forjado.",
		["Kill streaks"] = "Rachas de bajas",
		["A <b>kill streak</b> counts kills in a row without dying, shown at the top right. Bleed-outs from a cut count, and so do bot kills. Dying ends the streak, but the best one is saved."] = "Una <b>racha de bajas</b> cuenta las bajas seguidas sin morir y se muestra arriba a la derecha. Cuentan las muertes por desangrado tras un corte, y tambi\195\169n las bajas de bots. Morir termina la racha, pero la mejor se guarda.",
		["The streak catches fire as it grows, and every ten kills earns a title. Every {every} kills up to {most}: +{share} walk speed and poise recovery (Mythic names +{mythic}, Exotic names +{exotic}).\n\nNo prizes: it\'s for the glory.\n\nAfter dying, <b>SPECTATE</b> watches other fighters and <b>RESPAWN</b> returns to the fight."] = "La racha arde a medida que crece, y cada diez bajas se gana un t\195\173tulo. Cada {every} bajas, hasta {most}: +{share} de velocidad al caminar y de recuperaci\195\179n de postura (apellidos M\195\173ticos +{mythic}, Ex\195\179ticos +{exotic}).\n\nSin premios: es por la gloria.\n\nTras morir, <b>OBSERVAR</b> permite ver a otros luchadores y <b>REAPARECER</b> devuelve al combate.",
		["TO WHOEVER FREED THIS TEMPLE"] = "A QUIEN HAYA LIBERADO ESTE TEMPLO",
		["Her blade still rests within these walls. Search every corner."] = "Su espada a\195\186n descansa entre estos muros. Registra cada rinc\195\179n.",
		["YOU  {mine}  :  {theirs}  {name}"] = "T\195\154  {mine}  :  {theirs}  {name}",
