		["THE CHERRY GROVE"] = "LE BOSQUET DES CERISIERS",
		["THE BAMBOO SHRINE"] = "LE SANCTUAIRE DES BAMBOUS",
		["THE FOG GATE"] = "LA PORTE DE LA BRUME",
		["THE NORTH WOOD"] = "LE BOIS DU NORD",
