		["Pale gold fittings, four-lobed guard, faint red glow on the edge."] = "\230\183\161\233\135\145\229\136\128\232\163\157\227\128\129\229\155\155\231\147\163\229\136\128\233\144\148\227\128\129\229\136\131\229\143\163\230\179\155\232\145\151\229\190\174\229\188\177\231\180\133\229\133\137\227\128\130",
		["Each hit that draws blood: +5 blood, +6 poise"] = "\230\175\143\230\172\161\229\145\189\228\184\173\232\166\139\232\161\128\239\188\154\232\161\128\233\135\143+5\239\188\140\232\187\128\229\185\185+6",
