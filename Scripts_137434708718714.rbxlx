		["You stayed out of the ring: a point to them."] = "\235\167\129 \235\176\150\236\151\144 \236\158\136\236\151\136\236\150\180\236\154\148: \236\131\129\235\140\128 \236\160\144\236\136\152 +1.",
		["They left the 1v1."] = "\236\131\129\235\140\128\234\176\128 1v1\236\157\132 \235\150\160\235\130\172\236\150\180\236\154\148.",
