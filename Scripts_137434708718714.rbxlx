		["Cuts leave blood on the blade. With the blade drawn, tap <b>WIPE</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "\224\184\129\224\184\178\224\184\163\224\184\159\224\184\177\224\184\153\224\184\151\224\184\180\224\185\137\224\184\135\224\185\128\224\184\165\224\184\183\224\184\173\224\184\148\224\185\132\224\184\167\224\185\137\224\184\154\224\184\153\224\184\148\224\184\178\224\184\154 \224\185\128\224\184\161\224\184\183\224\185\136\224\184\173\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154\224\184\173\224\184\173\224\184\129\224\184\161\224\184\178\224\185\129\224\184\165\224\185\137\224\184\167 \224\185\129\224\184\149\224\184\176 <b>\224\185\128\224\184\138\224\185\135\224\184\148\224\184\148\224\184\178\224\184\154</b> \224\185\128\224\184\158\224\184\183\224\185\136\224\184\173\224\185\128\224\184\138\224\185\135\224\184\148\224\184\148\224\185\137\224\184\167\224\184\162\224\184\156\224\185\137\224\184\178\224\184\151\224\184\181\224\184\165\224\184\176\224\184\148\224\185\137\224\184\178\224\184\153 \224\184\129\224\184\178\224\184\163\224\185\128\224\184\138\224\185\135\224\184\148\224\185\131\224\184\138\224\185\137\224\185\128\224\184\167\224\184\165\224\184\178\224\184\155\224\184\163\224\184\176\224\184\161\224\184\178\224\184\147 {time} \224\184\167\224\184\180\224\184\153\224\184\178\224\184\151\224\184\181",
		["Drawing the sword"] = "\224\184\129\224\184\178\224\184\163\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154",
		["The sword starts sheathed, with a hand on the sheath, ready to draw.\n\n<b>{Lock}</b>: toggle lock-on. While locked on, the mouse picks the cut; its name shows at the bottom of the screen.\n<b>{NextTarget}</b>: switch target.\n<b>{Unequip}</b>: unequip the sword. <b>{Equip}</b>: equip it again."] = "\224\184\148\224\184\178\224\184\154\224\185\128\224\184\163\224\184\180\224\185\136\224\184\161\224\184\173\224\184\162\224\184\185\224\185\136\224\185\131\224\184\153\224\184\157\224\184\177\224\184\129 \224\185\130\224\184\148\224\184\162\224\184\161\224\184\181\224\184\161\224\184\183\224\184\173\224\184\167\224\184\178\224\184\135\224\184\173\224\184\162\224\184\185\224\185\136\224\184\154\224\184\153\224\184\157\224\184\177\224\184\129 \224\184\158\224\184\163\224\185\137\224\184\173\224\184\161\224\184\138\224\184\177\224\184\129\n\n<b>{Lock}</b>: \224\185\128\224\184\155\224\184\180\224\184\148/\224\184\155\224\184\180\224\184\148\224\184\165\224\185\135\224\184\173\224\184\129\224\185\128\224\184\155\224\185\137\224\184\178 \224\184\130\224\184\147\224\184\176\224\184\165\224\185\135\224\184\173\224\184\129\224\185\128\224\184\155\224\185\137\224\184\178 \224\185\128\224\184\161\224\184\178\224\184\170\224\185\140\224\184\136\224\184\176\224\185\128\224\184\165\224\184\183\224\184\173\224\184\129\224\184\151\224\185\136\224\184\178\224\184\159\224\184\177\224\184\153 \224\185\129\224\184\165\224\184\176\224\184\138\224\184\183\224\185\136\224\184\173\224\184\151\224\185\136\224\184\178\224\184\136\224\184\176\224\185\129\224\184\170\224\184\148\224\184\135\224\184\151\224\184\181\224\185\136\224\184\148\224\185\137\224\184\178\224\184\153\224\184\165\224\185\136\224\184\178\224\184\135\224\184\130\224\184\173\224\184\135\224\184\136\224\184\173\n<b>{NextTarget}</b>: \224\184\170\224\184\165\224\184\177\224\184\154\224\185\128\224\184\155\224\185\137\224\184\178\n<b>{Unequip}</b>: \224\184\155\224\184\165\224\185\136\224\184\173\224\184\162\224\184\148\224\184\178\224\184\154 <b>{Equip}</b>: \224\184\136\224\184\177\224\184\154\224\184\148\224\184\178\224\184\154\224\184\173\224\184\181\224\184\129\224\184\132\224\184\163\224\184\177\224\185\137\224\184\135",
		["Move the mouse to pick the cut, then hold {Draw} and swipe:\n\n<b>Down-left</b>, swipe up-right: low cut.\n<b>Left</b>, swipe right: horizontal slice.\n<b>Up-left</b>, swipe down-right: diagonal cut.\n<b>Up</b>, swipe down: vertical slice.\n\nA faster swipe makes a faster cut.\n\n<b>{CalmDraw}</b>: calm draw. The blade slides out slowly into a guard, with no cut."] = "\224\184\130\224\184\162\224\184\177\224\184\154\224\185\128\224\184\161\224\184\178\224\184\170\224\185\140\224\185\128\224\184\158\224\184\183\224\185\136\224\184\173\224\185\128\224\184\165\224\184\183\224\184\173\224\184\129\224\184\151\224\185\136\224\184\178\224\184\159\224\184\177\224\184\153 \224\185\129\224\184\165\224\185\137\224\184\167\224\184\129\224\184\148 {Draw} \224\184\132\224\185\137\224\184\178\224\184\135\224\185\132\224\184\167\224\185\137\224\185\129\224\184\165\224\184\176\224\184\155\224\184\177\224\184\148:\n\n<b>\224\184\165\224\185\136\224\184\178\224\184\135\224\184\139\224\185\137\224\184\178\224\184\162</b> \224\184\155\224\184\177\224\184\148\224\184\130\224\184\182\224\185\137\224\184\153\224\184\130\224\184\167\224\184\178: \224\184\159\224\184\177\224\184\153\224\184\149\224\185\136\224\184\179\n<b>\224\184\139\224\185\137\224\184\178\224\184\162</b> \224\184\155\224\184\177\224\184\148\224\185\132\224\184\155\224\184\130\224\184\167\224\184\178: \224\184\159\224\184\177\224\184\153\224\185\129\224\184\153\224\184\167\224\184\153\224\184\173\224\184\153\n<b>\224\184\154\224\184\153\224\184\139\224\185\137\224\184\178\224\184\162</b> \224\184\155\224\184\177\224\184\148\224\184\165\224\184\135\224\184\130\224\184\167\224\184\178: \224\184\159\224\184\177\224\184\153\224\185\128\224\184\137\224\184\181\224\184\162\224\184\135\n<b>\224\184\154\224\184\153</b> \224\184\155\224\184\177\224\184\148\224\184\165\224\184\135: \224\184\159\224\184\177\224\184\153\224\185\129\224\184\153\224\184\167\224\184\149\224\184\177\224\185\137\224\184\135\n\n\224\184\162\224\184\180\224\185\136\224\184\135\224\184\155\224\184\177\224\184\148\224\185\128\224\184\163\224\185\135\224\184\167 \224\184\162\224\184\180\224\185\136\224\184\135\224\184\159\224\184\177\224\184\153\224\185\128\224\184\163\224\185\135\224\184\167\n\n<b>{CalmDraw}</b>: \224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154\224\184\170\224\184\135\224\184\154 \224\184\148\224\184\178\224\184\154\224\184\136\224\184\176\224\184\132\224\185\136\224\184\173\224\184\162\224\185\134 \224\185\128\224\184\165\224\184\183\224\185\136\224\184\173\224\184\153\224\184\173\224\184\173\224\184\129\224\184\161\224\184\178\224\185\128\224\184\155\224\185\135\224\184\153\224\184\151\224\185\136\224\184\178\224\184\129\224\184\178\224\184\163\224\185\140\224\184\148 \224\185\130\224\184\148\224\184\162\224\185\132\224\184\161\224\185\136\224\184\159\224\184\177\224\184\153",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>{Equip}</b>: put the blade away. The next draw is ready about a second later."] = "\224\184\159\224\184\177\224\184\153\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154\224\184\136\224\184\176\224\184\136\224\184\177\224\184\154\224\184\148\224\184\178\224\184\154\224\185\132\224\184\167\224\185\137\224\185\129\224\184\153\224\185\136\224\184\153 \224\184\148\224\184\178\224\184\154\224\184\151\224\184\181\224\185\136\224\185\130\224\184\148\224\184\153\224\184\159\224\184\177\224\184\153\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154\224\184\136\224\184\176\224\184\150\224\184\185\224\184\129\224\184\155\224\184\177\224\184\148\224\184\173\224\184\173\224\184\129\224\185\129\224\184\165\224\184\176\224\185\128\224\184\170\224\184\181\224\184\162\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165 {block} \224\184\159\224\184\177\224\184\153\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154\224\185\129\224\184\149\224\185\136\224\184\165\224\184\176\224\184\132\224\184\163\224\184\177\224\185\137\224\184\135\224\185\128\224\184\170\224\184\181\224\184\162\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165 {draw}\n\n<b>{Equip}</b>: \224\185\128\224\184\129\224\185\135\224\184\154\224\184\148\224\184\178\224\184\154\224\185\128\224\184\130\224\185\137\224\184\178\224\184\157\224\184\177\224\184\129 \224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154\224\184\132\224\184\163\224\184\177\224\185\137\224\184\135\224\184\149\224\185\136\224\184\173\224\185\132\224\184\155\224\185\132\224\184\148\224\185\137\224\185\131\224\184\153\224\184\173\224\184\181\224\184\129\224\184\163\224\184\178\224\184\167\224\184\171\224\184\153\224\184\182\224\185\136\224\184\135\224\184\167\224\184\180\224\184\153\224\184\178\224\184\151\224\184\181",
		["The sword starts sheathed, with a hand on the sheath, ready to draw. While locked on, a slow drag on the right side of the screen moves the hand on the sheath, and a quick <b>flick</b> draws. The flick\'s direction picks the cut.\n\n<b>LOCKED ON</b>: tap to switch target, hold to turn lock-on off. <b>LOCK ON</b>: tap to turn it back on.\n<b>UNEQUIP</b>: hold to unequip the sword. <b>EQUIP</b>: tap to equip it again."] = "\224\184\148\224\184\178\224\184\154\224\185\128\224\184\163\224\184\180\224\185\136\224\184\161\224\184\173\224\184\162\224\184\185\224\185\136\224\185\131\224\184\153\224\184\157\224\184\177\224\184\129 \224\185\130\224\184\148\224\184\162\224\184\161\224\184\181\224\184\161\224\184\183\224\184\173\224\184\167\224\184\178\224\184\135\224\184\173\224\184\162\224\184\185\224\185\136\224\184\154\224\184\153\224\184\157\224\184\177\224\184\129 \224\184\158\224\184\163\224\185\137\224\184\173\224\184\161\224\184\138\224\184\177\224\184\129 \224\184\130\224\184\147\224\184\176\224\184\165\224\185\135\224\184\173\224\184\129\224\185\128\224\184\155\224\185\137\224\184\178 \224\184\129\224\184\178\224\184\163\224\184\165\224\184\178\224\184\129\224\184\138\224\185\137\224\184\178\224\185\134 \224\184\151\224\184\178\224\184\135\224\184\148\224\185\137\224\184\178\224\184\153\224\184\130\224\184\167\224\184\178\224\184\130\224\184\173\224\184\135\224\184\136\224\184\173\224\184\136\224\184\176\224\184\130\224\184\162\224\184\177\224\184\154\224\184\161\224\184\183\224\184\173\224\184\154\224\184\153\224\184\157\224\184\177\224\184\129 \224\185\129\224\184\165\224\184\176\224\184\129\224\184\178\224\184\163<b>\224\184\170\224\184\176\224\184\154\224\184\177\224\184\148</b>\224\185\128\224\184\163\224\185\135\224\184\167\224\185\134 \224\184\136\224\184\176\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154 \224\184\151\224\184\180\224\184\168\224\184\151\224\184\181\224\185\136\224\184\170\224\184\176\224\184\154\224\184\177\224\184\148\224\184\136\224\184\176\224\185\128\224\184\165\224\184\183\224\184\173\224\184\129\224\184\151\224\185\136\224\184\178\224\184\159\224\184\177\224\184\153\n\n<b>\224\184\165\224\185\135\224\184\173\224\184\129\224\185\129\224\184\165\224\185\137\224\184\167</b>: \224\185\129\224\184\149\224\184\176\224\185\128\224\184\158\224\184\183\224\185\136\224\184\173\224\184\170\224\184\165\224\184\177\224\184\154\224\185\128\224\184\155\224\185\137\224\184\178 \224\184\129\224\184\148\224\184\132\224\185\137\224\184\178\224\184\135\224\185\128\224\184\158\224\184\183\224\185\136\224\184\173\224\184\155\224\184\180\224\184\148\224\184\165\224\185\135\224\184\173\224\184\129\224\185\128\224\184\155\224\185\137\224\184\178 <b>\224\184\165\224\185\135\224\184\173\224\184\129\224\185\128\224\184\155\224\185\137\224\184\178</b>: \224\185\129\224\184\149\224\184\176\224\185\128\224\184\158\224\184\183\224\185\136\224\184\173\224\185\128\224\184\155\224\184\180\224\184\148\224\184\129\224\184\165\224\184\177\224\184\154\224\184\161\224\184\178\n<b>\224\184\155\224\184\165\224\185\136\224\184\173\224\184\162\224\184\148\224\184\178\224\184\154</b>: \224\184\129\224\184\148\224\184\132\224\185\137\224\184\178\224\184\135\224\185\128\224\184\158\224\184\183\224\185\136\224\184\173\224\184\155\224\184\165\224\185\136\224\184\173\224\184\162\224\184\148\224\184\178\224\184\154 <b>\224\184\136\224\184\177\224\184\154\224\184\148\224\184\178\224\184\154</b>: \224\185\129\224\184\149\224\184\176\224\185\128\224\184\158\224\184\183\224\185\136\224\184\173\224\184\136\224\184\177\224\184\154\224\184\148\224\184\178\224\184\154\224\184\173\224\184\181\224\184\129\224\184\132\224\184\163\224\184\177\224\185\137\224\184\135",
		["<b>Flick right</b>: horizontal slice.\n<b>Flick down</b>: vertical slice.\n<b>Flick up-right</b>: low cut.\n\n<b>CALM DRAW</b>: the blade slides out slowly into a guard, with no cut."] = "<b>\224\184\170\224\184\176\224\184\154\224\184\177\224\184\148\224\185\132\224\184\155\224\184\130\224\184\167\224\184\178</b>: \224\184\159\224\184\177\224\184\153\224\185\129\224\184\153\224\184\167\224\184\153\224\184\173\224\184\153\n<b>\224\184\170\224\184\176\224\184\154\224\184\177\224\184\148\224\184\165\224\184\135</b>: \224\184\159\224\184\177\224\184\153\224\185\129\224\184\153\224\184\167\224\184\149\224\184\177\224\185\137\224\184\135\n<b>\224\184\170\224\184\176\224\184\154\224\184\177\224\184\148\224\184\130\224\184\182\224\185\137\224\184\153\224\184\130\224\184\167\224\184\178</b>: \224\184\159\224\184\177\224\184\153\224\184\149\224\185\136\224\184\179\n\n<b>\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154\224\184\170\224\184\135\224\184\154</b>: \224\184\148\224\184\178\224\184\154\224\184\136\224\184\176\224\184\132\224\185\136\224\184\173\224\184\162\224\185\134 \224\185\128\224\184\165\224\184\183\224\185\136\224\184\173\224\184\153\224\184\173\224\184\173\224\184\129\224\184\161\224\184\178\224\185\128\224\184\155\224\185\135\224\184\153\224\184\151\224\185\136\224\184\178\224\184\129\224\184\178\224\184\163\224\185\140\224\184\148 \224\185\130\224\184\148\224\184\162\224\185\132\224\184\161\224\185\136\224\184\159\224\184\177\224\184\153",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>SHEATHE</b>: put the blade away. The next draw is ready about a second later."] = "\224\184\159\224\184\177\224\184\153\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154\224\184\136\224\184\176\224\184\136\224\184\177\224\184\154\224\184\148\224\184\178\224\184\154\224\185\132\224\184\167\224\185\137\224\185\129\224\184\153\224\185\136\224\184\153 \224\184\148\224\184\178\224\184\154\224\184\151\224\184\181\224\185\136\224\185\130\224\184\148\224\184\153\224\184\159\224\184\177\224\184\153\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154\224\184\136\224\184\176\224\184\150\224\184\185\224\184\129\224\184\155\224\184\177\224\184\148\224\184\173\224\184\173\224\184\129\224\185\129\224\184\165\224\184\176\224\185\128\224\184\170\224\184\181\224\184\162\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165 {block} \224\184\159\224\184\177\224\184\153\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154\224\185\129\224\184\149\224\185\136\224\184\165\224\184\176\224\184\132\224\184\163\224\184\177\224\185\137\224\184\135\224\185\128\224\184\170\224\184\181\224\184\162\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165 {draw}\n\n<b>\224\185\128\224\184\129\224\185\135\224\184\154\224\184\148\224\184\178\224\184\154</b>: \224\185\128\224\184\129\224\185\135\224\184\154\224\184\148\224\184\178\224\184\154\224\185\128\224\184\130\224\185\137\224\184\178\224\184\157\224\184\177\224\184\129 \224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154\224\184\132\224\184\163\224\184\177\224\185\137\224\184\135\224\184\149\224\185\136\224\184\173\224\185\132\224\184\155\224\185\132\224\184\148\224\185\137\224\185\131\224\184\153\224\184\173\224\184\181\224\184\129\224\184\163\224\184\178\224\184\167\224\184\171\224\184\153\224\184\182\224\185\136\224\184\135\224\184\167\224\184\180\224\184\153\224\184\178\224\184\151\224\184\181",
		["Clashes and parries"] = "\224\184\129\224\184\178\224\184\163\224\184\155\224\184\176\224\184\151\224\184\176\224\185\129\224\184\165\224\184\176\224\184\129\224\184\178\224\184\163\224\184\155\224\184\177\224\184\148\224\184\155\224\185\137\224\184\173\224\184\135",
		["Blades that meet push each other apart, and the firmer blade moves less. A hard swing knocks a still blade far aside, and that blade is slow to recover: an opening to attack.\n\nHit near the hands, a blade barely moves. Hit near the tip, it\'s knocked aside easily."] = "\224\184\148\224\184\178\224\184\154\224\184\151\224\184\181\224\185\136\224\184\155\224\184\176\224\184\151\224\184\176\224\184\129\224\184\177\224\184\153\224\184\136\224\184\176\224\184\156\224\184\165\224\184\177\224\184\129\224\184\129\224\184\177\224\184\153\224\184\173\224\184\173\224\184\129 \224\184\148\224\184\178\224\184\154\224\184\151\224\184\181\224\185\136\224\184\136\224\184\177\224\184\154\224\185\129\224\184\153\224\185\136\224\184\153\224\184\129\224\184\167\224\185\136\224\184\178\224\184\136\224\184\176\224\184\130\224\184\162\224\184\177\224\184\154\224\184\153\224\185\137\224\184\173\224\184\162\224\184\129\224\184\167\224\185\136\224\184\178 \224\184\129\224\184\178\224\184\163\224\184\159\224\184\178\224\184\148\224\185\129\224\184\163\224\184\135\224\184\136\224\184\176\224\184\155\224\184\177\224\184\148\224\184\148\224\184\178\224\184\154\224\184\151\224\184\181\224\185\136\224\184\153\224\184\180\224\185\136\224\184\135\224\184\173\224\184\162\224\184\185\224\185\136\224\184\173\224\184\173\224\184\129\224\185\132\224\184\155\224\185\132\224\184\129\224\184\165 \224\185\129\224\184\165\224\184\176\224\184\148\224\184\178\224\184\154\224\184\153\224\184\177\224\185\137\224\184\153\224\184\136\224\184\176\224\184\129\224\184\165\224\184\177\224\184\154\224\184\161\224\184\178\224\184\138\224\185\137\224\184\178: \224\185\128\224\184\155\224\185\135\224\184\153\224\184\138\224\185\136\224\184\173\224\184\135\224\185\131\224\184\171\224\185\137\224\185\130\224\184\136\224\184\161\224\184\149\224\184\181\n\n\224\184\150\224\185\137\224\184\178\224\185\130\224\184\148\224\184\153\224\185\131\224\184\129\224\184\165\224\185\137\224\184\161\224\184\183\224\184\173 \224\184\148\224\184\178\224\184\154\224\185\129\224\184\151\224\184\154\224\185\132\224\184\161\224\185\136\224\184\130\224\184\162\224\184\177\224\184\154 \224\184\150\224\185\137\224\184\178\224\185\130\224\184\148\224\184\153\224\185\131\224\184\129\224\184\165\224\185\137\224\184\155\224\184\165\224\184\178\224\184\162\224\184\148\224\184\178\224\184\154 \224\184\148\224\184\178\224\184\154\224\184\136\224\184\176\224\184\150\224\184\185\224\184\129\224\184\155\224\184\177\224\184\148\224\184\173\224\184\173\224\184\129\224\184\135\224\185\136\224\184\178\224\184\162",
		["<b>Draw-cuts</b> hit hardest. A blade held still that meets a draw-cut, or the drawer while the blade comes out, is knocked aside, and the cut goes through.\n\n<b>A still guard</b> (L2 on a gamepad) parries other swings: the swing bounces off and the attacker is staggered.\n\n<b>Two swings meeting</b> both give way, and neither can cut for a moment.\n\nThe whole sword can clash, handle included."] = "<b>\224\184\159\224\184\177\224\184\153\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154</b>\224\184\129\224\184\163\224\184\176\224\185\129\224\184\151\224\184\129\224\185\129\224\184\163\224\184\135\224\184\151\224\184\181\224\185\136\224\184\170\224\184\184\224\184\148 \224\184\148\224\184\178\224\184\154\224\184\151\224\184\181\224\185\136\224\184\150\224\184\183\224\184\173\224\184\153\224\184\180\224\185\136\224\184\135\224\185\132\224\184\167\224\185\137 \224\184\150\224\185\137\224\184\178\224\185\130\224\184\148\224\184\153\224\184\159\224\184\177\224\184\153\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154 \224\184\171\224\184\163\224\184\183\224\184\173\224\185\132\224\184\155\224\185\130\224\184\148\224\184\153\224\184\149\224\184\177\224\184\167\224\184\132\224\184\153\224\184\151\224\184\181\224\185\136\224\184\129\224\184\179\224\184\165\224\184\177\224\184\135\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154\224\184\173\224\184\173\224\184\129 \224\184\136\224\184\176\224\184\150\224\184\185\224\184\129\224\184\155\224\184\177\224\184\148\224\184\129\224\184\163\224\184\176\224\185\128\224\184\148\224\185\135\224\184\153\224\184\173\224\184\173\224\184\129 \224\185\129\224\184\165\224\184\176\224\184\129\224\184\178\224\184\163\224\184\159\224\184\177\224\184\153\224\184\136\224\184\176\224\184\156\224\185\136\224\184\178\224\184\153\224\185\132\224\184\155\224\185\132\224\184\148\224\185\137\n\n<b>\224\184\149\224\184\177\224\185\137\224\184\135\224\184\129\224\184\178\224\184\163\224\185\140\224\184\148\224\184\153\224\184\180\224\185\136\224\184\135</b> (L2 \224\184\154\224\184\153\224\184\136\224\184\173\224\184\162\224\185\128\224\184\129\224\184\161) \224\184\155\224\184\177\224\184\148\224\184\155\224\185\137\224\184\173\224\184\135\224\184\129\224\184\178\224\184\163\224\184\159\224\184\178\224\184\148\224\185\129\224\184\154\224\184\154\224\184\173\224\184\183\224\185\136\224\184\153\224\185\132\224\184\148\224\185\137: \224\184\148\224\184\178\224\184\154\224\184\151\224\184\181\224\185\136\224\184\159\224\184\178\224\184\148\224\184\161\224\184\178\224\184\136\224\184\176\224\185\128\224\184\148\224\185\137\224\184\135\224\184\173\224\184\173\224\184\129 \224\185\129\224\184\165\224\184\176\224\184\157\224\185\136\224\184\178\224\184\162\224\185\130\224\184\136\224\184\161\224\184\149\224\184\181\224\184\136\224\184\176\224\184\138\224\184\176\224\184\135\224\184\177\224\184\129\n\n<b>\224\184\159\224\184\178\224\184\148\224\184\170\224\184\167\224\184\153\224\184\129\224\184\177\224\184\153</b> \224\184\151\224\184\177\224\185\137\224\184\135\224\184\170\224\184\173\224\184\135\224\184\157\224\185\136\224\184\178\224\184\162\224\184\136\224\184\176\224\185\128\224\184\170\224\184\181\224\184\162\224\184\136\224\184\177\224\184\135\224\184\171\224\184\167\224\184\176 \224\185\129\224\184\165\224\184\176\224\184\159\224\184\177\224\184\153\224\185\132\224\184\161\224\185\136\224\185\132\224\184\148\224\185\137\224\184\138\224\184\177\224\185\136\224\184\167\224\184\132\224\184\163\224\184\185\224\185\136\n\n\224\184\148\224\184\178\224\184\154\224\184\155\224\184\176\224\184\151\224\184\176\224\185\132\224\184\148\224\185\137\224\184\151\224\184\177\224\185\137\224\184\135\224\185\128\224\184\165\224\185\136\224\184\161 \224\184\163\224\184\167\224\184\161\224\184\150\224\184\182\224\184\135\224\184\148\224\185\137\224\184\178\224\184\161\224\184\148\224\185\137\224\184\167\224\184\162",
		["Cuts, wounds and bleeding"] = "\224\184\129\224\184\178\224\184\163\224\184\159\224\184\177\224\184\153 \224\184\154\224\184\178\224\184\148\224\185\129\224\184\156\224\184\165 \224\185\129\224\184\165\224\184\176\224\185\128\224\184\165\224\184\183\224\184\173\224\184\148\224\185\132\224\184\171\224\184\165",
		["A cut needs speed and a leading edge. Speed comes from the swing and from movement, so dashing past counts. A sudden change of direction hits with the flat.\n\nOnly a blade moving into a target counts. A blade left resting in a body sticks."] = "\224\184\129\224\184\178\224\184\163\224\184\159\224\184\177\224\184\153\224\184\149\224\185\137\224\184\173\224\184\135\224\184\161\224\184\181\224\184\132\224\184\167\224\184\178\224\184\161\224\185\128\224\184\163\224\185\135\224\184\167\224\185\129\224\184\165\224\184\176\224\185\131\224\184\138\224\185\137\224\184\132\224\184\161\224\184\148\224\184\178\224\184\154\224\184\153\224\184\179 \224\184\132\224\184\167\224\184\178\224\184\161\224\185\128\224\184\163\224\185\135\224\184\167\224\184\161\224\184\178\224\184\136\224\184\178\224\184\129\224\184\129\224\184\178\224\184\163\224\184\159\224\184\178\224\184\148\224\185\129\224\184\165\224\184\176\224\184\129\224\184\178\224\184\163\224\185\128\224\184\132\224\184\165\224\184\183\224\185\136\224\184\173\224\184\153\224\184\151\224\184\181\224\185\136 \224\184\158\224\184\184\224\185\136\224\184\135\224\184\156\224\185\136\224\184\178\224\184\153\224\184\136\224\184\182\224\184\135\224\184\153\224\184\177\224\184\154\224\184\148\224\185\137\224\184\167\224\184\162 \224\184\129\224\184\178\224\184\163\224\185\128\224\184\155\224\184\165\224\184\181\224\185\136\224\184\162\224\184\153\224\184\151\224\184\180\224\184\168\224\184\129\224\184\176\224\184\151\224\184\177\224\184\153\224\184\171\224\184\177\224\184\153\224\184\136\224\184\176\224\185\130\224\184\148\224\184\153\224\184\148\224\185\137\224\184\167\224\184\162\224\184\148\224\185\137\224\184\178\224\184\153\224\185\129\224\184\154\224\184\153\224\184\130\224\184\173\224\184\135\224\184\148\224\184\178\224\184\154\n\n\224\184\153\224\184\177\224\184\154\224\185\128\224\184\137\224\184\158\224\184\178\224\184\176\224\184\148\224\184\178\224\184\154\224\184\151\224\184\181\224\185\136\224\184\129\224\184\179\224\184\165\224\184\177\224\184\135\224\185\128\224\184\132\224\184\165\224\184\183\224\185\136\224\184\173\224\184\153\224\185\128\224\184\130\224\185\137\224\184\178\224\184\171\224\184\178\224\185\128\224\184\155\224\185\137\224\184\178\224\184\171\224\184\161\224\184\178\224\184\162 \224\184\148\224\184\178\224\184\154\224\184\151\224\184\181\224\185\136\224\184\132\224\185\137\224\184\178\224\184\135\224\184\173\224\184\162\224\184\185\224\185\136\224\185\131\224\184\153\224\184\163\224\185\136\224\184\178\224\184\135\224\184\136\224\184\176\224\184\149\224\184\180\224\184\148\224\184\173\224\184\162\224\184\185\224\185\136\224\184\149\224\184\163\224\184\135\224\184\153\224\184\177\224\185\137\224\184\153",
		["A fast, edge-first cut all the way through a limb <b>severs</b> it. Through the head or torso: <b>a kill</b>.\n\nAnything less is a <b>wound</b>: it bleeds and slows the limb. Deeper wounds are worse.\n\n<b>Stabs</b> never kill outright. A stab to the head, or a fast one to the body (dash or lunge in), takes a lot of blood at once. Other stabs wound."] = "\224\184\129\224\184\178\224\184\163\224\184\159\224\184\177\224\184\153\224\184\151\224\184\181\224\185\136\224\185\128\224\184\163\224\185\135\224\184\167 \224\185\131\224\184\138\224\185\137\224\184\132\224\184\161\224\184\153\224\184\179 \224\185\129\224\184\165\224\184\176\224\184\159\224\184\177\224\184\153\224\184\151\224\184\176\224\184\165\224\184\184\224\185\129\224\184\130\224\184\153\224\184\130\224\184\178\224\184\136\224\184\153\224\184\170\224\184\184\224\184\148 \224\184\136\224\184\176\224\184\151\224\184\179\224\185\131\224\184\171\224\185\137\224\185\129\224\184\130\224\184\153\224\184\130\224\184\178<b>\224\184\130\224\184\178\224\184\148</b> \224\184\151\224\184\176\224\184\165\224\184\184\224\184\171\224\184\177\224\184\167\224\184\171\224\184\163\224\184\183\224\184\173\224\184\165\224\184\179\224\184\149\224\184\177\224\184\167: <b>\224\184\149\224\184\178\224\184\162</b>\n\n\224\184\153\224\185\137\224\184\173\224\184\162\224\184\129\224\184\167\224\185\136\224\184\178\224\184\153\224\184\177\224\185\137\224\184\153\224\184\132\224\184\183\224\184\173<b>\224\184\154\224\184\178\224\184\148\224\185\129\224\184\156\224\184\165</b>: \224\185\128\224\184\165\224\184\183\224\184\173\224\184\148\224\185\132\224\184\171\224\184\165 \224\185\129\224\184\165\224\184\176\224\185\129\224\184\130\224\184\153\224\184\130\224\184\178\224\184\153\224\184\177\224\185\137\224\184\153\224\184\138\224\185\137\224\184\178\224\184\165\224\184\135 \224\185\129\224\184\156\224\184\165\224\184\162\224\184\180\224\185\136\224\184\135\224\184\165\224\184\182\224\184\129\224\184\162\224\184\180\224\185\136\224\184\135\224\185\129\224\184\162\224\185\136\n\n<b>\224\185\129\224\184\151\224\184\135</b>\224\185\132\224\184\161\224\185\136\224\185\128\224\184\132\224\184\162\224\184\151\224\184\179\224\185\131\224\184\171\224\185\137\224\184\149\224\184\178\224\184\162\224\185\131\224\184\153\224\184\151\224\184\181\224\185\128\224\184\148\224\184\181\224\184\162\224\184\167 \224\185\129\224\184\151\224\184\135\224\184\151\224\184\181\224\185\136\224\184\171\224\184\177\224\184\167 \224\184\171\224\184\163\224\184\183\224\184\173\224\185\129\224\184\151\224\184\135\224\185\128\224\184\163\224\185\135\224\184\167\224\184\151\224\184\181\224\185\136\224\184\165\224\184\179\224\184\149\224\184\177\224\184\167 (\224\184\158\224\184\184\224\185\136\224\184\135\224\184\171\224\184\163\224\184\183\224\184\173\224\185\130\224\184\150\224\184\161\224\185\128\224\184\130\224\185\137\224\184\178\224\185\132\224\184\155) \224\184\136\224\184\176\224\185\128\224\184\170\224\184\181\224\184\162\224\185\128\224\184\165\224\184\183\224\184\173\224\184\148\224\184\161\224\184\178\224\184\129\224\185\131\224\184\153\224\184\151\224\184\177\224\184\153\224\184\151\224\184\181 \224\185\129\224\184\151\224\184\135\224\185\129\224\184\154\224\184\154\224\184\173\224\184\183\224\185\136\224\184\153\224\185\128\224\184\155\224\185\135\224\184\153\224\185\129\224\184\156\224\184\165",
		["Every fighter has {squares} squares of blood. Wounds bleed for a few seconds, and so does a lost limb. With two limbs lost, the stumps bleed out. Losing both arms drops the katana.\n\nCombat is allowed in the arena and the forest, except in safe zones. Inside one, the screen shows <b>{safe}</b>."] = "\224\184\153\224\184\177\224\184\129\224\184\170\224\184\185\224\185\137\224\184\151\224\184\184\224\184\129\224\184\132\224\184\153\224\184\161\224\184\181\224\185\128\224\184\165\224\184\183\224\184\173\224\184\148 {squares} \224\184\138\224\185\136\224\184\173\224\184\135 \224\184\154\224\184\178\224\184\148\224\185\129\224\184\156\224\184\165\224\185\128\224\184\165\224\184\183\224\184\173\224\184\148\224\185\132\224\184\171\224\184\165\224\185\132\224\184\161\224\185\136\224\184\129\224\184\181\224\185\136\224\184\167\224\184\180\224\184\153\224\184\178\224\184\151\224\184\181 \224\185\129\224\184\130\224\184\153\224\184\130\224\184\178\224\184\151\224\184\181\224\185\136\224\184\130\224\184\178\224\184\148\224\184\129\224\185\135\224\185\128\224\184\138\224\185\136\224\184\153\224\184\129\224\184\177\224\184\153 \224\184\150\224\185\137\224\184\178\224\185\128\224\184\170\224\184\181\224\184\162\224\185\129\224\184\130\224\184\153\224\184\130\224\184\178\224\184\170\224\184\173\224\184\135\224\184\130\224\185\137\224\184\178\224\184\135 \224\185\128\224\184\165\224\184\183\224\184\173\224\184\148\224\184\136\224\184\176\224\185\132\224\184\171\224\184\165\224\184\136\224\184\178\224\184\129\224\184\163\224\184\173\224\184\162\224\184\130\224\184\178\224\184\148\224\184\136\224\184\153\224\184\149\224\184\178\224\184\162 \224\185\128\224\184\170\224\184\181\224\184\162\224\185\129\224\184\130\224\184\153\224\184\151\224\184\177\224\185\137\224\184\135\224\184\170\224\184\173\224\184\135\224\184\130\224\185\137\224\184\178\224\184\135\224\184\136\224\184\176\224\184\151\224\184\179\224\184\132\224\184\178\224\184\149\224\184\178\224\184\153\224\184\176\224\184\1