		["Grab the bellows handle with the mouse and drag it up and down"] = "\231\148\168\233\188\160\230\160\135\230\138\147\228\189\143\233\163\142\231\174\177\230\138\138\230\137\139\239\188\140\228\184\138\228\184\139\230\139\150\229\138\168",
