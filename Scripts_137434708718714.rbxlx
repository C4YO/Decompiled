		["{was}. Press **{Equip}** to sheathe, then {how}."] = "{was}. \208\157\208\176\208\182\208\188\208\184 **{Equip}**, \209\135\209\130\208\190\208\177\209\139 \209\131\208\177\209\128\208\176\209\130\209\140 \208\186\208\187\208\184\208\189\208\190\208\186 \208\178 \208\189\208\190\208\182\208\189\209\139, \208\183\208\176\209\130\208\181\208\188 {how}.",
		["{was}. Tap **SHEATHE**, then {how}."] = "{was}. \208\157\208\176\208\182\208\188\208\184 **\208\146 \208\157\208\158\208\150\208\157\208\171**, \208\183\208\176\209\130\208\181\208\188 {how}.",
		["Not a dash attack. Hold **W + A** and press **{Dash}** while passing it."] = "\208\157\208\181 \209\131\208\180\208\176\209\128 \208\178 \209\128\209\139\208\178\208\186\208\181. \208\151\208\176\208\182\208\188\208\184 **W + A** \208\184 \208\189\208\176\208\182\208\188\208\184 **{Dash}**, \208\191\209\128\208\190\209\133\208\190\208\180\209\143 \208\188\208\184\208\188\208\190.",
		["Not a dash attack. Tap **DASH** while walking past it."] = "\208\157\208\181 \209\131\208\180\208\176\209\128 \208\178 \209\128\209\139\208\178\208\186\208\181. \208\157\208\176\208\182\208\188\208\184 **\208\160\208\171\208\146\208\158\208\154**, \208\191\209\128\208\190\209\133\208\190\208\180\209\143 \208\188\208\184\208\188\208\190.",
