		["Day {day} in a row: {spins} spins a day."] = "Ng\195\160y th\225\187\169 {day} li\195\170n ti\225\186\191p: {spins} l\198\176\225\187\163t quay m\225\187\151i ng\195\160y.",
		["Day {day} in a row. From day {from} you get {spins} a day."] = "Ng\195\160y th\225\187\169 {day} li\195\170n ti\225\186\191p. T\225\187\171 ng\195\160y {from} b\225\186\161n nh\225\186\173n {spins} l\198\176\225\187\163t m\225\187\151i ng\195\160y.",
		["MERRY CHRISTMAS"] = "GI\195\129NG SINH VUI V\225\186\186",
		["A gift for playing on Christmas Day."] = "Qu\195\160 t\225\186\183ng v\195\172 b\225\186\161n \196\145\195\163 ch\198\161i v\195\160o ng\195\160y Gi\195\161ng Sinh.",
		["DAILY BONUS"] = "TH\198\175\225\187\158NG H\225\186\176NG NG\195\128Y",
		["+{xp} XP"] = "+{xp} XP",
		["All daily quests done"] = "Xong m\225\187\141i nhi\225\187\135m v\225\187\165 h\225\186\177ng ng\195\160y",
		["ADVENT CALENDAR"] = "L\225\187\138CH M\195\153A V\225\187\140NG",
		["Day {day} of 25"] = "Ng\195\160y {day}/25",
		["no boost"] = "kh\195\180ng c\195\179 buff",
		["{count} boost: +{walk} walk speed or +{other} to another stat"] = "{count} buff: +{walk} t\225\187\145c \196\145\225\187\153 \196\145i ho\225\186\183c +{other} cho ch\225\187\137 s\225\187\145 kh\195\161c",
		["{count} boosts, each +{walk} walk speed or +{other} to another stat"] = "{count} buff, m\225\187\151i buff +{walk} t\225\187\145c \196\145\225\187\153 \196\145i ho\225\186\183c +{other} cho ch\225\187\137 s\225\187\145 kh\195\161c",
		["Safe zone: combat forbidden"] = "V\195\185ng an to\195\160n: c\225\186\165m giao chi\225\186\191n",
		["Names and boosts"] = "H\225\187\141 t\195\170n v\195\160 buff",
		["<b>Family name</b>: rolled once, at the forge.\n<b>First name</b>: reroll any time on the character screen (CHARACTER, on the title screen).\n\nRarer family names give stat boosts. Boosts are kept small, so fights are still won with the blade."] = "<b>H\225\187\141</b>: \196\145\198\176\225\187\163c quay m\225\187\153t l\225\186\167n, t\225\186\161i l\195\178 r\195\168n.\n<b>T\195\170n</b>: \196\145\225\187\149i \196\145\198\176\225\187\163c b\225\186\165t c\225\187\169 l\195\186c n\195\160o \225\187\159 m\195\160n h\195\172nh nh\195\162n v\225\186\173t (NH\195\130N V\225\186\172T, \225\187\159 m\195\160n h\195\172nh ch\195\173nh).\n\nH\225\187\141 hi\225\186\191m h\198\161n cho buff ch\225\187\137 s\225\187\145. Buff \196\145\198\176\225\187\163c gi\225\187\175 \225\187\159 m\225\187\169c nh\225\187\143 \196\145\225\187\131 tr\225\186\173n \196\145\225\186\165u v\225\186\171n \196\145\198\176\225\187\163c quy\225\186\191t \196\145\225\187\139nh b\225\186\177ng l\198\176\225\187\161i ki\225\186\191m.",
		["Rarity, odds and boosts:\n\n{rarities}\n\nThe rarest names belong to famous swordsmen and warlords. A Mythic name is a legend\'s own name, used in place of a family name. An Exotic name is a god\'s. Every spin is pure chance at these odds."] = "\196\144\225\187\153 hi\225\186\191m, t\225\187\137 l\225\187\135 v\195\160 buff:\n\n{rarities}\n\nNh\225\187\175ng h\225\187\141 hi\225\186\191m nh\225\186\165t thu\225\187\153c v\225\187\129 c\195\161c ki\225\186\191m s\196\169 v\195\160 l\195\163nh ch\195\186a n\225\187\149i ti\225\186\191ng. T\195\170n Th\225\186\167n tho\225\186\161i l\195\160 t\195\170n ri\195\170ng c\225\187\167a m\225\187\153t huy\225\187\129n tho\225\186\161i, d\195\185ng thay cho h\225\187\141. T\195\170n T\225\187\145i th\198\176\225\187\163ng l\195\160 t\195\170n c\225\187\167a m\225\187\153t v\225\187\139 th\225\186\167n. M\225\187\151i l\198\176\225\187\163t quay ho\195\160n to\195\160n ng\225\186\171u nhi\195\170n theo c\195\161c t\225\187\137 l\225\187\135 n\195\160y.",
		["Boosts:\n\n<b>Walk speed</b>: faster movement.\n<b>Poise recovery</b>: poise refills faster.\n<b>Poise toughness</b>: all poise costs are lower.\n<b>Slower bleeding</b>: wounds and stumps bleed slower.\n<b>Faster dash recharge</b>: dash charges refill sooner.\n\nBoosts stack with forge upgrades."] = "C\195\161c buff:\n\n<b>T\225\187\145c \196\145\225\187\153 \196\145i</b>: di chuy\225\187\131n nhanh h\198\161n.\n<b>H\225\187\147i \196\145\225\187\153 v\225\187\175ng</b>: \196\145\225\187\153 v\225\187\175ng h\225\187\147i l\225\186\161i nhanh h\198\161n.\n<b>\196\144\225\187\153 l\195\172</b>: m\225\187\141i m\225\187\169c ti\195\170u hao \196\145\225\187\153 v\225\187\175ng \196\145\225\187\129u th\225\186\165p h\198\161n.\n<b>Ch\225\186\163y m\195\161u ch\225\186\173m h\198\161n</b>: v\225\186\191t th\198\176\198\161ng v\195\160 m\225\187\143m c\225\187\165t ch\225\186\163y m\195\161u ch\225\186\173m h\198\161n.\n<b>H\225\187\147i l\198\176\225\187\155t nhanh h\198\161n</b>: c\195\161c l\198\176\225\187\163t l\198\176\225\187\155t h\225\187\147i l\225\186\161i s\225\187\155m h\198\161n.\n\nBuff c\225\187\153ng d\225\187\147n v\225\187\155i n\195\162ng c\225\186\165p t\225\187\171 l\195\178 r\195\168n.",
		["<b>Rename spins</b> reroll the family name. Get {spins} free spins every level, or buy more in the SHOP. Use them on the character screen. The old name can always be kept.\n\nBots have names too. The rarer a bot\'s name, the better it fights."] = "<b>L\198\176\225\187\163t quay t\195\170n</b> d\195\185ng \196\145\225\187\131 quay h\225\187\141 m\225\187\155i. Nh\225\186\173n {spins} l\198\176\225\187\163t quay mi\225\187\133n ph\195\173 m\225\187\151i c\225\186\165p, ho\225\186\183c mua th\195\170m \225\187\159 C\225\187\172A H\195\128NG. D\195\185ng ch\195\186ng \225\187\159 m\195\160n h\195\172nh nh\195\162n v\225\186\173t. Lu\195\180n c\195\179 th\225\187\131 gi\225\187\175 l\225\186\161i h\225\187\141 c\197\169.\n\nBot c\197\169ng c\195\179 t\195\170n. T\195\170n bot c\195\160ng hi\225\186\191m, bot \196\145\195\161nh c\195\160ng gi\225\187\143i.",
		["Poise"] = "\196\144\225\187\153 v\225\187\175ng",
		["<b>Poise</b> is a fighter\'s steadiness. The poise bar is the thin bar above the blood squares; an opponent\'s is under their name. It grows from the middle as poise is lost, turning from gold to red, and hides at full poise."] = "<b>\196\144\225\187\153 v\225\187\175ng</b> l\195\160 s\225\187\177 v\225\187\175ng v\195\160ng c\225\187\167a \196\145\225\186\165u s\196\169. Thanh \196\145\225\187\153 v\225\187\175ng l\195\160 thanh m\225\187\143ng ph\195\173a tr\195\170n c\195\161c \195\180 m\195\161u; thanh c\225\187\167a \196\145\225\187\145i th\225\187\167 n\225\186\177m d\198\176\225\187\155i t\195\170n \196\145\225\187\145i th\225\187\167. Thanh d\195\160i ra t\225\187\171 gi\225\187\175a khi m\225\186\165t \196\145\225\187\153 v\225\187\175ng, chuy\225\187\131n t\225\187\171 v\195\160ng sang \196\145\225\187\143, v\195\160 \225\186\169n \196\145i khi \196\145\225\187\153 v\225\187\175ng \196\145\225\186\167y.",
		["Poise costs:\n\n<b>Draw-cut</b>: {draw}.  <b>Blade hit by a draw-cut</b>: {block}.\n<b>Hard swing</b>: {swing}.  <b>Dash</b>: {dash}.  <b>Kick</b>: {kick}.\n<b>Taking a cut</b>: {wound} (double from a draw-cut), plus blood loss.\n<b>Clashes</b>: more the harder the blade is knocked."] = "M\225\187\169c ti\195\170u hao \196\145\225\187\153 v\225\187\175ng:\n\n<b>\196\144\195\178n r\195\186t ki\225\186\191m</b>: {draw}.  <b>L\198\176\225\187\161i ki\225\186\191m tr\195\186ng \196\145\195\178n r\195\186t ki\225\186\191m</b>: {block}.\n<b>Nh\195\161t vung m\225\186\161nh</b>: {swing}.  <b>C\195\186 l\198\176\225\187\155t</b>: {dash}.  <b>C\195\186 \196\145\195\161</b>: {kick}.\n<b>B\225\187\139 ch\195\169m</b>: {wound} (g\225\186\165p \196\145\195\180i n\225\186\191u l\195\160 \196\145\195\178n r\195\186t ki\225\186\191m), c\225\187\153ng th\195\170m m\225\186\165t m\195\161u.\n<b>Ch\225\186\161m ki\225\186\191m</b>: ki\225\186\191m b\225\187\139 \196\145\195\161nh b\225\186\173t c\195\160ng m\225\186\161nh th\195\172 t\225\187\145n c\195\160ng nhi\225\187\129u.",
		["Poise refills after {delay} seconds with no poise lost, at {regen} per second. A still guard (L2 on a gamepad) refills it faster; low blood refills it slower.\n\nBelow half poise, blade and movement speed drop, and the blade is knocked aside more easily."] = "\196\144\225\187\153 v\225\187\175ng h\225\187\147i l\225\186\161i sau {delay} gi\195\162y kh\195\180ng m\225\186\165t \196\145\225\187\153 v\225\187\175ng, v\225\187\155i t\225\187\145c \196\145\225\187\153 {regen} m\225\187\151i gi\195\162y. Th\225\186\191 th\225\187\167 \196\145\225\187\169ng y\195\170n (L2 tr\195\170n tay c\225\186\167m ch\198\161i game) gi\195\186p h\225\187\147i nhanh h\198\161n; \195\173t m\195\161u th\195\172 h\225\187\147i ch\225\186\173m h\198\161n.\n\nD\198\176\225\187\155i m\225\187\153t n\225\187\173a \196\145\225\187\153 v\225\187\175ng, t\225\187\145c \196\145\225\187\153 ki\225\186\191m v\195\160 di chuy\225\187\131n gi\225\186\163m, v\195\160 ki\225\186\191m d\225\187\133 b\225\187\139 \196\145\195\161nh b\225\186\173t h\198\161n.",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> ({Wipe}). See the next scroll."] = "Khi v\225\187\129 kh\195\180ng, \196\145\225\187\153 v\225\187\175ng s\225\186\189 <b>v\225\187\161</b>: cho\195\161ng {stagger} gi\195\162y, r\225\187\147i suy y\225\186\191u {weakened} gi\195\162y (ch\225\186\173m h\198\161n {slower}, h\225\187\165t h\198\161i, vi\225\187\129n m\195\160n h\195\172nh t\225\187\145i d\225\186\167n). Sau \196\145\195\179 \196\145\225\187\153 v\225\187\175ng h\225\187\147i v\225\187\129 m\225\187\153t n\225\187\173a.\n\nC\195\161ch nhanh nh\225\186\165t \196\145\225\187\131 h\225\187\147i \196\145\225\186\167y \196\145\225\187\153 v\225\187\175ng l\195\160 <b>lau ki\225\186\191m</b> ({Wipe}). Xem cu\225\187\153n th\198\176 k\225\186\191 ti\225\186\191p.",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> (WIPE). See the next scroll."] = "Khi v\225\187\129 kh\195\180ng, \196\145\225\187\153 v\225\187\175ng s\225\186\189 <b>v\225\187\161</b>: cho\195\161ng {stagger} gi\195\162y, r\225\187\147i suy y\225\186\191u {weakened} gi\195\162y (ch\225\186\173m h\198\161n {slower}, h\225\187\165t h\198\161i, vi\225\187\129n m\195\160n h\195\172nh t\225\187\145i d\225\186\167n). Sau \196\145\195\179 \196\145\225\187\153 v\225\187\175ng h\225\187\147i v\225\187\129 m\225\187\153t n\225\187\173a.\n\nC\195\161ch nhanh nh\225\186\165t \196\145\225\187\131 h\225\187\147i \196\145\225\186\167y \196\145\225\187\153 v\225\187\175ng l\195\160 <b>lau ki\225\186\191m</b> (LAU KI\225\186\190M). Xem cu\225\187\153n th\198\176 k\225\186\191 ti\225\186\191p.",
		["Wiping the blade"] = "Lau ki\225\186\191m",
		["Cuts leave blood on the blade. With the blade drawn, press <b>{Wipe}</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "C\195\161c nh\195\161t ch\195\169m \196\145\225\187\131 l\225\186\161i m\195\161u tr\195\170n ki\225\186\191m. Khi ki\225\186\191m \196\145\195\163 r\195\186t ra, nh\225\186\165n <b>{Wipe}</b> \196\145\225\187\131 lau b\225\186\177ng v\225\186\163i, h\225\186\191t m\225\186\183t n\195\160y \196\145\225\186\191n m\225\186\183t kia. M\225\187\151i l\225\186\167n lau m\225\186\165t kho\225\186\163ng {time} gi\195\162y.",
		["<b>Wiping restores poise.</b> During a wipe, poise refills at {times}x speed, and a finished wipe fills it to full.\n\nAfter a poise break, a finished wipe also ends the weakened state."] = "<b>Lau ki\225\186\191m h\225\187\147i l\225\186\161i \196\145\225\187\153 v\225\187\175ng.</b> Trong khi lau, \196\145\225\187\153 v\225\187\175ng h\225\187\147i nhanh g\225\186\165p {times} l\225\186\167n, v\195\160 lau xong s\225\186\189 h\225\187\147i \196\145\225\186\167y \196\145\225\187\153 v\225\187\175ng.\n\nSau khi \196\145\225\187\153 v\225\187\175ng v\225\187\161, lau xong c\197\169ng ch\225\186\165m d\225\187\169t tr\225\186\161ng th\195\161i suy y\225\186\191u.",
		["<b>Wiping leaves an opening.</b> Once a wipe starts, steering, guarding and cutting are locked until it ends, and a swing into the loose blade knocks it far aside. Losing poise mid-wipe cancels the full refill.\n\nBots punish wipes. Make some distance first.\n\nA later forge rank unlocks a quicker wipe."] = "<b>Lau ki\225\186\191m \196\145\225\187\131 l\225\187\153 s\198\161 h\225\187\159.</b> Khi \196\145\195\163 b\225\186\175t \196\145\225\186\167u lau, vi\225\187\135c \196\145i\225\187\129u khi\225\187\131n ki\225\186\191m, \196\145\225\187\161 v\195\160 ch\195\169m b\225\187\139 kh\195\179a cho \196\145\225\186\191n khi lau xong, v\195\160 m\225\187\153t nh\195\161t vung v\195\160o l\198\176\225\187\161i ki\225\186\191m \196\145ang l\225\187\143ng s\225\186\189 \196\145\195\161nh b\225\186\173t n\195\179 ra xa. M\225\186\165t \196\145\225\187\153 v\225\187\175ng gi\225\187\175a l\195\186c lau s\225\186\189 h\225\187\167y vi\225\187\135c h\225\187\147i \196\145\225\186\167y.\n\nBot s\225\186\189 tr\225\187\171ng ph\225\186\161t vi\225\187\135c lau ki\225\186\191m. H\195\163y gi\195\163n kho\225\186\163ng c\195\161ch tr\198\176\225\187\155c.\n\nB\225\186\173c r\195\168n cao h\198\161n s\225\186\189 m\225\187\159 kh\195\179a c\195\161ch lau nhanh h\198\161n.",
		["Cuts leave blood on the blade. With the blade drawn, tap <b>WIPE</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "C\195\161c nh\195\161t ch\195\169m \196\145\225\187\131 l\225\186\161i m\195\161u tr\195\170n ki\225\186\191m. Khi ki\225\186\191m \196\145\195\163 r\195\186t ra, ch\225\186\161m <b>LAU KI\225\186\190M</b> \196\145\225\187\131 lau b\225\186\177ng v\225\186\163i, h\225\186\191t m\225\186\183t n\195\160y \196\145\225\186\191n m\225\186\183t kia. M\225\187\151i l\225\186\167n lau m\225\186\165t kho\225\186\163ng {time} gi\195\162y.",
		["Drawing the sword"] = "R\195\186t ki\225\186\191m",
		["The sword starts sheathed, with a hand on the sheath, ready to draw.\n\n<b>{Lock}</b>: toggle lock-on. While locked on, the mouse picks the cut; its name shows at the bottom of the screen.\n<b>{NextTarget}</b>: switch target.\n<b>{Unequip}</b>: unequip the sword. <b>{Equip}</b>: equip it again."] = "Ki\225\186\191m b\225\186\175t \196\145\225\186\167u trong v\225\187\143, tay \196\145\225\186\183t tr\195\170n v\225\187\143, s\225\186\181n s\195\160ng r\195\186t.\n\n<b>{Lock}</b>: b\225\186\173t/t\225\186\175t kh\195\179a m\225\187\165c ti\195\170u. Khi \196\145ang kh\195\179a, chu\225\187\153t ch\225\187\141n nh\195\161t ch\195\169m; t\195\170n nh\195\161t ch\195\169m hi\225\187\135n \225\187\159 d\198\176\225\187\155i c\195\185ng m\195\160n h\195\172nh.\n<b>{NextTarget}</b>: \196\145\225\187\149i m\225\187\165c ti\195\170u.\n<b>{Unequip}</b>: bu\195\180ng ki\225\186\191m. <b>{Equip}</b>: c\225\186\167m l\225\186\161i ki\225\186\191m.",
		["Move the mouse to pick the cut, then hold {Draw} and swipe:\n\n<b>Down-left</b>, swipe up-right: low cut.\n<b>Left</b>, swipe right: horizontal slice.\n<b>Up-left</b>, swipe down-right: diagonal cut.\n<b>Up</b>, swipe down: vertical slice.\n\nA faster swipe makes a faster cut.\n\n<b>{CalmDraw}</b>: calm draw. The blade slides out slowly into a guard, with no cut."] = "Di chu\225\187\153t \196\145\225\187\131 ch\225\187\141n nh\195\161t ch\195\169m, r\225\187\147i gi\225\187\175 {Draw} v\195\160 lia:\n\n<b>D\198\176\225\187\155i-tr\195\161i</b>, lia l\195\170n-ph\225\186\163i: ch\195\169m th\225\186\165p.\n<b>Tr\195\161i</b>, lia sang ph\225\186\163i: ch\195\169m ngang.\n<b>Tr\195\170n-tr\195\161i</b>, lia xu\225\187\145ng-ph\225\186\163i: ch\195\169m ch\195\169o.\n<b>Tr\195\170n</b>, lia xu\225\187\145ng: ch\195\169m d\225\187\141c.\n\nLia c\195\160ng nhanh, ch\195\169m c\195\160ng nhanh.\n\n<b>{CalmDraw}</b>: r\195\186t ch\225\186\173m. Ki\225\186\191m t\225\187\171 t\225\187\171 tr\198\176\225\187\163t ra v\195\160o th\225\186\191 th\225\187\167, kh\195\180ng ch\195\169m.",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>{Equip}</b>: put the blade away. The next draw is ready about a second later."] = "\196\144\195\178n r\195\186t ki\225\186\191m \196\145\198\176\225\187\163c gi\225\187\175 r\225\186\165t ch\225\186\175c. L\198\176\225\187\161i ki\225\186\191m tr\195\186ng \196\145\195\178n r\195\186t ki\225\186\191m s\225\186\189 b\225\187\139 \196\145\195\161nh b\225\186\173t v\195\160 m\225\186\165t {block} \196\145\225\187\153 v\225\187\175ng. M\225\187\151i \196\145\195\178n r\195\186t ki\225\186\191m t\225\187\145n {draw} \196\145\225\187\153 v\225\187\175ng.\n\n<b>{Equip}</b>: tra ki\225\186\191m v\195\160o v\225\187\143. L\225\186\167n r\195\186t ti\225\186\191p theo s\225\186\181n s\195\160ng sau kho\225\186\163ng m\225\187\153t gi\195\162y.",
		["The sword starts sheathed, with a hand on the sheath, ready to draw. While locked on, a slow drag on the right side of the screen moves the hand on the sheath, and a quick <b>flick</b> draws. The flick\'s direction picks the cut.\n\n<b>LOCKED ON</b>: tap to switch target, hold to turn lock-on off. <b>LOCK ON</b>: tap to turn it back on.\n<b>UNEQUIP</b>: hold to unequip the sword. <b>EQUIP</b>: tap to equip it again."] = "Ki\225\186\191m b\225\186\175t \196\145\225\186\167u trong v\225\187\143, tay \196\145\225\186\183t tr\195\170n v\225\187\143, s\225\186\181n s\195\160ng r\195\186t. Khi \196\145ang kh\195\179a m\225\187\165c ti\195\170u, k\195\169o ch\225\186\173m \225\187\159 b\195\170n ph\225\186\163i m\195\160n h\195\172nh s\225\186\189 di chuy\225\187\131n tay tr\195\170n v\225\187\143 ki\225\186\191m, c\195\178n <b>vu\225\187\145t nhanh</b> s\225\186\189 r\195\186t ki\225\186\191m. H\198\176\225\187\155ng vu\225\187\145t ch\225\187\141n nh\195\161t ch\195\169m.\n\n<b>\196\144\195\131 KH\195\147A</b>: ch\225\186\161m \196\145\225\187\131 \196\145\225\187\149i m\225\187\165c ti\195\170u, gi\225\187\175 \196\145\225\187\131 t\225\186\175t kh\195\179a m\225\187\165c ti\195\170u. <b>KH\195\147A</b>: ch\225\186\161m \196\145\225\187\131 b\225\186\173t l\225\186\161i.\n<b>BU\195\148NG KI\225\186\190M</b>: gi\225\187\175 \196\145\225\187\131 bu\195\180ng ki\225\186\191m. <b>C\225\186\166M KI\225\186\190M</b>: ch\225\186\161m \196\145\225\187\131 c\225\186\167m l\225\186\161i ki\225\186\191m.",
		["<b>Flick right</b>: horizontal slice.\n<b>Flick down</b>: vertical slice.\n<b>Flick up-right</b>: low cut.\n\n<b>CALM DRAW</b>: the blade slides out slowly into a guard, with no cut."] = "<b>Vu\225\187\145t nhanh sang ph\225\186\163i</b>: ch\195\169m ngang.\n<b>Vu\225\187\145t nhanh xu\225\187\145ng</b>: ch\195\169m d\225\187\141c.\n<b>Vu\225\187\145t nhanh l\195\170n-ph\225\186\163i</b>: ch\195\169m th\225\186\165p.\n\n<b>R\195\154T CH\225\186\172M</b>: ki\225\186\191m t\225\187\171 t\225\187\171 tr\198\176\225\187\163t ra v\195\160o th\225\186\191 th\225\187\167, kh\195\180ng ch\195\169m.",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>SHEATHE</b>: put the blade away. The next draw is ready about a second later."] = "\196\144\195\178n r\195\186t ki\225\186\191m \196\145\198\176\225\187\163c gi\225\187\175 r\225\186\165t ch\225\186\175c. L\198\176\225\187\161i ki\225\186\191m tr\195\186ng \196\145\195\178n r\195\186t ki\225\186\191m s\225\186\189 b\225\187\139 \196\145\195\161nh b\225\186\173t v\195\160 m\225\186\165t {block} \196\145\225\187\153 v\225\187\175ng. M\225\187\151i \196\145\195\178n r\195\186t ki\225\186\191m t\225\187\145n {draw} \196\145\225\187\153 v\225\187\175ng.\n\n<b>TRA KI\225\186\190M</b>: c\225\186\165t ki\225\186\191m v\195\160o v\225\187\143. L\225\186\167n r\195\186t ti\225\186\191p theo s\225\186\181n s\195\160ng sau kho\225\186\163ng m\225\187\153t gi\195\162y.",
		["Clashes and parries"] = "Ch\225\186\161m ki\225\186\191m v\195\160 g\225\186\161t \196\145\195\178n",
		["Blades that meet push each other apart, and the firmer blade moves less. A hard swing knocks a still blade far aside, and that blade is slow to recover: an opening to attack.\n\nHit near the hands, a blade barely moves. Hit near the tip, it\'s knocked aside easily."] = "Hai l\198\176\225\187\161i ki\225\186\191m ch\225\186\161m nhau s\225\186\189 \196\145\225\186\169y nhau ra, v\195\160 l\198\176\225\187\161i ki\225\186\191m \196\145\198\176\225\187\163c gi\225\187\175 ch\225\186\175c h\198\161n x\195\170 d\225\187\139ch \195\173t h\198\161n. M\225\187\153t nh\195\161t vung m\225\186\161nh \196\145\195\161nh b\225\186\173t m\225\187\153t l\198\176\225\187\161i ki\225\186\191m \196\145\225\187\169ng y\195\170n ra xa, v\195\160 l\198\176\225\187\161i ki\225\186\191m \196\145\195\179 ch\225\186\173m h\225\187\147i l\225\186\161i: s\198\161 h\225\187\159 \196\145\225\187\131 t\225\186\165n c\195\180ng.\n\nB\225\187\139 ch\225\186\161m g\225\186\167n tay, l\198\176\225\187\161i ki\225\186\191m h\225\186\167u nh\198\176 kh\195\180ng x\195\170 d\225\187\139ch. B\225\187\139 ch\225\186\161m g\225\186\167n m\197\169i, ki\225\186\191m d\225\187\133 b\225\187\139 \196\145\195\161nh b\225\186\173t.",
		["<b>Draw-cuts</b> hit hardest. A blade held still that meets a draw-cut, or the drawer while the blade comes out, is knocked aside, and the cut goes through.\n\n<b>A still guard</b> (L2 on a gamepad) parries other swings: the swing bounces off and the attacker is staggered.\n\n<b>Two swings meeting</b> both give way, and neither can cut for a moment.\n\nThe whole sword can clash, handle included."] = "<b>\196\144\195\178n r\195\186t ki\225\186\191m</b> \196\145\195\161nh m\225\186\161nh nh\225\186\165t. M\225\187\153t l\198\176\225\187\161i ki\225\186\191m \196\145\225\187\169ng y\195\170n g\225\186\183p \196\145\195\178n r\195\186t ki\225\186\191m, ho\225\186\183c ch\225\186\161m v\195\160o ng\198\176\225\187\157i \196\145ang r\195\186t ki\225\186\191m khi l\198\176\225\187\161i ki\225\186\191m \196\145ang ra, s\225\186\189 b\225\187\139 g\225\186\161t sang b\195\170n, v\195\160 nh\195\161t ch\195\169m \196\145i xuy\195\170n qua.\n\n<b>Th\225\186\191 th\225\187\167 \196\145\225\187\169ng y\195\170n</b> (L2 tr\195\170n tay c\225\186\167m ch\198\161i game) g\225\186\161t \196\145\198\176\225\187\163c c\195\161c nh\195\161t vung kh\195\161c: nh\195\161t vung b\225\187\139 b\225\186\173t l\225\186\161i v\195\160 ng\198\176\225\187\157i t\225\186\165n c\195\180ng b\225\187\139 cho\195\161ng.\n\n<b>Hai nh\195\161t vung g\225\186\183p nhau</b> th\195\172 c\225\186\163 hai c\195\185ng b\225\186\173t ra, v\195\160 kh\195\180ng ai ch\195\169m \196\145\198\176\225\187\163c trong ch\225\187\145c l\195\161t.\n\nC\225\186\163 thanh ki\225\186\191m \196\145\225\187\129u c\195\179 th\225\187\131 va ch\225\186\161m, k\225\187\131 c\225\186\163 chu\195\180i.",
		["Cuts, wounds and bleeding"] = "Ch\195\169m, v\225\186\191t th\198\176\198\161ng v\195\160 ch\225\186\163y m\195\161u",
		["A cut needs speed and a leading edge. Speed comes from the swing and from movement, so dashing past counts. A sudden change of direction hits with the flat.\n\nOnly a blade moving into a target counts. A blade left resting in a body sticks."] = "M\225\187\153t nh\195\161t ch\195\169m c\225\186\167n t\225\187\145c \196\145\225\187\153 v\195\160 l\198\176\225\187\161i s\225\186\175c \196\145i tr\198\176\225\187\155c. T\225\187\145c \196\145\225\187\153 \196\145\225\186\191n t\225\187\171 nh\195\161t vung v\195\160 t\225\187\171 di chuy\225\187\131n, n\195\170n l\198\176\225\187\155t qua c\197\169ng t\195\173nh. \196\144\225\187\149i h\198\176\225\187\155ng \196\145\225\187\153t ng\225\187\153t s\225\186\189 \196\145\195\161nh tr\195\186ng b\225\186\177ng m\225\186\183t ki\225\186\191m.\n\nCh\225\187\137 l\198\176\225\187\161i ki\225\186\191m \196\145ang di chuy\225\187\131n v\195\160o m\225\187\165c ti\195\170u m\225\187\155i t\195\173nh. Ki\225\186\191m n\225\186\177m y\195\170n trong c\198\161 th\225\187\131 s\225\186\189 b\225\187\139 k\225\186\185t.",
		["A fast, edge-first cut all the way through a limb <b>severs</b> it. Through the head or torso: <b>a kill</b>.\n\nAnything less is a <b>wound</b>: it bleeds and slows the limb. Deeper wounds are worse.\n\n<b>Stabs</b> never kill outright. A stab to the head, or a fast one to the body (dash or lunge in), takes a lot of blood at once. Other stabs wound."] = "M\225\187\153t nh\195\161t ch\195\169m nhanh, l\198\176\225\187\161i s\225\186\175c \196\145i tr\198\176\225\187\155c, xuy\195\170n h\225\186\191t qua m\225\187\153t chi s\225\186\189 <b>ch\195\169m \196\145\225\187\169t</b> chi \196\145\195\179. Xuy\195\170n qua \196\145\225\186\167u ho\225\186\183c th\195\162n: <b>h\225\186\161 g\225\187\165c</b>.\n\n\195\141t h\198\161n th\225\186\191 l\195\160 m\225\187\153t <b>v\225\186\191t th\198\176\198\161ng</b>: n\195\179 ch\225\186\163y m\195\161u v\195\160 l\195\160m chi \196\145\195\179 ch\225\186\173m \196\145i. V\225\186\191t th\198\176\198\161ng c\195\160ng s\195\162u c\195\160ng n\225\186\183ng.\n\n<b>\196\144\195\162m</b> kh\195\180ng bao gi\225\187\157 h\225\186\161 g\225\187\165c ngay. \196\144\195\162m v\195\160o \196\145\225\186\167u, ho\225\186\183c \196\145\195\162m nhanh v\195\160o th\195\162n (l\198\176\225\187\155t ho\225\186\183c lao t\225\187\155i), l\195\160m m\225\186\165t nhi\225\187\129u m\195\161u ngay l\225\186\173p t\225\187\169c. C\195\161c nh\195\161t \196\145\195\162m kh\195\161c g\195\162y v\225\186\191t th\198\176\198\161ng.",
		["Every fighter has {squares} squares of blood. Wounds bleed for a few seconds, and so does a lost limb. With two limbs lost, the stumps bleed out. Losing both arms drops the katana.\n\nCombat is allowed in the arena and the forest, except in safe zones. Inside one, the screen shows <b>{safe}</b>."] = "M\225\187\151i \196\145\225\186\165u s\196\169 c\195\179 {squares} \195\180 m\195\161u. V\225\186\191t th\198\176\198\161ng ch\225\186\163y m\195\161u v\195\160i gi\195\162y, chi b\225\187\139 \196\145\225\187\169t c\197\169ng v\225\186\173y. Khi m\225\186\165t hai chi, c\195\161c m\225\187\143m c\225\187\165t ch\225\186\163y m\195\161u \196\145\225\186\191n ch\225\186\191t. M\225\186\165t c\225\186\163 hai tay s\225\186\189 l\195\160m r\198\161i katana.\n\n\196\144\198\176\225\187\163c ph\195\169p giao chi\225\186\191n \225\187\159 \196\145\225\186\165u tr\198\176\225\187\157ng v\195\160 khu r\225\187\171ng, tr\225\187\171 trong v\195\185ng an to\195\160n. Khi \225\187\159 trong v\195\185ng an to\195\160n, m\195\160n h\195\172nh hi\225\187\135n <b>{safe}</b>.",
		["The forge and levels"] = "L\195\178 r\195\168n v\195\160 c\225\186\165p \196\145\225\187\153",
		["XP rewards:\n\n<b>Wounding a player</b>: {wound}.\n<b>Severing a limb</b>: {sever}.\n<b>A kill</b>: {kill}.\n<b>Defeating a bot</b>: {botLeast} to {botMost}, more for rarer names.\n\nEach level needs a little more XP than the last. No level cap."] = "Ph\225\186\167n th\198\176\225\187\159ng XP:\n\n<b>L\195\160m b\225\187\139 th\198\176\198\161ng ng\198\176\225\187\157i ch\198\161i</b>: {wound}.\n<b>Ch\195\169m \196\145\225\187\169t m\225\187\153t chi</b>: {sever}.\n<b>H\225\186\161 g\225\187\165c</b>: {kill}.\n<b>\196\144\195\161nh b\225\186\161i bot</b>: {botLeast} \196\145\225\186\191n {botMost}, t\195\170n c\195\160ng hi\225\186\191m c\195\160ng nhi\225\187\129u.\n\nM\225\187\151i c\225\186\165p c\225\186\167n nhi\225\187\129u XP h\198\161n c\225\186\165p tr\198\176\225\187\155c m\225\187\153t ch\195\186t. Kh\195\180ng gi\225\187\155i h\225\186\161n c\225\186\165p.",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, press E at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "C\225\187\169 m\225\187\151i {levels} c\225\186\165p s\225\186\189 m\225\187\159 kh\195\179a m\225\187\153t <b>b\225\186\173c r\195\168n</b> m\225\187\155i. T\225\186\161i l\195\178 r\195\168n, ph\195\173a nam \196\145\225\186\165u tr\198\176\225\187\157ng, nh\225\186\165n E \225\187\159 \196\145e \196\145\225\187\131 nung, \196\145\225\186\173p b\195\186a v\195\160 t\195\180i l\198\176\225\187\161i ki\225\186\191m. M\225\187\151i b\225\186\173c cho ki\225\186\191m di\225\187\135n m\225\186\161o m\225\187\155i v\195\160 m\225\187\153t n\195\162ng c\225\186\165p m\225\187\155i.\n\nB\225\187\169c t\198\176\225\187\157ng ki\225\186\191m \225\187\159 \196\145\195\162y tr\198\176ng b\195\160y ki\225\186\191m c\225\187\167a m\225\187\141i b\225\186\173c r\195\168n.\n\n<b>R\195\168n l\225\186\161i</b> \196\145\225\187\131 quay v\225\187\129 b\225\186\165t k\225\187\179 b\225\186\173c n\195\160o \196\145\195\163 r\195\168n.",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, tap <b>Forge your blade</b> at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "C\225\187\169 m\225\187\151i {levels} c\225\186\165p s\225\186\189 m\225\187\159 kh\195\179a m\225\187\153t <b>b\225\186\173c r\195\168n</b> m\225\187\155i. T\225\186\161i l\195\178 r\195\168n, ph\195\173a nam \196\145\225\186\165u tr\198\176\225\187\157ng, ch\225\186\161m <b>R\195\168n ki\225\186\191m</b> \225\187\159 \196\145e \196\145\225\187\131 nung, \196\145\225\186\173p b\195\186a v\195\160 t\195\180i l\198\176\225\187\161i ki\225\186\191m. M\225\187\151i b\225\186\173c cho ki\225\186\191m di\225\187\135n m\225\186\161o m\225\187\155i v\195\160 m\225\187\153t n\195\162ng c\225\186\165p m\225\187\155i.\n\nB\225\187\169c t\198\176\225\187\157ng ki\225\186\191m \225\187\159 \196\145\195\162y tr\198\176ng b\195\160y ki\225\186\191m c\225\187\167a m\225\187\141i b\225\186\173c r\195\168n.\n\n<b>R\195\168n l\225\186\161i</b> \196\145\225\187\131 quay v\225\187\129 b\225\186\165t k\225\187\179 b\225\186\173c n\195\160o \196\145\195\163 r\195\168n.",
		["Kill streaks"] = "Chu\225\187\151i h\225\186\161 g\225\187\165c",
		["A <b>kill streak</b> counts kills in a row without dying, shown at the top right. Bleed-outs from a cut count, and so do bot kills. Dying ends the streak, but the best one is saved."] = "<b>Chu\225\187\151i h\225\186\161 g\225\187\165c</b> \196\145\225\186\191m s\225\187\145 l\225\186\167n h\225\186\161 g\225\187\165c li\195\170n ti\225\186\191p m\195\160 kh\195\180ng ch\225\186\191t, hi\225\187\131n th\225\187\139 \225\187\159 g\195\179c tr\195\170n b\195\170n ph\225\186\163i. Ch\225\186\191t v\195\172 m\225\186\165t m\195\161u do nh\195\161t ch\195\169m c\197\169ng \196\145\198\176\225\187\163c t\195\173nh, h\225\186\161 g\225\187\165c bot c\197\169ng v\225\186\173y. Ch\225\186\191t s\225\186\189 m\225\186\165t chu\225\187\151i, nh\198\176ng chu\225\187\151i t\225\187\145t nh\225\186\165t \196\145\198\176\225\187\163c l\198\176u l\225\186\161i.",
		["The streak catches fire as it grows, and every ten kills earns a title. Every {every} kills up to {most}: +{share} walk speed and poise recovery (Mythic names +{mythic}, Exotic names +{exotic}).\n\nNo prizes: it\'s for the glory.\n\nAfter dying, <b>SPECTATE</b> watches other fighters and <b>RESPAWN</b> returns to the fight."] = "Chu\225\187\151i b\225\187\145c l\225\187\173a khi d\195\160i ra, v\195\160 c\225\187\169 m\225\187\151i m\198\176\225\187\157i l\225\186\167n h\225\186\161 g\225\187\165c s\225\186\189 \196\145\198\176\225\187\163c m\225\187\153t danh hi\225\187\135u. C\225\187\169 m\225\187\151i {every} l\225\186\167n h\225\186\161 g\225\187\165c, cho \196\145\225\186\191n {most} l\225\186\167n: +{share} t\225\187\145c \196\145\225\187\153 \196\145i v\195\160 h\225\187\147i \196\145\225\187\153 v\225\187\175ng (h\225\187\141 Th\225\186\167n tho\225\186\161i +{mythic}, h\225\187\141 T\225\187\145i th\198\176\225\187\163ng +{exotic}).\n\nKh\195\180ng c\195\179 gi\225\186\163i th\198\176\225\187\159ng: ch\225\187\137 v\195\172 vinh quang.\n\nSau khi ch\225\186\191t, <b>THEO D\195\149I</b> \196\145\225\187\131 xem c\195\161c \196\145\225\186\165u s\196\169 kh\195\161c v\195\160 <b>H\225\187\146I SINH</b> \196\145\225\187\131 quay l\225\186\161i tr\225\186\173n \196\145\225\186\165u.",
		["TO WHOEVER FREED THIS TEMPLE"] = "G\225\187\172I NG\198\175\225\187\156I \196\144\195\131 GI\225\186\162I THO\195\129T NG\195\148I CH\195\153A N\195\128Y",
		["Her blade still rests within these walls. Search every corner."] = "Thanh ki\225\186\191m c\225\187\167a n\195\160ng v\225\186\171n n\225\186\177m trong nh\225\187\175ng b\225\187\169c t\198\176\225\187\157ng n\195\160y. H\195\163y l\225\187\165c so\195\161t m\225\187\141i ng\195\179c ng\195\161ch.",
		["YOU  {mine}  :  {theirs}  {name}"] = "B\225\186\160N  {mine}  :  {theirs}  {name}",
		["1V1 \194\183 ROUND {round} \194\183 FIRST TO {wins}"] = "1V1 \194\183 HI\225\187\134P {round} \194\183 \196\144\225\186\160T {wins} TR\198\175\225\187\154C",
		["1V1 \194\183 FIRST TO {wins} KILLS"] = "1V1 \194\183 \196\144\225\186\160T {wins} L\225\186\166N H\225\186\160 G\225\187\164C TR\198\175\225\187\154C",
		["Lock on to {name} to bow back."] = "Kh\195\179a m\225\187\165c ti\195\170u v\195\160o {name} \196\145\225\187\131 c\195\186i ch\195\160o l\225\186\161i.",
		["BOW BACK"] = "C\195\154I CH\195\128O L\225\186\160I",
		["ACCEPT"] = "CH\225\186\164P NH\225\186\172N",
		["{key}   BOW BACK"] = "{key}   C\195\154I CH\195\128O L\225\186\160I",
		["{key}   ACCEPT"] = "{key}   CH\225\186\164P NH\225\186\172N",
		["DECLINE"] = "T\225\187\170 CH\225\187\144I",
		["{key}   DECLINE"] = "{key}   T\225\187\170 CH\225\187\144I",
		["1V1 BOW"] = "C\195\154I CH\195\128O 1V1",
		["1V1 REMATCH"] = "T\195\129I \196\144\225\186\164U 1V1",
		["1V1 CHALLENGE"] = "TH\195\129CH \196\144\225\186\164U 1V1",
		["{name} bows to you"] = "{name} c\195\186i ch\195\160o b\225\186\161n",
		["{name} wants a rematch"] = "{name} mu\225\187\145n t\195\161i \196\145\225\186\165u",
		["{name} challenges you"] = "{name} th\195\161ch \196\145\225\186\165u b\225\186\161n",
		["{name} bowed back: the 1v1 begins."] = "{name} \196\145\195\163 c\195\186i ch\195\160o l\225\186\161i: tr\225\186\173n 1v1 b\225\186\175t \196\145\225\186\167u.",
		["They bowed back: the 1v1 begins."] = "\196\144\225\187\145i th\225\187\167 \196\145\195\163 c\195\186i ch\195\160o l\225\186\161i: tr\225\186\173n 1v1 b\225\186\175t \196\145\225\186\167u.",
		["FIGHT"] = "CHI\225\186\190N!",
		["DRAW"] = "H\195\146A",
		["No winner in {seconds} seconds: the round again."] = "Kh\195\180ng ai th\225\186\175ng sau {seconds} gi\195\162y: \196\145\225\186\165u l\225\186\161i hi\225\187\135p n\195\160y.",
		["They stayed out of the ring: a point to you."] = "\196\144\225\187\145i th\225\187\167 \225\187\159 ngo\195\160i v\195\181 \196\145\195\160i: b\225\186\161n \196\145\198\176\225\187\163c m\225\187\153t \196\145i\225\187\131m.",
		["You stayed out of the ring: a point to them."] = "B\225\186\161n \225\187\159 ngo\195\160i v\195\181 \196\145\195\160i: \196\145\225\187\145i th\225\187\167 \196\145\198\176\225\187\163c m\225\187\153t \196\145i\225\187\131m.",
		["They left the 1v1."] = "\196\144\225\187\145i th\225\187\167 \196\145\195\163 r\225\187\157i tr\225\186\173n 1v1.",
		["They forfeited."] = "\196\144\225\187\145i th\225\187\167 \196\145\195\163 \196\145\225\186\167u h\195\160ng.",
		["You forfeited."] = "B\225\186\161n \196\145\195\163 \196\145\225\186\167u h\195\160ng.",
		["+{xp} XP   {why}"] = "+{xp} XP   {why}",
		["NO RESULT"] = "KH\195\148NG C\195\147 K\225\186\190T QU\225\186\162",
		["The 1v1 couldn\'t go on."] = "Tr\225\186\173n 1v1 kh\195\180ng th\225\187\131 ti\225\186\191p t\225\187\165c.",
		["VICTORY"] = "CHI\225\186\190N TH\225\186\174NG",
