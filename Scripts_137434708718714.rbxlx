		["MERRY CHRISTMAS"] = "\208\161 \208\160\208\158\208\150\208\148\208\149\208\161\208\162\208\146\208\158\208\156",
		["A gift for playing on Christmas Day."] = "\208\159\208\190\208\180\208\176\209\128\208\190\208\186 \208\183\208\176 \208\184\208\179\209\128\209\131 \208\178 \208\180\208\181\208\189\209\140 \208\160\208\190\208\182\208\180\208\181\209\129\209\130\208\178\208\176.",
		["DAILY BONUS"] = "\208\149\208\150\208\149\208\148\208\157\208\149\208\146\208\157\208\171\208\153 \208\145\208\158\208\157\208\163\208\161",
