		["Not a dash attack. Hold **W + A** and press **{Dash}** while passing it."] = "\228\184\141\230\152\175\229\134\178\229\136\186\230\150\169\227\128\130\230\140\137\228\189\143**W + A**\239\188\140\231\187\143\232\191\135\232\165\191\231\147\156\230\151\182\230\140\137**{Dash}**\227\128\130",
		["Not a dash attack. Tap **DASH** while walking past it."] = "\228\184\141\230\152\175\229\134\178\229\136\186\230\150\169\227\128\130\232\181\176\232\191\135\232\165\191\231\147\156\230\151\182\231\130\185\229\135\187\226\128\156**\229\134\178\229\136\186**\226\128\157\227\128\130",
		["A new watermelon is on the stand."] = "\229\143\176\229\186\167\228\184\138\229\143\136\230\148\190\228\186\134\228\184\128\228\184\170\230\150\176\232\165\191\231\147\156\227\128\130",
