		["Back into the ring: {seconds} seconds out loses the round"] = "Reviens dans le ring\194\160: {seconds} secondes dehors et tu perds la manche",
		["Back into the ring: {seconds} seconds out gives them a point"] = "Reviens dans le ring\194\160: {seconds} secondes dehors et ton adversaire marque un point",
		["1v1 queue: waiting for an opponent ({key} to leave it)"] = "File 1v1\194\160: en attente d\'un adversaire ({key} pour quitter)",
		["MENU"] = "MENU",
		["First to {wins} kills."] = "Premier \195\160 {wins} \195\169liminations.",
		["HEAT"] = "CHAUFFE",
		["Grab the bellows handle with the mouse and drag it up and down"] = "Attrape la poign\195\169e du soufflet avec la souris et fais-la monter et descendre",
		["Drag your finger up and down anywhere to pump the bellows"] = "Fais glisser ton doigt de haut en bas n\'importe o\195\185 pour actionner le soufflet",
		["STRIKE"] = "FRAPPE",
		["Lift the hammer, then bring it down fast on the shining stars"] = "L\195\168ve le marteau, puis abats-le vite sur les \195\169toiles brillantes",
		["Swipe up to lift the hammer, then down fast onto the shining stars"] = "Balaie vers le haut pour lever le marteau, puis vite vers le bas sur les \195\169toiles brillantes",
		["QUENCH"] = "TREMPE",
		["Click to plunge the blade into the water"] = "Clique pour plonger la lame dans l\'eau",
		["Tap to plunge the blade into the water"] = "Touche l\'\195\169cran pour plonger la lame dans l\'eau",
		["QUENCHED"] = "TREMP\195\137E",
		["FITTING THE HILT"] = "MONTAGE DE LA MONTURE",
		["The guard, the handle, the wrap, then the pommel"] = "La garde, la poign\195\169e, le tressage, puis le pommeau",
		["TACHI STAGE {stage}"] = "\195\137TAPE DU TACHI {stage}",
		["THE STEEL DIDN\'T TAKE"] = "L\'ACIER N\'A PAS PRIS",
		["Something went wrong. Q to leave and try again."] = "Un probl\195\168me est survenu. Q pour quitter, puis r\195\169essaie.",
		["Something went wrong. Tap LEAVE and try again."] = "Un probl\195\168me est survenu. Touche QUITTER, puis r\195\169essaie.",
		["That upgrade unlocks at level {level} (you\'re level {yours})"] = "Cette am\195\169lioration se d\195\169bloque au niveau {level} (tu es niveau {yours})",
		["The forge couldn\'t do that just now"] = "La forge n\'a pas pu faire \195\167a pour le moment",
		["Q   leave        R   back to the fire"] = "Q   quitter        R   retour au feu",
		["TAKING OFF THE HILT"] = "D\195\137MONTAGE DE LA MONTURE",
		["STAGE {stage}   {name}"] = "\195\137TAPE {stage}   {name}",
		["the next rank"] = "le rang suivant",
		["Forging for rank {rank}: {name}.  The pommel, the wrap, the handle, then the guard"] = "Forge du rang {rank}\194\160: {name}.  Le pommeau, le tressage, la poign\195\169e, puis la garde",
		["Forging for rank {rank}: {name}.  Grab the bellows handle and drag it up and down"] = "Forge du rang {rank}\194\160: {name}.  Attrape la poign\195\169e du soufflet et fais-la monter et descendre",
		["FORGE RANK {rank}"] = "RANG DE FORGE {rank}",
		["BEGIN FORGING"] = "COMMENCER \195\128 FORGER",
		["IN USE"] = "UTILIS\195\137",
		["SWAP"] = "CHANGER",
		["RESTORE {price}"] = "RESTAURER {price}",
		["Unlocks at forge rank {rank} (highest forged: rank {forged})"] = "Se d\195\169bloque au rang de forge {rank} (plus haut forg\195\169 : rang {forged})",
		["Unlocks at level {level} (current: level {current})"] = "Se d\195\169bloque au niveau {level} (actuel : niveau {current})",
		["RANK {rank}"] = "RANG {rank}",
		["NEW"] = "NOUVEAU",
		["RANK {rank}   {name}"] = "RANG {rank}   {name}",
		["KATANA"] = "KATANA",
		["FORGE"] = "FORGE",
		["LEAVE"] = "QUITTER",
		["Fully restored"] = "Enti\195\168rement restaur\195\169",
		["Every rank is forged"] = "Tous les rangs sont forg\195\169s",
		["Q   leave"] = "Q   quitter",
		["Restore TACHI to stage {stage}?"] = "Restaurer le TACHI \195\160 l\'\195\169tape {stage} ?",
		["{name}. {line}. Price: {price}. Balance: {have}."] = "{name}. {line}. Prix : {price}. Solde : {have}.",
		["A great strike"] = "Une frappe magnifique",
		["A good strike"] = "Une bonne frappe",
		["Too cold to work. Press R to put it back in the fire"] = "Trop froide pour \195\170tre travaill\195\169e. Appuie sur R pour la remettre au feu",
		["Too cold to work. Tap BACK TO THE FIRE"] = "Trop froide pour \195\170tre travaill\195\169e. Touche RETOUR AU FEU",
		["Hit the shining stars"] = "Frappe les \195\169toiles brillantes",
		["Harder: bring it down faster"] = "Plus fort\194\160: abats-le plus vite",
		["Too hot! The steel was wasted back to orange. Ease off"] = "Trop chaud\194\160! L\'acier est g\195\162ch\195\169, retour \195\160 l\'orange. Doucement",
		["Hot enough. Click off the handle (or press Space) to take it to the anvil"] = "Assez chaud. L\195\162che la poign\195\169e (ou appuie sur Espace) pour l\'apporter \195\160 l\'enclume",
		["Hot enough. Tap DONE to take it to the anvil"] = "Assez chaud. Touche TERMIN\195\137 pour l\'apporter \195\160 l\'enclume",
		["BACK TO THE FIRE"] = "RETOUR AU FEU",
		["Drag to turn"] = "Fais glisser pour tourner",
		["Drag to turn      Scroll to zoom      Q   leave the forge"] = "Fais glisser pour tourner      Molette pour zoomer      Q   quitter la forge",
		["THE FORGE"] = "LA FORGE",
		["THE MAIN ARENA"] = "L\'AR\195\136NE PRINCIPALE",
		["PROMOTED"] = "PROMU",
		["Under level {level} only"] = "Seulement sous le niveau {level}",
		["You can\'t fight here now"] = "Tu ne peux plus combattre ici",
		["Forge, then fight"] = "Forge, puis combats",
		["Fight in the main arena"] = "Combats dans l\'ar\195\168ne principale",
		["Follow the red arrow"] = "Suis la fl\195\168che rouge",
		["{distance} m"] = "{distance} m",
		["UI hidden: turn it back on in SETTINGS."] = "Interface masqu\195\169e : r\195\169active-la dans R\195\137GLAGES.",
		["UI hidden: press {key} to show it."] = "Interface masqu\195\169e : appuie sur {key} pour l\'afficher.",
		["low cut"] = "coupe basse",
		["swipe up-right"] = "glisse en haut \195\160 droite",
		["cut across"] = "coupe horizontale",
		["swipe right"] = "glisse \195\160 droite",
		["diagonal cut"] = "coupe diagonale",
		["swipe down-right"] = "glisse en bas \195\160 droite",
		["downward cut"] = "coupe verticale",
		["swipe down"] = "glisse vers le bas",
		["calm draw"] = "d\195\169gainage calme",
		["swipe up-left"] = "glisse en haut \195\160 gauche",
		["swipe left"] = "glisse \195\160 gauche",
		["swipe down-left"] = "glisse en bas \195\160 gauche",
		["MAKIWARA"] = "MAKIWARA",
		["flick left or down to draw"] = "balaie \195\160 gauche ou vers le bas pour d\195\169gainer",
		["flick right or down to draw"] = "balaie \195\160 droite ou vers le bas pour d\195\169gainer",
		["{cut}  \194\183  hold {draw}, {swipe}"] = "{cut}  \194\183  maintiens {draw}, {swipe}",
		["{cut}  \194\183  hold {draw}, {swipe}  \194\183  {calm} calm draw"] = "{cut}  \194\183  maintiens {draw}, {swipe}  \194\183  {calm} d\195\169gainage calme",
		["{key}   front view"] = "{key}   vue de face",
		["{key}   menu"] = "{key}   menu",
		["UPGRADE READY  \194\183  GO TO THE FORGE"] = "AM\195\137LIORATION PR\195\138TE  \194\183  VA \195\128 LA FORGE",
		["{ping} ms"] = "{ping} ms",
		["Safe zone: streak lost in {seconds}s"] = "Zone s\195\187re : s\195\169rie perdue dans {seconds}s",
		["{scale}x XP  {time}"] = "{scale}x XP  {time}",
		["Peaceful: lock-on back in {seconds}s"] = "Pacifique : ciblage de retour dans {seconds}s",
		["Lock-on: looking for an opponent"] = "Ciblage\194\160: recherche d\'un adversaire",
