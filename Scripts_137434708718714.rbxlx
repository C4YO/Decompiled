		["White metal fittings."] = "\231\153\189\233\138\128\229\136\128\232\163\157\227\128\130",
		["+2.5% walk speed, 25% faster poise recovery"] = "\231\167\187\229\139\149\233\128\159\229\186\166+2.5%\239\188\140\232\187\128\229\185\185\230\129\162\229\190\169\233\128\159\229\186\166+25%",
		["Red cord, cherry-blossom ornaments, black tassel, red sheath with metal bands."] = "\231\180\133\232\137\178\230\159\132\231\185\169\227\128\129\230\171\187\232\138\177\233\163\190\228\187\182\227\128\129\233\187\145\232\137\178\230\181\129\232\152\135\227\128\129\229\184\182\233\135\145\229\177\172\231\174\141\231\154\132\231\180\133\232\137\178\229\136\128\233\158\152\227\128\130",
