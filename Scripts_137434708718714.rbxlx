		["{upgrade}.  {look}"] = "{upgrade}\227\128\130  {look}",
		["REFORGE"] = "\233\135\141\233\145\132",
		["Forge your next upgrade, or reforge your blade to a rank you\'ve already forged."] = "\233\141\155\233\128\160\228\184\139\228\184\128\231\180\154\229\188\183\229\140\150\239\188\140\230\136\150\229\176\135\229\136\128\233\135\141\233\145\132\231\130\186\229\183\178\233\141\155\233\128\160\233\129\142\231\154\132\231\173\137\231\180\154\227\128\130",
