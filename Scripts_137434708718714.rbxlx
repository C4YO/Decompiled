		["Kicked, not sliced: it\'s back on its stand."] = "\229\143\170\230\152\175\232\184\162\228\184\173\239\188\140\230\178\161\230\156\137\230\150\169\229\188\128\227\128\130\232\165\191\231\147\156\229\143\136\229\155\158\229\136\176\229\143\176\229\186\167\228\184\138\228\186\134\227\128\130",
		["A stab only marks it. **Swing** through it to slice it."] = "\231\170\129\229\136\186\229\143\170\228\188\154\231\149\153\228\184\139\229\136\128\231\151\149\227\128\130**\230\140\165\229\136\128**\230\150\169\232\191\135\229\142\187\230\137\141\232\131\189\229\136\135\229\188\128\227\128\130",
		["Too slow, or hit with the flat. Swing faster, edge first."] = "\229\164\170\230\133\162\239\188\140\230\136\150\230\152\175\231\148\168\229\136\128\233\157\162\230\139\141\229\136\176\228\186\134\227\128\130\230\140\165\229\190\151\229\134\141\229\191\171\228\186\155\239\188\140\229\136\128\229\136\131\230\156\157\229\137\141\227\128\130",
