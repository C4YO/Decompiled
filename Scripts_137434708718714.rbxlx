		["{names} will be gone for good."] = "{names}\229\176\135\230\176\184\233\129\160\229\164\177\229\142\187\227\128\130",
		["Peaceful: out in the forest nobody can hurt you, and you can\'t hurt anyone. In the rings you fight as usual."] = "\229\146\140\229\185\179\230\168\161\229\188\143\239\188\154\229\156\168\230\163\174\230\158\151\232\163\161\230\178\146\228\186\186\232\131\189\229\130\183\229\174\179\228\189\160\239\188\140\228\189\160\228\185\159\228\184\141\232\131\189\229\130\183\229\174\179\228\187\187\228\189\149\228\186\186\227\128\130\229\156\168\230\147\130\229\143\176\232\163\161\231\133\167\229\184\184\230\136\176\233\172\165\227\128\130",
		["Peaceful: nobody can hurt you, and you can\'t hurt anyone. In the beginners\' ring and the boss arena you fight as usual."] = "\229\146\140\229\185\179\230\168\161\229\188\143\239\188\154\230\178\146\228\186\186\232\131\189\229\130\183\229\174\179\228\189\160\239\188\140\228\189\160\228\185\159\228\184\141\232\131\189\229\130\183\229\174\179\228\187\187\228\189\149\228\186\186\227\128\130\229\156\168\230\150\176\230\137\139\230\147\130\229\143\176\229\146\140\233\166\150\233\160\152\231\171\182\230\138\128\229\160\180\232\163\161\231\133\167\229\184\184\230\136\176\233\172\165\227\128\130",
		["BONFIRE"] = "\231\175\157\231\129\171",
		["LAST LOCATION"] = "\228\184\138\230\172\161\228\189\141\231\189\174",
		["Outside the ring: sword lowered"] = "\230\147\130\229\143\176\229\164\150\239\188\154\229\136\128\229\183\178\229\158\130\228\184\139",
		["Outside the ring: sword sheathed"] = "\230\147\130\229\143\176\229\164\150\239\188\154\229\183\178\230\148\182\229\136\128",
		["Find bonfires out in the world to travel between them."] = "\229\156\168\228\184\150\231\149\140\229\144\132\229\156\176\230\137\190\229\136\176\231\175\157\231\129\171\239\188\140\229\176\177\232\131\189\229\156\168\229\174\131\229\128\145\228\185\139\233\150\147\229\130\179\233\128\129\227\128\130",
		["Tap a bonfire you\'ve found to travel there."] = "\232\188\149\232\167\184\228\189\160\230\137\190\229\136\176\231\154\132\231\175\157\231\129\171\229\141\179\229\143\175\229\130\179\233\128\129\229\136\176\233\130\163\232\163\161\227\128\130",
		["Click a bonfire you\'ve found to travel there."] = "\233\187\158\230\147\138\228\189\160\230\137\190\229\136\176\231\154\132\231\175\157\231\129\171\229\141\179\229\143\175\229\130\179\233\128\129\229\136\176\233\130\163\232\163\161\227\128\130",
		["Bonfire found: {name}"] = "\231\153\188\231\143\190\231\175\157\231\129\171\239\188\154{name}",
		["Rested at {name}. You\'ll start here when you next play."] = "\229\183\178\229\156\168{name}\228\188\145\230\129\175\227\128\130\228\184\139\230\172\161\233\128\178\229\133\165\233\129\138\230\136\178\230\156\131\229\190\158\233\128\153\232\163\161\233\150\139\229\167\139\227\128\130",
