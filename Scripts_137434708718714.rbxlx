		["VICTORY"] = "\236\138\185\235\166\172",
		["DEFEAT"] = "\237\140\168\235\176\176",
		["Back into the ring: {seconds} seconds out loses the round"] = "\235\167\129 \236\149\136\236\156\188\235\161\156 \235\143\140\236\149\132\234\176\128\236\132\184\236\154\148: \235\176\150\236\151\144\236\132\156 {seconds}\236\180\136\234\176\128 \236\167\128\235\130\152\235\169\180 \235\157\188\236\154\180\235\147\156 \237\140\168\235\176\176",
		["Back into the ring: {seconds} seconds out gives them a point"] = "\235\167\129 \236\149\136\236\156\188\235\161\156 \235\143\140\236\149\132\234\176\128\236\132\184\236\154\148: \235\176\150\236\151\144\236\132\156 {seconds}\236\180\136\234\176\128 \236\167\128\235\130\152\235\169\180 \236\131\129\235\140\128 \236\160\144\236\136\152 +1",
		["1v1 queue: waiting for an opponent ({key} to leave it)"] = "1v1 \235\140\128\234\184\176\236\151\180: \236\131\129\235\140\128\235\165\188 \234\184\176\235\139\164\235\166\172\235\138\148 \236\164\145 ({key}: \235\130\152\234\176\128\234\184\176)",
		["MENU"] = "\235\169\148\235\137\180",
		["First to {wins} kills."] = "\235\168\188\236\160\128 {wins}\236\178\152\236\185\152 \236\139\156 \236\138\185\235\166\172.",
		["HEAT"] = "\234\176\128\236\151\180",
		["Grab the bellows handle with the mouse and drag it up and down"] = "\235\167\136\236\154\176\236\138\164\235\161\156 \237\146\128\235\172\180 \236\134\144\236\158\161\236\157\180\235\165\188 \236\158\161\234\179\160 \236\156\132\236\149\132\235\158\152\235\161\156 \235\129\140\236\150\180\235\139\185\234\184\176\236\132\184\236\154\148",
		["Drag your finger up and down anywhere to pump the bellows"] = "\236\149\132\235\172\180 \234\179\179\236\151\144\236\132\156\235\130\152 \236\134\144\234\176\128\235\157\189\236\157\132 \236\156\132\236\149\132\235\158\152\235\161\156 \235\147\156\235\158\152\234\183\184\237\149\180 \237\146\128\235\172\180\236\167\136\237\149\152\236\132\184\236\154\148",
		["STRIKE"] = "\237\131\128\234\178\169",
		["Lift the hammer, then bring it down fast on the shining stars"] = "\235\167\157\236\185\152\235\165\188 \235\147\164\236\150\180 \236\152\172\235\166\176 \235\146\164 \235\185\155\235\130\152\235\138\148 \235\179\132 \236\156\132\235\161\156 \235\185\160\235\165\180\234\178\140 \235\130\180\235\166\172\236\185\152\236\132\184\236\154\148",
		["Swipe up to lift the hammer, then down fast onto the shining stars"] = "\236\156\132\235\161\156 \236\138\164\236\153\128\236\157\180\237\148\132\237\149\180 \235\167\157\236\185\152\235\165\188 \235\147\164\234\179\160, \235\185\155\235\130\152\235\138\148 \235\179\132 \236\156\132\235\161\156 \235\185\160\235\165\180\234\178\140 \236\149\132\235\158\152\235\161\156 \236\138\164\236\153\128\236\157\180\237\148\132\237\149\152\236\132\184\236\154\148",
		["QUENCH"] = "\235\139\180\234\184\136\236\167\136",
		["Click to plunge the blade into the water"] = "\237\129\180\235\166\173\237\149\180\236\132\156 \236\185\188\235\130\160\236\157\132 \235\172\188\236\151\144 \235\139\180\234\183\184\236\132\184\236\154\148",
		["Tap to plunge the blade into the water"] = "\237\131\173\237\149\180\236\132\156 \236\185\188\235\130\160\236\157\132 \235\172\188\236\151\144 \235\139\180\234\183\184\236\132\184\236\154\148",
		["QUENCHED"] = "\235\139\180\234\184\136\236\167\136 \236\153\132\235\163\140",
		["FITTING THE HILT"] = "\236\134\144\236\158\161\236\157\180 \235\167\158\236\182\148\235\138\148 \236\164\145",
		["The guard, the handle, the wrap, then the pommel"] = "\236\189\148\235\147\177\236\157\180, \236\134\144\236\158\161\236\157\180, \236\134\144\236\158\161\236\157\180 \235\129\136, \235\167\136\236\167\128\235\167\137\236\156\188\235\161\156 \236\158\144\235\163\168 \235\168\184\235\166\172",
		["TACHI STAGE {stage}"] = "\237\131\128\236\185\152 \235\139\168\234\179\132 {stage}",
		["THE STEEL DIDN\'T TAKE"] = "\234\176\149\236\178\160\236\157\180 \235\178\132\237\139\176\236\167\128 \235\170\187\237\150\136\236\150\180\236\154\148",
		["Something went wrong. Q to leave and try again."] = "\235\172\184\236\160\156\234\176\128 \236\131\157\234\178\188\236\150\180\236\154\148. Q \237\130\164\235\161\156 \235\130\152\234\176\132 \235\146\164 \235\139\164\236\139\156 \236\139\156\235\143\132\237\149\152\236\132\184\236\154\148.",
		["Something went wrong. Tap LEAVE and try again."] = "\235\172\184\236\160\156\234\176\128 \236\131\157\234\178\188\236\150\180\236\154\148. [\235\130\152\234\176\128\234\184\176]\235\165\188 \237\131\173\237\149\152\234\179\160 \235\139\164\236\139\156 \236\139\156\235\143\132\237\149\152\236\132\184\236\154\148.",
		["That upgrade unlocks at level {level} (you\'re level {yours})"] = "\234\183\184 \234\176\149\237\153\148\235\138\148 \235\160\136\235\178\168 {level}\236\151\144 \237\149\180\234\184\136\235\143\188\236\154\148 (\237\152\132\236\158\172 \235\160\136\235\178\168 {yours})",
		["The forge couldn\'t do that just now"] = "\236\167\128\234\184\136\236\157\128 \235\140\128\236\158\165\234\176\132\236\151\144\236\132\156 \234\183\184 \236\158\145\236\151\133\236\157\132 \237\149\160 \236\136\152 \236\151\134\236\150\180\236\154\148",
