		["+{xp} XP"] = "+{xp} XP",
		["All daily quests done"] = "\230\175\143\230\151\165\228\187\187\229\139\153\229\133\168\233\131\168\229\174\140\230\136\144",
		["ADVENT CALENDAR"] = "\233\153\141\232\135\168\231\175\128\230\151\165\230\155\134",
		["Day {day} of 25"] = "\231\172\172{day}\229\164\169\239\188\140\229\133\17725\229\164\169",
		["no boost"] = "\231\132\161\229\138\160\230\136\144",
		["{count} boost: +{walk} walk speed or +{other} to another stat"] = "{count}\233\160\133\229\138\160\230\136\144\239\188\154\231\167\187\229\139\149\233\128\159\229\186\166+{walk}\239\188\140\230\136\150\229\133\182\228\187\150\229\177\172\230\128\167+{other}",
		["{count} boosts, each +{walk} walk speed or +{other} to another stat"] = "{count}\233\160\133\229\138\160\230\136\144\239\188\140\230\175\143\233\160\133\231\130\186\231\167\187\229\139\149\233\128\159\229\186\166+{walk}\239\188\140\230\136\150\229\133\182\228\187\150\229\177\172\230\128\167+{other}",
		["Safe zone: combat forbidden"] = "\229\174\137\229\133\168\229\141\128\239\188\154\231\166\129\230\173\162\230\136\176\233\172\165",
		["Names and boosts"] = "\229\167\147\230\176\143\232\136\135\229\138\160\230\136\144",
		["<b>Family name</b>: rolled once, at the forge.\n<b>First name</b>: reroll any time on the character screen (CHARACTER, on the title screen).\n\nRarer family names give stat boosts. Boosts are kept small, so fights are still won with the blade."] = "<b>\229\167\147\230\176\143</b>\239\188\154\229\143\170\229\156\168\233\141\155\229\136\128\229\157\138\230\138\189\229\174\154\228\184\128\230\172\161\227\128\130\n<b>\229\144\141\229\173\151</b>\239\188\154\233\154\168\230\153\130\229\143\175\228\187\165\229\156\168\232\167\146\232\137\178\231\149\171\233\157\162\239\188\136\230\168\153\233\161\140\231\149\171\233\157\162\228\184\173\231\154\132\227\128\140\232\167\146\232\137\178\227\128\141\239\188\137\233\135\141\230\138\189\227\128\130\n\n\232\188\131\231\168\128\230\156\137\231\154\132\229\167\147\230\176\143\230\156\131\229\184\182\228\190\134\229\177\172\230\128\167\229\138\160\230\136\144\227\128\130\229\138\160\230\136\144\229\136\187\230\132\143\229\129\154\229\190\151\229\190\136\229\176\143\239\188\140\229\165\189\232\174\147\229\139\157\232\178\160\228\187\141\229\143\150\230\177\186\230\150\188\229\136\128\230\179\149\227\128\130",
		["Rarity, odds and boosts:\n\n{rarities}\n\nThe rarest names belong to famous swordsmen and warlords. A Mythic name is a legend\'s own name, used in place of a family name. An Exotic name is a god\'s. Every spin is pure chance at these odds."] = "\231\168\128\230\156\137\229\186\166\227\128\129\230\169\159\231\142\135\232\136\135\229\138\160\230\136\144\239\188\154\n\n{rarities}\n\n\230\156\128\231\168\128\230\156\137\231\154\132\229\167\147\230\176\143\229\177\172\230\150\188\232\145\151\229\144\141\229\138\141\232\177\170\232\136\135\230\173\166\229\176\135\227\128\130\231\165\158\232\169\177\231\180\154\230\152\175\229\130\179\229\165\135\228\186\186\231\137\169\230\156\172\228\186\186\231\154\132\229\144\141\229\173\151\239\188\140\231\148\168\228\190\134\229\143\150\228\187\163\229\167\147\230\176\143\227\128\130\232\182\133\229\135\161\231\180\154\229\137\135\230\152\175\231\165\158\230\152\142\228\185\139\229\144\141\227\128\130\230\175\143\230\172\161\230\138\189\231\177\164\233\131\189\229\174\140\229\133\168\228\190\157\231\133\167\228\187\165\228\184\138\230\169\159\231\142\135\233\154\168\230\169\159\227\128\130",
		["Boosts:\n\n<b>Walk speed</b>: faster movement.\n<b>Poise recovery</b>: poise refills faster.\n<b>Poise toughness</b>: all poise costs are lower.\n<b>Slower bleeding</b>: wounds and stumps bleed slower.\n<b>Faster dash recharge</b>: dash charges refill sooner.\n\nBoosts stack with forge upgrades."] = "\229\138\160\230\136\144\231\168\174\233\161\158\239\188\154\n\n<b>\231\167\187\229\139\149\233\128\159\229\186\166</b>\239\188\154\231\167\187\229\139\149\230\155\180\229\191\171\227\128\130\n<b>\232\187\128\229\185\185\230\129\162\229\190\169</b>\239\188\154\232\187\128\229\185\185\230\129\162\229\190\169\229\190\151\230\155\180\229\191\171\227\128\130\n<b>\232\187\128\229\185\185\233\159\140\230\128\167</b>\239\188\154\230\137\128\230\156\137\232\187\128\229\185\185\230\182\136\232\128\151\233\131\189\233\153\141\228\189\142\227\128\130\n<b>\229\135\186\232\161\128\230\184\155\231\183\169</b>\239\188\154\229\130\183\229\143\163\229\146\140\230\150\183\232\130\162\230\181\129\232\161\128\230\155\180\230\133\162\227\128\130\n<b>\232\161\157\229\136\186\229\133\133\232\131\189\233\128\159\229\186\166</b>\239\188\154\232\161\157\229\136\186\229\133\133\232\131\189\230\129\162\229\190\169\229\190\151\230\155\180\229\191\171\227\128\130\n\n\229\138\160\230\136\144\230\156\131\232\136\135\233\141\155\229\136\128\229\157\138\231\154\132\229\188\183\229\140\150\231\150\138\229\138\160\227\128\130",
		["<b>Rename spins</b> reroll the family name. Get {spins} free spins every level, or buy more in the SHOP. Use them on the character screen. The old name can always be kept.\n\nBots have names too. The rarer a bot\'s name, the better it fights."] = "<b>\230\148\185\229\144\141\230\138\189\231\177\164</b>\229\143\175\228\187\165\233\135\141\230\138\189\229\167\147\230\176\143\227\128\130\230\175\143\229\141\135\228\184\128\231\180\154\229\133\141\232\178\187\231\141\178\229\190\151{spins}\230\172\161\230\138\189\231\177\164\239\188\140\228\185\159\229\143\175\228\187\165\229\156\168\227\128\140\229\149\134\229\186\151\227\128\141\232\179\188\232\178\183\230\155\180\229\164\154\227\128\130\229\156\168\232\167\146\232\137\178\231\149\171\233\157\162\228\189\191\231\148\168\227\128\130\229\142\159\230\156\172\231\154\132\229\167\147\230\176\143\229\167\139\231\181\130\229\143\175\228\187\165\228\191\157\231\149\153\227\128\130\n\n\228\186\186\230\169\159\228\185\159\230\156\137\229\167\147\230\176\143\227\128\130\228\186\186\230\169\159\231\154\132\229\167\147\230\176\143\232\182\138\231\168\128\230\156\137\239\188\140\229\175\166\229\138\155\232\182\138\229\188\183\227\128\130",
		["Poise"] = "\232\187\128\229\185\185",
		["<b>Poise</b> is a fighter\'s steadiness. The poise bar is the thin bar above the blood squares; an opponent\'s is under their name. It grows from the middle as poise is lost, turning from gold to red, and hides at full poise."] = "<b>\232\187\128\229\185\185</b>\228\187\163\232\161\168\230\173\166\232\128\133\230\158\182\229\139\162\231\154\132\231\169\169\229\174\154\231\168\139\229\186\166\227\128\130\232\187\128\229\185\185\230\162\157\230\152\175\232\161\128\230\160\188\228\184\138\230\150\185\231\154\132\231\180\176\230\162\157\239\188\155\229\176\141\230\137\139\231\154\132\232\187\128\229\185\185\230\162\157\229\156\168\229\144\141\229\173\151\228\184\139\230\150\185\227\128\130\230\144\141\229\164\177\232\187\128\229\185\185\230\153\130\239\188\140\232\187\128\229\185\185\230\162\157\230\156\131\229\190\158\228\184\173\233\150\147\229\144\145\229\133\169\229\129\180\229\187\182\228\188\184\239\188\140\231\148\177\233\135\145\232\189\137\231\180\133\239\188\155\232\187\128\229\185\185\229\133\168\230\187\191\230\153\130\229\137\135\230\156\131\233\154\177\232\151\143\227\128\130",
		["Poise costs:\n\n<b>Draw-cut</b>: {draw}.  <b>Blade hit by a draw-cut</b>: {block}.\n<b>Hard swing</b>: {swing}.  <b>Dash</b>: {dash}.  <b>Kick</b>: {kick}.\n<b>Taking a cut</b>: {wound} (double from a draw-cut), plus blood loss.\n<b>Clashes</b>: more the harder the blade is knocked."] = "\232\187\128\229\185\185\230\182\136\232\128\151\239\188\154\n\n<b>\230\139\148\229\136\128\230\150\172</b>\239\188\154{draw}\227\128\130  <b>\232\162\171\230\139\148\229\136\128\230\150\172\230\147\138\228\184\173\231\154\132\229\136\128</b>\239\188\154{block}\227\128\130\n<b>\231\140\155\229\138\155\230\143\174\231\160\141</b>\239\188\154{swing}\227\128\130  <b>\232\161\157\229\136\186</b>\239\188\154{dash}\227\128\130  <b>\232\184\162\230\147\138</b>\239\188\154{kick}\227\128\130\n<b>\232\162\171\230\150\172\228\184\173</b>\239\188\154{wound}\239\188\136\232\162\171\230\139\148\229\136\128\230\150\172\229\137\135\229\138\160\229\128\141\239\188\137\239\188\140\229\143\166\229\138\160\229\164\177\232\161\128\233\128\160\230\136\144\231\154\132\230\182\136\232\128\151\227\128\130\n<b>\230\139\188\229\136\128</b>\239\188\154\229\136\128\232\162\171\230\147\138\233\150\139\229\190\151\232\182\138\231\140\155\239\188\140\230\182\136\232\128\151\232\182\138\229\164\154\227\128\130",
		["Poise refills after {delay} seconds with no poise lost, at {regen} per second. A still guard (L2 on a gamepad) refills it faster; low blood refills it slower.\n\nBelow half poise, blade and movement speed drop, and the blade is knocked aside more easily."] = "\233\128\163\231\186\140{delay}\231\167\146\230\156\170\230\144\141\229\164\177\232\187\128\229\185\185\229\190\140\239\188\140\232\187\128\229\185\185\233\150\139\229\167\139\228\187\165\230\175\143\231\167\146{regen}\231\154\132\233\128\159\229\186\166\230\129\162\229\190\169\227\128\130\233\157\156\230\173\162\230\160\188\230\147\139\239\188\136\230\137\139\230\138\138\231\130\186L2\239\188\137\230\153\130\230\129\162\229\190\169\230\155\180\229\191\171\239\188\155\232\161\128\233\135\143\228\189\142\230\153\130\230\129\162\229\190\169\230\155\180\230\133\162\227\128\130\n\n\232\187\128\229\185\185\228\189\142\230\150\188\228\184\128\229\141\138\230\153\130\239\188\140\229\136\128\233\128\159\232\136\135\231\167\187\229\139\149\233\128\159\229\186\166\228\184\139\233\153\141\239\188\140\229\136\128\228\185\159\230\155\180\229\174\185\230\152\147\232\162\171\230\147\138\233\150\139\227\128\130",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> ({Wipe}). See the next scroll."] = "\232\187\128\229\185\185\230\173\184\233\155\182\230\153\130\230\156\131<b>\229\180\169\230\189\176</b>\239\188\154\232\184\137\232\185\140{stagger}\231\167\146\239\188\140\230\142\165\232\145\151\229\138\155\231\171\173{weakened}\231\167\146\239\188\136\230\184\155\233\128\159{slower}\227\128\129\229\150\152\230\176\163\227\128\129\232\158\162\229\185\149\233\130\138\231\183\163\232\174\138\230\154\151\239\188\137\227\128\130\228\185\139\229\190\140\232\187\128\229\185\185\230\129\162\229\190\169\229\136\176\228\184\128\229\141\138\227\128\130\n\n\232\187\128\229\185\185\229\155\158\230\187\191\230\156\128\229\191\171\231\154\132\230\150\185\230\179\149\230\152\175<b>\230\140\175\232\161\128</b>\239\188\136{Wipe}\239\188\137\227\128\130\232\171\139\231\156\139\228\184\139\228\184\128\229\141\183\232\187\184\227\128\130",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> (WIPE). See the next scroll."] = "\232\187\128\229\185\185\230\173\184\233\155\182\230\153\130\230\156\131<b>\229\180\169\230\189\176</b>\239\188\154\232\184\137\232\185\140{stagger}\231\167\146\239\188\140\230\142\165\232\145\151\229\138\155\231\171\173{weakened}\231\167\146\239\188\136\230\184\155\233\128\159{slower}\227\128\129\229\150\152\230\176\163\227\128\129\232\158\162\229\185\149\233\130\138\231\183\163\232\174\138\230\154\151\239\188\137\227\128\130\228\185\139\229\190\140\232\187\128\229\185\185\230\129\162\229\190\169\229\136\176\228\184\128\229\141\138\227\128\130\n\n\232\187\128\229\185\185\229\155\158\230\187\191\230\156\128\229\191\171\231\154\132\230\150\185\230\179\149\230\152\175<b>\230\140\175\232\161\128</b>\239\188\136\233\187\158\230\147\138\227\128\140\230\140\175\232\161\128\227\128\141\239\188\137\227\128\130\232\171\139\231\156\139\228\184\139\228\184\128\229\141\183\232\187\184\227\128\130",
		["Wiping the blade"] = "\230\140\175\232\161\128",
		["Cuts leave blood on the blade. With the blade drawn, press <b>{Wipe}</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "\230\150\172\230\147\138\230\156\131\229\156\168\229\136\128\228\184\138\231\149\153\228\184\139\232\161\128\232\183\161\227\128\130\230\139\148\229\136\128\231\139\128\230\133\139\228\184\139\230\140\137<b>{Wipe}</b>\239\188\140\231\148\168\229\184\131\230\147\166\230\139\173\229\136\128\232\186\171\239\188\140\228\184\128\233\157\162\230\147\166\229\174\140\229\134\141\230\147\166\229\143\166\228\184\128\233\157\162\227\128\130\230\175\143\230\172\161\230\140\175\232\161\128\231\180\132\233\156\128{time}\231\167\146\227\128\130",
		["<b>Wiping restores poise.</b> During a wipe, poise refills at {times}x speed, and a finished wipe fills it to full.\n\nAfter a poise break, a finished wipe also ends the weakened state."] = "<b>\230\140\175\232\161\128\229\143\175\228\187\165\230\129\162\229\190\169\232\187\128\229\185\185\227\128\130</b>\230\140\175\232\161\128\230\156\159\233\150\147\239\188\140\232\187\128\229\185\185\228\187\165{times}\229\128\141\233\128\159\229\186\166\230\129\162\229\190\169\239\188\155\229\174\140\230\136\144\230\140\175\232\161\128\229\137\135\231\155\180\230\142\165\229\155\158\230\187\191\227\128\130\n\n\232\187\128\229\185\185\229\180\169\230\189\176\229\190\140\239\188\140\229\174\140\230\136\144\230\140\175\232\161\128\233\130\132\232\131\189\232\167\163\233\153\164\229\138\155\231\171\173\231\139\128\230\133\139\227\128\130",
		["<b>Wiping leaves an opening.</b> Once a wipe starts, steering, guarding and cutting are locked until it ends, and a swing into the loose blade knocks it far aside. Losing poise mid-wipe cancels the full refill.\n\nBots punish wipes. Make some distance first.\n\nA later forge rank unlocks a quicker wipe."] = "<b>\230\140\175\232\161\128\230\156\131\233\156\178\229\135\186\231\160\180\231\182\187\227\128\130</b>\230\140\175\232\161\128\228\184\128\230\151\166\233\150\139\229\167\139\239\188\140\231\181\144\230\157\159\229\137\141\233\131\189\231\132\161\230\179\149\230\147\141\230\142\167\229\136\128\227\128\129\230\160\188\230\147\139\230\136\150\230\150\172\230\147\138\239\188\155\233\172\134\230\143\161\231\154\132\229\136\128\232\139\165\232\162\171\231\160\141\228\184\173\239\188\140\230\156\131\232\162\171\233\129\160\233\129\160\230\147\138\233\150\139\227\128\130\230\140\175\232\161\128\233\128\148\228\184\173\232\139\165\230\144\141\229\164\177\232\187\128\229\185\185\239\188\140\229\174\140\230\136\144\229\190\140\229\176\177\228\184\141\230\156\131\229\155\158\230\187\191\227\128\130\n\n\228\186\186\230\169\159\229\176\136\230\140\145\230\140\175\232\161\128\230\153\130\233\128\178\230\148\187\227\128\130\229\133\136\230\139\137\233\150\139\232\183\157\233\155\162\227\128\130\n\n\229\190\140\231\186\140\231\154\132\233\141\155\229\136\128\231\173\137\231\180\154\230\156\131\232\167\163\233\142\150\230\155\180\229\191\171\231\154\132\230\140\175\232\161\128\230\150\185\229\188\143\227\128\130",
		["Cuts leave blood on the blade. With the blade drawn, tap <b>WIPE</b> to wipe it with a cloth, one side then the other. A wipe takes about {time} seconds."] = "\230\150\172\230\147\138\230\156\131\229\156\168\229\136\128\228\184\138\231\149\153\228\184\139\232\161\128\232\183\161\227\128\130\230\139\148\229\136\128\231\139\128\230\133\139\228\184\139\233\187\158\230\147\138\227\128\140<b>\230\140\175\232\161\128</b>\227\128\141\239\188\140\231\148\168\229\184\131\230\147\166\230\139\173\229\136\128\232\186\171\239\188\140\228\184\128\233\157\162\230\147\166\229\174\140\229\134\141\230\147\166\229\143\166\228\184\128\233\157\162\227\128\130\230\175\143\230\172\161\230\140\175\232\161\128\231\180\132\233\156\128{time}\231\167\146\227\128\130",
		["Drawing the sword"] = "\230\139\148\229\136\128\232\161\147",
		["The sword starts sheathed, with a hand on the sheath, ready to draw.\n\n<b>{Lock}</b>: toggle lock-on. While locked on, the mouse picks the cut; its name shows at the bottom of the screen.\n<b>{NextTarget}</b>: switch target.\n<b>{Unequip}</b>: unequip the sword. <b>{Equip}</b>: equip it again."] = "\229\136\128\228\184\128\233\150\139\229\167\139\230\148\182\229\156\168\229\136\128\233\158\152\228\184\173\239\188\140\230\137\139\230\140\137\229\156\168\229\136\128\233\158\152\228\184\138\239\188\140\233\154\168\230\153\130\229\143\175\228\187\165\230\139\148\229\136\128\227\128\130\n\n<b>{Lock}</b>\239\188\154\233\150\139\229\149\159\230\136\150\233\151\156\233\150\137\233\142\150\229\174\154\227\128\130\233\142\150\229\174\154\230\153\130\239\188\140\230\187\145\233\188\160\228\189\141\231\189\174\230\177\186\229\174\154\230\139\148\229\135\186\229\147\170\231\168\174\230\150\172\230\147\138\239\188\140\229\144\141\231\168\177\230\156\131\233\161\175\231\164\186\229\156\168\232\158\162\229\185\149\229\186\149\233\131\168\227\128\130\n<b>{NextTarget}</b>\239\188\154\229\136\135\230\143\155\231\155\174\230\168\153\227\128\130\n<b>{Unequip}</b>\239\188\154\233\172\134\230\137\139\230\148\190\233\150\139\229\136\128\227\128\130<b>{Equip}</b>\239\188\154\233\135\141\230\150\176\230\143\161\229\136\128\227\128\130",
		["Move the mouse to pick the cut, then hold {Draw} and swipe:\n\n<b>Down-left</b>, swipe up-right: low cut.\n<b>Left</b>, swipe right: horizontal slice.\n<b>Up-left</b>, swipe down-right: diagonal cut.\n<b>Up</b>, swipe down: vertical slice.\n\nA faster swipe makes a faster cut.\n\n<b>{CalmDraw}</b>: calm draw. The blade slides out slowly into a guard, with no cut."] = "\231\167\187\229\139\149\230\187\145\233\188\160\233\129\184\230\147\135\230\150\172\230\147\138\239\188\140\231\132\182\229\190\140\230\140\137\228\189\143{Draw}\228\184\166\230\187\145\229\139\149\239\188\154\n\n<b>\229\183\166\228\184\139</b>\239\188\140\229\144\145\229\143\179\228\184\138\230\187\145\229\139\149\239\188\154\230\146\169\230\150\172\227\128\130\n<b>\229\183\166</b>\239\188\140\229\144\145\229\143\179\230\187\145\229\139\149\239\188\154\230\169\171\230\150\172\227\128\130\n<b>\229\183\166\228\184\138</b>\239\188\140\229\144\145\229\143\179\228\184\139\230\187\145\229\139\149\239\188\154\230\150\156\230\150\172\227\128\130\n<b>\228\184\138</b>\239\188\140\229\144\145\228\184\139\230\187\145\229\139\149\239\188\154\231\184\177\230\150\172\227\128\130\n\n\230\187\145\229\190\151\232\182\138\229\191\171\239\188\140\230\150\172\229\190\151\232\182\138\229\191\171\227\128\130\n\n<b>{CalmDraw}</b>\239\188\154\233\157\156\229\191\131\230\139\148\229\136\128\227\128\130\229\136\128\232\186\171\231\183\169\231\183\169\229\135\186\233\158\152\239\188\140\230\147\186\229\165\189\230\160\188\230\147\139\230\158\182\229\139\162\239\188\140\228\184\141\229\135\186\230\150\172\230\147\138\227\128\130",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>{Equip}</b>: put the blade away. The next draw is ready about a second later."] = "\230\139\148\229\136\128\230\150\172\230\153\130\230\143\161\229\136\128\230\165\181\231\169\169\227\128\130\232\162\171\230\139\148\229\136\128\230\150\172\230\147\138\228\184\173\231\154\132\229\136\128\230\156\131\232\162\171\230\147\138\233\150\139\239\188\140\228\184\166\230\144\141\229\164\177{block}\232\187\128\229\185\185\227\128\130\230\175\143\230\172\161\230\139\148\229\136\128\230\150\172\230\182\136\232\128\151{draw}\232\187\128\229\185\185\227\128\130\n\n<b>{Equip}</b>\239\188\154\230\148\182\229\136\128\227\128\130\231\180\132\228\184\128\231\167\146\229\190\140\229\143\175\228\187\165\229\134\141\230\172\161\230\139\148\229\136\128\227\128\130",
		["The sword starts sheathed, with a hand on the sheath, ready to draw. While locked on, a slow drag on the right side of the screen moves the hand on the sheath, and a quick <b>flick</b> draws. The flick\'s direction picks the cut.\n\n<b>LOCKED ON</b>: tap to switch target, hold to turn lock-on off. <b>LOCK ON</b>: tap to turn it back on.\n<b>UNEQUIP</b>: hold to unequip the sword. <b>EQUIP</b>: tap to equip it again."] = "\229\136\128\228\184\128\233\150\139\229\167\139\230\148\182\229\156\168\229\136\128\233\158\152\228\184\173\239\188\140\230\137\139\230\140\137\229\156\168\229\136\128\233\158\152\228\184\138\239\188\140\233\154\168\230\153\130\229\143\175\228\187\165\230\139\148\229\136\128\227\128\130\233\142\150\229\174\154\230\153\130\239\188\140\229\156\168\232\158\162\229\185\149\229\143\179\229\129\180\231\183\169\230\133\162\230\139\150\229\139\149\229\143\175\231\167\187\229\139\149\229\136\128\233\158\152\228\184\138\231\154\132\230\137\139\239\188\140<b>\229\191\171\230\187\145</b>\229\141\179\229\143\175\230\139\148\229\136\128\227\128\130\229\191\171\230\187\145\231\154\132\230\150\185\229\144\145\230\177\186\229\174\154\230\150\172\230\147\138\227\128\130\n\n\227\128\140<b>\229\183\178\233\142\150\229\174\154</b>\227\128\141\239\188\154\233\187\158\230\147\138\229\136\135\230\143\155\231\155\174\230\168\153\239\188\140\233\149\183\230\140\137\233\151\156\233\150\137\233\142\150\229\174\154\227\128\130\227\128\140<b>\233\142\150\229\174\154</b>\227\128\141\239\188\154\233\187\158\230\147\138\233\135\141\230\150\176\233\150\139\229\149\159\227\128\130\n\227\128\140<b>\233\172\134\230\137\139</b>\227\128\141\239\188\154\233\149\183\230\140\137\230\148\190\233\150\139\229\136\128\227\128\130\227\128\140<b>\230\143\161\229\136\128</b>\227\128\141\239\188\154\233\187\158\230\147\138\233\135\141\230\150\176\230\143\161\229\136\128\227\128\130",
		["<b>Flick right</b>: horizontal slice.\n<b>Flick down</b>: vertical slice.\n<b>Flick up-right</b>: low cut.\n\n<b>CALM DRAW</b>: the blade slides out slowly into a guard, with no cut."] = "<b>\229\144\145\229\143\179\229\191\171\230\187\145</b>\239\188\154\230\169\171\230\150\172\227\128\130\n<b>\229\144\145\228\184\139\229\191\171\230\187\145</b>\239\188\154\231\184\177\230\150\172\227\128\130\n<b>\229\144\145\229\143\179\228\184\138\229\191\171\230\187\145</b>\239\188\154\230\146\169\230\150\172\227\128\130\n\n\227\128\140<b>\233\157\156\229\191\131\230\139\148\229\136\128</b>\227\128\141\239\188\154\229\136\128\232\186\171\231\183\169\231\183\169\229\135\186\233\158\152\239\188\140\230\147\186\229\165\189\230\160\188\230\147\139\230\158\182\229\139\162\239\188\140\228\184\141\229\135\186\230\150\172\230\147\138\227\128\130",
		["Draw-cuts are held firm. A blade hit by a draw-cut is knocked aside and loses {block} poise. Each draw-cut costs {draw} poise.\n\n<b>SHEATHE</b>: put the blade away. The next draw is ready about a second later."] = "\230\139\148\229\136\128\230\150\172\230\153\130\230\143\161\229\136\128\230\165\181\231\169\169\227\128\130\232\162\171\230\139\148\229\136\128\230\150\172\230\147\138\228\184\173\231\154\132\229\136\128\230\156\131\232\162\171\230\147\138\233\150\139\239\188\140\228\184\166\230\144\141\229\164\177{block}\232\187\128\229\185\185\227\128\130\230\175\143\230\172\161\230\139\148\229\136\128\230\150\172\230\182\136\232\128\151{draw}\232\187\128\229\185\185\227\128\130\n\n\227\128\140<b>\230\148\182\229\136\128</b>\227\128\141\239\188\154\229\176\135\229\136\128\230\148\182\229\155\158\233\158\152\228\184\173\227\128\130\231\180\132\228\184\128\231\167\146\229\190\140\229\143\175\228\187\165\229\134\141\230\172\161\230\139\148\229\136\128\227\128\130",
		["Clashes and parries"] = "\230\139\188\229\136\128\232\136\135\229\189\136\229\143\141",
		["Blades that meet push each other apart, and the firmer blade moves less. A hard swing knocks a still blade far aside, and that blade is slow to recover: an opening to attack.\n\nHit near the hands, a blade barely moves. Hit near the tip, it\'s knocked aside easily."] = "\231\155\184\231\162\176\231\154\132\229\136\128\230\156\131\228\186\146\231\155\184\230\142\168\233\150\139\239\188\140\230\143\161\229\190\151\230\155\180\231\169\169\231\154\132\229\136\128\231\167\187\229\139\149\230\155\180\229\176\145\227\128\130\231\140\155\229\138\155\230\143\174\231\160\141\232\131\189\230\138\138\233\157\156\230\173\162\231\154\132\229\136\128\233\129\160\233\129\160\230\147\138\233\150\139\239\188\140\232\128\140\228\184\148\232\169\178\229\136\128\229\155\158\228\189\141\231\183\169\230\133\162\239\188\154\233\128\153\230\173\163\230\152\175\233\128\178\230\148\187\231\154\132\230\169\159\230\156\131\227\128\130\n\n\230\147\138\228\184\173\233\157\160\232\191\145\230\143\161\230\159\132\232\153\149\239\188\140\229\136\128\229\185\190\228\185\142\230\150\135\233\162\168\228\184\141\229\139\149\227\128\130\230\147\138\228\184\173\233\157\160\232\191\145\229\136\128\229\176\150\232\153\149\239\188\140\229\136\128\229\190\136\229\174\185\230\152\147\232\162\171\230\147\138\233\150\139\227\128\130",
		["<b>Draw-cuts</b> hit hardest. A blade held still that meets a draw-cut, or the drawer while the blade comes out, is knocked aside, and the cut goes through.\n\n<b>A still guard</b> (L2 on a gamepad) parries other swings: the swing bounces off and the attacker is staggered.\n\n<b>Two swings meeting</b> both give way, and neither can cut for a moment.\n\nThe whole sword can clash, handle included."] = "<b>\230\139\148\229\136\128\230\150\172</b>\229\138\155\233\129\147\230\156\128\229\188\183\227\128\130\233\157\156\230\173\162\231\154\132\229\136\128\231\162\176\229\136\176\230\139\148\229\136\128\230\150\172\239\188\140\230\136\150\229\156\168\229\135\186\229\136\128\230\153\130\231\162\176\229\136\176\230\139\148\229\136\128\232\128\133\239\188\140\230\156\131\232\162\171\229\189\136\233\150\139\239\188\140\232\128\140\230\150\172\230\147\138\231\155\180\230\142\165\230\150\172\233\129\142\227\128\130\n\n<b>\233\157\156\230\173\162\230\160\188\230\147\139</b>\239\188\136\230\137\139\230\138\138\231\130\186L2\239\188\137\229\143\175\229\189\136\229\143\141\229\133\182\228\187\150\230\143\174\231\160\141\239\188\154\230\143\174\231\160\141\230\156\131\232\162\171\229\189\136\233\150\139\239\188\140\230\148\187\230\147\138\232\128\133\233\153\183\229\133\165\232\184\137\232\185\140\227\128\130\n\n<b>\229\133\169\230\172\161\230\143\174\231\160\141\231\155\184\230\146\158</b>\230\153\130\233\155\153\230\150\185\233\131\189\230\156\131\232\162\171\230\142\168\233\150\139\239\188\140\228\184\128\230\153\130\232\170\176\228\185\159\231\132\161\230\179\149\230\150\172\230\147\138\227\128\130\n\n\230\149\180\230\138\138\229\136\128\233\131\189\232\131\189\230\139\188\229\136\128\239\188\140\229\136\128\230\159\132\228\185\159\229\140\133\230\139\172\229\156\168\229\133\167\227\128\130",
		["Cuts, wounds and bleeding"] = "\230\150\172\230\147\138\227\128\129\229\130\183\229\143\163\232\136\135\230\181\129\232\161\128",
		["A cut needs speed and a leading edge. Speed comes from the swing and from movement, so dashing past counts. A sudden change of direction hits with the flat.\n\nOnly a blade moving into a target counts. A blade left resting in a body sticks."] = "\230\150\172\230\147\138\233\156\128\232\166\129\233\128\159\229\186\166\239\188\140\232\128\140\228\184\148\229\136\128\229\136\131\230\156\157\229\137\141\227\128\130\233\128\159\229\186\166\228\190\134\232\135\170\230\143\174\229\136\128\229\146\140\231\167\187\229\139\149\239\188\140\229\155\160\230\173\164\232\161\157\229\136\186\230\142\160\233\129\142\228\185\159\231\174\151\227\128\130\231\170\129\231\132\182\230\148\185\232\174\138\230\150\185\229\144\145\230\156\131\232\174\138\230\136\144\229\136\128\233\157\162\230\139\141\230\137\147\227\128\130\n\n\229\143\170\230\156\137\230\156\157\231\155\174\230\168\153\229\136\135\229\133\165\231\154\132\229\136\128\230\137\141\231\174\151\230\149\184\227\128\130\229\129\156\231\149\153\229\156\168\232\186\171\233\171\148\232\163\161\231\154\132\229\136\128\230\156\131\229\141\161\228\189\143\227\128\130",
		["A fast, edge-first cut all the way through a limb <b>severs</b> it. Through the head or torso: <b>a kill</b>.\n\nAnything less is a <b>wound</b>: it bleeds and slows the limb. Deeper wounds are worse.\n\n<b>Stabs</b> never kill outright. A stab to the head, or a fast one to the body (dash or lunge in), takes a lot of blood at once. Other stabs wound."] = "\233\128\159\229\186\166\229\191\171\227\128\129\229\136\128\229\136\131\229\156\168\229\137\141\228\184\148\229\174\140\229\133\168\229\136\135\231\169\191\232\130\162\233\171\148\231\154\132\230\150\172\230\147\138\239\188\140\230\156\131\229\176\135\229\133\182<b>\230\150\172\230\150\183</b>\227\128\130\229\136\135\231\169\191\233\160\173\233\131\168\230\136\150\232\186\171\232\187\128\239\188\154<b>\228\184\128\230\147\138\230\150\131\229\145\189</b>\227\128\130\n\n\230\156\170\233\129\148\229\136\176\233\128\153\229\128\139\231\168\139\229\186\166\231\154\132\229\137\135\230\152\175<b>\229\130\183\229\143\163</b>\239\188\154\230\156\131\230\181\129\232\161\128\228\184\166\228\189\191\232\169\178\232\130\162\233\171\148\232\174\138\230\133\162\227\128\130\229\130\183\229\143\163\232\182\138\230\183\177\232\182\138\229\154\180\233\135\141\227\128\130\n\n<b>\231\170\129\229\136\186</b>\228\184\141\230\156\131\228\184\128\230\147\138\230\150\131\229\145\189\227\128\130\231\170\129\229\136\186\233\160\173\233\131\168\239\188\140\230\136\150\229\191\171\233\128\159\231\170\129\229\136\186\232\186\171\233\171\148\239\188\136\232\161\157\229\136\186\230\136\150\231\170\129\233\128\178\229\136\186\229\133\165\239\188\137\239\188\140\230\156\131\228\184\128\228\184\139\233\128\160\230\136\144\229\164\167\233\135\143\229\164\177\232\161\128\227\128\130\229\133\182\228\187\150\231\170\129\229\136\186\229\143\170\233\128\160\230\136\144\229\130\183\229\143\163\227\128\130",
		["Every fighter has {squares} squares of blood. Wounds bleed for a few seconds, and so does a lost limb. With two limbs lost, the stumps bleed out. Losing both arms drops the katana.\n\nCombat is allowed in the arena and the forest, except in safe zones. Inside one, the screen shows <b>{safe}</b>."] = "\230\175\143\229\144\141\230\173\166\232\128\133\233\131\189\230\156\137{squares}\230\160\188\232\161\128\227\128\130\229\130\183\229\143\163\230\156\131\230\181\129\232\161\128\229\185\190\231\167\146\239\188\140\230\150\183\232\130\162\228\185\159\228\184\128\230\168\163\227\128\130\229\164\177\229\142\187\229\133\169\230\162\157\232\130\162\233\171\148\229\190\140\239\188\140\230\150\183\229\143\163\230\156\131\228\184\128\231\155\180\230\181\129\232\161\128\229\136\176\230\173\187\228\186\161\231\130\186\230\173\162\227\128\130\229\164\177\229\142\187\233\155\153\232\135\130\229\176\177\230\156\131\230\142\137\229\136\128\227\128\130\n\n\231\171\182\230\138\128\229\160\180\229\146\140\230\163\174\230\158\151\228\184\173\233\131\189\229\143\175\228\187\165\230\136\176\233\172\165\239\188\140\229\174\137\229\133\168\229\141\128\233\153\164\229\164\150\227\128\130\232\186\171\232\153\149\229\174\137\229\133\168\229\141\128\230\153\130\239\188\140\232\158\162\229\185\149\230\156\131\233\161\175\231\164\186<b>{safe}</b>\227\128\130",
		["The forge and levels"] = "\233\141\155\229\136\128\229\157\138\232\136\135\231\173\137\231\180\154",
		["XP rewards:\n\n<b>Wounding a player</b>: {wound}.\n<b>Severing a limb</b>: {sever}.\n<b>A kill</b>: {kill}.\n<b>Defeating a bot</b>: {botLeast} to {botMost}, more for rarer names.\n\nEach level needs a little more XP than the last. No level cap."] = "XP\231\141\142\229\139\181\239\188\154\n\n<b>\229\130\183\229\136\176\231\142\169\229\174\182</b>\239\188\154{wound}\227\128\130\n<b>\230\150\172\230\150\183\232\130\162\233\171\148</b>\239\188\154{sever}\227\128\130\n<b>\230\147\138\230\174\186</b>\239\188\154{kill}\227\128\130\n<b>\230\147\138\230\149\151\228\186\186\230\169\159</b>\239\188\154{botLeast}\229\136\176{botMost}\239\188\140\229\167\147\230\176\143\232\182\138\231\168\128\230\156\137\232\182\138\229\164\154\227\128\130\n\n\230\175\143\231\180\154\230\137\128\233\156\128XP\230\175\148\228\184\138\228\184\128\231\180\154\231\149\165\229\164\154\227\128\130\230\178\146\230\156\137\231\173\137\231\180\154\228\184\138\233\153\144\227\128\130",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, press E at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "\230\175\143{levels}\231\180\154\232\167\163\233\142\150\228\184\128\229\128\139\230\150\176\231\154\132<b>\233\141\155\229\136\128\231\173\137\231\180\154</b>\227\128\130\229\156\168\231\171\182\230\138\128\229\160\180\229\141\151\233\130\138\231\154\132\233\141\155\229\136\128\229\157\138\239\188\140\229\136\176\233\144\181\231\160\167\229\137\141\230\140\137E\239\188\140\231\130\186\229\136\128\229\138\160\231\134\177\227\128\129\233\142\154\230\137\147\227\128\129\230\183\172\231\129\171\227\128\130\230\175\143\229\128\139\231\173\137\231\180\154\233\131\189\230\156\131\232\179\166\228\186\136\229\136\128\229\133\168\230\150\176\231\154\132\229\164\150\232\167\128\229\146\140\228\184\128\233\160\133\230\150\176\229\188\183\229\140\150\227\128\130\n\n\233\128\153\232\163\161\231\154\132\229\136\128\230\158\182\229\177\149\231\164\186\228\186\134\230\175\143\229\128\139\233\141\155\229\136\128\231\173\137\231\180\154\231\154\132\229\136\128\227\128\130\n\n<b>\233\135\141\233\145\132</b>\229\141\179\229\143\175\229\136\135\230\143\155\229\155\158\228\187\187\228\189\149\229\183\178\233\141\155\233\128\160\233\129\142\231\154\132\231\173\137\231\180\154\227\128\130",
		["A new <b>forge rank</b> unlocks every {levels} levels. At the forge, south of the arena, tap <b>Forge your blade</b> at the anvil to heat, hammer and quench the blade. Each rank gives the blade a new look and a new upgrade.\n\nThe sword wall here shows every forge rank\'s blade.\n\n<b>Reforge</b> to switch back to any rank already forged."] = "\230\175\143{levels}\231\180\154\232\167\163\233\142\150\228\184\128\229\128\139\230\150\176\231\154\132<b>\233\141\155\229\136\128\231\173\137\231\180\154</b>\227\128\130\229\156\168\231\171\182\230\138\128\229\160\180\229\141\151\233\130\138\231\154\132\233\141\155\229\136\128\229\157\138\239\188\140\229\136\176\233\144\181\231\160\167\229\137\141\233\187\158\230\147\138\227\128\140<b>\233\141\155\233\128\160\229\136\128\229\136\131</b>\227\128\141\239\188\140\231\130\186\229\136\128\229\138\160\231\134\177\227\128\129\233\142\154\230\137\147\227\128\129\230\183\172\231\129\171\227\128\130\230\175\143\229\128\139\231\173\137\231\180\154\233\131\189\230\156\131\232\179\166\228\186\136\229\136\128\229\133\168\230\150\176\231\154\132\229\164\150\232\167\128\229\146\140\228\184\128\233\160\133\230\150\176\229\188\183\229\140\150\227\128\130\n\n\233\128\153\232\163\161\231\154\132\229\136\128\230\158\182\229\177\149\231\164\186\228\186\134\230\175\143\229\128\139\233\141\155\229\136\128\231\173\137\231\180\154\231\154\132\229\136\128\227\128\130\n\n<b>\233\135\141\233\145\132</b>\229\141\179\229\143\175\229\136\135\230\143\155\229\155\158\228\187\187\228\189\149\229\183\178\233\141\155\233\128\160\233\129\142\231\154\132\231\173\137\231\180\154\227\128\130",
		["Kill streaks"] = "\233\128\163\230\150\172",
		["A <b>kill streak</b> counts kills in a row without dying, shown at the top right. Bleed-outs from a cut count, and so do bot kills. Dying ends the streak, but the best one is saved."] = "<b>\233\128\163\230\150\172</b>\231\181\177\232\168\136\230\156\170\230\173\187\228\186\161\230\156\159\233\150\147\231\154\132\233\128\163\231\186\140\230\147\138\230\174\186\230\149\184\239\188\140\233\161\175\231\164\186\229\156\168\229\143\179\228\184\138\232\167\146\227\128\130\232\162\171\230\150\172\229\130\183\229\190\140\229\164\177\232\161\128\232\128\140\228\186\161\231\154\132\228\185\159\231\174\151\239\188\140\230\147\138\230\174\186\228\186\186\230\169\159\228\185\159\231\174\151\227\128\130\230\173\187\228\186\161\230\156\131\228\184\173\230\150\183\233\128\163\230\150\172\239\188\140\228\189\134\230\156\128\228\189\179\231\180\128\233\140\132\230\156\131\228\191\157\229\173\152\228\184\139\228\190\134\227\128\130",
		["The streak catches fire as it grows, and every ten kills earns a title. Every {every} kills up to {most}: +{share} walk speed and poise recovery (Mythic names +{mythic}, Exotic names +{exotic}).\n\nNo prizes: it\'s for the glory.\n\nAfter dying, <b>SPECTATE</b> watches other fighters and <b>RESPAWN</b> returns to the fight."] = "\233\128\163\230\150\172\232\182\138\229\164\154\239\188\140\230\149\184\229\173\151\229\176\177\230\156\131\231\135\131\232\181\183\231\129\171\231\132\176\239\188\155\230\175\143\229\141\129\233\128\163\230\150\172\231\141\178\229\190\151\228\184\128\229\128\139\231\168\177\232\153\159\227\128\130\230\175\143{every}\233\128\163\230\150\172\239\188\140\231\155\180\229\136\176{most}\233\128\163\230\150\172\239\188\154\231\167\187\229\139\149\233\128\159\229\186\166\232\136\135\232\187\128\229\185\185\230\129\162\229\190\169+{share}\239\188\136\231\165\158\232\169\177\229\167\147\230\176\143+{mythic}\239\188\140\232\182\133\229\135\161\229\167\147\230\176\143+{exotic}\239\188\137\227\128\130\n\n\230\178\146\230\156\137\231\141\142\229\147\129\239\188\154\229\143\170\231\130\186\230\166\174\232\128\128\227\128\130\n\n\233\153\163\228\186\161\229\190\140\239\188\140\227\128\140<b>\232\167\128\230\136\176</b>\227\128\141\229\143\175\228\187\165\232\167\128\231\156\139\229\133\182\228\187\150\230\173\166\232\128\133\230\136\176\233\172\165\239\188\140\227\128\140<b>\229\190\169\230\180\187</b>\227\128\141\229\143\175\228\187\165\233\135\141\232\191\148\230\136\176\233\172\165\227\128\130",
		["TO WHOEVER FREED THIS TEMPLE"] = "\232\135\180\232\167\163\230\148\190\230\173\164\229\175\186\228\185\139\228\186\186",
		["Her blade still rests within these walls. Search every corner."] = "\229\165\185\231\154\132\229\136\128\228\187\141\229\174\137\230\148\190\229\156\168\233\128\153\229\156\141\231\137\134\228\185\139\229\133\167\227\128\130\230\144\156\233\129\141\230\175\143\228\184\128\229\128\139\232\167\146\232\144\189\227\128\130",
