		["Poise"] = "\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165",
		["<b>Poise</b> is a fighter\'s steadiness. The poise bar is the thin bar above the blood squares; an opponent\'s is under their name. It grows from the middle as poise is lost, turning from gold to red, and hides at full poise."] = "<b>\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165</b>\224\184\132\224\184\183\224\184\173\224\184\132\224\184\167\224\184\178\224\184\161\224\184\161\224\184\177\224\185\136\224\184\153\224\184\132\224\184\135\224\184\130\224\184\173\224\184\135\224\184\153\224\184\177\224\184\129\224\184\170\224\184\185\224\185\137 \224\185\129\224\184\150\224\184\154\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\184\132\224\184\183\224\184\173\224\185\129\224\184\150\224\184\154\224\184\154\224\184\178\224\184\135\224\185\134 \224\185\128\224\184\171\224\184\153\224\184\183\224\184\173\224\184\138\224\185\136\224\184\173\224\184\135\224\185\128\224\184\165\224\184\183\224\184\173\224\184\148 \224\184\170\224\185\136\224\184\167\224\184\153\224\184\130\224\184\173\224\184\135\224\184\132\224\184\185\224\185\136\224\184\149\224\185\136\224\184\173\224\184\170\224\184\185\224\185\137\224\184\173\224\184\162\224\184\185\224\185\136\224\185\131\224\184\149\224\185\137\224\184\138\224\184\183\224\185\136\224\184\173 \224\185\129\224\184\150\224\184\154\224\184\136\224\184\176\224\184\130\224\184\162\224\184\178\224\184\162\224\184\136\224\184\178\224\184\129\224\184\149\224\184\163\224\184\135\224\184\129\224\184\165\224\184\178\224\184\135\224\185\128\224\184\161\224\184\183\224\185\136\224\184\173\224\185\128\224\184\170\224\184\181\224\184\162\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165 \224\185\128\224\184\155\224\184\165\224\184\181\224\185\136\224\184\162\224\184\153\224\184\136\224\184\178\224\184\129\224\184\170\224\184\181\224\184\151\224\184\173\224\184\135\224\185\128\224\184\155\224\185\135\224\184\153\224\184\170\224\184\181\224\185\129\224\184\148\224\184\135 \224\185\129\224\184\165\224\184\176\224\184\136\224\184\176\224\184\139\224\185\136\224\184\173\224\184\153\224\185\128\224\184\161\224\184\183\224\185\136\224\184\173\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\185\128\224\184\149\224\185\135\224\184\161",
		["Poise costs:\n\n<b>Draw-cut</b>: {draw}.  <b>Blade hit by a draw-cut</b>: {block}.\n<b>Hard swing</b>: {swing}.  <b>Dash</b>: {dash}.  <b>Kick</b>: {kick}.\n<b>Taking a cut</b>: {wound} (double from a draw-cut), plus blood loss.\n<b>Clashes</b>: more the harder the blade is knocked."] = "\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\184\151\224\184\181\224\185\136\224\185\128\224\184\170\224\184\181\224\184\162:\n\n<b>\224\184\159\224\184\177\224\184\153\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154</b>: {draw}   <b>\224\184\148\224\184\178\224\184\154\224\184\151\224\184\181\224\185\136\224\185\130\224\184\148\224\184\153\224\184\159\224\184\177\224\184\153\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154</b>: {block}\n<b>\224\184\159\224\184\178\224\184\148\224\185\129\224\184\163\224\184\135</b>: {swing}   <b>\224\184\158\224\184\184\224\185\136\224\184\135</b>: {dash}   <b>\224\185\128\224\184\149\224\184\176</b>: {kick}\n<b>\224\185\130\224\184\148\224\184\153\224\184\159\224\184\177\224\184\153</b>: {wound} (\224\184\170\224\184\173\224\184\135\224\185\128\224\184\151\224\185\136\224\184\178\224\184\150\224\185\137\224\184\178\224\185\130\224\184\148\224\184\153\224\184\159\224\184\177\224\184\153\224\184\138\224\184\177\224\184\129\224\184\148\224\184\178\224\184\154) \224\185\129\224\184\165\224\184\176\224\184\129\224\184\178\224\184\163\224\185\128\224\184\170\224\184\181\224\184\162\224\185\128\224\184\165\224\184\183\224\184\173\224\184\148\n<b>\224\184\155\224\184\176\224\184\151\224\184\176</b>: \224\184\162\224\184\180\224\185\136\224\184\135\224\184\148\224\184\178\224\184\154\224\185\130\224\184\148\224\184\153\224\184\129\224\184\163\224\184\176\224\185\129\224\184\151\224\184\129\224\185\129\224\184\163\224\184\135 \224\184\162\224\184\180\224\185\136\224\184\135\224\185\128\224\184\170\224\184\181\224\184\162\224\184\161\224\184\178\224\184\129",
		["Poise refills after {delay} seconds with no poise lost, at {regen} per second. A still guard (L2 on a gamepad) refills it faster; low blood refills it slower.\n\nBelow half poise, blade and movement speed drop, and the blade is knocked aside more easily."] = "\224\185\128\224\184\161\224\184\183\224\185\136\224\184\173\224\185\132\224\184\161\224\185\136\224\185\128\224\184\170\224\184\181\224\184\162\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\185\128\224\184\155\224\185\135\224\184\153\224\185\128\224\184\167\224\184\165\224\184\178 {delay} \224\184\167\224\184\180\224\184\153\224\184\178\224\184\151\224\184\181 \224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\184\136\224\184\176\224\184\159\224\184\183\224\185\137\224\184\153\224\184\167\224\184\180\224\184\153\224\184\178\224\184\151\224\184\181\224\184\165\224\184\176 {regen} \224\184\129\224\184\178\224\184\163\224\184\149\224\184\177\224\185\137\224\184\135\224\184\129\224\184\178\224\184\163\224\185\140\224\184\148\224\184\153\224\184\180\224\185\136\224\184\135 (L2 \224\184\154\224\184\153\224\184\136\224\184\173\224\184\162\224\185\128\224\184\129\224\184\161) \224\184\151\224\184\179\224\185\131\224\184\171\224\185\137\224\184\159\224\184\183\224\185\137\224\184\153\224\185\128\224\184\163\224\185\135\224\184\167\224\184\130\224\184\182\224\185\137\224\184\153 \224\184\170\224\185\136\224\184\167\224\184\153\224\185\128\224\184\165\224\184\183\224\184\173\224\184\148\224\184\153\224\185\137\224\184\173\224\184\162\224\184\151\224\184\179\224\185\131\224\184\171\224\185\137\224\184\159\224\184\183\224\185\137\224\184\153\224\184\138\224\185\137\224\184\178\224\184\165\224\184\135\n\n\224\185\128\224\184\161\224\184\183\224\185\136\224\184\173\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\184\149\224\185\136\224\184\179\224\184\129\224\184\167\224\185\136\224\184\178\224\184\132\224\184\163\224\184\182\224\185\136\224\184\135 \224\184\132\224\184\167\224\184\178\224\184\161\224\185\128\224\184\163\224\185\135\224\184\167\224\184\148\224\184\178\224\184\154\224\185\129\224\184\165\224\184\176\224\184\129\224\184\178\224\184\163\224\185\128\224\184\132\224\184\165\224\184\183\224\185\136\224\184\173\224\184\153\224\184\151\224\184\181\224\185\136\224\184\136\224\184\176\224\184\165\224\184\148\224\184\165\224\184\135 \224\185\129\224\184\165\224\184\176\224\184\148\224\184\178\224\184\154\224\184\136\224\184\176\224\184\150\224\184\185\224\184\129\224\184\155\224\184\177\224\184\148\224\184\173\224\184\173\224\184\129\224\184\135\224\185\136\224\184\178\224\184\162\224\184\130\224\184\182\224\185\137\224\184\153",
		["At zero, poise <b>breaks</b>: staggered for {stagger} seconds, then weakened for {weakened} seconds ({slower} slower, out of breath, the screen\'s edges darkening). Poise then refills to half.\n\nThe fastest way back to full poise is to <b>wipe the blade</b> ({Wipe}). See the next scroll."] = "\224\185\128\224\184\161\224\184\183\224\185\136\224\184\173\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\185\128\224\184\171\224\184\165\224\184\183\224\184\173\224\184\168\224\184\185\224\184\153\224\184\162\224\185\140 \224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\184\136\224\184\176<b>\224\185\129\224\184\149\224\184\129</b>: \224\184\138\224\184\176\224\184\135\224\184\177\224\184\129 {stagger} \224\184\167\224\184\180\224\184\153\224\184\178\224\184\151\224\184\181 \224\185\129\224\184\165\224\185\137\224\184\167\224\184\173\224\185\136\224\184\173\224\184\153\224\185\129\224\184\163\224\184\135 {weakened} \224\184\167\224\184\180\224\184\153\224\184\178\224\184\151\224\184\181 (\224\184\138\224\185\137\224\184\178\224\184\165\224\184\135 {slower} \224\184\171\224\184\173\224\184\154 \224\185\129\224\184\165\224\184\176\224\184\130\224\184\173\224\184\154\224\184\136\224\184\173\224\184\161\224\184\183\224\184\148\224\184\165\224\184\135) \224\184\136\224\184\178\224\184\129\224\184\153\224\184\177\224\185\137\224\184\153\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\184\136\224\184\176\224\184\159\224\184\183\224\185\137\224\184\153\224\184\129\224\184\165\224\184\177\224\184\154\224\184\161\224\184\178\224\184\132\224\184\163\224\184\182\224\185\136\224\184\135\224\184\171\224\184\153\224\184\182\224\185\136\224\184\135\n\n\224\184\167\224\184\180\224\184\152\224\184\181\224\184\151\224\184\181\224\185\136\224\185\128\224\184\163\224\185\135\224\184\167\224\184\151\224\184\181\224\185\136\224\184\170\224\184\184\224\184\148\224\185\131\224\184\153\224\184\129\224\184\178\224\184\163\224\185\128\224\184\149\224