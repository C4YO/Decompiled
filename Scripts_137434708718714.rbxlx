v63.Names = v64
local v72 = {
	["Title"] = v10("Poise")
}
local v73 = {}
local v74, v75 = v10("<b>Poise</b> is a fighter\'s steadiness. The poise bar is the thin bar above the blood squares; an opponent\'s is under their name. It grows from the middle as poise is lost, turning from gold to red, and hides at full poise.")
__set_list(v73, 1, {{
	["Text"] = v74,
	["Args"] = v75
}, {
	["Text"] = v10("Poise costs:\n\n<b>Draw-cut</b>: {draw}.  <b>Blade hit by a draw-cut</b>: {block}.\n<b>Hard swing</b>: {swing}.  <b>Dash</b>: {dash}.  <b>Kick</b>: {kick}.\n<b>Taking a cut</b>: {wound} (double from a draw-cut), plus blood loss.\n<b>Clashes</b>: more the harder the blade is knocked."),
	["Args"] = function()
		-- upvalues: (copy) v_u_12
