		["Blade out, walk up close. Hold **W + A** to walk past the watermelon, then press **{Dash}** to dash through it."] = "R\195\186t ki\225\186\191m ra, \196\145i l\225\186\161i g\225\186\167n. Gi\225\187\175 **W + A** \196\145\225\187\131 \196\145i ngang qua qu\225\186\163 d\198\176a h\225\186\165u, r\225\187\147i nh\225\186\165n **{Dash}** \196\145\225\187\131 l\198\176\225\187\155t xuy\195\170n qua n\195\179.",
		["HOLD W + A"] = "GI\225\187\174 W + A",
		["PRESS {Dash}"] = "NH\225\186\164N {Dash}",
		["Blade out, walk up close. Walk past the watermelon, then tap **DASH** to dash through it."] = "R\195\186t ki\225\186\191m ra, \196\145i l\225\186\161i g\225\186\167n. \196\144i ngang qua qu\225\186\163 d\198\176a h\225\186\165u, r\225\187\147i ch\225\186\161m **L\198\175\225\187\154T** \196\145\225\187\131 l\198\176\225\187\155t xuy\195\170n qua n\195\179.",
		["WALK PAST IT"] = "\196\144I NGANG QUA",
		["TAP DASH"] = "CH\225\186\160M L\198\175\225\187\154T",
		["That was the low cut"] = "\196\144\195\179 l\195\160 ch\195\169m th\225\186\165p",
		["That was the horizontal slice"] = "\196\144\195\179 l\195\160 ch\195\169m ngang",
		["That was a diagonal cut"] = "\196\144\195\179 l\195\160 ch\195\169m ch\195\169o",
		["That was the vertical slice"] = "\196\144\195\179 l\195\160 ch\195\169m d\225\187\141c",
		["That was another draw"] = "\196\144\195\179 l\195\160 m\225\187\153t th\225\186\191 r\195\186t ki\225\186\191m kh\195\161c",
		["That was a swing"] = "\196\144\195\179 l\195\160 m\225\187\153t nh\195\161t vung",
		["move the mouse **left**, then **hold {Draw}** and **swipe right**"] = "di chu\225\187\153t sang **tr\195\161i**, r\225\187\147i **gi\225\187\175 {Draw}** v\195\160 **lia sang ph\225\186\163i**",
		["move the mouse **up**, then **hold {Draw}** and **swipe down**"] = "di chu\225\187\153t **l\195\170n**, r\225\187\147i **gi\225\187\175 {Draw}** v\195\160 **lia xu\225\187\145ng**",
		["draw again"] = "r\195\186t ki\225\186\191m l\225\186\161i",
		["**flick right** on the right side of the screen"] = "**vu\225\187\145t nhanh sang ph\225\186\163i** \225\187\159 b\195\170n ph\225\186\163i m\195\160n h\195\172nh",
		["**flick down** on the right side of the screen"] = "**vu\225\187\145t nhanh xu\225\187\145ng** \225\187\159 b\195\170n ph\225\186\163i m\195\160n h\195\172nh",
		["Rusted, the cord rotten"] = "G\225\187\137 s\195\169t, d\195\162y \196\145\195\163 m\225\187\165c",
		["Rust polished away"] = "\196\144\195\163 \196\145\195\161nh b\195\179ng s\225\186\161ch g\225\187\137",
		["Black silk on the handle and cords"] = "L\225\187\165a \196\145en tr\195\170n chu\195\180i v\195\160 d\195\162y",
		["Bright silver fittings"] = "Chi ti\225\186\191t b\225\186\161c s\195\161ng b\195\179ng",
		["Black lacquered sheath"] = "V\225\187\143 ki\225\186\191m s\198\161n m\195\160i \196\145en",
		["Temper line polished, purple silk"] = "V\195\162n t\195\180i \196\145\198\176\225\187\163c \196\145\195\161nh b\195\179ng, l\225\187\165a t\195\173m",
		["Best of 5: the first to {wins} round wins."] = "\196\144\225\186\165u 5 hi\225\187\135p: ai th\225\186\175ng {wins} hi\225\187\135p tr\198\176\225\187\155c l\195\160 th\225\186\175ng.",
		["Every attack is a draw-cut that strikes through any blade. No guard."] = "M\225\187\141i \196\145\195\178n \196\145\195\161nh \196\145\225\187\129u l\195\160 \196\145\195\178n r\195\186t ki\225\186\191m xuy\195\170n qua m\225\187\141i l\198\176\225\187\161i ki\225\186\191m. Kh\195\180ng c\195\179 th\225\186\191 th\225\187\167.",
		["Fight from the sheath: every draw-cut strikes through any blade, and the blade goes straight back in."] = "Chi\225\186\191n \196\145\225\186\165u t\225\187\171 trong v\225\187\143: m\225\187\141i \196\145\195\178n r\195\186t ki\225\186\191m \196\145\225\187\129u xuy\195\170n qua m\225\187\141i l\198\176\225\187\161i ki\225\186\191m, v\195\160 ki\225\186\191m l\225\186\173p t\225\187\169c tr\225\187\159 v\195\160o v\225\187\143.",
		["10 rename spins"] = "10 l\198\176\225\187\163t quay t\195\170n",
		["50 rename spins"] = "50 l\198\176\225\187\163t quay t\195\170n",
		["Each column is a string: hold a key, then pluck that string."] = "M\225\187\151i c\225\187\153t l\195\160 m\225\187\153t d\195\162y: gi\225\187\175 m\225\187\153t ph\195\173m r\225\187\147i g\225\186\163y d\195\162y \196\145\195\179.",
		["TACHI restored: stage {stage}, {name}"] = "\196\144\195\163 ph\225\187\165c h\225\187\147i TACHI: giai \196\145o\225\186\161n {stage}, {name}",
		["You can only bow for a 1v1 with someone you could fight right now, in the same ring."] = "B\225\186\161n ch\225\187\137 c\195\179 th\225\187\131 c\195\186i ch\195\160o \196\145\225\187\131 1v1 v\225\187\155i ng\198\176\225\187\157i m\195\160 b\225\186\161n \196\145\195\161nh \196\145\198\176\225\187\163c ngay l\195\186c n\195\160y, trong c\195\185ng v\195\181 \196\145\195\160i.",
		["The rematch can\'t start: you both need to be in the same ring."] = "Kh\195\180ng th\225\187\131 t\195\161i \196\145\225\186\165u: c\225\186\163 hai c\225\186\167n \225\187\159 c\195\185ng m\225\187\153t v\195\181 \196\145\195\160i.",
		["Positions 1 to 9: hold one, then pluck."] = "V\225\187\139 tr\195\173 1 \196\145\225\186\191n 9: gi\225\187\175 m\225\187\153t ph\195\173m r\225\187\147i g\225\186\163y.",
		["Finish a daily quest"] = "Ho\195\160n th\195\160nh m\225\187\153t nhi\225\187\135m v\225\187\165 h\225\186\177ng ng\195\160y",
		["VENGEFUL EMPRESS"] = "N\225\187\174 HO\195\128NG B\195\129O TH\195\153",
		["THE TEMPLE GHOST"] = "H\225\187\146N MA NG\195\148I CH\195\153A",
		["Reroll your first name as often as you like, or spin a new family name ({count} spin)."] = "\196\144\225\187\149i t\195\170n bao nhi\195\170u l\225\186\167n t\195\185y th\195\173ch, ho\225\186\183c quay m\225\187\153t h\225\187\141 m\225\187\155i ({count} l\198\176\225\187\163t quay).",
		["Reroll your first name as often as you like, or spin a new family name ({count} spins)."] = "\196\144\225\187\149i t\195\170n bao nhi\195\170u l\225\186\167n t\195\185y th\195\173ch, ho\225\186\183c quay m\225\187\153t h\225\187\141 m\225\187\155i ({count} l\198\176\225\187\163t quay).",
		["Reroll your first name as often as you like."] = "\196\144\225\187\149i t\195\170n bao nhi\195\170u l\225\186\167n t\195\185y th\195\173ch.",
		["REROLL FIRST NAME"] = "\196\144\225\187\148I T\195\138N",
		["Couldn\'t roll. Try again."] = "Kh\195\180ng quay \196\145\198\176\225\187\163c. Th\225\187\173 l\225\186\161i nh\195\169.",
		["REROLL"] = "\196\144\225\187\148I T\195\138N",
		["Roll a first name first."] = "H\195\163y quay ra m\225\187\153t t\195\170n tr\198\176\225\187\155c \196\145\195\163.",
		["RARER THAN YOURS"] = "HI\225\186\190M H\198\160N H\225\187\140 C\225\187\166A B\225\186\160N",
		["LEGENDARY AND UP"] = "HUY\225\187\128N THO\225\186\160I TR\225\187\158 L\195\138N",
		["ASK TWICE FOR EXOTIC"] = "T\225\187\144I TH\198\175\225\187\162NG: H\225\187\142I 2 L\225\186\166N",
		["{on} OF {all}"] = "{on}/{all}",
		["Asks before a spin throws away a family name."] = "H\225\187\143i tr\198\176\225\187\155c khi l\198\176\225\187\163t quay b\225\187\143 \196\145i m\225\187\153t h\225\187\141.",
		["You\'ll lose {names} and {count} more."] = "B\225\186\161n s\225\186\189 m\225\186\165t {names} v\195\160 {count} h\225\187\141 kh\195\161c.",
		["You\'ll lose {names}."] = "B\225\186\161n s\225\186\189 m\225\186\165t {names}.",
		["Are you sure?"] = "B\225\186\161n ch\225\186\175c ch\225\187\169?",
		["{names} will be gone for good."] = "{names} s\225\186\189 m\225\186\165t v\196\169nh vi\225\187\133n.",
		["Peaceful: out in the forest nobody can hurt you, and you can\'t hurt anyone. In the rings you fight as usual."] = "H\195\178a b\195\172nh: trong r\225\187\171ng kh\195\180ng ai l\195\160m b\225\186\161n b\225\187\139 th\198\176\198\161ng \196\145\198\176\225\187\163c, v\195\160 b\225\186\161n c\197\169ng kh\195\180ng l\195\160m ai b\225\187\139 th\198\176\198\161ng \196\145\198\176\225\187\163c. Trong v\195\181 \196\145\195\160i b\225\186\161n v\225\186\171n \196\145\195\161nh nh\198\176 th\198\176\225\187\157ng.",
		["Peaceful: nobody can hurt you, and you can\'t hurt anyone. In the beginners\' ring and the boss arena you fight as usual."] = "H\195\178a b\195\172nh: kh\195\180ng ai l\195\160m b\225\186\161n b\225\187\139 th\198\176\198\161ng \196\145\198\176\225\187\163c, v\195\160 b\225\186\161n c\197\169ng kh\195\180ng l\195\160m ai b\225\187\139 th\198\176\198\161ng \196\145\198\176\225\187\163c. Trong v\195\181 \196\145\195\160i t\195\162n th\225\187\167 v\195\160 \196\145\225\186\165u tr\198\176\225\187\157ng boss b\225\186\161n chi\225\186\191n \196\145\225\186\165u nh\198\176 th\198\176\225\187\157ng.",
		["BONFIRE"] = "L\225\187\172A TR\225\186\160I",
		["LAST LOCATION"] = "V\225\187\138 TR\195\141 CU\225\187\144I",
		["Outside the ring: sword lowered"] = "Ngo\195\160i v\195\181 \196\145\195\160i: ki\225\186\191m \196\145\195\163 h\225\186\161 xu\225\187\145ng",
		["Outside the ring: sword sheathed"] = "Ngo\195\160i v\195\181 \196\145\195\160i: ki\225\186\191m \196\145\195\163 v\195\160o v\225\187\143",
		["Find bonfires out in the world to travel between them."] = "T\195\172m l\225\187\173a tr\225\186\161i kh\225\186\175p th\225\186\191 gi\225\187\155i \196\145\225\187\131 di chuy\225\187\131n gi\225\187\175a ch\195\186ng.",
		["Tap a bonfire you\'ve found to travel there."] = "Ch\225\186\161m v\195\160o l\225\187\173a tr\225\186\161i b\225\186\161n \196\145\195\163 t\195\172m th\225\186\165y \196\145\225\187\131 di chuy\225\187\131n \196\145\225\186\191n \196\145\195\179.",
		["Click a bonfire you\'ve found to travel there."] = "Nh\225\186\165p v\195\160o l\225\187\173a tr\225\186\161i b\225\186\161n \196\145\195\163 t\195\172m th\225\186\165y \196\145\225\187\131 di chuy\225\187\131n \196\145\225\186\191n \196\145\195\179.",
		["Bonfire found: {name}"] = "\196\144\195\163 t\195\172m th\225\186\165y l\225\187\173a tr\225\186\161i: {name}",
		["Rested at {name}. You\'ll start here when you next play."] = "\196\144\195\163 ngh\225\187\137 t\225\186\161i {name}. L\225\186\167n ch\198\161i t\225\187\155i b\225\186\161n s\225\186\189 b\225\186\175t \196\145\225\186\167u \225\187\159 \196\145\195\162y.",
		["You haven\'t found that bonfire yet."] = "B\225\186\161n ch\198\176a t\195\172m th\225\186\165y l\225\187\173a tr\225\186\161i \196\145\195\179.",
		["{upgrade}.  {look}"] = "{upgrade}.  {look}",
		["REFORGE"] = "R\195\136N L\225\186\160I",
		["Forge your next upgrade, or reforge your blade to a rank you\'ve already forged."] = "R\195\168n n\195\162ng c\225\186\165p ti\225\186\191p theo, ho\225\186\183c r\195\168n l\225\186\161i ki\225\186\191m v\225\187\129 m\225\187\153t b\225\186\173c b\225\186\161n \196\145\195\163 r\195\168n.",
		["FORGE RANK {rank}   {name}"] = "R\195\136N B\225\186\172C {rank}   {name}",
		["unlocks at level {level} (you\'re level {yours})"] = "m\225\187\159 kh\195\179a \225\187\159 c\225\186\165p {level} (b\225\186\161n \196\145ang \225\187\159 c\225\186\165p {yours})",
		["RANK {rank}   {name}   (in use)"] = "B\225\186\172C {rank}   {name}   (\196\145ang d\195\185ng)",
		["Dark blade, crimson edge, red lightning, a glow that flares as it drinks."] = "L\198\176\225\187\161i ki\225\186\191m s\225\186\171m, l\198\176\225\187\161i s\225\186\175c \196\145\225\187\143 th\225\186\171m, tia s\195\169t \196\145\225\187\143, \195\161nh s\195\161ng b\195\185ng l\195\170n khi u\225\187\145ng m\195\161u.",
		["FIND IT"] = "T\195\140M N\195\147",
		["{short} Find it in the rooms of the temple on the hill."] = "{short} H\195\163y t\195\172m n\195\179 trong c\195\161c c\196\131n ph\195\178ng c\225\187\167a ng\195\180i \196\145\225\187\129n tr\195\170n \196\145\225\187\147i.",
		["Blade length 3.2 studs"] = "L\198\176\225\187\161i ki\225\186\191m d\195\160i 3.2 studs",
		["Blade length 3.4 studs, draw styles (coming soon)"] = "L\198\176\225\187\161i ki\225\186\191m d\195\160i 3.4 studs, ki\225\187\131u r\195\186t ki\225\186\191m (s\225\186\175p c\195\179)",
		["+5% walk speed"] = "+5% t\225\187\145c \196\145\225\187\153 \196\145i",
		["+5% walk speed, 25% faster poise recovery"] = "+5% t\225\187\145c \196\145\225\187\153 \196\145i, h\225\187\147i \196\145\225\187\153 v\225\187\175ng nhanh h\198\161n 25%",
		["After {delay} seconds of calm it comes back, {regen} a second: faster with a still guard (L2 on a gamepad), slower with little blood.\n\nBelow half, your feet slow down. The lower it is, the heavier your blade and the more easily it\'s knocked aside."] = "Sau {delay} gi\195\162y y\195\170n \225\187\149n, \196\145\225\187\153 v\225\187\175ng h\225\187\147i l\225\186\161i {regen} m\225\187\151i gi\195\162y: nhanh h\198\161n khi gi\225\187\175 th\225\186\191 th\225\187\167 \196\145\225\187\169ng y\195\170n (L2 tr\195\170n tay c\225\186\167m ch\198\161i game), ch\225\186\173m h\198\161n khi c\195\178n \195\173t m\195\161u.\n\nD\198\176\225\187\155i m\225\187\153t n\225\187\173a, ch\195\162n b\225\186\161n ch\225\186\173m l\225\186\161i. C\195\160ng th\225\186\165p, ki\225\186\191m c\195\160ng n\225\186\183ng v\195\160 c\195\160ng d\225\187\133 b\225\187\139 \196\145\195\161nh b\225\186\173t.",
		["<b>Wiping resets your poise.</b> While the cloth is on the blade, poise comes back {times} times as fast, and a finished wipe fills it to full.\n\nIt works after a break too: finishing a wipe ends being weakened.\n\nA finished wipe also gives back all your dashes."] = "<b>Lau ki\225\186\191m h\225\187\147i l\225\186\161i \196\145\225\187\153 v\225\187\175ng.</b> Khi v\225\186\163i \196\145ang tr\195\170n l\198\176\225\187\161i ki\225\186\191m, \196\145\225\187\153 v\225\187\175ng h\225\187\147i nhanh g\225\186\165p {times} l\225\186\167n, v\195\160 lau xong s\225\186\189 l\195\160m \196\145\225\186\167y ho\195\160n to\195\160n.\n\nC\195\161ch n\195\160y c\197\169ng hi\225\187\135u qu\225\186\163 sau khi v\225\187\161: lau xong l\195\160 h\225\186\191t suy y\225\186\191u.\n\nLau xong ki\225\186\191m c\197\169ng h\225\187\147i l\225\186\161i to\195\160n b\225\187\153 l\198\176\225\187\163t l\198\176\225\187\155t.",
		["tap WIPE to refill dashes"] = "ch\225\186\161m LAU KI\225\186\190M \196\145\225\187\131 h\225\187\147i l\198\176\225\187\163t l\198\176\225\187\155t",
		["{key}  wipe to refill dashes"] = "{key}  lau ki\225\186\191m \196\145\225\187\131 h\225\187\147i l\198\176\225\187\163t l\198\176\225\187\155t",
		["Out of dashes. Tap **WIPE** to wipe your blade and get them back."] = "H\225\186\191t l\198\176\225\187\163t l\198\176\225\187\155t. Ch\225\186\161m **LAU KI\225\186\190M** \196\145\225\187\131 lau ki\225\186\191m v\195\160 h\225\187\147i l\225\186\161i.",
		["Out of dashes. Press **{Wipe}** to wipe your blade and get them back."] = "H\225\186\191t l\198\176\225\187\163t l\198\176\225\187\155t. Nh\225\186\165n **{Wipe}** \196\145\225\187\131 lau ki\225\186\191m v\195\160 h\225\187\147i l\225\186\161i.",
		["+1% walk speed"] = "+1% t\225\187\145c \196\145\225\187\153 \196\145i",
		["10% less poise lost to hits and clashes"] = "M\225\186\165t \195\173t h\198\161n 10% \196\145\225\187\153 v\225\187\175ng khi tr\195\186ng \196\145\195\178n v\195\160 va ch\225\186\161m ki\225\186\191m",
		["10% less poise lost to hits and clashes, 15% quicker back from knocks"] = "M\225\186\165t \195\173t h\198\161n 10% \196\145\225\187\153 v\225\187\175ng khi tr\195\186ng \196\145\195\178n v\195\160 va ch\225\186\161m ki\225\186\191m, h\225\187\147i ph\225\187\165c sau khi b\225\187\139 \196\145\195\161nh b\225\186\173t nhanh h\198\161n 15%",
		["+1% walk speed, 25% faster poise recovery"] = "+1% t\225\187\145c \196\145\225\187\153 \196\145i, h\225\187\147i \196\145\225\187\153 v\225\187\175ng nhanh h\198\161n 25%",
		["+20 blood"] = "+20 m\195\161u",
		["UPGRADE READY"] = "S\225\186\180N S\195\128NG N\195\130NG C\225\186\164P",
		["the forge"] = "l\195\178 r\195\168n",
		["New look"] = "Di\225\187\135n m\225\186\161o m\225\187\155i",
		["Draw styles (coming soon)"] = "Ki\225\187\131u r\195\186t ki\225\186\191m (s\225\186\175p c\195\179)",
		["SINGLE"] = "\196\144\198\160N KI\225\186\190M",
		["DUAL WIELD"] = "SONG KI\225\186\190M",
		["IAI"] = "IAI",
		["Robux spins aren\'t sold on your account. Ry\197\141 and levels still give them."] = "T\195\160i kho\225\186\163n c\225\187\167a b\225\186\161n kh\195\180ng mua \196\145\198\176\225\187\163c l\198\176\225\187\163t quay b\225\186\177ng Robux. B\225\186\161n v\225\186\171n nh\225\186\173n \196\145\198\176\225\187\163c ch\195\186ng t\225\187\171 ry\197\141 v\195\160 khi l\195\170n c\225\186\165p.",
		["Beginners\' ring: under level {level} only"] = "V\195\181 \196\145\195\160i t\195\162n th\225\187\167: ch\225\187\137 d\195\160nh cho d\198\176\225\187\155i c\225\186\165p {level}"
	}
}
