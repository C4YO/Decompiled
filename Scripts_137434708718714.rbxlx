		["PRESS {Equip}"] = "\208\157\208\144\208\150\208\156\208\152 {Equip}",
		["Tap **SHEATHE** to sheathe the blade. Every draw starts from the sheath."] = "\208\157\208\176\208\182\208\188\208\184 **\208\146 \208\157\208\158\208\150\208\157\208\171**, \209\135\209\130\208\190\208\177\209\139 \209\131\208\177\209\128\208\176\209\130\209\140 \208\186\208\187\208\184\208\189\208\190\208\186. \208\154\208\176\208\182\208\180\209\139\208\185 \208\178\209\139\209\133\208\178\208\176\209\130 \208\189\208\176\209\135\208\184\208\189\208\176\208\181\209\130\209\129\209\143 \208\184\208\183 \208\189\208\190\208\182\208\181\208\189.",
