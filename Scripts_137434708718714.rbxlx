		["Path of the Sword: {chapter} done. Chapter {number}, {next}, begins."] = "Jalan Pedang: {chapter} selesai. Bab {number}, {next}, dimulai.",
		["Path of the Sword: done. You walked it to the end."] = "Jalan Pedang: selesai. Kamu menempuhnya sampai akhir.",
		["You can\'t go peaceful so soon after a fight."] = "Kamu tidak bisa masuk mode damai secepat ini setelah bertarung.",
		["You can go peaceful again in {time}."] = "Kamu bisa masuk mode damai lagi dalam {time}.",
		["PvP off in the forest. PvP still on in the rings."] = "PvP nonaktif di hutan. PvP tetap aktif di ring.",
		["PvP is back on."] = "PvP aktif lagi.",
		["Couldn\'t load your data. Please rejoin."] = "Gagal memuat datamu. Silakan masuk ulang.",
		["Your data was opened on another server. Please rejoin."] = "Datamu dibuka di server lain. Silakan masuk ulang.",
		["{event}: {quest}"] = "{event}: {quest}",
		["Unknown tab."] = "Tab tidak dikenal.",
		["That isn\'t one of today\'s quests."] = "Itu bukan misi hari ini.",
		["Already done today."] = "Sudah selesai hari ini.",
		["You can work on {count} at a time: drop one first."] = "Kamu bisa mengerjakan {count} sekaligus: batalkan satu dulu.",
		["Not in a boss fight."] = "Tidak bisa saat melawan bos.",
		["Needs both hands."] = "Perlu kedua tangan.",
		["Not during a fight."] = "Tidak bisa saat bertarung.",
		["That can\'t be bought with ry\197\141."] = "Itu tidak bisa dibeli dengan ry\197\141.",
		["Already owned."] = "Sudah dimiliki.",
		["Unknown pack."] = "Paket tidak dikenal.",
		["1 rename spin"] = "1 spin nama",
		["{count} rename spins"] = "{count} spin nama",
		["Kill streak lost: safe zone"] = "Kill streak hilang: zona aman",
		["Kicked, not sliced: it\'s back on its stand."] = "Disepak, bukan ditebas: semangkanya kembali ke penyangga.",
		["A stab only marks it. **Swing** through it to slice it."] = "Tusukan hanya menandainya. **Ayunkan** pedang menembusnya untuk menebasnya.",
		["Too slow, or hit with the flat. Swing faster, edge first."] = "Terlalu lambat, atau kena sisi datar. Ayun lebih cepat, sisi tajam di depan.",
		["{was}. Press **{Equip}** to sheathe, then {how}."] = "{was}. Tekan **{Equip}** untuk menyarungkan, lalu {how}.",
		["{was}. Tap **SHEATHE**, then {how}."] = "{was}. Ketuk **SARUNG**, lalu {how}.",
		["Not a dash attack. Hold **W + A** and press **{Dash}** while passing it."] = "Bukan serangan dash. Tahan **W + A** dan tekan **{Dash}** saat melewatinya.",
		["Not a dash attack. Tap **DASH** while walking past it."] = "Bukan serangan dash. Ketuk **DASH** saat berjalan melewatinya.",
		["A new watermelon is on the stand."] = "Ada semangka baru di penyangga.",
		["Still loading: try again in a moment."] = "Masih memuat: coba lagi sebentar.",
		["Not during a 1v1."] = "Tidak bisa saat 1v1.",
		["Not straight after a fight: wait a few seconds."] = "Tidak bisa langsung setelah bertarung: tunggu beberapa detik.",
		["Not with a missing limb."] = "Tidak bisa saat ada anggota tubuh yang putus.",
		["The dojo is full: try again soon."] = "Dojo penuh: coba lagi nanti.",
		["HEAD"] = "KEPALA",
		["TORSO"] = "BADAN",
		["LEFT ARM"] = "LENGAN KIRI",
		["RIGHT ARM"] = "LENGAN KANAN",
		["LEFT LEG"] = "KAKI KIRI",
		["RIGHT LEG"] = "KAKI KANAN",
		["THE ARENA"] = "ARENA",
		["THE CHERRY GROVE"] = "HUTAN SAKURA",
		["THE BAMBOO SHRINE"] = "KUIL BAMBU",
		["THE FOG GATE"] = "GERBANG KABUT",
		["THE NORTH WOOD"] = "HUTAN UTARA",
		["THE TEMPLE"] = "KUIL",
		["THE FOOT OF THE HILL"] = "KAKI BUKIT",
		["THE RIVER BRIDGE"] = "JEMBATAN SUNGAI",
		["THE RUINED OUTSKIRTS"] = "PINGGIRAN YANG HANCUR",
		["THE MOUNTAIN\'S FOOT"] = "KAKI GUNUNG",
		["THE SOUTH WOOD"] = "HUTAN SELATAN",
		["Pumpkin Samurai"] = "Samurai Labu",
		["Take hold of the sword, or sheathe it."] = "Pegang pedang, atau sarungkan.",
		["Unequip the sword (sheathes it first)."] = "Lepas pedang (disarungkan dulu).",
		["Hold, swipe to draw. Blade out: thrust."] = "Tahan, geser: cabut. Pedang tercabut: tusuk.",
		["Hip swap: draw from the other hip."] = "Pindah pinggang: mencabut dari sisi lain.",
		["Lock on to who you\'re looking at, or off."] = "Kunci target yang kamu lihat, atau matikan.",
		["Cycle lock on target."] = "Ganti target yang dikunci.",
		["Kick: knock back, send limbs flying."] = "Sepak: dorong mundur, lempar anggota tubuh.",
		["Dash."] = "Dash.",
		["Front view: watch your own draws."] = "Tampak depan: lihat cabutanmu sendiri.",
		["Bow to who you\'re locked onto: both bow, a 1v1."] = "Beri hormat ke target: saling hormat, 1v1.",
		["Battle music: next track."] = "Musik pertarungan: lagu berikutnya.",
		["Battle music: the last track."] = "Musik pertarungan: lagu sebelumnya.",
		["In the dojo: skip to the arena."] = "Di dojo: langsung ke arena.",
		["Hide the UI for clean shots. Again: show it."] = "Sembunyikan UI untuk rekaman. Lagi: tampil.",
		["Shamisen: take it out or put it away."] = "Shamisen: keluarkan atau simpan.",
		["left click"] = "klik kiri",
		["right click"] = "klik kanan",
		["middle click"] = "klik tengah",
		["RIGHT SHIFT"] = "SHIFT KANAN",
		["RIGHT CTRL"] = "CTRL KANAN",
		["RIGHT ALT"] = "ALT KANAN",
		["Talk"] = "Bicara",
		["TRAVELLING MERCHANT"] = "PEDAGANG KELILING",
		["Ah, a traveller. You\'ll forgive me if I don\'t get up."] = "Ah, seorang pengembara. Maafkan aku kalau tidak berdiri.",
		["Three nights ago my horses caught wind of something up at that temple."] = "Tiga malam lalu, kuda-kudaku mencium sesuatu di kuil di atas sana.",
		["They screamed, broke their harness and bolted into the trees. I haven\'t seen them since."] = "Mereka meringkik, memutus tali kekang, lalu kabur ke hutan. Aku belum melihat mereka lagi sejak itu.",
		["So here I am, stranded with a wagon full of wax."] = "Jadi di sinilah aku, terdampar dengan gerobak penuh lilin.",
		["There\'s something wrong with that temple, I\'d stay away if I were you, especially at night."] = "Ada yang tidak beres dengan kuil itu. Kalau aku jadi kau, aku akan menjauh, terutama di malam hari.",
		["Here, take some wax. It might be useful to give your blade some extra shine. Be careful around a flame though, this stuff can catch alight in the blink of an eye!"] = "Ini, ambil sedikit lilin. Mungkin berguna untuk memberi pedangmu kilau lebih. Tapi hati-hati di dekat api, benda ini bisa terbakar dalam sekejap mata!",
		["Still here? So am I."] = "Masih di sini? Aku juga.",
		["And keep away from that temple at night."] = "Dan jauhi kuil itu di malam hari.",
		["KATANA: SINGLE"] = "KATANA: TUNGGAL",
		["One katana at the left hip."] = "Satu katana di pinggang kiri.",
		["A katana at each hip, drawn together, one in each hand."] = "Satu katana di tiap pinggang, dicabut bersamaan, satu di tiap tangan.",
		["A katana at each hip, one in each hand."] = "Satu katana di tiap pinggang, satu di tiap tangan.",
		["KATANA: IAI"] = "KATANA: IAI",
		["Draw-cuts only. High risk, high reward: cuts through blades, but a miss can be parried. Longer dash, faster draw. On a kill: poise back and a faster sheathe."] = "Hanya tebasan cabut. Risiko tinggi, hadiah besar: menembus pedang, tapi jika meleset bisa ditangkis. Dash lebih jauh, mencabut lebih cepat. Saat kill: kuda-kuda kembali dan menyarungkan lebih cepat.",
		["The older, longer sword, slung edge down at your hip. Slower and heavier than the katana: its hits take more poise and bleed more."] = "Pedang yang lebih tua dan lebih panjang, digantung dengan mata menghadap ke bawah di pinggang. Lebih lambat dan lebih berat dari katana: serangannya menguras lebih banyak kuda-kuda dan membuat lebih banyak pendarahan.",
		["Longer and heavier than the katana: slower, but its hits take more poise and bleed more."] = "Lebih panjang dan lebih berat dari katana: lebih lambat, tetapi serangannya menguras lebih banyak kuda-kuda dan membuat lebih banyak pendarahan.",
		["Crimson rime. A keening at vespers. Kindled steel unsheathes me."] = "Embun beku merah tua. Ratapan saat doa senja. Baja yang menyala menghunusku.",
		["+2.5% walk speed"] = "+2,5% kecepatan jalan",
		["Mirror polish, wavy temper line, clean bandages."] = "Kilap cermin, garis tempa bergelombang, perban bersih.",
		["Store 2 dashes"] = "Simpan 2 dash",
		["Black cord, gold collar, lacquered sheath."] = "Tali hitam, cincin emas, sarung berpernis.",
		["Blade length 2.9 studs"] = "Panjang bilah 2.9 studs",
		["A groove down each side, red cord on the sheath."] = "Alur di tiap sisi, tali merah di sarung.",
		["Dark forged steel, black sheath."] = "Baja tempa gelap, sarung hitam.",
		["Quick wipe: both sides at once"] = "Lap cepat: dua sisi sekaligus",
		["Gold guard, collar and pommel."] = "Pelindung tangan, cincin, dan kepala gagang emas.",
		["Blade length 3.0 studs"] = "Panjang bilah 3.0 studs",
		["Gleaming silver, crescent-moon guard, white cord and sheath."] = "Perak berkilau, pelindung tangan bulan sabit, tali dan sarung putih.",
		["Store 3 dashes"] = "Simpan 3 dash",
		["White metal fittings."] = "Hiasan logam putih.",
		["+2.5% walk speed, 25% faster poise recovery"] = "+2,5% kecepatan jalan, pemulihan kuda-kuda 25% lebih cepat",
		["Red cord, cherry-blossom ornaments, black tassel, red sheath with metal bands."] = "Tali merah, hiasan bunga sakura, rumbai hitam, sarung merah dengan cincin logam.",
		["Blade length 3.1 studs, draw styles (coming soon)"] = "Panjang bilah 3.1 studs, gaya cabut (segera hadir)",
		["Pale gold fittings, four-lobed guard, faint red glow on the edge."] = "Hiasan emas pucat, pelindung tangan empat kelopak, cahaya merah samar di sisi tajam.",
		["Each hit that draws blood: +5 blood, +6 poise"] = "Setiap serangan yang mengeluarkan darah: +5 darah, +6 kuda-kuda",
