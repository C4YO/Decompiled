		["A second katana at your right hip: draw both at once and fight with one in each hand."] = "Katana kedua di pinggang kananmu: cabut keduanya sekaligus dan bertarung dengan satu di tiap tangan.",
		["Iai"] = "Iai",
		["Draw-cuts only. Cuts through blades, but a miss can be parried. 1.5x dash, 1.6x draw speed."] = "Hanya tebasan cabut. Menembus pedang, tapi jika meleset bisa ditangkis. Dash 1.5x, mencabut 1.6x lebih cepat.",
		["Shamisen"] = "Shamisen",
		["A playable three-string shamisen. Pluck with the mouse or a finger; 9 keys or pads set the notes. Heard by nearby players."] = "Shamisen tiga senar yang bisa dimainkan. Petik dengan mouse atau jari; 9 tombol atau pad menentukan nada. Terdengar oleh pemain di dekatnya.",
		["ANYONE"] = "SIAPA SAJA",
		["PLAYERS"] = "PEMAIN",
		["OVER RIGHT SHOULDER"] = "DI ATAS BAHU KANAN",
		["WIDE RIGHT SHOULDER"] = "BAHU KANAN LEBAR",
		["OVER LEFT SHOULDER"] = "DI ATAS BAHU KIRI",
		["WIDE LEFT SHOULDER"] = "BAHU KIRI LEBAR",
		["ABOVE HEAD"] = "DI ATAS KEPALA",
		["BEHIND"] = "BELAKANG",
		["FAR BEHIND"] = "JAUH DI BELAKANG",
		["CUSTOM 1"] = "KUSTOM 1",
		["CUSTOM 2"] = "KUSTOM 2",
		["CUSTOM 3"] = "KUSTOM 3",
		["BACKWARDS"] = "MUNDUR",
		["FORWARDS"] = "MAJU",
		["HOLD {Draw}"] = "TAHAN {Draw}",
		["Walk onto the mat"] = "Jalan ke atas tikar",
		["Walk onto the straw mat with **WASD**."] = "Jalan ke atas tikar jerami dengan **WASD**.",
		["WALK ONTO THE MAT"] = "JALAN KE ATAS TIKAR",
		["Walk onto the straw mat with the **thumbstick**."] = "Jalan ke atas tikar jerami dengan **joystick**.",
		["Horizontal slice"] = "Tebasan horizontal",
		["Walk up close. Move the mouse **left**. Then **hold {Draw}** and **swipe right**."] = "Jalan mendekat. Gerakkan mouse ke **kiri**. Lalu **tahan {Draw}** dan **geser ke kanan**.",
		["MOVE LEFT"] = "GERAK KE KIRI",
		["SWIPE RIGHT"] = "GESER KE KANAN",
		["Walk up close. Then **flick right** on the right side of the screen."] = "Jalan mendekat. Lalu **geser cepat ke kanan** di sisi kanan layar.",
		["Sheathe the sword"] = "Sarungkan pedang",
		["Press **{Equip}** to sheathe the blade. Every draw starts from the sheath."] = "Tekan **{Equip}** untuk menyarungkan pedang. Setiap cabutan dimulai dari sarung.",
		["PRESS {Equip}"] = "TEKAN {Equip}",
		["Tap **SHEATHE** to sheathe the blade. Every draw starts from the sheath."] = "Ketuk **SARUNG** untuk menyarungkan pedang. Setiap cabutan dimulai dari sarung.",
		["TAP SHEATHE"] = "KETUK SARUNG",
		["Vertical slice"] = "Tebasan vertikal",
		["Walk up close. Move the mouse **up**. Then **hold {Draw}** and **swipe down**."] = "Jalan mendekat. Gerakkan mouse ke **atas**. Lalu **tahan {Draw}** dan **geser ke bawah**.",
		["MOVE UP"] = "GERAK KE ATAS",
		["SWIPE DOWN"] = "GESER KE BAWAH",
		["Walk up close. Then **flick down** on the right side of the screen."] = "Jalan mendekat. Lalu **geser cepat ke bawah** di sisi kanan layar.",
		["FLICK DOWN"] = "GESER CEPAT KE BAWAH",
		["Weakened: wipe the blade"] = "Lemah: lap pedangmu",
		["Poise broken: **weakened** (slow, no jumping). Press **{Wipe}** to wipe the blade and recover."] = "Kuda-kuda hancur: **lemah** (lambat, tidak bisa lompat). Tekan **{Wipe}** untuk mengelap pedang dan pulih.",
		["PRESS {Wipe}"] = "TEKAN {Wipe}",
		["Poise broken: **weakened** (slow, no jumping). Tap **WIPE** to wipe the blade and recover."] = "Kuda-kuda hancur: **lemah** (lambat, tidak bisa lompat). Ketuk **LAP** untuk mengelap pedang dan pulih.",
		["TAP WIPE"] = "KETUK LAP",
		["Dash attack"] = "Serangan dash",
		["Blade out, walk up close. Hold **W + A** to walk past the watermelon, then press **{Dash}** to dash through it."] = "Cabut pedang, jalan mendekat. Tahan **W + A** untuk berjalan melewati semangka, lalu tekan **{Dash}** untuk dash menembusnya.",
		["HOLD W + A"] = "TAHAN W + A",
		["PRESS {Dash}"] = "TEKAN {Dash}",
		["Blade out, walk up close. Walk past the watermelon, then tap **DASH** to dash through it."] = "Cabut pedang, jalan mendekat. Jalan melewati semangka, lalu ketuk **DASH** untuk dash menembusnya.",
		["WALK PAST IT"] = "JALAN MELEWATINYA",
		["TAP DASH"] = "KETUK DASH",
		["That was the low cut"] = "Itu tadi tebasan bawah",
		["That was the horizontal slice"] = "Itu tadi tebasan horizontal",
		["That was a diagonal cut"] = "Itu tadi tebasan diagonal",
		["That was the vertical slice"] = "Itu tadi tebasan vertikal",
		["That was another draw"] = "Itu tadi cabutan lain",
		["That was a swing"] = "Itu tadi ayunan",
		["move the mouse **left**, then **hold {Draw}** and **swipe right**"] = "gerakkan mouse ke **kiri**, lalu **tahan {Draw}** dan **geser ke kanan**",
		["move the mouse **up**, then **hold {Draw}** and **swipe down**"] = "gerakkan mouse ke **atas**, lalu **tahan {Draw}** dan **geser ke bawah**",
		["draw again"] = "cabut lagi",
		["**flick right** on the right side of the screen"] = "**geser cepat ke kanan** di sisi kanan layar",
		["**flick down** on the right side of the screen"] = "**geser cepat ke bawah** di sisi kanan layar",
		["Rusted, the cord rotten"] = "Berkarat, talinya lapuk",
		["Rust polished away"] = "Karat dipoles habis",
		["Black silk on the handle and cords"] = "Sutra hitam di gagang dan tali",
		["Bright silver fittings"] = "Hiasan perak berkilau",
		["Black lacquered sheath"] = "Sarung berpernis hitam",
		["Temper line polished, purple silk"] = "Garis tempa dipoles, sutra ungu",
		["Best of 5: the first to {wins} round wins."] = "Best of 5: yang pertama menang {wins} ronde jadi pemenang.",
		["Every attack is a draw-cut that strikes through any blade. No guard."] = "Setiap serangan adalah tebasan cabut yang menembus pedang apa pun. Tanpa bertahan.",
		["Fight from the sheath: every draw-cut strikes through any blade, and the blade goes straight back in."] = "Bertarung dari sarung: setiap tebasan cabut menembus pedang apa pun, dan pedang langsung kembali ke sarung.",
		["10 rename spins"] = "10 spin nama",
		["50 rename spins"] = "50 spin nama",
		["Each column is a string: hold a key, then pluck that string."] = "Setiap kolom adalah satu senar: tahan sebuah tombol, lalu petik senar itu.",
		["TACHI restored: stage {stage}, {name}"] = "TACHI dipulihkan: tahap {stage}, {name}",
		["You can only bow for a 1v1 with someone you could fight right now, in the same ring."] = "Kamu hanya bisa memberi hormat untuk 1v1 kepada orang yang bisa kamu lawan sekarang, di ring yang sama.",
		["The rematch can\'t start: you both need to be in the same ring."] = "Rematch tidak bisa dimulai: kalian berdua harus di ring yang sama.",
		["Positions 1 to 9: hold one, then pluck."] = "Posisi 1 sampai 9: tahan satu, lalu petik.",
		["Finish a daily quest"] = "Selesaikan satu misi harian",
		["VENGEFUL EMPRESS"] = "MAHARANI PENDENDAM",
		["THE TEMPLE GHOST"] = "HANTU KUIL",
		["Reroll your first name as often as you like, or spin a new family name ({count} spin)."] = "Acak ulang nama depanmu sesukamu, atau spin nama keluarga baru ({count} spin).",
		["Reroll your first name as often as you like, or spin a new family name ({count} spins)."] = "Acak ulang nama depanmu sesukamu, atau spin nama keluarga baru ({count} spin).",
		["Reroll your first name as often as you like."] = "Acak ulang nama depanmu sesukamu.",
		["REROLL FIRST NAME"] = "ACAK ULANG NAMA DEPAN",
		["Couldn\'t roll. Try again."] = "Gagal mengacak. Coba lagi.",
		["REROLL"] = "ACAK ULANG",
		["Roll a first name first."] = "Acak nama depan dulu.",
		["RARER THAN YOURS"] = "LEBIH LANGKA DARIMU",
		["LEGENDARY AND UP"] = "LEGENDARIS KE ATAS",
		["ASK TWICE FOR EXOTIC"] = "EKSOTIS: TANYA 2 KALI",
		["{on} OF {all}"] = "{on} DARI {all}",
		["Asks before a spin throws away a family name."] = "Bertanya sebelum spin membuang nama keluarga.",
		["You\'ll lose {names} and {count} more."] = "Kamu akan kehilangan {names} dan {count} lainnya.",
		["You\'ll lose {names}."] = "Kamu akan kehilangan {names}.",
		["Are you sure?"] = "Kamu yakin?",
		["{names} will be gone for good."] = "{names} akan hilang selamanya.",
		["Peaceful: out in the forest nobody can hurt you, and you can\'t hurt anyone. In the rings you fight as usual."] = "Damai: di hutan tidak ada yang bisa melukaimu, dan kamu tidak bisa melukai siapa pun. Di ring kamu bertarung seperti biasa.",
		["Peaceful: nobody can hurt you, and you can\'t hurt anyone. In the beginners\' ring and the boss arena you fight as usual."] = "Damai: tidak ada yang bisa melukaimu, dan kamu tidak bisa melukai siapa pun. Di ring pemula dan arena bos kamu bertarung seperti biasa.",
		["BONFIRE"] = "API UNGGUN",
		["LAST LOCATION"] = "LOKASI TERAKHIR",
		["Outside the ring: sword lowered"] = "Di luar ring: pedang diturunkan",
		["Outside the ring: sword sheathed"] = "Di luar ring: pedang disarungkan",
		["Find bonfires out in the world to travel between them."] = "Temukan api unggun di seluruh dunia untuk berpindah di antaranya.",
		["Tap a bonfire you\'ve found to travel there."] = "Ketuk api unggun yang sudah kamu temukan untuk pergi ke sana.",
		["Click a bonfire you\'ve found to travel there."] = "Klik api unggun yang sudah kamu temukan untuk pergi ke sana.",
		["Bonfire found: {name}"] = "Api unggun ditemukan: {name}",
		["Rested at {name}. You\'ll start here when you next play."] = "Istirahat di {name}. Kamu akan mulai di sini saat main lagi.",
		["You haven\'t found that bonfire yet."] = "Kamu belum menemukan api unggun itu.",
		["{upgrade}.  {look}"] = "{upgrade}.  {look}",
		["REFORGE"] = "TEMPA ULANG",
		["Forge your next upgrade, or reforge your blade to a rank you\'ve already forged."] = "Tempa upgrade berikutnya, atau tempa ulang pedangmu ke tingkat yang sudah kamu tempa.",
		["FORGE RANK {rank}   {name}"] = "TEMPA TINGKAT {rank}   {name}",
		["unlocks at level {level} (you\'re level {yours})"] = "terbuka di level {level} (kamu level {yours})",
		["RANK {rank}   {name}   (in use)"] = "TINGKAT {rank}   {name}   (dipakai)",
		["Dark blade, crimson edge, red lightning, a glow that flares as it drinks."] = "Bilah gelap, sisi tajam merah darah, petir merah, cahaya yang berkobar saat meminum darah.",
		["FIND IT"] = "TEMUKAN",
		["{short} Find it in the rooms of the temple on the hill."] = "{short} Temukan di ruangan-ruangan kuil di atas bukit.",
		["Blade length 3.2 studs"] = "Panjang bilah 3.2 studs",
		["Blade length 3.4 studs, draw styles (coming soon)"] = "Panjang bilah 3.4 studs, gaya cabut (segera hadir)",
		["+5% walk speed"] = "+5% kecepatan jalan",
		["+5% walk speed, 25% faster poise recovery"] = "+5% kecepatan jalan, pemulihan kuda-kuda 25% lebih cepat",
		["After {delay} seconds of calm it comes back, {regen} a second: faster with a still guard (L2 on a gamepad), slower with little blood.\n\nBelow half, your feet slow down. The lower it is, the heavier your blade and the more easily it\'s knocked aside."] = "Setelah {delay} detik tenang, kuda-kuda pulih {regen} per detik: lebih cepat dengan posisi bertahan diam (L2 di gamepad), lebih lambat kalau darahmu sedikit.\n\nDi bawah setengah, kakimu melambat. Makin rendah, makin berat pedangmu dan makin mudah terpental.",
		["<b>Wiping resets your poise.</b> While the cloth is on the blade, poise comes back {times} times as fast, and a finished wipe fills it to full.\n\nIt works after a break too: finishing a wipe ends being weakened.\n\nA finished wipe also gives back all your dashes."] = "<b>Mengelap memulihkan kuda-kudamu.</b> Selama kain ada di pedang, kuda-kuda pulih {times} kali lebih cepat, dan lap yang selesai mengisinya sampai penuh.\n\nIni juga berlaku setelah kuda-kuda hancur: menyelesaikan lap mengakhiri kondisi lemah.\n\nLap yang selesai juga mengembalikan semua dash-mu.",
		["tap WIPE to refill dashes"] = "ketuk LAP untuk mengisi dash",
		["{key}  wipe to refill dashes"] = "{key}  lap pedang untuk mengisi dash",
		["Out of dashes. Tap **WIPE** to wipe your blade and get them back."] = "Dash habis. Ketuk **LAP** untuk mengelap pedangmu dan mengisinya lagi.",
		["Out of dashes. Press **{Wipe}** to wipe your blade and get them back."] = "Dash habis. Tekan **{Wipe}** untuk mengelap pedangmu dan mengisinya lagi.",
		["+1% walk speed"] = "+1% kecepatan jalan",
		["10% less poise lost to hits and clashes"] = "Kuda-kuda berkurang 10% lebih sedikit saat terkena serangan dan benturan",
		["10% less poise lost to hits and clashes, 15% quicker back from knocks"] = "Kuda-kuda berkurang 10% lebih sedikit saat terkena serangan dan benturan, pulih dari pentalan 15% lebih cepat",
		["+1% walk speed, 25% faster poise recovery"] = "+1% kecepatan jalan, pemulihan kuda-kuda 25% lebih cepat",
		["+20 blood"] = "+20 darah",
		["UPGRADE READY"] = "UPGRADE SIAP",
		["the forge"] = "tempat tempa",
		["New look"] = "Tampilan baru",
		["Draw styles (coming soon)"] = "Gaya cabut (segera hadir)",
		["SINGLE"] = "TUNGGAL",
		["DUAL WIELD"] = "DUA PEDANG",
		["IAI"] = "IAI",
		["Robux spins aren\'t sold on your account. Ry\197\141 and levels still give them."] = "Spin dengan Robux tidak dijual untuk akunmu. Ry\197\141 dan level tetap memberikannya.",
		["Beginners\' ring: under level {level} only"] = "Ring pemula: hanya di bawah level {level}"
	}
}
return v1]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX154">
            <Properties>
              <string name="Name">Japanese</string>
              <ProtectedString name="Source"><![CDATA[local v1 = {
	["Name"] = "\230\151\165\230\156\172\232\170\158",
	["Locales"] = nil,
	["Lines"] = nil,
	["Locales"] = { "ja-jp", "ja" },
	["Lines"] = {
		["1 free rename spin"] = "\231\132\161\230\150\153\230\148\185\229\144\141\227\130\172\227\131\129\227\131\1631\229\155\158",
		["{count} free rename spins"] = "\231\132\161\230\150\153\230\148\185\229\144\141\227\130\172\227\131\129\227\131\163{count}\229\155\158",
		["{xp} XP"] = "{xp} XP",
		["{scale}x XP for {minutes} minutes"] = "{minutes}\229\136\134\233\150\147XP{scale}\229\128\141",
		["OPENED"] = "\233\150\139\229\176\129\230\184\136\227\129\191",
		["MISSED"] = "\233\128\131\227\129\151\227\129\159",
		["A door opens each day from 1 to 25 December while playing. Missed doors stay shut."] = "12\230\156\1361\230\151\165\227\129\139\227\130\13725\230\151\165\227\129\190\227\129\167\227\128\129\227\131\151\227\131\172\227\130\164\228\184\173\227\129\171\230\175\142\230\151\1651\227\129\164\227\129\174\230\137\137\227\129\140\233\150\139\227\129\143\227\128\130\233\128\131\227\129\151\227\129\159\230\137\137\227\129\175\233\150\137\227\129\152\227\129\159\227\129\190\227\129\190\227\128\130",
		["BACK"] = "\230\136\187\227\130\139",
		["AIM DOT"] = "\231\133\167\230\186\150\231\130\185",
		["COLOUR"] = "\232\137\178",
		["OUTLINE"] = "\227\130\162\227\130\166\227\131\136\227\131\169\227\130\164\227\131\179",
		["DOT"] = "\227\131\137\227\131\131\227\131\136",
		["BRIGHTNESS"] = "\230\152\142\227\130\139\227\129\149",
		["CUSTOM"] = "\227\130\171\227\130\185\227\130\191\227\131\160",
		["DEFAULT"] = "\227\131\135\227\131\149\227\130\169\227\131\171\227\131\136",
		["ON"] = "\227\130\170\227\131\179",
		["OFF"] = "\227\130\170\227\131\149",
		["Your blade is alight: {hits} hits."] = "\229\136\131\227\129\140\231\135\131\227\129\136\227\129\166\227\129\132\227\130\139\239\188\154\230\174\139\227\130\138{hits}\229\155\158",
		["Your blade\'s flame is out: wipe it again, then light it."] = "\229\136\131\227\129\174\231\130\142\227\129\140\230\182\136\227\129\136\227\129\159\227\128\130\227\130\130\227\129\134\228\184\128\229\186\166\232\161\128\230\140\175\227\130\138\227\130\146\227\129\151\227\129\166\227\128\129\231\129\171\227\130\146\231\129\175\227\129\155\227\128\130",
		["Your blade is waxed: hold it in a fire stand\'s flame."] = "\229\136\131\227\129\171\232\157\139\227\129\140\229\161\151\227\130\137\227\130\140\227\129\159\227\128\130\231\175\157\231\129\171\227\129\174\231\130\142\227\129\171\227\129\139\227\129\150\227\129\155\227\128\130",
		["{count} / {goal}"] = "{count} / {goal}",
		["The mist seals the way out: defeat the boss, or fall."] = "\233\156\167\227\129\140\233\128\128\232\183\175\227\130\146\229\176\129\227\129\152\227\129\159\239\188\154\227\131\156\227\130\185\227\130\146\229\128\146\227\129\153\227\129\139\227\128\129\229\128\146\227\130\140\227\130\139\227\129\139\227\128\130",
		["The seal is broken: the way out is open."] = "\229\176\129\229\141\176\227\129\140\232\167\163\227\129\145\227\129\159\239\188\154\233\128\128\232\183\175\227\129\140\233\150\139\227\129\132\227\129\159\227\128\130",
		["LOCAL"] = "\229\145\168\229\155\178",
		["DM"] = "DM",
		["GLOBAL"] = "\229\133\168\228\189\147",
		["SHOW"] = "\232\161\168\231\164\186",
		["HIDE"] = "\233\157\158\232\161\168\231\164\186",
		["Sending too fast. Wait a moment."] = "\233\128\129\228\191\161\227\129\140\233\128\159\227\129\153\227\129\142\227\129\190\227\129\153\227\128\130\229\176\145\227\129\151\229\190\133\227\129\163\227\129\166\227\129\143\227\129\160\227\129\149\227\129\132\227\128\130",
		["Message not sent."] = "\227\131\161\227\131\131\227\130\187\227\131\188\227\130\184\227\130\146\233\128\129\228\191\161\227\129\167\227\129\141\227\129\190\227\129\155\227\130\147\227\129\167\227\129\151\227\129\159\227\128\130",
		["Can\'t message this player."] = "\227\129\147\227\129\174\227\131\151\227\131\172\227\130\164\227\131\164\227\131\188\227\129\171\227\129\175\227\131\161\227\131\131\227\130\187\227\131\188\227\130\184\227\130\146\233\128\129\227\130\140\227\129\190\227\129\155\227\130\147\227\128\130",
		["Type a message"] = "\227\131\161\227\131\131\227\130\187\227\131\188\227\130\184\227\130\146\229\133\165\229\138\155",
		["{key}   chat"] = "{key}   \227\131\129\227\131\163\227\131\131\227\131\136",
		["No other players in this server."] = "\227\129\147\227\129\174\227\130\181\227\131\188\227\131\144\227\131\188\227\129\171\227\129\175\227\129\187\227\129\139\227\129\174\227\131\151\227\131\172\227\130\164\227\131\164\227\131\188\227\129\140\227\129\132\227\129\190\227\129\155\227\130\147\227\128\130",
		["Type a code and press REDEEM. Each code works once."] = "\227\130\179\227\131\188\227\131\137\227\130\146\229\133\165\229\138\155\227\129\151\227\129\166\227\128\140\229\188\149\227\129\141\230\143\155\227\129\136\227\128\141\227\130\146\230\138\188\227\129\151\227\129\166\227\129\143\227\129\160\227\129\149\227\129\132\227\128\130\229\144\132\227\130\179\227\131\188\227\131\137\227\129\1751\229\155\158\227\129\160\227\129\145\228\189\191\227\129\136\227\129\190\227\129\153\227\128\130",
		["ENTER CODE"] = "\227\130\179\227\131\188\227\131\137\227\130\146\229\133\165\229\138\155",
		["Type a code first."] = "\229\133\136\227\129\171\227\130\179\227\131\188\227\131\137\227\130\146\229\133\165\229\138\155\227\129\151\227\129\166\227\129\143\227\129\160\227\129\149\227\129\132\227\128\130",
		["Checking..."] = "\231\162\186\232\170\141\228\184\173...",
		["No answer from the server. Try again."] = "\227\130\181\227\131\188\227\131\144\227\131\188\227\129\139\227\130\137\229\191\156\231\173\148\227\129\140\227\129\130\227\130\138\227\129\190\227\129\155\227\130\147\227\128\130\227\130\130\227\129\134\228\184\128\229\186\166\227\129\138\232\169\166\227\129\151\227\129\143\227\129\160\227\129\149\227\129\132\227\128\130",
		["Redeemed: {reward}"] = "\229\188\149\227\129\141\230\143\155\227\129\136\227\129\190\227\129\151\227\129\159\239\188\154{reward}",
