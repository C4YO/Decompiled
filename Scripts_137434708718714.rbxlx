        <Item class="ModuleScript" referent="RBX186">
          <Properties>
            <string name="Name">Leveling</string>
            <ProtectedString name="Source"><![CDATA[local v_u_1 = {
	["XP"] = {
		["Wound"] = 8,
		["Sever"] = 25,
		["Kill"] = 100,
		["Assist"] = 50,
		["DummyKill"] = 50,
		["DuelWin"] = 200
	}
}
v_u_1.XP.DummyKillByRarity = {
	["Common"] = 50,
	["Uncommon"] = 55,
	["Rare"] = 60,
	["Epic"] = 70,
	["Legendary"] = 85,
	["Mythic"] = 100,
	["Exotic"] = 150
}
function v_u_1.dummyKillXP(p2) -- name: dummyKillXP
	-- upvalues: (copy) v_u_1
	local v3
	if p2 then
		v3 = v_u_1.XP.DummyKillByRarity[p2]
	else
		v3 = nil
	end
	return v3 or v_u_1.XP.DummyKill
end
v_u_1.KillCredit = 20
v_u_1.SpinsPerLevel = 4
v_u_1.WoundsPerLife = 6
v_u_1.Daily = {
	["Spins"] = 1,
	["StreakSpins"] = 2,
	["StreakFrom"] = 5
}
function v_u_1.dailySpins(p4) -- name: dailySpins
	-- upvalues: (copy) v_u_1
	local v5 = v_u_1.Daily
	if v5.StreakFrom <= p4 then
		return v5.StreakSpins
	else
		return v5.Spins
	end
end
v_u_1.Higher = {
	["Step"] = 0.05,
	["Max"] = 1
}
function v_u_1.need(p6) -- name: need
	local v7 = 1.1 ^ (math.max(p6, 1) - 1) * 300 + 0.5
	return math.floor(v7)
end
function v_u_1.xpScale(p8) -- name: xpScale
	local v9 = 1
	if p8("DoubleXP") then
		v9 = v9 * 2
	end
	if p8("XPBoost") then
		v9 = v9 * 1.5
	end
	return v9
end
