		local v29 = v_u_5.percent(v16.Chance)
		table.insert(v15, v27("<b>%s</b> (%s): %s", v28, v29, v26))
	end
	return table.concat(v15, "\n")
end
local v_u_31 = v13.FetchTime + v13.PassTime * 2 + v13.TurnTime + v13.StowTime
