		["Bow to who you\'re locked onto: both bow, a 1v1."] = "\229\144\145\233\142\150\229\174\154\231\154\132\229\176\141\230\137\139\232\161\140\231\166\174\239\188\154\233\155\153\230\150\185\228\186\146\231\155\184\232\161\140\231\166\174\229\141\179\233\150\139\229\167\1391v1\227\128\130",
