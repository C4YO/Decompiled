		["Support the game"] = "Apoya el juego",
		["2x XP for 30 minutes"] = "2x XP durante 30 minutos",
		["2x XP"] = "2x XP",
		["Doubles all XP earned. Stacks with other XP multipliers and passes."] = "Duplica toda la XP ganada. Se acumula con otros multiplicadores de XP y pases.",
		["1.5x XP"] = "1.5x XP",
		["Multiplies all XP by 1.5. Stacks with other XP multipliers and passes."] = "Multiplica toda la XP por 1.5. Se acumula con otros multiplicadores de XP y pases.",
		["2x Ry\197\141"] = "2x Ry\197\141",
		["Doubles every ry\197\141 gain: kills, quests, rewards and ry\197\141 packs."] = "Duplica cada ganancia de ry\197\141: bajas, misiones, recompensas y paquetes de ry\197\141.",
		["Dual Wield"] = "Dos katanas",
		["A second katana at your right hip: draw both at once and fight with one in each hand."] = "Una segunda katana en la cadera derecha: desenvaina las dos a la vez y lucha con una en cada mano.",
		["Iai"] = "Iai",
		["Draw-cuts only. Cuts through blades, but a miss can be parried. 1.5x dash, 1.6x draw speed."] = "Solo cortes al desenvainar. Atraviesa hojas, pero si falla, se puede parar. Impulso 1.5x, desenvainado 1.6x m\195\161s r\195\161pido.",
		["Shamisen"] = "Shamisen",
		["A playable three-string shamisen. Pluck with the mouse or a finger; 9 keys or pads set the notes. Heard by nearby players."] = "Un shamisen de tres cuerdas para tocar. Puntea con el rat\195\179n o un dedo; 9 teclas o botones fijan las notas. Lo oyen los jugadores cercanos.",
		["ANYONE"] = "CUALQUIERA",
		["PLAYERS"] = "JUGADORES",
		["OVER RIGHT SHOULDER"] = "SOBRE EL HOMBRO DERECHO",
		["WIDE RIGHT SHOULDER"] = "HOMBRO DERECHO ABIERTO",
