		["Poise broken: **weakened** (slow, no jumping). Tap **WIPE** to wipe the blade and recover."] = "\208\161\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140 \209\129\208\187\208\190\208\188\208\187\208\181\208\189\208\176: **\208\190\209\129\208\187\208\176\208\177\208\187\208\181\208\189\208\184\208\181** (\208\188\208\181\208\180\208\187\208\181\208\189\208\189\208\190, \208\177\208\181\208\183 \208\191\209\128\209\139\208\182\208\186\208\190\208\178). \208\157\208\176\208\182\208\188\208\184 **\208\167\208\152\208\161\208\162\208\154\208\144**, \209\135\209\130\208\190\208\177\209\139 \208\191\208\190\209\135\208\184\209\129\209\130\208\184\209\130\209\140 \208\186\208\187\208\184\208\189\208\190\208\186 \208\184 \208\191\209\128\208\184\208\185\209\130\208\184 \208\178 \209\129\208\181\208\177\209\143.",
		["TAP WIPE"] = "\208\157\208\144\208\150\208\156\208\152 \208\167\208\152\208\161\208\162\208\154\208\144",
		["Dash attack"] = "\208\144\209\130\208\176\208\186\208\176 \209\128\209\139\208\178\208\186\208\190\208\188",
		["Blade out, walk up close. Hold **W + A** to walk past the watermelon, then press **{Dash}** to dash through it."] = "\208\161 \208\190\208\177\208\189\208\176\208\182\209\145\208\189\208\189\209\139\208\188 \208\186\208\187\208\184\208\189\208\186\208\190\208\188 \208\191\208\190\208\180\208\190\208\185\208\180\208\184 \208\178\208\191\208\187\208\190\209\130\208\189\209\131\209\142. \208\151\208\176\208\182\208\188\208\184 **W + A**, \209\135\209\130\208\190\208\177\209\139 \208\191\209\128\208\190\208\185\209\130\208\184 \208\188\208\184\208\188\208\190 \208\176\209\128\208\177\209\131\208\183\208\176, \208\183\208\176\209\130\208\181\208\188 \208\189\208\176\208\182\208\188\208\184 **{Dash}**, \209\135\209\130\208\190\208\177\209\139 \208\191\209\128\208\190\209\128\208\178\208\176\209\130\209\140\209\129\209\143 \209\129\208\186\208\178\208\190\208\183\209\140 \208\189\208\181\208\179\208\190 \209\128\209\139\208\178\208\186\208\190\208\188.",
		["HOLD W + A"] = "\208\151\208\144\208\150\208\156\208\152 W + A",
		["PRESS {Dash}"] = "\208\157\208\144\208\150\208\156\208\152 {Dash}",
		["Blade out, walk up close. Walk past the watermelon, then tap **DASH** to dash through it."] = "\208\161 \208\190\208\177\208\189\208\176\208\182\209\145\208\189\208\189\209\139\208\188 \208\186\208\187\208\184\208\189\208\186\208\190\208\188 \208\191\208\190\208\180\208\190\208\185\208\180\208\184 \208\178\208\191\208\187\208\190\209\130\208\189\209\131\209\142. \208\152\208\180\208\184 \208\188\208\184\208\188\208\190 \208\176\209\128\208\177\209\131\208\183\208\176, \208\183\208\176\209\130\208\181\208\188 \208\189\208\176\208\182\208\188\208\184 **\208\160\208\171\208\146\208\158\208\154**, \209\135\209\130\208\190\208\177\209\139 \208\191\209\128\208\190\209\128\208\178\208\176\209\130\209\140\209\129\209\143 \209\129\208\186\208\178\208\190\208\183\209\140 \208\189\208\181\208\179\208\190.",
		["WALK PAST IT"] = "\208\152\208\148\208\152 \208\156\208\152\208\156\208\158",
		["TAP DASH"] = "\208\157\208\144\208\150\208\156\208\152 \208\160\208\171\208\146\208\158\208\154",
		["That was the low cut"] = "\208\173\209\130\208\190 \208\177\209\139\208\187 \208\189\208\184\208\182\208\189\208\184\208\185 \209\131\208\180\208\176\209\128",
		["That was the horizontal slice"] = "\208\173\209\130\208\190 \208\177\209\139\208\187 \208\179\208\190\209\128\208\184\208\183\208\190\208\189\209\130\208\176\208\187\209\140\208\189\209\139\208\185 \209\131\208\180\208\176\209\128",
		["That was a diagonal cut"] = "\208\173\209\130\208\190 \208\177\209\139\208\187 \208\180\208\184\208\176\208\179\208\190\208\189\208\176\208\187\209\140\208\189\209\139\208\185 \209\131\208\180\208\176\209\128",
		["That was the vertical slice"] = "\208\173\209\130\208\190 \208\177\209\139\208\187 \208\178\208\181\209\128\209\130\208\184\208\186\208\176\208\187\209\140\208\189\209\139\208\185 \209\131\208\180\208\176\209\128",
		["That was another draw"] = "\208\173\209\130\208\190 \208\177\209\139\208\187 \208\180\209\128\209\131\208\179\208\190\208\185 \208\178\209\139\209\133\208\178\208\176\209\130",
		["That was a swing"] = "\208\173\209\130\208\190 \208\177\209\139\208\187 \208\178\208\183\208\188\208\176\209\133",
		["move the mouse **left**, then **hold {Draw}** and **swipe right**"] = "\208\178\208\181\208\180\208\184 \208\188\209\139\209\136\209\140 **\208\178\208\187\208\181\208\178\208\190**, \208\183\208\176\209\130\208\181\208\188 **\208\183\208\176\208\182\208\188\208\184 {Draw}** \208\184 **\208\188\208\176\209\133\208\189\208\184 \208\178\208\191\209\128\208\176\208\178\208\190**",
		["move the mouse **up**, then **hold {Draw}** and **swipe down**"] = "\208\178\208\181\208\180\208\184 \208\188\209\139\209\136\209\140 **\208\178\208\178\208\181\209\128\209\133**, \208\183\208\176\209\130\208\181\208\188 **\208\183\208\176\208\182\208\188\208\184 {Draw}** \208\184 **\208\188\208\176\209\133\208\189\208\184 \208\178\208\189\208\184\208\183**",
		["draw again"] = "\208\178\209\139\209\133\208\178\208\176\209\130\208\184 \209\129\208\189\208\190\208\178\208\176",
		["**flick right** on the right side of the screen"] = "\209\129\208\180\208\181\208\187\208\176\208\185 **\209\129\208\178\208\176\208\185\208\191 \208\178\208\191\209\128\208\176\208\178\208\190** \208\189\208\176 \208\191\209\128\208\176\208\178\208\190\208\185 \209\129\209\130\208\190\209\128\208\190\208\189\208\181 \209\141\208\186\209\128\208\176\208\189\208\176",
		["**flick down** on the right side of the screen"] = "\209\129\208\180\208\181\208\187\208\176\208\185 **\209\129\208\178\208\176\208\185\208\191 \208\178\208\189\208\184\208\183** \208\189\208\176 \208\191\209\128\208\176\208\178\208\190\208\185 \209\129\209\130\208\190\209\128\208\190\208\189\208\181 \209\141\208\186\209\128\208\176\208\189\208\176",
		["Rusted, the cord rotten"] = "\208\160\208\182\208\176\208\178\209\139\208\185, \209\136\208\189\209\131\209\128 \209\129\208\179\208\189\208\184\208\187",
		["Rust polished away"] = "\208\160\208\182\208\176\208\178\209\135\208\184\208\189\208\176 \209\129\208\191\208\190\208\187\208\184\209\128\208\190\208\178\208\176\208\189\208\176",
		["Black silk on the handle and cords"] = "\208\167\209\145\209\128\208\189\209\139\208\185 \209\136\209\145\208\187\208\186 \208\189\208\176 \209\128\209\131\208\186\208\190\209\143\209\130\208\184 \208\184 \209\136\208\189\209\131\209\128\208\176\209\133",
		["Bright silver fittings"] = "\208\175\209\128\208\186\208\176\209\143 \209\129\208\181\209\128\208\181\208\177\209\128\209\143\208\189\208\176\209\143 \209\132\209\131\209\128\208\189\208\184\209\130\209\131\209\128\208\176",
		["Black lacquered sheath"] = "\208\157\208\190\208\182\208\189\209\139 \208\191\208\190\208\186\209\128\209\139\209\130\209\139 \209\135\209\145\209\128\208\189\209\139\208\188 \208\187\208\176\208\186\208\190\208\188",
		["Temper line polished, purple silk"] = "\208\165\208\176\208\188\208\190\208\189 \208\190\209\130\208\191\208\190\208\187\208\184\209\128\208\190\208\178\208\176\208\189, \209\132\208\184\208\190\208\187\208\181\209\130\208\190\208\178\209\139\208\185 \209\136\209\145\208\187\208\186",
		["Best of 5: the first to {wins} round wins."] = "\208\156\208\176\208\186\209\129\208\184\208\188\209\131\208\188 5 \209\128\208\176\209\131\208\189\208\180\208\190\208\178: \208\191\208\190\208\177\208\181\208\182\208\180\208\176\208\181\209\130 \209\130\208\190\209\130, \208\186\209\130\208\190 \208\191\208\181\209\128\208\178\209\139\208\188 \208\178\209\139\208\184\208\179\209\128\208\176\208\181\209\130 {wins} \208\184\208\183 \208\189\208\184\209\133.",
		["Every attack is a draw-cut that strikes through any blade. No guard."] = "\208\154\208\176\208\182\208\180\208\176\209\143 \208\176\209\130\208\176\208\186\208\176 \226\128\148 \209\131\208\180\208\176\209\128 \209\129 \208\178\209\139\209\133\208\178\208\176\209\130\208\176, \208\186\208\190\209\130\208\190\209\128\209\139\208\185 \208\191\209\128\208\190\208\177\208\184\208\178\208\176\208\181\209\130 \208\187\209\142\208\177\208\190\208\185 \208\186\208\187\208\184\208\189\208\190\208\186. \208\145\208\181\208\183 \208\177\208\187\208\190\208\186\208\176.",
		["Fight from the sheath: every draw-cut strikes through any blade, and the blade goes straight back in."] = "\208\145\208\190\208\185 \208\184\208\183 \208\189\208\190\208\182\208\181\208\189: \208\186\208\176\208\182\208\180\209\139\208\185 \209\131\208\180\208\176\209\128 \209\129 \208\178\209\139\209\133\208\178\208\176\209\130\208\176 \208\191\209\128\208\190\208\177\208\184\208\178\208\176\208\181\209\130 \208\187\209\142\208\177\208\190\208\185 \208\186\208\187\208\184\208\189\208\190\208\186, \208\184 \208\186\208\187\208\184\208\189\208\190\208\186 \209\129\209\128\208\176\208\183\209\131 \209\131\209\133\208\190\208\180\208\184\209\130 \208\190\208\177\209\128\208\176\209\130\208\189\208\190 \208\178 \208\189\208\190\208\182\208\189\209\139.",
		["10 rename spins"] = "10 \208\191\209\128\208\190\208\186\209\128\209\131\209\130\208\190\208\178 \209\132\208\176\208\188\208\184\208\187\208\184\208\184",
		["50 rename spins"] = "50 \208\191\209\128\208\190\208\186\209\128\209\131\209\130\208\190\208\178 \209\132\208\176\208\188\208\184\208\187\208\184\208\184",
		["Each column is a string: hold a key, then pluck that string."] = "\208\154\208\176\208\182\208\180\209\139\208\185 \209\129\209\130\208\190\208\187\208\177\208\181\209\134 \226\128\148 \209\141\209\130\208\190 \209\129\209\130\209\128\209\131\208\189\208\176: \208\183\208\176\208\182\208\188\208\184 \208\186\208\187\208\176\208\178\208\184\209\136\209\131 \208\184 \209\137\208\184\208\191\208\189\208\184 \209\141\209\130\209\131 \209\129\209\130\209\128\209\131\208\189\209\131.",
		["TACHI restored: stage {stage}, {name}"] = "\208\162\208\144\208\162\208\152 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\190\208\178\208\187\208\181\208\189: \209\141\209\130\208\176\208\191 {stage}, {name}",
		["You can only bow for a 1v1 with someone you could fight right now, in the same ring."] = "\208\159\208\190\208\186\208\187\208\190\208\189\208\184\209\130\209\140\209\129\209\143 \208\180\208\187\209\143 1v1 \208\188\208\190\208\182\208\189\208\190 \209\130\208\190\208\187\209\140\208\186\208\190 \209\130\208\190\208\188\209\131, \209\129 \208\186\208\181\208\188 \209\130\209\139 \208\188\208\190\208\182\208\181\209\136\209\140 \209\129\209\128\208\176\208\183\208\184\209\130\209\140\209\129\209\143 \208\191\209\128\209\143\208\188\208\190 \209\129\208\181\208\185\209\135\208\176\209\129, \208\189\208\176 \209\130\208\190\208\188 \208\182\208\181 \209\128\208\184\208\189\208\179\208\181.",
		["The rematch can\'t start: you both need to be in the same ring."] = "\208\160\208\181\208\178\208\176\208\189\209\136 \208\189\208\181 \208\189\208\176\209\135\208\176\209\130\209\140: \208\178\209\139 \208\190\208\177\208\176 \208\180\208\190\208\187\208\182\208\189\209\139 \208\177\209\139\209\130\209\140 \208\189\208\176 \208\190\208\180\208\189\208\190\208\188 \209\128\208\184\208\189\208\179\208\181.",
		["Positions 1 to 9: hold one, then pluck."] = "\208\159\208\190\208\183\208\184\209\134\208\184\208\184 1\226\128\1479: \208\183\208\176\208\182\208\188\208\184 \208\190\208\180\208\189\209\131 \208\184 \209\137\208\184\208\191\208\189\208\184.",
		["Finish a daily quest"] = "\208\146\209\139\208\191\208\190\208\187\208\189\208\184 \208\181\208\182\208\181\208\180\208\189\208\181\208\178\208\189\209\139\208\185 \208\186\208\178\208\181\209\129\209\130",
		["VENGEFUL EMPRESS"] = "\208\156\208\161\208\162\208\152\208\162\208\149\208\155\208\172\208\157\208\144\208\175 \208\152\208\156\208\159\208\149\208\160\208\144\208\162\208\160\208\152\208\166\208\144",
		["THE TEMPLE GHOST"] = "\208\159\208\160\208\152\208\151\208\160\208\144\208\154 \208\165\208\160\208\144\208\156\208\144",
		["Reroll your first name as often as you like, or spin a new family name ({count} spin)."] = "\208\156\208\181\208\189\209\143\208\185 \208\184\208\188\209\143 \209\129\208\186\208\190\208\187\209\140\208\186\208\190 \209\131\208\179\208\190\208\180\208\189\208\190 \208\184\208\187\208\184 \208\191\209\128\208\190\208\186\209\128\209\131\209\130\208\184 \208\189\208\190\208\178\209\131\209\142 \209\132\208\176\208\188\208\184\208\187\208\184\209\142 ({count} \208\191\209\128\208\190\208\186\209\128\209\131\209\130).",
		["Reroll your first name as often as you like, or spin a new family name ({count} spins)."] = "\208\156\208\181\208\189\209\143\208\185 \208\184\208\188\209\143 \209\129\208\186\208\190\208\187\209\140\208\186\208\190 \209\131\208\179\208\190\208\180\208\189\208\190 \208\184\208\187\208\184 \208\191\209\128\208\190\208\186\209\128\209\131\209\130\208\184 \208\189\208\190\208\178\209\131\209\142 \209\132\208\176\208\188\208\184\208\187\208\184\209\142 (\208\191\209\128\208\190\208\186\209\128\209\131\209\130\208\190\208\178: {count}).",
		["Reroll your first name as often as you like."] = "\208\156\208\181\208\189\209\143\208\185 \208\184\208\188\209\143 \209\129\208\186\208\190\208\187\209\140\208\186\208\190 \209\131\208\179\208\190\208\180\208\189\208\190.",
		["REROLL FIRST NAME"] = "\208\161\208\156\208\149\208\157\208\152\208\162\208\172 \208\152\208\156\208\175",
		["Couldn\'t roll. Try again."] = "\208\157\208\181 \209\131\208\180\208\176\208\187\208\190\209\129\209\140 \209\129\208\188\208\181\208\189\208\184\209\130\209\140 \208\184\208\188\209\143. \208\159\208\190\208\191\209\128\208\190\208\177\209\131\208\185 \208\181\209\137\209\145 \209\128\208\176\208\183.",
		["REROLL"] = "\208\161\208\156\208\149\208\157\208\152\208\162\208\172",
		["Roll a first name first."] = "\208\161\208\189\208\176\209\135\208\176\208\187\208\176 \208\191\208\190\208\187\209\131\209\135\208\184 \208\184\208\188\209\143.",
		["RARER THAN YOURS"] = "\208\160\208\149\208\150\208\149 \208\162\208\146\208\158\208\149\208\153",
		["LEGENDARY AND UP"] = "\208\155\208\149\208\147\208\149\208\157\208\148\208\144\208\160\208\157\208\171\208\149 \208\152 \208\146\208\171\208\168\208\149",
		["ASK TWICE FOR EXOTIC"] = "\208\148\208\146\208\144\208\150\208\148\208\171 \208\148\208\155\208\175 \208\173\208\154\208\151\208\158\208\162\208\152\208\167\208\149\208\161\208\154\208\152\208\165",
		["{on} OF {all}"] = "{on} \208\152\208\151 {all}",
		["Asks before a spin throws away a family name."] = "\208\161\208\191\209\128\208\190\209\129\208\184\209\130, \208\191\209\128\208\181\208\182\208\180\208\181 \209\135\208\181\208\188 \208\191\209\128\208\190\208\186\209\128\209\131\209\130 \208\178\209\139\208\177\209\128\208\190\209\129\208\184\209\130 \209\132\208\176\208\188\208\184\208\187\208\184\209\142.",
		["You\'ll lose {names} and {count} more."] = "\208\162\209\139 \208\191\208\190\209\130\208\181\209\128\209\143\208\181\209\136\209\140 {names} \208\184 \208\181\209\137\209\145 {count}.",
		["You\'ll lose {names}."] = "\208\162\209\139 \208\191\208\190\209\130\208\181\209\128\209\143\208\181\209\136\209\140 {names}.",
		["Are you sure?"] = "\208\162\209\139 \209\131\208\178\208\181\209\128\208\181\208\189?",
		["{names} will be gone for good."] = "{names} \208\191\209\128\208\190\208\191\208\176\208\180\209\145\209\130 \208\189\208\176\208\178\209\129\208\181\208\179\208\180\208\176.",
		["Peaceful: out in the forest nobody can hurt you, and you can\'t hurt anyone. In the rings you fight as usual."] = "\208\156\208\184\209\128\208\189\209\139\208\185 \209\128\208\181\208\182\208\184\208\188: \208\178 \208\187\208\181\209\129\209\131 \208\189\208\184\208\186\209\130\208\190 \208\189\208\181 \208\188\208\190\208\182\208\181\209\130 \209\130\208\181\208\177\209\143 \209\128\208\176\208\189\208\184\209\130\209\140, \208\184 \209\130\209\139 \208\189\208\181 \208\188\208\190\208\182\208\181\209\136\209\140 \209\128\208\176\208\189\208\184\209\130\209\140 \208\189\208\184\208\186\208\190\208\179\208\190. \208\157\208\176 \209\128\208\184\208\189\208\179\208\176\209\133 \209\130\209\139 \209\129\209\128\208\176\208\182\208\176\208\181\209\136\209\140\209\129\209\143 \208\186\208\176\208\186 \208\190\208\177\209\139\209\135\208\189\208\190.",
		["Peaceful: nobody can hurt you, and you can\'t hurt anyone. In the beginners\' ring and the boss arena you fight as usual."] = "\208\156\208\184\209\128\208\189\209\139\208\185 \209\128\208\181\208\182\208\184\208\188: \208\189\208\184\208\186\209\130\208\190 \208\189\208\181 \208\188\208\190\208\182\208\181\209\130 \209\130\208\181\208\177\209\143 \209\128\208\176\208\189\208\184\209\130\209\140, \208\184 \209\130\209\139 \208\189\208\181 \208\188\208\190\208\182\208\181\209\136\209\140 \209\128\208\176\208\189\208\184\209\130\209\140 \208\189\208\184\208\186\208\190\208\179\208\190. \208\157\208\176 \209\128\208\184\208\189\208\179\208\181 \208\189\208\190\208\178\208\184\209\135\208\186\208\190\208\178 \208\184 \208\189\208\176 \208\176\209\128\208\181\208\189\208\181 \208\177\208\190\209\129\209\129\208\176 \209\130\209\139 \209\129\209\128\208\176\208\182\208\176\208\181\209\136\209\140\209\129\209\143 \208\186\208\176\208\186 \208\190\208\177\209\139\209\135\208\189\208\190.",
		["BONFIRE"] = "\208\154\208\158\208\161\208\162\208\129\208\160",
		["LAST LOCATION"] = "\208\159\208\158\208\161\208\155\208\149\208\148\208\157\208\149\208\149 \208\156\208\149\208\161\208\162\208\158",
		["Outside the ring: sword lowered"] = "\208\146\208\189\208\181 \209\128\208\184\208\189\208\179\208\176: \208\188\208\181\209\135 \208\190\208\191\209\131\209\137\208\181\208\189",
		["Outside the ring: sword sheathed"] = "\208\146\208\189\208\181 \209\128\208\184\208\189\208\179\208\176: \208\188\208\181\209\135 \208\178 \208\189\208\190\208\182\208\189\208\176\209\133",
		["Find bonfires out in the world to travel between them."] = "\208\157\208\176\209\133\208\190\208\180\208\184 \208\186\208\190\209\129\209\130\209\128\209\139 \208\191\208\190 \208\178\209\129\208\181\208\188\209\131 \208\188\208\184\209\128\209\131, \209\135\209\130\208\190\208\177\209\139 \208\191\208\181\209\128\208\181\208\188\208\181\209\137\208\176\209\130\209\140\209\129\209\143 \208\188\208\181\208\182\208\180\209\131 \208\189\208\184\208\188\208\184.",
		["Tap a bonfire you\'ve found to travel there."] = "\208\154\208\190\209\129\208\189\208\184\209\129\209\140 \208\189\208\176\208\185\208\180\208\181\208\189\208\189\208\190\208\179\208\190 \208\186\208\190\209\129\209\130\209\128\208\176, \209\135\209\130\208\190\208\177\209\139 \208\191\208\181\209\128\208\181\208\188\208\181\209\129\209\130\208\184\209\130\209\140\209\129\209\143 \208\186 \208\189\208\181\208\188\209\131.",
		["Click a bonfire you\'ve found to travel there."] = "\208\157\208\176\208\182\208\188\208\184 \208\189\208\176 \208\189\208\176\208\185\208\180\208\181\208\189\208\189\209\139\208\185 \208\186\208\190\209\129\209\130\209\145\209\128, \209\135\209\130\208\190\208\177\209\139 \208\191\208\181\209\128\208\181\208\188\208\181\209\129\209\130\208\184\209\130\209\140\209\129\209\143 \208\186 \208\189\208\181\208\188\209\131.",
		["Bonfire found: {name}"] = "\208\157\208\176\208\185\208\180\208\181\208\189 \208\186\208\190\209\129\209\130\209\145\209\128: {name}",
		["Rested at {name}. You\'ll start here when you next play."] = "\208\158\209\130\208\180\209\139\209\133: {name}. \208\146 \209\129\208\187\208\181\208\180\209\131\209\142\209\137\208\184\208\185 \209\128\208\176\208\183 \209\130\209\139 \208\189\208\176\209\135\208\189\209\145\209\136\209\140 \208\183\208\180\208\181\209\129\209\140.",
		["You haven\'t found that bonfire yet."] = "\208\162\209\139 \208\181\209\137\209\145 \208\189\208\181 \208\189\208\176\209\136\209\145\208\187 \209\141\209\130\208\190\209\130 \208\186\208\190\209\129\209\130\209\145\209\128.",
		["{upgrade}.  {look}"] = "{upgrade}.  {look}",
		["REFORGE"] = "\208\159\208\149\208\160\208\149\208\154\208\158\208\146\208\144\208\162\208\172",
		["Forge your next upgrade, or reforge your blade to a rank you\'ve already forged."] = "\208\146\209\139\208\186\209\131\208\185 \209\129\208\187\208\181\208\180\209\131\209\142\209\137\208\181\208\181 \209\131\208\187\209\131\209\135\209\136\208\181\208\189\208\184\208\181 \208\184\208\187\208\184 \208\191\208\181\209\128\208\181\208\186\209\131\208\185 \208\186\208\187\208\184\208\189\208\190\208\186 \208\189\208\176 \209\131\208\182\208\181 \208\178\209\139\208\186\208\190\208\178\208\176\208\189\208\189\209\139\208\185 \209\128\208\176\208\189\208\179.",
		["FORGE RANK {rank}   {name}"] = "\208\146\208\171\208\154\208\158\208\146\208\144\208\162\208\172 \208\160\208\144\208\157\208\147 {rank}   {name}",
		["unlocks at level {level} (you\'re level {yours})"] = "\208\190\209\130\208\186\209\128\208\190\208\181\209\130\209\129\209\143 \208\189\208\176 {level} \209\131\209\128\208\190\208\178\208\189\208\181 (\209\131 \209\130\208\181\208\177\209\143 {yours})",
		["RANK {rank}   {name}   (in use)"] = "\208\160\208\144\208\157\208\147 {rank}   {name}   (\208\178\209\139\208\177\209\128\208\176\208\189)",
		["Dark blade, crimson edge, red lightning, a glow that flares as it drinks."] = "\208\162\209\145\208\188\208\189\209\139\208\185 \208\186\208\187\208\184\208\189\208\190\208\186, \208\177\208\176\208\179\209\128\208\190\208\178\208\190\208\181 \208\187\208\181\208\183\208\178\208\184\208\181, \208\186\209\128\208\176\209\129\208\189\209\139\208\181 \208\188\208\190\208\187\208\189\208\184\208\184 \208\184 \209\129\208\178\208\181\209\135\208\181\208\189\208\184\208\181, \209\135\209\130\208\190 \208\178\209\129\208\191\209\139\209\133\208\184\208\178\208\176\208\181\209\130, \208\186\208\190\208\179\208\180\208\176 \208\186\208\187\208\184\208\189\208\190\208\186 \208\191\209\140\209\145\209\130 \208\186\209\128\208\190\208\178\209\140.",
		["FIND IT"] = "\208\157\208\144\208\153\208\148\208\152",
		["{short} Find it in the rooms of the temple on the hill."] = "{short} \208\157\208\176\208\185\208\180\208\184 \208\181\208\179\208\190 \208\178 \208\186\208\190\208\188\208\189\208\176\209\130\208\176\209\133 \209\133\209\128\208\176\208\188\208\176 \208\189\208\176 \209\133\208\190\208\187\208\188\208\181.",
		["Blade length 3.2 studs"] = "\208\148\208\187\208\184\208\189\208\176 \208\186\208\187\208\184\208\189\208\186\208\176 3.2 studs",
		["Blade length 3.4 studs, draw styles (coming soon)"] = "\208\148\208\187\208\184\208\189\208\176 \208\186\208\187\208\184\208\189\208\186\208\176 3.4 studs, \209\129\209\130\208\184\208\187\208\184 \208\178\209\139\209\133\208\178\208\176\209\130\208\176 (\209\129\208\186\208\190\209\128\208\190)",
		["+5% walk speed"] = "+5% \208\186 \209\129\208\186\208\190\209\128\208\190\209\129\209\130\208\184 \209\133\208\190\208\180\209\140\208\177\209\139",
		["+5% walk speed, 25% faster poise recovery"] = "+5% \208\186 \209\129\208\186\208\190\209\128\208\190\209\129\209\130\208\184 \209\133\208\190\208\180\209\140\208\177\209\139, \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\176\208\178\208\187\208\184\208\178\208\176\208\181\209\130\209\129\209\143 \208\189\208\176 25% \208\177\209\139\209\129\209\130\209\128\208\181\208\181",
		["After {delay} seconds of calm it comes back, {regen} a second: faster with a still guard (L2 on a gamepad), slower with little blood.\n\nBelow half, your feet slow down. The lower it is, the heavier your blade and the more easily it\'s knocked aside."] = "\208\159\208\190\209\129\208\187\208\181 {delay} \209\129\208\181\208\186. \208\183\208\176\209\130\208\184\209\136\209\140\209\143 \208\190\208\189\208\176 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\176\208\178\208\187\208\184\208\178\208\176\208\181\209\130\209\129\209\143, \208\191\208\190 {regen} \208\178 \209\129\208\181\208\186\209\131\208\189\208\180\209\131: \208\177\209\139\209\129\209\130\209\128\208\181\208\181 \209\129 \208\189\208\181\208\191\208\190\208\180\208\178\208\184\208\182\208\189\209\139\208\188 \208\177\208\187\208\190\208\186\208\190\208\188 (L2 \208\189\208\176 \208\179\208\181\208\185\208\188\208\191\208\176\208\180\208\181), \208\188\208\181\208\180\208\187\208\181\208\189\208\189\208\181\208\181, \208\186\208\190\208\179\208\180\208\176 \208\188\208\176\208\187\208\190 \208\186\209\128\208\190\208\178\208\184.\n\n\208\157\208\184\208\182\208\181 \208\191\208\190\208\187\208\190\208\178\208\184\208\189\209\139 \208\189\208\190\208\179\208\184 \208\183\208\176\208\188\208\181\208\180\208\187\209\143\209\142\209\130\209\129\209\143. \208\167\208\181\208\188 \208\190\208\189\208\176 \208\189\208\184\208\182\208\181, \209\130\208\181\208\188 \209\130\209\143\208\182\208\181\208\187\208\181\208\181 \208\186\208\187\208\184\208\189\208\190\208\186 \208\184 \209\130\208\181\208\188 \208\187\208\181\208\179\209\135\208\181 \208\190\209\130\208\177\208\184\209\130\209\140 \208\181\208\179\208\190 \208\178 \209\129\209\130\208\190\209\128\208\190\208\189\209\131.",
		["<b>Wiping resets your poise.</b> While the cloth is on the blade, poise comes back {times} times as fast, and a finished wipe fills it to full.\n\nIt works after a break too: finishing a wipe ends being weakened.\n\nA finished wipe also gives back all your dashes."] = "<b>\208\167\208\184\209\129\209\130\208\186\208\176 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\176\208\178\208\187\208\184\208\178\208\176\208\181\209\130 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140.</b> \208\159\208\190\208\186\208\176 \209\130\208\186\208\176\208\189\209\140 \208\189\208\176 \208\186\208\187\208\184\208\189\208\186\208\181, \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140 \208\178\208\190\208\183\208\178\209\128\208\176\209\137\208\176\208\181\209\130\209\129\209\143 \208\177\209\139\209\129\209\130\209\128\208\181\208\181 (\195\151{times}), \208\176 \208\183\208\176\208\186\208\190\208\189\209\135\208\181\208\189\208\189\208\176\209\143 \209\135\208\184\209\129\209\130\208\186\208\176 \208\183\208\176\208\191\208\190\208\187\208\189\209\143\208\181\209\130 \208\181\209\145 \208\180\208\190 \208\186\208\190\208\189\209\134\208\176.\n\n\208\173\209\130\208\190 \209\128\208\176\208\177\208\190\209\130\208\176\208\181\209\130 \208\184 \208\191\208\190\209\129\208\187\208\181 \208\191\208\190\208\187\208\190\208\188\208\186\208\184: \208\183\208\176\208\186\208\190\208\189\209\135\208\181\208\189\208\189\208\176\209\143 \209\135\208\184\209\129\209\130\208\186\208\176 \209\129\208\189\208\184\208\188\208\176\208\181\209\130 \208\190\209\129\208\187\208\176\208\177\208\187\208\181\208\189\208\184\208\181.\n\n\208\151\208\176\208\178\208\181\209\128\209\136\209\145\208\189\208\189\208\176\209\143 \209\135\208\184\209\129\209\130\208\186\208\176 \209\130\208\176\208\186\208\182\208\181 \208\178\208\190\208\183\208\178\209\128\208\176\209\137\208\176\208\181\209\130 \208\178\209\129\208\181 \209\128\209\139\208\178\208\186\208\184.",
		["tap WIPE to refill dashes"] = "\208\189\208\176\208\182\208\188\208\184 \208\167\208\152\208\161\208\162\208\154\208\144, \209\135\209\130\208\190\208\177\209\139 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\190\208\178\208\184\209\130\209\140 \209\128\209\139\208\178\208\186\208\184",
		["{key}  wipe to refill dashes"] = "{key}  \208\191\208\190\209\135\208\184\209\129\209\130\208\184 \208\186\208\187\208\184\208\189\208\190\208\186, \209\135\209\130\208\190\208\177\209\139 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\190\208\178\208\184\209\130\209\140 \209\128\209\139\208\178\208\186\208\184",
		["Out of dashes. Tap **WIPE** to wipe your blade and get them back."] = "\208\160\209\139\208\178\208\186\208\184 \208\186\208\190\208\189\209\135\208\184\208\187\208\184\209\129\209\140. \208\157\208\176\208\182\208\188\208\184 **\208\167\208\152\208\161\208\162\208\154\208\144**, \209\135\209\130\208\190\208\177\209\139 \208\191\208\190\209\135\208\184\209\129\209\130\208\184\209\130\209\140 \208\186\208\187\208\184\208\189\208\190\208\186 \208\184 \208\178\208\181\209\128\208\189\209\131\209\130\209\140 \208\184\209\133.",
		["Out of dashes. Press **{Wipe}** to wipe your blade and get them back."] = "\208\160\209\139\208\178\208\186\208\184 \208\186\208\190\208\189\209\135\208\184\208\187\208\184\209\129\209\140. \208\157\208\176\208\182\208\188\208\184 **{Wipe}**, \209\135\209\130\208\190\208\177\209\139 \208\191\208\190\209\135\208\184\209\129\209\130\208\184\209\130\209\140 \208\186\208\187\208\184\208\189\208\190\208\186 \208\184 \208\178\208\181\209\128\208\189\209\131\209\130\209\140 \208\184\209\133.",
		["+1% walk speed"] = "+1% \208\186 \209\129\208\186\208\190\209\128\208\190\209\129\209\130\208\184 \209\133\208\190\208\180\209\140\208\177\209\139",
		["10% less poise lost to hits and clashes"] = "\208\157\208\176 10% \208\188\208\181\208\189\209\140\209\136\208\181 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184 \209\130\208\181\209\128\209\143\208\181\209\130\209\129\209\143 \208\190\209\130 \209\131\208\180\208\176\209\128\208\190\208\178 \208\184 \209\129\209\130\208\190\208\187\208\186\208\189\208\190\208\178\208\181\208\189\208\184\208\185 \208\186\208\187\208\184\208\189\208\186\208\190\208\178",
		["10% less poise lost to hits and clashes, 15% quicker back from knocks"] = "\208\157\208\176 10% \208\188\208\181\208\189\209\140\209\136\208\181 \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\208\184 \209\130\208\181\209\128\209\143\208\181\209\130\209\129\209\143 \208\190\209\130 \209\131\208\180\208\176\209\128\208\190\208\178 \208\184 \209\129\209\130\208\190\208\187\208\186\208\189\208\190\208\178\208\181\208\189\208\184\208\185 \208\186\208\187\208\184\208\189\208\186\208\190\208\178, \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\190\208\178\208\187\208\181\208\189\208\184\208\181 \208\191\208\190\209\129\208\187\208\181 \208\190\209\130\208\177\208\184\208\178\208\176 \208\189\208\176 15% \208\177\209\139\209\129\209\130\209\128\208\181\208\181",
		["+1% walk speed, 25% faster poise recovery"] = "+1% \208\186 \209\129\208\186\208\190\209\128\208\190\209\129\209\130\208\184 \209\133\208\190\208\180\209\140\208\177\209\139, \209\129\209\130\208\190\208\185\208\186\208\190\209\129\209\130\209\140 \208\178\208\190\209\129\209\129\209\130\208\176\208\189\208\176\208\178\208\187\208\184\208\178\208\176\208\181\209\130\209\129\209\143 \208\189\208\176 25% \208\177\209\139\209\129\209\130\209\128\208\181\208\181",
		["+20 blood"] = "+20 \208\186\209\128\208\190\208\178\208\184",
		["UPGRADE READY"] = "\208\163\208\155\208\163\208\167\208\168\208\149\208\157\208\152\208\149 \208\147\208\158\208\162\208\158\208\146\208\158",
		["the forge"] = "\208\186\209\131\208\183\208\189\208\184\209\134\208\176",
		["New look"] = "\208\157\208\190\208\178\209\139\208\185 \208\190\208\177\208\187\208\184\208\186",
		["Draw styles (coming soon)"] = "\208\161\209\130\208\184\208\187\208\184 \208\178\209\139\209\133\208\178\208\176\209\130\208\176 (\209\129\208\186\208\190\209\128\208\190)",
		["SINGLE"] = "\208\158\208\148\208\152\208\157 \208\156\208\149\208\167",
		["DUAL WIELD"] = "\208\148\208\146\208\144 \208\156\208\149\208\167\208\144",
		["IAI"] = "\208\152\208\144\208\153",
		["Robux spins aren\'t sold on your account. Ry\197\141 and levels still give them."] = "\208\159\209\128\208\190\208\186\209\128\209\131\209\130\209\139 \208\183\208\176 Robux \208\189\208\181\208\180\208\190\209\129\209\130\209\131\208\191\208\189\209\139 \208\180\208\187\209\143 \209\130\208\178\208\190\208\181\208\179\208\190 \208\176\208\186\208\186\208\176\209\131\208\189\209\130\208\176. \208\152\209\133 \208\191\208\190-\208\191\209\128\208\181\208\182\208\189\208\181\208\188\209\131 \208\180\208\176\209\142\209\130 ry\197\141 \208\184 \209\131\209\128\208\190\208\178\208\189\208\184.",
		["Beginners\' ring: under level {level} only"] = "\208\160\208\184\208\189\208\179 \208\189\208\190\208\178\208\184\209\135\208\186\208\190\208\178: \209\130\208\190\208\187\209\140\208\186\208\190 \208\180\208\190 {level} \209\131\209\128\208\190\208\178\208\189\209\143"
	}
}
