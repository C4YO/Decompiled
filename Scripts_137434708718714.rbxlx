		["+5% walk speed, 25% faster poise recovery"] = "\224\184\132\224\184\167\224\184\178\224\184\161\224\185\128\224\184\163\224\185\135\224\184\167\224\185\128\224\184\148\224\184\180\224\184\153 +5% \224\184\159\224\184\183\224\185\137\224\184\153\224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\185\128\224\184\163\224\185\135\224\184\167\224\184\130\224\184\182\224\185\137\224\184\153 25%",
		["After {delay} seconds of calm it comes back, {regen} a second: faster with a still guard (L2 on a gamepad), slower with little blood.\n\nBelow half, your feet slow down. The lower it is, the heavier your blade and the more easily it\'s knocked aside."] = "\224\184\171\224\184\165\224\184\177\224\184\135\224\184\170\224\184\135\224\184\154\224\184\153\224\184\180\224\185\136\224\184\135 {delay} \224\184\167\224\184\180\224\184\153\224\184\178\224\184\151\224\184\181 \224\184\170\224\184\161\224\184\148\224\184\184\224\184\165\224\184\136\224\184\176\224\184\129\224\184\165\224\184\177\224\184\154\224\184\161\224\184\178\224\184\167\224\184\180\224\184\153\224\184\178\224\184\151\224\184\181\224\184\165\224\184\176 {regen}: \224\185\128\224\184\163\224\185\135\224\184\167\224\184\130\224\184\182\224\185\137\224\184\153\224\185\128\224\184\161\224\184\183\224\185\136\224\184\173\224\184\149\224\184\177\224\185\137\224\184\135\224\184\129\224\184\178\224\184\163\224\185\140\224\184\148\224\184\153\224\184\180\224\185\136\224\184\135 (L2 \224\184\154\224\184\153\224\184\136\224\184\173\224\184\162\224\185\128\224\184\129\224\184\161) \224\184\138\224\185\137\224\184\178\224\184\165\224\184\135\224\185\128\224\184\161\224\184\183\224\185\136\224\184\173\224\185\128\224\184\165\224\184\183\224\184\173\224\184\148\224\184\153\224\185\137\224\184\173\224\184\162\n\n\224\184\150\224\185\137\224\184\178\224\184\149\224\185\136\224\184\179\224\184\129\224\184\167\224\185\136\224\184\178\224\184\132\224\184\163\224\184\182\224\185\136\224\184\135 \224\185\128\224\184\151\224\185\137\224\184\178\224\184\130\224\184\173\224\184\135\224\184\132\224\184\184\224\184\147\224\184\136\224\184\176\224\184\138\224\185\137\224\184\178\224\184\165\224\184\135 \224\184\162\224\184\180\224\185\136\224\184\135\224\184\149\224\185\136\224\184\179 \224\184\148\224\184\178\224\184\154\224\184\162\224\184\180\224\185\136\224\184\135\224\184\171\224\184\153\224\184\177\224\184\129\224\185\129\2