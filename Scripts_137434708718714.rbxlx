		["100 rename spins"] = "100 giros de nome",
		["500 rename spins"] = "500 giros de nome",
		["1,000 rename spins"] = "1,000 giros de nome",
		["5,000 rename spins"] = "5,000 giros de nome",
		["Support the game"] = "Apoie o jogo",
		["2x XP for 30 minutes"] = "2x XP por 30 minutos",
		["2x XP"] = "2x XP",
		["Doubles all XP earned. Stacks with other XP multipliers and passes."] = "Dobra todo o XP ganho. Acumula com outros multiplicadores de XP e passes.",
		["1.5x XP"] = "1,5x XP",
		["Multiplies all XP by 1.5. Stacks with other XP multipliers and passes."] = "Multiplica todo o XP por 1,5. Acumula com outros multiplicadores de XP e passes.",
		["2x Ry\197\141"] = "2x Ry\197\141",
		["Doubles every ry\197\141 gain: kills, quests, rewards and ry\197\141 packs."] = "Dobra todo ganho de ry\197\141: abates, miss\195\181es, recompensas e pacotes de ry\197\141.",
		["Dual Wield"] = "Duas Katanas",
		["A second katana at your right hip: draw both at once and fight with one in each hand."] = "Uma segunda katana no quadril direito: saque as duas de uma vez e lute com uma em cada m\195\163o.",
		["Iai"] = "Iai",
		["Draw-cuts only. Cuts through blades, but a miss can be parried. 1.5x dash, 1.6x draw speed."] = "S\195\179 cortes de saque. Atravessa l\195\162minas, mas um erro pode ser defendido. Dash 1.5x, saque 1.6x mais r\195\161pido.",
		["Shamisen"] = "Shamisen",
		["A playable three-string shamisen. Pluck with the mouse or a finger; 9 keys or pads set the notes. Heard by nearby players."] = "Um shamisen de tr\195\170s cordas para tocar. Dedilhe com o mouse ou um dedo; 9 teclas ou bot\195\181es definem as notas. Jogadores por perto ouvem.",
		["ANYONE"] = "QUALQUER UM",
		["PLAYERS"] = "JOGADORES",
		["OVER RIGHT SHOULDER"] = "SOBRE O OMBRO DIREITO",
		["WIDE RIGHT SHOULDER"] = "OMBRO DIREITO ABERTO",
		["OVER LEFT SHOULDER"] = "SOBRE O OMBRO ESQUERDO",
		["WIDE LEFT SHOULDER"] = "OMBRO ESQUERDO ABERTO",
		["ABOVE HEAD"] = "ACIMA DA CABE\195\135A",
		["BEHIND"] = "ATR\195\129S",
		["FAR BEHIND"] = "BEM ATR\195\129S",
		["CUSTOM 1"] = "PERSONALIZADA 1",
		["CUSTOM 2"] = "PERSONALIZADA 2",
		["CUSTOM 3"] = "PERSONALIZADA 3",
		["BACKWARDS"] = "PARA TR\195\129S",
		["FORWARDS"] = "PARA FRENTE",
		["HOLD {Draw}"] = "SEGURE {Draw}",
		["Walk onto the mat"] = "V\195\161 at\195\169 o tatame",
		["Walk onto the straw mat with **WASD**."] = "Ande at\195\169 o tatame com **WASD**.",
		["WALK ONTO THE MAT"] = "V\195\129 AT\195\137 O TATAME",
		["Walk onto the straw mat with the **thumbstick**."] = "V\195\161 at\195\169 o tatame com o **anal\195\179gico**.",
		["Horizontal slice"] = "Corte horizontal",
		["Walk up close. Move the mouse **left**. Then **hold {Draw}** and **swipe right**."] = "Chegue perto. Mova o mouse para a **esquerda**. Depois **segure {Draw}** e **deslize para a direita**.",
		["MOVE LEFT"] = "MOVA \195\128 ESQUERDA",
		["SWIPE RIGHT"] = "DESLIZE \195\128 DIREITA",
		["Walk up close. Then **flick right** on the right side of the screen."] = "Chegue perto. Depois **deslize r\195\161pido para a direita** no lado direito da tela.",
		["Sheathe the sword"] = "Guarde a espada",
		["Press **{Equip}** to sheathe the blade. Every draw starts from the sheath."] = "Aperte **{Equip}** para guardar a l\195\162mina. Todo saque come\195\167a na bainha.",
		["PRESS {Equip}"] = "APERTE {Equip}",
		["Tap **SHEATHE** to sheathe the blade. Every draw starts from the sheath."] = "Toque em **GUARDAR** para guardar a l\195\162mina. Todo saque come\195\167a na bainha.",
		["TAP SHEATHE"] = "TOQUE EM GUARDAR",
		["Vertical slice"] = "Corte vertical",
		["Walk up close. Move the mouse **up**. Then **hold {Draw}** and **swipe down**."] = "Chegue perto. Mova o mouse para **cima**. Depois **segure {Draw}** e **deslize para baixo**.",
		["MOVE UP"] = "MOVA PARA CIMA",
		["SWIPE DOWN"] = "DESLIZE PARA BAIXO",
		["Walk up close. Then **flick down** on the right side of the screen."] = "Chegue perto. Depois **deslize r\195\161pido para baixo** no lado direito da tela.",
		["FLICK DOWN"] = "DESLIZE PARA BAIXO",
		["Weakened: wipe the blade"] = "Enfraquecido: limpe a l\195\162mina",
		["Poise broken: **weakened** (slow, no jumping). Press **{Wipe}** to wipe the blade and recover."] = "Postura quebrada: **enfraquecido** (lento, sem pular). Aperte **{Wipe}** para limpar a l\195\162mina e se recuperar.",
		["PRESS {Wipe}"] = "APERTE {Wipe}",
		["Poise broken: **weakened** (slow, no jumping). Tap **WIPE** to wipe the blade and recover."] = "Postura quebrada: **enfraquecido** (lento, sem pular). Toque em **LIMPAR** para limpar a l\195\162mina e se recuperar.",
		["TAP WIPE"] = "TOQUE EM LIMPAR",
		["Dash attack"] = "Ataque com dash",
		["Blade out, walk up close. Hold **W + A** to walk past the watermelon, then press **{Dash}** to dash through it."] = "Com a l\195\162mina para fora, chegue perto. Segure **W + A** para passar pela melancia e aperte **{Dash}** para atravess\195\161-la com um dash.",
		["HOLD W + A"] = "SEGURE W + A",
		["PRESS {Dash}"] = "APERTE {Dash}",
		["Blade out, walk up close. Walk past the watermelon, then tap **DASH** to dash through it."] = "Com a l\195\162mina para fora, chegue perto. Passe pela melancia e toque em **DASH** para atravess\195\161-la com um dash.",
		["WALK PAST IT"] = "PASSE POR ELA",
		["TAP DASH"] = "TOQUE EM DASH",
		["That was the low cut"] = "Esse foi o corte baixo",
		["That was the horizontal slice"] = "Esse foi o corte horizontal",
		["That was a diagonal cut"] = "Esse foi um corte diagonal",
		["That was the vertical slice"] = "Esse foi o corte vertical",
		["That was another draw"] = "Esse foi outro saque",
		["That was a swing"] = "Isso foi um golpe",
		["move the mouse **left**, then **hold {Draw}** and **swipe right**"] = "mova o mouse para a **esquerda**, depois **segure {Draw}** e **deslize para a direita**",
		["move the mouse **up**, then **hold {Draw}** and **swipe down**"] = "mova o mouse para **cima**, depois **segure {Draw}** e **deslize para baixo**",
		["draw again"] = "saque de novo",
		["**flick right** on the right side of the screen"] = "**deslize r\195\161pido para a direita** no lado direito da tela",
		["**flick down** on the right side of the screen"] = "**deslize r\195\161pido para baixo** no lado direito da tela",
		["Rusted, the cord rotten"] = "Enferrujado, o cord\195\163o podre",
		["Rust polished away"] = "Ferrugem removida no polimento",
		["Black silk on the handle and cords"] = "Seda preta no cabo e nos cord\195\181es",
		["Bright silver fittings"] = "Guarni\195\167\195\181es de prata brilhante",
		["Black lacquered sheath"] = "Bainha laqueada de preto",
		["Temper line polished, purple silk"] = "Linha de t\195\170mpera polida, seda roxa",
		["Best of 5: the first to {wins} round wins."] = "Melhor de 5: vence quem ganhar {wins} rodadas primeiro.",
		["Every attack is a draw-cut that strikes through any blade. No guard."] = "Todo ataque \195\169 um corte de saque que atravessa qualquer l\195\162mina. Sem guarda.",
		["Fight from the sheath: every draw-cut strikes through any blade, and the blade goes straight back in."] = "Lute da bainha: todo corte de saque atravessa qualquer l\195\162mina, e a l\195\162mina volta direto para a bainha.",
		["10 rename spins"] = "10 giros de nome",
		["50 rename spins"] = "50 giros de nome",
		["Each column is a string: hold a key, then pluck that string."] = "Cada coluna \195\169 uma corda: segure uma tecla e dedilhe essa corda.",
		["TACHI restored: stage {stage}, {name}"] = "TACHI restaurado: est\195\161gio {stage}, {name}",
		["You can only bow for a 1v1 with someone you could fight right now, in the same ring."] = "Voc\195\170 s\195\179 pode fazer a sauda\195\167\195\163o do 1v1 para algu\195\169m com quem poderia lutar agora, no mesmo ringue.",
		["The rematch can\'t start: you both need to be in the same ring."] = "A revanche n\195\163o pode come\195\167ar: voc\195\170s dois precisam estar no mesmo ringue.",
		["Positions 1 to 9: hold one, then pluck."] = "Posi\195\167\195\181es 1 a 9: segure uma e dedilhe.",
		["Finish a daily quest"] = "Conclua uma miss\195\163o di\195\161ria",
		["VENGEFUL EMPRESS"] = "IMPERATRIZ VINGATIVA",
		["THE TEMPLE GHOST"] = "O FANTASMA DO TEMPLO",
		["Reroll your first name as often as you like, or spin a new family name ({count} spin)."] = "Sorteie seu nome quantas vezes quiser, ou gire um novo sobrenome ({count} giro).",
		["Reroll your first name as often as you like, or spin a new family name ({count} spins)."] = "Sorteie seu nome quantas vezes quiser, ou gire um novo sobrenome ({count} giros).",
		["Reroll your first name as often as you like."] = "Sorteie seu nome quantas vezes quiser.",
		["REROLL FIRST NAME"] = "SORTEAR NOME",
		["Couldn\'t roll. Try again."] = "N\195\163o deu para sortear. Tente de novo.",
		["REROLL"] = "SORTEAR",
		["Roll a first name first."] = "Sorteie um nome primeiro.",
		["RARER THAN YOURS"] = "MAIS RARO QUE O SEU",
		["LEGENDARY AND UP"] = "LEND\195\129RIO OU MAIS",
		["ASK TWICE FOR EXOTIC"] = "AVISO DUPLO: EX\195\147TICO",
		["{on} OF {all}"] = "{on} DE {all}",
		["Asks before a spin throws away a family name."] = "Pergunta antes que um giro descarte um sobrenome.",
		["You\'ll lose {names} and {count} more."] = "Voc\195\170 vai perder {names} e mais {count}.",
		["You\'ll lose {names}."] = "Voc\195\170 vai perder {names}.",
		["Are you sure?"] = "Tem certeza?",
		["{names} will be gone for good."] = "{names} ser\195\161 perdido para sempre.",
		["Peaceful: out in the forest nobody can hurt you, and you can\'t hurt anyone. In the rings you fight as usual."] = "Pac\195\173fico: na floresta ningu\195\169m pode te ferir, e voc\195\170 n\195\163o pode ferir ningu\195\169m. Nos ringues voc\195\170 luta normalmente.",
		["Peaceful: nobody can hurt you, and you can\'t hurt anyone. In the beginners\' ring and the boss arena you fight as usual."] = "Pac\195\173fico: ningu\195\169m pode te ferir, e voc\195\170 n\195\163o pode ferir ningu\195\169m. No ringue dos iniciantes e na arena do chefe voc\195\170 luta normalmente.",
		["BONFIRE"] = "FOGUEIRA",
		["LAST LOCATION"] = "\195\154LTIMO LOCAL",
		["Outside the ring: sword lowered"] = "Fora do ringue: espada abaixada",
		["Outside the ring: sword sheathed"] = "Fora do ringue: espada guardada",
		["Find bonfires out in the world to travel between them."] = "Encontre fogueiras pelo mundo para viajar entre elas.",
		["Tap a bonfire you\'ve found to travel there."] = "Toque em uma fogueira que voc\195\170 encontrou para viajar at\195\169 l\195\161.",
		["Click a bonfire you\'ve found to travel there."] = "Clique em uma fogueira que voc\195\170 encontrou para viajar at\195\169 l\195\161.",
		["Bonfire found: {name}"] = "Fogueira encontrada: {name}",
		["Rested at {name}. You\'ll start here when you next play."] = "Descansou em {name}. Voc\195\170 vai come\195\167ar aqui na pr\195\179xima vez que jogar.",
		["You haven\'t found that bonfire yet."] = "Voc\195\170 ainda n\195\163o encontrou essa fogueira.",
		["{upgrade}.  {look}"] = "{upgrade}.  {look}",
		["REFORGE"] = "REFORJAR",
		["Forge your next upgrade, or reforge your blade to a rank you\'ve already forged."] = "Forje sua pr\195\179xima melhoria, ou reforje sua l\195\162mina para um rank que voc\195\170 j\195\161 forjou.",
		["FORGE RANK {rank}   {name}"] = "FORJAR RANK {rank}   {name}",
		["unlocks at level {level} (you\'re level {yours})"] = "desbloqueia no n\195\173vel {level} (voc\195\170 est\195\161 no n\195\173vel {yours})",
		["RANK {rank}   {name}   (in use)"] = "RANK {rank}   {name}   (em uso)",
		["Dark blade, crimson edge, red lightning, a glow that flares as it drinks."] = "L\195\162mina escura, fio carmesim, raios vermelhos, um brilho que se acende ao beber.",
		["FIND IT"] = "ENCONTRE",
		["{short} Find it in the rooms of the temple on the hill."] = "{short} Encontre-a nas salas do templo da colina.",
		["Blade length 3.2 studs"] = "L\195\162mina de 3,2 studs",
		["Blade length 3.4 studs, draw styles (coming soon)"] = "L\195\162mina de 3,4 studs, estilos de saque (em breve)",
		["+5% walk speed"] = "+5% de velocidade de caminhada",
		["+5% walk speed, 25% faster poise recovery"] = "+5% de velocidade de caminhada, recupera\195\167\195\163o de postura 25% mais r\195\161pida",
		["After {delay} seconds of calm it comes back, {regen} a second: faster with a still guard (L2 on a gamepad), slower with little blood.\n\nBelow half, your feet slow down. The lower it is, the heavier your blade and the more easily it\'s knocked aside."] = "Depois de {delay} segundos de calma ela volta, {regen} por segundo: mais r\195\161pido com a guarda parada (L2 no controle), mais devagar com pouco sangue.\n\nAbaixo da metade, seus p\195\169s ficam mais lentos. Quanto mais baixa, mais pesada fica sua l\195\162mina e mais f\195\161cil \195\169 desvi\195\161-la.",
		["<b>Wiping resets your poise.</b> While the cloth is on the blade, poise comes back {times} times as fast, and a finished wipe fills it to full.\n\nIt works after a break too: finishing a wipe ends being weakened.\n\nA finished wipe also gives back all your dashes."] = "<b>Limpar a l\195\162mina restaura sua postura.</b> Enquanto o pano est\195\161 na l\195\162mina, a postura volta {times} vezes mais r\195\161pido, e uma limpeza completa a enche toda.\n\nFunciona depois de uma quebra tamb\195\169m: terminar uma limpeza acaba com o enfraquecimento.\n\nUma limpeza completa tamb\195\169m devolve todos os seus dashes.",
		["tap WIPE to refill dashes"] = "toque em LIMPAR para recarregar os dashes",
		["{key}  wipe to refill dashes"] = "{key}  limpe a l\195\162mina para recarregar os dashes",
		["Out of dashes. Tap **WIPE** to wipe your blade and get them back."] = "Sem dashes. Toque em **LIMPAR** para limpar a l\195\162mina e recuper\195\161-los.",
		["Out of dashes. Press **{Wipe}** to wipe your blade and get them back."] = "Sem dashes. Aperte **{Wipe}** para limpar a l\195\162mina e recuper\195\161-los.",
		["+1% walk speed"] = "+1% de velocidade de caminhada",
		["10% less poise lost to hits and clashes"] = "10% menos postura perdida com golpes e choques de l\195\162minas",
		["10% less poise lost to hits and clashes, 15% quicker back from knocks"] = "10% menos postura perdida com golpes e choques de l\195\162minas, recupera\195\167\195\163o de rebatidas 15% mais r\195\161pida",
		["+1% walk speed, 25% faster poise recovery"] = "+1% de velocidade de caminhada, recupera\195\167\195\163o de postura 25% mais r\195\161pida",
		["+20 blood"] = "+20 de sangue",
		["UPGRADE READY"] = "MELHORIA PRONTA",
		["the forge"] = "a forja",
		["New look"] = "Novo visual",
		["Draw styles (coming soon)"] = "Estilos de saque (em breve)",
		["SINGLE"] = "SIMPLES",
		["DUAL WIELD"] = "DUAS KATANAS",
		["IAI"] = "IAI",
		["Robux spins aren\'t sold on your account. Ry\197\141 and levels still give them."] = "Giros por Robux n\195\163o s\195\163o vendidos na sua conta. Ry\197\141 e n\195\173veis ainda d\195\163o giros.",
		["Beginners\' ring: under level {level} only"] = "Ringue dos iniciantes: s\195\179 abaixo do n\195\173vel {level}"
	}
}
return v1]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX157">
