		local v25
		if v24 % 1 == 0 then
			v25 = string.format("%d", v24)
		else
			v25 = string.format("%.1f", v24)
		end
		v19.other = v25 .. "%"
		local v26
		if v18 == 0 then
			v26 = v_u_11("no boost")
		elseif v18 == 1 then
			v26 = v_u_11("{count} boost: +{walk} walk speed or +{other} to another stat", v19)
