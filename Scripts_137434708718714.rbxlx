		["Day {day} in a row. From day {from} you get {spins} a day."] = "\233\128\163\231\186\140\231\153\187\229\133\165\231\172\172{day}\229\164\169\227\128\130\231\172\172{from}\229\164\169\232\181\183\230\175\143\229\164\169\229\143\175\231\141\178\229\190\151{spins}\230\172\161\227\128\130",
		["MERRY CHRISTMAS"] = "\232\129\150\232\170\149\229\191\171\230\168\130",
		["A gift for playing on Christmas Day."] = "\230\132\159\232\172\157\228\189\160\229\156\168\232\129\150\232\170\149\231\175\128\231\149\182\229\164\169\228\190\134\231\142\169\239\188\140\233\128\129\228\189\160\228\184\128\228\187\189\231\166\174\231\137\169\227\128\130",
