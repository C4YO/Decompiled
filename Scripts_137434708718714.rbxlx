		["{was}. Tap **SHEATHE**, then {how}."] = "{was}. Touche **RANGER**, puis {how}.",
		["Not a dash attack. Hold **W + A** and press **{Dash}** while passing it."] = "Pas une attaque en ru\195\169e. Maintiens **W + A** et appuie sur **{Dash}** en passant \195\160 c\195\180t\195\169.",
		["Not a dash attack. Tap **DASH** while walking past it."] = "Pas une attaque en ru\195\169e. Touche **RU\195\137E** en marchant \195\160 c\195\180t\195\169 d\'elle.",
		["A new watermelon is on the stand."] = "Une nouvelle past\195\168que est sur le support.",
		["Still loading: try again in a moment."] = "Encore en chargement\194\160: r\195\169essaie dans un instant.",
		["Not during a 1v1."] = "Pas pendant un 1v1.",
		["Not straight after a fight: wait a few seconds."] = "Pas juste apr\195\168s un combat\194\160: attends quelques secondes.",
		["Not with a missing limb."] = "Impossible avec un membre en moins.",
		["The dojo is full: try again soon."] = "Le dojo est plein\194\160: r\195\169essaie bient\195\180t.",
		["HEAD"] = "T\195\138TE",
		["TORSO"] = "TORSE",
		["LEFT ARM"] = "BRAS GAUCHE",
		["RIGHT ARM"] = "BRAS DROIT",
		["LEFT LEG"] = "JAMBE GAUCHE",
		["RIGHT LEG"] = "JAMBE DROITE",
