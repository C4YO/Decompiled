		["Walk up close. Then **flick right** on the right side of the screen."] = "\234\176\128\234\185\140\236\157\180 \235\139\164\234\176\128\234\176\128\236\132\184\236\154\148. \234\183\184\235\139\164\236\157\140 \237\153\148\235\169\180 \236\152\164\235\165\184\236\170\189\236\151\144\236\132\156 **\236\152\164\235\165\184\236\170\189\236\156\188\235\161\156 \237\148\140\235\166\173**\237\149\152\236\132\184\236\154\148.",
		["Sheathe the sword"] = "\235\130\169\235\143\132\237\149\152\234\184\176",
		["Press **{Equip}** to sheathe the blade. Every draw starts from the sheath."] = "**{Equip}** \237\130\164\235\165\188 \235\136\140\235\159\172 \235\130\169\235\143\132\237\149\152\236\132\184\236\154\148. \235\170\168\235\147\160 \235\176\156\235\143\132\235\138\148 \236\185\188\236\167\145\236\151\144\236\132\156 \236\139\156\236\158\145\237\149\180\236\154\148.",
		["PRESS {Equip}"] = "{Equip} \235\136\132\235\165\180\234\184\176",
		["Tap **SHEATHE** to sheathe the blade. Every draw starts from the sheath."] = "**\235\130\169\235\143\132**\235\165\188 \237\131\173\237\149\180 \236\185\188\236\157\132 \236\185\188\236\167\145\236\151\144 \235\132\163\236\156\188\236\132\184\236\154\148. \235\170\168\235\147\160 \235\176\156\235\143\132\235\138\148 \236\185\188\236\167\145\236\151\144\236\132\156 \236\139\156\236\158\145\237\149\180\236\154\148.",
		["TAP SHEATHE"] = "\235\130\169\235\143\132 \237\131\173",
		["Vertical slice"] = "\236\132\184\235\161\156 \235\178\160\234\184\176",
		["Walk up close. Move the mouse **up**. Then **hold {Draw}** and **swipe down**."] = "\234\176\128\234\185\140\236\157\180 \235\139\164\234\176\128\234\176\128\236\132\184\236\154\148. \235\167\136\236\154\176\236\138\164\235\165\188 **\236\156\132\235\161\156** \236\152\174\234\184\176\236\132\184\236\154\148. \234\183\184\235\139\164\236\157\140 **{Draw} \235\136\132\235\165\184 \236\177\132** **\236\149\132\235\158\152\235\161\156 \236\138\164\236\153\128\236\157\180\237\148\132**\237\149\152\236\132\184\236\154\148.",
		["MOVE UP"] = "\236\156\132\235\161\156",
		["SWIPE DOWN"] = "\236\149\132\235\158\152\235\161\156 \236\138\164\236\153\128\236\157\180\237\148\132",
		["Walk up close. Then **flick down** on the right side of the screen."] = "\234\176\128\234\185\140\236\157\180 \235\139\164\234\176\128\234\176\128\236\132\184\236\154\148. \234\183\184\235\139\164\236\157\140 \237\153\148\235\169\180 \236\152\164\235\165\184\236\170\189\236\151\144\236\132\156 **\236\149\132\235\158\152\235\161\156 \237\148\140\235\166\173**\237\149\152\236\132\184\236\154\148.",
		["FLICK DOWN"] = "\236\149\132\235\158\152\235\161\156 \237\148\140\235\166\173",
		["Weakened: wipe the blade"] = "\236\149\189\237\153\148: \236\185\188\235\130\160 \235\139\166\234\184\176",
		["Poise broken: **weakened** (slow, no jumping). Press **{Wipe}** to wipe the blade and recover."] = "\236\158\144\236\132\184\234\176\128 \235\172\180\235\132\136\236\161\140\236\150\180\236\154\148: **\236\149\189\237\153\148** \236\131\129\237\131\156\236\152\136\236\154\148 (\235\138\144\235\160\164\236\167\128\234\179\160 \236\160\144\237\148\132 \235\182\136\234\176\128). **{Wipe}** \237\130\164\235\165\188 \235\136\140\235\159\172 \236\185\188\235\130\160\236\157\132 \235\139\166\234\179\160 \237\154\140\235\179\181\237\149\152\236\132\184\236\154\148.",
		["PRESS {Wipe}"] = "{Wipe} \235\136\132\235\165\180\234\184\176",
		["Poise broken: **weakened** (slow, no jumping). Tap **WIPE** to wipe the blade and recover."] = "\236\158\144\236\132\184\234\176\128 \235\172\180\235\132\136\236\161\140\236\150\180\236\154\148: **\236\149\189\237\153\148** \236\131\129\237\131\156\236\152\136\236\154\148 (\235\138\144\235\160\164\236\167\128\234\179\160 \236\160\144\237\148\132 \235\182\136\234\176\128). **\235\139\166\234\184\176**\235\165\188 \237\131\173\237\149\180 \236\185\188\235\130\160\236\157\132 \235\139\166\234\179\160 \237\154\140\235\179\181\237\149\152\236\132\184\236\154\148.",
		["TAP WIPE"] = "\235\139\166\234\184\176 \237\131\173",
		["Dash attack"] = "\235\140\128\236\139\156 \234\179\181\234\178\169",
		["Blade out, walk up close. Hold **W + A** to walk past the watermelon, then press **{Dash}** to dash through it."] = "\236\185\188\236\157\132 \235\189\145\234\179\160 \234\176\128\234\185\140\236\157\180 \235\139\164\234\176\128\234\176\128\236\132\184\236\154\148. **W + A**\235\165\188 \235\136\132\235\165\184 \236\177\132 \236\136\152\235\176\149 \236\152\134\236\157\132 \236\167\128\235\130\152\234\176\128\235\139\164\234\176\128 **{Dash}** \237\130\164\235\165\188 \235\136\140\235\159\172 \235\140\128\236\139\156\235\161\156 \235\178\160\234\179\160 \236\167\128\235\130\152\234\176\128\236\132\184\236\154\148.",
		["HOLD W + A"] = "W + A \235\136\132\235\165\184 \236\177\132\235\161\156",
		["PRESS {Dash}"] = "{Dash} \235\136\132\235\165\180\234\184\176",
		["Blade out, walk up close. Walk past the watermelon, then tap **DASH** to dash through it."] = "\236\185\188\236\157\132 \235\189\145\234\179\160 \234\176\128\234\185\140\236\157\180 \235\139\164\234\176\128\234\176\128\236\132\184\236\154\148. \236\136\152\235\176\149 \236\152\134\236\157\132 \236\167\128\235\130\152\234\176\128\235\139\164\234\176\128 **\235\140\128\236\139\156**\235\165\188 \237\131\173\237\149\180 \235\178\160\234\179\160 \236\167\128\235\130\152\234\176\128\236\132\184\236\154\148.",
		["WALK PAST IT"] = "\236\152\134\236\156\188\235\161\156 \236\167\128\235\130\152\234\176\128\234\184\176",
		["TAP DASH"] = "\235\140\128\236\139\156 \237\131\173",
		["That was the low cut"] = "\234\183\184\234\177\180 \237\149\152\235\139\168 \235\178\160\234\184\176\236\152\128\236\150\180\236\154\148",
		["That was the horizontal slice"] = "\234\183\184\234\177\180 \234\176\128\235\161\156 \235\178\160\234\184\176\236\152\128\236\150\180\236\154\148",
		["That was a diagonal cut"] = "\234\183\184\234\177\180 \236\130\172\236\132\160 \235\178\160\234\184\176\236\152\128\236\150\180\236\154\148",
		["That was the vertical slice"] = "\234\183\184\234\177\180 \236\132\184\235\161\156 \235\178\160\234\184\176\236\152\128\236\150\180\236\154\148",
		["That was another draw"] = "\234\183\184\234\177\180 \235\139\164\235\165\184 \235\176\156\235\143\132\236\152\128\236\150\180\236\154\148",
		["That was a swing"] = "\234\183\184\234\177\180 \234\183\184\235\131\165 \237\156\152\235\145\144\235\165\180\234\184\176\236\152\128\236\150\180\236\154\148",
		["move the mouse **left**, then **hold {Draw}** and **swipe right**"] = "\235\167\136\236\154\176\236\138\164\235\165\188 **\236\153\188\236\170\189**\236\156\188\235\161\156 \236\152\174\234\184\176\234\179\160 **{Draw} \235\136\132\235\165\184 \236\177\132** **\236\152\164\235\165\184\236\170\189\236\156\188\235\161\156 \236\138\164\236\153\128\236\157\180\237\148\132**\237\149\152\236\132\184\236\154\148",
		["move the mouse **up**, then **hold {Draw}** and **swipe down**"] = "\235\167\136\236\154\176\236\138\164\235\165\188 **\236\156\132\235\161\156** \236\152\174\234\184\176\234\179\160 **{Draw} \235\136\132\235\165\184 \236\177\132** **\236\149\132\235\158\152\235\161\156 \236\138\164\236\153\128\236\157\180\237\148\132**\237\149\152\236\132\184\236\154\148",
		["draw again"] = "\235\139\164\236\139\156 \235\176\156\235\143\132\237\149\152\236\132\184\236\154\148",
		["**flick right** on the right side of the screen"] = "\237\153\148\235\169\180 \236\152\164\235\165\184\236\170\189\236\151\144\236\132\156 **\236\152\164\235\165\184\236\170\189\236\156\188\235\161\156 \237\148\140\235\166\173**\237\149\152\236\132\184\236\154\148",
		["**flick down** on the right side of the screen"] = "\237\153\148\235\169\180 \236\152\164\235\165\184\236\170\189\236\151\144\236\132\156 **\236\149\132\235\158\152\235\161\156 \237\148\140\235\166\173**\237\149\152\236\132\184\236\154\148",
		["Rusted, the cord rotten"] = "\235\133\185\236\138\172\234\179\160 \235\129\136\236\157\128 \236\141\169\236\157\140",
		["Rust polished away"] = "\235\133\185\236\157\132 \234\176\136\236\149\132 \236\151\134\236\149\176",
		["Black silk on the handle and cords"] = "\236\134\144\236\158\161\236\157\180\236\153\128 \235\129\136\236\151\144 \234\178\128\236\157\128 \235\185\132\235\139\168",
		["Bright silver fittings"] = "\235\185\155\235\130\152\235\138\148 \236\157\128 \236\158\165\236\139\157",
		["Black lacquered sheath"] = "\234\178\128\236\157\128 \236\152\187\236\185\160 \236\185\188\236\167\145",
		["Temper line polished, purple silk"] = "\236\185\188\235\130\160 \235\172\180\235\138\172 \236\151\176\235\167\136, \235\179\180\235\157\188\236\131\137 \235\185\132\235\139\168",
		["Best of 5: the first to {wins} round wins."] = "5\237\140\144 \236\138\185\235\182\128: \235\168\188\236\160\128 {wins}\235\157\188\236\154\180\235\147\156\235\165\188 \236\157\180\234\184\176\235\169\180 \236\138\185\235\166\172.",
		["Every attack is a draw-cut that strikes through any blade. No guard."] = "\235\170\168\235\147\160 \234\179\181\234\178\169\236\157\180 \236\150\180\235\150\164 \236\185\188\235\130\160\235\143\132 \235\154\171\234\179\160 \235\178\160\235\138\148 \235\176\156\235\143\132 \235\178\160\234\184\176\236\152\136\236\154\148. \234\176\128\235\147\156 \236\151\134\236\157\140.",
		["Fight from the sheath: every draw-cut strikes through any blade, and the blade goes straight back in."] = "\236\185\188\236\167\145\236\151\144\236\132\156 \236\139\184\236\155\140\236\154\148: \235\170\168\235\147\160 \235\176\156\235\143\132 \235\178\160\234\184\176\234\176\128 \236\150\180\235\150\164 \236\185\188\235\130\160\235\143\132 \235\154\171\234\179\160, \236\185\188\236\157\128 \235\176\148\235\161\156 \236\185\188\236\167\145\236\156\188\235\161\156 \235\143\140\236\149\132\234\176\128\236\154\148.",
		["10 rename spins"] = "\234\176\156\235\170\133\234\182\140 10\234\176\156",
		["50 rename spins"] = "\234\176\156\235\170\133\234\182\140 50\234\176\156",
		["Each column is a string: hold a key, then pluck that string."] = "\234\176\129 \236\151\180\236\157\180 \237\149\156 \236\164\132\236\157\180\236\151\144\236\154\148: \237\130\164\235\165\188 \235\136\132\235\165\184 \236\177\132 \234\183\184 \236\164\132\236\157\132 \237\138\149\234\184\176\236\132\184\236\154\148.",
		["TACHI restored: stage {stage}, {name}"] = "\237\131\128\236\185\152 \235\179\181\236\155\144: {stage}\235\139\168\234\179\132, {name}",
		["You can only bow for a 1v1 with someone you could fight right now, in the same ring."] = "1v1 \236\157\184\236\130\172\235\138\148 \236\167\128\234\184\136 \234\176\153\236\157\128 \235\167\129\236\151\144\236\132\156 \236\139\184\236\154\184 \236\136\152 \236\158\136\235\138\148 \236\131\129\235\140\128\236\151\144\234\178\140\235\167\140 \237\149\160 \236\136\152 \236\158\136\236\150\180\236\154\148.",
		["The rematch can\'t start: you both need to be in the same ring."] = "\236\158\172\235\140\128\234\178\176\236\157\132 \236\139\156\236\158\145\237\149\160 \236\136\152 \236\151\134\236\150\180\236\154\148: \235\145\152 \235\139\164 \234\176\153\236\157\128 \235\167\129\236\151\144 \236\158\136\236\150\180\236\149\188 \237\149\180\236\154\148.",
		["Positions 1 to 9: hold one, then pluck."] = "\237\143\172\236\167\128\236\133\152 1~9: \237\149\152\235\130\152\235\165\188 \235\136\132\235\165\184 \236\177\132 \236\164\132\236\157\132 \237\138\149\234\184\176\236\132\184\236\154\148.",
		["Finish a daily quest"] = "\236\157\188\236\157\188 \237\128\152\236\138\164\237\138\184 1\234\176\156 \236\153\132\235\163\140",
		["VENGEFUL EMPRESS"] = "\235\179\181\236\136\152\236\157\152 \236\151\172\236\160\156",
		["THE TEMPLE GHOST"] = "\236\160\136\236\157\152 \236\156\160\235\160\185",
		["Reroll your first name as often as you like, or spin a new family name ({count} spin)."] = "\236\157\180\235\166\132\236\157\128 \236\155\144\237\149\152\235\138\148 \235\167\140\237\129\188 \235\139\164\236\139\156 \235\189\145\236\157\132 \236\136\152 \236\158\136\234\179\160, \236\131\136 \236\132\177\236\148\168\235\143\132 \235\189\145\236\157\132 \236\136\152 \236\158\136\236\150\180\236\154\148 (\234\176\156\235\170\133\234\182\140 {count}\234\176\156).",
		["Reroll your first name as often as you like, or spin a new family name ({count} spins)."] = "\236\157\180\235\166\132\236\157\128 \236\155\144\237\149\152\235\138\148 \235\167\140\237\129\188 \235\139\164\236\139\156 \235\189\145\236\157\132 \236\136\152 \236\158\136\234\179\160, \236\131\136 \236\132\177\236\148\168\235\143\132 \235\189\145\236\157\132 \236\136\152 \236\158\136\236\150\180\236\154\148 (\234\176\156\235\170\133\234\182\140 {count}\234\176\156).",
		["Reroll your first name as often as you like."] = "\236\157\180\235\166\132\236\157\128 \236\155\144\237\149\152\235\138\148 \235\167\140\237\129\188 \235\139\164\236\139\156 \235\189\145\236\157\132 \236\136\152 \236\158\136\236\150\180\236\154\148.",
		["REROLL FIRST NAME"] = "\236\157\180\235\166\132 \235\139\164\236\139\156 \235\189\145\234\184\176",
		["Couldn\'t roll. Try again."] = "\235\189\145\236\167\128 \235\170\187\237\150\136\236\150\180\236\154\148. \235\139\164\236\139\156 \236\139\156\235\143\132\237\149\152\236\132\184\236\154\148.",
		["REROLL"] = "\235\139\164\236\139\156 \235\189\145\234\184\176",
		["Roll a first name first."] = "\235\168\188\236\160\128 \236\157\180\235\166\132\236\157\132 \235\189\145\236\156\188\236\132\184\236\154\148.",
		["RARER THAN YOURS"] = "\235\130\180 \234\178\131\235\179\180\235\139\164 \237\157\172\234\183\128",
		["LEGENDARY AND UP"] = "\236\160\132\236\132\164 \236\157\180\236\131\129",
		["ASK TWICE FOR EXOTIC"] = "\236\180\136\236\155\148\236\157\128 \235\145\144 \235\178\136 \237\153\149\236\157\184",
		["{on} OF {all}"] = "{all}\234\176\156 \236\164\145 {on}\234\176\156",
		["Asks before a spin throws away a family name."] = "\235\189\145\234\184\176\235\161\156 \236\132\177\236\148\168\235\165\188 \235\178\132\235\166\172\234\184\176 \236\160\132\236\151\144 \235\172\188\236\150\180\235\180\133\235\139\136\235\139\164.",
		["You\'ll lose {names} and {count} more."] = "{names} \236\153\184 {count}\234\176\156\235\165\188 \236\158\131\234\178\140 \235\144\169\235\139\136\235\139\164.",
		["You\'ll lose {names}."] = "{names}\236\157\132(\235\165\188) \236\158\131\234\178\140 \235\144\169\235\139\136\235\139\164.",
		["Are you sure?"] = "\236\160\149\235\167\144\236\157\184\234\176\128\236\154\148?",
		["{names} will be gone for good."] = "{names}\236\157\128(\235\138\148) \236\152\129\236\152\129 \236\130\172\235\157\188\236\167\145\235\139\136\235\139\164.",
		["Peaceful: out in the forest nobody can hurt you, and you can\'t hurt anyone. In the rings you fight as usual."] = "\237\143\137\237\153\148 \235\170\168\235\147\156: \236\136\178\236\151\144\236\132\156\235\138\148 \236\149\132\235\172\180\235\143\132 \235\139\185\236\139\160\236\157\132 \235\139\164\236\185\152\234\178\140 \237\149\160 \236\136\152 \236\151\134\234\179\160, \235\139\185\236\139\160\235\143\132 \236\149\132\235\172\180\235\143\132 \235\139\164\236\185\152\234\178\140 \237\149\160 \236\136\152 \236\151\134\236\150\180\236\154\148. \235\167\129 \236\149\136\236\151\144\236\132\156\235\138\148 \237\143\137\236\134\140\236\178\152\235\159\188 \236\139\184\236\155\140\236\154\148.",
		["Peaceful: nobody can hurt you, and you can\'t hurt anyone. In the beginners\' ring and the boss arena you fight as usual."] = "\237\143\137\237\153\148 \235\170\168\235\147\156: \236\149\132\235\172\180\235\143\132 \235\139\185\236\139\160\236\157\132 \235\139\164\236\185\152\234\178\140 \237\149\160 \236\136\152 \236\151\134\234\179\160, \235\139\185\236\139\160\235\143\132 \236\149\132\235\172\180\235\143\132 \235\139\164\236\185\152\234\178\140 \237\149\160 \236\136\152 \236\151\134\236\150\180\236\154\148. \236\180\136\235\179\180\236\158\144 \235\167\129\234\179\188 \235\179\180\236\138\164 \234\178\189\234\184\176\236\158\165\236\151\144\236\132\156\235\138\148 \237\143\137\236\134\140\236\178\152\235\159\188 \236\139\184\236\155\140\236\154\148.",
		["BONFIRE"] = "\235\170\168\235\139\165\235\182\136",
		["LAST LOCATION"] = "\235\167\136\236\167\128\235\167\137 \236\156\132\236\185\152",
		["Outside the ring: sword lowered"] = "\235\167\129 \235\176\150: \236\185\188\236\157\132 \235\130\180\235\166\188",
		["Outside the ring: sword sheathed"] = "\235\167\129 \235\176\150: \236\185\188\236\157\180 \235\130\169\235\143\132\235\144\168",
		["Find bonfires out in the world to travel between them."] = "\234\179\179\234\179\179\236\157\152 \235\170\168\235\139\165\235\182\136\236\157\132 \236\176\190\236\149\132 \234\183\184 \236\130\172\236\157\180\235\165\188 \236\157\180\235\143\153\237\149\152\236\132\184\236\154\148.",
		["Tap a bonfire you\'ve found to travel there."] = "\236\176\190\236\157\128 \235\170\168\235\139\165\235\182\136\236\157\132 \237\131\173\237\149\152\235\169\180 \234\183\184\234\179\179\236\156\188\235\161\156 \236\157\180\235\143\153\237\149\180\236\154\148.",
		["Click a bonfire you\'ve found to travel there."] = "\236\176\190\236\157\128 \235\170\168\235\139\165\235\182\136\236\157\132 \237\129\180\235\166\173\237\149\152\235\169\180 \234\183\184\234\179\179\236\156\188\235\161\156 \236\157\180\235\143\153\237\149\180\236\154\148.",
		["Bonfire found: {name}"] = "\235\170\168\235\139\165\235\182\136 \235\176\156\234\178\172: {name}",
		["Rested at {name}. You\'ll start here when you next play."] = "{name}\236\151\144\236\132\156 \236\137\172\236\151\136\236\150\180\236\154\148. \235\139\164\236\157\140\236\151\144 \237\148\140\235\160\136\236\157\180\237\149\152\235\169\180 \236\151\172\234\184\176\236\132\156 \236\139\156\236\158\145\237\149\180\236\154\148.",
		["You haven\'t found that bonfire yet."] = "\236\149\132\236\167\129 \234\183\184 \235\170\168\235\139\165\235\182\136\236\157\132 \236\176\190\236\167\128 \235\170\187\237\150\136\236\150\180\236\154\148.",
		["{upgrade}.  {look}"] = "{upgrade}.  {look}",
		["REFORGE"] = "\236\158\172\235\139\168\236\161\176",
		["Forge your next upgrade, or reforge your blade to a rank you\'ve already forged."] = "\235\139\164\236\157\140 \234\176\149\237\153\148\235\165\188 \235\139\168\236\161\176\237\149\152\234\177\176\235\130\152, \236\157\180\235\175\184 \235\139\168\236\161\176\237\149\156 \235\147\177\234\184\137\236\156\188\235\161\156 \236\185\188\236\157\132 \236\158\172\235\139\168\236\161\176\237\149\152\236\132\184\236\154\148.",
		["FORGE RANK {rank}   {name}"] = "\235\139\168\236\161\176 \235\147\177\234\184\137 {rank}   {name}",
		["unlocks at level {level} (you\'re level {yours})"] = "\235\160\136\235\178\168 {level}\236\151\144 \237\149\180\234\184\136 (\237\152\132\236\158\172 \235\160\136\235\178\168 {yours})",
		["RANK {rank}   {name}   (in use)"] = "\235\147\177\234\184\137 {rank}   {name}   (\236\130\172\236\154\169 \236\164\145)",
		["Dark blade, crimson edge, red lightning, a glow that flares as it drinks."] = "\234\178\128\236\157\128 \236\185\188\235\130\160, \236\167\132\237\153\141\235\185\155 \235\130\160, \235\182\137\236\157\128 \235\178\136\234\176\156, \237\148\188\235\165\188 \235\167\136\236\139\164\236\136\152\235\161\157 \237\131\128\236\152\164\235\165\180\235\138\148 \235\185\155.",
		["FIND IT"] = "\236\176\190\234\184\176",
		["{short} Find it in the rooms of the temple on the hill."] = "{short} \236\150\184\235\141\149 \236\156\132 \236\130\172\236\155\144\236\157\152 \235\176\169\236\151\144\236\132\156 \236\176\190\236\156\188\236\132\184\236\154\148.",
		["Blade length 3.2 studs"] = "\236\185\188\235\130\160 \234\184\184\236\157\180 3.2 \236\138\164\237\132\176\235\147\156",
		["Blade length 3.4 studs, draw styles (coming soon)"] = "\236\185\188\235\130\160 \234\184\184\236\157\180 3.4 \236\138\164\237\132\176\235\147\156, \235\176\156\235\143\132 \236\138\164\237\131\128\236\157\188 (\236\182\156\236\139\156 \236\152\136\236\160\149)",
		["+5% walk speed"] = "\236\157\180\235\143\153 \236\134\141\235\143\132 +5%",
		["+5% walk speed, 25% faster poise recovery"] = "\236\157\180\235\143\153 \236\134\141\235\143\132 +5%, \236\158\144\236\132\184 \237\154\140\235\179\181 25% \235\185\168\235\157\188\236\167\144",
		["After {delay} seconds of calm it comes back, {regen} a second: faster with a still guard (L2 on a gamepad), slower with little blood.\n\nBelow half, your feet slow down. The lower it is, the heavier your blade and the more easily it\'s knocked aside."] = "{delay}\236\180\136 \235\143\153\236\149\136 \236\149\132\235\172\180 \236\157\188\236\157\180 \236\151\134\236\156\188\235\169\180 \236\180\136\235\139\185 {regen}\236\148\169 \237\154\140\235\179\181\235\143\188\236\154\148: \235\169\136\236\182\152 \234\176\128\235\147\156(\234\178\140\236\158\132\237\140\168\235\147\156 L2)\235\169\180 \235\141\148 \235\185\160\235\165\180\234\179\160, \237\148\188\234\176\128 \236\160\129\236\156\188\235\169\180 \235\141\148 \235\138\144\235\160\164\236\154\148.\n\n\236\160\136\235\176\152 \236\149\132\235\158\152\235\161\156 \235\150\168\236\150\180\236\167\128\235\169\180 \235\176\156\236\157\180 \235\138\144\235\160\164\236\160\184\236\154\148. \235\130\174\236\157\132\236\136\152\235\161\157 \236\185\188\236\157\180 \235\172\180\234\177\176\236\155\140\236\167\128\234\179\160 \235\141\148 \236\137\189\234\178\140 \237\138\149\234\178\168 \235\130\152\234\176\128\236\154\148.",
		["<b>Wiping resets your poise.</b> While the cloth is on the blade, poise comes back {times} times as fast, and a finished wipe fills it to full.\n\nIt works after a break too: finishing a wipe ends being weakened.\n\nA finished wipe also gives back all your dashes."] = "<b>\236\185\188\235\130\160\236\157\132 \235\139\166\236\156\188\235\169\180 \236\158\144\236\132\184\234\176\128 \237\154\140\235\179\181\235\143\188\236\154\148.</b> \236\178\156\236\157\180 \236\185\188\235\130\160\236\151\144 \235\139\191\236\149\132 \236\158\136\235\138\148 \235\143\153\236\149\136 \236\158\144\236\132\184\234\176\128 {times}\235\176\176 \235\185\168\235\166\172 \235\143\140\236\149\132\236\152\164\234\179\160, \235\139\164 \235\139\166\236\156\188\235\169\180 \234\176\128\235\147\157 \236\176\168\236\154\148.\n\n\236\158\144\236\132\184\234\176\128 \235\172\180\235\132\136\236\167\132 \235\146\164\236\151\144\235\143\132 \237\134\181\237\149\180\236\154\148: \235\139\166\234\184\176\235\165\188 \235\129\157\235\130\180\235\169\180 \236\149\189\237\153\148\234\176\128 \237\146\128\235\160\164\236\154\148.\n\n\235\139\166\234\184\176\235\165\188 \235\129\157\235\130\180\235\169\180 \235\140\128\236\139\156\235\143\132 \235\170\168\235\145\144 \235\143\140\236\149\132\236\153\128\236\154\148.",
		["tap WIPE to refill dashes"] = "[\235\139\166\234\184\176]\235\165\188 \237\131\173\237\149\180 \235\140\128\236\139\156 \236\182\169\236\160\132",
		["{key}  wipe to refill dashes"] = "{key}  \236\185\188\235\130\160\236\157\132 \235\139\166\236\149\132 \235\140\128\236\139\156 \236\182\169\236\160\132",
		["Out of dashes. Tap **WIPE** to wipe your blade and get them back."] = "\235\140\128\236\139\156\235\165\188 \235\139\164 \236\141\188\236\150\180\236\154\148. **\235\139\166\234\184\176**\235\165\188 \237\131\173\237\149\180 \236\185\188\235\130\160\236\157\132 \235\139\166\236\156\188\235\169\180 \235\139\164\236\139\156 \236\177\132\236\155\140\236\160\184\236\154\148.",
		["Out of dashes. Press **{Wipe}** to wipe your blade and get them back."] = "\235\140\128\236\139\156\235\165\188 \235\139\164 \236\141\188\236\150\180\236\154\148. **{Wipe}** \237\130\164\235\161\156 \236\185\188\235\130\160\236\157\132 \235\139\166\236\156\188\235\169\180 \235\139\164\236\139\156 \236\177\132\236\155\140\236\160\184\236\154\148.",
		["+1% walk speed"] = "\236\157\180\235\143\153 \236\134\141\235\143\132 +1%",
		["10% less poise lost to hits and clashes"] = "\237\148\188\234\178\169\234\179\188 \236\185\188 \235\182\128\235\148\170\237\158\152\236\156\188\235\161\156 \236\158\131\235\138\148 \236\158\144\236\132\184 10% \234\176\144\236\134\140",
		["10% less poise lost to hits and clashes, 15% quicker back from knocks"] = "\237\148\188\234\178\169\234\179\188 \236\185\188 \235\182\128\235\148\170\237\158\152\236\156\188\235\161\156 \236\158\131\235\138\148 \236\158\144\236\132\184 10% \234\176\144\236\134\140, \237\138\149\234\178\168 \235\130\152\234\176\132 \235\146\164 \237\154\140\235\179\181 15% \235\185\168\235\157\188\236\167\144",
		["+1% walk speed, 25% faster poise recovery"] = "\236\157\180\235\143\153 \236\134\141\235\143\132 +1%, \236\158\144\236\132\184 \237\154\140\235\179\181 25% \235\185\168\235\157\188\236\167\144",
		["+20 blood"] = "\237\148\188 +20",
		["UPGRADE READY"] = "\234\176\149\237\153\148 \234\176\128\235\138\165",
		["the forge"] = "\235\140\128\236\158\165\234\176\132",
		["New look"] = "\236\131\136\235\161\156\236\154\180 \236\153\184\237\152\149",
		["Draw styles (coming soon)"] = "\235\176\156\235\143\132 \236\138\164\237\131\128\236\157\188 (\236\182\156\236\139\156 \236\152\136\236\160\149)",
		["SINGLE"] = "\236\157\188\235\143\132\235\165\152",
		["DUAL WIELD"] = "\236\157\180\235\143\132\235\165\152",
		["IAI"] = "\234\177\176\237\149\169",
		["Robux spins aren\'t sold on your account. Ry\197\141 and levels still give them."] = "\236\157\180 \234\179\132\236\160\149\236\151\144\236\132\156\235\138\148 \235\161\156\235\178\133\236\138\164 \234\176\156\235\170\133\234\182\140\236\157\132 \237\140\148\236\167\128 \236\149\138\236\149\132\236\154\148. \228\184\161 \234\181\172\235\167\164\236\153\128 \235\160\136\235\178\168 \236\151\133\236\156\188\235\161\156\235\138\148 \234\179\132\236\134\141 \236\150\187\236\157\132 \236\136\152 \236\158\136\236\150\180\236\154\148.",
		["Beginners\' ring: under level {level} only"] = "\236\180\136\235\179\180\236\158\144 \235\167\129: \235\160\136\235\178\168 {level} \235\175\184\235\167\140\235\167\140"
	}
}
return v1]]></ProtectedString>
