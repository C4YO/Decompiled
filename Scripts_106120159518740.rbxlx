		p468:ReactBench()
		p468:FlashBurst(35)
	else
		p468:PlayMoment("Crowd", "TheirBucket", false, true)
		p468:PlayMoment("Commentary", p468.LastScorer == 1 and "AnswerBack" or "TheirBucket")
	end
	p468.LastScorer = p469
	local v470 = p468:GetCourtAttributes()
	if v470 and v470:GetAttribute("Team1Score") == v470:GetAttribute("Team2Score") then
		p468:PlayMoment("Commentary", "TieGame")
		p468:PlayMoment("Commentary", "Intense")
	end
end
function v11.OnPossession(p471, p472) -- name: OnPossession
