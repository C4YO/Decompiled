function v12.PageLoad(p117, p118) -- name: PageLoad
	-- upvalues: (ref) v_u_4, (copy) v_u_9
	local v119 = {}
	local v120 = v_u_4.ProfileData.Inventory and (v_u_4.ProfileData.Inventory[p118] or {}) or {}
	local v121 = p117.Shared.Config.Accessories[p118]
	if v121 then
		for v122, v123 in v120 do
			local v124 = v121[v122]
			local v125 = (p118 == "Shirt" or p118 == "Pants") and v122:lower():match("asset") and {
				["VisualName"] = "Avatar Import",
				["Tags"] = nil,
				["AssetId"] = nil,
				["Tags"] = {},
				["AssetId"] = v122
			} or v124
			if not v125 then
				continue
			end
			v119[v122] = {
				["VisualName"] = v125.VisualName,
				["Color"] = Color3.fromRGB(table.unpack(v123)),
				["Tags"] = v125.Tags,
				["Id"] = v125.AssetId
			}
			if p118 ~= "Shoes" then
				continue
			end
			local v126 = string.split(v125.ShoeId, "_")
			local v127 = v126[1]
			local v128 = v126[2] or "Base"
			local v129 = v128 == "" and "Base" or v128
			local v130 = v_u_9.Accessories.Shoes:FindFirstChild(v127):FindFirstChild(v129)
			v119[v122].Model = v130
			v119[v122].Name = v122
		end
	end
	if p118 == "Vehicles" then
		for v131, v132 in v120 do
			v119[v131] = v132
		end
		for _, v133 in v_u_9.Assets.Models.Vehicles:GetChildren() do
			local v134 = v133:FindFirstChild("Model")
			if v134 then
				v134 = v133.Model:FindFirstChild("Packet")
			end
			if not v134 or (v119[v133.Name] or not require(v134).Default) then
				continue
			end
			v119[v133.Name] = {}
		end
	end
	if p118 == "Mascots" then
		for v135, v136 in v120 do
			v119[v135] = v136
		end
	end
	p117:LoadPage(p118, v119, function(p137)
		warn("equip", p137)
	end)
end
