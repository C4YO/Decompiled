			-- upvalues: (copy) p_u_197
			p_u_197:Step(p198)
		end)
		p_u_197.InputBeganConnection = v_u_2.InputBegan:Connect(function(p199, p200)
			-- upvalues: (copy) p_u_197, (ref) v_u_2
			local v201 = Vector2.new(p199.Position.X, p199.Position.Y)
			if p199.UserInputType == Enum.UserInputType.Touch then
				if p200 or p_u_197:OverMenu(v201) then
					p_u_197.MenuTouches[p199] = true
				else
					p_u_197.WorldTouches[p199] = v201
					p_u_197.Pinch = nil
				end
			elseif p200 or p199.UserInputType ~= Enum.UserInputType.MouseButton2 then
				return
			elseif not p_u_197:OverMenu(v201) then
				p_u_197.Dragging = true
				v_u_2.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			end
		end)
		p_u_197.InputEndedConnection = v_u_2.InputEnded:Connect(function(p202)
