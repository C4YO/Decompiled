			table.remove(p50.Teams.Home, table.find(p50.Teams.Home, v52.Name))
		end
		if table.find(p50.Teams.Away, v52.Name) then
			table.remove(p50.Teams.Away, table.find(p50.Teams.Away, v52.Name))
		end
		if p51 ~= "Neutral" then
