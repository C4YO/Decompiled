              <Item class="ModuleScript" referent="RBX641">
                <Properties>
                  <string name="Name">Takeover</string>
                  <ProtectedString name="Source"><![CDATA[local v33 = {
	["Playmaking"] = {
		["Artist"] = function(p1)
			local v2
			if p1.Attributes.Speed >= 90 and (p1.Attributes.Acceleration >= 85 and p1.Attributes.BallHandle >= 88) then
				v2 = p1.Position == "PG" and true or p1.Position == "SG"
			else
				v2 = false
			end
			return v2
		end,
		["Downhill"] = function(p3)
			local v4
			if p3.Attributes.Speed >= 85 and (p3.Attributes.Acceleration >= 80 and p3.Attributes.BallHandle >= 81) then
				v4 = (p3.Position == "PG" or p3.Position == "SG") and true or p3.Position == "SF"
			else
				v4 = false
			end
			return v4
		end,
		["Team Riser"] = function(p5)
			local v6
			if p5.Attributes.PassAccuracy >= 90 then
				v6 = p5.Position == "PG"
			else
				v6 = false
			end
			return v6
		end,
		["Control Tower"] = function(p7)
			local v8
			if p7.Attributes.PassAccuracy >= 88 and (p7.Attributes.PostControl >= 88 and p7.Attributes.Speed >= 70) then
				v8 = p7.Position == "PF" and true or p7.Position == "C"
			else
				v8 = false
			end
			return v8
		end
	},
	["Shooting"] = {
		["Knockdown Shooter"] = function(p9)
			local v10
			if p9.Attributes.ThreePointShot >= 80 then
				v10 = p9.Attributes.MidRangeShot >= 80
			else
				v10 = false
			end
			return v10
		end,
		["Fadeaway King"] = function(p11)
			local v12
			if p11.Attributes.MidRangeShot >= 88 and p11.Attributes.MovingShot >= 84 then
				v12 = (p11.Position == "PG" or p11.Position == "SG") and true or p11.Position == "SF"
			else
				v12 = false
			end
			return v12
		end,
		["Post General"] = function(p13)
			local v14
			if p13.Attributes.PostControl >= 83 and (p13.Attributes.MidRangeShot >= 80 and p13.Attributes.Strength >= 80) then
				v14 = (p13.Position == "SF" or p13.Position == "PF") and true or p13.Position == "C"
			else
				v14 = false
			end
			return v14
		end,
		["Smooth Operator"] = function(p15)
			local v16
			if p15.Attributes.MidRangeShot >= 90 and p15.Attributes.ThreePointShot >= 85 then
				v16 = (p15.Position == "PG" or p15.Position == "SG") and true or p15.Position == "SF"
			else
				v16 = false
			end
			return v16
		end
	},
	["Defense"] = {
		["Board Hunter"] = function(p17)
			local v18
			if p17.Attributes.Rebound >= 90 and (p17.Attributes.Strength >= 85 and p17.Attributes.Vertical >= 70) then
				v18 = p17.Position == "PF" and true or p17.Position == "C"
			else
				v18 = false
			end
			return v18
		end,
		["Hound"] = function(p19)
			local v20
			if p19.Attributes.LateralSpeed >= 90 and (p19.Attributes.Steal >= 87 and p19.Attributes.PerimeterDefense >= 81) then
				v20 = (p19.Position == "PG" or p19.Position == "SG") and true or p19.Position == "SF"
			else
				v20 = false
			end
			return v20
		end,
		["Glue Guy"] = function(p21)
			local v22
			if p21.Attributes.Stamina >= 90 and (p21.Attributes.PerimeterDefense >= 81 and (p21.Attributes.Speed >= 80 and p21.Attributes.Rebound >= 59)) then
				v22 = (p21.Position == "PG" or (p21.Position == "SG" or p21.Position == "SF")) and true or p21.Position == "PF"
			else
				v22 = false
			end
			return v22
		end,
		["Paint Controller"] = function(p23)
			local v24
			if p23.Attributes.Block >= 90 and (p23.Attributes.InteriorDefense >= 89 and (p23.Attributes.Vertical >= 71 and p23.Attributes.Speed >= 70)) then
				v24 = p23.Position == "PF" and true or p23.Position == "C"
			else
				v24 = false
			end
			return v24
		end
	},
	["Finishing"] = {
		["Crafty Finisher"] = function(p25)
			local v26
			if p25.Attributes.DrivingLayup >= 80 and p25.Attributes.Vertical >= 80 then
				v26 = (p25.Position == "PG" or p25.Position == "SG") and true or p25.Position == "SF"
			else
				v26 = false
			end
			return v26
		end,
		["Highlight Reel"] = function(p27)
			local v28
			if p27.Attributes.DrivingDunk >= 81 and (p27.Attributes.Vertical >= 80 and p27.Attributes.Strength >= 65) then
				v28 = (p27.Position == "SG" or p27.Position == "SF") and true or p27.Position == "PF"
			else
				v28 = false
			end
			return v28
		end,
		["Rim Rocker"] = function(p29)
			local v30
			if (p29.Attributes.DrivingDunk >= 87 or p29.Attributes.StandingDunk >= 87) and p29.Attributes.Vertical >= 65 then
				v30 = (p29.Position == "SF" or p29.Position == "PF") and true or p29.Position == "C"
			else
				v30 = false
			end
			return v30
		end,
		["Diesel"] = function(p31)
			local v32
			if p31.Attributes.StandingDunk >= 87 and (p31.Attributes.Strength >= 88 and p31.Attributes.PostControl >= 83) then
				v32 = p31.Position == "PF" and true or p31.Position == "C"
			else
				v32 = false
			end
			return v32
		end
	},
	["Physical"] = {
		["Unleash"] = function()
			return true
		end,
		["Resolve"] = function()
			return true
		end
	}
}
return v33]]></ProtectedString>
