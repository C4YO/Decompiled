            <Item class="ModuleScript" referent="RBX1368">
              <Properties>
                <string name="Name">ColorUtil</string>
                <ProtectedString name="Source"><![CDATA[return {
	["LerpColors"] = function(p1, p2) -- name: LerpColors
		if #p1 < 2 then
			error("You need at least two colors to interpolate between.")
		end
		local v3 = math.clamp(p2, 0, 1) * (#p1 - 1)
		local v4 = math.floor(v3) + 1
		local v5 = math.ceil(v3) + 1
		if v4 == v5 then
			return p1[v4]
		end
		local v6 = v3 - (v4 - 1)
		local v7 = p1[v4]
		local v8 = p1[v5]
		return Color3.new(v7.R + (v8.R - v7.R) * v6, v7.G + (v8.G - v7.G) * v6, v7.B + (v8.B - v7.B) * v6)
	end,
	["HexToColor3"] = function(p9) -- name: HexToColor3
		local v10 = p9:sub(1, 2)
		local v11 = tonumber(v10, 16)
		local v12 = p9:sub(3, 4)
		local v13 = tonumber(v12, 16)
		local v14 = p9:sub(5, 6)
		local v15 = tonumber(v14, 16)
		return Color3.fromRGB(v11, v13, v15)
	end,
	["Color3ToHex"] = function(p16) -- name: Color3ToHex
		local v17 = p16.R * 255 + 0.5
		local v18 = math.floor(v17)
		local v19 = math.clamp(v18, 0, 255)
		local v20 = p16.G * 255 + 0.5
		local v21 = math.floor(v20)
		local v22 = math.clamp(v21, 0, 255)
		local v23 = p16.B * 255 + 0.5
		local v24 = math.floor(v23)
		local v25 = math.clamp(v24, 0, 255)
		return string.format("%02X%02X%02X", v19, v22, v25)
	end
}]]></ProtectedString>
