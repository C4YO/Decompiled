		else
			if p120[p121 .. "Shoe"] then
				p120[p121 .. "Shoe"].Object:Destroy()
			end
			local v127 = string.split(v123, "_")
			local v128 = v127[1]
			if not v127[2] or v127[2] == "" then
				v127[2] = "Base"
			end
			local v129 = v127[2]
