	p471.Sounds.Possession = nil
	if not p471.FinalStretch then
		p471:SetBoard("Lower", p472 == 2 and "DE-FENSE!" or "THE FINALS")
	end
	if p472 == 2 then
		p471.Sounds.Possession = p471:PlayMoment("Crowd", "Defense", true, true)
	else
		p471.Sounds.Possession = p471:PlayMoment("Crowd", "Hype") or p471:PlayMoment("Crowd", "Organ")
	end
end
