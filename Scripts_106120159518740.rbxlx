function v9.WatchStarterOffer(p_u_135) -- name: WatchStarterOffer
	local v_u_136 = p_u_135.ButtonConfig[4][1]
	local v_u_137 = v_u_136.UnselectedContext
	local function v_u_140(p138) -- name: SetContext
		-- upvalues: (copy) v_u_136, (copy) p_u_135
