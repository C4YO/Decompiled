			p8.Packets[p9].RightLegPacket = v_u_6.newLeg(p9.RightUpperLeg, p9.RightLowerLeg, p9.RightFoot, p10.Legs.RightHip or p9.LowerTorso.RightHipRigAttachment, p8.Packets[p9].RightLegGoal, false)
