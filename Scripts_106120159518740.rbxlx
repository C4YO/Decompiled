function v_u_1.Init(p3, p4) -- name: Init
	-- upvalues: (copy) v_u_2, (copy) v_u_1
	local v5 = v_u_2._started == false
	assert(v5, "Iris.Init() can only be called once.")
	local v6 = v_u_2._shutdown == false
	assert(v6, "Iris.Init() cannot be called once shutdown.")
	if p3 == nil then
