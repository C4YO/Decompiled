            <Properties>
              <string name="Name">VoiceChat</string>
              <ProtectedString name="Source"><![CDATA[local v_u_1 = game:GetService("RunService")
local v2 = {}
local v_u_3 = {
	[0] = 1,
	[15] = 1,
	[60] = 0
}
function v2.Start(p_u_4) -- name: Start
	-- upvalues: (copy) v_u_1
	local v5 = workspace:WaitForChild("Characters")
	p_u_4.Connections.VoiceAdded = v5.DescendantAdded:Connect(function(p6)
		-- upvalues: (copy) p_u_4
		if p6.Name == "VoiceChat" and p6:IsA("Attachment") then
			p_u_4:AddVoice(p6)
		end
	end)
	for _, v7 in v5:GetDescendants() do
		if v7.Name ~= "VoiceChat" or not v7:IsA("Attachment") then
			continue
		end
		p_u_4:AddVoice(v7)
	end
	p_u_4.Connections.Update = v_u_1.Heartbeat:Connect(function(p8)
		-- upvalues: (copy) p_u_4
		p_u_4:Update(p8)
	end)
end
function v2.AddVoice(p_u_9, p_u_10) -- name: AddVoice
	-- upvalues: (copy) v_u_3
	if not p_u_9.Voices[p_u_10] then
		local v_u_11 = {
			["Rig"] = nil,
			["Open"] = 0,
			["Written"] = 0,
			["Rig"] = p_u_10:FindFirstAncestorOfClass("Model")
		}
		p_u_9.Voices[p_u_10] = v_u_11
		v_u_11.Removed = p_u_10.AncestryChanged:Connect(function()
			-- upvalues: (copy) p_u_10, (copy) p_u_9
			if not p_u_10:IsDescendantOf(workspace) then
				p_u_9:RemoveVoice(p_u_10)
			end
		end)
		task.spawn(function()
			-- upvalues: (copy) p_u_10, (copy) p_u_9, (copy) v_u_11, (ref) v_u_3
			local v12 = p_u_10:WaitForChild("MicEmitter", 10)
			if p_u_9.Voices[p_u_10] == v_u_11 then
				if v12 then
					v12:SetDistanceAttenuation(v_u_3)
					v_u_11.Emitter = v12
					v_u_11.Group = v12.AudioInteractionGroup
				end
				v_u_11.Analyzer = p_u_10:WaitForChild("MicAnaylzer", 10)
				local v13 = v_u_11
				local v14 = p_u_10.Parent
				if v14 then
					v14 = p_u_10.Parent:FindFirstChildOfClass("FaceControls")
				end
				v13.Face = v14
			end
		end)
	end
end
function v2.RemoveVoice(p15, p16) -- name: RemoveVoice
	local v17 = p15.Voices[p16]
	if v17 then
		v17.Removed:Disconnect()
		if v17.Face and v17.Written ~= 0 then
			v17.Face.JawDrop = 0
		end
		p15.Voices[p16] = nil
	end
end
function v2.Update(p18, p19) -- name: Update
	local v20 = workspace.CurrentCamera.CFrame.Position
	for _, v21 in p18.Voices do
		local v22
		if v21.Rig == nil then
			v22 = false
		else
			v22 = v21.Rig.Name == p18.Player.Name
		end
		if v21.Emitter and v22 ~= v21.IsOwn then
			v21.Emitter.AudioInteractionGroup = v22 and "OwnVoice" or v21.Group
			v21.IsOwn = v22
		end
		p18:MoveMouth(v21, v20, p19)
	end
end
function v2.MoveMouth(_, p23, p24, p25) -- name: MoveMouth
	if p23.Analyzer and p23.Face then
		local v26 = p23.Face.Parent
		local v27
		if v26 == nil then
			v27 = false
		else
			v27 = (v26.Position - p24).Magnitude <= 60
		end
		if v27 or p23.Open ~= 0 then
			local v28 = ((v27 and (p23.Analyzer.RmsLevel or 0) or 0) - 0.01) / 0.13999999999999999
			local v29 = math.clamp(v28, 0, 1) * 0.6
			local v30 = p23.Open < v29 and 25 or 10
			local v31 = p23.Open
			local v32 = v29 - p23.Open
			local v33 = v30 * p25
			p23.Open = v31 + v32 * math.min(1, v33)
			if v29 == 0 and p23.Open < 0.01 then
				p23.Open = 0
			end
			local v34 = p23.Open - p23.Written
			if math.abs(v34) >= 0.01 or p23.Open == 0 and p23.Written ~= 0 then
				p23.Face.JawDrop = p23.Open
				p23.Written = p23.Open
			end
		end
	else
		return
	end
end
