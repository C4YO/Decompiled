		}, { "Classic Size", "Larger Size" }).closed() then
			if v166.value == "Classic Size" then
				p_u_1.UpdateGlobalConfig(p_u_1.TemplateConfig.sizeDefault)
			elseif v166.value == "Larger Size" then
				p_u_1.UpdateGlobalConfig(p_u_1.TemplateConfig.sizeClear)
			end
		end
		p_u_1.SameLine()
		if p_u_1.Button({ "Revert" }).clicked() then
			p_u_1.UpdateGlobalConfig(p_u_1.TemplateConfig.colorDark)
			p_u_1.UpdateGlobalConfig(p_u_1.TemplateConfig.sizeDefault)
			v165:set("Dark Theme")
			v166:set("Classic Size")
		end
		v_u_11("Reset Iris to the default theme and size.")
		p_u_1.End()
		p_u_1.TabBar()
		for v167, v168 in ipairs(v163) do
			p_u_1.Tab({ v168[1] })
			v163[v167][2]()
			p_u_1.End()
		end
		p_u_1.End()
		p_u_1.Separator()
		p_u_1.End()
	end
	local function v_u_182() -- name: widgetEventInteractivity
		-- upvalues: (copy) p_u_1
