		local v171 = p_u_1.State(false)
		local v172 = p_u_1.State("clicked")
		p_u_1.SameLine()
		p_u_1.RadioButton({ "clicked", "clicked" }, {
			["index"] = v172
		})
		p_u_1.RadioButton({ "rightClicked", "rightClicked" }, {
			["index"] = v172
		})
		p_u_1.RadioButton({ "doubleClicked", "doubleClicked" }, {
			["index"] = v172
		})
		p_u_1.RadioButton({ "ctrlClicked", "ctrlClicked" }, {
			["index"] = v172
		})
		p_u_1.End()
		p_u_1.SameLine()
		if p_u_1.Button({ v172:get() .. " to reveal text" })[v172:get()]() then
			v171:set(not v171:get())
