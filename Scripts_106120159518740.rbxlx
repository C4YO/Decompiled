		local v176 = p_u_1.Text
		local v177 = {}
		local v178 = v175.unchecked
		__set_list(v177, 1, {"unchecked: " .. tostring(v178())})
		v176(v177)
		local v179 = p_u_1.Text
		local v180 = {}
		local v181 = v175.checked
		__set_list(v180, 1, {"checked: " .. tostring(v181())})
		v179(v180)
		p_u_1.End()
		p_u_1.SameLine()
		if p_u_1.Button({ "Hover over me" }).hovered() then
			p_u_1.Text({ "The button is hovered" })
		end
		p_u_1.End()
		p_u_1.End()
	end
	local function v_u_192() -- name: widgetStateInteractivity
		-- upvalues: (copy) p_u_1
		p_u_1.CollapsingHeader({ "Widget State Interactivity" })
