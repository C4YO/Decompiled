			v_u_2.Character:SetSpectate(false)
		end
	end)
	p_u_18.Enabled = workspace.Map.Courts.Court1.HalfCourt1:GetAttribute("StartedGame")
	p_u_17:SetSpectateActive(workspace.Map.Courts.Court1.HalfCourt1:GetAttribute("StartedGame"))
