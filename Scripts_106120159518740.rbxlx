          <Item class="ModuleScript" referent="RBX465">
            <Properties>
              <string name="Name">RotateControl</string>
              <ProtectedString name="Source"><![CDATA[local v_u_1 = game:GetService("UserInputService")
local v_u_2 = nil
local v_u_3 = nil
local v_u_4 = {
	["Left"] = {
		["Direction"] = -1,
		["Key"] = "Q",
		["Button"] = nil,
		["Button"] = Enum.KeyCode.ButtonL1
	},
	["Right"] = {
		["Direction"] = 1,
		["Key"] = "E",
		["Button"] = nil,
		["Button"] = Enum.KeyCode.ButtonR1
	}
}
local v_u_5 = {
	["Background"] = 1,
	["Icon"] = nil,
	["Icon"] = Color3.fromRGB(255, 255, 255)
}
local v_u_6 = {
	["Background"] = 0,
	["Icon"] = nil,
	["Icon"] = Color3.fromRGB(0, 0, 0)
}
local v_u_7 = {}
v_u_7.__index = v_u_7
function v_u_7.Init(p8) -- name: Init
	-- upvalues: (ref) v_u_2, (ref) v_u_3
	v_u_2 = p8.Controllers.UserInput
	v_u_3 = p8.Controllers.Sound
end
function v_u_7.new(p9, p10) -- name: new
	-- upvalues: (copy) v_u_7, (copy) v_u_4, (copy) v_u_1, (ref) v_u_2
	local v11 = v_u_7
	local v_u_12 = setmetatable({}, v11)
	v_u_12.Frame = p9
	v_u_12.CanTurn = p10
	v_u_12.Held = {}
	v_u_12.Maid = v_u_12.Shared.Maid.new()
	for v13, v14 in v_u_4 do
		v_u_12:SetupArrow(p9[v13], v14.Direction)
	end
	v_u_12.Maid:GiveTask(v_u_1.InputEnded:Connect(function(p15)
		-- upvalues: (copy) v_u_12
		if p15.UserInputType == Enum.UserInputType.MouseButton1 or p15.UserInputType == Enum.UserInputType.Touch then
			v_u_12:ReleaseAll()
		end
	end))
	v_u_12:ShowKeys(v_u_2:GetPreferred())
	v_u_12.Maid:GiveTask(v_u_2.PreferredChanged:Connect(function(p16)
		-- upvalues: (copy) v_u_12
		v_u_12:ShowKeys(p16)
	end))
	return v_u_12
end
function v_u_7.SetupArrow(p_u_17, p_u_18, p_u_19) -- name: SetupArrow
	-- upvalues: (ref) v_u_3, (copy) v_u_6, (copy) v_u_5
	p_u_17.Maid:GiveTask(p_u_18.InputBegan:Connect(function(p20)
		-- upvalues: (copy) p_u_17, (copy) p_u_18, (copy) p_u_19
		if p20.UserInputType == Enum.UserInputType.MouseButton1 or p20.UserInputType == Enum.UserInputType.Touch then
			p_u_17:Press(p_u_18, p_u_19)
		end
	end))
	p_u_17.Maid:GiveTask(p_u_18.MouseEnter:Connect(function()
		-- upvalues: (copy) p_u_17, (ref) v_u_3, (copy) p_u_18, (ref) v_u_6
		if p_u_17.CanTurn() then
			v_u_3:PlaySound("Hover", true)
			p_u_17:LightArrow(p_u_18, v_u_6)
		end
	end))
	p_u_17.Maid:GiveTask(p_u_18.MouseLeave:Connect(function()
		-- upvalues: (copy) p_u_17, (copy) p_u_18, (ref) v_u_5
		p_u_17:LightArrow(p_u_18, v_u_5)
	end))
end
function v_u_7.LightArrow(p21, p22, p23) -- name: LightArrow
	p21.Shared.spr.target(p22, 1, 4, {
		["BackgroundTransparency"] = p23.Background
	})
	p21.Shared.spr.target(p22.Icon, 1, 4, {
		["ImageColor3"] = p23.Icon
	})
end
function v_u_7.Press(p24, p25, p26) -- name: Press
	-- upvalues: (ref) v_u_3
	if not p24.Held[p25] and p24.CanTurn() then
		p24.Held[p25] = p26
		v_u_3:PlaySound("Click", true)
		p24.Shared.spr.target(p25.UIScale, 1, 5, {
			["Scale"] = 0.9
		})
	end
end
function v_u_7.ReleaseAll(p27) -- name: ReleaseAll
	for v28 in p27.Held do
		p27.Shared.spr.target(v28.UIScale, 1, 5, {
			["Scale"] = 1
		})
	end
	table.clear(p27.Held)
end
function v_u_7.GetInput(p29) -- name: GetInput
	if not p29.CanTurn() then
		return 0
	end
	local v30 = 0
	for _, v31 in p29.Held do
		v30 = v30 + v31
	end
	return math.clamp(v30, -1, 1)
end
function v_u_7.ShowKeys(p32, p33) -- name: ShowKeys
	-- upvalues: (ref) v_u_2, (copy) v_u_4, (copy) v_u_1
	local v34 = p33 == v_u_2.Preferred.Gamepad
	local v35 = p33 == v_u_2.Preferred.Touch
	for v36, v37 in v_u_4 do
		local v38 = p32.Frame:FindFirstChild((("%*Key"):format(v36)))
		if not v38 then
			continue
		end
		v38.Visible = not v35
		v38.BackgroundTransparency = v34 and 1 or 0.9
		v38.UIStroke.Enabled = not v34
		v38.Letter.Text = v37.Key
		v38.Letter.Visible = not v34
		v38.Pad.Visible = v34
		v38.Pad.Image = v34 and (v_u_1:GetImageForKeyCode(v37.Button) or "") or ""
	end
end
function v_u_7.Destroy(p39) -- name: Destroy
	p39:ReleaseAll()
	p39.Maid:DoCleaning()
end
return v_u_7]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX466">
            <Properties>
              <string name="Name">RoundButton</string>
              <ProtectedString name="Source"><![CDATA[local _ = workspace.CurrentCamera
local v_u_1 = nil
local v_u_2 = nil
local v_u_3 = {
	["Active"] = false
}
v_u_3.__index = v_u_3
function v_u_3.Init(p4, _) -- name: Init
	-- upvalues: (ref) v_u_1, (ref) v_u_2
	v_u_1 = p4.Controllers.Sound
	v_u_2 = p4.Shared.Maid
end
function v_u_3.GetSize(p5, p6) -- name: GetSize
	return UDim2.new(p5.Config.Size.X.Scale * p6, p5.Config.Size.X.Offset * p6, p5.Config.Size.Y.Scale * p6, p5.Config.Size.Y.Offset * p6)
end
function v_u_3.GetColor(p7, p8) -- name: GetColor
	return Color3.fromRGB(p7.Config.Color.R * 255 * p8, p7.Config.Color.G * 255 * p8, p7.Config.Color.B * 255 * p8)
end
function v_u_3.Update(p9) -- name: Update
	if p9.TextLabel then
		p9.TextLabel.Text = p9.Config.Text
	end
	local v10 = p9.Config[p9.Selected and "Enter" or p9.State]
	p9.Shared.spr.target(p9.ButtonObject, v10.Damping, v10.Frequency, {
		["Size"] = p9:GetSize(v10.Size)
	})
	p9.Shared.spr.target(p9.ButtonObject, 1, v10.Frequency, {
		["BackgroundColor3"] = p9:GetColor(v10.Color),
		["Transparency"] = v10.Transparency
	})
	if v10.Transparency then
		p9.Shared.spr.target(p9.ButtonObject, 1, v10.TransparencyFrequency or v10.Frequency, {
			["Transparency"] = v10.Transparency
		})
	end
	if p9.TextLabel then
		p9.TextLabel.TextColor3 = p9.Config.TextColor
	end
	if p9.White then
		if p9.State == "Leave" and not p9.Selected then
			p9.ButtonObject.UIStroke.Color = p9.Config.StrokeColor or Color3.fromRGB(255, 255, 255)
			p9.ButtonObject.UIStroke.Transparency = p9.Config.StrokeTransparency or 1
		else
			p9.ButtonObject.UIStroke.Color = p9.Config.StrokeColor or Color3.fromRGB(255, 255, 255)
			p9.ButtonObject.UIStroke.Transparency = p9.Config.StrokeEnterTransparency or 0
		end
	elseif p9.State == "Leave" and not p9.Selected then
		p9.ButtonObject.UIStroke.Color = p9.Config.StrokeColor or Color3.fromRGB(0, 0, 0)
		p9.ButtonObject.UIStroke.Transparency = p9.Config.StrokeTransparency or 1
	else
		p9.ButtonObject.UIStroke.Color = p9.Config.StrokeColor or Color3.fromRGB(255, 255, 255)
		p9.ButtonObject.UIStroke.Transparency = p9.Config.StrokeTransparency or 1
	end
end
function v_u_3.GetSelected(p11, _) -- name: GetSelected
	return p11.Selected
end
function v_u_3.SetSelected(p12, p13, _) -- name: SetSelected
	p12.Selected = p13
	p12.ButtonObject.UIStroke:SetAttribute("OriginalTransparency", p12.Selected and p12.Config.StrokeEnterTransparency or p12.Config.StrokeTransparency)
	p12:Update()
end
function v_u_3.Setup(p_u_14) -- name: Setup
	-- upvalues: (ref) v_u_1
	p_u_14.Maid:GiveTask(p_u_14.ButtonObject.MouseEnter:Connect(function()
		-- upvalues: (ref) v_u_1, (copy) p_u_14
		v_u_1:PlaySound("Hover", true)
		p_u_14.State = "Enter"
		p_u_14.Hover = true
		p_u_14:Update()
	end))
	p_u_14.Maid:GiveTask(p_u_14.ButtonObject.MouseLeave:Connect(function()
		-- upvalues: (copy) p_u_14
		p_u_14.State = "Leave"
		p_u_14.Hover = false
		p_u_14:Update()
	end))
	p_u_14.Maid:GiveTask(p_u_14.ButtonObject.MouseButton1Down:Connect(function()
		-- upvalues: (copy) p_u_14
		p_u_14.State = "Down"
		p_u_14:Update()
	end))
	p_u_14.Maid:GiveTask(p_u_14.ButtonObject.MouseButton1Up:Connect(function()
		-- upvalues: (copy) p_u_14
		p_u_14.State = p_u_14.Hover and "Enter" or "Leave"
		p_u_14:Update()
	end))
	p_u_14:Update()
end
function v_u_3.SwitchConfig(p15, p16) -- name: SwitchConfig
	for v17, v18 in p16 do
		p15.Config[v17] = v18
	end
	p15:Update()
end
function v_u_3.new(p19, p20, p21) -- name: new
	-- upvalues: (copy) v_u_3, (ref) v_u_2
	local v22 = v_u_3
	local v23 = setmetatable({
		["State"] = "Leave"
	}, v22)
	v23.ButtonObject = p19
	v23.TextLabel = p19:FindFirstChildOfClass("TextLabel") or p19
	if p19:FindFirstChild("Icon") or p20.NoText then
		v23.TextLabel = nil
	end
	v23.Config = p20
	v23.White = p21
	if not v23.Config.Size then
		v23.Config.Size = v23.ButtonObject.Size
	end
	if not v23.Config.Color then
		v23.Config.Color = v23.ButtonObject.BackgroundColor3
	end
	if not v23.Config.TextColor and v23.TextLabel then
		v23.Config.TextColor = v23.TextLabel.TextColor3
	end
	v23.Maid = v_u_2.new()
	v23:Setup()
	return v23
end
function v_u_3.Connect(p24, p_u_25) -- name: Connect
	-- upvalues: (ref) v_u_1
	p24.Maid:GiveTask(p24.ButtonObject.MouseButton1Click:Connect(function()
		-- upvalues: (ref) v_u_1, (copy) p_u_25
		v_u_1:PlaySound("Click", true)
		p_u_25()
	end))
end
function v_u_3.Destroy(p26) -- name: Destroy
	p26.Maid:Destroy()
end
return v_u_3]]></ProtectedString>
