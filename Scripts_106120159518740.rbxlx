	["Init"] = function(p_u_34) -- name: Init
		-- upvalues: (ref) v_u_7, (ref) v_u_2, (ref) v_u_5, (ref) v_u_3, (ref) v_u_4, (ref) v_u_6
		v_u_7 = p_u_34.Controllers.Replication
