            <Item class="ModuleScript" referent="RBX1351">
              <Properties>
                <string name="Name">Snapshot</string>
                <ProtectedString name="Source"><![CDATA[local v_u_1 = {}
v_u_1.__index = v_u_1
function v_u_1.new(p2) -- name: new
	-- upvalues: (copy) v_u_1
	local v3 = v_u_1
	local v4 = setmetatable({}, v3)
	v4.MaxSnapshots = p2 or 128
	v4.Snapshots = {}
	return v4
end
function v_u_1.Clear(p5) -- name: Clear
	table.clear(p5.Snapshots)
end
function v_u_1.GetCount(p6) -- name: GetCount
	return #p6.Snapshots
end
function v_u_1.GetNewest(p7) -- name: GetNewest
	return p7.Snapshots[#p7.Snapshots]
end
function v_u_1.GetOldest(p8) -- name: GetOldest
	return p8.Snapshots[1]
end
function v_u_1.Add(p9, p10, p11) -- name: Add
	local v12 = p9.Snapshots
	local v13 = v12[#v12]
	if v13 and p10 <= v13.Timestamp then
		return false
	end
	v12[#v12 + 1] = {
		["Timestamp"] = p10,
		["State"] = p11
	}
	local v14 = #v12 - p9.MaxSnapshots
	if v14 > 0 then
		table.move(v12, v14 + 1, #v12, 1, v12)
		for v15 = #v12, #v12 - v14 + 1, -1 do
			v12[v15] = nil
		end
	end
	return true
end
function v_u_1.GetSnapshotPair(p16, p17) -- name: GetSnapshotPair
	local v18 = p16.Snapshots
	local v19 = #v18
	if v19 < 2 then
		return nil
	else
		local v20 = 1
		while v20 <= v19 do
			local v21 = (v20 + v19) / 2
			local v22 = math.floor(v21)
			if v18[v22].Timestamp < p17 then
				v20 = v22 + 1
			else
				v19 = v22 - 1
			end
		end
		local v23 = v18[v20]
		local v24 = v18[v20 - 1]
		if v24 and v23 then
			return v24, v23
		else
			return nil
		end
	end
end
function v_u_1.GetAlpha(_, p25, p26, p27) -- name: GetAlpha
	local v28 = p27.Timestamp - p26.Timestamp
	if v28 <= 0 then
		return 1
	end
	local v29 = (p25 - p26.Timestamp) / v28
	return math.clamp(v29, 0, 1)
end
function v_u_1.Interpolate(p30, p31) -- name: Interpolate
	local v32, v33 = p30:GetSnapshotPair(p31)
	if v32 then
		return v32, v33, p30:GetAlpha(p31, v32, v33)
	else
		return nil
	end
end
function v_u_1.GetInterpolatedCFrame(p34, p35) -- name: GetInterpolatedCFrame
	local v36, v37, v38 = p34:Interpolate(p35)
	if v36 then
		return v36.State.CFrame:Lerp(v37.State.CFrame, v38)
	else
		return nil
	end
end
function v_u_1.GetInterpolatedPosition(p39, p40) -- name: GetInterpolatedPosition
	local v41, v42, v43 = p39:Interpolate(p40)
	if v41 then
		return v41.State.Position:Lerp(v42.State.Position, v43)
	else
		return nil
	end
end
function v_u_1.ExtrapolatePosition(p44, p45) -- name: ExtrapolatePosition
	local v46 = p44.Snapshots
	local v47 = #v46
	if v47 < 2 then
		return nil
	end
	local v48 = v46[v47]
	local v49 = p45 - v48.Timestamp
	return v48.State.Position + v48.State.Velocity * v49
end
function v_u_1.ExtrapolateCFrame(p50, p51) -- name: ExtrapolateCFrame
	local v52 = p50.Snapshots
	local v53 = #v52
	if v53 < 2 then
		return nil
	end
	local v54 = v52[v53]
	local v55 = v54.State
	local v56 = p51 - v54.Timestamp
	local v57 = v55.CFrame.Position + v55.Velocity * v56
	return v55.CFrame.Rotation + v57
end
function v_u_1.GetRenderCFrame(p58, p59, p60) -- name: GetRenderCFrame
	local v61 = p58:GetNewest()
	if not v61 then
		return nil
	end
	if v61.Timestamp >= p59 then
		local v62 = p58:GetInterpolatedCFrame(p59)
		if v62 then
			return v62
		end
		local v63 = p58:GetOldest()
		return v63 and v63.State.CFrame or v61.State.CFrame
	end
	local v64 = p60 or 0.25
	if v64 <= 0 then
		return v61.State.CFrame
	end
	local v65 = p59 - v61.Timestamp
	local v66 = math.min(v65, v64)
	local v67 = v61.State
	local v68 = 1 - v66 / v64 * 0.25
	local v69 = v67.CFrame.Position + v67.Velocity * v68 * v66
	return CFrame.new(v69) * v67.CFrame.Rotation
end
return v_u_1]]></ProtectedString>
