		p_u_1.Separator()
		local v115 = p_u_1.State(false)
		local v116 = p_u_1.State("clicked")
		p_u_1.SameLine()
		p_u_1.RadioButton({ "clicked", "clicked" }, {
			["index"] = v116
		})
		p_u_1.RadioButton({ "rightClicked", "rightClicked" }, {
			["index"] = v116
		})
		p_u_1.RadioButton({ "doubleClicked", "doubleClicked" }, {
			["index"] = v116
		})
		p_u_1.RadioButton({ "ctrlClicked", "ctrlClicked" }, {
			["index"] = v116
		})
		p_u_1.End()
		p_u_1.SameLine()
		if p_u_1.Button({ v116:get() .. " to reveal text" })[v116:get()]() then
			v115:set(not v115:get())
		end
		if v115:get() then
			p_u_1.Text({ "Here i am!" })
		end
		p_u_1.End()
		p_u_1.Separator()
		local v117 = p_u_1.State(0)
		p_u_1.SameLine()
		if p_u_1.Button({ "Click to show text for 20 frames" }).clicked() then
			v117:set(20)
		end
		if v117:get() > 0 then
			p_u_1.Text({ "Here i am!" })
		end
		p_u_1.End()
		local v118 = v117:get() - 1
		v117:set((math.max(0, v118)))
		p_u_1.Text({ "Text Timer: " .. v117:get() })
		local v119 = p_u_1.Checkbox({ "Event-tracked checkbox" })
		p_u_1.Indent()
		local v120 = p_u_1.Text
		local v121 = {}
		local v122 = v119.unchecked
		__set_list(v121, 1, {"unchecked: " .. tostring(v122())})
		v120(v121)
		local v123 = p_u_1.Text
		local v124 = {}
		local v125 = v119.checked
		__set_list(v124, 1, {"checked: " .. tostring(v125())})
		v123(v124)
		p_u_1.End()
		p_u_1.SameLine()
		if p_u_1.Button({ "Hover over me" }).hovered() then
			p_u_1.Text({ "The button is hovered" })
		end
		p_u_1.End()
		p_u_1.End()
	end
	local function v_u_136() -- name: widgetStateInteractivity
