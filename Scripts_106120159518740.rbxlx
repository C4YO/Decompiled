                    <Item class="ModuleScript" referent="RBX1193">
                      <Properties>
                        <string name="Name">InsideHandLayup</string>
                        <ProtectedString name="Source"><![CDATA[local v14 = {
	["Damping"] = 750,
	["Speed"] = 1.625,
	["PlantKey"] = 3,
	["FadeTime"] = 0.3,
	["MeterMultiplier"] = 1.5,
	["GetVelocity"] = nil,
	["GetGoal"] = nil,
	["Velocity"] = nil,
	["GetVelocity"] = function(p1, p2, p3, _, p4, p5) -- name: GetVelocity
		local v6 = p2.data.HumanoidRootPart.Position
		local _ = (p1 - p3.Position) * Vector3.new(1, 0, 1)
		local _ = p3.CFrame
		local v7 = CFrame.new(p1 * Vector3.new(1, 0, 1), p3.Position * Vector3.new(1, 0, 1))
		local v8 = ((p3.Position - v7.LookVector * 0.8) * Vector3.new(1, 0, 1) - v6 * Vector3.new(1, 0, 1)) / p5
		if v8.Magnitude > 14.5 then
			v8 = v8.Unit * 14.5
		end
		local v9 = v8 ~= v8 and Vector3.new(0, 0, 0) or v8
		if p4 == 1 then
			return v9 * 0.5
		elseif p4 == 2 then
			return v9
		elseif p4 == 3 then
			return p2:GetAttribute("ServerVelocity") * 0.4
		elseif p4 == 4 then
			return p2:GetAttribute("ServerVelocity") * 0.1
		else
			return p4 ~= 5 and Vector3.new(0, 0, 0) or p2:GetAttribute("ServerVelocity") * 0
		end
	end,
	["GetGoal"] = function(p10, _, p11, _, _, _) -- name: GetGoal
		local v12 = (p10 - p11.Position) * Vector3.new(1, 0, 1)
		local v13 = p11.CFrame
		if p11.CFrame.RightVector:Dot(v12.Unit) < 0 then
			v13 = v13 - p11.CFrame.RightVector * 3.25
		elseif p11.CFrame.RightVector:Dot(v12.Unit) > 0 then
			v13 = v13 + p11.CFrame.RightVector * 3.25
		end
		return {
			["CFrame"] = v13,
			["Position"] = v13.Position
		}
	end,
	["Velocity"] = {
		["Forward"] = {
			{
				["deltaTime"] = 0.12
			},
			{
				["deltaTime"] = 0.175
			},
			{
				["deltaTime"] = 0.25
			},
			{
				["deltaTime"] = 0.25
			},
			{
				["deltaTime"] = 0.15
			}
		}
	}
}
return v14]]></ProtectedString>
                      </Properties>
                    </Item>
