					for _, v32 in p12.partData do
						for v33, v34 in v32 do
							if v34.point.Anchored then
								continue
							end
							v33.Transform = v33.WorldCFrame:ToObjectSpace(CFrame.new(v34.point.Position))
						end
					end
				else
					p12.sleeping = true
				end
			else
				return
			end
		end
	else
		return
	end
end
function v_u_2.Swish(p35, p36, p37, p38) -- name: Swish
	-- upvalues: (ref) v_u_3
	if p35.Active then
		p35.Basketball = p36
		p35.lastBasketballTime = os.clock()
		p35.sleeping = false
		local v39 = p37 or p36.Velocity
		local v40 = p35.Model.PrimaryPart.Swish
		if p38 and p35.Model.PrimaryPart:FindFirstChild("Dunk") then
			v40 = p35.Model.PrimaryPart.Dunk
		end
		local v41 = v40:FindFirstChild("PitchShiftSoundEffect")
		if v41 then
			v41.Octave = v_u_3.DecimalRandom(v41:GetAttribute("MinRange") or 0.875, v41:GetAttribute("MaxRange") or 1.2)
		end
		v40:Play()
		for _, v42 in p35.partData do
			for _, v43 in v42 do
				if v43.point.BaseAnchored then
					continue
				end
				local v44 = v39.Unit
				local v45 = v44 ~= v44 and Vector3.new(0, 0, 0) or v44
				local v46 = math.random(12.5, 20)
				local v47 = v39.Magnitude
				local v48 = Random.new():NextNumber(21.5, 27.5)
				local v49 = math.clamp(v47, v48, 40)
				local v50 = v49 * 8
				local v51 = v49 * 11
