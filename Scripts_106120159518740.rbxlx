                <Item class="ModuleScript" referent="RBX1338">
                  <Properties>
                    <string name="Name">Lines</string>
                    <ProtectedString name="Source"><![CDATA[local v1 = {
	["Spoken"] = nil,
	["Headlines"] = nil,
	["Ticker"] = "TONIGHT: THE OLD PARK\'S LAST DAY  \226\128\162  THE NEW PARK OPENS NEXT  \226\128\162  POWER CREWS ON STANDBY  \226\128\162  RESIDENTS ASKED TO AVOID THE PARK DISTRICT  \226\128\162  ",
	["Arrival"] = nil,
	["Memorial"] = nil,
	["Story"] = nil,
	["GuestTalk"] = nil,
	["GuestPanic"] = nil,
	["TrappedHelp"] = nil,
	["ReporterTalk"] = nil,
	["Spoken"] = {
		["R_PreShow"] = {
			["Speaker"] = "Reporter",
			["Text"] = "Good evening, this is Channel 8, live from the Old Park on its very last day. ...Too much? Okay, from the top.",
			["Duration"] = 7.8,
			["Sound"] = "rbxassetid://114665431031210"
		},
		["R_Interview1"] = {
			["Speaker"] = "Reporter",
			["Text"] = "So be honest. You gonna miss this place?",
			["Duration"] = 5.1,
			["Sound"] = "rbxassetid://86820524521963"
		},
		["G_Interview1"] = {
			["Speaker"] = "Guest",
			["Text"] = "Are you kidding? I learned to play on these courts. Every summer, right here.",
			["Duration"] = 5.5,
			["Sound"] = "rbxassetid://108144236331025"
		},
		["R_Interview2"] = {
			["Speaker"] = "Reporter",
			["Text"] = "Ha, I\'ve been hearing that all day. Thanks, man.",
			["Duration"] = 5.3,
			["Sound"] = "rbxassetid://111190513171922"
		},
		["PA_PreShow"] = {
			["Speaker"] = "PA",
			["Text"] = "Welcome to the Old Park. Thanks for spending our last day with us.",
			["Duration"] = 6.6,
			["Sound"] = ""
		},
		["R_Live1"] = {
			["Speaker"] = "Reporter",
			["Text"] = "Good evening! I\'m at the Old Park for its very last night, and honestly? It\'s packed out here.",
			["Duration"] = 5.6,
			["Focus"] = true,
			["Sound"] = "rbxassetid://83659886633748"
		},
		["R_Weird"] = {
			["Speaker"] = "Reporter",
			["Text"] = "Whoa. Okay, the lights are a little moody tonight.",
			["Duration"] = 3.5,
			["Focus"] = true,
			["Sound"] = "rbxassetid://92925655873245"
		},
		["R_Above100"] = {
			["Speaker"] = "Reporter",
			["Text"] = "Wait, a hundred and three percent? Is that... bad?",
			["Duration"] = 3.4,
			["Focus"] = true,
			["Sound"] = "rbxassetid://112765521782411"
		},
		["R_LosingLights"] = {
			["Speaker"] = "Reporter",
			["Text"] = "And there goes another one. That whole side of the park is dark now.",
			["Duration"] = 5.3,
			["Sound"] = "rbxassetid://94841500770678"
		},
		["R_Blimp"] = {
			["Speaker"] = "Reporter",
			["Text"] = "Hold on, did the blimp just glitch?",
			["Duration"] = 2.4,
			["Sound"] = "rbxassetid://82689517041586"
		},
		["PA_MinorIssues"] = {
			["Speaker"] = "PA",
			["Text"] = "Attention, guests. We\'re having some minor power issues. Please stand by.",
			["Duration"] = 8,
			["Sound"] = ""
		},
		["R_Underneath"] = {
			["Speaker"] = "Reporter",
			["Text"] = "Whoa! Did you feel that? That came from under the ground!",
			["Duration"] = 4,
			["Sound"] = "rbxassetid://87401437990926"
		},
		["R_StayAway"] = {
			["Speaker"] = "Reporter",
			["Text"] = "Get off the courts! Stay away from anything that\'s sparking!",
			["Duration"] = 3.6,
			["Sound"] = "rbxassetid://92053201101432"
		},
		["PA_ClearEquipment"] = {
			["Speaker"] = "PA",
			["Text"] = "Please stay clear of all electrical equipment.",
			["Duration"] = 4.3,
			["Sound"] = ""
		},
		["R_ShutDown"] = {
			["Speaker"] = "Reporter",
			["Text"] = "Okay. Okay... I think they actually got it.",
			["Duration"] = 3.2,
			["Focus"] = true,
			["Sound"] = "rbxassetid://75119231702179"
		},
		["R_NoNo"] = {
			["Speaker"] = "Reporter",
			["Text"] = "No, no, no, no...",
			["Duration"] = 2.2,
			["Sound"] = "rbxassetid://80663593246643"
		},
		["R_ComingDown"] = {
			["Speaker"] = "Reporter",
			["Text"] = "That blimp is coming down! Move!",
			["Duration"] = 2.4,
			["Sound"] = "rbxassetid://79968555226150"
		},
		["PA_Evacuate"] = {
			["Speaker"] = "PA",
			["Text"] = "All guests, please evacuate the park immediately.",
			["Duration"] = 4.8,
			["Sound"] = ""
		},
		["R_Nobody"] = {
			["Speaker"] = "Reporter",
			["Text"] = "Alright. Nobody\'s fixing this tonight. We need to go.",
			["Duration"] = 3.4,
			["Sound"] = "rbxassetid://124495210233529"
		},
		["R_Overloaded"] = {
			["Speaker"] = "Reporter",
			["Text"] = "Everything\'s turning on at once! What is happening?!",
			["Duration"] = 3,
			["Sound"] = "rbxassetid://124295135889008"
		},
		["R_EverybodyOut"] = {
			["Speaker"] = "Reporter",
			["Text"] = "Go, go, go! Get to the ladder!",
			["Duration"] = 2.4,
			["Sound"] = "rbxassetid://92099091043665"
		},
		["PA_Cut"] = {
			["Speaker"] = "PA",
			["Text"] = "Please evac\226\128\148",
			["Duration"] = 1.4,
			["Sound"] = ""
		},
		["Radio_Inbound"] = {
			["Speaker"] = "Pilot",
			["Text"] = "Rescue One, inbound over the north entrance. Get everybody to the evac point!",
			["Duration"] = 6,
			["Sound"] = "rbxassetid://83585108920247"
		},
		["R_Helicopter"] = {
			["Speaker"] = "Reporter",
			["Text"] = "Helicopter! Over there! Everybody, follow me!",
			["Duration"] = 2.8,
			["Sound"] = "rbxassetid://136154788812701"
		},
		["Radio_Ladder"] = {
			["Speaker"] = "Pilot",
			["Text"] = "Ladder\'s down! Start climbing, let\'s go!",
			["Duration"] = 3.8,
			["Sound"] = "rbxassetid://81490084154948"
		},
		["Radio_LiftOff"] = {
			["Speaker"] = "Pilot",
			["Text"] = "That\'s everybody. Hang on, we\'re lifting!",
			["Duration"] = 3.4,
			["Sound"] = "rbxassetid://136450774713270"
		},
		["Radio_MadeIt"] = {
			["Speaker"] = "Radio",
			["Text"] = "...if anyone\'s still listening... everybody made it out.",
			["Duration"] = 5,
			["Sound"] = ""
		},
		["S_Online"] = {
			["Speaker"] = "System",
			["Text"] = "New Park power system: online.",
			["Duration"] = 3.6,
			["Sound"] = ""
		},
		["S_Welcome"] = {
			["Speaker"] = "System",
			["Text"] = "Welcome to the New Park.",
			["Duration"] = 2.8,
			["Sound"] = ""
		}
	},
	["Headlines"] = {
		["PreEvent"] = "LIVE: ONE LAST DAY AT OLD PARK",
		["Farewell"] = "FAREWELL TO THE OLD PARK",
		["LosingPower"] = "OLD PARK: POWER OUTAGES REPORTED",
		["Underground"] = "BREAKING: UNDERGROUND BLAST AT OLD PARK",
		["Escalation"] = "BREAKING: PARK POWER SYSTEM FAILING",
		["Blimp"] = "BREAKING: BLIMP LOSING ALTITUDE",
		["Overload"] = "BREAKING: EVACUATE THE OLD PARK"
	},
	["Arrival"] = {
		{
			["At"] = 3.2,
			["Line"] = "S_Online"
		},
		{
			["At"] = 7.2,
			["Line"] = "S_Welcome"
		}
	},
	["Memorial"] = {
		["Stone"] = nil,
		["Saved"] = "Saved by you",
		["Lost"] = "Lost with the Old Park",
		["Stone"] = {
			"IN MEMORY OF",
			"THE OLD PARK",
			"{OpeningYear} \226\128\147 {ClosingYear}",
			"What we saved on its last day is kept here."
		}
	},
	["Story"] = {
		{
			["Text"] = "THE OLD PARK HAS BEEN SHUT DOWN.",
			["Start"] = 7,
			["FadeIn"] = 1.4,
			["Hold"] = 3.2,
			["FadeOut"] = 1.4,
			["Type"] = 0
		},
		{
			["Text"] = "{OpeningYear} \226\128\147 {ClosingYear}",
			["Start"] = 13,
			["FadeIn"] = 1.4,
			["Hold"] = 2.6,
			["FadeOut"] = 1.2,
			["Type"] = 0
		}
	},
	["GuestTalk"] = {
		{
			["Text"] = "Last day, huh? Feels weird. I\'ve been coming here since I was like ten.",
			["Sound"] = "rbxassetid://73449873961221"
		},
		{
			["Text"] = "Court three\'s my court. Don\'t tell anybody, but the left rim\'s a little soft.",
			["Sound"] = "rbxassetid://107505317758445"
		},
		{
			["Text"] = "You hear that buzzing? These lights have been doing that for years. Nobody ever fixes it.",
			["Sound"] = "rbxassetid://119029484793149"
		},
		{
			["Text"] = "Hit my first game winner right over there. Nobody believes me, but I did.",
			["Sound"] = "rbxassetid://123823979283570"
		},
		{
			["Text"] = "Everyone keeps hyping up the New Park. It\'s cool, I guess. It\'s just not this, you know?",
			["Sound"] = "rbxassetid://111974673681917"
		},
		{
			["Text"] = "That vending machine ate my money again. Last day and it\'s still robbing me.",
			["Sound"] = "rbxassetid://87864353531827"
		}
	},
	["GuestPanic"] = {
		{
			["Text"] = "What\'s going on?!",
			["Sound"] = ""
		},
		{
			["Text"] = "Why is everything going dark?!",
			["Sound"] = ""
		},
		{
			["Text"] = "We gotta get out of here!",
			["Sound"] = "rbxassetid://86572049559214"
		},
		{
			["Text"] = "Which way\'s out?!",
			["Sound"] = ""
		}
	},
	["TrappedHelp"] = { "Which way do I go?!", "I can\'t see a thing out here!", "Hey! Is it this way?" },
	["ReporterTalk"] = {
		{
			["Phases"] = { "PreEvent" },
			["Greeting"] = {
				["Text"] = "Hey! Marcus Reed, Channel 8. Big night, huh?",
				["Sound"] = ""
			},
			["Answers"] = {
				{
					["Question"] = "What\'s happening tonight?",
					["Answer"] = "We\'re doing a goodbye special. Last night of the Old Park before the new one opens.",
					["Sound"] = ""
				},
				{
					["Question"] = "Are you going to miss it?",
					["Answer"] = "Honestly? Yeah. I covered the day these courts opened. My first live shot was right over there.",
					["Sound"] = ""
				},
				{
					["Question"] = "What\'s under the park?",
					["Answer"] = "Cables, mostly. All the old power equipment that keeps this place running. Some of it\'s older than me.",
					["Sound"] = ""
				}
			}
		},
		{
			["Phases"] = { "Farewell", "LosingPower" },
			["Greeting"] = {
				["Text"] = "We\'re live in a sec, make it quick!",
				["Sound"] = ""
			},
			["Answers"] = {
				{
					["Question"] = "What\'s happening to the lights?",
					["Answer"] = "No clue. Old wiring, probably. ...Hopefully.",
					["Sound"] = ""
				},
				{
					["Question"] = "Should we be worried?",
					["Answer"] = "Ask me again in five minutes.",
					["Sound"] = ""
				},
				{
					["Question"] = "What\'s that scoreboard doing?",
					["Answer"] = "Nobody turned that on. And I don\'t know what \'power load\' is, but over a hundred can\'t be good.",
					["Sound"] = ""
				}
			}
		},
		{
			["Phases"] = { "Underground", "Escalation" },
			["Greeting"] = {
				["Text"] = "Hey, you shouldn\'t be over here! It\'s not safe!",
				["Sound"] = ""
			},
			["Answers"] = {
				{
					["Question"] = "What was that explosion?",
					["Answer"] = "Something blew underground. The equipment room, maybe? Everything down there\'s running way too hot.",
					["Sound"] = ""
				},
				{
					["Question"] = "Can it be fixed?",
					["Answer"] = "Some people are going for the main breaker. If anyone can shut it off, it\'s from there.",
					["Sound"] = ""
				},
				{
					["Question"] = "Where should I go?",
					["Answer"] = "Away from the courts. Away from anything with a plug, honestly.",
					["Sound"] = ""
				}
			}
		},
		{
			["Phases"] = { "Blimp", "Overload" },
			["Greeting"] = {
				["Text"] = "Not now! Just go, get out of here!",
				["Sound"] = ""
			},
			["Answers"] = {}
		}
	}
}
return v1]]></ProtectedString>
