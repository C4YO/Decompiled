			v59.Stamina.MaxCurrent = v_u_6.Lerp(v59.Stamina.MaxCurrent, v59.Stamina.MaxTarget, p58 * 10)
			v59.Takeover.Current = v_u_6.Lerp(v59.Takeover.Current, v59.Takeover.CurrentTarget, p58 * 10)
			v59.MaxStaminaFrame.Position = UDim2.new(v59.Stamina.MaxCurrent / 100, 0, 0.5, 0)
			v59.StaminaFrame.Size = UDim2.new(v59.Stamina.Current / 100, 0, 1, 0)
			v59.TakeoverFrame.Size = UDim2.new(v59.Takeover.Current / 100, 0, 1, 0)
		end
	end))
end
