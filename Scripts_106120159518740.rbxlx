			["isChecked"] = v189
		})
		p_u_1.Checkbox({ "Inverted of above checkbox" }, {
			["isChecked"] = v191
		})
		p_u_1.Text({ (("isChecked: %*\n"):format(v191.value)) })
		p_u_1.End()
	end
	local function v_u_197() -- name: dynamicStyle
		-- upvalues: (copy) p_u_1, (copy) v_u_11
