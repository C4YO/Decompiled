				local v52 = v43.point
				local v53 = v52.forceVelocity
				local v54 = v46 * (v39.Magnitude / 2.5 / 7)
				local v55 = math.clamp(v54, 0, v46)
				v52.forceVelocity = v53 + (Vector3.new(0, v55, 0) + -(v45 / 2.5) * v46 * math.random(v50, v51))
			end
		end
	end
end
function v_u_2.Load(p56) -- name: Load
