			v51 = p49:IsEquipped(v_u_13[v50.Page] or v50.Page, v50.Name)
		end
		if v50.Page == "Shoes" then
			v51 = (v50.ModelName == p49.CurrentShoe or v50.ModelName == p49.LeftShoe) and true or v50.ModelName == p49.RightShoe
		end
		v50.Button:Update(v51)
	end
end
