				"Cos",
				"Tan",
				"Saw"
			})
			local v76 = p_u_1.SliderNum({
				"Samples",
				1,
				1,
				145,
				"%d samples"
			}, {
				["number"] = v70
			})
			if p_u_1.SliderNum({
				"Baseline",
				0.1,
				-1,
				1
			}, {
				["number"] = v71
			}).numberChanged() then
				v72:set(v72.value, true)
			end
			if v74.state.isChecked.value or (v75.closed() or (v76.numberChanged() or #v72.value == 0)) then
				if v74.state.isChecked.value then
					v73:set(v73.value + p_u_1.Internal._deltaTime)
				end
				local v77 = v73.value * 30
				local v78 = math.floor(v77) - 1
				local v79 = v69.value
				table.clear(v72.value)
				for v80 = 1, v70.value do
					if v79 == "Sin" then
						local v81 = v72.value
						local v82 = (v80 + v78) * 5
						local v83 = math.rad(v82)
						v81[v80] = math.sin(v83)
					elseif v79 == "Cos" then
						local v84 = v72.value
						local v85 = (v80 + v78) * 5
						local v86 = math.rad(v85)
						v84[v80] = math.cos(v86)
					elseif v79 == "Tan" then
						local v87 = v72.value
						local v88 = (v80 + v78) * 5
						local v89 = math.rad(v88)
						v87[v80] = math.tan(v89)
					else
						if v79 ~= "Saw" then
							continue
						end
						v72.value[v80] = v80 % 2 == v78 % 2 and 1 or -1
					end
				end
				v72:set(v72.value, true)
			end
