	local function v_u_126() -- name: widgetEventInteractivity
		-- upvalues: (copy) p_u_1
		p_u_1.CollapsingHeader({ "Widget Event Interactivity" })
		local v114 = p_u_1.State(0)
		if p_u_1.Button({ "Click to increase Number" }).clicked() then
