function v11.PlayIntro(p_u_176) -- name: PlayIntro
	-- upvalues: (ref) v_u_7, (copy) v_u_3, (copy) v_u_16, (copy) v_u_2
	local v177 = os.clock()
	local v178 = v_u_7.Character
	local v179
	if v178 then
		v179 = v178:GetAttribute("Goal")
	else
		v179 = v178
	end
	while not v179 and os.clock() - v177 < 5 do
		task.wait(0.1)
		v178 = v_u_7.Character
		if v178 then
			v179 = v178:GetAttribute("Goal")
		else
			v179 = v178
		end
	end
	if v178 and v179 then
		local v180 = p_u_176.GuiObject:WaitForChild("Intro")
		local v181 = v180.TopBar
		local v182 = v180.BottomBar
		local v183 = p_u_176.TutorialInfo.EstimatedMinutes
		if not v183 then
			local v184 = #p_u_176.TutorialInfo.Tasks * 20 / 60
			local v185 = math.ceil(v184)
			v183 = math.max(1, v185)
		end
		v180.Title.Text = ("%* TUTORIAL"):format((string.upper(p_u_176.TutorialInfo.DisplayName or p_u_176.TutorialType)))
		v180.Time.Text = ("ABOUT %* MINUTE%*"):format(v183, v183 == 1 and "" or "S")
		p_u_176.Canvas.Visible = false
		v181.Position = UDim2.new(0.5, 0, 0, 0)
		v182.Position = UDim2.new(0.5, 0, 1, 0)
		v180.Visible = true
		v_u_3:Create(v181, v_u_16, {
			["Position"] = UDim2.new(0.5, 0, 0.11, 0)
		}):Play()
		v_u_3:Create(v182, v_u_16, {
			["Position"] = UDim2.new(0.5, 0, 0.89, 0)
		}):Play()
		p_u_176.Modules.Camera.ForcedCamera = true
		local v_u_186 = workspace.CurrentCamera
		local v_u_187 = v_u_186.CameraType
		v_u_186.CameraType = Enum.CameraType.Scriptable
		v_u_186.FieldOfView = 55
		local v188 = v179.Position
		local v_u_189 = CFrame.lookAt(v188 + Vector3.new(30, 16, 44), v188)
		local v_u_190 = CFrame.lookAt(v188 + Vector3.new(-30, 12, 34), v188)
		local v_u_191 = os.clock()
		local v_u_192 = false
		v_u_2:BindToRenderStep("TutorialIntro", Enum.RenderPriority.Last.Value, function()
			-- upvalues: (copy) v_u_191, (copy) v_u_186, (copy) v_u_189, (copy) v_u_190, (ref) v_u_192, (copy) v_u_187, (copy) p_u_176
			local v193 = os.clock() - v_u_191
			if v193 < 4.5 then
				local v194 = v_u_186
				local v195 = v_u_189
				local v196 = v_u_190
				local v197 = v193 / 4.5
				local v198 = math.clamp(v197, 0, 1)
				v194.CFrame = v195:Lerp(v196, v198 * v198 * (3 - v198 * 2))
				return
			elseif v_u_192 then
				local v199 = v_u_186
				local v200 = v_u_190
				local v201 = v_u_186.CFrame
				local v202 = (v193 - 4.5) / 1.6
				local v203 = math.clamp(v202, 0, 1)
				v199.CFrame = v200:Lerp(v201, v203 * v203 * (3 - v203 * 2))
			else
				v_u_192 = true
				v_u_186.CameraType = v_u_187
				p_u_176.Modules.Camera.ForcedCamera = false
			end
		end)
		task.wait(0.8)
		p_u_176:FadeIntroText(v180.Title, 0.15)
		p_u_176:FadeIntroText(v180.Time, 0.25)
		task.wait(3.7)
		p_u_176:FadeIntroText(v180.Title, 1)
		p_u_176:FadeIntroText(v180.Time, 1)
		v_u_3:Create(v181, v_u_16, {
			["Position"] = UDim2.new(0.5, 0, 0, 0)
		}):Play()
		v_u_3:Create(v182, v_u_16, {
			["Position"] = UDim2.new(0.5, 0, 1, 0)
		}):Play()
		task.wait(1.6)
		v_u_2:UnbindFromRenderStep("TutorialIntro")
		v180.Visible = false
		p_u_176.Canvas.Visible = true
	end
end
