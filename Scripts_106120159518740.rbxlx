game:GetService("RunService")
local v_u_2 = {}
v_u_2.__index = v_u_2
local v_u_3 = nil
local v_u_4 = nil
local v_u_5 = nil
local v_u_6 = v1.Assets.Models.Nets
local v_u_7 = require(script:WaitForChild("Verlet"))
function v_u_2.Init(p8) -- name: Init
