			end)
		else
			p_u_102:SetupSetting(v_u_120.Name, v_u_120.Bar.Main, v_u_120.Name == "Gamepoint" and 21 or (v_u_120.Name == "Winby" and 2 or 24), function(p123, p124)
				local v125 = p123 + (p124 and 1 or -1)
