		end,
		["Glove"] = function(p6)
			return p6.Attributes.BallHandle >= 96 and 5 or ((p6.Attributes.BallHandle >= 90 or p6.Attributes.PostControl >= 90 and p6.Attributes.Strength >= 90) and 4 or ((p6.Attributes.BallHandle >= 82 or p6.Attributes.PostControl >= 82 and p6.Attributes.Strength >= 81) and 3 or ((p6.Attributes.BallHandle >= 73 or p6.Attributes.PostControl >= 72 and p6.Attributes.Strength >= 71) and 2 or ((p6.Attributes.BallHandle >= 65 or p6.Attributes.PostControl >= 65 and p6.Attributes.Strength >= 64) and 1 or false))))
