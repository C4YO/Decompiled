	["QuickTasks"] = { "Jumpshot", "Pass", "StealBall" },
	["GetFailReason"] = function(p4, p5) -- name: GetFailReason
		-- upvalues: (copy) v_u_1, (copy) v_u_2, (copy) v_u_3
		if p4 and p5 then
			local v6 = string.lower(p4.Header)
			if p4.Kind == "Shot" then
				if p5.ShotType then
					if p4.ShotTypes and not table.find(p4.ShotTypes, p5.ShotType) then
						return ("THAT WAS A %*"):format(v_u_1[p5.ShotType] or string.upper(p5.ShotType)), ("Try a %*"):format(v6)
					elseif p4.Direction and p4.Direction ~= p5.Direction then
						return "RUN AT THE HOOP", "Start at circle 1 and run in"
					elseif p4.Marker and (not p4.MarkerIsGuide and (p5.Position and ((p5.Position - p4.Marker.Position) * Vector3.new(1, 0, 1)).Magnitude > p4.Marker.Size)) then
						return "SHOOT IN THE CIRCLE", "Stand in the circle, then shoot"
					else
						return nil
					end
				else
					return nil
				end
			elseif p4.Kind == "Dribble" then
				if p5.Name then
					if p5.Name == p4.Name then
						if p4.Sprint == true and not p5.Escape then
							return "HOLD SPRINT", "Hold sprint, then press the key"
						elseif p4.Sprint == false and p5.Escape then
							return "LET GO OF SPRINT", "Don\'t hold sprint for this one"
						elseif p4.Direction and p4.Direction ~= p5.Direction then
							return "STAND STILL", "Stop moving, then try again"
						else
							return nil
						end
					else
						return ("THAT WAS A %*"):format(v_u_2[p5.Name] or string.upper(p5.Name)), ("Try the %*"):format(v6)
					end
				else
					return nil
				end
			elseif p4.Kind == "Pass" then
				if p5.PassAnimation == "FakePass" then
					return "THAT WAS A FAKE PASS", "Pass it for real this time"
				elseif p5.ShotType then
					return ("THAT WAS A %*"):format(v_u_1[p5.ShotType] or "SHOT"), "Pass it to your teammate instead"
				elseif p5.Name then
					return ("THAT WAS A %*"):format(v_u_2[p5.Name] or string.upper(p5.Name)), "Pass it to your teammate instead"
				else
					return nil
				end
			elseif p4.Kind == "Defense" then
				if p5.OutOfReach then
					if p4.Name == "StealBall" then
						return "GET CLOSER", "Walk right up to them, then press steal"
					else
						return nil
					end
				elseif p5.Type and p5.Type ~= p4.Name then
					return ("THAT WAS A %*"):format(v_u_3[p5.Type] or string.upper(p5.Type)), ("Try a %*"):format(v6)
				else
					return nil
				end
			else
				return nil
			end
		else
			return nil
		end
	end,
	["IsTry"] = function(p7, p8) -- name: IsTry
		if not p8 then
			return false
		end
		if p7.Kind == "Pass" then
			return p8.PassAnimation == "FakePass" and true or p8.Refused == true
		end
		if p7.Kind ~= "Defense" then
			return false
		end
		local v9
		if p8.Missed == true then
			v9 = p8.Type == p7.Name
		else
			v9 = false
		end
		return v9
	end,
	["IsComplete"] = function(p10, p11) -- name: IsComplete
		if p11 then
			if p10.Kind == "Defense" then
				return p11.Type == p10.Name
			elseif p10.Kind == "Pass" then
				local v12
				if p11.PassAnimation == nil then
					v12 = false
				else
					v12 = p11.PassAnimation ~= "FakePass"
				end
				return v12
			elseif p10.Kind == "Dribble" then
				if p11.Name == p10.Name then
					if p10.Sprint == nil or p10.Sprint == p11.Escape then
						return (not p10.Direction or p10.Direction == p11.Direction) and true or false
					else
						return false
					end
				else
					return false
				end
			elseif p11.ShotType and (p11.Direction and p11.Position) then
				local v13 = p10.ShotTypes
				local v14 = p11.ShotType
				if not v13 and true or table.find(v13, v14) ~= nil then
					if p10.Direction and p10.Direction ~= p11.Direction then
						return false
					else
						return (not p10.Marker or (p10.MarkerIsGuide or ((p11.Position - p10.Marker.Position) * Vector3.new(1, 0, 1)).Magnitude <= p10.Marker.Size)) and true or false
					end
				else
