				return
			elseif p203.UserInputType == Enum.UserInputType.Touch and p_u_197.WorldTouches[p203] then
				p_u_197:FollowFingers(p203)
				return
			elseif not p204 then
				if p203.UserInputType == Enum.UserInputType.MouseWheel then
					if p_u_197:OverMenu(Vector2.new(p203.Position.X, p203.Position.Y)) then
						return
					end
					p_u_197:StartFlying()
