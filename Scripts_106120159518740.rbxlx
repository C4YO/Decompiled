		for v57 = 1, 9 do
			p56.partData[v57] = {}
			for v58 = 1, 12 do
				local v59 = p56.Model.Root:FindFirstChild((("Bone%*_%*"):format(v57, v58)))
				p56.partData[v57][v59] = {
					["point"] = v_u_7.Point.new(v59.WorldPosition, v57 == 1),
					["constraints"] = {},
					["neighbors"] = {}
				}
				local v60 = p56.Model.Root:FindFirstChild((("Bone%*_%*"):format(v57, v58 - 1))) or p56.Model.Root:FindFirstChild((("Bone%*_12"):format(v57)))
				local v61 = p56.Model.Root:FindFirstChild((("Bone%*_%*"):format(v57, v58 + 1))) or p56.Model.Root:FindFirstChild((("Bone%*_1"):format(v57)))
				local v62 = p56.Model.Root:FindFirstChild((("Bone%*_%*"):format(v57 - 1, v58)))
				local v63 = p56.partData[v57][v59]
				local v64 = {}
