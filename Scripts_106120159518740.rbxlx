	v_u_2.parentInstance = p3
	v_u_2._started = true
	v_u_2._generateRootInstance()
	v_u_2._generateSelectionImageObject()
	for _, v7 in v_u_2._initFunctions do
		v7()
	end
	local _ = os.clock() - 120
	task.delay(0.5, function()
		-- upvalues: (ref) v_u_2
		v_u_2._cycle(game:GetService("RunService").Heartbeat:Wait())
	end)
	return v_u_1
end
function v_u_1.ForceRun() -- name: ForceRun
