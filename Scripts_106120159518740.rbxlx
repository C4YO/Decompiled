end
function v_u_1.Step(p6, p7, p8) -- name: Step
	if not p6.Anchored then
		p6.Acceleration = p6.Acceleration + (Vector3.new(0, -22.5, 0) + (p6.basePosition - p6.Position) * p6.constraintReturn + (Vector3.new(0, 0, 0) - p6.Velocity) * p6.velocityReturn)
		p6.Acceleration = p6.Acceleration + p6.forceVelocity
		p6.Velocity = (p6.Position - p6.PreviousPosition) / p7
		p6.PreviousPosition = p6.Position
		if p6.snapBack then
			p6.Position = p6.Position:Lerp(p6.basePosition, p7 * 3)
		else
			p6.Position = p6.Position + (p6.Velocity * p8 * p7 + p6.Acceleration * p7 * p7)
		end
		p6.Acceleration = Vector3.new(0, 0, 0)
		p6.forceVelocity = Vector3.new(0, 0, 0)
	end
end
local v_u_9 = {}
v_u_9.__index = v_u_9
function v_u_9.new(p10, p11, p12) -- name: new
