end
local v_u_9 = workspace.CurrentCamera
function IsInView(p10) -- name: IsInView
	-- upvalues: (copy) v_u_9
	local _, v11 = v_u_9:WorldToViewportPoint(p10)
	if v11 then
		return ((p10 - v_u_9.CFrame.Position) * Vector3.new(1, 0, 1)).Magnitude <= 135
	else
		return false
	end
end
function v_u_2.Update(p12, p13, p14, p15) -- name: Update
	if p12.Root then
		local v16 = os.clock()
		local v17 = p14.data.Spring:GetGoal() ~= 0 and true or p14.data.Spring:GetPosition() > 0.1
		if p15 and not v17 then
			v17 = p15.data.Spring:GetGoal() ~= 0 and true or p15.data.Spring:GetPosition() > 0.1
		end
		if v16 - p12.lastBasketballTime < 0.2 then
			v17 = false
		end
		if v17 then
			p12.sleeping = false
		end
		if p12.sleeping then
			return
		else
			if v16 - (p12.lastViewCheck or 0) >= 0.1 then
				p12.lastViewCheck = v16
				p12.inView = IsInView(p12.Root.Position)
			end
			if p12.inView then
				if v17 then
					for _, v18 in p12.partData do
						for v19, v20 in v18 do
							v20.point.Position = v20.point.Position:Lerp(v19.TransformedWorldCFrame.Position, 0.3)
						end
					end
				end
				local v21 = 0
				local v22 = 0
				local v23 = false
				for _, v24 in p12.partData do
					for _, v25 in v24 do
						if v17 and not v25.point.BaseAnchored then
							v25.point.Anchored = false
							v25.point.snapBack = false
							v25.point:Step(p13, 1)
							v23 = true
						else
							if v25.point.Anchored and v25.point.forceVelocity == Vector3.new(0, 0, 0) or v25.point.BaseAnchored then
								continue
							end
							v23 = true
							if p12.Basketball then
								local v26 = (v25.point.Position - p12.Basketball.Position).Magnitude
								local v27 = (v25.point.Position - v25.point.basePosition).Magnitude
								local v28 = v25.point.Velocity.Magnitude
								v21 = math.max(v21, v28)
								v22 = math.max(v22, v27)
								if v26 < 1.05 then
									p12.lastContactTime = v16
								elseif v21 < 3 and (v22 < 0.2 and v16 - p12.lastContactTime > 0.9) then
									v25.point.snapBack = true
								else
									v25.point.snapBack = false
								end
								if v25.point.forceVelocity ~= Vector3.new(0, 0, 0) then
									v25.point.snapBack = false
								end
							end
							if not v17 and ((v25.point.Position - v25.point.basePosition).Magnitude < 0.02 and (v25.point.forceVelocity == Vector3.new(0, 0, 0) and (not v25.point.BaseAnchored and (v25.point.Velocity.Magnitude < 2 and v16 - p12.lastContactTime > 0.9)))) then
								v25.point.Anchored = true
							end
							v25.point:Step(p13, 1)
