          <Item class="ModuleScript" referent="RBX127">
            <Properties>
              <string name="Name">Courts</string>
              <ProtectedString name="Source"><![CDATA[game:GetService("RunService")
local v1 = {
	["models"] = {}
}
local v_u_2 = nil
local v_u_3 = workspace:GetAttribute("Gamemode") == "Park" and true or workspace:GetAttribute("Gamemode") == "Plaza"
v1.ReleasedBarriers = {}
v1.WatchedHalfCourts = {}
function v1.ShouldBarrierCollide(_, p4) -- name: ShouldBarrierCollide
	-- upvalues: (copy) v_u_3
	return v_u_3 or p4:GetAttribute("StartedGame") == true
end
function v1.IsBarrierHeld(p5, p6) -- name: IsBarrierHeld
	local v7 = p5.CurrentCourt
	if not v7 then
		return false
	end
	for _, v8 in v7.Barriers do
		if v8.Object ~= p6 then
			continue
		end
		return true
	end
	for _, v9 in v7.BenchBarriers do
		if v9.Object ~= p6 then
			continue
		end
		return true
	end
	return false
end
function v1.RefreshBarrier(p10, p11) -- name: RefreshBarrier
	local v12 = p10.ReleasedBarriers[p11]
	if v12 and not p10:IsBarrierHeld(p11) then
		local v13 = p10:ShouldBarrierCollide(v12)
		if p11.CanCollide ~= v13 then
			p11.CanCollide = v13
		end
	end
end
function v1.ReleaseBarrier(p_u_14, p_u_15, p_u_16) -- name: ReleaseBarrier
	local v17 = p_u_14.ReleasedBarriers[p_u_15] ~= nil
	p_u_14.ReleasedBarriers[p_u_15] = p_u_16
	if not v17 then
		p_u_15:GetPropertyChangedSignal("CanCollide"):Connect(function()
			-- upvalues: (copy) p_u_14, (copy) p_u_15
			p_u_14:RefreshBarrier(p_u_15)
		end)
	end
	if not p_u_14.WatchedHalfCourts[p_u_16] then
		p_u_14.WatchedHalfCourts[p_u_16] = true
		p_u_16:GetAttributeChangedSignal("StartedGame"):Connect(function()
			-- upvalues: (copy) p_u_14, (copy) p_u_16
			for v18, v19 in p_u_14.ReleasedBarriers do
				if v19 ~= p_u_16 then
					continue
				end
				p_u_14:RefreshBarrier(v18)
			end
		end)
	end
