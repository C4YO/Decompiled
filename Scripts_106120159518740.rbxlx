                    <Item class="ModuleScript" referent="RBX1222">
                      <Properties>
                        <string name="Name">Layup</string>
                        <ProtectedString name="Source"><![CDATA[local v16 = {
	["Damping"] = 750,
	["Speed"] = 1.85,
	["PlantKey"] = 3,
	["FadeTime"] = 0.325,
	["MeterMultiplier"] = 1.2,
	["GetVelocity"] = nil,
	["GetGoal"] = nil,
	["Velocity"] = nil,
	["GetVelocity"] = function(p1, p2, p3, _, p4, p5) -- name: GetVelocity
		local v6 = p2.data.HumanoidRootPart.Position
		local v7 = (p1 - p3.Position) * Vector3.new(1, 0, 1)
		local _ = p3.CFrame
		local v8 = p3.CFrame.RightVector:Dot(v7.Unit) > -0.25 and p3.CFrame.RightVector:Dot(v7.Unit) < 0.25 and 6 or 4.5
		local v9 = CFrame.new(p1 * Vector3.new(1, 0, 1), p3.Position * Vector3.new(1, 0, 1))
		local v10 = ((p3.Position - v9.LookVector * v8) * Vector3.new(1, 0, 1) - v6 * Vector3.new(1, 0, 1)) / p5
		if v10.Magnitude > 14.5 then
			v10 = v10.Unit * 14.5
		end
		local v11 = v10 ~= v10 and Vector3.new(0, 0, 0) or v10
		if p4 == 1 then
			return v11 * 0.75
		elseif p4 == 2 then
			return v11
		elseif p4 == 3 then
			return p2:GetAttribute("ServerVelocity") * 0.6
		elseif p4 == 4 then
			return p2:GetAttribute("ServerVelocity") * 0.3
		else
			return p4 ~= 5 and Vector3.new(0, 0, 0) or p2:GetAttribute("ServerVelocity") * 0
		end
	end,
	["GetGoal"] = function(p12, _, p13, _, _, _) -- name: GetGoal
