          <Item class="ModuleScript" referent="RBX126">
            <Properties>
              <string name="Name">Characters</string>
              <ProtectedString name="Source"><![CDATA[game:GetService("ReplicatedStorage")
local v_u_1 = game:GetService("RunService")
game:GetService("Players")
local v_u_2 = nil
local v_u_3 = nil
local v_u_4 = nil
local v_u_5 = nil
local v_u_6 = nil
local v_u_7 = nil
return {
	["models"] = {},
	["loading"] = {},
	["__aeroOrder"] = 5,
	["Start"] = function(p_u_8) -- name: Start
		-- upvalues: (copy) v_u_1
		for _, v_u_9 in workspace.Characters:GetChildren() do
			task.defer(function()
				-- upvalues: (copy) p_u_8, (copy) v_u_9
				p_u_8:loadCharacter(v_u_9)
			end)
		end
		workspace.Characters.ChildAdded:Connect(function(p_u_10)
			-- upvalues: (copy) p_u_8
			task.defer(function()
				-- upvalues: (ref) p_u_8, (copy) p_u_10
				p_u_8:loadCharacter(p_u_10)
			end)
		end)
		workspace.Characters.ChildRemoved:Connect(function(p11)
			-- upvalues: (copy) p_u_8
			if p_u_8.models[p11] then
				p_u_8.models[p11]:Destroy()
				p_u_8.models[p11] = nil
			end
		end)
		v_u_1.RenderStepped:Connect(function(p12)
			-- upvalues: (copy) p_u_8
			debug.profilebegin("update characters")
			p_u_8:Update(p12)
			debug.profileend()
		end)
		v_u_1.Stepped:Connect(function(p13)
			-- upvalues: (copy) p_u_8
			debug.profilebegin("update characters: step")
			p_u_8:StepUpdate(p13)
			debug.profileend()
		end)
	end,
	["Get"] = function(p14) -- name: Get
		return p14.models
	end,
	["GetPacket"] = function(p15, p16) -- name: GetPacket
		return p15.models[p16]
	end,
	["GetFromString"] = function(p17, p18) -- name: GetFromString
		for _, v19 in p17.models do
			if v19.model.Name ~= p18 then
