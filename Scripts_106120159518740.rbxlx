						warn("remove from loading")
						p_u_20.loading[p_u_21] = nil
						return
					end
					p_u_20.models[p_u_21]:Destroy()
					p_u_20.models[p_u_21] = nil
					p_u_20:loadCharacter(p_u_21)
				end
			end)
			p_u_20.loading[p_u_21] = true
			local v24 = v_u_6.new(p_u_21, p_u_21.Name ~= p_u_20.Player.Name)
			if p_u_20.loading[p_u_21] then
				p_u_20.loading[p_u_21] = nil
