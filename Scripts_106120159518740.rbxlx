	end,
	["removePacket"] = function(p3, p4) -- name: removePacket
		local v5 = table.find(p3.ActivePackets, p4)
		if v5 then
			table.remove(p3.ActivePackets, v5)
		end
	end,
	["Init"] = function(p_u_6) -- name: Init
		p_u_6.Services.PhysicsService.anchorPacket:Connect(function(p7, p8)
			p7.Anchored = p8
