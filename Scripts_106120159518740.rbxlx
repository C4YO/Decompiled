	v5.Position = p2
	v5.PreviousPosition = p2
	v5.Velocity = Vector3.new(0, 0, 0)
	v5.Acceleration = Vector3.new(0, 0, 0)
	v5.PreviousDt = tick()
	v5.originalPosition = p2
	v5.Anchored = p3 or false
	v5.BaseAnchored = p3 or false
	v5.constraintReturn = 0.7
	v5.velocityReturn = 0.8
	v5.snapBack = false
	v5.forceVelocity = Vector3.new(0, 0, 0)
