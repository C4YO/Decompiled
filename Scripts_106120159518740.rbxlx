				end
			elseif v18.Name == "FGPercentage" then
				if p15.Stats[p16].ThreesAttempted > 0 or p15.Stats[p16].TwosAttempted > 0 then
					local v25 = p15.Stats[p16].ThreesMade + p15.Stats[p16].TwosMade
					local v26 = p15.Stats[p16].ThreesAttempted + p15.Stats[p16].TwosAttempted
					local v27 = v18.Value
					local v28 = v25 / v26 * 100
					v27.Text = ("%*%%"):format((math.floor(v28)))
				else
					v18.Value.Text = "N/A"
				end
			elseif v18.Name == "Rebounds" then
				v18.Value.Text = p15.Stats[p16].OffensiveRebounds + p15.Stats[p16].DefensiveRebounds
			else
				if v18.Name ~= "Points" then
