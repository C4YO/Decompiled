              <Item class="ModuleScript" referent="RBX1248">
                <Properties>
                  <string name="Name">Shooting</string>
                  <ProtectedString name="Source"><![CDATA[return {
	["Moves"] = {},
	["Init"] = function(p1) -- name: Init
		for _, v2 in script.Packages:GetChildren() do
			local v3 = v2.Name
			local v4 = tostring(v3)
			for _, v5 in v2:GetDescendants() do
				if not v5:IsA("ModuleScript") then
					continue
				end
				if not p1[v5.Name] then
					p1[v5.Name] = {}
				end
				p1[v5.Name][v4] = require(v5)
			end
		end
		return p1
	end
}]]></ProtectedString>
