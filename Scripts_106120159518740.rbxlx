			v_u_22 = p_u_21:GetPropertyChangedSignal("Name"):Connect(function()
				-- upvalues: (ref) v_u_22, (copy) p_u_20, (copy) p_u_21
				v_u_22:Disconnect()
				p_u_20:loadCharacter(p_u_21)
