		},
		["Headband"] = {
			["Max"] = 1,
			["Part"] = "Head"
		},
		["Hats"] = {
			["Max"] = 2,
			["Part"] = "Head"
		},
		["Chain"] = {
			["Max"] = 1,
			["Part"] = "UpperTorso"
		},
		["Backpack"] = {
			["Max"] = 1,
			["Part"] = "UpperTorso"
		},
		["Glasses"] = {
			["Max"] = 2,
			["Part"] = "Head"
		},
		["Mascot"] = {
			["Max"] = 1
		}
	},
	["Takeover"] = {
		["Crafty Finisher"] = "Increases shot percentages on finishing shot attempts off a gather and clutch layup percentages, speeds up gathers, and increase the ability to finish on taller players.",
		["Highlight Reel"] = "Increases blowby succession, boosts driving dunk percentages, and increases posterizer chance.",
		["Rim Rocker"] = "Increase percentages on lob finishing attempts, increase posterizer chance, and increase the player\226\128\153s catch succession on lobs.",
		["Diesel"] = "Increases post backdown strength, increases posterizer chance, along with increasing standing dunk percentages.",
		["Knockdown Shooter"] = "Increases shooting range from deep, decreases late contest from defenders on standing shots, and increases shot percentages off the catch.",
		["Fadeaway King"] = "Increases the player\226\128\153s fadeaway speed, increases range on fadeaway shots, and also boosts shot percentages on fades.",
		["Post General"] = "Increases post shot range, decreases late contest on all post shots, also increases all post shot percentages.",
		["Smooth Operator"] = "Increases shot succession off the dribble, boosts the range that a player can off-dribble from slightly, decreases late contest on shots that are off the dribble as well.",
		["Artist"] = "Increase chances of ankle breakers off of dribbling and gathers, gives more space off dribble moves and gathers, and speeds up dribble combos.",
		["Downhill"] = "Increases blowby succession while driving and increases speed with the ball.",
		["Team Riser"] = "Boosts teammate\226\128\153s shot percentages on every assist. Increases pass speed and also makes passes harder to intercept while boosting all teammates\' stats by +2 (does not stack).",
		["Control Tower"] = "Increases teammate shot percentage after receiving a pass, as well as increasing passing speed in the post and post move speed.",
		["Board Hunter"] = "Increases boxout strength, improves rebounding ability, and allows visibility of where the ball will land on the rim.",
		["Hound"] = "Increases lane steal ability, improves perimeter contests, drains more stamina on bumps, lowers ankle break chance, and increases on-ball steal success.",
		["Glue Guy"] = "Increases ability to dive for loose balls, improves rebounding, and boosts contest ability on both perimeter and interior along with lateral quickness.",
		["Paint Controller"] = "Increases block and chasedown hitboxes, improves jump speed and height for blocks, making rim protection more effective.",
		["Unleash"] = "Increases all physical stats significantly while also providing a boost to all other stats.",
		["Resolve"] = "Reduces stamina drain, improves endurance and hustle, while also providing a boost to all other stats."
	},
	["Badges"] = {
		["Playmaking"] = {
			["Space Maker"] = "Improves a player\226\128\153s ability to create space from a defender. When performing any stepback move or shot, there\226\128\153s a higher chance of successfully creating separation from the opponent.",
			["Tireless Handles"] = "Reduces the amount of energy lost when performing dribble moves. A player takes less of an energy hit when performing consecutive dribble moves, allowing them to chain together combos quicker for longer periods of time.",
			["Quick Handles"] = "Improves the ability to quickly chain dribble moves together.",
			["Quick Pass"] = "Improves a player\226\128\153s ability to quickly pass the ball. Speeds up how quickly a player gets the ball out of their hands as well as the velocity of the pass.",
			["Dish Out"] = "Increases the chances of successfully completing a pass from mid-air. Passing out of a jump shot or layup yields fewer errant passes than normal.",
			["Glove"] = "Reduces the chances of getting stripped by the defender. When performing dribble moves, defenders have a tougher time poking the ball free with their steal attempts.",
			["Dimer"] = "Boosts the shot percentage for open teammates on jump shots after catching a pass. When in the half-court, passes by Dimers to open shooters yield a shot percentage boost.",
			["Soul Snatcher"] = "Improves the likelihood of freezing or dropping a defender during dribble moves. When performing stepbacks and other certain moves, the defender Stumbles or falls more frequently when biting the wrong way.",
			["Whistle Wizard"] = "Improves the likelihood of a foul being called.",
			["Post Footwork"] = "Increases the speed of post moves",
			["Fast Breaker"] = "Improves player speed when on the fast break."
		},
		["Shooting"] = {
			["Limitless Shooter"] = "Boosts the range that one can effectively shoot standing three-point shots.",
			["Catch & Pop"] = "Boosts the chance of hitting a jump shot immediately after a catch. For a short time after receiving a pass, the receiver\226\128\153s outside shooting attributes get a significant boost.",
			["Corner Spot-Up"] = "Gives a boost to shots taken near the corner. Deep mid-range or 3PT shots taken along the baseline of the court receive a boost, whether it is off the dribble or off a catch.",
			["Formless Shooter"] = "Improves the ability to shoot difficult shots off the dribble. High difficulty jumpers such as hop steps, spins, stepbacks, and pull-ups receive a shot percentage boost.",
			["Momentum Shooter"] = "",
			["Tunnel Vision"] = "Reduces the impact of a defender who is closing out. Jump shots taken with a defender closing out receive less of a penalty from a shot contest. This includes both mid-range and 3PT shots.",
			["Quick Draw"] = "Quicker jumpshot off the catch and shoot.",
			["Fade Artist"] = "Improves the ability to shoot acrobatic shots.",
			["Relentless Shooter"] = "Shot % penalty is not as bad when shooting on low stamina.",
			["Deep Post Bag"] = "Increases the speed of shots that are out of the post.",
			["Midrange Maestro"] = "Increases the chance of hitting midrange shots."
		},
		["Finishing"] = {
			["Traffic Finisher"] = "Slashers who play below the rim finish contact layups more successfully while dunkers are able to pull off more contact dunks.",
			["Acro Finisher"] = "",
			["Quick Feet"] = "",
			["Relentless Finisher"] = "Improves a player\'s ability to convert contact layups. Strengthens a player\'s ability to absorb contact and still finish. Also reduces the amount of energy lost from contact layups.",
			["Alley-oop Finisher"] = "Increases make % for a successful alley-oop catch.",
			["Perfect Lays"] = "Gives an additional boost for having good layup timing. Gives an extra shot boost for having slightly early, slightly late, or excellent shot timing on layups.",
			["PutBack Finisher"] = "Improves the ability to catch the basketball on putback attempts.",
			["Aerial Assault"] = "Increases the chance of hitting floaters.",
			["Gymnast"] = "Boosts the ability to hit high degrees of difficulty layups. Spin, half-spin, hop step, euro-step, cradle, reverse and change shot layup attempts receive a significant boost. Additionally, the ability to beat defenders with these gathers is improved.",
			["High Flyer"] = "Improves the dunk range on driving dunk attempts.",
			["Paint King"] = "Increases the chance of bumping your defender."
		},
		["Defense"] = {
			["Tough Ankles"] = "Reduces the chances of getting crossed over. Lowers the likelihood of getting ankle-broken by opposing dribble moves.",
			["Locks"] = "Boosts the ability to stay in front of the ball handler on the perimeter. Defenders have access to quicker cut off moves and are more successful when bumping or hip riding the ball handler.",
			["Intimidator"] = "Intimidates offensive players causing them to miss shots more often. Offensive players have less success shooting when contested by players with this badge. Also boosts the shot defense ratings when tightly guarding an opponent.",
			["Thief"] = "Improves a player\226\128\153s ability to steal the ball from a ball handler. Increases the chances of a steal and reduces the chances of a foul when attempting to strip the ball from a ball handler. Also improves the chances of successful layup strips.",
			["Trampoline"] = "",
			["Lurker"] = "Improves a player\'s ability to get chasedown blocks.",
			["Post Lockdown"] = "Improves the defender\226\128\153s ability to defend post moves. Increases the chances bumps/pushbacks on a defender preventing an offensive post move from succeeding.",
			["Rebound Chaser"] = "Improves a player\226\128\153s ability to chase down rebounds. Improves a player\226\128\153s ability to track down rebounds from farther distances than normal.",
			["Rim Saver"] = "Improves ability to block shots, gives boost to the Takeover meter for blocker/teammates. Improves player\226\128\153s ability to block shots, unlocks special block animations and gives boost to the Takeover meter for the blocker and blocker\226\128\153s teammates following a block.",
			["Iron Screens"] = "Increases effectiveness of screens and drains energy from opponents on physical contact. This badge makes it tougher for the defense to get through or around screens. Players hit by contact from a Brick Wall lose more energy than normal.",
			["Navigator"] = "Improves a player\226\128\153s ability to navigate through screens effectively on defense.",
			["Hustler"] = "Improves the overall speed and the ability to catch loose balls. Also increases defensive speed during fast breaks."
		}
	},
