					continue
				end
				v139.UnselectedFrame.Content.Information.Context.RichText = true
				v139.UnselectedFrame.Content.Information.Context.Text = p138
			end
		end
	end
	task.spawn(function()
		-- upvalues: (copy) p_u_135, (copy) v_u_140, (copy) v_u_137
		while true do
			local v141 = p_u_135.Controllers.Store:GetStarterOfferEnd()
			if v141 then
				v141 = v141 - os.time()
			end
			local v142 = p_u_135.Pages.Store
			if v142 then
				v142 = p_u_135.Pages.Store.Motion
			end
			if v141 and (v141 > 0 and (v142 and not p_u_135.Controllers.Store:WasGivenStarterPack())) then
				v_u_140((("<font color=\"#FF5252\">Starter Pack ends in %*</font>"):format((v142:FormatClock(v141)))))
			else
				v_u_140(v_u_137)
			end
			task.wait(1)
		end
	end)
