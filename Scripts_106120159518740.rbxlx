                  <ProtectedString name="Source"><![CDATA[local v_u_24 = {
	["__index"] = function(p_u_1, p2)
		-- upvalues: (copy) v_u_24
		if p2 == "TimePosition" then
			return p_u_1.AnimationObject.TimePosition
		end
		local v3 = v_u_24
		local v4 = rawget(v3, p2)
		if v4 ~= nil then
			return v4
		end
		local v_u_5 = p_u_1.AnimationObject[p2]
		return typeof(v_u_5) == "function" and function(_, ...)
			-- upvalues: (copy) v_u_5, (copy) p_u_1
			return v_u_5(p_u_1.AnimationObject, ...)
		end or v_u_5
	end,
	["__newindex"] = function(p6, p7, p8)
		if p7 == "TimePosition" then
			p6.AnimationObject.TimePosition = p8
		else
			rawset(p6, p7, p8)
		end
	end,
	["Play"] = function(p9, p10, p11, p12) -- name: Play
		p9.IsPlaying = true
		p9.AnimationObject:Play(p10, p11, p12)
	end,
	["Stop"] = function(p13, p14) -- name: Stop
		p13.IsPlaying = false
		p13.AnimationObject:Stop(p14)
	end,
	["AdjustWeight"] = function(p15, p16) -- name: AdjustWeight
		p15.AnimationObject:AdjustWeight(p16)
	end,
	["AdjustSpeed"] = function(p17, p18) -- name: AdjustSpeed
		p17.AnimationObject:AdjustSpeed(p18)
	end,
	["new"] = function(p19, p20) -- name: new
		-- upvalues: (copy) v_u_24
		local v21 = v_u_24
		local v22 = setmetatable({
			["IsPlaying"] = false
		}, v21)
		v22.AnimationObject = p20:LoadAnimation(p19)
		return v22
	end,
	["Destroy"] = function(p23) -- name: Destroy
		p23.AnimationObject:Destroy()
	end
}
return v_u_24]]></ProtectedString>
