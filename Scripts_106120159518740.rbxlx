            <Item class="ModuleScript" referent="RBX543">
              <Properties>
                <string name="Name">AxisConstraint.spec</string>
                <ProtectedString name="Source"><![CDATA[local v_u_1 = require(script.Parent:WaitForChild("AxisConstraint"))
return function()
	-- upvalues: (copy) v_u_1
	local v_u_2 = {
		["Radius"] = 0,
		["XAxisLimits"] = nil,
		["YAxisLimits"] = nil,
		["ZAxisLimits"] = nil,
		["AxisLocked"] = nil,
		["ClipVelocity"] = nil,
		["XAxisLimits"] = NumberRange.new((-1 / 0), (1 / 0)),
		["YAxisLimits"] = NumberRange.new((-1 / 0), (1 / 0)),
		["ZAxisLimits"] = NumberRange.new((-1 / 0), (1 / 0)),
		["AxisLocked"] = { false, false, false },
		["ClipVelocity"] = function() -- name: ClipVelocity end
	}
	afterEach(function()
		-- upvalues: (copy) v_u_2
		v_u_2.AxisLocked = { false, false, false }
	end)
	describe("Axis Lock", function()
		-- upvalues: (copy) v_u_2, (ref) v_u_1
		it("Should lock X Axis", function()
			-- upvalues: (ref) v_u_2, (ref) v_u_1
			v_u_2.AxisLocked = { true, false, false }
			local v3 = v_u_1(v_u_2, Vector3.new(-10, 0, 0), Vector3.new(0, 0, 0), CFrame.identity)
			expect(v3.X).to.equal(0)
		end)
		it("Should lock Y Axis", function()
			-- upvalues: (ref) v_u_2, (ref) v_u_1
			v_u_2.AxisLocked = { false, true, false }
			local v4 = v_u_1(v_u_2, Vector3.new(0, -10, 0), Vector3.new(0, 0, 0), CFrame.identity)
			expect(v4.Y).to.equal(0)
		end)
		it("Should lock Z Axis", function()
			-- upvalues: (ref) v_u_2, (ref) v_u_1
			v_u_2.AxisLocked = { false, false, true }
			local v5 = v_u_1(v_u_2, Vector3.new(0, 0, -10), Vector3.new(0, 0, 0), CFrame.identity)
			expect(v5.Z).to.equal(0)
		end)
	end)
	describe("Axis Limit", function()
		-- upvalues: (copy) v_u_2, (ref) v_u_1
		describe("Should limit X Axis", function()
			-- upvalues: (ref) v_u_2, (ref) v_u_1
			it("Min Limit", function()
				-- upvalues: (ref) v_u_2, (ref) v_u_1
				v_u_2.XAxisLimits = NumberRange.new(-5, (1 / 0))
				local v6 = v_u_1(v_u_2, Vector3.new(-10, 0, 0), Vector3.new(0, 0, 0), CFrame.identity)
				expect(v6.X).to.equal(-5)
			end)
			it("Max Limit", function()
				-- upvalues: (ref) v_u_2, (ref) v_u_1
				v_u_2.XAxisLimits = NumberRange.new((-1 / 0), 5)
				local v7 = v_u_1(v_u_2, Vector3.new(10, 0, 0), Vector3.new(0, 0, 0), CFrame.identity)
				expect(v7.X).to.equal(5)
			end)
		end)
		describe("Should limit Y Axis", function()
			-- upvalues: (ref) v_u_2, (ref) v_u_1
			it("Min Limit", function()
				-- upvalues: (ref) v_u_2, (ref) v_u_1
				v_u_2.YAxisLimits = NumberRange.new(-5, (1 / 0))
				local v8 = v_u_1(v_u_2, Vector3.new(0, -10, 0), Vector3.new(0, 0, 0), CFrame.identity)
				expect(v8.Y).to.equal(-5)
			end)
			it("Max Limit", function()
				-- upvalues: (ref) v_u_2, (ref) v_u_1
				v_u_2.YAxisLimits = NumberRange.new((-1 / 0), 5)
				local v9 = v_u_1(v_u_2, Vector3.new(0, 10, 0), Vector3.new(0, 0, 0), CFrame.identity)
				expect(v9.Y).to.equal(5)
			end)
		end)
		describe("Should limit Z Axis", function()
			-- upvalues: (ref) v_u_2, (ref) v_u_1
			it("Min Limit", function()
				-- upvalues: (ref) v_u_2, (ref) v_u_1
				v_u_2.ZAxisLimits = NumberRange.new(-5, (1 / 0))
				local v10 = v_u_1(v_u_2, Vector3.new(0, 0, -10), Vector3.new(0, 0, 0), CFrame.identity)
				expect(v10.Z).to.equal(-5)
			end)
			it("Max Limit", function()
				-- upvalues: (ref) v_u_2, (ref) v_u_1
				v_u_2.ZAxisLimits = NumberRange.new((-1 / 0), 5)
				local v11 = v_u_1(v_u_2, Vector3.new(0, 0, 10), Vector3.new(0, 0, 0), CFrame.identity)
				expect(v11.Z).to.equal(5)
			end)
		end)
	end)
end]]></ProtectedString>
