                  <Properties>
                    <string name="Name">Presets</string>
                    <ProtectedString name="Source"><![CDATA[local v_u_1 = false
local v_u_2 = {
	"PG",
	"SG",
	"SF",
	"PF",
	"C"
}
local v_u_3 = {
	["Background"] = 0.88,
	["Line"] = 0.5
}
local v_u_4 = {
	["Background"] = 0.82,
	["Line"] = 0.25
}
local v_u_5 = {
	["Background"] = 0.76,
	["Line"] = 0
}
local v_u_6 = {
	["Attributes"] = UDim2.new(0.984, 0, 0.054, 0),
	["Buttons"] = UDim2.new(0.05, 0, 0.471, 0),
