				v65.index = tonumber(v66)
				v65.elasticDistance = (v59.Position - v60.Position).Magnitude
				v64[v60] = v65
				local v67 = {
					["layer"] = v57
				}
				local v68 = v61.Name
				v67.index = tonumber(v68)
				v67.elasticDistance = (v59.Position - v61.Position).Magnitude
				v64[v61] = v67
				v63.neighbors = v64
				if not v62 then
