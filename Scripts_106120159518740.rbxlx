		}
		local v185 = p_u_1.Checkbox({ "User-Generated State" }, v184)
		p_u_1.Text({ (("isChecked: %*\n"):format(v185.state.isChecked.value)) })
		local v186 = p_u_1.Checkbox({ "Widget Coupled State" })
		local v187 = p_u_1.Checkbox({ "Coupled to above Checkbox" }, {
			["isChecked"] = v186.state.isChecked
		})
		p_u_1.Text({ (("isChecked: %*\n"):format(v187.state.isChecked.value)) })
		local v188 = p_u_1.State(false)
		p_u_1.Checkbox({ "Widget and Code Coupled State" }, {
			["isChecked"] = v188
		})
		if p_u_1.Button({ "Click to toggle above checkbox" }).clicked() then
