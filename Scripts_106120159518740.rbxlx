              <Properties>
                <string name="Name">ReplicationConfig</string>
                <ProtectedString name="Source"><![CDATA[local v1 = game:GetService("RunService")
local v_u_2 = {
	["Network"] = nil,
	["Snapshot"] = nil,
	["Ball"] = nil,
	["Character"] = nil,
	["Debug"] = false,
	["Network"] = {
		["SEND_RATE"] = 60,
		["SERVER_START_TIME"] = nil,
		["SERVER_START_TIME"] = workspace:GetAttribute("SERVER_START_TIME") or 1000000000
	},
	["Snapshot"] = {
		["MAX"] = 64,
		["DELAY_MIN"] = 0.02,
		["DELAY_MAX"] = 0.06,
		["PREDICT"] = 0.75,
		["PREDICT_MAX"] = 0.1,
		["EXTRAPOLATION"] = 0.1,
		["NORMAL_SHARPNESS"] = 45,
		["FAST_SHARPNESS"] = 70,
		["AGGRESSIVE_ERROR"] = 1.25,
		["SNAP_ERROR"] = 4
	},
	["Ball"] = {
		["SEND_RATE"] = 50,
		["DELAY"] = 0.05
	},
	["Character"] = {
		["SPEED_SCALE"] = 5,
		["CHARACTER_SIZE"] = Vector3.new(3.9, 6.15, 2),
		["EVALUATE_PERFORMANCE_RATE"] = 0.5,
		["OFF_COURT_RENDER_TIME"] = 0.06666666666666667
	}
}
v_u_2.Network.INTERVAL = 1 / v_u_2.Network.SEND_RATE
v_u_2.Network.BALL_INTERVAL = 1 / v_u_2.Ball.SEND_RATE
if not v1:IsServer() or workspace:GetAttribute("SERVER_START_TIME") then
	if v1:IsClient() then
		workspace:GetAttributeChangedSignal("SERVER_START_TIME"):Connect(function()
			-- upvalues: (copy) v_u_2
			v_u_2.Network.SERVER_START_TIME = workspace:GetAttribute("SERVER_START_TIME")
		end)
	end
	return v_u_2
end
local v3 = workspace:GetServerTimeNow()
local v4 = math.round(v3)
workspace:SetAttribute("SERVER_START_TIME", v4)
v_u_2.Network.SERVER_START_TIME = v4
return v_u_2]]></ProtectedString>
