function comma_value(p120) -- name: comma_value
	repeat
		local v121
		p120, v121 = string.gsub(p120, "^(-?%d+)(%d%d%d)", "%1,%2")
	until v121 == 0
	return p120
end
function v_u_119.UpdateCart(p122) -- name: UpdateCart
	for v123, v124 in p122.CartFrames do
		if p122.ChangedAttributes[v123] then
			continue
		end
		v124.Maid:DoCleaning()
		v124.Object:Destroy()
		p122.CartFrames[v123] = nil
	end
	for v125, v126 in p122.ChangedAttributes do
		local v127 = p122:GetOriginal(v125)
		if v126 - v127 == 0 then
			if not p122.CartFrames[v125] then
				continue
			end
			p122.CartFrames[v125].Maid:DoCleaning()
			p122.CartFrames[v125].Object:Destroy()
			p122.CartFrames[v125] = nil
		else
			local v128 = p122.CartFrames[v125] and p122.CartFrames[v125].Object or p122.CartItemsFrame.Example.Frame:Clone()
			v128.ItemName.Text = ("%* (%*) -> (%*)"):format(v125, v127, v126)
			v128.ItemPrice.Text = ("%*"):format((comma_value(p122:UpgradeFromCost(v127, v126, v125))))
			v128.Parent = p122.CartItemsFrame
			v128.Visible = true
			if p122.CartFrames[v125] then
				continue
			end
			local v129 = {
				["Object"] = v128,
				["Maid"] = p122.Shared.Maid.new()
			}
			p122.CartFrames[v125] = v129
		end
	end
	p122:GetOriginal()
	p122.CartFrame.TotalPrice.Text = ("%*"):format((comma_value(p122:CalculateFullUpgradeCost(p122:GetOriginal(), p122:GetCurrentAttributes()))))
end
function v_u_119.Update(p130) -- name: Update
	local v131 = p130:GetSlotData()
	local v132 = v131.MaxAttributes
	local v133 = p130:GetOverallFromAttributes() >= 99
	for v134, v135 in p130.AttributeFrames do
		local v136 = p130.ChangedAttributes[v134] or p130:GetOriginal(v134)
		v135.Maximum.Text = v132[v134]
		v135.Current.Text = v136
		v135.Label.TextTransparency = v136 ~= v132[v134] and 0.15 or v135.TextTransparency
		if v135.Up and p130.ArrowStates then
			local v137 = v135.Up
			local v138
			if v136 < v132[v134] then
				v138 = not v133
			else
				v138 = false
			end
			p130:SetArrowEnabled(v137, v138)
			p130:SetArrowEnabled(v135.Down, p130:GetOriginal(v134) < v136)
		end
		if not v135.UseGradient then
			continue
		end
		local v139 = v136 / 99
		local v140 = (v131.MaxAttributes[v134] - v136) / 99
		local _ = v132[v134] / 99
		if v139 == 1 then
			v135.Object.Main.Base.UIGradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0) })
		else
			v135.Object.Main.Base.UIGradient.Transparency = p130.Shared.Util.NumberUtil.CreateOrderedSequence({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(v139, 0),
				NumberSequenceKeypoint.new(v139 + 0.0001, 1),
				NumberSequenceKeypoint.new(1, 1)
			})
			local v141 = v135.Object.Main.MaxFrame.UIGradient
			local v142 = p130.Shared.Util.NumberUtil.CreateOrderedSequence
			local v143 = {}
			local v144 = NumberSequenceKeypoint.new(0, 1)
			local v145 = NumberSequenceKeypoint.new(v139, 1)
			local v146 = NumberSequenceKeypoint.new(v139 + 0.0001, 0)
			local v147 = NumberSequenceKeypoint.new
			local v148 = v139 + 0.0001 + v140
			local v149 = v147(math.clamp(v148, 0, 1), 0)
			local v150 = NumberSequenceKeypoint.new
			local v151 = v139 + 0.0002 + v140 + 0.0001
			__set_list(v143, 1, {v144, v145, v146, v149, v150(math.clamp(v151, 0, 1), 1), NumberSequenceKeypoint.new(1, 1)})
			v141.Transparency = v142(v143)
		end
	end
	local v152 = p130:GetShownOverall(p130:GetOverallFromAttributes())
	local v153 = p130.Shared.Util.TableUtil.GetTableLength(p130.ChangedAttributes) ~= 0
	local v154 = v152 / 99
	local v155 = p130.Rotation1
	local v156 = v154 * 360
	v155.Rotation = math.clamp(v156, 180, 360)
	local v157 = p130.Rotation2
	local v158 = v154 * 360
	v157.Rotation = math.clamp(v158, 0, 180)
	p130.OverallFrame.Overall.Text = v152
	p130.Header.Inaccurate1.Visible = v153
	p130.Header.Inaccurate2.Visible = v153
	p130.Header.Inaccurate3.Visible = v153
	p130:UpdateCart()
end
