            <Properties>
              <string name="Name">Onboarding</string>
              <ProtectedString name="Source"><![CDATA[local v1 = {
	["GAME7_ON"] = false
}
v1.Steps = {
	["Joined"] = 1,
	["IntroDone"] = 2,
	["TutorialStarted"] = 3,
	["Jumpshot"] = 4,
	["Pass"] = 5,
	["Steal"] = 6,
	["Game7Joined"] = nil,
	["Game7Started"] = nil,
	["Game7Finished"] = nil,
	["BackInMenu"] = nil,
	["Game7Joined"] = v1.GAME7_ON and 7 or nil,
	["Game7Started"] = v1.GAME7_ON and 8 or nil,
	["Game7Finished"] = v1.GAME7_ON and 9 or nil,
	["BackInMenu"] = v1.GAME7_ON and 10 or 7
}
v1.StepNames = {
	"Joined",
	"Intro Done",
	"Tutorial Started",
	"Jumpshot Drill Done",
	"Pass Drill Done",
	"Steal Drill Done",
	"Back In Menu"
}
if v1.GAME7_ON then
	local v2 = v1.StepNames
	local v3 = v1.Steps.Game7Joined
	table.insert(v2, v3, "Game 7 Joined")
	local v4 = v1.StepNames
	local v5 = v1.Steps.Game7Started
	table.insert(v4, v5, "Game 7 Started")
	local v6 = v1.StepNames
	local v7 = v1.Steps.Game7Finished
	table.insert(v6, v7, "Game 7 Finished")
end
v1.DrillSteps = {
	["Jumpshot"] = v1.Steps.Jumpshot,
	["Pass"] = v1.Steps.Pass,
	["StealBall"] = v1.Steps.Steal
}
v1.DONE = 1000
function v1.IsActive(p8, p9) -- name: IsActive
	local v10 = p9 and p9.OnboardingStep or 0
	local v11
	if p8.Steps.Joined <= v10 then
		v11 = v10 < p8.DONE
	else
		v11 = false
	end
	return v11
end
function v1.WantsGame7(p12, p13) -- name: WantsGame7
	local v14 = p12.GAME7_ON and (p13 ~= nil and not p12:IsActive(p13))
	if v14 then
		v14 = p13.Game7Seen ~= true
	end
	return v14
end
function v1.IsHoldingPopups(p15, p16) -- name: IsHoldingPopups
	return p15:IsActive(p16) and p16.OnboardingStep < (p15.Steps.Game7Joined or p15.Steps.BackInMenu) and true or p15:WantsGame7(p16)
end
function v1.GetsShotHelp(p17, p18) -- name: GetsShotHelp
	local v19
	if workspace:GetAttribute("TutorialQuick") == true then
		v19 = true
	elseif workspace:GetAttribute("Game7") == true then
		v19 = p17:IsActive(p18)
	else
		v19 = false
	end
	return v19
end
return v1]]></ProtectedString>
