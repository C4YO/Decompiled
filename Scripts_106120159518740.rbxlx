		})
		if v142.value == false then
			p_u_1.End()
		else
			p_u_1.SameLine()
			p_u_1.Text({ "Table using NextRow and NextColumn syntax:" })
			v_u_10("calling Iris.NextRow() in the outer loop, and Iris.NextColumn()in the inner loop")
			p_u_1.End()
			p_u_1.Table({ 3 })
