            <Item class="ModuleScript" referent="RBX545">
              <Properties>
                <string name="Name">DistanceConstraint</string>
                <ProtectedString name="Source"><![CDATA[return function(p1, p2, p3)
	debug.profilebegin("Distance Constraint")
	local v4 = p3.Bones[p1.ParentIndex]
