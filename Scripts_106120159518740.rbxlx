	end
	p280.Gifting:Close()
	p280.Motion:Pause()
	p280.Preview:Stop()
	p280.Transition = true
	p280.PlaybackId = p280.PlaybackId + 1
	local _ = p280.PlaybackId
	p280.Frame.Visible = false
end
function v8.Show(p_u_281, p282) -- name: Show
	p_u_281.Active = true
	if p_u_281.Legacy then
		return p_u_281.Legacy:Show(p282)
	end
	p_u_281.PlaybackId = p_u_281.PlaybackId + 1
	local _ = p_u_281.PlaybackId
	p_u_281.Frame.Visible = true
	p_u_281.Motion:Resume()
	p_u_281.Motion:PlayEntrance(p_u_281.CurrentPage or "Coins")
	task.spawn(function()
