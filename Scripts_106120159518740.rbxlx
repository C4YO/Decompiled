				p_u_1.NextRow()
				for v144 = 1, 3 do
					p_u_1.NextColumn()
					p_u_1.Text({ (("Row: %*, Column: %*"):format(v143, v144)) })
				end
			end
			p_u_1.End()
			p_u_1.Text({ "" })
			p_u_1.SameLine()
			p_u_1.Text({ "Table using NextColumn only syntax:" })
			v_u_10("only calling Iris.NextColumn() in the inner loop, the result is identical")
			p_u_1.End()
			p_u_1.Table({ 2 })
			for v145 = 1, 4 do
				for v146 = 1, 2 do
					p_u_1.NextColumn()
					p_u_1.Text({ (("Row: %*, Column: %*"):format(v145, v146)) })
				end
			end
			p_u_1.End()
			p_u_1.Separator()
			local v147 = p_u_1.State(false)
			local v148 = p_u_1.State(false)
			local v149 = p_u_1.State(true)
			local v150 = p_u_1.State(true)
			local v151 = p_u_1.State(3)
			p_u_1.Text({ "Table with Customizable Arguments" })
			p_u_1.Table({
				4,
				[p_u_1.Args.Table.RowBg] = v147.value,
				[p_u_1.Args.Table.BordersOuter] = v148.value,
				[p_u_1.Args.Table.BordersInner] = v149.value
			})
			for v152 = 1, v151:get() do
				for v153 = 1, 4 do
					p_u_1.NextColumn()
					if v150.value then
						p_u_1.Button({ (("Month: %*, Week: %*"):format(v152, v153)) })
					else
						p_u_1.Text({ (("Month: %*, Week: %*"):format(v152, v153)) })
					end
				end
			end
			p_u_1.End()
			p_u_1.Checkbox({ "RowBg" }, {
				["isChecked"] = v147
			})
			p_u_1.Checkbox({ "BordersOuter" }, {
				["isChecked"] = v148
			})
			p_u_1.Checkbox({ "BordersInner" }, {
				["isChecked"] = v149
			})
			p_u_1.SameLine()
			p_u_1.RadioButton({ "Buttons", true }, {
				["index"] = v150
			})
			p_u_1.RadioButton({ "Text", false }, {
				["index"] = v150
			})
			p_u_1.End()
			p_u_1.InputNum({
				"Number of rows",
				[p_u_1.Args.InputNum.Min] = 0,
				[p_u_1.Args.InputNum.Max] = 100,
				[p_u_1.Args.InputNum.Format] = "%d"
