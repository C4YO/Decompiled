				continue
			end
			p_u_6:createPacket(v11)
		end
	end,
	["GetNearestBasketball"] = function(p12, p13, p14) -- name: GetNearestBasketball
		local v15 = (1 / 0)
		local v16 = p14 or 2024
		local v17 = nil
		for _, v18 in p12.ActivePackets do
			local v19 = (v18.Position - p13).Magnitude
			if v19 >= v15 or v19 >= v16 then
				continue
			end
			v17 = v18
			v15 = v19
		end
		return v17, v15
	end,
	["GetData"] = function(_) -- name: GetData end,
	["OnUpdate"] = function(_, p20) -- name: OnUpdate
		warn(p20)
	end
}]]></ProtectedString>
