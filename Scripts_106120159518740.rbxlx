		["Tooltip"] = function() -- name: Tooltip
			-- upvalues: (copy) p_u_1
			p_u_1.PushConfig({
				["ContentWidth"] = UDim.new(0, 250)
			})
			p_u_1.Tree({ "Tooltip" })
			if p_u_1.Text({ "Hover over me to reveal a tooltip" }).hovered() then
				p_u_1.Tooltip({ "I am some helpful tooltip text" })
			end
			local v59 = p_u_1.State("Hello ")
			local v60 = p_u_1.State(1)
			if p_u_1.InputNum({
				"# of repeat",
				1,
				1,
				50
			}, {
				["number"] = v60
			}).numberChanged() then
				v59:set(string.rep("Hello ", v60:get()))
			end
			if p_u_1.Checkbox({ "Show dynamic text tooltip" }).state.isChecked.value then
				p_u_1.Tooltip({ v59:get() })
			end
			p_u_1.End()
			p_u_1.PopConfig()
		end,
		["Plotting"] = function() -- name: Plotting
			-- upvalues: (copy) p_u_1
			p_u_1.Tree({ "Plotting" })
			p_u_1.SeparatorText({ "Progress" })
			local v61 = os.clock() * 15
			local v62 = p_u_1.State(0)
			local v63 = v61 % 100 - 50
			local v64 = math.abs(v63) - 7.5
			v62:set(math.clamp(v64, 0, 35) / 35)
			p_u_1.ProgressBar({ "Progress Bar" }, {
				["progress"] = v62
			})
			local v65 = p_u_1.ProgressBar
			local v66 = {}
			local v67 = v62:get() * 1753
			__set_list(v66, 1, {"Progress Bar", (("%*/1753"):format((math.floor(v67))))})
			v65(v66, {
				["progress"] = v62
			})
			p_u_1.SeparatorText({ "Graphs" })
			local v68 = p_u_1.State({
				0.5,
				0.8,
				0.2,
				0.9,
				0.1,
				0.6,
				0.4,
				0.7,
				0.3,
				0
			})
			p_u_1.PlotHistogram({
				"Histogram",
				100,
				0,
				1,
				"random"
			}, {
				["values"] = v68
			})
			p_u_1.PlotLines({
				"Lines",
				100,
				0,
				1,
				"random"
			}, {
				["values"] = v68
			})
			local v69 = p_u_1.State("Cos")
			local v70 = p_u_1.State(37)
			local v71 = p_u_1.State(0)
			local v72 = p_u_1.State({})
			local v73 = p_u_1.State(0)
			local v74 = p_u_1.Checkbox({ "Animate" })
			local v75 = p_u_1.ComboArray({ "Plotting Function" }, {
				["index"] = v69
			}, {
