			local v23 = p_u_1.State(p_u_1._config.ImageColor)
			local v24 = p_u_1.State(p_u_1._config.ImageTransparency)
			p_u_1.InputColor4({ "Image Tint" }, {
				["color"] = v23,
				["transparency"] = v24
			})
			p_u_1.Combo({ "Asset" }, {
				["index"] = v16
			})
			p_u_1.Selectable({ "Robux Small", "rbxasset://textures/ui/common/robux.png" }, {
				["index"] = v16
			})
