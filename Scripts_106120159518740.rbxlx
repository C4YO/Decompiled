			v19.PresetName.Text = string.upper(v_u_18.Name)
			local v20 = v19.BadgePoints
			local v21 = v_u_18.BadgePoints
			v20.Text = tostring(v21)
			local v22 = v19.Vitals
			local v23 = v_u_18.Height
