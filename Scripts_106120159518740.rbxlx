          </Item>
          <Item class="ModuleScript" referent="RBX467">
            <Properties>
              <string name="Name">Slider</string>
              <ProtectedString name="Source"><![CDATA[local v_u_1 = game:GetService("RunService")
local v_u_2 = game:GetService("UserInputService")
local v_u_3 = game:GetService("GuiService")
local v_u_4 = nil
local v_u_5 = nil
local v_u_6 = {
	["_Connections"] = {}
}
v_u_6.__index = v_u_6
function v_u_6.New(p7) -- name: New
	-- upvalues: (copy) v_u_6
	assert(p7, "No object specified")
	local v8 = p7:IsA("Frame") or p7:IsA("ImageLabel")
	assert(v8, "Must be a slider")
	local v9 = p7:FindFirstChild("Drag", true)
	assert(v9, "Must be a slider")
	local v10 = v_u_6
	local v11 = setmetatable({}, v10)
	v11._Object = p7
	v11._Min = 0
	v11._Max = 1
	v11._Value = 1
	v11._Active = false
	v11._Distance = p7:FindFirstChild("Slider", true)
	v11._Number = p7:FindFirstChild("Number", true)
	v11._Drag = p7:FindFirstChild("Drag", true)
	v11._RunConnection = nil
	v11:SetValue(v11._Value)
	return v11
end
function v_u_6.Init(p12) -- name: Init
	-- upvalues: (ref) v_u_4, (ref) v_u_5
	v_u_4 = p12.Shared.ListenerList
	v_u_5 = p12.Player:GetMouse()
end
function v_u_6.SetValue(p13, p14) -- name: SetValue
	local v15 = type(p14) == "number"
	assert(v15, "Value must be a number")
	local v16 = p13._Min
	local v17 = p13._Max
	local v18 = math.clamp(p14, v16, v17)
	local v19 = p13._Number
	local v20 = v18 * 100
	v19.Text = math.floor(v20)
	p13._Distance.Size = UDim2.new(v18, 0, 1, 0)
	p13._Value = v18
end
function v_u_6.Lerp(_, p21, p22, p23) -- name: Lerp
	return p21 + (p22 - p21) * p23
end
function v_u_6.HandleInput(p24, p25, p26) -- name: HandleInput
	assert(p25, "No input object specified")
	assert(p26, "No handler specified")
	local v27 = p24._Object.AbsolutePosition
	local v28 = (p25.Position.X - v27.X) / p24._Object.AbsoluteSize.X
	local v29 = math.clamp(v28, 0, 1)
	local v30 = p24:Lerp(33, 100, v29)
	local v31 = p24._Value
	p24:SetValue(v29)
	p26(v30, v31)
end
function v_u_6.OnUpdate(p_u_32, p_u_33) -- name: OnUpdate
	-- upvalues: (copy) v_u_6, (ref) v_u_4, (copy) v_u_2, (copy) v_u_3, (copy) v_u_1
	if v_u_6._Connections[p_u_32._Object] then
		v_u_6._Connections[p_u_32._Object]:DisconnectAll()
	end
	local v34 = v_u_4.new()
	v_u_6._Connections[p_u_32._Object] = v34
	local v_u_35 = p_u_32._Object.Parent:FindFirstChild("Button") or p_u_32._Object.Parent
	v34:Connect(v_u_35.InputBegan, function(p36)
		-- upvalues: (copy) p_u_32, (copy) p_u_33
		local v37 = p36.UserInputType
		if v37 == Enum.UserInputType.MouseButton1 or v37 == Enum.UserInputType.Touch then
			p_u_32._Active = true
			p_u_32._Number.Visible = true
			p_u_32:HandleInput(p36, p_u_33)
		end
	end)
	v34:Connect(v_u_2.InputBegan, function(p38, p39)
		-- upvalues: (ref) v_u_3, (copy) p_u_32, (copy) v_u_35, (ref) v_u_1, (ref) v_u_2, (copy) p_u_33
		if not p39 then
			if v_u_3.SelectedObject == p_u_32._Drag or v_u_3.SelectedObject == v_u_35 and p38.KeyCode == Enum.KeyCode.ButtonR2 then
				v_u_3:RemoveSelectionGroup("SelectedSlider")
				v_u_3:AddSelectionParent("SelectedSlider", v_u_3.SelectedObject)
				if p_u_32._RunConnection then
					p_u_32._RunConnection:Disconnect()
					p_u_32._RunConnection = nil
				end
				p_u_32._RunConnection = v_u_1.Stepped:Connect(function()
					-- upvalues: (ref) v_u_3, (ref) p_u_32, (ref) v_u_35, (ref) v_u_2, (ref) p_u_33
					if v_u_3.SelectedObject ~= p_u_32._Drag and v_u_3.SelectedObject ~= v_u_35 then
						v_u_3:RemoveSelectionGroup("SelectedSlider")
						if p_u_32._RunConnection then
							p_u_32._RunConnection:Disconnect()
						end
					end
					local v40 = v_u_2:GetGamepadState(Enum.UserInputType.Gamepad1)[17]
					local v41 = 0 + p_u_32._Value
					if v40.Position.X >= 0.4 then
						p_u_32:SetValue(p_u_32._Value + 0.01 + 0.01, true)
					elseif v40.Position.X <= -0.4 then
						p_u_32:SetValue(p_u_32._Value - 0.01, true)
					end
					local v42 = v41 * 100
					local v43 = math.round(v42)
					local v44 = p_u_32._Value * 100
					if v43 ~= math.round(v44) then
						local v45 = p_u_33
						local v46 = p_u_32:Lerp(33, 100, p_u_32._Value)
						v45(math.floor(v46), v41)
					end
					if v40.Position.Y >= 0.5 or v40.Position.Y <= -0.5 then
						v_u_3:RemoveSelectionGroup("SelectedSlider")
						if p_u_32._RunConnection then
							p_u_32._RunConnection:Disconnect()
						end
					end
				end)
			end
		end
	end)
	v34:Connect(v_u_2.InputEnded, function(p47)
		-- upvalues: (copy) p_u_32, (ref) v_u_3
		if p47.KeyCode == Enum.KeyCode.ButtonR2 and p_u_32._RunConnection then
			v_u_3:RemoveSelectionGroup("SelectedSlider")
			if p_u_32._RunConnection then
				p_u_32._RunConnection:Disconnect()
			end
		end
	end)
	v34:Connect(v_u_35.InputEnded, function(p48)
		-- upvalues: (copy) p_u_32
		local v49 = p48.UserInputType
		if v49 == Enum.UserInputType.MouseButton1 or v49 == Enum.UserInputType.Touch then
			p_u_32._Number.Visible = false
			p_u_32._Active = false
		end
	end)
	v34:Connect(v_u_2.InputChanged, function(p50)
		-- upvalues: (copy) p_u_32, (copy) p_u_33
		if p_u_32._Active then
			local v51 = p50.UserInputType
			if v51 == Enum.UserInputType.MouseMovement or v51 == Enum.UserInputType.Touch then
				p_u_32:HandleInput(p50, p_u_33)
			end
		end
	end)
end
return v_u_6]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX468">
            <Properties>
              <string name="Name">Spinner</string>
              <ProtectedString name="Source"><![CDATA[local v_u_1 = game:GetService("RunService")
local v_u_2 = game:GetService("TweenService")
local v_u_3 = TweenInfo.new(1.25, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
return {
	["objects"] = {},
	["Init"] = function(p_u_4) -- name: Init
		-- upvalues: (copy) v_u_1
		print("spin init")
		v_u_1.Heartbeat:Connect(function(p5)
			-- upvalues: (copy) p_u_4
			p_u_4:Update(p5)
		end)
	end,
	["AddObject"] = function(p6, p7, p8, p9) -- name: AddObject
		-- upvalues: (copy) v_u_3, (copy) v_u_2
		local v10 = p9 or v_u_3
		p7.Rotation = 0
		p6.objects[p7] = {
			["speed"] = nil,
			["rotation"] = 0,
			["speed"] = p8 or 750
		}
		p7.Visible = true
		v_u_2:Create(p7, v10, {
			["ImageTransparency"] = 0
		}):Play()
	end,
	["RemoveObject"] = function(p11, p12) -- name: RemoveObject
		-- upvalues: (copy) v_u_2, (copy) v_u_3
		local v13 = v_u_2:Create(p12, v_u_3, {
			["ImageTransparency"] = 1
		})
		v13:Play()
		v13.Completed:Wait()
		p11.objects[p12] = nil
		p12.Visible = false
	end,
	["Update"] = function(p14, p15) -- name: Update
		for v16, v17 in p14.objects do
			v17.rotation = (v17.rotation + v17.speed * p15) % 360
			v16.Rotation = v17.rotation
		end
	end
}]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX469">
            <Properties>
              <string name="Name">StrokeButton</string>
              <ProtectedString name="Source"><![CDATA[local _ = workspace.CurrentCamera
local v_u_1 = nil
local v_u_2 = nil
local v_u_3 = {
	["Active"] = false
}
v_u_3.__index = v_u_3
function v_u_3.Init(p4, _) -- name: Init
	-- upvalues: (ref) v_u_1, (ref) v_u_2
	v_u_1 = p4.Controllers.Sound
	v_u_2 = p4.Shared.Maid
end
function v_u_3.GetSize(p5, p6) -- name: GetSize
	return UDim2.new(p5.Config.Size.X.Scale * p6, p5.Config.Size.X.Offset * p6, p5.Config.Size.Y.Scale * p6, p5.Config.Size.Y.Offset * p6)
end
function v_u_3.GetColor(p7, p8) -- name: GetColor
	return Color3.fromRGB(p7.Config.Color.R * 255 * p8, p7.Config.Color.G * 255 * p8, p7.Config.Color.B * 255 * p8)
end
function v_u_3.Update(p9) -- name: Update
	if p9.TextLabel then
		p9.TextLabel.Text = p9.Config.Text
	end
	local v10 = p9.Config[p9.Selected and "Enter" or p9.State]
	p9.Shared.spr.target(p9.ButtonObject, v10.Damping, v10.Frequency, {
		["Size"] = p9:GetSize(v10.Size)
	})
	p9.Shared.spr.target(p9.ButtonObject, 1, v10.Frequency, {
		["BackgroundColor3"] = p9:GetColor(v10.Color)
	})
	if p9.TextLabel then
		p9.TextLabel.TextColor3 = p9.Config.TextColor
	end
	if p9.White then
