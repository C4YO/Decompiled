		p_u_1.Checkbox({ "ComputedState (dynamic coupling)" }, {
			["isChecked"] = v133
		})
		p_u_1.Checkbox({ "Inverted of above checkbox" }, {
			["isChecked"] = v135
		})
		p_u_1.Text({ (("isChecked: %*\n"):format(v135.value)) })
		p_u_1.End()
	end
	local function v_u_141() -- name: dynamicStyle
