	local v157 = v149 + 0.001
	__set_list(v153, 1, {v154, v155, v156(math.clamp(v157, 0, 0.999), 1), NumberSequenceKeypoint.new(1, 1)})
	local v158 = v152(v153)
	p144.MainFrame.Topbar.Progress.Progression.UIGradient.Transparency = v158
end
