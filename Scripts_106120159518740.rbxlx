function v13.AddShoe(p120, p121, p122) -- name: AddShoe
	-- upvalues: (ref) v_u_6
	if p120.Rig:FindFirstChild((("%*Foot"):format(p121))) then
		local v123 = p122.Model or p122[1]
		local v124 = Color3.fromRGB
		local v125 = p122.Color or p122[2]
		local v126 = v124(table.unpack(v125))
		if p120[p121 .. "Shoe"] and p120[p121 .. "Shoe"].Name == v123 then
			p120:ScaleAccessory(p120[p121 .. "Shoe"].Object)
