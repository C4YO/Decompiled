	["IsComplete"] = function(p1, p2) -- name: IsComplete
		if p2 and (p2.Direction and p2.ShotType) then
			if p2.Direction == "Left" or p2.Direction == "Right" then
				p2.Direction = "Horizontal"
			end
			print(p2.ShotType)
			if p1.ShotType and p1.ShotType ~= p2.ShotType then
				return false
			elseif p1.Direction == "Moving" and p2.Direction == "Idle" or p1.Direction and (p1.Direction ~= "Moving" and p1.Direction ~= p2.Direction) then
				return false
			else
				return (not p1.Marker or ((p2.Position - p1.Marker.Position) * Vector3.new(1, 0, 1)).Magnitude <= p1.Marker.Size) and true or false
			end
		else
			return false
		end
	end
