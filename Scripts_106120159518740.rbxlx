				p_u_20:loadCharacter(p_u_21)
				return
			end
		end
	end,
	["Update"] = function(p26, p27) -- name: Update
		local v28 = os.clock()
		for _, v29 in p26.models do
			v29:Update(p27, v28)
		end
	end,
	["StepUpdate"] = function(p30, p31) -- name: StepUpdate
		local v32 = os.clock()
		for _, v33 in p30.models do
