            <Item class="ModuleScript" referent="RBX1342">
              <Properties>
                <string name="Name">Clock</string>
                <ProtectedString name="Source"><![CDATA[return {
	["Now"] = function() -- name: Now
		return workspace:GetServerTimeNow()
	end,
	["EventTime"] = function(p1) -- name: EventTime
		return workspace:GetServerTimeNow() - p1
	end,
	["FormatCountdown"] = function(p2) -- name: FormatCountdown
		local v3 = math.floor(p2)
		local v4 = math.max(0, v3)
		local v5 = v4 // 86400
		local v6 = v4 % 86400 // 3600
		local v7 = v4 % 3600 // 60
		local v8 = v4 % 60
		if v5 > 0 then
			return ("%*d %*h %*m %*s"):format(v5, v6, v7, v8)
		elseif v6 > 0 then
			return ("%*h %*m %*s"):format(v6, v7, v8)
		elseif v7 > 0 then
			return ("%*m %*s"):format(v7, v8)
		else
			return ("%*s"):format(v8)
		end
	end,
	["FormatClock"] = function(p9) -- name: FormatClock
		local v10 = math.floor(p9)
		local v11 = math.max(0, v10)
		return string.format("%02d:%02d", v11 // 60, v11 % 60)
	end,
	["Noise"] = function(p12, p13, p14) -- name: Noise
		local v15 = math.noise(p13 * (p14 or 1) + 0.37, p12 * 1.618 + 0.5) * 2
		return math.clamp(v15, -1, 1)
	end,
	["Random"] = function(p16, p17) -- name: Random
		return Random.new(math.floor(p16) * 100003 + math.floor(p17)):NextNumber()
	end
}]]></ProtectedString>
