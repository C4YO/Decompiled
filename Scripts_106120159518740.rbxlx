                  <ProtectedString name="Source"><![CDATA[local v44 = {
	["Playmaking"] = {
		["Quick Handles"] = function(p1)
			return p1.Attributes.BallHandle >= 96 and p1.Attributes.Speed >= 88 and 5 or (p1.Attributes.BallHandle >= 88 and p1.Attributes.Speed >= 83 and 4 or (p1.Attributes.BallHandle >= 81 and p1.Attributes.Speed >= 70 and 3 or (p1.Attributes.BallHandle >= 73 and p1.Attributes.Speed >= 65 and 2 or (p1.Attributes.BallHandle >= 67 and p1.Attributes.Speed >= 59 and 1 or false))))
		end,
		["Tireless Handles"] = function(p2)
			return p2.Attributes.BallHandle >= 96 and p2.Attributes.Stamina >= 90 and 5 or (p2.Attributes.BallHandle >= 88 and p2.Attributes.Stamina >= 82 and 4 or (p2.Attributes.BallHandle >= 79 and p2.Attributes.Stamina >= 75 and 3 or (p2.Attributes.BallHandle >= 70 and p2.Attributes.Stamina >= 67 and 2 or (p2.Attributes.BallHandle >= 64 and p2.Attributes.Stamina >= 59 and 1 or false))))
