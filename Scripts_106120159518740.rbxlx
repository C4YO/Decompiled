		-- upvalues: (ref) v_u_2, (copy) v_u_13, (copy) v_u_14
		v_u_2:PreloadAsync(v_u_13, v_u_14)
	end)
end
function v_u_5.OnUpdate(p17, p18) -- name: OnUpdate
	p17.Updated:Connect(p18)
end
function v_u_5.Destroy(p19) -- name: Destroy
	p19.Finished:Destroy()
	p19.Updated:Destroy()
end
return v_u_5]]></ProtectedString>
