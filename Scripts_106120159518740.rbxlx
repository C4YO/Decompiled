	local v146 = p144:GetSlotData()
	local v147 = p144:GetBadgePoints() - p144:GetUsedBadgePoints()
	p144.MainFrame.Topbar.BadgePoints.Number.Text = v147
	local _ = v146.BadgePoints >= v146.MaxBadgePoints
	p144.MainFrame.Topbar.Progress.Progression.Info.Current.Text = v146.BadgeProgression
	local v148 = p144.Shared.Config.Progression.GetBuildPerBadge(v146)
	p144.MainFrame.Topbar.Progress.Progression.Info.Needed.Text = v148
	local v149 = v146.BadgeProgression / v148
