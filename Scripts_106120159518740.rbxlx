				for _, v9 in v8:GetChildren() do
					p_u_5.objects[v7.Name][v8.Name][v9.Name] = v9:IsA("BasePart") and v9 and v9 or v9:FindFirstChild("Circle")
				end
			end
		end
		os.clock()
		task.spawn(function()
			-- upvalues: (copy) p_u_5
			while task.wait(0.1) do
				p_u_5:Update()
