		if #v109 <= 1 then
			break
		end
		local v114 = v_u_7.Court
		local v115 = v107 + 2 + (v107 - 1) - 1
		local v116 = tostring(v115)
		table.insert(v114, v116)
		local v117 = v_u_7.Court
