					v132.Color = v126
					p120:ScaleAccessory(v132)
					v132.Parent = p120.Rig
					p120.Shared.Util.GameUtil:createInstance("Weld", {
						["Name"] = "ShoeWeld",
						["Part0"] = nil,
						["Part1"] = nil,
						["C0"] = nil,
						["C1"] = nil,
						["Parent"] = nil,
						["Part0"] = p120.Rig:FindFirstChild((("%*Foot"):format(p121))),
						["Part1"] = v132,
						["C0"] = v131.CFrame,
						["C1"] = v132.RigAttachment.CFrame,
						["Parent"] = v132
					})
					return {
						["Name"] = v123,
						["Object"] = v132
					}
