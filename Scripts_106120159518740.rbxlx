					for v160, v161 in v155 do
						local v162 = Font.new(v161.Family, v158.state.index.value, v159.state.index.value)
						p_u_1.SameLine()
						p_u_1.PushConfig({
							["TextFont"] = v162
						})
						if p_u_1.Selectable({ ("%* | \"The quick brown fox jumps over the lazy dog.\""):format(v160), v162.Family }, {
							["index"] = v157
						}).selected() then
							v154.value.TextFont = v162
						end
						p_u_1.PopConfig()
						p_u_1.End()
					end
				end }
		}
		local v164 = {
			["isOpened"] = v_u_5
		}
		p_u_1.Window({ "Style Editor" }, v164)
		p_u_1.Text({ "Customize the look of Iris in realtime." })
		local v165 = p_u_1.State("Dark Theme")
		if p_u_1.ComboArray({ "Theme" }, {
			["index"] = v165
		}, { "Dark Theme", "Light Theme" }).closed() then
			if v165.value == "Dark Theme" then
				p_u_1.UpdateGlobalConfig(p_u_1.TemplateConfig.colorDark)
			elseif v165.value == "Light Theme" then
				p_u_1.UpdateGlobalConfig(p_u_1.TemplateConfig.colorLight)
			end
		end
		local v166 = p_u_1.State("Classic Size")
		if p_u_1.ComboArray({ "Size" }, {
