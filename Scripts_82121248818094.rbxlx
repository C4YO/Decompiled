		v_u_6.JumpPower = 75
		local v_u_8 = 0
		local v_u_9 = false
		local function v12(_, p10) -- name: onStateChanged
			-- upvalues: (ref) v_u_8, (ref) v_u_9, (copy) p_u_5, (copy) v_u_7, (ref) v_u_2
