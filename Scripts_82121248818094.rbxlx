		local function v13() -- name: onJumpRequest
			-- upvalues: (ref) v_u_9, (ref) v_u_8, (copy) v_u_6
			if v_u_9 and v_u_8 < 13 then
				v_u_6:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
		v_u_6.StateChanged:Connect(v12)
