								if v13 then
									v9 = v13.Value
								end
							end
						end
						if v9 and (v9 ~= "None" and v9 ~= "") then
							local v14 = v_u_1:FindFirstChild(v8.folder)
							if v14 then
								local v15 = v14:FindFirstChild(v9)
