        <Item class="ModuleScript" referent="RBX461">
          <Properties>
            <string name="Name">SharedFunctions</string>
            <ProtectedString name="Source"><![CDATA[local v_u_1 = game:GetService("Players")
local v2 = require(script.Parent:WaitForChild("Input"))
local v3 = script.Parent:WaitForChild("Util")
local v4 = require(v3:WaitForChild("Validate"))
local v5 = require(v3:WaitForChild("Physics"))
local v6 = require(v3:WaitForChild("Debris"))
local v7 = require(v3:WaitForChild("Tables"))
local v8 = require(v3:WaitForChild("CoreGuiCall"))
return {
	["IsFiniteNumber"] = v4.IsFiniteNumber,
	["IsFiniteVector3"] = v4.IsFiniteVector3,
	["IsNormalString"] = v4.IsNormalString,
	["Lerp"] = v5.Lerp,
	["GetModelMass"] = v5.GetModelMass,
	["SetNetworkOwner"] = v5.SetNetworkOwner,
	["DebugPosition"] = v5.DebugPosition,
	["ApplyVelocity"] = v5.ApplyVelocity,
	["ApplyAngularVelocity"] = v5.ApplyAngularVelocity,
	["RandomUnitVector"] = v5.RandomUnitVector,
	["Debris"] = v6.Debris,
	["GetTableLength"] = v7.GetTableLength,
	["GetTableValueByIndex"] = v7.GetTableValueByIndex,
	["UnpackTable"] = v7.UnpackTable,
	["CoreCall"] = v8.CoreCall,
	["BindingsChanged"] = v2.BindingsChanged,
	["VirtualInputBegan"] = v2.VirtualInputBegan,
	["VirtualInputEnded"] = v2.VirtualInputEnded,
	["GetDefaultBinding"] = v2.GetDefaultBinding,
	["GetBinding"] = v2.GetBinding,
	["SetBinding"] = v2.SetBinding,
	["FindActionForInput"] = v2.FindActionForInput,
	["SetVirtualInput"] = v2.SetVirtualInput,
	["IsVirtualPressed"] = v2.IsVirtualPressed,
	["ReleaseAllVirtualInputs"] = v2.ReleaseAllVirtualInputs,
	["GetInput"] = v2.GetInput,
	["CheckIfPressed"] = v2.CheckIfPressed,
	["WaitForAttribute"] = function(_, p9, p10) -- name: WaitForAttribute
		repeat
			task.wait()
		until p9:GetAttribute(p10)
	end,
	["FireSpecificClients"] = function(_, p11, p12, p13, p14) -- name: FireSpecificClients
		-- upvalues: (copy) v_u_1
		for _, v15 in pairs(v_u_1:GetPlayers()) do
			if not p14 or v15.Character then
				local v16 = 0
				if p13 then
					for _, v17 in pairs(p13) do
						if v15:GetAttribute(v17) then
							v16 = v16 + 1
						end
					end
				end
				if p13 and v16 == #p13 then
					p11:FireClient(v15, p12)
				end
			end
		end
	end,
	["GetLimbs"] = function(_) -- name: GetLimbs
		return {
			"Head",
			"Torso",
			"Left Arm",
			"Right Arm",
			"Left Leg",
			"Right Leg"
		}
	end,
	["BetterEmit"] = function(p18, p19) -- name: BetterEmit
		local v20 = p19:Clone()
		v20.WorldCFrame = p19.WorldCFrame
		v20.Name = v20.Name .. "_BetterEmit"
		v20.Parent = workspace.Terrain
		local v21 = 0
		for _, v_u_22 in pairs(v20:GetDescendants()) do
			if v_u_22:IsA("ParticleEmitter") then
				local v23 = v_u_22.Lifetime.Max
				v21 = math.max(v21, v23)
				v_u_22:Emit(v_u_22:GetAttribute("EmitCount") or 25)
			elseif v_u_22:IsA("PointLight") then
				v_u_22.Enabled = true
				task.delay(0.05, function()
					-- upvalues: (copy) v_u_22
					v_u_22.Enabled = false
				end)
			end
		end
		p18:Debris(v20, v21)
	end,
	["StringToColor3"] = function(_, p24) -- name: StringToColor3
		local v25 = string.split(p24, ", ")
		local v26 = Color3.fromRGB
		local v27 = v25[1]
		local v28 = tonumber(v27) * 255
		local v29 = v25[2]
		local v30 = tonumber(v29) * 255
		local v31 = v25[3]
		return v26(v28, v30, tonumber(v31) * 255)
	end
}]]></ProtectedString>
