        <Item class="ModuleScript" referent="RBX129">
          <Properties>
            <string name="Name">Handler</string>
            <ProtectedString name="Source"><![CDATA[local v_u_1 = {}
local v2 = game:GetService("ReplicatedStorage")
local v_u_3 = require(v2:WaitForChild("Modules"):WaitForChild("ColorPacks"))
local v4 = v2:WaitForChild("Appearance")
local v_u_5 = v4:WaitForChild("Faces"):GetChildren()
local v_u_6 = v4:WaitForChild("Scars"):GetChildren()
local v_u_7 = v4:WaitForChild("Wrinkles"):GetChildren()
