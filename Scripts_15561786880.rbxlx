          <Item class="ModuleScript" referent="RBX176">
            <Properties>
              <string name="Name">help</string>
              <ProtectedString name="Source"><![CDATA[return {
	["Name"] = "help",
	["Description"] = "Displays a list of all commands, or inspects one command.",
	["Group"] = "Help",
	["Args"] = nil,
	["ClientRun"] = nil,
	["Args"] = {
		{
			["Type"] = "command",
			["Name"] = "Command",
			["Description"] = "The command to view information on",
			["Optional"] = true
		}
	},
	["ClientRun"] = function(p1, p2) -- name: ClientRun
		if p2 then
			local v3 = p1.Cmdr.Registry:GetCommandForExecutor(p2, p1.Executor)
			if not v3 then
				p1:Reply("No command with that name is available to you.")
				return ""
			end
			p1:Reply(("Command: %*"):format(v3.Name), Color3.fromRGB(230, 126, 34))
			if v3.Aliases and #v3.Aliases > 0 then
				p1:Reply(("Aliases: %*"):format((table.concat(v3.Aliases, ", "))), Color3.fromRGB(230, 230, 230))
			end
			p1:Reply(v3.Description, Color3.fromRGB(230, 230, 230))
			for v4, v5 in ipairs(v3.Args) do
				p1:Reply((("#%* %*%*: %* - %*"):format(v4, v5.Name, v5.Optional == true and "?" or "", v5.Type, v5.Description)))
			end
		else
			p1:Reply("Argument Shorthands\n-------------------\n.   Me/Self\n*   All/Everyone\n**  Others\n?   Random\n?N  List of N random values\n")
			p1:Reply("Tips\n----\n\226\128\162 Utilize the Tab key to automatically complete commands\n\226\128\162 Easily select and copy command output\n")
			local v6 = p1.Cmdr.Registry:GetCommandsForExecutor(p1.Executor)
			table.sort(v6, function(p7, p8)
				local v9 = p7.Group or "No Group"
				local v10 = v9 == "PrivateServer" and "Private Server" or v9
				local v11 = p8.Group or "No Group"
				local v12 = v11 == "PrivateServer" and "Private Server" or v11
				if v10 == v12 then
					return p7.Name < p8.Name
				else
					return v10 < v12
				end
			end)
			local v13 = nil
			for _, v14 in ipairs(v6) do
				local v15 = v14.Group or "No Group"
				local v16 = v15 == "PrivateServer" and "Private Server" or v15
				if v13 == v16 then
					v16 = v13
				else
					p1:Reply((("\n%*\n%*"):format(v16, (string.rep("-", #v16)))))
				end
				local v17
				if v14.Description then
					v17 = ("%* - %*"):format(v14.Name, v14.Description)
				else
					v17 = v14.Name
				end
				p1:Reply(v17)
				v13 = v16
			end
		end
		return ""
	end
}]]></ProtectedString>
