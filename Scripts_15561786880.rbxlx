        <Item class="ModuleScript" referent="RBX462">
          <Properties>
            <string name="Name">TOSConfig</string>
            <ProtectedString name="Source"><![CDATA[return {
	["Version"] = 2,
	["Title"] = "BEFORE YOU PLAY",
	["Lines"] = nil,
	["WaitTime"] = 30,
	["Lines"] = {
		"QUICKDRAW has no crosshair. This is intentional.",
		"The bullet comes out of the BARREL - there is no fixed crosshair.",
		"You can shoot THROUGH WALLS - penetration depends on the material and its thickness.",
		"Movement sways your arms and torso, which causes the apparent \"fire spread\".",
		"There is NO RANDOM spread. Stand still or crouch for accurate shots.",
		"QUICKDRAW is a deathmatch shooter: walk the map and fight other players.",
		"You will die often. That is an expected part of the game.",
		"Group and community links are available on the game page."
	}
}]]></ProtectedString>
          </Properties>
        </Item>
