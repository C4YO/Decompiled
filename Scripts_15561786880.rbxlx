end
function v_u_1.GetSample(_, p68) -- name: GetSample
	-- upvalues: (copy) v_u_12, (copy) v_u_16, (copy) v_u_13, (copy) v_u_17, (copy) v_u_8, (copy) v_u_5, (copy) v_u_11, (copy) v_u_15, (copy) v_u_6, (copy) v_u_7
	return {
		["name"] = p68 and v_u_12[math.random(#v_u_12)] or v_u_16[math.random(#v_u_16)],
		["lastName"] = p68 and v_u_13[math.random(#v_u_13)] or v_u_17[math.random(#v_u_17)],
		["skin"] = v_u_8[math.random(#v_u_8)],
		["face"] = v_u_5[math.random(#v_u_5)],
		["hair"] = p68 and v_u_11[math.random(#v_u_11)] or (math.random(1, 8) <= 7 and v_u_15[math.random(#v_u_15)] or nil),
		["scar"] = math.random(1, 5) >= 5 and v_u_6[math.random(#v_u_6)] or nil,
		["wrinkle"] = math.random(1, 5) >= 5 and v_u_7[math.random(#v_u_7)] or nil
	}
end
return v_u_1]]></ProtectedString>
