function SortAccessoriesAlphabetically(p90) -- name: SortAccessoriesAlphabetically
	table.sort(p90, function(p91, p92)
		local v93 = GetBaseName(p91)
		local v94 = GetBaseName(p92)
		if v93 == v94 then
