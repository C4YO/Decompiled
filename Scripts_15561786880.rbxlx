          <Item class="ModuleScript" referent="RBX177">
            <Properties>
              <string name="Name">lasthit</string>
              <ProtectedString name="Source"><![CDATA[local v_u_1 = game:GetService("Players")
local function v_u_8(p2, p3, p4, p5, p6) -- name: showMarker
	local v_u_7 = Instance.new("Part")
	v_u_7.Anchored = true
	v_u_7.CanCollide = false
	v_u_7.Shape = Enum.PartType.Ball
	v_u_7.Material = Enum.Material.Neon
	v_u_7.Color = typeof(p4) == "Color3" and p4 and p4 or Color3.new(1, 0.3, 0.3)
	v_u_7.Size = typeof(p6) == "Vector3" and p6 and p6 or Vector3.new(0.7, 0.7, 0.7)
	v_u_7.Name = typeof(p5) == "string" and p5 and p5 or "CmdrLastHit"
	v_u_7.CFrame = CFrame.new(p2)
	v_u_7.Parent = workspace.Terrain
	task.delay(p3, function()
		-- upvalues: (copy) v_u_7
		if v_u_7 and v_u_7.Parent then
			v_u_7:Destroy()
		end
	end)
end
return {
	["Name"] = "lasthit",
	["Aliases"] = nil,
	["Description"] = "Show your last recorded bullet hit position.",
	["Group"] = "DefaultUtil",
	["Args"] = nil,
	["ClientRun"] = nil,
	["Aliases"] = { "hitpos", "showlasthit" },
	["Args"] = {
		{
			["Type"] = "number",
			["Name"] = "duration",
			["Description"] = "Seconds to show",
			["Optional"] = true
		}
	},
	["ClientRun"] = function(_, p9) -- name: ClientRun
		-- upvalues: (copy) v_u_1, (copy) v_u_8
		local v10 = v_u_1.LocalPlayer
		if not v10 then
			return "Last-hit debug is client-only"
		end
		local v11 = v10:GetAttribute("LastHitPosition")
		local v12 = v10:GetAttribute("LastPierceEntryPosition")
		local v13 = v10:GetAttribute("LastPierceExitPosition")
		if typeof(v11) ~= "Vector3" and typeof(v13) ~= "Vector3" then
			return "No last hit recorded yet"
		end
		local v14 = (typeof(p9) ~= "number" or (p9 <= 0 or not p9)) and 8 or p9
		if typeof(v12) == "Vector3" and typeof(v13) == "Vector3" then
			v_u_8(v12, v14, Color3.new(1, 0.8, 0.2), "CmdrPierceEntry", Vector3.new(0.55, 0.55, 0.55))
			v_u_8(v13, v14, Color3.new(0.2, 0.8, 1), "CmdrPierceExit", Vector3.new(0.65, 0.65, 0.65))
		end
		if typeof(v11) ~= "Vector3" then
			return string.format("Showing last wallbang (pierce) for %.1fs", v14)
		end
		v_u_8(v11, v14, Color3.new(1, 0.3, 0.3), "CmdrLastHit", Vector3.new(0.75, 0.75, 0.75))
		return string.format("Showing last hit (and wallbang if present) for %.1fs", v14)
	end
}]]></ProtectedString>
