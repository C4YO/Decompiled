local v_u_12 = require(v10:WaitForChild("Names"))
local v_u_13 = require(v10:WaitForChild("LastNames"))
local v14 = v4:WaitForChild("Male")
local v_u_15 = v14:WaitForChild("Hair"):GetChildren()
local v_u_16 = require(v14:WaitForChild("Names"))
local v_u_17 = require(v14:WaitForChild("LastNames"))
function v_u_1.GetAllColors(_) -- name: GetAllColors
	-- upvalues: (copy) v_u_3
	local v18 = {}
	for _, v19 in v_u_3.GetLegacyPalette() do
		local v20 = v19.Value
		table.insert(v18, v20)
	end
	return v18
end
function v_u_1.GetRandomColor(_) -- name: GetRandomColor
	-- upvalues: (copy) v_u_3
	local v21 = v_u_3.GetLegacyPalette()
	return v21[math.random(#v21)].Value
end
function v_u_1.GetClothing(_, p22, p23) -- name: GetClothing
	for _, v24 in pairs(p22:GetChildren()) do
		if v24:IsA("Model") and (v24:GetAttribute("Clothing") and v24.Name == p23) then
			return v24
		end
	end
end
function v_u_1.UpdateClothing(_, p25) -- name: UpdateClothing
	-- upvalues: (copy) v_u_1
	local v26 = {}
	for _, v27 in pairs(p25:GetChildren()) do
		if v27:IsA("Model") and v27:GetAttribute("Clothing") then
			if v26[v27.Name] then
				v27:Destroy()
			else
				v26[v27.Name] = true
				for _, v28 in pairs(v27:GetChildren()) do
					if v28:IsA("BasePart") then
						v28.Transparency = v28:GetAttribute("Transparency")
					end
				end
			end
		end
	end
	local v29 = v_u_1:GetClothing(p25, "Topwear")
	if v29 then
		local v30 = v29:FindFirstChild("Config")
		if v30 then
			v30 = require(v30)
		end
		if v30 and v30.hideArms then
			local v31 = v_u_1:GetClothing(p25, "Shirt")
			local v32 = v31 and v31:FindFirstChild("Welds")
			if v32 then
				for _, v33 in pairs(v32:GetChildren()) do
					if v33:IsA("Weld") and (v33:GetAttribute("Part0") and v33:GetAttribute("Part0"):match("Arm")) then
						v33.Part1.Transparency = 1
					end
				end
			end
		end
	end
end
function v_u_1.AddClothing(_, p34, p35, p36, p37) -- name: AddClothing
	-- upvalues: (copy) v_u_9, (copy) v_u_1, (copy) v_u_3
	local v38 = nil
	for _, v39 in pairs(v_u_9:GetChildren()) do
		if v39:IsA("Folder") then
			for _, v40 in pairs(v39:GetChildren()) do
				if v40.Name == p35 and v40:IsA("Model") then
					v38 = v40
					break
				end
			end
		end
	end
	if v38 then
		local v41 = v38.Parent:GetAttribute("Name")
		local v42 = p34:FindFirstChild(v41)
		if v42 then
			v42:Destroy()
		end
		local v43 = v38:Clone()
		local v44 = v43:WaitForChild("Welds")
		local v45 = p34:GetAttribute("IsFemale")
		for _, v46 in pairs(v44:GetChildren()) do
			if v46:IsA("Weld") then
				local v47 = p34:FindFirstChild(v46:GetAttribute("Part0"))
				if v47 then
					v46.Part0 = v47
				end
			end
		end
		local v48 = p36 or v_u_1:GetRandomColor()
		local v49 = math.round(p37 or 0)
		local v50 = v_u_3.MinimumTone
		local v51 = v_u_3.MaximumTone
		local v52 = math.clamp(v49, v50, v51)
		v43:SetAttribute("Color", v48)
		v43:SetAttribute("Tone", v52)
		local v53 = v_u_3.ApplyTone(v48, v52)
		for _, v54 in pairs(v43:GetChildren()) do
			if v54:IsA("BasePart") then
				v54:SetAttribute("Transparency", v54.Transparency)
				v54.CollisionGroup = "NoCollision"
				v54.CanCollide = false
				v54.CanTouch = false
				v54.CanQuery = false
				v54.Massless = true
				local v55 = v44:FindFirstChild(v54.Name)
				local v56 = v54.Name:match("_Female")
				if not v45 and v56 or v45 and (not v56 and v43:FindFirstChild(v54.Name .. "_Female")) then
					if v55 then
						v55:Destroy()
					end
					v54:Destroy()
				end
				if v38:GetAttribute("Colorable") ~= false and not v54:GetAttribute("LockedColor") then
					local v57 = v54:GetAttribute("ColorOffset") or 0
					local v58 = Color3.fromRGB
					local v59 = v53.R * 255 + v57
					local v60 = math.clamp(v59, 0, 255)
					local v61 = v53.G * 255 + v57
					local v62 = math.clamp(v61, 0, 255)
					local v63 = v53.B * 255 + v57
					local v64 = v58(v60, v62, (math.clamp(v63, 0, 255)))
					local v65 = v54:FindFirstChildWhichIsA("SurfaceAppearance")
					if v65 then
						v65.Color = v64
					else
						v54.Color = v64
					end
				end
			end
		end
		v43:SetAttribute("Clothing", true)
		v43:SetAttribute("Name", p35)
		v43.Name = v41
		v43.Parent = p34
