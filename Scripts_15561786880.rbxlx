          <Item class="ModuleScript" referent="RBX160">
            <Properties>
              <string name="Name">TeleportTo</string>
              <ProtectedString name="Source"><![CDATA[local v_u_1 = {
	["bar"] = "saloon",
	["bunker"] = "lab",
	["laboratory"] = "lab",
	["tavern"] = "saloon"
}
local function v_u_7() -- name: locationNames
	local v2 = { "bunker" }
	local v3 = workspace:FindFirstChild("Map")
	if v3 then
		v3 = v3:FindFirstChild("Zones")
	end
	if v3 then
		for _, v4 in v3:GetChildren() do
			if v4:IsA("BasePart") then
				local v5 = string.lower
				local v6 = v4.Name
				table.insert(v2, v5(v6))
			end
		end
	end
	table.sort(v2)
	return v2
end
local v17 = {
	["Name"] = "teleportto",
	["Aliases"] = nil,
	["Description"] = "Teleport players to a named map location.",
	["Group"] = "Moderator",
	["Args"] = nil,
	["Aliases"] = { "tpto", "tplocation" },
	["Args"] = {
		{
			["Type"] = nil,
			["Name"] = "location",
			["Description"] = "Map location, such as bunker or saloon.",
			["Type"] = {
				["Transform"] = function(p8) -- name: Transform
					return string.lower(p8)
				end,
				["Validate"] = function(p9) -- name: Validate
					-- upvalues: (copy) v_u_1, (copy) v_u_7
					local v10 = v_u_1[p9] or p9
					local v11 = workspace:FindFirstChild("Map")
					if v11 then
						v11 = v11:FindFirstChild("Zones")
					end
					if v11 then
						for _, v12 in v11:GetChildren() do
							if v12:IsA("BasePart") and string.lower(v12.Name) == v10 then
								return true
							end
						end
					end
					return false, "Unknown location. Available: " .. table.concat(v_u_7(), ", ")
				end,
				["Autocomplete"] = function(p13) -- name: Autocomplete
					-- upvalues: (copy) v_u_7
					local v14 = {}
					for _, v15 in v_u_7() do
						if string.find(v15, p13, 1, true) == 1 then
							table.insert(v14, v15)
						end
					end
					return v14
				end,
				["Parse"] = function(p16) -- name: Parse
					return p16
				end
			}
		},
		{
			["Type"] = "players",
			["Name"] = "players",
			["Description"] = "Players to teleport (omit for yourself).",
			["Optional"] = true
		}
	}
}
return v17]]></ProtectedString>
