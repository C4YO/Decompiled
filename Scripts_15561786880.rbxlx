          <Item class="ModuleScript" referent="RBX154">
            <Properties>
              <string name="Name">MyRank</string>
              <ProtectedString name="Source"><![CDATA[local v1 = game:GetService("ReplicatedStorage")
local v_u_2 = game:GetService("RunService")
local v_u_3 = require(v1:WaitForChild("Modules"):WaitForChild("Constants")).GROUP_ID
return {
	["Name"] = "myrank",
	["Aliases"] = nil,
	["Description"] = "Show your Cmdr permission attributes.",
	["Group"] = "Player",
	["Args"] = nil,
	["Run"] = nil,
	["Aliases"] = { "rank", "whoami" },
	["Args"] = {},
	["Run"] = function(p4) -- name: Run
		-- upvalues: (copy) v_u_3, (copy) v_u_2
		local v_u_5 = p4.Executor
		if not v_u_5 then
			return "No player"
		end
		local v6 = v_u_5:GetAttribute("Rank")
		local v7 = v_u_5:GetAttribute("IsPrivateServerOwner") == true
		local v8, v9 = pcall(function()
			-- upvalues: (copy) v_u_5, (ref) v_u_3
			return v_u_5:GetRankInGroup(v_u_3)
		end)
		local v10 = (not v8 or typeof(v9) ~= "number") and "?" or tostring(v9)
		local v11 = v_u_2
		return string.format("UserId=%d\nRankAttribute=%s\nGroupRank(%d)=%s\nIsPrivateServerOwner=%s\nStudio=%s", v_u_5.UserId, tostring(v6), v_u_3, v10, tostring(v7), (tostring(v11:IsStudio())))
	end
}]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX155">
            <Properties>
              <string name="Name">PlayerList</string>
              <ProtectedString name="Source"><![CDATA[local v_u_1 = game:GetService("Players")
return {
	["Name"] = "list",
	["Aliases"] = nil,
	["Description"] = "Player list",
	["Group"] = "Player",
	["Args"] = nil,
	["ClientRun"] = nil,
	["Aliases"] = {},
	["Args"] = {},
	["ClientRun"] = function() -- name: ClientRun
		-- upvalues: (copy) v_u_1
		local v2 = v_u_1:GetPlayers()
		local v3 = ""
		for v4, v5 in pairs(v2) do
			if v5.DisplayName == v5.Name then
				v3 = v3 .. "#" .. v4 .. " " .. v5.Name .. " : " .. v5.UserId
			else
				v3 = v3 .. "#" .. v4 .. " " .. v5.DisplayName .. " (" .. v5.Name .. ") : " .. v5.UserId
			end
			if v4 ~= #v2 then
				v3 = v3 .. "\n"
			end
		end
		return v3
	end
}]]></ProtectedString>
            </Properties>
